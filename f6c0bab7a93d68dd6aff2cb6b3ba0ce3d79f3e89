{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { mkdir, readFile, rm, writeFile } from \"node:fs/promises\";\n2\timport { existsSync } from \"node:fs\";\n3\timport { join } from \"node:path\";\n4\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n5\timport {\n6\t  currentBranch,\n7\t  git,\n8\t  gitUserIdentity,\n9\t  headSha,\n10\t  repoIdentity,\n11\t  revList,\n12\t  statusPorcelain,\n13\t  type RepoInfo,\n14\t} from \"./git.js\";\n15\timport {\n16\t  absorbIncoming,\n17\t  ensureMergeConfig,\n18\t  ensureTransport,\n19\t  INCOMING_REF,\n20\t  NOTES_NAME,\n21\t  NOTES_REF,\n22\t} from \"./transport.js\";\n23\timport {\n24\t  finalizeEvent,\n25\t  parseEventLine,\n26\t  serializeEvent,\n27\t  type Actor,\n28\t  type EventDraft,\n29\t  type EvidenceEvent,\n30\t  type RepoContext,\n31\t} from \"./schema.js\";\n32\timport {\n33\t  commitDateIso,\n34\t  defaultRewriteTarget,\n35\t  detectRewrites,\n36\t  parseReAnchor,\n37\t  reAnchorDraft,\n38\t  type DetectedRewrite,\n39\t  type ReAnchorMapping,\n40\t  type UnmatchedBranch,\n41\t} from \"./reanchor.js\";\n42\timport { collectMatches, redactDraft, type ExtraValueGroup, type RedactionRecord } from \"./redact/apply.js\";\n43\timport { captureRules, collectEnvValues, loadConfig } from \"./redact/config.js\";\n44\timport { addKnownSecrets, loadKnownSecrets } from \"./redact/known-secrets.js\";\n45\timport { RULESET_VERSION, type RedactionRule } from \"./redact/rules.js\";\n46\timport {\n47\t  filterFindings,\n48\t  findingGuidance,\n49\t  formatFinding,\n50\t  loadAllowlist,\n51\t  scanEvents,\n52\t} from \"./redact/scan.js\";\n53\t\n54\texport { ensureMergeConfig, NOTES_NAME, NOTES_REF } from \"./transport.js\";\n55\t\n56\t/**\n57\t * Storage model: one git note per anchor commit under refs/notes/\n58\t * conversation-ledger. The note body is JSONL — one canonical-JSON event\n59\t * per line, lexicographically sorted, unique. Everything lives in the note\n60\t * blob itself (no out-of-tree pointers), so records are reachable from the\n61\t * ref, GC-safe, travel with `git push`/`fetch` of that one ref, and merge\n62\t * conflict-free with the cat_sort_uniq notes strategy.\n63\t *\n64\t * Events are anchored to HEAD at capture time, so conversations ride the\n65\t * commit DAG: merge a branch and its conversations become reachable from\n66\t * the target branch with no extra machinery.\n67\t */\n68\t\n69\tfunction stateDir(repo: RepoInfo): string {\n70\t  return join(repo.commonDir, \"conversation-ledger\");\n71\t}\n72\t\n73\tfunction pendingPath(repo: RepoInfo): string {\n74\t  return join(stateDir(repo), \"pending.jsonl\");\n75\t}\n76\t\n77\t/** Local, rebuildable cache/state only — never the record of truth. */\n78\tasync function ensureStateDir(repo: RepoInfo): Promise<void> {\n79\t  await mkdir(stateDir(repo), { recursive: true });\n80\t}\n81\t\n82\texport async function captureContext(repo: RepoInfo): Promise<RepoContext> {\n83\t  const [identity, branch, head, status] = await Promise.all([\n84\t    repoIdentity(repo),\n85\t    currentBranch(repo),\n86\t    headSha(repo),\n87\t    statusPorcelain(repo),\n88\t  ]);\n89\t  const context: RepoContext = { repo: identity, cwd: repo.root };\n90\t  if (branch) context.branch = branch;\n91\t  if (head) context.head = head;\n92\t  if (status.trim()) context.dirty_fingerprint = sha256Hex(status);\n93\t  return context;\n94\t}\n95\t\n96\tasync function readNoteLines(repo: RepoInfo, anchor: string, refName = NOTES_NAME): Promise<string[]> {\n97\t  const body = await git([\"notes\", \"--ref\", refName, \"show\", anchor], {\n98\t    cwd: repo.root,\n99\t    allowFailure: true,\n100\t  });\n101\t  return body.split(\"\\n\").filter((l) => l.trim().length > 0);\n102\t}\n103\t\n104\t/** `refName` defaults to the main ledger ref; the scan gate also reads a temp fetched ref. */\n105\texport async function readNoteEvents(\n106\t  repo: RepoInfo,\n107\t  anchor: string,\n108\t  refName = NOTES_NAME,\n109\t): Promise<EvidenceEvent[]> {\n110\t  return (await readNoteLines(repo, anchor, refName)).map(parseEventLine);\n111\t}\n112\t\n113\t/** All (anchor commit, note) pairs in the ledger ref (or `refName`, for reading a temp fetched ref). */\n114\texport async function listAnchors(repo: RepoInfo, refName = NOTES_NAME): Promise<string[]> {\n115\t  const out = await git([\"notes\", \"--ref\", refName, \"list\"], {\n116\t    cwd: repo.root,\n117\t    allowFailure: true,\n118\t  });\n119\t  return out\n120\t    .split(\"\\n\")\n121\t    .filter(Boolean)\n122\t    .map((line) => line.split(/\\s+/)[1])\n123\t    .filter((sha): sha is string => Boolean(sha));\n124\t}\n125\t\n126\tasync function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n127\t  await ensureStateDir(repo);\n128\t  const lockDir = join(stateDir(repo), \"lock\");\n129\t  const deadline = Date.now() + 10_000;\n130\t  for (;;) {\n131\t    try {\n132\t      await mkdir(lockDir);\n133\t      break;\n134\t    } catch {\n135\t      if (Date.now() > deadline) {\n136\t        // A crashed writer can leave the lock behind; steal it after the\n137\t        // wait budget rather than wedging capture hooks forever.\n138\t        await rm(lockDir, { recursive: true, force: true });\n139\t      } else {\n140\t        await new Promise((r) => setTimeout(r, 100));\n141\t      }\n142\t    }\n143\t  }\n144\t  try {\n145\t    return await fn();\n146\t  } finally {\n147\t    await rm(lockDir, { recursive: true, force: true });\n148\t  }\n149\t}\n150\t\n151\texport interface AppendResult {\n152\t  appended: EvidenceEvent[];\n153\t  deduped: number;\n154\t  /** null when events went to the pending queue (unborn HEAD). */\n155\t  anchor: string | null;\n156\t}\n157\t\n158\texport async function appendEvents(\n159\t  repo: RepoInfo,\n160\t  drafts: EventDraft[],\n161\t  opts: { context?: RepoContext; anchor?: string } = {},\n162\t): Promise<AppendResult> {\n163\t  const config = await loadConfig(repo.root);\n164\t  // Master per-repo switch: skip everything, including the transport wiring\n165\t  // below, so a disabled repo's ledger ref is never even touched.\n166\t  if (config.enabled === false) {\n167\t    return { appended: [], deduped: 0, anchor: null };\n168\t  }\n169\t  const context = opts.context ?? (await captureContext(repo));\n170\t  // First capture in a repo wires up transport (pre-push hook + fetch\n171\t  // refspec); later calls are cheap re-checks. Never throws.\n172\t  await ensureTransport(repo, config);\n173\t  const rules = captureRules(config);\n174\t  // Exact-value scrubbing layers, each tagged with its own rule id for the\n175\t  // audit trail. Only consulted when capture redaction is active at all\n176\t  // (rules.length > 0); known-secrets additionally requires its opt-in flag.\n177\t  const extraValues: ExtraValueGroup[] = [];\n178\t  if (rules.length > 0) {\n179\t    if (config.redact?.knownSecrets === true) {\n180\t      const known = await loadKnownSecrets(repo);\n181\t      if (known.length > 0) extraValues.push({ ruleId: \"known-secret\", values: known });\n182\t    }\n183\t    if (config.redact?.env === true) {\n184\t      const env = await collectEnvValues(repo.root);\n185\t      if (env.length > 0) extraValues.push({ ruleId: \"env-value\", values: env });\n186\t    }\n187\t  }\n188\t  const events = drafts.map((draft) => {\n189\t    const withContext = { ...draft, context: draft.context ?? context };\n190\t    if (rules.length === 0) return finalizeEvent(withContext);\n191\t    const { draft: redacted, records } = redactDraft(withContext, {\n192\t      rules,\n193\t      ...(extraValues.length > 0 ? { extraValues } : {}),\n194\t    });\n195\t    return finalizeEvent(records.length > 0 ? { ...redacted, redactions: records } : redacted);\n196\t  });\n197\t  return withLock(repo, async () => {\n198\t    await ensureMergeConfig(repo);\n199\t    // Almost everything anchors to HEAD at capture time; re-anchor mapping\n200\t    // events override this to anchor at the successor commit so the mapping\n201\t    // rides the surviving branch's DAG regardless of where it was created.\n202\t    const anchor = opts.anchor ?? (await headSha(repo));\n203\t    if (!anchor) {\n204\t      return appendPending(repo, events);\n205\t    }\n206\t    const pending = await drainPending(repo);\n207\t    const existing = await readNoteLines(repo, anchor);\n208\t    const known = new Set(existing.map((l) => parseEventLine(l).id));\n209\t    const fresh = [...pending, ...events].filter((e) => {\n210\t      if (known.has(e.id)) return false;\n211\t      known.add(e.id);\n212\t      return true;\n213\t    });\n214\t    if (fresh.length === 0) {\n215\t      return { appended: [], deduped: events.length, anchor };\n216\t    }\n217\t    const lines = [...existing, ...fresh.map(serializeEvent)].sort();\n218\t    await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n219\t      cwd: repo.root,\n220\t      input: lines.join(\"\\n\") + \"\\n\",\n221\t    });\n222\t    const freshIds = new Set(fresh.map((e) => e.id));\n223\t    return {\n224\t      appended: events.filter((e) => freshIds.has(e.id)),\n225\t      deduped: events.length - events.filter((e) => freshIds.has(e.id)).length,\n226\t      anchor,\n227\t    };\n228\t  });\n229\t}\n230\t\n231\tasync function appendPending(repo: RepoInfo, events: EvidenceEvent[]): Promise<AppendResult> {\n232\t  await ensureStateDir(repo);\n233\t  const path = pendingPath(repo);\n234\t  const existing = existsSync(path)\n235\t    ? (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean)\n236\t    : [];\n237\t  const known = new Set(existing.map((l) => parseEventLine(l).id));\n238\t  const fresh = events.filter((e) => !known.has(e.id));\n239\t  await writeFile(path, [...existing, ...fresh.map(serializeEvent)].join(\"\\n\") + \"\\n\");\n240\t  return { appended: fresh, deduped: events.length - fresh.length, anchor: null };\n241\t}\n242\t\n243\t/** Events held while HEAD was unborn; caller writes them into a real note. */\n244\tasync function drainPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n245\t  const path = pendingPath(repo);\n246\t  if (!existsSync(path)) return [];\n247\t  const events = (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n248\t  await rm(path, { force: true });\n249\t  return events;\n250\t}\n251\t\n252\texport async function readPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n253\t  const path = pendingPath(repo);\n254\t  if (!existsSync(path)) return [];\n255\t  return (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n256\t}\n257\t\n258\texport interface ReadOptions {\n259\t  /** Restrict to events anchored to commits reachable from this rev. */\n260\t  reachableFrom?: string;\n261\t  kind?: string;\n262\t  source?: string;\n263\t  /**\n264\t   * Exact match on `producer.model`. Events the source never labelled with a\n265\t   * model (human turns in most transcripts, cledger's own bookkeeping events)\n266\t   * have no model and are therefore excluded by this filter, rather than\n267\t   * being folded in on a guess about which model they belong to.\n268\t   */\n269\t  model?: string;\n270\t  conversation?: string;\n271\t}\n272\t\n273\texport async function readEvents(repo: RepoInfo, opts: ReadOptions = {}): Promise<EvidenceEvent[]> {\n274\t  // Lazy transport: fold in anything a plain `git fetch`/`git pull` staged.\n275\t  await absorbIncoming(repo);\n276\t  // Lazy re-anchoring, same shape: if the fetch revealed that the remote\n277\t  // target branch rewrote noted commits (squash merge), map them before\n278\t  // filtering by reachability below.\n279\t  await autoReAnchor(repo);\n280\t  let anchors = await listAnchors(repo);\n281\t  const noteCache = new Map<string, EvidenceEvent[]>();\n282\t  const readNote = async (anchor: string): Promise<EvidenceEvent[]> => {\n283\t    let events = noteCache.get(anchor);\n284\t    if (!events) {\n285\t      events = await readNoteEvents(repo, anchor);\n286\t      noteCache.set(anchor, events);\n287\t    }\n288\t    return events;\n289\t  };\n290\t  if (opts.reachableFrom) {\n291\t    anchors = await resolveAnchors(repo, anchors, opts.reachableFrom, readNote);\n292\t  }\n293\t  const events: EvidenceEvent[] = [];\n294\t  for (const anchor of anchors) {\n295\t    events.push(...(await readNote(anchor)));\n296\t  }\n297\t  events.push(...(await readPending(repo)));\n298\t  const filtered = events.filter(\n299\t    (e) =>\n300\t      (!opts.kind || e.kind === opts.kind) &&\n301\t      (!opts.source || e.producer.source === opts.source) &&\n302\t      (!opts.model || e.producer.model === opts.model) &&\n303\t      (!opts.conversation || e.conversation?.id === opts.conversation ||\n304\t        e.conversation?.id.startsWith(opts.conversation)),\n305\t  );\n306\t  return sortEvents(dedupById(filtered));\n307\t}\n308\t\n309\t/**\n310\t * Collapse events that share an id but live under different anchor commits.\n311\t *\n312\t * Append-time dedup only ever consults the note of the commit being written\n313\t * to (see `appendEvents`), so it cannot see a copy filed under a different\n314\t * anchor. Any capture that re-reads transcript lines it already ingested\n315\t * *after* HEAD moved therefore files a second copy of the same events against\n316\t * the new HEAD — and once both anchors are reachable, reads returned the turn\n317\t * twice. Worktrees made this routine before capture cursors became shared\n318\t * (they were per-worktree, so entering or leaving one restarted the scan),\n319\t * but it is not worktree-specific: a forced rescan does it too, and the\n320\t * duplicates already written this way are permanent, since the ledger is\n321\t * append-only.\n322\t *\n323\t * Identical ids mean identical *identity* fields by construction, so the\n324\t * copies differ only in provenance the id excludes — `recorded_at`, the\n325\t * `context` captured at the time, `raw`. The earliest `recorded_at` wins as\n326\t * the original capture, with the canonical serialization as a tie-break so\n327\t * every clone independently picks the same one.\n328\t */\n329\tfunction dedupById(events: EvidenceEvent[]): EvidenceEvent[] {\n330\t  const byId = new Map<string, EvidenceEvent>();\n331\t  for (const event of events) {\n332\t    const seen = byId.get(event.id);\n333\t    if (!seen) {\n334\t      byId.set(event.id, event);\n335\t      continue;\n336\t    }\n337\t    if (event.recorded_at < seen.recorded_at) byId.set(event.id, event);\n338\t    else if (event.recorded_at === seen.recorded_at) {\n339\t      if (canonicalJson(event) < canonicalJson(seen)) byId.set(event.id, event);\n340\t    }\n341\t  }\n342\t  return [...byId.values()];\n343\t}\n344\t\n345\t/**\n346\t * Reachability with re-anchor resolution. Plain reachability drops any\n347\t * conversation whose anchor commit was rewritten away (a GitHub squash merge\n348\t * discards the branch's commits, so their notes fall out of `rev-list` even\n349\t * though the work survives in the squash commit). A `re_anchor` event —\n350\t * anchored to the successor commit, so it is discoverable exactly when the\n351\t * successor is in view — repairs this: an anchor counts as reachable when the\n352\t * rev reaches it, or when a mapping whose successor is reachable names it as\n353\t * superseded. Superseded commits can themselves anchor further mappings\n354\t * (a squash commit later rewritten again), so resolution loops to a fixpoint:\n355\t * grow the reachable set, read the notes that just became visible, repeat.\n356\t * The set only grows and each note is read once, so it terminates.\n357\t */\n358\tasync function resolveAnchors(\n359\t  repo: RepoInfo,\n360\t  anchors: string[],\n361\t  rev: string,\n362\t  readNote: (anchor: string) => Promise<EvidenceEvent[]>,\n363\t): Promise<string[]> {\n364\t  const reachable = await revList(repo, rev);\n365\t  const visited = new Set<string>();\n366\t  const mappings: ReAnchorMapping[] = [];\n367\t  for (;;) {\n368\t    const frontier = anchors.filter((a) => reachable.has(a) && !visited.has(a));\n369\t    for (const anchor of frontier) {\n370\t      visited.add(anchor);\n371\t      for (const event of await readNote(anchor)) {\n372\t        const mapping = parseReAnchor(event);\n373\t        if (mapping) mappings.push(mapping);\n374\t      }\n375\t    }\n376\t    let grew = false;\n377\t    for (const mapping of mappings) {\n378\t      // A mapping only applies once its successor is in view; one pointing\n379\t      // at an unreachable successor (e.g. asserted from another branch)\n380\t      // changes nothing here.\n381\t      if (!reachable.has(mapping.successor)) continue;\n382\t      for (const sha of mapping.superseded) {\n383\t        if (!reachable.has(sha)) {\n384\t          reachable.add(sha);\n385\t          grew = true;\n386\t        }\n387\t      }\n388\t    }\n389\t    if (frontier.length === 0 && !grew) break;\n390\t  }\n391\t  return anchors.filter((a) => reachable.has(a));\n392\t}\n393\t\n394\t/** Commits carrying notes, and the commits existing mappings already supersede. */\n395\tasync function reAnchorState(\n396\t  repo: RepoInfo,\n397\t): Promise<{ anchors: Set<string>; alreadySuperseded: Set<string> }> {\n398\t  const anchors = new Set(await listAnchors(repo));\n399\t  const alreadySuperseded = new Set<string>();\n400\t  for (const anchor of anchors) {\n401\t    for (const event of await readNoteEvents(repo, anchor)) {\n402\t      const mapping = parseReAnchor(event);\n403\t      if (mapping) for (const sha of mapping.superseded) alreadySuperseded.add(sha);\n404\t    }\n405\t  }\n406\t  return { anchors, alreadySuperseded };\n407\t}\n408\t\n409\texport interface ReAnchorRunResult {\n410\t  /** Rev the detection compared against, or null when none could be resolved. */\n411\t  target: string | null;\n412\t  detected: DetectedRewrite[];\n413\t  ambiguous: string[];\n414\t  /** Noted, rewritten-looking branches exact matching could not map. */\n415\t  unmatched: UnmatchedBranch[];\n416\t  /** Mapping events actually appended — empty on dry runs and re-runs. */\n417\t  applied: EvidenceEvent[];\n418\t}\n419\t\n420\t/**\n421\t * One detection pass against `target` (default: the remote default branch),\n422\t * optionally appending the proposed exact mappings, each anchored to its\n423\t * successor commit. Re-running is a no-op: commits an existing mapping\n424\t * covers are excluded from detection, and identical mapping events dedup by\n425\t * id anyway. Ambiguous branches are reported, never guessed at.\n426\t */\n427\texport async function runReAnchor(\n428\t  repo: RepoInfo,\n429\t  opts: { target?: string; apply: boolean },\n430\t): Promise<ReAnchorRunResult> {\n431\t  const target = opts.target ?? (await defaultRewriteTarget(repo));\n432\t  if (!target) return { target: null, detected: [], ambiguous: [], unmatched: [], applied: [] };\n433\t  const { anchors, alreadySuperseded } = await reAnchorState(repo);\n434\t  if (anchors.size === 0) return { target, detected: [], ambiguous: [], unmatched: [], applied: [] };\n435\t  const { detected, ambiguous, unmatched } = await detectRewrites(repo, {\n436\t    target,\n437\t    anchors,\n438\t    alreadySuperseded,\n439\t  });\n440\t  const applied: EvidenceEvent[] = [];\n441\t  if (opts.apply) {\n442\t    for (const rewrite of detected) {\n443\t      const result = await appendEvents(repo, [reAnchorDraft(rewrite.mapping)], {\n444\t        anchor: rewrite.mapping.successor,\n445\t      });\n446\t      applied.push(...result.appended);\n447\t    }\n448\t  }\n449\t  return { target, detected, ambiguous, unmatched, applied };\n450\t}\n451\t\n452\t/**\n453\t * Manual mapping — the escape hatch for everything mechanical matching\n454\t * cannot assert: a maintainer edited during the squash, the branch is long\n455\t * gone, an ambiguous match needed a human eye. Asserted by the user, so the\n456\t * actor is the user (two humans asserting the same mapping yield two\n457\t * events; honest provenance, and the reads they affect are identical).\n458\t */\n459\texport async function manualReAnchor(\n460\t  repo: RepoInfo,\n461\t  supersededRevs: string[],\n462\t  ontoRev: string,\n463\t): Promise<{ event: EvidenceEvent | null; superseded: string[]; successor: string }> {\n464\t  const resolve = async (rev: string): Promise<string> => {\n465\t    const sha = (await git([\"rev-parse\", \"--verify\", \"--quiet\", `${rev}^{commit}`], {\n466\t      cwd: repo.root,\n467\t      allowFailure: true,\n468\t    })).trim();\n469\t    if (!sha) throw new Error(`cledger re-anchor: cannot resolve \"${rev}\" to a commit`);\n470\t    return sha;\n471\t  };\n472\t  const successor = await resolve(ontoRev);\n473\t  const superseded = [];\n474\t  for (const rev of supersededRevs) {\n475\t    // A superseded commit may already be GC'd (its branch deleted long ago)\n476\t    // — the mapping is how its still-enumerable note stays meaningful — so a\n477\t    // full SHA is taken at its word; only shorthand needs a live object.\n478\t    superseded.push(/^[0-9a-f]{40}$/.test(rev) ? rev : await resolve(rev));\n479\t  }\n480\t\n481\t  const identity = await gitUserIdentity(repo);\n482\t  const actor: Actor = { type: \"human\" };\n483\t  if (identity.email) actor.id = identity.email;\n484\t  if (identity.name) actor.display = identity.name;\n485\t\n486\t  const result = await appendEvents(\n487\t    repo,\n488\t    [\n489\t      reAnchorDraft({\n490\t        superseded,\n491\t        successor,\n492\t        method: \"manual\",\n493\t        occurredAt: await commitDateIso(repo, successor),\n494\t        actor,\n495\t      }),\n496\t    ],\n497\t    { anchor: successor },\n498\t  );\n499\t  // null means an identical mapping already exists — dedup, not failure.\n500\t  return { event: result.appended[0] ?? null, superseded, successor };\n501\t}\n502\t\n503\t/**\n504\t * Default-on half of re-anchoring (config: {\"reanchor\": {\"auto\": false}} to\n505\t * disable): runs inside every read, right after absorbIncoming, so a plain\n506\t * `git fetch` + `cledger log` is enough for a squash-merged branch's\n507\t * conversations to follow the squash commit. The detection pass costs a\n508\t * handful of subprocesses per local branch, so it is gated on a cursor over\n509\t * the target tip and only runs when the target actually moved. Never throws\n510\t * — a read must never fail because detection did. The known gap the cursor\n511\t * accepts: conversations captured onto an already-dead branch after the\n512\t * target was seen won't auto-map until the target moves again — `cledger\n513\t * re-anchor` covers that manually.\n514\t */\n515\tasync function autoReAnchor(repo: RepoInfo): Promise<void> {\n516\t  try {\n517\t    const config = await loadConfig(repo.root);\n518\t    if (config.reanchor?.auto === false) return;\n519\t    const target = await defaultRewriteTarget(repo);\n520\t    if (!target) return;\n521\t    const tip = (await git([\"rev-parse\", \"--verify\", \"--quiet\", target], {\n522\t      cwd: repo.root,\n523\t      allowFailure: true,\n524\t    })).trim();\n525\t    if (!tip) return;\n526\t    const cursorPath = join(stateDir(repo), \"reanchor-cursor\");\n527\t    let seen = \"\";\n528\t    try {\n529\t      seen = (await readFile(cursorPath, \"utf8\")).trim();\n530\t    } catch {\n531\t      // first run, or unreadable state — state is rebuildable\n532\t    }\n533\t    if (seen === tip) return;\n534\t    const result = await runReAnchor(repo, { target, apply: true });\n535\t    if (result.applied.length > 0) {\n536\t      const anchors = result.detected.reduce((n, d) => n + d.notedAnchors, 0);\n537\t      process.stderr.write(\n538\t        `cledger: re-anchored ${anchors} conversation anchor(s) rewritten away by ${target} ` +\n539\t          `(mappings recorded in the ledger)\\n`,\n540\t      );\n541\t    }\n542\t    if (result.ambiguous.length > 0) {\n543\t      process.stderr.write(\n544\t        `cledger: branch(es) ${result.ambiguous.join(\", \")} look rewritten onto ${target} but ` +\n545\t          `match more than one commit — run \\`cledger re-anchor\\` to resolve manually\\n`,\n546\t      );\n547\t    }\n548\t    await ensureStateDir(repo);\n549\t    await writeFile(cursorPath, tip + \"\\n\");\n550\t  } catch {\n551\t    // Reads must never fail because detection did.\n552\t  }\n553\t}\n554\t\n555\t/** Stable order: conversation, then seq, then time, then id. */\n556\texport function sortEvents(events: EvidenceEvent[]): EvidenceEvent[] {\n557\t  return [...events].sort((a, b) => {\n558\t    const conv = (a.conversation?.id ?? \"\").localeCompare(b.conversation?.id ?? \"\");\n559\t    if (conv !== 0) return conv;\n560\t    const seq = (a.conversation?.seq ?? 0) - (b.conversation?.seq ?? 0);\n561\t    if (seq !== 0) return seq;\n562\t    const time = a.occurred_at.localeCompare(b.occurred_at);\n563\t    if (time !== 0) return time;\n564\t    return a.id.localeCompare(b.id);\n565\t  });\n566\t}\n567\t\n568\texport interface SyncResult {\n569\t  fetched: boolean;\n570\t  pushed: boolean;\n571\t  /**\n572\t   * Anchors whose conversations this push was scoped to, or null when the\n573\t   * push was unscoped (`--all`). Length is the anchor count, not the event\n574\t   * count.\n575\t   */\n576\t  scopedAnchors: number | null;\n577\t}\n578\t\n579\t/**\n580\t * The anchors a push from `rev` should carry: exactly the set a read at that\n581\t * rev resolves to.\n582\t *\n583\t * Storage is per-commit and reads are per-branch, but a push is per-*ref* and\n584\t * a ref carries the whole notes database — so until 0.14.0 pushing any branch\n585\t * shipped every branch's conversations. Scoping the push to the same anchors\n586\t * `readEvents({reachableFrom: rev})` would return makes distribution agree\n587\t * with visibility: what you can see from a branch is what pushing that branch\n588\t * shares.\n589\t *\n590\t * Reusing `resolveAnchors` rather than a plain `git rev-list` is what makes\n591\t * this survive squash merges. A squash discards the source branch's commits,\n592\t * so its conversations sit on anchors unreachable from the target; the\n593\t * re_anchor mapping events that repair this are themselves anchored to the\n594\t * *surviving* commit, and `resolveAnchors` walks them transitively to pull\n595\t * the orphaned anchors back into view. A rev-list-only scope would silently\n596\t * drop precisely the conversations re-anchoring exists to save — and would\n597\t * push the mapping events describing them while leaving the events they\n598\t * point at behind.\n599\t */\n600\tasync function anchorsForRevs(repo: RepoInfo, revs: string[]): Promise<string[]> {\n601\t  const anchors = await listAnchors(repo);\n602\t  const noteCache = new Map<string, EvidenceEvent[]>();\n603\t  const readNote = async (anchor: string): Promise<EvidenceEvent[]> => {\n604\t    let events = noteCache.get(anchor);\n605\t    if (!events) {\n606\t      events = await readNoteEvents(repo, anchor);\n607\t      noteCache.set(anchor, events);\n608\t    }\n609\t    return events;\n610\t  };\n611\t  // Union across revs: `git push origin a b` should share both branches, and\n612\t  // resolving each separately keeps each one's re_anchor mappings applied in\n613\t  // its own reachability context rather than in a merged one.\n614\t  const union = new Set<string>();\n615\t  for (const rev of revs) {\n616\t    for (const anchor of await resolveAnchors(repo, anchors, rev, readNote)) union.add(anchor);\n617\t  }\n618\t  return [...union];\n619\t}\n620\t\n621\t/**\n622\t * Push `anchors`' notes to the remote's ledger ref without disturbing\n623\t * anything already there.\n624\t *\n625\t * The subtlety that makes this non-obvious: a notes ref is a *snapshot of the\n626\t * whole database*, not an append log. Its tip commit's tree maps every\n627\t * annotated commit to its note, so whatever tree you push becomes the\n628\t * remote's entire notes database. Pushing a tree containing only this\n629\t * branch's notes would therefore delete every other branch's — they would\n630\t * survive in the ref's history but vanish from `git notes show` and from any\n631\t * fresh clone, which is silent data loss for collaborators.\n632\t *\n633\t * So the scoped push is built the other way round: seed a temp ref from the\n634\t * remote's current tip, union this scope's notes into it, and push that. The\n635\t * result descends from what the remote already had, so it fast-forwards and\n636\t * strictly adds. Conversations on branches outside the scope are simply never\n637\t * written into the temp ref, and never leave the machine.\n638\t */\n639\tasync function pushScopedNotes(\n640\t  repo: RepoInfo,\n641\t  remote: string,\n642\t  anchors: string[],\n643\t): Promise<void> {\n644\t  const tmpName = \"cledger-push-tmp\";\n645\t  const tmpRef = `refs/notes/${tmpName}`;\n646\t  await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n647\t  // Seed from the remote. Failure here means the remote has no ledger ref\n648\t  // yet (first push), so the temp ref simply starts empty.\n649\t  await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n650\t  try {\n651\t    for (const anchor of anchors) {\n652\t      const local = await readNoteLines(repo, anchor);\n653\t      if (local.length === 0) continue;\n654\t      const seeded = await readNoteLines(repo, anchor, tmpName);\n655\t      // Line-level sort+unique: the same shape `cat_sort_uniq` gives the\n656\t      // merge path, so a scoped push and a full merge converge.\n657\t      const union = [...new Set([...seeded, ...local])].sort();\n658\t      if (union.length === seeded.length) continue; // remote already had all of them\n659\t      await git([\"notes\", \"--ref\", tmpName, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n660\t        cwd: repo.root,\n661\t        input: union.join(\"\\n\") + \"\\n\",\n662\t      });\n663\t    }\n664\t    const tmpExists = (await git([\"rev-parse\", \"--verify\", \"--quiet\", tmpRef], {\n665\t      cwd: repo.root,\n666\t      allowFailure: true,\n667\t    })).trim();\n668\t    if (!tmpExists) return; // nothing in scope and the remote had nothing\n669\t    await git([\"push\", remote, `${tmpRef}:${NOTES_REF}`], { cwd: repo.root });\n670\t  } finally {\n671\t    await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n672\t  }\n673\t}\n674\t\n675\t/**\n676\t * Event ids the remote's notes ref already has, fetched into a throwaway\n677\t * temp ref that is deleted before returning. Null means the remote has no\n678\t * ledger ref at all (e.g. first push), in which case the caller should\n679\t * treat everything local as unshared.\n680\t */\n681\tasync function remoteNoteIds(repo: RepoInfo, remote: string): Promise<Set<string> | null> {\n682\t  const remoteHasRef = (await git([\"ls-remote\", remote, NOTES_REF], {\n683\t    cwd: repo.root,\n684\t    allowFailure: true,\n685\t  })).trim();\n686\t  if (!remoteHasRef) return null;\n687\t\n688\t  const tmpName = \"conversation-ledger-scan-tmp\";\n689\t  const tmpRef = `refs/notes/${tmpName}`;\n690\t  await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n691\t  try {\n692\t    const ids = new Set<string>();\n693\t    for (const anchor of await listAnchors(repo, tmpName)) {\n694\t      for (const event of await readNoteEvents(repo, anchor, tmpName)) ids.add(event.id);\n695\t    }\n696\t    return ids;\n697\t  } finally {\n698\t    await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n699\t  }\n700\t}\n701\t\n702\t/** Thrown when the layer-E scan gate blocks a push; carries no secrets. */\n703\texport class ScanBlockedError extends Error {\n704\t  constructor(public readonly findings: number) {\n705\t    super(`cledger sync: push blocked — ${findings} potential secret(s) found (see report above)`);\n706\t  }\n707\t}\n708\t\n709\t/**\n710\t * Layer E: before push, scan only the events the remote does not yet have\n711\t * (already-pushed events are not rescanned every time). On any surviving\n712\t * finding, print a report and throw so sync() does not proceed to push —\n713\t * the fetch/merge phase, if it already ran, is left in place.\n714\t */\n715\tasync function runScanGate(\n716\t  repo: RepoInfo,\n717\t  remote: string,\n718\t  tier: \"standard\" | \"paranoid\",\n719\t  anchors: string[] | null,\n720\t): Promise<void> {\n721\t  const remoteIds = await remoteNoteIds(repo, remote);\n722\t\n723\t  const localEvents: EvidenceEvent[] = [];\n724\t  // Scan exactly what the push will carry. Before scoping this swept every\n725\t  // anchor, so a finding on a branch that was never going to be pushed still\n726\t  // blocked the push — which, given how often the flagged text is a\n727\t  // conversation *about* credential-shaped code, was a routine false block.\n728\t  for (const anchor of anchors ?? (await listAnchors(repo))) {\n729\t    localEvents.push(...(await readNoteEvents(repo, anchor)));\n730\t  }\n731\t  // Pending events are unanchored, so they are not in this push at all; they\n732\t  // are still scanned because they exist only before the first commit, when\n733\t  // there is nothing else to push anyway, and gating them early is the\n734\t  // conservative side to err on.\n735\t  localEvents.push(...(await readPending(repo)));\n736\t\n737\t  const candidates = remoteIds ? localEvents.filter((e) => !remoteIds.has(e.id)) : localEvents;\n738\t  if (candidates.length === 0) return;\n739\t\n740\t  const findings = filterFindings(scanEvents(candidates, tier), await loadAllowlist(repo));\n741\t  if (findings.length === 0) return;\n742\t\n743\t  const eventIds = [...new Set(findings.map((f) => f.eventId))];\n744\t  process.stderr.write(\n745\t    `cledger sync: blocked — ${findings.length} potential secret(s) across ` +\n746\t      `${eventIds.length} event(s) not yet on ${remote}\\n\\n`,\n747\t  );\n748\t  for (const f of findings) process.stderr.write(`  ${formatFinding(f)}\\n`);\n749\t  process.stderr.write(`\\n${findingGuidance(eventIds)}\\n`);\n750\t  process.stderr.write(\n751\t    \"\\nRemediate, then re-run sync:\\n\" +\n752\t      \"  cledger redact <event-id>     rewrite the event and remove the secret\\n\" +\n753\t      \"  cledger allow <fingerprint>   mark a fingerprint as a known false positive\\n\" +\n754\t      \"  cledger sync --no-scan        skip this gate for this sync only\\n\",\n755\t  );\n756\t  throw new ScanBlockedError(findings.length);\n757\t}\n758\t\n759\t/**\n760\t * Sync of the single ledger ref: explicit via `cledger sync`, or run by the\n761\t * pre-push transport hook (see transportPush). The fetch phase stages into\n762\t * INCOMING_REF and absorbs it — the same path a plain `git fetch` plus a\n763\t * later read takes.\n764\t */\n765\texport async function sync(\n766\t  repo: RepoInfo,\n767\t  remote = \"origin\",\n768\t  mode: \"both\" | \"push\" | \"fetch\" = \"both\",\n769\t  opts: { skipScan?: boolean; paranoid?: boolean; scope?: string | string[] | null } = {},\n770\t): Promise<SyncResult> {\n771\t  const result: SyncResult = { fetched: false, pushed: false, scopedAnchors: null };\n772\t  await ensureMergeConfig(repo);\n773\t  if (mode !== \"push\") {\n774\t    await git(\n775\t      [\"fetch\", remote, `+${NOTES_REF}:${INCOMING_REF}`],\n776\t      { cwd: repo.root, allowFailure: true },\n777\t    );\n778\t    result.fetched = await absorbIncoming(repo);\n779\t  }\n780\t  if (mode !== \"fetch\") {\n781\t    const config = await loadConfig(repo.root);\n782\t    // Scoped by default, to the current branch. `scope: null` opts out and\n783\t    // pushes the whole ledger — the pre-0.14.0 behavior. An empty array means\n784\t    // \"nothing in scope\", which is distinct from \"unscoped\" and must not\n785\t    // silently widen to everything.\n786\t    const scope = opts.scope === undefined ? [\"HEAD\"] : opts.scope;\n787\t    const revs = scope === null ? null : Array.isArray(scope) ? scope : [scope];\n788\t    const anchors = revs === null ? null : await anchorsForRevs(repo, revs);\n789\t    const scanDisabled = opts.skipScan === true || config.scan?.tier === \"off\";\n790\t    if (!scanDisabled) {\n791\t      const tier: \"standard\" | \"paranoid\" =\n792\t        opts.paranoid === true || config.scan?.tier === \"paranoid\" ? \"paranoid\" : \"standard\";\n793\t      await runScanGate(repo, remote, tier, anchors);\n794\t    }\n795\t    // The pushed child git inherits CLEDGER_INTERNAL, telling the pre-push\n796\t    // transport hook this push *is* the ledger push — no recursion.\n797\t    const prior = process.env[\"CLEDGER_INTERNAL\"];\n798\t    process.env[\"CLEDGER_INTERNAL\"] = \"1\";\n799\t    try {\n800\t      if (anchors === null) {\n801\t        await git([\"push\", remote, `${NOTES_REF}:${NOTES_REF}`], { cwd: repo.root });\n802\t      } else {\n803\t        await pushScopedNotes(repo, remote, anchors);\n804\t      }\n805\t    } finally {\n806\t      if (prior === undefined) delete process.env[\"CLEDGER_INTERNAL\"];\n807\t      else process.env[\"CLEDGER_INTERNAL\"] = prior;\n808\t    }\n809\t    result.pushed = true;\n810\t    result.scopedAnchors = anchors === null ? null : anchors.length;\n811\t  }\n812\t  return result;\n813\t}\n814\t\n815\texport interface TransportPushResult {\n816\t  pushed: boolean;\n817\t  /** True when scan findings held the ledger back (non-strict mode). */\n818\t  held: boolean;\n819\t}\n820\t\n821\t/**\n822\t * Local shas from git's pre-push stdin, which supplies one\n823\t * `<local ref> <local sha> <remote ref> <remote sha>` line per ref.\n824\t *\n825\t * The local sha is used rather than the local ref name because it is what\n826\t * git is actually pushing and needs no further resolution. A deletion sends\n827\t * an all-zero local sha and is skipped: there is no branch tip to scope to,\n828\t * and deleting a remote branch is not an occasion to share anything.\n829\t */\n830\texport function parsePrePushRefs(stdin: string): string[] {\n831\t  const revs: string[] = [];\n832\t  for (const line of stdin.split(\"\\n\")) {\n833\t    const parts = line.trim().split(/\\s+/);\n834\t    if (parts.length < 2) continue;\n835\t    const localSha = parts[1]!;\n836\t    if (!/^[0-9a-f]{40,64}$/.test(localSha)) continue;\n837\t    if (/^0+$/.test(localSha)) continue; // ref deletion\n838\t    revs.push(localSha);\n839\t  }\n840\t  return revs;\n841\t}\n842\t\n843\t/**\n844\t * Pre-push hook entrypoint policy. Pushes the ledger ref alongside the\n845\t * user's own push, scoped to the refs git is actually pushing.\n846\t *\n847\t * `revs` comes from git's pre-push stdin (see `parsePrePushRefs`), so\n848\t * `git push origin some-branch` shares that branch's conversations even when\n849\t * it is not the one checked out. It falls back to `HEAD` only when stdin\n850\t * carried nothing usable — an old installed hook that still redirects\n851\t * `</dev/null`, or a manual invocation.\n852\t *\n853\t * A scan finding blocks only the ledger by default —\n854\t * secrets never leave the machine, but a false positive never blocks\n855\t * shipping code; {\"transport\": {\"strict\": true}} escalates to aborting the\n856\t * whole push (rethrows ScanBlockedError; the CLI exits nonzero). Any other\n857\t * failure (network, missing remote ref perms) warns and lets the push\n858\t * proceed — the hook must never make `git push` flaky.\n859\t */\n860\texport async function transportPush(\n861\t  repo: RepoInfo,\n862\t  remote: string,\n863\t  revs?: string[],\n864\t): Promise<TransportPushResult> {\n865\t  const config = await loadConfig(repo.root);\n866\t  if (config.transport?.hook === false) return { pushed: false, held: false };\n867\t  const hasNotes = (await git([\"rev-parse\", \"--verify\", \"--quiet\", NOTES_REF], {\n868\t    cwd: repo.root,\n869\t    allowFailure: true,\n870\t  })).trim();\n871\t  if (!hasNotes) return { pushed: false, held: false };\n872\t\n873\t  try {\n874\t    // No usable refs (deletes only, or an old hook that ate stdin): fall back\n875\t    // to the checked-out branch rather than to the whole ledger.\n876\t    await sync(repo, remote, \"push\", { scope: revs && revs.length > 0 ? revs : [\"HEAD\"] });\n877\t    return { pushed: true, held: false };\n878\t  } catch (err) {\n879\t    if (err instanceof ScanBlockedError) {\n880\t      if (config.transport?.strict === true) throw err;\n881\t      process.stderr.write(\n882\t        \"cledger: conversation records were held back from this push (potential secrets — \" +\n883\t          \"see report above); your code push continues. Run `cledger sync` to review and \" +\n884\t          \"remediate.\\n\",\n885\t      );\n886\t      return { pushed: false, held: true };\n887\t    }\n888\t    process.stderr.write(\n889\t      `cledger: ledger push skipped (${err instanceof Error ? err.message : String(err)})\\n`,\n890\t    );\n891\t    return { pushed: false, held: false };\n892\t  }\n893\t}\n894\t\n895\tinterface LocatedEvent {\n896\t  event: EvidenceEvent;\n897\t  /** Anchor commit holding the note line, or null when the event is still in pending.jsonl. */\n898\t  anchor: string | null;\n899\t  /** Full line array of the containing note (or of pending.jsonl), for in-place rewrite. */\n900\t  lines: string[];\n901\t  index: number;\n902\t}\n903\t\n904\tfunction idMatchesPrefix(id: string, prefix: string): boolean {\n905\t  if (id.startsWith(prefix)) return true;\n906\t  const hash = id.startsWith(\"ev1-\") ? id.slice(4) : id;\n907\t  return hash.startsWith(prefix);\n908\t}\n909\t\n910\t/** Find the one event matching `idPrefix` across every anchor and the pending queue. */\n911\tasync function locateEvent(repo: RepoInfo, idPrefix: string): Promise<LocatedEvent> {\n912\t  const matches: LocatedEvent[] = [];\n913\t\n914\t  for (const anchor of await listAnchors(repo)) {\n915\t    const lines = await readNoteLines(repo, anchor);\n916\t    lines.forEach((line, index) => {\n917\t      const event = parseEventLine(line);\n918\t      if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor, lines, index });\n919\t    });\n920\t  }\n921\t\n922\t  const pendingFile = pendingPath(repo);\n923\t  const pendingLines = existsSync(pendingFile)\n924\t    ? (await readFile(pendingFile, \"utf8\")).split(\"\\n\").filter((l) => l.trim().length > 0)\n925\t    : [];\n926\t  pendingLines.forEach((line, index) => {\n927\t    const event = parseEventLine(line);\n928\t    if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor: null, lines: pendingLines, index });\n929\t  });\n930\t\n931\t  if (matches.length === 0) {\n932\t    throw new Error(`cledger redact: no event matches id prefix \"${idPrefix}\"`);\n933\t  }\n934\t  if (matches.length > 1) {\n935\t    throw new Error(\n936\t      `cledger redact: id prefix \"${idPrefix}\" is ambiguous (${matches.length} matches: ` +\n937\t        `${matches.map((m) => m.event.id).join(\", \")})`,\n938\t    );\n939\t  }\n940\t  return matches[0]!;\n941\t}\n942\t\n943\texport interface RedactResult {\n944\t  /** The rewritten event, with the secret removed. */\n945\t  event: EvidenceEvent;\n946\t  /** The companion `redaction` event recording why `event`'s content no longer matches its id. */\n947\t  redactionEvent: EvidenceEvent;\n948\t  /** True when the pre-redaction notes history was squashed away locally (see below). */\n949\t  squashed: boolean;\n950\t  /**\n951\t   * Count of newly-remembered secret values written to the opt-in\n952\t   * known-secrets store (0 unless `redact.knownSecrets` is on and this was a\n953\t   * `--pattern` redaction that matched at least one not-already-known value).\n954\t   */\n955\t  knownSecretsRemembered: number;\n956\t}\n957\t\n958\t/**\n959\t * Human redaction of an *existing* event (layer E's remediation path, as\n960\t * opposed to capture-time redaction in redact/apply.ts). Locates the event\n961\t * by id prefix, rewrites its content in place, appends a companion\n962\t * `redaction` event, and — when the pre-redaction content was never\n963\t * pushed — squashes the local notes ref history so the old blob becomes\n964\t * unreachable.\n965\t */\n966\texport async function redactEvent(\n967\t  repo: RepoInfo,\n968\t  idPrefix: string,\n969\t  opts: { pattern?: string; all?: boolean; reason?: string },\n970\t): Promise<RedactResult> {\n971\t  const hasPattern = typeof opts.pattern === \"string\" && opts.pattern.length > 0;\n972\t  const hasAll = opts.all === true;\n973\t  if (hasPattern === hasAll) {\n974\t    throw new Error(\"cledger redact: exactly one of --pattern or --all is required\");\n975\t  }\n976\t\n977\t  // Opt-in: when on, remember the exact values a --pattern redaction scrubs so\n978\t  // capture-time redaction can keep them out of future events (see\n979\t  // redact/known-secrets.ts). The --all path blanks whole content, so there is\n980\t  // no reusable value to remember there.\n981\t  const config = await loadConfig(repo.root);\n982\t  const rememberSecrets = hasPattern && config.redact?.knownSecrets === true;\n983\t\n984\t  const { located, rewritten, newRecords, secretValues } = await withLock(repo, async () => {\n985\t    const located = await locateEvent(repo, idPrefix);\n986\t    const original = located.event;\n987\t\n988\t    let rewrittenContent: unknown = original.content;\n989\t    let rewrittenRaw = original.raw;\n990\t    const newRecords: RedactionRecord[] = [];\n991\t    const secretValues: string[] = [];\n992\t\n993\t    if (hasPattern) {\n994\t      let pattern: RegExp;\n995\t      try {\n996\t        pattern = new RegExp(opts.pattern!, \"g\");\n997\t      } catch (err) {\n998\t        throw new Error(\n999\t          `cledger redact: invalid --pattern regex: ${err instanceof Error ? err.message : String(err)}`,\n1000\t        );\n1001\t      }\n1002\t      const rule: RedactionRule = {\n1003\t        id: \"manual\",\n1004\t        tier: \"capture\",\n1005\t        description: \"Manually specified redaction pattern\",\n1006\t        pattern,\n1007\t      };\n1008\t      const { draft: patched, records } = redactDraft(original, { rules: [rule] });\n1009\t      if (records.length === 0) {\n1010\t        throw new Error(`cledger redact: --pattern matched nothing in event ${original.id}`);\n1011\t      }\n1012\t      rewrittenContent = patched.content;\n1013\t      rewrittenRaw = patched.raw;\n1014\t      newRecords.push(...records);\n1015\t      if (rememberSecrets) {\n1016\t        secretValues.push(...collectMatches(original.content, pattern));\n1017\t        if (original.raw) secretValues.push(...collectMatches(original.raw.data, pattern));\n1018\t      }\n1019\t    } else {\n1020\t      const fingerprint = sha256Hex(canonicalJson(original.content)).slice(0, 12);\n1021\t      rewrittenContent = `[REDACTED:manual:${fingerprint}]`;\n1022\t      rewrittenRaw = undefined;\n1023\t      newRecords.push({ rule: \"manual\", ruleset: RULESET_VERSION, fingerprint, path: \"content\" });\n1024\t    }\n1025\t\n1026\t    // CRITICAL: this draft carries `original.id` explicitly, and\n1027\t    // finalizeEvent below (`draft.id ?? eventId(draft)`) preserves a\n1028\t    // supplied id rather than recomputing it. If the id were recomputed\n1029\t    // here from the rewritten (secret-free) content, it would no longer\n1030\t    // match the id a fresh capture of the *original* source material would\n1031\t    // produce — so a later transcript rescan (ids are a pure function of\n1032\t    // source content; that's what makes capture idempotent) would\n1033\t    // regenerate the original, unredacted event under its old id, dedup\n1034\t    // would no longer recognize it as \"already seen\" against this\n1035\t    // rewritten line, and the secret would silently reappear in the\n1036\t    // ledger. Keeping the id stable means the rewritten line permanently\n1037\t    // occupies that id slot — any rescan producing the same id dedups\n1038\t    // against it instead. The companion `redaction` event appended below\n1039\t    // is what records why this event's content no longer matches what its\n1040\t    // id would normally imply.\n1041\t    const rewrittenDraft: EventDraft = {\n1042\t      ...original,\n1043\t      id: original.id,\n1044\t      content: rewrittenContent,\n1045\t      redactions: [...(original.redactions ?? []), ...newRecords],\n1046\t    };\n1047\t    if (rewrittenRaw === undefined) delete rewrittenDraft.raw;\n1048\t    else rewrittenDraft.raw = rewrittenRaw;\n1049\t\n1050\t    const rewritten = finalizeEvent(rewrittenDraft);\n1051\t    if (rewritten.id !== original.id) {\n1052\t      // Should be unreachable given the explicit `id: original.id` above;\n1053\t      // guarded because a dedup break here is exactly the failure mode the\n1054\t      // comment above exists to prevent.\n1055\t      throw new Error(\"cledger redact: internal error — rewritten event id drifted from the original\");\n1056\t    }\n1057\t\n1058\t    const newLines = [...located.lines];\n1059\t    newLines[located.index] = serializeEvent(rewritten);\n1060\t    if (located.anchor !== null) {\n1061\t      newLines.sort();\n1062\t      await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", located.anchor], {\n1063\t        cwd: repo.root,\n1064\t        input: newLines.join(\"\\n\") + \"\\n\",\n1065\t      });\n1066\t    } else {\n1067\t      await ensureStateDir(repo);\n1068\t      await writeFile(pendingPath(repo), newLines.join(\"\\n\") + \"\\n\");\n1069\t    }\n1070\t\n1071\t    return { located, rewritten, newRecords, secretValues };\n1072\t  });\n1073\t\n1074\t  // Persist remembered secret values outside the notes lock (the store is its\n1075\t