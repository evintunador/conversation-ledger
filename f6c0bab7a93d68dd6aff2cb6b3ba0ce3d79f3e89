{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\timport { readFileSync } from \"node:fs\";\n3\timport { stdin as input } from \"node:process\";\n4\timport { findRepo, type RepoInfo } from \"./git.js\";\n5\timport {\n6\t  appendEvents,\n7\t  manualReAnchor,\n8\t  readEvents,\n9\t  redactEvent,\n10\t  runReAnchor,\n11\t  ScanBlockedError,\n12\t  sortEvents,\n13\t  sync,\n14\t  parsePrePushRefs,\n15\t  transportPush,\n16\t  type ReadOptions,\n17\t} from \"./store.js\";\n18\timport { parseEventLine, type EventDraft, type EvidenceEvent } from \"./schema.js\";\n19\timport { runClaudeCodeHook, captureClaudeTranscript } from \"./adapters/claude-code.js\";\n20\timport { runCodexHook, captureCodexTranscript } from \"./adapters/codex.js\";\n21\timport { renormalize } from \"./renormalize.js\";\n22\timport { installAdapters } from \"./install.js\";\n23\timport { forgeForRepo } from \"./forge/forge.js\";\n24\timport { suggestMappings } from \"./reanchor-suggest.js\";\n25\timport { loadConfig } from \"./redact/config.js\";\n26\timport {\n27\t  addToAllowlist,\n28\t  filterFindings,\n29\t  findingGuidance,\n30\t  formatFinding,\n31\t  inAgentSession,\n32\t  loadAllowlist,\n33\t  renderFinding,\n34\t  scanEvents,\n35\t} from \"./redact/scan.js\";\n36\t\n37\tconst USAGE = `conversation-ledger — durable records of coding-agent conversations, in git notes\n38\t\n39\tUsage:\n40\t  cledger append [--quiet]                 append JSONL events/drafts from stdin\n41\t  cledger log [--all|--rev R] [--kind K] [--source S] [--model M] [--conversation C] [--json]\n42\t              [--with-reasoning]           --model matches producer.model exactly, e.g. gpt-5.6-sol\n43\t  cledger show <conversation-id-prefix> [--json] [--with-reasoning]\n44\t                                           opaque provider-encrypted \\`reasoning\\` events are hidden\n45\t                                           by default on log/show; --with-reasoning reveals them\n46\t  cledger conversations [--rev R] [--with-reasoning]\n47\t                                           list conversations on current branch (--all for every branch),\n48\t                                           one line each: id, source, model(s), count, time span\n49\t  cledger export [--rev R]                lossless JSONL dump (default: everything, incl. reasoning)\n50\t  cledger sync [--remote R] [--push|--fetch] [--no-scan] [--paranoid] [--all|--rev R]\n51\t                                           fetch/merge/push of the ledger ref;\n52\t                                           push is gated by a secret scan unless --no-scan.\n53\t                                           Push carries only conversations reachable from the\n54\t                                           current branch; --all pushes the whole ledger,\n55\t                                           --rev scopes to another branch/commit\n56\t  cledger transport-push [remote]         pre-push hook entrypoint (installed automatically):\n57\t                                           pushes the ledger ref alongside git push, scoped to the\n58\t                                           refs being pushed (read from git's pre-push stdin;\n59\t                                           falls back to HEAD); scan findings hold back only the\n60\t                                           ledger unless transport.strict\n61\t  cledger scan [--all|--rev R] [--paranoid]   scan local events for potential secrets (CI-friendly:\n62\t                                           exits 1 if any finding, 0 otherwise); default scope is\n63\t                                           every local event, --rev restricts by reachability\n64\t  cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\n65\t                                           show a finding with real surrounding context (default 400\n66\t                                           chars each side). Writes to a file outside the repo and\n67\t                                           refuses to run inside a coding-agent session — reports\n68\t                                           never print content, because reprinting it re-seeds the\n69\t                                           finding. HUMANS ONLY, in a plain terminal.\n70\t  cledger allow <fingerprint...>          mark scan finding fingerprint(s) as known false positives\n71\t  cledger redact <event-id-prefix> (--pattern REGEX | --all) [--reason TEXT]\n72\t                                           rewrite an existing event to remove a secret, keeping its\n73\t                                           id stable, and squash local notes history if unpushed\n74\t  cledger re-anchor [--apply] [--target R] [--no-forge]\n75\t                                           detect branches squash-merged/rewritten onto the remote\n76\t                                           default branch and map their conversations to the\n77\t                                           surviving commits (dry-run by default; exact matches\n78\t                                           also auto-apply on read unless reanchor.auto is false).\n79\t                                           Inexact cases get evidence-ranked suggestions — forge PR\n80\t                                           metadata via your own gh session, commit-message\n81\t                                           corroboration, per-file content match — never auto-applied\n82\t  cledger re-anchor <old-rev...> --onto REV   assert one mapping manually (edited squashes,\n83\t                                           deleted branches, ambiguous matches)\n84\t  cledger renormalize                      re-interpret preserved unrecognized transcript lines this\n85\t                                           cledger version can now parse into conversation_turns,\n86\t                                           superseding the raw-only placeholders (append-only, idempotent)\n87\t  cledger install <claude-code|codex|all>  hook capture into coding CLIs (global)\n88\t  cledger hook <claude-code>              capture entrypoint invoked by CLI hooks (stdin: hook payload)\n89\t  cledger capture <claude-code|codex> --transcript PATH   manual/backfill ingestion\n90\t  cledger --version | --help\n91\t\n92\tEvents are anchored to the HEAD commit at capture time and stored under\n93\trefs/notes/conversation-ledger, so they follow branches through merges and\n94\tsync only when you say so.`;\n95\t\n96\tfunction version(): string {\n97\t  const pkg = JSON.parse(\n98\t    readFileSync(new URL(\"../package.json\", import.meta.url), \"utf8\"),\n99\t  ) as { version: string };\n100\t  return pkg.version;\n101\t}\n102\t\n103\tinterface Flags {\n104\t  [key: string]: string | boolean;\n105\t}\n106\t\n107\tfunction parseArgs(argv: string[]): { positional: string[]; flags: Flags } {\n108\t  const positional: string[] = [];\n109\t  const flags: Flags = {};\n110\t  for (let i = 0; i < argv.length; i++) {\n111\t    const arg = argv[i]!;\n112\t    if (arg.startsWith(\"--\")) {\n113\t      const name = arg.slice(2);\n114\t      const next = argv[i + 1];\n115\t      if (next !== undefined && !next.startsWith(\"--\")) {\n116\t        flags[name] = next;\n117\t        i++;\n118\t      } else {\n119\t        flags[name] = true;\n120\t      }\n121\t    } else {\n122\t      positional.push(arg);\n123\t    }\n124\t  }\n125\t  return { positional, flags };\n126\t}\n127\t\n128\tasync function requireRepo(): Promise<RepoInfo> {\n129\t  const repo = await findRepo(process.cwd());\n130\t  if (!repo) {\n131\t    process.stderr.write(\"cledger: not inside a git repository\\n\");\n132\t    process.exit(2);\n133\t  }\n134\t  return repo;\n135\t}\n136\t\n137\tasync function readStdin(): Promise<string> {\n138\t  const chunks: Buffer[] = [];\n139\t  for await (const chunk of input) chunks.push(chunk as Buffer);\n140\t  return Buffer.concat(chunks).toString(\"utf8\");\n141\t}\n142\t\n143\tfunction readOptionsFrom(flags: Flags): ReadOptions {\n144\t  const opts: ReadOptions = {};\n145\t  if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n146\t  if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n147\t  if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n148\t  if (typeof flags[\"model\"] === \"string\") opts.model = flags[\"model\"];\n149\t  if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n150\t  return opts;\n151\t}\n152\t\n153\tfunction snippet(event: EvidenceEvent): string {\n154\t  const c = event.content as Record<string, unknown> | string | null;\n155\t  let text = \"\";\n156\t  if (typeof c === \"string\") text = c;\n157\t  else if (c && typeof c === \"object\") {\n158\t    text = String(c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"] ?? JSON.stringify(c));\n159\t  }\n160\t  text = text.replace(/\\s+/g, \" \").trim();\n161\t  return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n162\t}\n163\t\n164\tfunction printHuman(events: EvidenceEvent[]): void {\n165\t  for (const e of events) {\n166\t    const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n167\t    const role =\n168\t      (e.content as Record<string, unknown> | null | undefined) &&\n169\t      typeof e.content === \"object\"\n170\t        ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n171\t        : e.actor.type;\n172\t    process.stdout.write(\n173\t      `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n174\t    );\n175\t  }\n176\t}\n177\t\n178\t/**\n179\t * `reasoning` events are opaque ciphertext, never meant for a human-facing\n180\t * transcript — `log`/`show` hide them by default. `--with-reasoning` opts\n181\t * in, as does asking for the kind explicitly via `--kind reasoning` (hiding\n182\t * them there would just return nothing). `export`'s job is a lossless dump,\n183\t * so it never filters by kind and needs no equivalent flag.\n184\t */\n185\tfunction includeReasoning(flags: Flags, opts: ReadOptions): boolean {\n186\t  return flags[\"with-reasoning\"] === true || opts.kind === \"reasoning\";\n187\t}\n188\t\n189\tfunction hideOpaqueReasoning(events: EvidenceEvent[]): EvidenceEvent[] {\n190\t  return events.filter((e) => e.kind !== \"reasoning\");\n191\t}\n192\t\n193\tfunction printJsonl(events: EvidenceEvent[], includeRaw: boolean): void {\n194\t  for (const e of events) {\n195\t    const out = includeRaw ? e : { ...e, raw: undefined };\n196\t    process.stdout.write(JSON.stringify(out) + \"\\n\");\n197\t  }\n198\t}\n199\t\n200\tasync function cmdAppend(flags: Flags): Promise<void> {\n201\t  const repo = await requireRepo();\n202\t  const body = await readStdin();\n203\t  const drafts: EventDraft[] = body\n204\t    .split(\"\\n\")\n205\t    .filter((l) => l.trim())\n206\t    .map((l) => JSON.parse(l) as EventDraft);\n207\t  if (drafts.length === 0) return;\n208\t  const result = await appendEvents(repo, drafts);\n209\t  if (!flags[\"quiet\"]) {\n210\t    for (const e of result.appended) process.stdout.write(e.id + \"\\n\");\n211\t    process.stderr.write(\n212\t      `appended ${result.appended.length}, deduped ${result.deduped}` +\n213\t        (result.anchor ? ` (anchor ${result.anchor.slice(0, 12)})` : \" (pending: no commits yet)\") +\n214\t        \"\\n\",\n215\t    );\n216\t  }\n217\t}\n218\t\n219\tasync function cmdLog(flags: Flags): Promise<void> {\n220\t  const repo = await requireRepo();\n221\t  const opts = readOptionsFrom(flags);\n222\t  let events = await readEvents(repo, opts);\n223\t  if (!includeReasoning(flags, opts)) events = hideOpaqueReasoning(events);\n224\t  if (flags[\"json\"]) printJsonl(events, false);\n225\t  else printHuman(events);\n226\t}\n227\t\n228\tasync function cmdShow(positional: string[], flags: Flags): Promise<void> {\n229\t  const prefix = positional[0];\n230\t  if (!prefix) {\n231\t    process.stderr.write(\"usage: cledger show <conversation-id-prefix>\\n\");\n232\t    process.exit(2);\n233\t  }\n234\t  const repo = await requireRepo();\n235\t  let events = await readEvents(repo, { conversation: prefix });\n236\t  if (!includeReasoning(flags, {})) events = hideOpaqueReasoning(events);\n237\t  if (events.length === 0) {\n238\t    process.stderr.write(`no events for conversation ${prefix}\\n`);\n239\t    process.exit(1);\n240\t  }\n241\t  if (flags[\"json\"]) {\n242\t    printJsonl(events, true);\n243\t    return;\n244\t  }\n245\t  for (const e of sortEvents(events)) {\n246\t    const c = e.content as Record<string, unknown>;\n247\t    const role = typeof c === \"object\" && c ? String(c[\"role\"] ?? e.actor.type) : e.actor.type;\n248\t    const text =\n249\t      typeof c === \"object\" && c && typeof c[\"text\"] === \"string\"\n250\t        ? (c[\"text\"] as string)\n251\t        : JSON.stringify(e.content, null, 2);\n252\t    process.stdout.write(`\\n[${e.occurred_at}] ${role} (${e.kind}, ${e.id.slice(0, 16)})\\n`);\n253\t    process.stdout.write(text.trimEnd() + \"\\n\");\n254\t  }\n255\t}\n256\t\n257\tasync function cmdConversations(flags: Flags): Promise<void> {\n258\t  const repo = await requireRepo();\n259\t  const opts = readOptionsFrom(flags);\n260\t  let events = await readEvents(repo, opts);\n261\t  if (!includeReasoning(flags, opts)) events = hideOpaqueReasoning(events);\n262\t  const byConv = new Map<\n263\t    string,\n264\t    { count: number; first: string; last: string; source: string; models: Set<string> }\n265\t  >();\n266\t  for (const e of events) {\n267\t    const id = e.conversation?.id ?? \"(none)\";\n268\t    const entry = byConv.get(id) ?? {\n269\t      count: 0,\n270\t      first: e.occurred_at,\n271\t      last: e.occurred_at,\n272\t      source: e.producer.source ?? e.producer.tool,\n273\t      models: new Set<string>(),\n274\t    };\n275\t    entry.count++;\n276\t    // A conversation can legitimately list several models — codex restates\n277\t    // `turn_context` when the user switches mid-session, and a claude-code\n278\t    // session mixes real model ids with `<synthetic>` harness messages.\n279\t    if (e.producer.model) entry.models.add(e.producer.model);\n280\t    if (e.occurred_at < entry.first) entry.first = e.occurred_at;\n281\t    if (e.occurred_at > entry.last) entry.last = e.occurred_at;\n282\t    byConv.set(id, entry);\n283\t  }\n284\t  for (const [id, s] of [...byConv.entries()].sort((a, b) => a[1].last.localeCompare(b[1].last))) {\n285\t    const models = s.models.size > 0 ? [...s.models].sort().join(\",\") : \"-\";\n286\t    process.stdout.write(\n287\t      `${id}  ${s.source}  ${models}  ${s.count} events  ${s.first} .. ${s.last}\\n`,\n288\t    );\n289\t  }\n290\t}\n291\t\n292\tasync function cmdExport(flags: Flags): Promise<void> {\n293\t  const repo = await requireRepo();\n294\t  const opts: ReadOptions = {};\n295\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n296\t  const events = await readEvents(repo, opts);\n297\t  printJsonl(events, true);\n298\t}\n299\t\n300\tasync function cmdSync(flags: Flags): Promise<void> {\n301\t  const repo = await requireRepo();\n302\t  const remote = typeof flags[\"remote\"] === \"string\" ? flags[\"remote\"] : \"origin\";\n303\t  const mode = flags[\"push\"] ? \"push\" : flags[\"fetch\"] ? \"fetch\" : \"both\";\n304\t  // Push is scoped to the current branch by default; --all restores the\n305\t  // pre-0.14.0 whole-ledger push, --rev scopes to something else.\n306\t  const scope: string | null = flags[\"all\"] === true\n307\t    ? null\n308\t    : typeof flags[\"rev\"] === \"string\"\n309\t      ? flags[\"rev\"]\n310\t      : \"HEAD\";\n311\t  const result = await sync(repo, remote, mode, {\n312\t    skipScan: flags[\"no-scan\"] === true,\n313\t    paranoid: flags[\"paranoid\"] === true,\n314\t    scope,\n315\t  });\n316\t  const pushed = !result.pushed\n317\t    ? \"not pushed\"\n318\t    : result.scopedAnchors === null\n319\t      ? \"pushed (whole ledger)\"\n320\t      : `pushed (${result.scopedAnchors} commit(s) in scope)`;\n321\t  process.stderr.write(\n322\t    `sync ${remote}: ${result.fetched ? \"fetched+merged\" : \"nothing fetched\"}, ${pushed}\\n`,\n323\t  );\n324\t}\n325\t\n326\tasync function cmdTransportPush(positional: string[]): Promise<void> {\n327\t  const repo = await findRepo(process.cwd());\n328\t  if (!repo) return; // a hook must never fail the user's push\n329\t  const remote = positional[0] || \"origin\";\n330\t  // git's pre-push hook pipes the refs being pushed. Only read when stdin is\n331\t  // actually a pipe: a manual `cledger transport-push` from a terminal would\n332\t  // otherwise block forever waiting on a human who has nothing to type.\n333\t  let revs: string[] = [];\n334\t  if (process.stdin.isTTY !== true) {\n335\t    try {\n336\t      revs = parsePrePushRefs(await readStdin());\n337\t    } catch {\n338\t      revs = []; // unreadable stdin must never fail the user's push\n339\t    }\n340\t  }\n341\t  try {\n342\t    await transportPush(repo, remote, revs);\n343\t  } catch (err) {\n344\t    if (err instanceof ScanBlockedError) {\n345\t      // transport.strict: nonzero exit makes git abort the entire push.\n346\t      process.stderr.write(\"cledger: entire push blocked (transport.strict is enabled)\\n\");\n347\t      process.exit(1);\n348\t    }\n349\t    // Anything else is a cledger bug or environment problem; the user's\n350\t    // code push must proceed regardless.\n351\t    process.stderr.write(\n352\t      `cledger: transport-push error (push continues): ${err instanceof Error ? err.message : String(err)}\\n`,\n353\t    );\n354\t  }\n355\t}\n356\t\n357\tasync function cmdScan(flags: Flags): Promise<void> {\n358\t  const repo = await requireRepo();\n359\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n360\t  const opts: ReadOptions = {};\n361\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n362\t  const events = await readEvents(repo, opts);\n363\t  const findings = filterFindings(scanEvents(events, tier), await loadAllowlist(repo));\n364\t  if (findings.length === 0) {\n365\t    process.stderr.write(\"cledger scan: no findings\\n\");\n366\t    return;\n367\t  }\n368\t  for (const f of findings) process.stdout.write(formatFinding(f) + \"\\n\");\n369\t  const eventIds = [...new Set(findings.map((f) => f.eventId))];\n370\t  process.stderr.write(`\\n${findingGuidance(eventIds)}\\n`);\n371\t  process.stderr.write(\n372\t    `\\ncledger scan: ${findings.length} finding(s) across ${eventIds.length} event(s)\\n`,\n373\t  );\n374\t  process.exit(1);\n375\t}\n376\t\n377\t/**\n378\t * Show a finding with enough surrounding text to actually judge it — the\n379\t * counterpart to `formatFinding`'s deliberately contentless report.\n380\t *\n381\t * Two guards, both load-bearing rather than decorative. It refuses to run\n382\t * inside a coding-agent session, because an agent investigating a blocked sync\n383\t * would otherwise read the flagged text into the transcript and mint a fresh\n384\t * event carrying it. And it writes to a file outside the repo by default\n385\t * rather than to stdout, so the content does not pass through a terminal that\n386\t * something else may be recording.\n387\t */\n388\tasync function cmdInspect(positional: string[], flags: Flags): Promise<void> {\n389\t  if (positional.length === 0) {\n390\t    process.stderr.write(\n391\t      \"usage: cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\\n\",\n392\t    );\n393\t    process.exit(2);\n394\t  }\n395\t  const agentVar = inAgentSession();\n396\t  if (agentVar && !flags[\"force\"]) {\n397\t    process.stderr.write(\n398\t      `cledger inspect: refusing to run inside a coding-agent session (saw $${agentVar}).\\n\\n` +\n399\t        \"  Reading flagged content here would capture it into this conversation and\\n\" +\n400\t        \"  re-seed the finding you are inspecting. Run this in a plain terminal.\\n\\n\" +\n401\t        \"  --force overrides, and is almost always the wrong call.\\n\",\n402\t    );\n403\t    process.exit(2);\n404\t  }\n405\t\n406\t  const repo = await requireRepo();\n407\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n408\t  const prefix = positional[0]!;\n409\t  const context = typeof flags[\"context\"] === \"string\" ? Number(flags[\"context\"]) : 400;\n410\t  if (!Number.isFinite(context) || context < 0) {\n411\t    process.stderr.write(\"cledger inspect: --context must be a non-negative number\\n\");\n412\t    process.exit(2);\n413\t  }\n414\t  const reveal = Boolean(flags[\"reveal\"]);\n415\t\n416\t  const events = await readEvents(repo);\n417\t  const matched = events.filter((e) => e.id.startsWith(prefix));\n418\t  if (matched.length === 0) {\n419\t    process.stderr.write(`cledger inspect: no event matching id prefix ${prefix}\\n`);\n420\t    process.exit(1);\n421\t  }\n422\t\n423\t  // Deliberately not allowlist-filtered: inspecting is exactly how you decide\n424\t  // whether something *should* be allowlisted, and re-checking an old decision\n425\t  // is legitimate.\n426\t  const findings = scanEvents(matched, tier);\n427\t  if (findings.length === 0) {\n428\t    process.stderr.write(\n429\t      `cledger inspect: no findings in ${matched.length} matching event(s) at the ${tier} tier\\n`,\n430\t    );\n431\t    return;\n432\t  }\n433\t\n434\t  const byId = new Map(matched.map((e) => [e.id, e]));\n435\t  const body = [\n436\t    `cledger inspect — ${findings.length} finding(s) in ${matched.length} event(s)`,\n437\t    `context: ${context} chars each side | matched text: ${reveal ? \"REVEALED\" : \"masked\"}`,\n438\t    \"\",\n439\t    \"This file contains raw conversation content and possibly a real secret.\",\n440\t    \"Delete it when you are done, and do not paste it into an agent session.\",\n441\t    \"\",\n442\t    ...findings.map((f) => renderFinding(byId.get(f.eventId)!, f, { context, reveal })),\n443\t  ].join(\"\\n\");\n444\t\n445\t  if (flags[\"stdout\"]) {\n446\t    process.stdout.write(body);\n447\t    return;\n448\t  }\n449\t  const { mkdtemp, writeFile } = await import(\"node:fs/promises\");\n450\t  const { tmpdir } = await import(\"node:os\");\n451\t  const { join } = await import(\"node:path\");\n452\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-inspect-\"));\n453\t  const out = join(dir, `${prefix.slice(0, 16)}.txt`);\n454\t  await writeFile(out, body, { mode: 0o600 });\n455\t  process.stderr.write(\n456\t    `${findings.length} finding(s) written to:\\n  ${out}\\n\\n` +\n457\t      \"Open it in an editor, then delete it. Re-run with --reveal to include the\\n\" +\n458\t      \"matched text itself, or --context N to widen the surrounding text.\\n\",\n459\t  );\n460\t}\n461\t\n462\tasync function cmdAllow(positional: string[]): Promise<void> {\n463\t  if (positional.length === 0) {\n464\t    process.stderr.write(\"usage: cledger allow <fingerprint...>\\n\");\n465\t    process.exit(2);\n466\t  }\n467\t  const repo = await requireRepo();\n468\t  await addToAllowlist(repo, positional);\n469\t  process.stderr.write(`allowlisted ${positional.length} fingerprint(s)\\n`);\n470\t}\n471\t\n472\tasync function cmdRedact(positional: string[], flags: Flags): Promise<void> {\n473\t  const idPrefix = positional[0];\n474\t  if (!idPrefix) {\n475\t    process.stderr.write(\"usage: cledger redact <event-id-prefix> (--pattern REGEX | --all) [--reason TEXT]\\n\");\n476\t    process.exit(2);\n477\t  }\n478\t  const repo = await requireRepo();\n479\t  const redactOpts: { pattern?: string; all?: boolean; reason?: string } = {};\n480\t  if (typeof flags[\"pattern\"] === \"string\") redactOpts.pattern = flags[\"pattern\"];\n481\t  if (flags[\"all\"