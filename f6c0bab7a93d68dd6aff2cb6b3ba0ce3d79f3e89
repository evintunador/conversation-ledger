self for when this installation moves.\n44\t */\n45\tfunction cledgerInvocation(): { node: string; cli: string } {\n46\t  return {\n47\t    node: process.execPath,\n48\t    cli: fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n49\t  };\n50\t}\n51\t\n52\t/**\n53\t * The block cledger owns inside `pre-push`, delimited by HOOK_MARKER so it can\n54\t * be recognized, upgraded, and removed without touching the rest of the file.\n55\t *\n56\t * The hook is fed git's pre-push stdin — one `<local ref> <local sha> <remote\n57\t * ref> <remote sha>` line per ref being pushed — so the ledger push can be\n58\t * scoped to the refs actually being pushed rather than to whatever happens to\n59\t * be checked out. Before 0.15.0 this was `</dev/null` and the scope fell back\n60\t * to `HEAD`, which meant `git push origin some-other-branch` shared nothing of\n61\t * that branch.\n62\t *\n63\t * Consuming that stdin has a cost worth being explicit about: a `pre-push`\n64\t * script's stdin can only be read once, so anything chained *after* this\n65\t * block finds it exhausted. In practice that is nearly always fine, because\n66\t * `installHook` appends this block to the end of an existing hook — an\n67\t * existing script runs, and reads stdin, before this block does. When it\n68\t * does read stdin first, this block's `$(cat)` comes back empty and the\n69\t * scope falls back to `HEAD`, which is the pre-0.15.0 behavior rather than a\n70\t * failure. Only hand-editing content in after this block loses the ref list,\n71\t * and restoring it would mean spilling stdin to a temp file and `exec`-ing it\n72\t * back onto fd 0 — more machinery in every user's hook than that case earns.\n73\t */\n74\tfunction hookBlock(): string {\n75\t  const { node, cli } = cledgerInvocation();\n76\t  return [\n77\t    `# >>> ${HOOK_MARKER} (added by cledger) >>>`,\n78\t    `# Shares this repo's conversation records (${NOTES_REF}) when you push.`,\n79\t    `# Scoped to the refs being pushed, read from git's pre-push stdin.`,\n80\t    `# Delete this block to disable, or set {\"transport\": {\"hook\": false}} in`,\n81\t    `# .cledger.json / ~/.config/cledger/config.json.`,\n82\t    `if [ -z \"$CLEDGER_INTERNAL\" ]; then`,\n83\t    `  _cledger_refs=$(cat)`,\n84\t    `  if [ -x \"${node}\" ] && [ -e \"${cli}\" ]; then`,\n85\t    `    printf '%s\\\\n' \"$_cledger_refs\" | \"${node}\" \"${cli}\" transport-push \"$1\" || exit $?`,\n86\t    `  elif command -v cledger >/dev/null 2>&1; then`,\n87\t    `    printf '%s\\\\n' \"$_cledger_refs\" | cledger transport-push \"$1\" || exit $?`,\n88\t    `  fi`,\n89\t    `  # Note: a pre-push script's stdin can only be read once, so anything`,\n90\t    `  # chained after this block will not see the ref list.`,\n91\t    `fi`,\n92\t    `# <<< ${HOOK_MARKER} <<<`,\n93\t  ].join(\"\\n\");\n94\t}\n95\t\n96\t/**\n97\t * Replace an already-installed cledger block with the current one.\n98\t *\n99\t * Without this an existing install keeps whatever block it was created with\n100\t * forever — `installHook` used to return \"present\" on any file containing the\n101\t * marker — so a behavior change in the hook itself (the stdin plumbing above)\n102\t * would only ever reach fresh repos. Only the marked region is touched;\n103\t * anything the user wrote around it is preserved byte for byte.\n104\t */\n105\tfunction replaceHookBlock(existing: string, block: string): string | null {\n106\t  const start = existing.indexOf(`# >>> ${HOOK_MARKER}`);\n107\t  const endMarker = `# <<< ${HOOK_MARKER} <<<`;\n108\t  const endIdx = existing.indexOf(endMarker, start);\n109\t  if (start === -1 || endIdx === -1) return null;\n110\t  const end = endIdx + endMarker.length;\n111\t  const current = existing.slice(start, end);\n112\t  if (current === block) return null; // already current\n113\t  return existing.slice(0, start) + block + existing.slice(end);\n114\t}\n115\t\n116\t/** Warnings that should print once per repo, not on every capture. */\n117\tasync function warnOnce(repo: RepoInfo, key: string, message: string): Promise<void> {\n118\t  const stateDir = join(repo.commonDir, \"conversation-ledger\");\n119\t  const path = join(stateDir, \"transport-warnings.json\");\n120\t  let warned: string[] = [];\n121\t  try {\n122\t    warned = JSON.parse(await readFile(path, \"utf8\")) as string[];\n123\t  } catch {\n124\t    // first warning, or unreadable state — state is rebuildable\n125\t  }\n126\t  if (warned.includes(key)) return;\n127\t  process.stderr.write(message);\n128\t  await mkdir(stateDir, { recursive: true });\n129\t  await writeFile(path, JSON.stringify([...warned, key]) + \"\\n\");\n130\t}\n131\t\n132\texport interface TransportSetup {\n133\t  hook:\n134\t    | \"installed\"\n135\t    | \"present\"\n136\t    | \"upgraded\"\n137\t    | \"appended\"\n138\t    | \"skipped-config\"\n139\t    | \"skipped-hookspath\"\n140\t    | \"skipped-foreign\";\n141\t  refspec: \"added\" | \"present\" | \"skipped-config\" | \"no-remote\";\n142\t}\n143\t\n144\t/**\n145\t * Transport is default-on but must cost the user nothing to get: the first\n146\t * capture in a repo wires it up. Installs the pre-push hook (chain-safe:\n147\t * appends to an existing shell hook, backs off with a one-time warning when\n148\t * core.hooksPath or a non-shell hook owns the file) and adds the fetch\n149\t * refspec that stages the remote's ledger ref on normal `git fetch`.\n150\t * Runs on every append — each check is a cheap stat/config read — so a\n151\t * remote added later still gets wired. Never throws: this runs inside\n152\t * capture, which must never fail a user's session.\n153\t */\n154\texport async function ensureTransport(\n155\t  repo: RepoInfo,\n156\t  config: CledgerConfig,\n157\t): Promise<TransportSetup | null> {\n158\t  try {\n159\t    return {\n160\t      hook: await ensurePrePushHook(repo, config),\n161\t      refspec: await ensureFetchRefspec(repo, config),\n162\t    };\n163\t  } catch {\n164\t    return null;\n165\t  }\n166\t}\n167\t\n168\tasync function ensurePrePushHook(\n169\t  repo: RepoInfo,\n170\t  config: CledgerConfig,\n171\t): Promise<TransportSetup[\"hook\"]> {\n172\t  if (config.transport?.hook === false) return \"skipped-config\";\n173\t\n174\t  const hooksPath = (await git([\"config\", \"--get\", \"core.hooksPath\"], {\n175\t    cwd: repo.root,\n176\t    allowFailure: true,\n177\t  })).trim();\n178\t  if (hooksPath) {\n179\t    await warnOnce(\n180\t      repo,\n181\t      \"hookspath\",\n182\t      `cledger: core.hooksPath is set (${hooksPath}), so the ledger pre-push hook was not ` +\n183\t        `installed. To share conversation records on push, add\\n` +\n184\t        `  cledger transport-push \"$1\"\\n` +\n185\t        `to that pre-push hook, or run \\`cledger sync\\` manually.\\n`,\n186\t    );\n187\t    return \"skipped-hookspath\";\n188\t  }\n189\t\n190\t  // The common dir, never this worktree's own git dir: git resolves hooks\n191\t  // relative to `$GIT_COMMON_DIR`, so a pre-push script written under\n192\t  // `.git/worktrees/<name>/hooks/` is simply never executed. Installing it\n193\t  // there would leave a repo whose first capture happened inside a worktree\n194\t  // with a hook that looks installed and silently never runs.\n195\t  const hookPath = join(repo.commonDir, \"hooks\", \"pre-push\");\n196\t  if (!existsSync(hookPath)) {\n197\t    await mkdir(join(repo.commonDir, \"hooks\"), { recursive: true });\n198\t    await writeFile(hookPath, `#!/bin/sh\\n${hookBlock()}\\n`);\n199\t    await chmod(hookPath, 0o755);\n200\t    return \"installed\";\n201\t  }\n202\t\n203\t  const existing = await readFile(hookPath, \"utf8\");\n204\t  if (existing.includes(HOOK_MARKER)) {\n205\t    const upgraded = replaceHookBlock(existing, hookBlock());\n206\t    if (upgraded === null) return \"present\";\n207\t    await writeFile(hookPath, upgraded);\n208\t    await chmod(hookPath, 0o755);\n209\t    return \"upgraded\";\n210\t  }\n211\t\n212\t  const shebang = existing.split(\"\\n\", 1)[0] ?? \"\";\n213\t  if (!/^#!.*\\b(sh|bash|zsh|dash|ksh)\\b/.test(shebang)) {\n214\t    await warnOnce(\n215\t      repo,\n216\t      \"foreign-hook\",\n217\t      `cledger: this repo's pre-push hook is not a shell script, so the ledger hook was not ` +\n218\t        `chained onto it. Run \\`cledger sync\\` to share conversation records manually.\\n`,\n219\t    );\n220\t    return \"skipped-foreign\";\n221\t  }\n222\t\n223\t  await writeFile(hookPath, existing.replace(/\\n?$/, \"\\n\") + \"\\n\" + hookBlock() + \"\\n\");\n224\t  await chmod(hookPath, 0o755);\n225\t  return \"appended\";\n226\t}\n227\t\n228\tasync function ensureFetchRefspec(\n229\t  repo: RepoInfo,\n230\t  config: CledgerConfig,\n231\t): Promise<TransportSetup[\"refspec\"]> {\n232\t  if (config.transport?.fetchRefspec === false) return \"skipped-config\";\n233\t\n234\t  const originUrl = (await git([\"remote\", \"get-url\", \"origin\"], {\n235\t    cwd: repo.root,\n236\t    allowFailure: true,\n237\t  })).trim();\n238\t  if (!originUrl) return \"no-remote\";\n239\t\n240\t  const fetchSpecs = await git([\"config\", \"--get-all\", \"remote.origin.fetch\"], {\n241\t    cwd: repo.root,\n242\t    allowFailure: true,\n243\t  });\n244\t  if (fetchSpecs.includes(INCOMING_REF)) return \"present\";\n245\t\n246\t  await git([\"config\", \"--add\", \"remote.origin.fetch\", FETCH_REFSPEC], { cwd: repo.root });\n247\t  return \"added\";\n248\t}\n249\t\n250\t/**\n251\t * Fold the staged incoming ref (populated by `git fetch` via the refspec)\n252\t * into the local ledger ref — the lazy, read-time half of transport. The\n253\t * merge is the same cat_sort_uniq union sync() uses, so absorbing can only\n254\t * add events. Returns true when new remote state was absorbed. Never\n255\t * throws: a concurrent notes merge just means the next read tries again.\n256\t */\n257\texport async function absorbIncoming(repo: RepoInfo): Promise<boolean> {\n258\t  const incoming = (await git([\"rev-parse\",