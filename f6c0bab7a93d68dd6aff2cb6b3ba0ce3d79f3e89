tion feedback\n * loop; the sync-report side is closed by the masked excerpt in scan.ts.\n *\n * This file necessarily holds plaintext secrets. It lives under `.git/`,\n * which git never tracks or pushes (structurally, not via .gitignore), so it\n * is exactly as local-and-unshared as the native transcripts the values came\n * from — consistent with the \"trust boundary is transport\" threat model. It\n * is local, rebuildable-if-lost state, the same tier as the allowlist and\n * pending queue — never the record of truth. Off by default: when the flag\n * is not set, this store is never read or created.\n */\nimport { chmod, mkdir, readFile, writeFile } from \"node:fs/promises\";\nimport { join } from \"node:path\";\nimport type { RepoInfo } from \"../git.js\";\n\n/**\n * Owner read/write only. This file holds confirmed secret plaintext, so it\n * must not be group/world-readable even on a shared machine. `mode` on\n * writeFile only applies when the file is *created*, so an explicit chmod\n * follows to also repair permissions on a store created before this existed.\n */\nconst STORE_MODE = 0o600;\n\n/**\n * Values shorter than this are never remembered: an exact-string scrub of a\n * short/common value (a weak password like \"pass\", a 4-char token) would\n * over-match innocent occurrences in unrelated events. Mirrors the same floor\n * collectEnvValues() applies to env masking.\n */\nconst MIN_VALUE_LENGTH = 8;\n\ninterface KnownSecretsFile {\n  values: string[];\n}\n\nfunction knownSecretsPath(repo: RepoInfo): string {\n  return join(repo.commonDir, \"conversation-ledger\", \"known-secrets.json\");\n}\n\n/** Load remembered secret values. Missing/malformed store -> empty (never fails capture). */\nexport async function loadKnownSecrets(repo: RepoInfo): Promise<string[]> {\n  try {\n    const raw = await readFile(knownSecretsPath(repo), \"utf8\");\n    const parsed = JSON.parse(raw) as KnownSecretsFile;\n    return Array.isArray(parsed.values) ? parsed.values.filter((v) => typeof v === \"string\") : [];\n  } catch {\n    return [];\n  }\n}\n\n/**\n * Remember confirmed secret values (additive, deduplicated, sorted). Values\n * below MIN_VALUE_LENGTH are dropped. A no-op that never creates the file\n * when nothing survives filtering.\n */\nexport async function addKnownSecrets(repo: RepoInfo, values: string[]): Promise<void> {\n  const existing = new Set(await loadKnownSecrets(repo));\n  let added = false;\n  for (const value of values) {\n    if (typeof value !== \"string\" || value.length < MIN_VALUE_LENGTH) continue;\n    if (!existing.has(value)) {\n      existing.add(value);\n      added = true;\n    }\n  }\n  if (!added) return;\n  await mkdir(join(repo.commonDir, \"conversation-ledger\"), { recursive: true });\n  const path = knownSecretsPath(repo);\n  await writeFile(path, JSON.stringify({ values: [...existing].sort() }, null, 2) + \"\\n\", {\n    mode: STORE_MODE,\n  });\n  // Repair perms on a pre-existing store (writeFile's mode only applies on\n  // create). Never fail capture over a chmod that the filesystem refuses.\n  try {\n    await chmod(path, STORE_MODE);\n  } catch {\n    /* best effort */\n  }\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/src/redact/known-secrets.ts","numLines":87,"startLine":1,"totalLines":87},"type":"text"},"type":"user","userType":"external","uuid":"3f417724-8959-45a4-970d-5209a84e96cf","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-01T02:36:35.812Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Sync-time secret scan (layer E, see docs/WIP_TECHNICAL_DESIGN.md \"Privacy\n3\t * and integrity\"). Unlike capture-tier redaction (apply.ts), this scanner\n4\t * never rewrites anything — it only reports findings so a human can decide\n5\t * whether to `cledger redact` the event, `cledger allow` the fingerprint as\n6\t * a known false positive, or push anyway with `--no-scan`. Rules may\n7\t * therefore be noisier than the capture tier.\n8\t */\n9\timport { mkdir, readFile, writeFile } from \"node:fs/promises\";\n10\timport { join } from \"node:path\";\n11\timport { sha256Hex } from \"../canonical.js\";\n12\timport type { RepoInfo } from \"../git.js\";\n13\timport type { EvidenceEvent } from \"../schema.js\";\n14\timport { isExemptFromRedaction, walkStrings } from \"./apply.js\";\n15\timport { rulesForTier, shannonEntropy } from \"./rules.js\";\n16\t\n17\texport interface Finding {\n18\t  eventId: string;\n19\t  conversation?: string;\n20\t  occurred_at: string;\n21\t  rule: string;\n22\t  fingerprint: string;\n23\t  /** JSON path of the string the match sits in, e.g. `content/blocks/0/text`. */\n24\t  path: string;\n25\t  /** Match span within that string, so `cledger inspect` can find it again. */\n26\t  start: number;\n27\t  end: number;\n28\t}\n29\t\n30\tconst PLACEHOLDER_RE = /\\[REDACTED:[^\\]]+\\]/g;\n31\t\n32\t/** True if [start, end) overlaps an existing `[REDACTED:...]` placeholder span in `text`. */\n33\tfunction overlapsPlaceholder(text: string, start: number, end: number): boolean {\n34\t  for (const m of text.matchAll(PLACEHOLDER_RE)) {\n35\t    const pStart = m.index ?? 0;\n36\t    const pEnd = pStart + m[0].length;\n37\t    if (start < pEnd && end > pStart) return true;\n38\t  }\n39\t  return false;\n40\t}\n41\t\n42\t/** Stands in for the matched secret wherever a match is rendered. */\n43\tconst MATCH_MARKER = \"<redacted>\";\n44\t\n45\tconst PURE_HEX_RE = /^[0-9a-fA-F]+$/;\n46\t\n47\t/**\n48\t * Scan already-finalized events for potential secrets. Read-only: never\n49\t * mutates content, only reports. `tier` selects the ruleset — \"standard\"\n50\t * re-runs the full capture ruleset plus scan-only keyword/URL/bearer rules\n51\t * (catching events captured under an older capture ruleset); \"paranoid\"\n52\t * additionally enables the entropy-gated high-entropy-token rule.\n53\t */\n54\texport function scanEvents(events: EvidenceEvent[], tier: \"standard\" | \"paranoid\"): Finding[] {\n55\t  const rules = rulesForTier(tier);\n56\t  const findings: Finding[] = [];\n57\t\n58\t  for (const event of events) {\n59\t    const visit = (value: string, path: string): string => {\n60\t      if (isExemptFromRedaction(event.kind, path)) return value;\n61\t      for (const rule of rules) {\n62\t        for (const m of value.matchAll(rule.pattern)) {\n63\t          const matchText = m[0];\n64\t          const start = m.index ?? 0;\n65\t          const end = start + matchText.length;\n66\t          if (overlapsPlaceholder(value, start, end)) continue;\n67\t          if (rule.entropyGated) {\n68\t            // Belt-and-suspenders: rulesForTier already excludes this rule\n69\t            // below \"paranoid\", but the gate is cheap to state explicitly.\n70\t            if (tier !== \"paranoid\") continue;\n71\t            if (PURE_HEX_RE.test(matchText)) continue; // git SHAs, content digests\n72\t            if (matchText.includes(\"[REDACTED:\")) continue;\n73\t            if (shannonEntropy(matchText) < 4.0) continue;\n74\t          }\n75\t          findings.push({\n76\t            eventId: event.id,\n77\t            ...(event.conversation ? { conversation: event.conversation.id } : {}),\n78\t            occurred_at: event.occurred_at,\n79\t            rule: rule.id,\n80\t            fingerprint: sha256Hex(matchText).slice(0, 12),\n81\t            path,\n82\t            start,\n83\t            end,\n84\t          });\n85\t        }\n86\t      }\n87\t      return value;\n88\t    };\n89\t    walkStrings(event.content, \"content\", visit);\n90\t    if (event.raw) walkStrings(event.raw.data, \"raw/data\", visit);\n91\t  }\n92\t\n93\t  return findings;\n94\t}\n95\t\n96\t/**\n97\t * One line per finding: coordinates only, never a character of the flagged\n98\t * text or its surroundings.\n99\t *\n100\t * This used to print ~20 characters of context with the match masked, on the\n101\t * theory that masking the match was enough to make the report safe to\n102\t * re-capture. It was not. The *context* around a match is itself what tripped\n103\t * the rule — a `keyword-assignment` hit prints the keyword that anchored it —\n104\t * so a report landing in a later conversation re-seeds a finding on the report\n105\t * itself, and every scan compounds the previous one. Observed in the wild:\n106\t * one discussion of GitHub Actions code multiplied into repeat findings that\n107\t * `cledger allow` could not durably clear, because each new report minted a\n108\t * new event. Coordinates cannot do that: an event id and a JSON path match no\n109\t * secret rule. Content lives behind `cledger inspect`, which writes to a file.\n110\t */\n111\texport function formatFinding(f: Finding): string {\n112\t  const where = `${f.path}@${f.start}`;\n113\t  return `${f.eventId.slice(0, 16)}  ${f.conversation ?? \"-\"}  ${f.occurred_at}  ${f.rule}  ${where}  [${f.fingerprint}]`;\n114\t}\n115\t\n116\t/** Every string in an event, keyed by the same JSON paths scanEvents uses. */\n117\texport function collectStrings(event: EvidenceEvent): Map<string, string> {\n118\t  const out = new Map<string, string>();\n119\t  const visit = (value: string, path: string): string => {\n120\t    out.set(path, value);\n121\t    return value;\n122\t  };\n123\t  walkStrings(event.content, \"content\", visit);\n124\t  if (event.raw) walkStrings(event.raw.data, \"raw/data\", visit);\n125\t  return out;\n126\t}\n127\t\n128\texport interface RenderOptions {\n129\t  /** Characters of surrounding text on each side. */\n130\t  context: number;\n131\t  /** Include the matched text verbatim instead of masking it. */\n132\t  reveal: boolean;\n133\t}\n134\t\n135\t/**\n136\t * A finding with enough surrounding text for a human to actually judge it.\n137\t *\n138\t * The whole point of the separate command: `formatFinding` is deliberately\n139\t * unreadable, so this is where readability lives. Callers are expected to send\n140\t * this to a file rather than a terminal — see `cledger inspect`.\n141\t */\n142\texport function renderFinding(event: EvidenceEvent, f: Finding, opts: RenderOptions): string {\n143\t  const value = collectStrings(event).get(f.path);\n144\t  if (value === undefined) {\n145\t    return `${f.path}: string no longer present in event ${f.eventId.slice(0, 16)} (event rewritten since the scan?)\\n`;\n146\t  }\n147\t  const lo = Math.max(0, f.start - opts.context);\n148\t  const hi = Math.min(value.length, f.end + opts.context);\n149\t  const match = opts.reveal ? value.slice(f.start, f.end) : MATCH_MARKER;\n150\t  const body = `${value.slice(lo, f.start)}${match}${value.slice(f.end, hi)}`;\n151\t  return [\n152\t    `rule:        ${f.rule}`,\n153\t    `fingerprint: ${f.fingerprint}`,\n154\t    `event:       ${f.eventId}`,\n155\t    `conversation:${f.conversation ?? \" -\"}`,\n156\t    `occurred_at: ${f.occurred_at}`,\n157\t    `location:    ${f.path}, chars ${f.start}-${f.end} of ${value.length}`,\n158\t    `match:       ${f.end - f.start} chars, ${opts.reveal ? \"SHOWN BELOW\" : \"masked (pass --reveal to show)\"}`,\n159\t    \"\",\n160\t    `${lo > 0 ? `…[${lo} chars before]…\\n` : \"\"}${body}${hi < value.length ? `\\n…[${value.length - hi} chars after]…` : \"\"}`,\n161\t    \"\",\n162\t  ].join(\"\\n\");\n163\t}\n164\t\n165\t/**\n166\t * Whether we appear to be running inside a coding-agent session, i.e. whether\n167\t * anything printed here will be swept int