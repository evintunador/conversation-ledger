e.endsWith(\".jsonl\")) continue;\n   623\t    const path = join(dirname(transcriptPath), name);\n   624\t    if (seen.has(path)) continue;\n   625\t    try {\n   626\t      const cursor = await readCursor(repo, basename(name, \".jsonl\"), CURSOR_FIELD);\n   627\t      if (cursor === null) continue; // never captured — not this pass's business\n   628\t      const info = await stat(path);\n   629\t      if (info.size <= cursor.size) continue; // nothing new since the last read\n   630\t      await captureClaudeTranscript(path, cwd, seen);\n   631\t    } catch {\n   632\t      continue;\n   633\t    }\n   634\t  }\n   635\t}\n   636\t\n   637\texport async function runClaudeCodeHook(stdinJson: string): Promise<void> {\n   638\t  try {\n   639\t    const payload = JSON.parse(stdinJson) as ClaudeCodeHookPayload;\n   640\t    const cwd = payload.cwd ?? process.cwd();\n   641\t    if (!payload.transcript_path) return;\n   642\t    const repo = await findRepo(cwd);\n   643\t    if (!repo) return; // hooks must never break the user's session outside a repo\n   644\t    const seen = new Set<string>();\n   645\t    await captureClaudeTranscript(payload.transcript_path, cwd, seen);\n   646\t    await sweepStaleTranscripts(payload.transcript_path, cwd, seen);\n   647\t  } catch (err) {\n   648\t    process.stderr.write(\n   649\t      `cledger: claude-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n   650\t    );\n   651\t  }\n   652\t}\n   653\t\n   654\t/**\n   655\t * Capture one transcript file. Does not print, does not follow subagents —\n   656\t * `captureClaudeTranscript` wraps this to do both.\n   657\t */\n   658\tasync function captureTranscriptFile(\n   659\t  repo: RepoInfo,\n   660\t  transcriptPath: string,\n   661\t): Promise<CaptureResult> {\n   662\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n   663\t  let raw: string;\n   664\t  try {\n   665\t    raw = await readFile(transcriptPath, \"utf8\");\n   666\t  } catch {\n   667\t    return result; // transcript not written yet\n   668\t  }\n   669\t  // Whether the writer had finished the last line when we read. A transcript\n   670\t  // that does not end in a newline was caught mid-write, which is how the\n   671\t  // final line comes to be torn — see `tornTail` below.\n   672\t  const endsWithNewline = raw.endsWith(\"\\n\");\n   673\t  const lines = raw.split(\"\\n\");\n   674\t  if (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n   675\t\n   676\t  const sessionId = basename(transcriptPath, \".jsonl\");\n   677\t  const stored = (await readCursor(repo, sessionId, CURSOR_FIELD)) ?? { count: 0, size: 0 };\n   678\t  let cursor = stored.count;\n   679\t  if (cursor > lines.length) cursor = 0; // transcript is shorter than expected — rescan from the start\n   680\t\n   681\t  /**\n   682\t   * Index of a half-written final line, when there is one.\n   683\t   *\n   684\t   * A line that fails to parse is normally a lost cause and gets skipped, but\n   685\t   * the last line of a file still being written is a different thing: the\n   686\t   * bytes are on their way. Advancing the cursor past it would skip it\n   687\t   * permanently, and this adapter now goes looking for transcript tails on\n   688\t   * purpose (see `sweepStaleTranscripts`), which is exactly where torn lines\n   689\t   * live. So the cursor stops short of it and the next read picks it up whole.\n   690\t   *\n   691\t   * The two conditions together are what make this safe: a parse failure\n   692\t   * anywhere but the unterminated last line is real corruption, and holding\n   693\t   * the cursor at it would stall the session's capture forever.\n   694\t   */\n   695\t  let tornTail: number | null = null;\n   696\t\n   697\t  const version = packageVersion();\n   698\t  const identity = await gitUserIdentity(repo);\n   699\t  let baseTime: string | null = null; // computed lazily, only if a timestampless unrecognized line needs it\n   700\t  const drafts: EventDraft[] = [];\n   701\t  for (let i = cursor; i < lines.length; i++) {\n   702\t    const text = lines[i]!;\n   703\t    if (!text.trim()) continue;\n   704\t    let parsed: ClaudeTranscriptLine;\n   705\t    try {\n   706\t      parsed = JSON.parse(text) as ClaudeTranscriptLine;\n   707\t    } catch {\n   708\t      // Partial line — normal at the tail of a live transcript. Remember it\n   709\t      // so the cursor stops here rather than stepping over it for good.\n   710\t      if (!endsWithNewline && i === lines.length - 1) tornTail = i;\n   711\t      continue;\n   712\t    }\n   713\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n   714\t    if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n   715\t      // Most non-turn lines carry no timestamp of their own, so the session\n   716\t      // base time is now needed on the common path rather than the rare one;\n   717\t      // it stays lazy so a transcript of nothing but turns never computes it.\n   718\t      if (baseTime === null) baseTime = firstTimestamp(lines) ?? (await sessionMtime(transcriptPath));\n   719\t      const occurredAt = typeof parsed.timestamp === \"string\" ? parsed.timestamp : baseTime;\n   720\t      const ctx = recordContext(parsed, occurredAt, i, sessionId, version);\n   630\t    mergeCaptureResult(total, await captureTranscriptFile(repo, path));\n   631\t  }\n   632\t  process.stderr.write(`cledger: qwen-code +${total.appended} events (${total.deduped} deduped)\\n`);\n   633\t  warnUnrecognized(\"qwen-code\", total.unrecognized);\n   634\t  return total;\n   635\t}\n   636\t\n   637\t/**\n   638\t * Capture any *other* transcript in this project that has grown since it was\n   639\t * last read — the same gap-closing pass the claude-code adapter runs, and for\n   640\t * the same reason: a session's own final lines are unreachable to it, because\n   641\t * the hook fires, capture reads to end-of-file, and Qwen Code then writes the\n   642\t * closing bookkeeping of that turn with no further hook to pick it up.\n   643\t *\n   644\t * A transcript with *no* cursor is skipped, and that bound is the point. A\n   645\t * missing cursor means cledger never captured that session at all — it\n   646\t * predates the install, or the user did not want it — and adopting those\n   647\t * would turn a gap-closing sweep into a silent backfill of every conversation\n   648\t * ever held in the project, anchored to whatever HEAD is checked out now\n   649\t * rather than the commit it was about. `--all` is where that belongs, on\n   650\t * purpose and by request.\n   651\t *\n   652\t * Failures are swallowed per session: a sweep is a bonus pass over\n   653\t * conversations the user is not currently having, and must never be the\n   654\t * reason their live capture reports an error.\n   655\t */\n   656\tasync function sweepStaleTranscripts(\n   657\t  repo: RepoInfo,\n   658\t  cwd: string,\n   659\t  seen: Set<string>,\n   660\t): Promise<CaptureResult> {\n   661\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n   662\t  for (const path of await projectTranscripts(cwd)) {\n   663\t    if (seen.has(path)) continue;\n   664\t    try {\n   665\t      const cursor = await readCursor(repo, basename(path, \".jsonl\"), CURSOR_FIELD);\n   666\t      if (cursor === null) continue; // never captured — not this pass's business\n   667\t      const info = await stat(path);\n   668\t      if (info.size <= cursor.size) continue; // nothing new since the last read\n   669\t      mergeCaptureResult(total, await captureTranscriptFile(repo, path));\n   670\t    } catch {\n   671\t      continue;\n   672\t    }\n   673\t  }\n   674\t  return total;\n   675\t}\n   676\t\n   677\texport async function runQwenHook(stdinJson: string): Promise<void> {\n   678\t  try {\n   679\t    const payload = JSON.parse(stdinJson) as QwenHookPayload;\n   680\t    const cwd = payload.cwd ?? process.cwd();\n   681\t    const repo = await findRepo(cwd);\n   682\t    if (!repo) return; // hooks must never break the user's session outside a repo\n   683\t    const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n   684\t    const seen = new Set<string>();\n   685\t    if (payload.transcript_path) {\n   686\t      seen.add(payload.transcript_path);\n   687\t      mergeCaptureResult(total, await captureTranscriptFile(repo, payload.transcript_path));\n   688\t    }\n   689\t    mergeCaptureResult(total, await sweepStaleTranscripts(repo, cwd, seen));\n   690\t    process.stderr.write(`cledger: qwen-code +${total.appended} events (${total.deduped} deduped)\\n`);\n   691\t    warnUnrecognized(\"qwen-code\", total.unrecognized);\n   692\t  } catch (err) {\n   693\t    process.stderr.write(\n   694\t      `cledger: qwen-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n   695\t    );\n   696\t  }\n   697\t}\n     1\timport { execFile } from \"node:child_process\";\n     2\timport { copyFile, mkdir, readFile, writeFile } from \"node:fs/promises\";\n     3\timport { existsSync } from \"node:fs\";\n     4\timport { homedir } from \"node:os\";\n     5\timport { dirname, join } from \"node:path\";\n     6\timport { fileURLToPath } from \"node:url\";\n     7\timport { promisify } from \"node:util\";\n     8\timport { hasAuthorIdentity } from \"./transport.js\";\n     9\t\n    10\tconst execFileP = promisify(execFile);\n    11\t\n    12\t/**\n    13\t * Hook commands prefer the bare `cledger` binary so installs survive this\n    14\t * repo moving; when it isn't on PATH yet we fall back to an absolute\n    15\t * node+script invocation so hooks work immediately after `cledger install`.\n    16\t */\n    17\tasync function hookCommand(source: string): Promise<string> {\n    18\t  try {\n    19\t    await execFileP(\"cledger\", [\"--version\"]);\n    20\t    return `cledger hook ${source}`;\n    21\t  } catch {\n    22\t    const script = fileURLToPath(new URL(\"./cli.js\", import.meta.url));\n    23\t    return `\"${process.execPath}\" \"${script}\" hook ${source}`;\n    24\t  }\n    25\t}\n    26\t\n    27\t/**\n    28\t * The same invocation as `hookCommand`, but as an argv array: the opencode\n    29\t * integration is a JS plugin that spawns the hook directly rather than a\n    30\t * shell command string in a config file.\n    31\t */\n    32\tasync function hookArgv(source: string): Promise<string[]> {\n    33\t  try {\n    34\t    await execFileP(\"cledger\", [\"--version\"]);\n    35\t    return [\"cledger\", \"hook\", source];\n    36\t  } catch {\n    37\t    const script = fileURLToPath(new URL(\"./cli.js\", import.meta.url));\n    38\t    return [process.execPath, script, \"hook\", source];\n    39\t  }\n    40\t}\n    41\t\n    42\tasync function backup(path: string): Promise<void> {\n    43\t  if (!existsSync(path)) return;\n    44\t  const stamp = new Date().toISOString().replace(/[:.]/g, \"-\");\n    45\t  await copyFile(path, `${path}.bak-${stamp}`);\n    46\t}\n    47\t\n    48\tinterface ClaudeHookEntry {\n    49\t  matcher?: string;\n    50\t  hooks: { type: string; command?: string; timeout?: number }[];\n    51\t}\n    52\t\n    53\t/** The cledger hook inside an event's entries, if it is already installed. */\n    54\tfunction findCledgerHook(\n    55\t  entries: ClaudeHookEntry[] | undefined,\n    56\t  needle: string,\n    57\t): { type: string; command?: string; timeout?: number } | undefined {\n    58\t  for (const entry of entries ?? []) {\n    59\t    const hook = entry.hooks?.find((h) => h.command?.includes(needle));\n    60\t    if (hook) return hook;\n    61\t  }\n    62\t  return undefined;\n    63\t}\n    64\t\n    65\t/**\n    66\t * How long a hook may run before the CLI kills it — in whatever unit that CLI\n    67\t * reads the field in, which is *not* the same across the three.\n    68\t *\n    69\t * Claude Code reads `timeout` as **seconds**. Gemini CLI and Qwen Code forked\n    70\t * Claude's hook config format but not its unit: both pass the number straight\n    71\t * to `setTimeout`, so theirs is **milliseconds**. Their own code says so —\n    72\t * `Hook timed out after ${timeout}ms`, with `DEFAULT_HOOK_TIMEOUT = 6e4`.\n    73\t *\n    74\t * Writing Claude's `120` into their settings therefore asks to be SIGTERMed\n    75\t * after 120 *milliseconds*. A cold capture is ~85ms of work on top of node's\n    76\t * startup, so the hook loses that race nearly every time: Gemini reported\n    77\t * \"Hook(s) [...] failed\" on almost every turn while its events sometimes still\n    78\t * landed, because whether `appendEvents` finished before the signal was a coin\n    79\t * flip. Diagnosed by trapping the signal in a wrapper script — the hook logged\n    80\t * `caught SIGTERM` in the same second it started.\n    81\t */\n    82\tconst HOOK_TIMEOUT_SECONDS = 120;\n    83\tconst HOOK_TIMEOUT_MILLISECONDS = 120_000;\n    84\t\n    85\t/**\n    86\t * A redirect this used to append to the two Gemini-derived CLIs' hook\n    87\t * commands, now only recognized so it can be taken back off.\n    88\t *\n    89\t * **Its rationale was wrong, and the constant survives as the repair.** It was\n    90\t * introduced after `qwen -p \"...\"` failed to capture: the CLI fires its `Stop`\n    91\t * hook and exits, and a hook doing a git-notes append was seen to die partway.\n    92\t * The explanation recorded at the time -- that the redirection \"routes the\n    93\t * command through a shell so the work runs as a grandchild that outlives the\n    94\t * teardown\" -- does not survive reading either CLI's source. Both *always*\n    95\t * invoke a hook as `bash -c \"<command>\"` whether or not it redirects, and\n    96\t * `bash -c` with a single simple command `exec`s it rather than forking, so\n    97\t * there is no grandchild and nothing is detached. All the redirect ever did\n    98\t * was hide the capture's own output.\n    99\t *\n   100\t * The real cause of hooks dying was the timeout unit (see\n   101\t * HOOK_TIMEOUT_MILLISECONDS): every hook was being SIGTERMed after 120ms. With\n   102\t * that fixed, the redirect has no job left and one standing cost -- a capture\n   103\t * cannot print a format-drift warning anywhere the user would see it, leaving\n   104\t * `cledger capture <source> --all` as the only way to watch one.\n   105\t *\n   106\t * New installs no longer write it. An existing hook that still carries it is\n   107\t * repaired in place, for the same reason the timeout is (see below): a setting\n   108\t * cledger got wrong should be fixable by re-running `cledger install`, not by\n   109\t * hand-editing JSON.\n   110\t *\n   111\t * The repair only ever touches cledger's own hook, and only when the command\n   112\t * ends in this exact string -- any other redirect a user wrote is left as\n   113\t * written. The one case it cannot tell apart is a user who appended precisely\n   114\t * this suffix to the cledger hook on purpose; they get it removed, and can put\n   115\t * it back. Silencing a capture is not worth a config key to preserve.\n   116\t */\n   117\tconst STALE_DETACH_SUFFIX = \" >/dev/null 2>&1\";\n   118\t\n   119\t/**\n   120\t * Install command hooks into a Claude-Code-shaped `settings.json`.\n   121\t *\n   122\t * Three of the supported CLIs share this exact config format -- a top-level\n   123\t * `hooks` object mapping an event name to an array of\n   124\t * `{matcher?, hooks:[{type:\"command\", command, timeout}]}` definitions. That\n   125\t * is not a coincidence: Gemini CLI ships a `gemini hooks migrate` command\n   126\t * whose whole job is importing Claude Code's hook config, and Qwen Code\n   127\t * inherited the same engine. Only the file path and the event names differ,\n   128\t * so they are the parameters here.\n   129\t */\n   130\tasync function installJsonHooks(\n   131\t  source: string,\n   132\t  setting