 and\n   599\t * would anchor each one to whatever HEAD happens to be checked out now rather\n   600\t * than to the commit it was actually about. A session cledger already tracks\n   601\t * is the only session it has any business finishing.\n   602\t *\n   603\t * Failures are swallowed per session: a sweep is a bonus pass over\n   604\t * conversations the user is not currently having, and must never be the\n   605\t * reason their live capture reports an error.\n   606\t */\n   607\tasync function sweepStaleTranscripts(\n   608\t  transcriptPath: string,\n   609\t  cwd: string,\n   610\t  seen: Set<string>,\n   611\t): Promise<void> {\n   612\t  const repo = await findRepo(cwd);\n   613\t  if (!repo) return;\n   614\t  let entries: string[];\n   615\t  try {\n   616\t    entries = await readdir(dirname(transcriptPath));\n   617\t  } catch {\n   618\t    return;\n   619\t  }\n   620\t\n   621\t  for (const name of entries) {\n   622\t    if (!name.endsWith(\".jsonl\")) continue;\n   623\t    const path = join(dirname(transcriptPath), name);\n   624\t    if (seen.has(path)) continue;\n   625\t    try {\n   626\t      const cursor = await readCursor(repo, basename(name, \".jsonl\"), CURSOR_FIELD);\n   627\t      if (cursor === null) continue; // never captured — not this pass's business\n   628\t      const info = await stat(path);\n   629\t      if (info.size <= cursor.size) continue; // nothing new since the last read\n   630\t      await captureClaudeTranscript(path, cwd, seen);\n   631\t    } catch {\n   632\t      continue;\n   633\t    }\n   634\t  }\n   635\t}\n   636\t\n   637\texport async function runClaudeCodeHook(stdinJson: string): Promise<void> {\n   638\t  try {\n   639\t    const payload = JSON.parse(stdinJson) as ClaudeCodeHookPayload;\n   640\t    const cwd = payload.cwd ?? process.cwd();\n   641\t    if (!payload.transcript_path) return;\n   642\t    const repo = await findRepo(cwd);\n   643\t    if (!repo) return; // hooks must never break the user's session outside a repo\n   644\t    const seen = new Set<string>();\n   645\t    await captureClaudeTranscript(payload.transcript_path, cwd, seen);\n   646\t    await sweepStaleTranscripts(payload.transcript_path, cwd, seen);\n   647\t  } catch (err) {\n   648\t    process.stderr.write(\n   649\t      `cledger: claude-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n   650\t    );\n   651\t  }\n   652\t}\n   653\t\n   654\t/**\n   655\t * Capture one transcript file. Does not print, does not follow subagents —\n   656\t * `captureClaudeTranscript` wraps this to do both.\n   657\t */\n   658\tasync function captureTranscriptFile(\n   659\t  repo: RepoInfo,\n   660\t  transcriptPath: string,\n   661\t): Promise<CaptureResult> {\n   662\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n   663\t  let raw: string;\n   664\t  try {\n   665\t    raw = await readFile(transcriptPath, \"utf8\");\n   666\t  } catch {\n   667\t    return result; // transcript not written yet\n   668\t  }\n   669\t  // Whether the writer had finished the last line when we read. A transcript\n   670\t  // that does not end in a newline was caught mid-write, which is how the\n   671\t  // final line comes to be torn — see `tornTail` below.\n   672\t  const endsWithNewline = raw.endsWith(\"\\n\");\n   673\t  const lines = raw.split(\"\\n\");\n   674\t  if (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n   675\t\n   676\t  const sessionId = basename(transcriptPath, \".jsonl\");\n   677\t  const stored = (await readCursor(repo, sessionId, CURSOR_FIELD)) ?? { count: 0, size: 0 };\n   678\t  let cursor = stored.count;\n   679\t  if (cursor > lines.length) cursor = 0; // transcript is shorter than expected — rescan from the start\n   680\t\n   681\t  /**\n   682\t   * Index of a half-written final line, when there is one.\n   683\t   *\n   684\t   * A line that fails to parse is normally a lost cause and gets skipped, but\n   685\t   * the last line of a file still being written is a different thing: the\n   686\t   * bytes are on their way. Advancing the cursor past it would skip it\n   687\t   * permanently, and this adapter now goes looking for transcript tails on\n   688\t   * purpose (see `sweepStaleTranscripts`), which is exactly where torn lines\n   689\t   * live. So the cursor stops short of it and the next read picks it up whole.\n   690\t   *\n   691\t   * The two conditions together are what make this safe: a parse failure\n   692\t   * anywhere but the unterminated last line is real corruption, and holding\n   693\t   * the cursor at it would stall the session's capture forever.\n   694\t   */\n   695\t  let tornTail: number | null = null;\n   696\t\n   697\t  const version = packageVersion();\n   698\t  const identity = await gitUserIdentity(repo);\n   699\t  let baseTime: string | null = null; // computed lazily, only if a timestampless unrecognized line needs it\n   700\t  const drafts: EventDraft[] = [];\n   701\t  for (let i = cursor; i < lines.length; i++) {\n   702\t    const text = lines[i]!;\n   703\t    if (!text.trim()) continue;\n   704\t    let parsed: ClaudeTranscriptLine;\n   705\t    try {\n   706\t      parsed = JSON.parse(text) as ClaudeTranscriptLine;\n   707\t    } catch {\n   708\t      // Partial line — normal at the tail of a live transcript. Remember it\n   709\t      // so the cursor stops here rather than stepping over it for good.\n   710\t      if (!endsWithNewline && i === lines.length - 1) tornTail = i;\n   711\t      continue;\n   712\t    }\n   713\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n   714\t    if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n   715\t      // Most non-turn lines carry no timestamp of their own, so the session\n   716\t      // base time is now needed on the common path rather than the rare one;\n   717\t      // it stays lazy so a transcript of nothing but turns never computes it