= await findRepo(cwd);\n    if (!repo) return; // hooks must never break the user's session outside a repo\n    const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n    const seen = new Set<string>();\n    if (payload.transcript_path) {\n      seen.add(payload.transcript_path);\n      mergeCaptureResult(total, await captureTranscriptFile(repo, payload.transcript_path));\n    }\n    mergeCaptureResult(total, await sweepStaleTranscripts(repo, cwd, seen));\n    process.stderr.write(`cledger: qwen-code +${total.appended} events (${total.deduped} deduped)\\n`);\n    warnUnrecognized(\"qwen-code\", total.unrecognized);\n  } catch (err) {\n    process.stderr.write(\n      `cledger: qwen-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n    );\n  }\n}\n","command":["/bin/zsh","-lc","ls -la .. && git log -5 --oneline && sed -n '550,595p' README.md && sed -n '575,660p' src/adapters/claude-code.ts && sed -n '620,710p' src/adapters/qwen-code.ts"],"cwd":"file:///Users/evintunador/repos/evintunador/conversation-ledger","duration":{"nanos":7084,"secs":0},"exit_code":0,"formatted_output":"total 16\ndrwxr-xr-x@   28 evintunador  staff    896 Sep  9 14:21 .\ndrwxr-xr-x@   11 evintunador  staff    352 Aug 31 10:06 ..\n-rw-r--r--@    1 evintunador  staff   6148 Jul 25 20:31 .DS_Store\ndrwxr-xr-x@   10 evintunador  staff    320 Aug  5 20:44 AI-s_non-anthropomorphic_path_to_understanding\ndrwxr-xr-x@ 1102 evintunador  staff  35264 Jul 17 11:57 Vault\ndrwxr-xr-x@   16 evintunador  staff    512 Sep 24 20:19 annals\ndrwx------@   42 evintunador  staff   1344 Aug 11 21:39 arxiv-summaries-workflow\ndrwx------@   18 evintunador  staff    576 Jul 16 13:57 auto-video-editing-suite\ndrwxr-xr-x@    8 evintunador  staff    256 Aug  5 20:38 context-graph\ndrwxr-xr-x@   15 evintunador  staff    480 Sep 24 21:11 conversation-ledger\ndrwxr-xr-x@    2 evintunador  staff     64 Sep 18 18:09 conversation-ledger-worktrees\ndrwxr-xr-x@   25 evintunador  staff