{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Draft builders for the non-conversational record: the state a session\n3\t * declares about itself, the things that happen in the harness around the\n4\t * turns, the material the harness injects into the model's context, and the\n5\t * intermediate file versions a session leaves behind.\n6\t *\n7\t * These are the counterpart to adapters/drift.ts. Drift handles line types an\n8\t * adapter does *not* know: preserve raw, warn, hope a later version can read\n9\t * them. Everything here is a type the adapter *does* know and has chosen to\n10\t * record with structure. Keeping them apart matters for the drift warning to\n11\t * stay meaningful — a warning that fires on every ordinary `mode` line stops\n12\t * being a signal that the upstream format moved.\n13\t *\n14\t * Every builder produces content in the same two-part shape: a `*_type`\n15\t * discriminator naming the source's own type verbatim, and the source's own\n16\t * fields beside it. Adapters do not rename or reinterpret those fields; a\n17\t * consumer that wants Claude Code's `permissionMode` reads `permissionMode`.\n18\t * What the ledger adds is the kind, the ordering, and the provenance.\n19\t *\n20\t * `blocks` appears whenever a record carries human-readable text, using the\n21\t * same `[{type: \"text\", text}]` shape `conversation_turn` uses. That is the\n22\t * one concession to uniformity: a consumer extracting text across a ledger\n23\t * should not need a per-kind special case to find it.\n24\t */\n25\t\n26\timport type { EventDraft, ProducerAgentContext } from \"../schema.js\";\n27\t\n28\t/** What every record shares: where it came from and where it sits. */\n29\texport interface RecordContext {\n30\t  occurredAt: string;\n31\t  /** Source system, e.g. \"claude-code\". */\n32\t  source: string;\n33\t  sessionId: string;\n34\t  /** Position in the source material — line index, part index. */\n35\t  seq: number;\n36\t  /** cledger's own version. */\n37\t  version: string;\n38\t  rawFormat: string;\n39\t  conversationId: string;\n40\t  /** Parent conversation id, for sub-conversations (see ConversationRef). */\n41\t  parentConversationId?: string;\n42\t  agent?: ProducerAgentContext;\n43\t}\n44\t\n45\t/**\n46\t * The shared skeleton every record shares: provenance, conversation position,\n47\t * and the verbatim source line under `raw`. Exported because a few source\n48\t * types map onto an existing kind rather than a new one — Claude Code's\n49\t * `system` lines that print into the conversation are `conversation_turn`s —\n50\t * and those still want this exact envelope.\n51\t */\n52\texport function recordDraft(\n53\t  ctx: RecordContext,\n54\t  kind: string,\n55\t  actorType: string,\n56\t  content: unknown,\n57\t  raw: unknown,\n58\t): EventDraft {\n59\t  return {\n60\t    kind,\n61\t    occurred_at: ctx.occurredAt,\n62\t    actor: { type: actorType },\n63\t    producer: {\n64\t      tool: \"cledger\",\n65\t      version: ctx.version,\n66\t      source: ctx.source,\n67\t      session_id: ctx.sessionId,\n68\t      ...ctx.agent,\n69\t    },\n70\t    conversation: {\n71\t      id: ctx.conversationId,\n72\t      seq: ctx.seq,\n73\t      ...(ctx.parentConversationId ? { parent: ctx.parentConversationId } : {}),\n74\t    },\n75\t    content,\n76\t    raw: { format: ctx.rawFormat, data: raw },\n77\t  };\n78\t}\n79\t\n80\t/**\n81\t * Text blocks for a record, or nothing when there is no text to carry.\n82\t * Empty and whitespace-only strings are dropped rather than stored as an\n83\t * empty block — a block that renders as nothing is worse than no block,\n84\t * because a consumer cannot tell it apart from real empty output.\n85\t */\n86\texport function textBlocks(...texts: unknown[]): { blocks: unknown[] } | Record<string, never> {\n87\t  const blocks = texts\n88\t    .filter((t): t is string => typeof t === \"string\" && t.trim() !== \"\")\n89\t    .map((text) => ({ type: \"text\", text }));\n90\t  return blocks.length > 0 ? { blocks } : {};\n91\t}\n92\t\n93\t/**\n94\t * Move a source field's text into `blocks`, returning the remaining fields.\n95\t * Lifting rather than copying: a queued prompt or a command's stdout can run\n96\t * to kilobytes, and storing it under both its source field name and `blocks`\n97\t * would double that for no gain — `raw.data` already holds the original\n98\t * under its original name.\n99\t */\n100\texport function liftText(\n101\t  fields: Record<string, unknown>,\n102\t  key: string,\n103\t): Record<string, unknown> {\n104\t  const value = fields[key];\n105\t  if (typeof value !== \"string\" || value.trim() === \"\") return fields;\n106\t  const { [key]: _lifted, ...rest } = fields;\n107\t  return { ...rest, ...textBlocks(value) };\n108\t}\n109\t\n110\t/**\n111\t * A declaration the session makes about itself, holding until restated.\n112\t *\n113\t * The actor is `system`: a mode change is the harness recording its own\n114\t * configuration, not the user speaking, even when the user is what caused it.\n115\t * Sources restate this constantly and each restatement is kept — `seq` makes\n116\t * them distinct events, so \"the mode was still `auto` here\" survives as a\n117\t * fact rather than collapsing into the first statement.\n118\t */\n119\texport function sessionStateDraft(\n120\t  ctx: RecordContext,\n121\t  stateType: string,\n122\t  state: Record<string, unknown>,\n123\t  raw: unknown,\n124\t): EventDraft {\n125\t  // Discriminator last: a source field that happened to be named\n126\t  // `state_type` must not be able to overwrite the label the ledger set.\n127\t  return recordDraft(ctx, \"session_state\", \"system\", { ...state, state_type: stateType }, raw);\n128\t}\n129\t\n130\t/**\n131\t * Something that happened in the harness and is not a turn.\n132\t *\n133\t * The actor is `system` for harness bookkeeping and `agent` for things the\n134\t * model drove (a task it started, a step it finished); callers pass whichever\n135\t * the source supports, defaulting to `system` because most of this is the\n136\t * harness talking about itself.\n137\t */\n138\texport function activityDraft(\n139\t  ctx: RecordContext,\n140\t  activityType: string,\n141\t  detail: Record<string, unknown>,\n142\t  raw: unknown,\n143\t  actorType = \"system\",\n144\t): EventDraft {\n145\t  return recordDraft(ctx, \"activity\", actorType, { ...detail, activity_type: activityType }, raw);\n146\t}\n147\t\n148\t/**\n149\t * Material the harness put into the model's context that nobody typed.\n150\t *\n151\t * The actor is `system` for the same reason `activity`'s is: the harness is\n152\t * the one that spoke. What separates this from `activity` is that the model\n153\t * read it — a consumer reconstructing what the model knew at a point in the\n154\t * conversation needs these, and does not need turn durations.\n155\t */\n156\texport function contextInjectionDraft(\n157\t  ctx: RecordContext,\n158\t  injectionType: string,\n159\t  injection: Record<string, unknown>,\n160\t  raw: unknown,\n161\t): EventDraft {\n162\t  return recordDraft(\n163\t    ctx,\n164\t    \"context_injection\",\n165\t    \"system\",\n166\t    { ...injection, injection_type: injectionType },\n167\t    raw,\n168\t  );\n169\t}\n170\t\n171\t/** One file version a snapshot record points at. */\n172\texport interface SnapshotFile {\n173\t  /** Path as the source states it — relative to the project for snapshots,\n174\t   *  absolute for deltas. Left exactly as stated rather than normalized. */\n175\t  path: string;\n176\t  /** Directory the file really lived in, when the source states it. */\n177\t  dir?: string;\n178\t  /** Source's own version counter for this file within the session. */\n179\t  version?: number;\n180\t  /** When the source took the backup, ISO 8601. */\n181\t  backup_time?: string;\n182\t  /**\n183\t   * Name of the backup file in the source's local cache. A pointer, not\n184\t   * content: the cache is machine-local and prunable, so this is stored for\n185\t   * traceability while `resolved` carries what the ledger could actually read\n186\t   * from it. Null when the source recorded no backup (a tracked file it had\n187\t   * not yet copied).\n188\t   */\n189\t  backup_file?: string | null;\n190\t}\n191\t\n192\t/** What the ledger read from a backup file, keyed by the pointer that named it. */\n193\texport interface ResolvedFile {\n194\t  backup_file: string;\n195\t  sha256: string;\n196\t  bytes: number;\n197\t}\n198\t\n199\t/**\n200\t * Intermediate file state: the versions a file passed through between\n201\t * commits.\n202\t *\n203\t * `operation` distinguishes the source's two shapes — a full statement of\n204\t * every tracked file (`snapshot`) from a single file's change (`delta`) —\n205\t * because a consumer reconstructing file history needs to know whether an\n206\t * absent file means \"unchanged\" or \"no longer tracked\".\n207\t *\n208\t * `resolved` is passed separately from `content` and stays out of event\n209\t * identity on purpose (see EvidenceEvent.resolved): the digests come from a\n210\t * cache that may be gone by the next rescan, and an id that moved when the\n211\t * cache was pruned would duplicate every snapshot in the ledger.\n212\t */\n213\texport function fileSnapshotDraft(\n214\t  ctx: RecordContext,\n215\t  operation: \"snapshot\" | \"delta\",\n216\t  detail: { message_id?: string; snapshot_message_id?: string; is_update?: boolean },\n217\t  files: SnapshotFile[],\n218\t  raw: unknown,\n219\t  resolvedFiles: ResolvedFile[],\n220\t): EventDraft {\n221\t  const draft = recordDraft(\n222\t    ctx,\n223\t    \"file_snapshot\",\n224\t    \"system\",\n225\t    { ...detail, operation, files },\n226\t    raw,\n227\t  );\n228\t  if (resolvedFiles.length > 0) draft.resolved = { files: resolvedFiles };\n229\t  return draft;\n230\t}\n231\t","tool_use_id":"toolu_019ivKmpcs4jNwg45feBpvK5","typ