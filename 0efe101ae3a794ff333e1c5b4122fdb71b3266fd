{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Qwen Code adapter.\n3\t *\n4\t * Qwen Code is a fork of Gemini CLI, but its conversation store is the one\n5\t * piece it did *not* inherit: where gemini-cli keeps a replayed write-ahead\n6\t * log (see gemini-cli.ts), Qwen Code writes a plain append-only JSONL\n7\t * transcript at `~/.qwen/projects/<escaped-cwd>/chats/<session-id>.jsonl`,\n8\t * one JSON object per line, with nearly the same envelope fields as\n9\t * claude-code (`uuid`, `parentUuid`, `sessionId`, `timestamp`, `cwd`,\n10\t * `gitBranch`, `version`). So this adapter is the claude-code adapter's twin\n11\t * in structure — per-line conversion, line-index `seq`, a line-count cursor,\n12\t * a catch-up sweep — and differs in two places: message content is a Google\n13\t * GenAI `Part` list (shared with gemini-cli in genai-parts.ts), and every\n14\t * non-turn record arrives as a `system` line discriminated by `subtype`\n15\t * rather than as its own top-level type.\n16\t *\n17\t * Verified against a live Qwen Code 0.21.5 session and against its shipped\n18\t * sources: `RECORD_TYPES` is exactly `user`/`assistant`/`tool_result`/\n19\t * `system`, assistant lines carry the serving model at the *top level*\n20\t * (`line.model`, not inside `message`), and `message.role` is Google's\n21\t * `\"user\"`/`\"model\"` rather than `\"user\"`/`\"assistant\"`.\n22\t */\n23\timport { readdir, readFile, stat } from \"node:fs/promises\";\n24\timport { homedir } from \"node:os\";\n25\timport { basename, join } from \"node:path\";\n26\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n27\timport { appendEvents } from \"../store.js\";\n28\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n29\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n30\timport { convertParts, isEmptyParts } from \"./genai-parts.js\";\n31\timport {\n32\t  countUnrecognized,\n33\t  mergeCaptureResult,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\timport {\n39\t  activityDraft,\n40\t  contextInjectionDraft,\n41\t  liftText,\n42\t  recordDraft,\n43\t  sessionStateDraft,\n44\t  type RecordContext,\n45\t} from \"./records.js\";\n46\t\n47\tconst RAW_FORMAT = \"qwen-code-jsonl/1\";\n48\t\n49\tconst CURSOR_FIELD = \"lines\";\n50\t\n51\t/**\n52\t * Line types carrying visible conversation content. `tool_result` is its own\n53\t * top-level type here, unlike claude-code where a tool result rides inside a\n54\t * `user` message — hence three convertible types rather than two.\n55\t */\n56\tconst CONVERTIBLE_LINE_TYPES = new Set([\"user\", \"assistant\", \"tool_result\"]);\n57\t\n58\t/**\n59\t * Every top-level record type Qwen Code writes, taken verbatim from its own\n60\t * `RECORD_TYPES` set. A line whose type is outside this set is genuinely new\n61\t * upstream content and routes to the drift path — preserved raw, warned\n62\t * about, upgradeable later by `cledger renormalize`.\n63\t */\n64\tconst RECORD_TYPES = new Set([\"user\", \"assistant\", \"tool_result\", \"system\"]);\n65\t\n66\t/**\n67\t * How a `system` line's `subtype` maps onto a record kind.\n68\t *\n69\t * Qwen Code funnels everything that is not a turn through `system`, so the\n70\t * subtype is the real discriminator; the names below are its own\n71\t * `KNOWN_RECORD_SUBTYPES`. The split follows the same reasoning the\n72\t * claude-code adapter applies to its top-level types: a declaration that\n73\t * holds until restated is `session_state`, material the harness put in front\n74\t * of the model is `context_injection`, and intermediate file state is\n75\t * `file_snapshot`.\n76\t *\n77\t * Anything not listed — including a subtype a future Qwen Code adds — falls\n78\t * through to `activity`, which is the honest default: `system` is a type this\n79\t * adapter knows, so preserving it raw-only and warning about drift would be a\n80\t * false alarm, but claiming to know that an unseen subtype is *state* would\n81\t * be a guess. \"Something happened, here are its fields verbatim\" is true of\n82\t * all of them.\n83\t */\n84\tconst SESSION_STATE_SUBTYPES = new Set([\n85\t  \"custom_title\",\n86\t  \"session_source\",\n87\t  \"parent_session\",\n88\t  \"goal_state\",\n89\t]);\n90\tconst CONTEXT_INJECTION_SUBTYPES = new Set([\n91\t  \"at_command\",\n92\t  \"agent_bootstrap\",\n93\t  \"agent_launch_prompt\",\n94\t]);\n95\tconst FILE_SNAPSHOT_SUBTYPES = new Set([\"attribution_snapshot\", \"file_history_snapshot\"]);\n96\t\n97\t/**\n98\t * Envelope fields every Qwen Code line carries. Dropped from the structured\n99\t * `content` of record events because they are already on the event itself\n100\t * (`occurred_at`, `producer.session_id`, `producer.source_version`) or in\n101\t * `raw.data` — repeating them in `content` would put one fact in three places\n102\t * with three chances to disagree. Mirrors claude-code's `ENVELOPE_KEYS`.\n103\t */\n104\tconst ENVELOPE_KEYS = new Set([\n105\t  \"type\",\n106\t  \"subtype\",\n107\t  \"uuid\",\n108\t  \"parentUuid\",\n109\t  \"sessionId\",\n110\t  \"timestamp\",\n111\t  \"cwd\",\n112\t  \"version\",\n113\t  \"gitBranch\",\n114\t  \"provenance\",\n115\t]);\n116\t\n117\tfunction payloadFields(line: Record<string, unknown>): Record<string, unknown> {\n118\t  const out: Record<string, unknown> = {};\n119\t  for (const [key, value] of Object.entries(line)) {\n120\t    if (!ENVELOPE_KEYS.has(key)) out[key] = value;\n121\t  }\n122\t  return out;\n123\t}\n124\t\n125\t/** Payload Qwen Code's hooks engine sends on stdin (subset we read). */\n126\tinterface QwenHookPayload {\n127\t  session_id?: string;\n128\t  transcript_path?: string;\n129\t  cwd?: string;\n130\t  hook_event_name?: string;\n131\t}\n132\t\n133\t/** One line of a `~/.qwen/projects/<escaped-cwd>/chats/<id>.jsonl` transcript. */\n134\tinterface QwenTranscriptLine {\n135\t  type?: string;\n136\t  /** `system` lines: which kind, e.g. \"ui_telemetry\" / \"parent_session\". */\n137\t  subtype?: string;\n138\t  /** `system` lines: the subtype's own payload. */\n139\t  systemPayload?: Record<string, unknown>;\n140\t  uuid?: string;\n141\t  parentUuid?: string;\n142\t  sessionId?: string;\n143\t  timestamp?: string;\n144\t  provenance?: string;\n145\t  cwd?: string;\n146\t  gitBranch?: string;\n147\t  /** Qwen Code's own CLI version, e.g. \"0.21.5\". */\n148\t  version?: string;\n149\t  /** Serving model, stated top-level on assistant lines only. */\n150\t  model?: string;\n151\t  message?: { role?: string; parts?: unknown };\n152\t  /** Present on `tool_result` lines alongside the functionResponse part. */\n153\t  toolCallResult?: { callId?: string; status?: string; executionStatus?: string };\n154\t}\n155\t\n156\t/** One file's state inside an `attribution_snapshot` payload. */\n157\tinterface QwenFileState {\n158\t  contentHash?: string;\n159\t  aiContribution?: number;\n160\t  aiCreated?: boolean;\n161\t}\n162\t\n163\t/**\n164\t * Where Qwen Code keeps a working directory's chats. The directory name is\n165\t * the absolute cwd with every `/` and `.` replaced by `-`, the same escaping\n166\t * claude-code uses for `~/.claude/projects/`.\n167\t */\n168\texport function qwenProjectChatsDir(cwd: string): string {\n169\t  return join(homedir(), \".qwen\", \"projects\", cwd.replace(/[/.]/g, \"-\"), \"chats\");\n170\t}\n171\t\n172\t/**\n173\t * A deterministic session time for records that carry no timestamp of their\n174\t * own: the first timestamp anywhere in the transcript (stable across\n175\t * rescans), falling back to the file mtime.\n176\t */\n177\tfunction firstTimestamp(lines: string[]): string | null {\n178\t  for (const text of lines) {\n179\t    if (!text.trim()) continue;\n180\t    try {\n181\t      const parsed = JSON.parse(text) as QwenTranscriptLine;\n182\t      if (typeof parsed.timestamp === \"string\" && !Number.isNaN(Date.parse(parsed.timestamp))) {\n183\t        return parsed.timestamp;\n184\t      }\n185\t    } catch {\n186\t      continue;\n187\t    }\n188\t  }\n189\t  return null;\n190\t}\n191\t\n192\tasync function sessionMtime(transcriptPath: string): Promise<string> {\n193\t  try {\n194\t    return (await stat(transcriptPath)).mtime.toISOString();\n195\t  } catch {\n196\t    return new Date().toISOString();\n197\t  }\n198\t}\n199\t\n200\t/**\n201\t * The parent session this transcript belongs to, if any.\n202\t *\n203\t * Qwen Code gives a subagent its own chat file and records the link once, as\n204\t * a `system`/`parent_session` line written right after the sub-session is\n205\t * created. The whole file is scanned rather than just the lines past the\n206\t * cursor: a cursor-resumed capture starts mid-file and would otherwise never\n207\t * see the record, and every event in the file needs the same parent to keep\n208\t * their ids stable across resumes. (The codex adapter re-scans its prefix for\n209\t * the same reason.)\n210\t */\n211\tfunction parentSessionId(lines: string[]): string | undefined {\n212\t  for (const text of lines) {\n213\t    if (!text.trim()) continue;\n214\t    let parsed: QwenTranscriptLine;\n215\t    try {\n216\t      parsed = JSON.parse(text) as QwenTranscriptLine;\n217\t    } catch {\n218\t      continue;\n219\t    }\n220\t    if (parsed.type !== \"system\" || parsed.subtype !== \"parent_session\") continue;\n221\t    const id = parsed.systemPayload?.[\"parentSessionId\"];\n222\t    if (typeof id === \"string\" && id) return id;\n223\t  }\n224\t  return undefined;\n225\t}\n226\t\n227\t/** Which conversation a transcript's lines belong to. */\n228\tfunction conversationFor(sessionId: string, parentId?: string): { id: string; parent?: string } {\n229\t  const id = `qwen-code:${sessionId}`;\n230\t  return parentId ? { id, parent: `qwen-code:${parentId}` } : { id };\n231\t}\n232\t\n233\t/**\n234\t * The agent facts this line states about itself. Qwen Code stamps every line\n235\t * with the CLI `version`, and labels assistant lines with the model that\n236\t * produced them; user and tool_result lines carry no model, and none is\n237\t * invented for them — the same rule the claude-code adapter follows, and for\n238\t * the same reason (the model that will answer a prompt is not knowable from\n239\t * the prompt's own line, and it can change mid-session).\n240\t *\n241\t * The provider is deliberately left unset even though Qwen Code knows it: the\n242\t * value appears as `auth_type` inside `ui_telemetry` payloads, and it names an\n243\t * *auth mode* (\"openai\", \"qwen-oauth\") rather than the inference provider\n244\t * `Producer.provider` asks for. Reading it off a neighbouring line would also\n245\t * break the per-line independence a cursor-resumed capture depends on.\n246\t */\n247\tfunction agentContext(line: QwenTranscriptLine): ProducerAgentContext {\n248\t  const agent: ProducerAgentContext = {};\n249\t  if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n250\t  if (typeof line.model === \"string\" && line.model) agent.model = line.model;\n251\t  return agent;\n252\t}\n253\t\n254\t/**\n255\t * The `RecordContext` a non-turn line converts under. Shared by the capture\n256\t * loop and the re-normalization hook so both mint the same event identity —\n257\t * `conversation` and `occurred_at` are both part of the identity subset, so\n258\t * any divergence would write a second copy instead of deduping.\n259\t */\n260\tfunction recordContext(\n261\t  line: QwenTranscriptLine,\n262\t  occurredAt: string,\n263\t  seq: number,\n264\t  fileSessionId: string,\n265\t  version: string,\n266\t  parentId: string | undefined,\n267\t): RecordContext {\n268\t  const sessionId = line.sessionId ?? fileSessionId;\n269\t  const conversation = conversationFor(sessionId, parentId);\n270\t  return {\n271\t    occurredAt,\n272\t    source: \"qwen-code\",\n273\t    sessionId,\n274\t    seq,\n275\t    version,\n276\t    rawFormat: RAW_FORMAT,\n277\t    conversationId: conversation.id,\n278\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n279\t    agent: agentContext(line),\n280\t  };\n281\t}\n282\t\n283\t/**\n284\t * An `attribution_snapshot` as a `file_snapshot`.\n285\t *\n286\t * Qwen tracks, per file, a content hash and how much of the file it attributes\n287\t * to the model. Unlike Claude Code's file history there is no local cache to\n288\t * resolve — the digest is in the record itself — so nothing goes in\n289\t * `resolved`, and `content` carries the source's own per-file fields beside\n290\t * the path they were keyed by.\n291\t */\n292\tfunction attributionSnapshot(line: QwenTranscriptLine, ctx: RecordContext): EventDraft {\n293\t  const snapshot = (line.systemPayload?.[\"snapshot\"] ?? {}) as Record<string, unknown>;\n294\t  const { fileStates, ...rest } = snapshot;\n295\t  const states = (fileStates ?? {}) as Record<string, QwenFileState>;\n296\t  const files = Object.entries(states).map(([path, state]) => ({ path, ...state }));\n297\t  return recordDraft(\n298\t    ctx,\n299\t    \"file_snapshot\",\n300\t    \"system\",\n301\t    { ...rest, operation: \"snapshot\", files },\n302\t    line,\n303\t  );\n304\t}\n305\t\n306\t/**\n307\t * Convert a line that is not a turn into the record it deserves, or null when\n308\t * the type is outside Qwen's own record set (the caller routes it to drift).\n309\t */\n310\tfunction convertRecordLine(line: QwenTranscriptLine, ctx: RecordContext): EventDraft | null {\n311\t  if (line.type !== \"system\") return null;\n312\t  const subtype = typeof line.subtype === \"string\" ? line.subtype : \"untyped\";\n313\t  const fields = payloadFields(line as unknown as Record<string, unknown>);\n314\t\n315\t  if (FILE_SNAPSHOT_SUBTYPES.has(subtype)) {\n316\t    if (subtype === \"attribution_snapshot\") return attributionSnapshot(line, ctx);\n317\t    // Any other file-history subtype keeps its payload verbatim: same kind,\n318\t    // no invented shape, because its fields have not been seen.\n319\t    return recordDraft(ctx, \"file_snapshot\", \"system\", { ...fields, operation: subtype }, line);\n320\t  }\n321\t  if (SESSION_STATE_SUBTYPES.has(subtype)) {\n322\t    return sessionStateDraft(ctx, subtype, fields, line);\n323\t  }\n324\t  if (CONTEXT_INJECTION_SUBTYPES.has(subtype)) {\n325\t    return contextInjectionDraft(ctx, subtype, fields, line);\n326\t  }\n327\t  // `content` is where a text-bearing system record (a notification, a queued\n328\t  // mid-turn message) puts its prose; lifting it gives `blocks` for free and\n329\t  // is a no-op when there is none.\n330\t  return activityDraft(ctx, `system/${subtype}`, liftText(fields, \"content\"), line);\n331\t}\n332\t\n333\tfunction convertLine(\n334\t  line: QwenTranscriptLine,\n335\t  seq: number,\n336\t  version: string,\n337\t  identity: GitUserIdentity,\n338\t  fileSessionId: string,\n339\t  parentId: string | undefined,\n340\t): EventDraft | null {\n341\t  const type = line.type;\n342\t  if (typeof type !== \"string\" || !CONVERTIBLE_LINE_TYPES.has(type)) return null;\n343\t  if (!line.message) return null;\n344\t  if (typeof line.timestamp !== \"string\") return null;\n345\t  if (isEmptyParts(line.message.parts)) return null;\n346\t  const sessionId = line.sessionId ?? fileSessionId;\n347\t\n348\t  // `tool_result` lines are stored with `message.role: \"user\"` because that is\n349\t  // how the GenAI API frames a function response, but the human did not say\n350\t  // them. They get the `system` actor every other adapter gives a standalone\n351\t  // tool result, rather than being attributed to the person at the keyboard.\n352\t  const actor: Actor =\n353\t    type === \"user\"\n354\t      ? { type: \"human\" }\n355\t      : type === \"assistant\"\n356\t        ? { type: \"agent\" }\n357\t        : { type: \"system\" };\n358\t  if (type === \"user\") {\n359\t    if (identity.email) actor.id = identity.email;\n360\t    if (identity.name) actor.display = identity.name;\n361\t  }\n362\t  if (type === \"assistant\" && typeof line.model === \"string\" && line.model) actor.id = line.model;\n363\t\n364\t  const content: Record<string, unknown> = {};\n365\t  if (typeof line.message.role === \"string\") content[\"role\"] = line.message.role;\n366\t  content[\"blocks\"] = convertParts(line.message.parts);\n367\t\n368\t  const conversation = conversationFor(sessionId, parentId);\n369\t  return {\n370\t    kind: \"conversation_turn\",\n371\t    occurred_at: line.timestamp,\n372\t    actor,\n373\t    producer: {\n374\t      tool: \"cledger\",\n375\t      version,\n376\t      source: \"qwen-code\",\n377\t      session_id: sessionId,\n378\t      ...agentContext(line),\n379\t    },\n380\t    conversation: {\n381\t      id: conversation.id,\n382\t      seq,\n383\t      ...(conversation.parent ? { parent: conversation.parent } : {}),\n384\t    },\n385\t    content,\n386\t    raw: { format: RAW_FORMAT, data: line },\n387\t  };\n388\t}\n389\t\n390\t/** Raw-only preservation event for an unrecognized qwen-code line (see drift.ts). */\n391\tfunction preserve(\n392\t  type: string,\n393\t  line: QwenTranscriptLine,\n394\t  occurredAt: string,\n395\t  seq: number,\n396\t  fileSessionId: string,\n397\t  version: string,\n398\t  parentId: string | undefined,\n399\t): EventDraft {\n400\t  const sessionId = line.sessionId ?? fileSessionId;\n401\t  const conversation = conversationFor(sessionId, parentId);\n402\t  return unrecognizedDraft({\n403\t    typeKey: type,\n404\t    line,\n405\t    occurredAt,\n406\t    source: \"qwen-code\",\n407\t    sessionId,\n408\t    seq,\n409\t    version,\n410\t    rawFormat: RAW_FORMAT,\n411\t    conversationId: conversation.id,\n412\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n413\t    agent: agentContext(line),\n414\t  });\n415\t}\n416\t\n417\t/**\n418\t * Re-normalization hook (see renormalize.ts): re-feed a preserved line's\n419\t * stored `raw.data` through the same convert paths a live capture uses, with\n420\t * the same seq and session id, so the reconstructed event's id is identical\n421\t * to what a later live capture of that line would produce.\n422\t *\n423\t * The parent link is recovered from the preserved event's own\n424\t * `conversation.parent` rather than by re-reading the transcript, which may\n425\t * be long gone; that is the same value the capture path used.\n426\t */\n427\texport function renormalizeUnrecognized(\n428\t  event: EvidenceEvent,\n429\t  identity: GitUserIdentity,\n430\t): EventDraft | null {\n431\t  if (!event.raw || event.conversation === undefined) return null;\n432\t  const line = event.raw.data as QwenTranscriptLine;\n433\t  const sessionId = event.producer.session_id ?? \"\";\n434\t  const parentId = event.conversation.parent?.replace(/^qwen-code:/, \"\");\n435\t  const version = packageVersion();\n436\t  const turn = convertLine(line, event.conversation.seq, version, identity, sessionId, parentId);\n437\t  if (turn) return turn;\n438\t  if (line?.type !== \"system\") return null;\n439\t  const ctx = recordContext(line, event.occurred_at, event.conversation.seq, sessionId, version, parentId);\n440\t  return convertRecordLine(line, ctx);\n441\t}\n442\t\n443\t/** Capture one transcript file. Does not print — `captureQwenTranscript` wraps it. */\n444\tasync function captureTranscriptFile(\n445\t  repo: RepoInfo,\n446\t  transcriptPath: string,\n447\t): Promise<CaptureResult> {\n448\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n449\t  let raw: string;\n450\t  try {\n451\t    raw = await readFile(transcriptPath, \"utf8\");\n452\t  } catch {\n453\t    return result; // transcript not written yet\n454\t  }\n455\t  // Whether the writer had finished the last line when we read. A transcript\n456\t  // that does not end in a newline was caught mid-write, which is how the\n457\t  // final line comes to be torn — see `tornTail` below.\n458\t  const endsWithNewline = raw.endsWith(\"\\n\");\n459\t  const lines = raw.split(\"\\n\");\n460\t  if (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n461\t\n462\t  const sessionId = basename(transcriptPath, \".jsonl\");\n463\t  const stored = (await readCursor(repo, sessionId, CURSOR_FIELD)) ?? { count: 0, size: 0 };\n464\t  let cursor = stored.count;\n465\t  if (cursor > lines.length) cursor = 0; // shorter than expected — rescan from the start\n466\t\n467\t  /**\n468\t   * Index of a half-written final line, when there is one. Advancing past it\n469\t   * would skip that line permanently once its bytes land. Both conditions are\n470\t   * load-bearing: a parse failure anywhere but the unterminated last line is\n471\t   * real corruption, and holding the cursor there would stall capture forever.\n472\t   */\n473\t  let tornTail: number | null = null;\n474\t\n475\t  const version = packageVersion();\n476\t  const identity = await gitUserIdentity(repo);\n477\t  const parentId = parentSessionId(lines);\n478\t  let baseTime: string | null = null; // lazy: only a timestampless record needs it\n479\t  const drafts: EventDraft[] = [];\n480\t  for (let i = cursor; i < lines.length; i++) {\n481\t    const text = lines[i]!;\n482\t    if (!text.trim()) continue;\n483\t    let parsed: QwenTranscriptLine;\n484\t    try {\n485\t      parsed = JSON.parse(text) as QwenTranscriptLine;\n486\t    } catch {\n487\t      // Partial line — normal at the tail of a live transcript. Remember it so\n488\t      // the cursor stops here rather than stepping over it for good.\n489\t      if (!endsWithNewline && i === lines.length - 1) tornTail = i;\n490\t      continue;\n491\t    }\n492\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n493\t\n494\t    if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n495\t      if (baseTime === null) {\n496\t        baseTime = firstTimestamp(lines) ?? (await sessionMtime(transcriptPath));\n497\t      }\n498\t      const occurredAt = typeof parsed.timestamp === \"string\" ? parsed.timestamp : baseTime;\n499\t      const ctx = recordContext(parsed, occurredAt, i, sessionId, version, parentId);\n500\t      const record = RECORD_TYPES.has(type) ? convertRecordLine(parsed, ctx) : null;\n501\t      if (record) {\n502\t        drafts.push(record);\n503\t        continue;\n504\t      }\n505\t      // Outside Qwen's own record set: preserve raw and warn.\n506\t      countUnrecognized(result.unrecognized, type);\n507\t      drafts.push(preserve(type, parsed, occurredAt, i, sessionId, version, parentId));\n508\t      continue;\n509\t    }\n510\t    const draft = convertLine(parsed, i, version, identity, sessionId, parentId);\n511\t    if (draft) drafts.push(draft);\n512\t  }\n513\t\n514\t  if (drafts.length > 0) {\n515\t    const appendResult = await appendEvents(repo, drafts);\n516\t    result.appended = appendResult.appended.length;\n517\t    result.deduped = appendResult.deduped;\n518\t  }\n519\t  // With a torn tail the cursor stops before it, and the recorded size is the\n520\t  // byte offset that line starts at — not the file's size, which would tell\n521\t  // the next sweep nothing had changed and strand the very line held back.\n522\t  const consumed = tornTail ?? lines.length;\n523\t  const size =\n524\t    tornTail === null\n525\t      ? Buffer.byteLength(raw)\n526\t      : Buffer.byteLength(lines.slice(0, consumed).join(\"\\n\")) + (consumed > 0 ? 1 : 0);\n527\t  await writeCursor(repo, sessionId, CURSOR_FIELD, consumed, size);\n528\t  return result;\n529\t}\n530\t\n531\texport async function captureQwenTranscript(\n532\t  transcriptPath: string,\n533\t  cwd: string,\n534\t): Promise<CaptureResult> {\n535\t  const repo = await findRepo(cwd);\n536\t  if (!repo) throw new Error(\"not inside a git repository\");\n537\t  const result = await captureTranscriptFile(repo, transcriptPath);\n538\t  process.stderr.write(`cledger: qwen-code +${result.appended} events (${result.deduped} deduped)\\n`);\n539\t  warnUnrecognized(\"qwen-code\", result.unrecognized);\n540\t  return result;\n541\t}\n542\t\n543\t/** Every `.jsonl` chat file Qwen Code has written for this project, newest first. */\n544\tasync function projectTranscripts(cwd: string): Promise<string[]> {\n545\t  const dir = qwenProjectChatsDir(cwd);\n546\t  let names: string[];\n547\t  try {\n548\t    names = await readdir(dir);\n549\t  } catch {\n550\t    return [];\n551\t  }\n552\t  const stamped = await Promise.all(\n553\t    names\n554\t      .filter((name) => name.endsWith(\".jsonl\"))\n555\t      .map(async (name) => {\n556\t        const path = join(dir, name);\n557\t        return { path, mtime: await stat(path).then((s) => s.mtimeMs, () => 0) };\n558\t      }),\n559\t  );\n560\t  stamped.sort((a, b) => b.mtime - a.mtime);\n561\t  return stamped.map((s) => s.path);\n562\t}\n563\t\n564\t/**\n565\t * Capture every Qwen Code chat recorded for this project, whether or not\n566\t * cledger has seen it before. This is the explicit backfill behind\n567\t * `cledger capture qwen-code --all`, and is deliberately *not* what the hook\n568\t * runs — see `sweepStaleTranscripts`.\n569\t */\n570\texport async function captureQwenAll(cwd: string, limit?: number): Promise<CaptureResult> {\n571\t  const repo = await findRepo(cwd);\n572\t  if (!repo) throw new Error(\"not inside a git repository\");\n573\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n574\t  const paths = await projectTranscripts(cwd);\n575\t  for (const path of typeof limit === \"number\" ? paths.slice(0, limit) : paths) {\n576\t    mergeCaptureResult(total, await captureTranscriptFile(repo, path));\n577\t  }\n578\t  process.stderr.write(`cledger: qwen-code +${total.appended} events (${total.deduped} deduped)\\n`);\n579\t  warnUnrecognized(\"qwen-code\", total.unrecognized);\n580\t  return total;\n581\t}\n582\t\n583\t/**\n584\t * Capture any *other* transcript in this project that has grown since it was\n585\t * last read — the same gap-closing pass the claude-code adapter runs, and for\n586\t * the same reason: a session's own final lines are unreachable to it, because\n587\t * the hook fires, capture reads to end-of-file, and Qwen Code then writes the\n588\t * closing bookkeeping of that turn with no further hook to pick it up.\n589\t *\n590\t * A transcript with *no* cursor is skipped, and that bound is the point. A\n591\t * missing cursor means cledger never captured that session at all — it\n592\t * predates the install, or the user did not want it — and adopting those\n593\t * would turn a gap-closing sweep into a silent backfill of every conversation\n594\t * ever held in the project, anchored to whatever HEAD is checked out now\n595\t * rather than the commit it was about. `--all` is where that belongs, on\n596\t * purpose and by request.\n597\t *\n598\t * Failures are swallowed per session: a sweep is a bonus pass over\n599\t * conversations the user is not currently having, and must never be the\n600\t * reason their live capture reports an error.\n601\t */\n602\tasync function sweepStaleTranscripts(\n603\t  repo: RepoInfo,\n604\t  cwd: string,\n605\t  seen: Set<string>,\n606\t): Promise<CaptureResult> {\n607\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n608\t  for (const path of await projectTranscripts(cwd)) {\n609\t    if (seen.has(path)) continue;\n610\t    try {\n611\t      const cursor = await readCursor(repo, basename(path, \".jsonl\"), CURSOR_FIELD);\n612\t      if (cursor === null) continue; // never captured — not this pass's business\n613\t      const info = await stat(path);\n614\t      if (info.size <= cursor.size) continue; // nothing new since the last read\n615\t      mergeCaptureResult(total, await captureTranscriptFile(repo, path));\n616\t    } catch {\n617\t      continue;\n618\t    }\n619\t  }\n620\t  return total;\n621\t}\n622\t\n623\texport async function runQwenHook(stdinJson: string): Promise<void> {\n624\t  try {\n625\t    const payload = JSON.parse(stdinJson) as QwenHookPayload;\n626\t    const cwd = payload.cwd ?? process.cwd();\n627\t    const repo = await findRepo(cwd);\n628\t    if (!repo) return; // hooks must never break the user's session outside a repo\n629\t    const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n630\t    const seen = new Set<string>();\n631\t    if (payload.transcript_path) {\n632\t      seen.add(payload.transcript_path);\n633\t      mergeCaptureResult(total, await captureTranscriptFile(repo, payload.transcript_path));\n634\t    }\n635\t    mergeCaptureResult(total, await sweepStaleTranscripts(repo, cwd, seen));\n636\t    process.stderr.write(`cledger: qwen-code +${total.appended} events (${total.deduped} deduped)\\n`);\n637\t    warnUnrecognized(\"qwen-code\", total.unrecognized);\n638\t  } catch (err) {\n639\t    process.stderr.write(\n640\t      `cledger: qwen-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n641\t    );\n642\t  }\n643\t}\n644\t","tool_use_id":"toolu_01CShsU9pDqpPZL5u7QQrL15","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","head":"0efe101ae3a794ff333e1c5b4122fdb71b3266fd","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:d10310cd-8144-4046-87b9-97bbb6ace18c","seq":114},"id":"ev1-143ea555c1558e9f7922151f3aaaa98c1401fa1203b77247c34b34183bd9dc96","kind":"conversation_turn","occurred_at":"2026-08-06T04:40:29.480Z","producer":{"session_id":"d10310cd-8144-4046-87b9-97bbb6ace18c","source":"claude-code","source_version":"2.1.223","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","entrypoint":"cli","gitBranch":"worktree-more-cli-adapters","isSidechain":false,"message":{"content":[{"content":"1\t/**\n2\t * Qwen Code adapter.\n3\t *\n4\t * Qwen Code is a fork of Gemini CLI, but its conversation store is the one\n5\t * piece it did *not* inherit: where gemini-cli keeps a replayed write-ahead\n6\t * log (see gemini-cli.ts), Qwen Code writes a plain append-only JSONL\n7\t * transcript at `~/.qwen/projects/<escaped-cwd>/chats/<session-id>.jsonl`,\n8\t * one JSON object per line, with nearly the same envelope fields as\n9\t * claude-code (`uuid`, `parentUuid`, `sessionId`, `timestamp`, `cwd`,\n10\t * `gitBranch`, `version`). So this adapter is the claude-code adapter's twin\n11\t * in structure — per-line conversion, line-index `seq`, a line-count cursor,\n12\t * a catch-up sweep — and differs in two places: message content is a Google\n13\t * GenAI `Part` list (shared with gemini-cli in genai-parts.ts), and every\n14\t * non-turn record arrives as a `system` line discriminated by `subtype`\n15\t * rather than as its own top-level type.\n16\t *\n17\t * Verified against a live Qwen Code 0.21.5 session and against its shipped\n18\t * sources: `RECORD_TYPES` is exactly `user`/`assistant`/`tool_result`/\n19\t * `system`, assistant lines carry the serving model at the *top level*\n20\t * (`line.model`, not inside `message`), and `message.role` is Google's\n21\t * `\"user\"`/`\"model\"` rather than `\"user\"`/`\"assistant\"`.\n22\t */\n23\timport { readdir, readFile, stat } from \"node:fs/promises\";\n24\timport { homedir } from \"node:os\";\n25\timport { basename, join } from \"node:path\";\n26\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n27\timport { appendEvents } from \"../store.js\";\n28\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n29\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n30\timport { convertParts, isEmptyParts } from \"./genai-parts.js\";\n31\timport {\n32\t  countUnrecognized,\n33\t  mergeCaptureResult,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\timport {\n39\t  activityDraft,\n40\t  contextInjectionDraft,\n41\t  liftText,\n42\t  recordDraft,\n43\t  sessionStateDraft,\n44\t  type RecordContext,\n45\t} from \"./records.js\";\n46\t\n47\tconst RAW_FORMAT = \"qwen-code-jsonl/1\";\n48\t\n49\tconst CURSOR_FIELD = \"lines\";\n50\t\n51\t/**\n52\t * Line types carrying visible conversation content. `tool_result` is its own\n53\t * top-level type here, unlike claude-code where a tool result rides inside a\n54\t * `user` message — hence three convertible types rather than two.\n55\t */\n56\tconst CONVERTIBLE_LINE_TYPES = new Set([\"user\", \"assistant\", \"tool_result\"]);\n57\t\n58\t/**\n59\t * Every top-level record type Qwen Code writes, taken verbatim from its own\n60\t * `RECORD_TYPES` set. A line whose type is outside this set is genuinely new\n61\t * upstream content and routes to the drift path — preserved raw, warned\n62\t * about, upgradeable later by `cledger renormalize`.\n63\t */\n64\tconst RECORD_TYPES = new Set([\"user\", \"assistant\", \"tool_result\", \"system\"]);\n65\t\n66\t/**\n67\t * How a `system` line's `subtype` maps onto a record kind.\n68\t *\n69\t * Qwen Code funnels everything that is not a turn through `system`, so the\n70\t * subtype is the real discriminator; the names below are its own\n71\t * `KNOWN_RECORD_SUBTYPES`. The split follows the same reasoning the\n72\t * claude-code adapter applies to its top-level types: a declaration that\n73\t * holds until restated is `session_state`, material the harness put in front\n74\t * of the model is `context_injection`, and intermediate file state is\n75\t * `file_snapshot`.\n76\t *\n77\t * Anything not listed — including a subtype a future Qwen Code adds — falls\n78\t * through to `activity`, which is the honest default: `system` is a type this\n79\t * adapter knows, so preserving it raw-only and warning about drift would be a\n80\t * false alarm, but claiming to know that an unseen subtype is *state* would\n81\t * be a guess. \"Something happened, here are its fields verbatim\" is true of\n82\t * all of them.\n83\t */\n84\tconst SESSION_STATE_SUBTYPES = new Set([\n85\t  \"custom_title\",\n86\t  \"session_source\",\n87\t  \"parent_session\",\n88\t  \"goal_state\",\n89\t]);\n90\tconst CONTEXT_INJECTION_SUBTYPES = new Set([\n91\t  \"at_command\",\n92\t  \"agent_bootstrap\",\n93\t  \"agent_launch_prompt\",\n94\t]);\n95\tconst FILE_SNAPSHOT_SUBTYPES = new Set([\"attribution_snapshot\", \"file_history_snapshot\"]);\n96\t\n97\t/**\n98\t * Envelope fields every Qwen Code line carries. Dropped from the structured\n99\t * `content` of record events because they are already on the event itself\n100\t * (`occurred_at`, `producer.session_id`, `producer.source_version`) or in\n101\t * `raw.data` — repeating them in `content` would put one fact in three places\n102\t * with three chances to disagree. Mirrors claude-code's `ENVELOPE_KEYS`.\n103\t */\n104\tconst ENVELOPE_KEYS = new Set([\n105\t  \"type\",\n106\t  \"subtype\",\n107\t  \"uuid\",\n108\t  \"parentUuid\",\n109\t  \"sessionId\",\n110\t  \"timestamp\",\n111\t  \"cwd\",\n112\t  \"version\",\n113\t  \"gitBranch\",\n114\t  \"provenance\",\n115\t]);\n116\t\n117\tfunction payloadFields(line: Record<string, unknown>): Record<string, unknown> {\n118\t  const out: Record<string, unknown> = {};\n119\t  for (const [key, value] of Object.entries(line)) {\n120\t    if (!ENVELOPE_KEYS.has(key)) out[key] = value;\n121\t  }\n122\t  return out;\n123\t}\n124\t\n125\t/** Payload Qwen Code's hooks engine sends on stdin (subset we read). */\n126\tinterface QwenHookPayload {\n127\t  session_id?: string;\n128\t  transcript_path?: string;\n129\t  cwd?: string;\n130\t  hook_event_name?: string;\n131\t}\n132\t\n133\t/** One line of a `~/.qwen/projects/<escaped-cwd>/chats/<id>.jsonl` transcript. */\n134\tinterface QwenTranscriptLine {\n135\t  type?: string;\n136\t  /** `system` lines: which kind, e.g. \"ui_telemetry\" / \"parent_session\". */\n137\t  subtype?: string;\n138\t  /** `system` lines: the subtype's own payload. */\n139\t  systemPayload?: Record<string, unknown>;\n140\t  uuid?: string;\n141\t  parentUuid?: string;\n142\t  sessionId?: string;\n143\t  timestamp?: string;\n144\t  provenance?: string;\n145\t  cwd?: string;\n146\t  gitBranch?: string;\n147\t  /** Qwen Code's own CLI version, e.g. \"0.21.5\". */\n148\t  version?: string;\n149\t  /** Serving model, stated top-level on assistant lines only. */\n150\t  model?: string;\n151\t  message?: { role?: string; parts?: unknown };\n152\t  /** Present on `tool_result` lines alongside the functionResponse part. */\n153\t  toolCallResult?: { callId?: string; status?: string; executionStatus?: string };\n154\t}\n155\t\n156\t/** One file's state inside an `attribution_snapshot` payload. */\n157\tinterface QwenFileState {\n158\t  contentHash?: string;\n159\t  aiContribution?: number;\n160\t  aiCreated?: boolean;\n161\t}\n162\t\n163\t/**\n164\t * Where Qwen Code keeps a working directory's chats. The directory name is\n165\t * the absolute cwd with every `/` and `.` replaced by `-`, the same escaping\n166\t * claude-code uses for `~/.claude/projects/`.\n167\t */\n168\texport function qwenProjectChatsDir(cwd: string): string {\n169\t  return join(homedir(), \".qwen\", \"projects\", cwd.replace(/[/.]/g, \"-\"), \"chats\");\n170\t}\n171\t\n172\t/**\n173\t * A deterministic session time for records that carry no timestamp of their\n174\t * own: the first timestamp anywhere in the transcript (stable across\n175\t * rescans), falling back to the file mtime.\n176\t */\n177\tfunction firstTimestamp(lines: string[]): string | null {\n178\t  for (const text of lines) {\n179\t    if (!text.trim()) continue;\n180\t    try {\n181\t      const parsed = JSON.parse(text) as QwenTranscriptLine;\n182\t      if (typeof parsed.timestamp === \"string\" && !Number.isNaN(Date.parse(parsed.timestamp))) {\n183\t        return parsed.timestamp;\n184\t      }\n185\t    } catch {\n186\t      continue;\n187\t    }\n188\t  }\n189\t  return null;\n190\t}\n191\t\n192\tasync function sessionMtime(transcriptPath: string): Promise<string> {\n193\t  try {\n194\t    return (await stat(transcriptPath)).mtime.toISOString();\n195\t  } catch {\n196\t    return new Date().toISOString();\n197\t  }\n198\t}\n199\t\n200\t/**\n201\t * The parent session this transcript belongs to, if any.\n202\t *\n203\t * Qwen Code gives a subagent its own chat file and records the link once, as\n204\t * a `system`/`parent_session` line written right after the sub-session is\n205\t * created. The whole file is scanned rather than just the lines past the\n206\t * cursor: a cursor-resumed capture starts mid-file and would otherwise never\n207\t * see the record, and every event in the file needs the same parent to keep\n208\t * their ids stable across resumes. (The codex adapter re-scans its prefix for\n209\t * the same reason.)\n210\t */\n211\tfunction parentSessionId(lines: string[]): string | undefined {\n212\t  for (const text of lines) {\n213\t    if (!text.trim()) continue;\n214\t    let parsed: QwenTranscriptLine;\n215\t    try {\n216\t      parsed = JSON.parse(text) as QwenTranscriptLine;\n217\t    } catch {\n218\t      continue;\n219\t    }\n220\t    if (parsed.type !== \"system\" || parsed.subtype !== \"parent_session\") continue;\n221\t    const id = parsed.systemPayload?.[\"parentSessionId\"];\n222\t    if (typeof id === \"string\" && id) return id;\n223\t  }\n224\t  return undefined;\n225\t}\n226\t\n227\t/** Which conversation a transcript's lines belong to. */\n228\tfunction conversationFor(sessionId: string, parentId?: string): { id: string; parent?: string } {\n229\t  const id = `qwen-code:${sessionId}`;\n230\t  return parentId ? { id, parent: `qwen-code:${parentId}` } : { id };\n231\t}\n232\t\n233\t/**\n234\t * The agent facts this line states about itself. Qwen Code stamps every line\n235\t * with the CLI `version`, and labels assistant lines with the model that\n236\t * produced them; user and tool_result lines carry no model, and none is\n237\t * invented for them — the same rule the claude-code adapter follows, and for\n238\t * the same reason (the model that will answer a prompt is not knowable from\n239\t * the prompt's own line, and it can change mid-session).\n240\t *\n241\t * The provider is deliberately left unset even though Qwen Code knows it: the\n242\t * value appears as `auth_type` inside `ui_telemetry` payloads, and it names an\n243\t * *auth mode* (\"openai\", \"qwen-oauth\") rather than the inference provider\n244\t * `Producer.provider` asks for. Reading it off a neighbouring line would also\n245\t * break the per-line independence a cursor-resumed capture depends on.\n246\t */\n247\tfunction agentContext(line: QwenTranscriptLine): ProducerAgentContext {\n248\t  const agent: ProducerAgentContext = {};\n249\t  if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n250\t  if (typeof line.model === \"string\" && line.model) agent.model = line.model;\n251\t  return agent;\n252\t}\n253\t\n254\t/**\n255\t * The `RecordContext` a non-turn line converts under. Shared by the capture\n256\t * loop and the re-normalization hook so both mint the same event identity —\n257\t * `conversation` and `occurred_at` are both part of the identity subset, so\n258\t * any divergence would write a second copy instead of deduping.\n259\t */\n260\tfunction recordContext(\n261\t  line: QwenTranscriptLine,\n262\t  occurredAt: string,\n263\t  seq: number,\n264\t  fileSessionId: string,\n265\t  version: string,\n266\t  parentId: string | undefined,\n267\t): RecordContext {\n268\t  const sessionId = line.sessionId ?? fileSessionId;\n269\t  const conversation = conversationFor(sessionId, parentId);\n270\t  return {\n271\t    occurredAt,\n272\t    source: \"qwen-code\",\n273\t    sessionId,\n274\t    seq,\n275\t    version,\n276\t    rawFormat: RAW_FORMAT,\n277\t    conversationId: conversation.id,\n278\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n279\t    agent: agentContext(line),\n280\t  };\n281\t}\n282\t\n283\t/**\n284\t * An `attribution_snapshot` as a `file_snapshot`.\n285\t *\n286\t * Qwen tracks, per file, a content hash and how much of the file it attributes\n287\t * to the model. Unlike Claude Code's file history there is no local cache to\n288\t * resolve — the digest is in the record itself — so nothing goes in\n289\t * `resolved`, and `content` carries the source's own per-file fields beside\n290\t * the path they were keyed by.\n291\t */\n292\tfunction attributionSnapshot(line: QwenTranscriptLine, ctx: RecordContext): EventDraft {\n293\t  const snapshot = (line.systemPayload?.[\"snapshot\"] ?? {}) as Record<string, unknown>;\n294\t  const { fileStates, ...rest } = snapshot;\n295\t  const states = (fileStates ?? {}) as Record<string, QwenFileState>;\n296\t  const files = Object.entries(states).map(([path, state]) => ({ path, ...state }));\n297\t  return recordDraft(\n298\t    ctx,\n299\t    \"file_snapshot\",\n300\t    \"system\",\n301\t    { ...rest, operation: \"snapshot\", files },\n302\t    line,\n303\t  );\n304\t}\n305\t\n306\t/**\n307\t * Convert a line that is not a turn into the record it deserves, or null when\n308\t * the type is outside Qwen's own record set (the caller routes it to drift).\n309\t */\n310\tfunction convertRecordLine(line: QwenTranscriptLine, ctx: RecordContext): EventDraft | null {\n311\t  if (line.type !== \"system\") return null;\n312\t  const subtype = typeof line.subtype === \"string\" ? line.subtype : \"untyped\";\n313\t  const fields = payloadFields(line as unknown as Record<string, unknown>);\n314\t\n315\t  if (FILE_SNAPSHOT_SUBTYPES.has(subtype)) {\n316\t    if (subtype === \"attribution_snapshot\") return attributionSnapshot(line, ctx);\n317\t    // Any other file-history subtype keeps its payload verbatim: same kind,\n318\t    // no invented shape, because its fields have not been seen.\n319\t    return recordDraft(ctx, \"file_snapshot\", \"system\", { ...fields, operation: subtype }, line);\n320\t  }\n321\t  if (SESSION_STATE_SUBTYPES.has(subtype)) {\n322\t    return sessionStateDraft(ctx, subtype, fields, line);\n323\t  }\n324\t  if (CONTEXT_INJECTION_SUBTYPES.has(subtype)) {\n325\t    return contextInjectionDraft(ctx, subtype, fields, line);\n326\t  }\n327\t  // `content` is where a text-bearing system record (a notification, a queued\n328\t  // mid-turn message) puts its prose; lifting it gives `blocks` for free and\n329\t  // is a no-op when there is none.\n330\t  return activityDraft(ctx, `system/${subtype}`, liftText(fields, \"content\"), line);\n331\t}\n332\t\n333\tfunction convertLine(\n334\t  line: QwenTranscriptLine,\n335\t  seq: number,\n336\t  version: string,\n337\t  identity: GitUserIdentity,\n338\t  fileSessionId: string,\n339\t  parentId: string | undefined,\n340\t): EventDraft | null {\n341\t  const type = line.type;\n342\t  if (typeof type !== \"string\" || !CONVERTIBLE_LINE_TYPES.has(type)) return null;\n343\t  if (!line.message) return null;\n344\t  if (typeof line.timestamp !== \"string\") return null;\n345\t  if (isEmptyParts(line.message.parts)) return null;\n346\t  const sessionId = line.sessionId ?? fileSessionId;\n347\t\n348\t  // `tool_result` lines are stored with `message.role: \"user\"` because that is\n349\t  // how the GenAI API frames a function response, but the human did not say\n350\t  // them. They get the `system` actor every other adapter gives a standalone\n351\t  // tool result, rather than being attributed to the person at the keyboard.\n352\t  const actor: Actor =\n353\t    type === \"user\"\n354\t      ? { type: \"human\" }\n355\t      : type === \"assistant\"\n356\t        ? { type: \"agent\" }\n357\t        : { typ