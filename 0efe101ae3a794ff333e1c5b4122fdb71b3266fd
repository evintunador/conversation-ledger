ontext_injection\",\n165\t    \"system\",\n166\t    { ...injection, injection_type: injectionType },\n167\t    raw,\n168\t  );\n169\t}\n170\t\n171\t/** One file version a snapshot record points at. */\n172\texport interface SnapshotFile {\n173\t  /** Path as the source states it — relative to the project for snapshots,\n174\t   *  absolute for deltas. Left exactly as stated rather than normalized. */\n175\t  path: string;\n176\t  /** Directory the file really lived in, when the source states it. */\n177\t  dir?: string;\n178\t  /** Source's own version counter for this file within the session. */\n179\t  version?: number;\n180\t  /** When the source took the backup, ISO 8601. */\n181\t  backup_time?: string;\n182\t  /**\n183\t   * Name of the backup file in the source's local cache. A pointer, not\n184\t   * content: the cache is machine-local and prunable, so this is stored for\n185\t   * traceability while `resolved` carries what the ledger could actually read\n186\t   * from it. Null when the source recorded no backup (a tracked file it had\n187\t   * not yet copied).\n188\t   */\n189\t  backup_file?: string | null;\n190\t}\n191\t\n192\t/** What the ledger read from a backup file, keyed by the pointer that named it. */\n193\texport interface ResolvedFile {\n194\t  backup_file: string;\n195\t  sha256: string;\n196\t  bytes: number;\n197\t}\n198\t\n199\t/**\n200\t * Intermediate file state: the versions a file passed through between\n201\t * commits.\n202\t *\n203\t * `operation` distinguishes the source's two shapes — a full statement of\n204\t * every tracked file (`snapshot`) from a single file's change (`delta`) —\n205\t * because a consumer reconstructing file history needs to know whether an\n206\t * absent file means \"unchanged\" or \"no longer tracked\".\n207\t *\n208\t * `resolved` is passed separately from `content` and stays out of event\n209\t * identity on purpose (see EvidenceEvent.resolved): the digests come from a\n210\t * cache that may be gone by the next rescan, and an id that moved when the\n211\t * cache was pruned would duplicate every snapshot in the ledger.\n212\t */\n213\texport function fileSnapshotDraft(\n214\t  ctx: RecordContext,\n215\t  operation: \"snapshot\" | \"delta\",\n216\t  detail: { message_id?: string; snapshot_message_id?: string; is_update?: boolean },\n217\t  files: SnapshotFile[],\n218\t  raw: unknown,\n219\t  resolvedFiles: ResolvedFile[],\n220\t): EventDraft {\n221\t  const draft = recordDraft(\n222\t    ctx,\n223\t    \"file_snapshot\",\n224\t    \"system\",\n225\t    { ...detail, operation, files },\n226\t    raw,\n227\t  );\n228\t  if (resolvedFiles.length > 0) draft.resolved = { files: resolvedFiles };\n229\t  return draft;\n230\t}\n231\t","tool_use_id":"toolu_019ivKmpcs4jNwg45feBpvK5","type":"tool_result"}],"role":"user"},"parentUuid":"71951ff8-7616-447c-8e13-814b6116562d","promptId":"0b289d23-aef8-4960-9f8f-a9de05143661","sessionId":"d10310cd-8144-4046-87b9-97bbb6ace18c","sessionKind":"bg","session_id":"8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","sourceToolAssistantUUID":"71951ff8-7616-447c-8e13-814b6116562d","timestamp":"2026-08-06T04:40:50.157Z","toolUseResult":{"file":{"content":"/**\n * Draft builders for the non-conversational record: the state a session\n * declares about itself, the things that happen in the harness around the\n * turns, the material the harness injects into the model's context, and the\n * intermediate file versions a session leaves behind.\n *\n * These are the counterpart to adapters/drift.ts. Drift handles line types an\n * adapter does *not* know: preserve raw, warn, hope a later version can read\n * them. Everything here is a type the adapter *does* know and has chosen to\n * record with structure. Keeping them apart matters for the drift warning to\n * stay meaningful — a warning that fires on every ordinary `mode` line stops\n * being a signal that the upstream format moved.\n *\n * Every builder produces content in the same two-part shape: a `*_type`\n * discriminator naming the source's own type verbatim, and the source's own\n * fields beside it. Adapters do not rename or reinterpret those fields; a\n * consumer that wants Claude Code's `permissionMode` reads `permissionMode`.\n * What the ledger adds is the kind, the ordering, and the provenance.\n *\n * `blocks` appears whenever a record carries human-readable text, using the\n * same `[{type: \"text\", text}]` shape `conversation_turn` uses. That is the\n * one concession to uniformity: a consumer extracting text across a ledger\n * should not need a per-kind special case to find it.\n */\n\nimport type { EventDraft, ProducerAgentContext } from \"../schema.js\";\n\n/** What every record shares: where it came from and where it sits. */\nexport interface RecordContext {\n  occurredAt: string;\n  /** Source system, e.g. \"claude-code\". */\n  source: string;\n  sessionId: string;\n  /** Position in the source material — line index, part index. */\n  seq: number;\n  /** cledger's own version. */\n  version: string;\n  rawFormat: string;\n  conversationId: string;\n  /** Parent conversation id, for sub-conversations (see ConversationRef). */\n  parentConversationId?: string;\n  agent?: ProducerAgentContext;\n}\n\n/**\n * The shared skeleton every record shares: provenance, conversation position,\n * and the verbatim source line under `raw`. Exported because a few source\n * types map onto an existing kind rather than a new one — Claude Code's\n * `system` lines that print into the conversation are `conversation_turn`s —\n * and those still want this exact envelope.\n */\nexport function recordDraft(\n  ctx: RecordContext,\n  kind: string,\n  actorType: string,\n  content: unknown,\n  raw: unknown,\n): EventDraft {\n  return {\n    kind,\n    occurred_at: ctx.occurredAt,\n    actor: { type: actorType },\n    producer: {\n      tool: \"cledger\",\n      version: ctx.version,\n      source: ctx.source,\n      session_id: ctx.sessionId,\n      ...ctx.agent,\n    },\n    conversation: {\n      id: ctx.conversationId,\n      seq: ctx.seq,\n      ...(ctx.parentConversationId ? { parent: ctx.parentConversationId } : {}),\n    },\n    content,\n    raw: { format: ctx.rawFormat, data: raw },\n  };\n}\n\n/**\n * Text blocks for a record, or nothing when there is no text to carry.\n * Empty and whitespace-only strings are dropped rather than stored as an\n * empty block — a block that renders as nothing is worse than no block,\n * because a consumer cannot tell it apart from real empty output.\n */\nexport function textBlocks(...texts: unknown[]): { blocks: unknown[] } | Record<string, never> {\n  const blocks = texts\n    .filter((t): t is string => typeof t === \"string\" && t.trim() !== \"\")\n    .map((text) => ({ type: \"text\", text }));\n  return blocks.length > 0 ? { blocks } : {};\n}\n\n/**\n * Move a source field's text into `blocks`, returning the remaining fields.\n * Lifting rather than copying: a queued prompt or a command's stdout can run\n * to kilobytes, and storing it under both its source field name and `blocks`\n * would double that for no gain — `raw.data` already holds the original\n * under its original name.\n */\nexport function liftText(\n  fields: Record<string, unknown>,\n  key: string,\n): Record<string, unknown> {\n  const value = fields[key];\n  if (typeof value !== \"string\" || value.trim() === \"\") return fields;\n  const { [key]: _lifted, ...rest } = fields;\n  return { ...rest, ...textBlocks(value) };\n}\n\n/**\n * A declaration the session makes about itself, holding until restated.\n *\n * The actor is `system`: a mode change is the harness recording its own\n * configuration, not the user speaking, even when the user is what caused it.\n * Sources restate this constantly and each restatement is kept — `seq` makes\n * them distinct events, so \"the mode was still `auto` here\" survives as a\n * fact rather than collapsing into the first statement.\n */\nexport function sessionStateDraft(\n  ctx: RecordContext,\n  stateType: string,\n  state: Record<string, unknown>,\n  raw: unknown,\n): EventDraft {\n  // Discriminator last: a source field that happened to be named\n  // `state_type` must not be able to overwrite the label the ledger set.\n  return recordDraft(ctx, \"session_state\", \"system\", { ...state, state_type: stateType }, raw);\n}\n\n/**\n * Something that happened in the harness and is not a turn.\n *\n * The actor is `system` for harness bookkeeping and `agent` for things the\n * model drove (a task it started, a step it finished); callers pass whichever\n * the source supports, defaulting to `system` because most of this is the\n * harness talking about itself.\n */\nexport function activityDraft(\n  ctx: RecordContext,\n  activityType: string,\n  detail: Record<string, unknown>,\n  raw: unknown,\n  actorType = \"system\",\n): EventDraft {\n  return recordDraft(ctx, \"activity\", actorType, { ...detail, activity_type: activityType }, raw);\n}\n\n/**\n * Material the harness put into the model's context that nobody typed.\n *\n * The actor is `system` for the same reason `activity`'s is: the harness is\n * the one that spoke. What separates this from `activity` is that the model\n * read it — a consumer reconstructing what the model knew at a point in the\n * conversation needs these, and does not need turn durations.\n */\nexport function contextInjectionDraft(\n  ctx: RecordContext,\n  injectionType: string,\n  injection: Record<string, unknown>,\n  raw: unknown,\n): EventDraft {\n  return recordDraft(\n    ctx,\n    \"context_injection\",\n    \"system\",\n    { ...injection, injection_type: injectionType },\n    raw,\n  );\n}\n\n/** One file version a snapshot record points at. */\nexport interface SnapshotFile {\n  /** Path as the source states it — relative to the project for snapshots,\n   *  absolute for deltas. Left exactly as stated rather than normalized. */\n  path: string;\n  /** Directory the file really lived in, when the source states it. */\n  dir?: string;\n  /** Source's own version counter for this file within the session. */\n  version?: number;\n  /** When the source took the backup, ISO 8601. */\n  backup_time?: string;\n  /**\n   * Name of the backup file in the source's local cache. A pointer, not\n   * content: the cache is machine-local and prunable, so this is stored for\n   * traceability while `resolved` carries what the ledger could actually read\n   * from it. Null when the source recorded no backup (a tracked file it had\n   * not yet copied).\n   */\n  backup_file?: string | null;\n}\n\n/** What the ledger read from a backup file, keyed by the pointer that named it. */\nexport interface ResolvedFile {\n  backup_file: string;\n  sha256: string;\n  bytes: number;\n}\n\n/**\n * Intermediate file state: the versions a file passed through between\n * commits.\n *\n * `operation` distinguishes the source's two shapes — a full statement of\n * every tracked file (`snapshot`) from a single file's change (`delta`) —\n * because a consumer reconstructing file history needs to know whether an\n * absent file means \"unchanged\" or \"no longer tracked\".\n *\n * `resolved` is passed separately from `content` and stays out of event\n * identity on purpose (see EvidenceEvent.resolved): the digests come from a\n * cache that may be gone by the next rescan, and an id that moved when the\n * cache was pruned would duplicate every snapshot in the ledger.\n */\nexport function fileSnapshotDraft(\n  ctx: RecordContext,\n  operation: \"snapshot\" | \"delta\",\n  detail: { message_id?: string; snapshot_message_id?: string; is_update?: boolean },\n  files: SnapshotFile[],\n  raw: unknown,\n  resolvedFiles: ResolvedFile[],\n): EventDraft {\n  const draft = recordDraft(\n    ctx,\n    \"file_snapshot\",\n    \"system\",\n    { ...detail, operation, files },\n    raw,\n  );\n  if (resolvedFiles.length > 0) draft.resolved = { files: resolvedFiles };\n  return draft;\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/records.ts","numLines":231,"startLine":1,"totalLines":231},"type":"text"},"type":"user","userType":"external","uuid":"fa2bb3d2-c780-45fa-b334-759e374a68e4","version":"2.1.223"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-06T04:47:43.205Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Gemini CLI adapter.\n3\t *\n4\t * Gemini CLI records a session to\n5\t * `~/.gemini/tmp/<project>/chats/session-<ts>-<id>.jsonl`, and the hook\n6\t * payload hands us that path directly. The file is append-only on disk but it\n7\t * is *not* a transcript: it is a write-ahead log of mutations to a single\n8\t * conversation document, and a line's meaning depends on every line before\n9\t * it. Four record forms exist, discriminated exactly as Gemini CLI's own\n10\t * `loadConversationRecord` discriminates them, and in this precedence order:\n11\t *\n12\t *  1. `{\"$rewindTo\": \"<message id>\"}` — the user rewound; that message and\n13\t *     every message after it leave the document. An unknown id clears it.\n14\t *  2. a bare message object (identified by a string `id`) — upsert by id.\n15\t *     Re-appending an existing id *replaces* it, which is how a model turn\n16\t *     grows its `toolCalls` as tools run.\n17\t *  3. `{\"$set\": {...}}` — metadata patch. When it carries a `messages` array\n18\t *     it replaces the entire message list.\n19\t *  4. the header (`sessionId` + `projectHash`), which may itself carry a\n20\t *     `messages` array.\n21\t *\n22\t * Three consequences drive this adapter's design.\n23\t *\n24\t * **Deletions are not honoured.** Replaying the log the way Gemini CLI does —\n25\t * applying every removal — reconstructs what the CLI would *resume*, which is\n26\t * not the same thing as what happened. Verified on a real session: after a\n27\t * failed API call Gemini rewrote the document with a `$set.messages` snapshot\n28\t * that silently dropped the prompt the user had just typed, so a faithful\n29\t * replay captures no record of it having been asked. The ledger records\n30\t * evidence, and the human did type it. So capture takes the *union* of every\n31\t * message the file ever contained, each at its last-written value, and treats\n32\t * `$rewindTo` and snapshot truncation as facts about Gemini's live view\n33\t * rather than instructions to forget. The removal itself is recorded too, as\n34\t * an `activity` — a rewind is something that happened, and a consumer\n35\t * reconstructing intent needs to know a turn was withdrawn, not just that it\n36\t * exists.\n37\t *\n38\t * **Ordering key.** `seq` is the index of the log record a thing was first\n39\t * seen at, counted in file order across messages *and* the mutation records\n40\t * between them, so both share one number space and neither can collide with\n41\t * the other. A message keeps the number it was first sighted under, so a\n42\t * rewind cannot renumber later turns — the positional-`seq` churn the\n43\t * opencode adapter documents and accepts does not arise here.\n44\t *\n45\t * **Settledness.** Because re-appending an id replaces the message, a model\n46\t * turn is mutable while its tools run: capturing it early would freeze a\n47\t * half-finished tool call into an immutable event id. A message whose\n48\t * `toolCalls` contain one that has neither a result nor a terminal status is\n49\t * therefore withheld, and holds the cursor back so the finished version is\n50\t * picked up next time.\n51\t */\n52\timport { readdir, readFile, stat } from \"node:fs/promises\";\n53\timport { homedir } from \"node:os\";\n54\timport { basename, join } from \"node:path\";\n55\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n56\timport { appendEvents } from \"../store.js\";\n57\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n58\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n59\timport { convertParts, ensurePartArray, isEmptyParts } from \"./genai-parts.js\";\n60\timport {\n61\t  countUnrecognized,\n62\t  mergeCaptureResult,\n63\t  unrecognizedDraft,\n64\t  warnUnrecognized,\n65\t  type CaptureResult,\n66\t} from \"./drift.js\";\n67\timport {\n68\t  activityDraft,\n69\t  liftText,\n70\t  recordDraft,\n71\t  sessionStateDraft,\n72\t  type RecordContext,\n73\t} from \"./records.js\";\n74\t\n75\tconst RAW_FORMAT = \"gemini-cli-chatlog/1\";\n76\t\n77\tconst CURSOR_FIELD = \"messages\";\n78\t\n79\t/** Message types carrying a turn someone took. */\n80\tconst CONVERTIBLE_MESSAGE_TYPES = new Set([\"user\", \"gemini\"]);\n81\t\n82\t/**\n83\t * Message types Gemini writes for transient UI notices. They are recorded as\n84\t * `conversation_turn`s spoken by `system` when they carry text, on the same\n85\t * reasoning the claude-code adapter applies to its text-bearing `system`\n86\t * lines: the user read them, so they are part of the conversation even though\n87\t * no participant composed them. A notice with no text becomes an `activity`.\n88\t *\n89\t * Gemini's own history assembly discards these outright. That is right for\n90\t * resuming a chat and wrong for a ledger — \"quota exceeded\" is often the only\n91\t * explanation for why a turn looks abandoned.\n92\t */\n93\tconst NOTICE_MESSAGE_TYPES = new Set([\"info\", \"error\", \"warning\"]);\n94\t\n95\t/**\n96\t * Tool-call states that will never change again. A call with a `result` is\n97\t * settled whatever its status says; one with neither is still running.\n98\t */\n99\tconst SETTLED_TOOL_STATUSES = new Set([\"success\", \"error\", \"cancelled\", \"canceled\"]);\n100\t\n101\t/**\n102\t * Metadata keys that carry the message list rather than a session fact. They\n103\t * are consumed by the replay itself and would be an enormous, duplicated\n104\t * `session_state` payload if they were also recorded as one.\n105\t */\n106\tconst MESSAGE_BEARING_KEYS = new Set([\"messages\"]);\n107\t\n108\t/**\n109\t * Prefixes Gemini CLI uses to inject harness-generated text as a `user`\n110\t * message: the session preamble it builds at startup, and the text a hook\n111\t * contributes. They are recorded as user turns because that is the API role\n112\t * they occupy, but the person at the keyboard did not write them, so they are\n113\t * attributed to `system` rather than carrying the git identity. Slash commands\n114\t * (`/help`) — which Gemini also filters out of its own resume history — *are*\n115\t * attributed to the human, because the human typed them.\n116\t */\n117\tconst HARNESS_USER_PREFIXES = [\"<session_context>\", \"<hook_context>\"];\n118\t\n119\t/** Payload Gemini CLI's hooks engine sends on stdin (subset we read). */\n120\tinterface GeminiHookPayload {\n121\t  session_id?: string;\n122\t  transcript_path?: string;\n123\t  cwd?: string;\n124\t  hook_event_name?: string;\n125\t}\n126\t\n127\tinterface GeminiThought {\n128\t  subject?: string;\n129\t  description?: string;\n130\t  timestamp?: string;\n131\t}\n132\t\n133\tinterface GeminiToolCall {\n134\t  id?: string;\n135\t  name?: string;\n136\t  args?: unknown;\n137\t  result?: unknown;\n138\t  status?: string;\n139\t  displayName?: string;\n140\t  description?: string;\n141\t}\n142\t\n143\t/** One message inside the conversation document. */\n144\tinterface GeminiMessage {\n145\t  id?: string;\n146\t  timestamp?: string;\n147\t  type?: string;\n148\t  /** `PartListUnion`: a string, one Part, or a Part array. */\n149\t  content?: unknown;\n150\t  displayContent?: unknown;\n151\t  thoughts?: GeminiThought[];\n152\t  toolCalls?: GeminiToolCall[];\n153\t  tokens?: unknown;\n154\t  model?: string;\n155\t}\n156\t\n157\t/** Session-level metadata accumulated from header and `$set` records. */\n158\tinterface GeminiSessionMetadata {\n159\t  sessionId?: string;\n160\t  projectHash?: string;\n161\t  startTime?: string;\n162\t  lastUpdated?: string;\n163\t  kind?: string;\n164\t}\n165\t\n166\t/** A replayed message plus the ordering key assigned at first sighting. */\n167\tinterface OrderedMessage {\n168\t  message: GeminiMessage;\n169\t  seq: number;\n170\t}\n171\t\n172\t/**\n173\t * A log record that is not a message: a metadata patch or a rewind. Recorded\n174\t * in its own right rather than only being applied, so the ledger keeps the\n175\t * session's declarations and the fact that a rewind happened.\n176\t */\n177\tinterface OrderedMutation {\n178\t  seq: number;\n179\t  /** \"metadata\" for a `$set`/header patch, \"rewind\" for a `$rewindTo`. */\n180\t  kind: \"metadata\" | \"rewind\";\n181\t  fields: Record<string, unknown>;\n182\t  raw: unknown;\n183\t}\n184\t\n185\texport interface GeminiSession {\n186\t  metadata: GeminiSessionMetadata;\n187\t  /** Every message the file ever held, at its last-written value, in first-sighting order. */\n188\t  messages: OrderedMessage[];\n189\t  /** Metadata patches and rewinds, in file order. */\n190\t  mutations: OrderedMutation[];\n191\t  /**\n192\t   * Ids Gemini CLI removed from its own live document — via `$rewindTo` or by\n193\t   * omitting them from a `$set.messages` snapshot. Captured anyway (see the\n194\t   * module comment); a withheld message that has been removed can never be\n195\t   * rewritten, so this is also what stops one holding the cursor forever.\n196\t   */\n197\t  rewound: Set<string>;\n198\t}\n199\t\n200\tfunction isRecord(value: unknown): value is Record<string, unknown> {\n201\t  return typeof value === \"object\" && value !== null;\n202\t}\n203\t\n204\tfunction isStringProp(value: unknown, prop: string): boolean {\n205\t  return isRecord(value) && typeof value[prop] === \"string\";\n206\t}\n207\t\n208\t/**\n209\t * Replay the write-ahead log.\n210\t *\n211\t * Record discrimination and precedence mirror Gemini CLI's own\n212\t * `loadConversationRecord` exactly — including its \"an unresolvable rewind\n213\t * target drops everything\" fallback — so that `live` tracks what the CLI\n214\t * itself would resume. The divergence is what gets *returned*: removals are\n215\t * recorded rather than applied to the captured set.\n216\t */\n217\texport function replaySession(text: string): GeminiSession {\n218\t  const metadata: GeminiSessionMetadata = {};\n219\t  /** Union: every message ever written, at its last-written value. */\n220\t  const seen = new Map<string, GeminiMessage>();\n221\t  /** What Gemini CLI itself would consider the current document. */\n222\t  let live = new Set<string>();\n223\t  const firstSeen = new Map<string, number>();\n224\t  const mutations: OrderedMutation[] = [];\n225\t  let nextSeq = 0;\n226\t\n227\t  const upsert = (candidate: unknown): void => {\n228\t    if (!isStringProp(candidate, \"id\")) return;\n229\t    const message = candidate as GeminiMessage;\n230\t    const id = message.id!;\n231\t    if (!firstSeen.has(id)) firstSeen.set(id, nextSeq++);\n232\t    seen.set(id, message);\n233\t    live.add(id);\n234\t  };\n235\t\n236\t  for (const line of text.split(\"\\n\")) {\n237\t    if (!line.trim()) continue;\n238\t    let record: unknown;\n239\t    try {\n240\t      record = JSON.parse(line);\n241\t    } catch {\n242\t      continue; // partial line — normal at the tail of a live session\n243\t    }\n244\t    if (!isRecord(record)) continue;\n245\t\n246\t    if (isStringProp(record, \"$rewindTo\")) {\n247\t      const target = record[\"$rewindTo\"] as string;\n248\t      const ids = [...live];\n249\t      const at = ids.indexOf(target);\n250\t      // An unresolvable target drops the whole document, matching the CLI.\n251\t      const removed = at === -1 ? ids : ids.slice(at);\n252\t      live = at === -1 ? new Set() : new Set(ids.slice(0, at));\n253\t      mutations.push({\n254\t        seq: nextSeq++,\n255\t        kind: \"rewind\",\n256\t        fields: { rewind_to: target, removed_messages: removed, resolved: at !== -1 },\n257\t        raw: record,\n258\t      });\n259\t      continue;\n260\t    }\n261\t\n262\t    if (isStringProp(record, \"id\")) {\n263\t      upsert(record);\n264\t      continue;\n265\t    }\n266\t\n267\t    if (isRecord(record[\"$set\"])) {\n268\t      const set = record[\"$set\"] as Record<string, unknown>;\n269\t      if (Array.isArray(set[\"messages\"])) {\n270\t        // A snapshot replaces the live document wholesale; anything it omits\n271\t        // is dropped from the CLI's view but kept in `seen`.\n272\t        live = new Set();\n273\t        for (const message of set[\"messages\"]) upsert(message);\n274\t      }\n275\t      Object.assign(metadata, set);\n276\t      const fields = patchFields(set);\n277\t      if (Object.keys(fields).length > 0) {\n278\t        mutations.push({ seq: nextSeq++, kind: \"metadata\", fields, raw: record });\n279\t      }\n280\t      continue;\n281\t    }\n282\t\n283\t    if (isStringProp(record, \"sessionId\") && isStringProp(record, \"projectHash\")) {\n284\t      Object.assign(metadata, record);\n285\t      if (Array.isArray(record[\"messages\"])) {\n286\t        for (const message of record[\"messages\"]) upsert(message);\n287\t      }\n288\t      const fields = patchFields(record);\n289\t      if (Object.keys(fields).length > 0) {\n290\t        mutations.push({ seq: nextSeq++, kind: \"metadata\", fields, raw: record });\n291\t      }\n292\t    }\n293\t  }\n294\t\n295\t  const messages = [...seen.entries()]\n296\t    .map(([id, message]) => ({ message, seq: firstSeen.get(id) ?? 0 }))\n297\t    // Sorting by first sighting makes the emitted order a pure function of the\n298\t    // file rather than of Map insertion history, which a snapshot reshuffles.\n299\t    .sort((a, b) => a.seq - b.seq);\n300\t  const rewound = new Set([...seen.keys()].filter((id) => !live.has(id)));\n301\t  return { metadata, messages, mutations, rewound };\n302\t}\n303\t\n304\t/** A metadata record's own fields, minus the message list it may carry. */\n305\tfunction patchFields(record: Record<string, unknown>): Record<string, unknown> {\n306\t  const out: Record<string, unknown> = {};\n307\t  for (const [key, value] of Object.entries(record)) {\n308\t    if (!MESSAGE_BEARING_KEYS.has(key)) out[key] = value;\n309\t  }\n310\t  return out;\n311\t}\n312\t\n313\t/** Whether every tool call on a message has reached a state that cannot change. */\n314\tfunction isSettled(message: GeminiMessage): boolean {\n315\t  for (const call of message.toolCalls ?? []) {\n316\t    if (call.result !== undefined) continue;\n317\t    if (typeof call.status === \"string\" && SETTLED_TOOL_STATUSES.has(call.status)) continue;\n318\t    return false;\n319\t  }\n320\t  return true;\n321\t}\n322\t\n323\t/**\n324\t * The agent facts a message states about itself. Gemini CLI labels model turns\n325\t * with the serving model and states no provider anywhere in the file (the same\n326\t * CLI reaches AI Studio, Vertex, or a Code Assist tier depending on how the\n327\t * user authenticated), so `provider` is left unset rather than assumed.\n328\t *\n329\t * `source_version` is not recorded per message either — unlike claude-code and\n330\t * qwen-code, Gemini CLI stamps no CLI version into its session file — so it is\n331\t * supplied by the caller when one is known, and otherwise omitted. Guessing it\n332\t * from the installed binary would be wrong for a backfill of an old session.\n333\t */\n334\tfunction agentContext(message: GeminiMessage, sourceVersion?: string): ProducerAgentContext {\n335\t  const agent: ProducerAgentContext = {};\n336\t  if (sourceVersion) agent.source_version = sourceVersion;\n337\t  if (typeof message.model === \"string\" && message.model) agent.model = message.model;\n338\t  return agent;\n339\t}\n340\t\n341\tfunction partListText(content: unknown): string {\n342\t  return ensurePartArray(content)\n343\t    .map((part) => (typeof part.text === \"string\" ? part.text : \"\"))\n344\t    .join(\"\");\n345\t}\n346\t\n347\tfunction isHarnessAuthored(content: unknown): boolean {\n348\t  const text = partListText(content).trim();\n349\t  return HARNESS_USER_PREFIXES.some((prefix) => text.startsWith(prefix));\n350\t}\n351\t\n352\t/**\n353\t * Which conversation a session's messages belong to. Gemini gives a subagent\n354\t * its own session file under `<chats>/<parent session id>/`, so the directory\n355\t * name is the parent link — the file itself never states one.\n356\t */\n357\tfunction conversationFor(sessionId: string, parentId?: string): { id: string; parent?: string } {\n358\t  const id = `gemini-cli:${sessionId}`;\n359\t  return parentId ? { id, parent: `gemini-cli:${parentId}` } : { id };\n360\t}\n361\t\n362\t/** Blocks for a `gemini` message, mirroring the CLI's own history assembly. */\n363\tfunction modelBlocks(message: GeminiMessage): unknown[] {\n364\t  const parts = ensurePartArray(message.content);\n365\t  const callsInContent = parts.some((part) => part.functionCall !== undefined);\n366\t  const thoughtsInContent = parts.some((part) => part.thought === true);\n367\t\n368\t  const blocks: unknown[] = [];\n369\t  // When the content parts already carry the calls or the reasoning, Gemini CLI\n370\t  // uses them alone and ignores the sibling `thoughts`/`toolCalls` fields —\n371\t  // they are the same facts recorded twice. Mirroring that precedence is what\n372\t  // keeps a turn from emitting each tool call as two blocks.\n373\t  if (callsInContent || thoughtsInContent) {\n374\t    blocks.push(...convertParts(message.content));\n375\t  } else {\n376\t    for (const thought of message.thoughts ?? []) {\n377\t      const text = thought.description ?? thought.subject;\n378\t      if (typeof text !== \"string\" || !text.trim()) continue;\n379\t      const block: Record<string, unknown> = { type: \"thinking\", text };\n380\t      if (typeof thought.subject === \"string\" && thought.subject) block[\"subject\"] = thought.subject;\n381\t      blocks.push(block);\n382\t    }\n383\t    blocks.push(...convertParts(message.content));\n384\t    for (const call of message.toolCalls ?? []) {\n385\t      const block: Record<string, unknown> = { type: \"tool_use\" };\n386\t      if (typeof call.id === \"string\") block[\"id\"] = call.id;\n387\t      if (typeof call.name === \"string\") block[\"name\"] = call.name;\n388\t      if (call.args !== undefined) block[\"input\"] = call.args;\n389\t      blocks.push(block);\n390\t    }\n391\t  }\n392\t\n393\t  // Results are appended either way: the content parts hold the *call*, never\n394\t  // its outcome — Gemini CLI emits those as a separate synthetic message.\n395\t  for (const call of message.toolCalls ?? []) {\n396\t    if (call.result === undefined) continue;\n397\t    const block: Record<string, unknown> = { type: \"tool_result\" };\n398\t    if (typeof call.id === \"string\") block[\"tool_use_id\"] = call.id;\n399\t    if (typeof call.name === \"string\") block[\"name\"] = call.name;\n400\t    block[\"content\"] = call.result;\n401\t    if (call.status === \"error\") block[\"is_error\"] = true;\n402\t    blocks.push(block);\n403\t  }\n404\t  return blocks;\n405\t}\n406\t\n407\t/** The `RecordContext` a message or mutation converts under. */\n408\tfunction recordContext(\n409\t  occurredAt: string,\n410\t  seq: number,\n411\t  sessionId: string,\n412\t  version: string,\n413\t  parentId: string | undefined,\n414\t  agent: ProducerAgentContext,\n415\t): RecordContext {\n416\t  const conversation = conversationFor(sessionId, parentId);\n417\t  return {\n418\t    occurredAt,\n419\t    source: \"gemini-cli\",\n420\t    sessionId,\n421\t    seq,\n422\t    version,\n423\t    rawFormat: RAW_FORMAT,\n424\t    conversationId: conversation.id,\n425\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n426\t    agent,\n427\t  };\n428\t}\n429\t\n430\tfunction convertMessage(\n431\t  message: GeminiMessage,\n432\t  seq: number,\n433\t  sessionId: string,\n434\t  baseTime: string,\n435\t  version: string,\n436\t  identity: GitUserIdentity,\n437\t  sourceVersion: string | undefined,\n438\t  parentId: string | undefined,\n439\t): EventDraft | null {\n440\t  const type = message.type;\n441\t  if (typeof type !== \"string\") return null;\n442\t\n443\t  const agent = agentContext(message, sourceVersion);\n444\t  const occurredAt = typeof message.timestamp === \"string\" ? message.timestamp : baseTime;\n445\t  const ctx = recordContext(occurredAt, seq, sessionId, version, parentId, agent);\n446\t\n447\t  if (NOTICE_MESSAGE_TYPES.has(type)) {\n448\t    const text = partListText(message.content).trim();\n449\t    if (text) {\n450\t      return recordDraft(\n451\t        ctx,\n452\t        \"conversation_turn\",\n453\t        \"system\",\n454\t        { role: \"system\", notice_type: type, blocks: [{ type: \"text\", text }] },\n455\t        message,\n456\t      );\n457\t    }\n458\t    const { content: _content, ...fields } = message as Record<string, unknown>;\n459\t    return activityDraft(ctx, `notice/${type}`, fields, message);\n460\t  }\n461\t\n462\t  if (!CONVERTIBLE_MESSAGE_TYPES.has(type)) return null;\n463\t\n464\t  let blocks: unknown[];\n465\t  let actor: Actor;\n466\t  if (type === \"user\") {\n467\t    if (isEmptyParts(message.content)) return null;\n468\t    blocks = convertParts(message.content);\n469\t    if (isHarnessAuthored(message.content)) {\n470\t      actor = { type: \"system\" };\n471\t    } else {\n472\t      actor = { type: \"human\" };\n473\t      if (identity.email) actor.id = identity.email;\n474\t      if (identity.name) actor.display = identity.name;\n475\t    }\n476\t  } else {\n477\t    blocks = modelBlocks(message);\n478\t    if (blocks.length === 0) return null;\n479\t    actor = { type: \"agent\" };\n480\t    if (agent.model) actor.id = agent.model;\n481\t  }\n482\t\n483\t  const conversation = conversationFor(sessionId, parentId);\n484\t  return {\n485\t    kind: \"conversation_turn\",\n486\t    occurred_at: occurredAt,\n487\t    actor,\n488\t    producer: {\n489\t      tool: \"cledger\",\n490\t      version,\n491\t      source: \"gemini-cli\",\n492\t      session_id: sessionId,\n493\t      ...agent,\n494\t    },\n495\t    conversation: {\n496\t      id: conversation.id,\n497\t      seq,\n498\t      ...(conversation.parent ? { parent: conversation.parent } : {}),\n499\t    },\n500\t    content: { role: type === \"user\" ? \"user\" : \"model\", blocks },\n501\t    raw: { format: RAW_FORMAT, data: message },\n502\t  };\n503\t}\n504\t\n505\t/**\n506\t * A metadata patch or a rewind, as its own event.\n507\t *\n508\t * A `$set` is a declaration about the session that holds until restated —\n509\t * `session_state`, exactly like claude-code's `mode` and `summary` lines,\n510\t * restatements included. A `$rewindTo` is something that happened, so it is\n511\t * `activity`; it is the one record that makes the withdrawn turns above it\n512\t * legible as withdrawn rather than merely present.\n513\t */\n514\tfunction convertMutation(mutation: OrderedMutation, ctx: RecordContext): EventDraft {\n515\t  if (mutation.kind === \"rewind\") {\n516\t    return activityDraft(ctx, \"rewind\", mutation.fields, mutation.raw);\n517\t  }\n518\t  return sessionStateDraft(ctx, \"metadata\", liftText(mutation.fields, \"summary\"), mutation.raw);\n519\t}\n520\t\n521\t/** Raw-only preservation event for an unrecognized gemini-cli message. */\n522\tfunction preserve(\n523\t  typeKey: string,\n524\t  message: GeminiMessage,\n525\t  occurredAt: string,\n526\t  seq: number,\n527\t  sessionId: string,\n528\t  version: string,\n529\t  sourceVersion: string | undefined,\n530\t  parentId: string | undefined,\n531\t): EventDraft {\n532\t  const conversation = conversationFor(sessionId, parentId);\n533\t  return unrecognizedDraft({\n534\t    typeKey,\n535\t    line: message,\n536\t    occurredAt,\n537\t    source: \"gemini-cli\",\n538\t    sessionId,\n539\t    seq,\n540\t    version,\n541\t    rawFormat: RAW_FORMAT,\n542\t    conversationId: conversation.id,\n543\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n544\t    agent: agentContext(message, sourceVersion),\n545\t  });\n546\t}\n547\t\n548\t/**\n549\t * Re-normalization hook (see renormalize.ts). The whole message object is what\n550\t * `raw.data` stores — not the log line it arrived on — so reconstruction needs\n551\t * no replay: the same message, the same `seq` and session id go back through\n552\t * `convertMessage`, yielding the id a live capture would produce. `baseTime`\n553\t * falls back to the preserved event's own `occurred_at`, which is the value\n554\t * the preservation path computed, so a timestampless message reconstructs to\n555\t * the same instant and the same id.\n556\t */\n557\texport function renormalizeUnrecognized(\n558\t  event: EvidenceEvent,\n559\t  identity: GitUserIdentity,\n560\t): EventDraft | null {\n561\t  if (!event.raw || event.conversation === undefined) return null;\n562\t  const message = event.raw.data as GeminiMessage | null;\n563\t  if (!message || typeof message !== \"object\") return null;\n564\t  return convertMessage(\n565\t    message,\n566\t    event.conversation.seq,\n567\t    event.producer.session_id ?? \"\",\n568\t    event.occurred_at,\n569\t    packageVersion(),\n570\t    identity,\n571\t    event.producer.source_version,\n572\t    event.conversation.parent?.replace(/^gemini-cli:/, \"\"),\n573\t  );\n574\t}\n575\t\n576\t/**\n577\t * Capture an already-read session log. Split out from the file plumbing so\n578\t * tests and offline backfill exercise replay + conversion directly.\n579\t *\n580\t * `sourceVersion` is the Gemini CLI version, which the session file does not\n581\t * record; a live hook capture does not know it either, so it is optional and\n582\t * omitted rather than guessed.\n583\t */\n584\texport async function captureGeminiSession(\n585\t  text: string,\n586\t  cwd: string,\n587\t  fallbackSessionId: string,\n588\t  sourceVersion?: string,\n589\t  parentId?: string,\n590\t): Promise<CaptureResult> {\n591\t  const repo = await findRepo(cwd);\n592\t  if (!repo) throw new Error(\"not inside a git repository\");\n593\t  const result = await captureSessionInto(repo, text, fallbackSessionId, sourceVersion, parentId, 0);\n594\t  process.stderr.write(\n595\t    `cledger: gemini-cli +${result.appended} events (${result.deduped} deduped)\\n`,\n596\t  );\n597\t  warnUnrecognized(\"gemini-cli\", result.unrecognized);\n598\t  return result;\n599\t}\n600\t\n601\t/** The conversion half, without printing — shared by every capture entrypoint. */\n602\tasync function captureSessionInto(\n603\t  repo: RepoInfo,\n604\t  text: string,\n605\t  fallbackSessionId: string,\n606\t  sourceVersion: string | undefined,\n607\t  parentId: string | undefined,\n608\t  fileSize: number,\n609\t): Promise<CaptureResult> {\n610\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n611\t  const session = replaySession(text);\n612\t  const sessionId = session.metadata.sessionId ?? fallbackSessionId;\n613\t  if (!sessionId) return result;\n614\t\n615\t  const baseTime =\n616\t    session.metadata.startTime ?? session.metadata.lastUpdated ?? new Date().toISOString();\n617\t  const version = packageVersion();\n618\t  const identity = await gitUserIdentity(repo);\n619\t\n620\t  // The cursor is the lowest ordering key not yet finalized — not a position\n621\t  // in the replayed list. Because keys are assigned at first sighting and never\n622\t  // reused, a rewind that shortens the document cannot make the cursor skip\n623\t  // past records written after it.\n624\t  const cursor = (await readCursor(repo, sessionId, CURSOR_FIELD))?.count ?? 0;\n625\t  let nextCursor = cursor;\n626\t  let held = false;\n627\t\n628\t  const drafts: EventDraft[] = [];\n629\t  const advance = (seq: number) => {\n630\t    if (!held) nextCursor = seq + 1;\n631\t  };\n632\t\n633\t  for (const mutation of session.mutations) {\n634\t    if (mutation.seq < cursor) continue;\n635\t    const ctx = recordContext(baseTime, mutation.seq, sessionId, version, parentId, {\n636\t      ...(sourceVersion ? { source_version: sourceVersion } : {}),\n637\t    });\n638\t    drafts.push(convertMutation(mutation, ctx));\n639\t  }\n640\t\n641\t  for (const { message, seq } of session.messages) {\n642\t    if (seq < cursor) continue;\n643\t    const type = typeof message.type === \"string\" ? message.type : \"(untyped)\";\n644\t\n645\t    // A message Gemini has already dropped from its live document can never be\n646\t    // rewritten, so a tool call left mid-flight on one is settled by\n647\t    // abandonment — without this it would hold the cursor back forever.\n648\t    if (!session.rewound.has(message.id ?? \"\") && !isSettled(message)) {\n649\t      held = true;\n650\t      continue;\n651\t    }\n652\t\n653\t    const draft = convertMessage(\n654\t      message,\n655\t      seq,\n656\t      sessionId,\n657\t      baseTime,\n658\t      version,\n659\t      identity,\n660\t      sourceVersion,\n661\t      parentId,\n662\t    );\n663\t    if (draft) {\n664\t      drafts.push(draft);\n665\t      continue;\n666\t    }\n667\t    if (CONVERTIBLE_MESSAGE_TYPES.has(type) || NOTICE_MESSAGE_TYPES.has(type)) continue; // empty\n668\t    countUnrecognized(result.unrecognized, type);\n669\t    const occurredAt = typeof message.timestamp === \"string\" ? message.timestamp : baseTime;\n670\t    drafts.push(preserve(type, message, occurredAt, seq, sessionId, version, sourceVersion, parentId));\n671\t  }\n672\t\n673\t  // The cursor advances to the highest seq examined, unless a withheld message\n674\t  // held it back at its own position.\n675\t  for (const { seq } of session.messages) if (seq >= cursor) advance(seq);\n676\t  for (const { seq } of session.mutations) if (seq >= cursor) advance(seq);\n677\t\n678\t  if (drafts.length > 0) {\n679\t    const appendResult = await appendEvents(repo, drafts);\n680\t    result.appended = appendResult.appended.length;\n681\t    result.deduped = appendResult.deduped;\n682\t  }\n683\t  await writeCursor(repo, sessionId, CURSOR_FIELD, nextCursor, fileSize);\n684\t  return result;\n685\t}\n686\t\n687\t/** Session id embedded in `session-<timestamp>-<short id>.jsonl`, else the stem. */\n688\tfunction sessionIdFromPath(path: string): string {\n689\t  return basename(path, \".jsonl\");\n690\t}\n691\t\n692\t/** Capture one session file, plus any subagent sessions filed beneath it. */\n693\tasync function captureSessionFile(\n694\t  repo: RepoInfo,\n695\t  path: string,\n696\t  parentId?: string,\n697\t): Promise<CaptureResult> {\n698\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n699\t  let text: string;\n700\t  try {\n701\t    text = await readFile(path, \"utf8\");\n702\t  } catch {\n703\t    return total; // not written yet\n704\t  }\n705\t  mergeCaptureResult(\n706\t    total,\n707\t    await captureSessionInto(\n708\t      repo,\n709\t      text,\n710\t      sessionIdFromPath(path),\n711\t      undefined,\n712\t      parentId,\n713\t      Buffer.byteLength(text),\n714\t    ),\n715\t  );\n716\t  for (const child of await subagentSessions(path)) {\n717\t    mergeCaptureResult(total, await captureSessionFile(repo, child, sessionIdOf(text, path)));\n718\t  }\n719\t  return total;\n720\t}\n721\t\n722\t/** The session id a file declares, falling back to its name. */\n723\tfunction sessionIdOf(text: string, path: string): string {\n724\t  return replaySession(text).metadata.sessionId ?? sessionIdFromPath(path);\n725\t}\n726\t\n727\t/**\n728\t * Subagent session files belonging to a session.\n729\t *\n730\t * Gemini files a sub-session's chats under `<chats>/<parent session id>/`, a\n731\t * sibling directory of the parent's own file that nothing in the parent\n732\t * transcript points at — so, exactly as with claude-code's `subagents/`\n733\t * directory, capture has to go looking or the whole sub-conversation is\n734\t * invisible however well the adapter can convert its lines.\n735\t */\n736\tasync function subagentSessions(path: string): Promise<string[]> {\n737\t  const text = await readFile(path, \"utf8\").catch(() => \"\");\n738\t  if (!text) return [];\n739\t  const id = sessionIdOf(text, path);\n740\t  const dir = join(path.slice(0, path.lastIndexOf(\"/\")), id);\n741\t  try {\n742\t    const entries = await readdir(dir);\n743\t    return entries\n744\t      .filter((name) => name.endsWith(\".jsonl\"))\n745\t      .sort()\n746\t      .map((name) => join(dir, name));\n747\t  } catch {\n748\t    return []; // no subagents ran\n749\t  }\n750\t}\n751\t\n752\texport async function captureGeminiTranscript(\n753\t  transcriptPath: string,\n754\t  cwd: string,\n755\t): Promise<CaptureResult> {\n756\t  const repo = await findRepo(cwd);\n757\t  if (!repo) throw new Error(\"not inside a git repository\");\n758\t  const result = await captureSessionFile(repo, transcriptPath);\n759\t  process.stderr.write(\n760\t    `cledger: gemini-cli +${result.appended} events (${result.deduped} deduped)\\n`,\n761\t  );\n762\t  warnUnrecognized(\"gemini-cli\", result.unrecognized);\n763\t  return result;\n764\t}\n765\t\n766\t/**\n767\t * Resolve the directory Gemini CLI keeps `cwd`'s chats in.\n768\t *\n769\t * Gemini names each project directory after the workspace's basename (with a\n770\t * disambiguating suffix when two workspaces share one), and records the\n771\t * mapping in `~/.gemini/projects.json`. That file is consulted first; if it is\n772\t * missing or stale, the fallback reads the `.project_root` marker Gemini writes\n773\t * inside each directory, which states the absolute workspace path. Guessing\n774\t * from the basename alone would collide across checkouts.\n775\t */\n776\texport async function geminiProjectChatsDir(cwd: string): Promise<string | null> {\n777\t  const tmpRoot = join(homedir(), \".gemini\", \"tmp\");\n778\t  try {\n779\t    const raw = await readFile(join(homedir(), \".gemini\", \"projects.json\"), \"utf8\");\n780\t    const parsed = JSON.parse(raw) as { projects?: Record<string, string> };\n781\t    const name = parsed.projects?.[cwd];\n782\t    if (typeof name === \"string\" && name) return join(tmpRoot, name, \"chats\");\n783\t  } catch {\n784\t    /* fall through to the marker scan */\n785\t  }\n786\t  let names: string[];\n787\t  try {\n788\t    names = await readdir(tmpRoot);\n789\t  } catch {\n790\t    return null;\n791\t  }\n792\t  for (const name of names) {\n793\t    try {\n794\t      const root = (await readFile(join(tmpRoot, name, \".project_root\"), \"utf8\")).trim();\n795\t      if (root === cwd) return join(tmpRoot, name, \"chats\");\n796\t    } catch {\n797\t      continue;\n798\t    }\n799\t  }\n800\t  return null;\n801\t}\n802\t\n803\t/** Every top-level session file for this workspace, newest first. */\n804\tasync function projectSessions(cwd: string): Promise<string[]> {\n805\t  const dir = await geminiProjectChatsDir(cwd);\n806\t  if (!dir) return [];\n807\t  let names: string[];\n808\t  try {\n809\t    names = await readdir(dir);\n810\t  } catch {\n811\t    return [];\n812\t  }\n813\t  const stamped = await Promise.all(\n814\t    names\n815\t      .filter((name) => name.endsWith(\".jsonl\"))\n816\t      .map(async (name) => {\n817\t        const path = join(dir, name);\n818\t        return { path, mtime: await stat(path).then((s) => s.mtimeMs, () => 0) };\n819\t      }),\n820\t  );\n821\t  stamped.sort((a, b) => b.mtime - a.mtime);\n822\t  return stamped.map((s) => s.path);\n823\t}\n824\t\n825\t/**\n826\t * Capture every Gemini CLI chat recorded for this workspace, seen before or\n827\t * not — the explicit backfill behind `cledger capture gemini-cli --all`.\n828\t */\n829\texport async function captureGeminiAll(cwd: string, limit?: number): Promise<CaptureResult> {\n830\t  const repo = await findRepo(cwd);\n831\t  if (!repo) throw new Error(\"not inside a git repository\");\n832\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n833\t  const paths = await projectSessions(cwd);\n834\t  for (const path of typeof limit === \"number\" ? paths.slice(0, limit) : paths) {\n835\t    mergeCaptureResult(total, await captureSessionFile(repo, path));\n836\t  }\n837\t  process.stderr.write(`cledger: gemini-cli +${total.appended} events (${total.deduped} deduped)\\n`);\n838\t  warnUnrecognized(\"gemini-cli\", total.unrecognized);\n839\t  return total;\n840\t}\n841\t\n842\t/**\n843\t * Capture any *other* session in this workspace whose file has grown since it\n844\t * was last read. Bounded to sessions that already have a cursor, for the same\n845\t * reason claude-code's sweep is: a missing cursor means cledger never captured\n846\t * that session, and adopting it would be a silent backfill anchored to the\n847\t * wrong commit rather than the gap-closing pass this is meant to be.\n848\t */\n849\tasync function sweepStaleSessions(\n850\t  repo: RepoInfo,\n851\t  cwd: string,\n852\t  seen: Set<string>,\n853\t): Promise<CaptureResult> {\n854\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n855\t  for (const path of await projectSessions(cwd)) {\n856\t    if (seen.has(path)) continue;\n857\t    try {\n858\t      const cursor = await readCursor(repo, sessionIdFromPath(path), CURSOR_FIELD);\n859\t      if (cursor === null) continue; // never captured — not this pass's business\n860\t      const info = await stat(path);\n861\t      if (info.size <= cursor.size) continue; // nothing new since the last read\n862\t      mergeCaptureResult(total, await captureSessionFile(repo, path));\n863\t    } catch {\n864\t      continue;\n865\t    }\n866\t  }\n867\t  return total;\n868\t}\n869\t\n870\texport async function runGeminiHook(stdinJson: string): Promise<void> {\n871\t  try {\n872\t    const payload = JSON.parse(stdinJson) as GeminiHookPayload;\n873\t    const cwd = payload.cwd ?? process.cwd();\n874\t    const repo = await findRepo(cwd);\n875\t    if (!repo) return; // hooks must never break the user's session outside a repo\n876\t    const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n877\t    const seen = new Set<string>();\n878\t    if (payload.transcript_path) {\n879\t      seen.add(payload.transcript_path);\n880\t      mergeCaptureResult(total, await captureSessionFile(repo, payload.transcript_path));\n881\t    }\n882\t    mergeCaptureResult(total, await sweepStaleSessions(repo, cwd, seen));\n883\t    process.stderr.write(\n884\t      `cledger: gemini-cli +${total.appended} events (${total.deduped} deduped)\\n`,\n885\t    );\n886\t    warnUnrecognized(\"gemini-cli\", total.unrecognized);\n887\t  } catch (err) {\n888\t    process.stderr.write(\n889\t      `cledger: gemini-cli hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n890\t    );\n891\t  }\n892\t}\n893\t","tool_use_id":"toolu_011ku2JZTvhcBcoYV2SosKVi","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","head":"0efe101ae3a794ff333e1c5b4122fdb71b3266fd","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:d10310cd-8144-4046-87b9-97bbb6ace18c","seq":77},"id":"ev1-caab406dfccd7e0466d92af529cfd00b080b6315eb8b11db6c2b5d1eb8c95a29","kind":"conversation_turn","occurred_at":"2026-08-06T04:39:15.104Z","producer":{"session_id":"d10310cd-8144-4046-87b9-97bbb6ace18c","source":"claude-code","source_version":"2.1.223","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","entrypoint":"cli","gitBranch":"worktree-more-cli-adapters","isSidechain":false,"message":{"content":[{"content":"1\t/**\n2\t * Gemini CLI adapter.\n3\t *\n4\t * Gemini CLI records a session to\n5\t * `~/.gemini/tmp/<project>/chats/session-<ts>-<id>.jsonl`, and the hook\n6\t * payload hands us that path directly. The file is append-only on disk but it\n7\t * is *not* a transcript: it is a write-ahead log of mutations to a single\n8\t * conversation document, and a line's meaning depends on every line before\n9\t * it. Four record forms exist, discriminated exactly as Gemini CLI's own\n10\t * `loadConversationRecord` discriminates them, and in this precedence order:\n11\t *\n12\t *  1. `{\"$rewindTo\": \"<message id>\"}` — the user rewound; that message and\n13\t *     every message after it leave the document. An unknown id clears it.\n14\t *  2. a bare message object (identified by a string `id`) — upsert by id.\n15\t *     Re-appending an existing id *replaces* it, which is how a model turn\n16\t *     grows its `toolCalls` as tools run.\n17\t *  3. `{\"$set\": {...}}` — metadata patch. When it carries a `messages` array\n18\t *     it replaces the entire message list.\n19\t *  4. the header (`sessionId` + `projectHash`), which may itself carry a\n20\t *     `messages` array.\n21\t *\n22\t * Three consequences drive this adapter's design.\n23\t *\n24\t * **Deletions are not honoured.** Replaying the log the way Gemini CLI does —\n25\t * applying every removal — reconstructs what the CLI would *resume*, which is\n26\t * not the same thing as what happened. Verified on a real session: after a\n27\t * failed API call Gemini rewrote the document with a `$set.messages` snapshot\n28\t * that silently dropped the prompt the user had just typed, so a faithful\n29\t * replay captures no record of it having been asked. The ledger records\n30\t * evidence, and the human did type it. So capture takes the *union* of every\n31\t * message the file ever contained, each at its last-written value, and treats\n32\t * `$rewindTo` and snapshot truncation as facts about Gemini's live view\n33\t * rather than instructions to forget. The removal itself is recorded too, as\n34\t * an `activity` — a rewind is something that happened, and a consumer\n35\t * reconstructing intent needs to know a turn was withdrawn, not just that it\n36\t * exists.\n37\t *\n38\t * **Ordering key.** `seq` is the index of the log record a thing was first\n39\t * seen at, counted in file order across messages *and* the mutation records\n40\t * between them, so both share one number space and neither can collide with\n41\t * the other. A message keeps the number it was first sighted under, so a\n42\t * rewind cannot renumber later turns — the positional-`seq` churn the\n43\t * opencode adapter documents and accepts does not arise here.\n44\t *\n45\t * **Settledness.** Because re-appending an id replaces the message, a model\n46\t * turn is mutable while its tools run: capturing it early would freeze a\n47\t * half-finished tool call into an immutable event id. A message whose\n48\t * `toolCalls` contain one that has neither a result nor a terminal status is\n49\t * therefore withheld, and holds the cursor back so the finished version is\n50\t * picked up next time.\n51\t */\n52\timport { readdir, readFile, stat } from \"node:fs/promises\";\n53\timport { homedir } from \"node:os\";\n54\timport { basename, join } from \"node:path\";\n55\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n56\timport { appendEvents } from \"../store.js\";\n57\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n58\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n59\timport { convertParts, ensurePartArray, isEmptyParts } from \"./genai-parts.js\";\n60\timport {\n61\t  countUnrecognized,\n62\t  mergeCaptureResult,\n63\t  unrecognizedDraft,\n64\t  warnUnrecognized,\n65\t  type CaptureResult,\n66\t} from \"./drift.js\";\n67\timport {\n68\t  activityDraft,\n69\t  liftText,\n70\t  recordDraft,\n71\t  sessionStateDraft,\n72\t  type RecordContext,\n73\t} from \"./records.js\";\n74\t\n75\tconst RAW_FORMAT = \"gemini-cli-chatlog/1\";\n76\t\n77\tconst CURSOR_FIELD = \"messages\";\n78\t\n79\t/** Message types carrying a turn someone took. */\n80\tconst CONVERTIBLE_MESSAGE_TYPES = new Set([\"user\", \"gemini\"]);\n81\t\n82\t/**\n83\t * Message types Gemini writes for transient UI notices. They are recorded as\n84\t * `conversation_turn`s spoken by `system` when they carry text, on the same\n85\t * reasoning the claude-code adapter applies to its text-bearing `system`\n86\t * lines: the user read them, so they are part of the conversation even though\n87\t * no participant composed them. A notice with no text becomes an `activity`.\n88\t *\n89\t * Gemini's own history assembly discards these outright. That is right for\n90\t * resuming a chat and wrong for a ledger — \"quota exceeded\" is often the only\n91\t * explanation for why a turn looks abandoned.\n92\t */\n93\tconst NOTICE_MESSAGE_TYPES = new Set([\"info\", \"error\", \"warning\"]);\n94\t\n95\t/**\n96\t * Tool-call states that will never change again. A call with a `result` is\n97\t * settled whatever its status says; one with neither is still running.\n98\t */\n99\tconst SETTLED_TOOL_STATUSES = new Set([\"success\", \"error\", \"cancelled\", \"canceled\"]);\n100\t\n101\t/**\n102\t * Metadata keys that carry the message list rather than a session fact. They\n103\t * are consumed by the replay itself and would be an enormous, duplicated\n104\t * `session_state` payload if they were also recorded as one.\n105\t */\n106\tconst MESSAGE_BEARING_KEYS = new Set([\"messages\"]);\n107\t\n108\t/**\n109\t * Prefixes Gemini CLI uses to inject harness-generated text as a `user`\n110\t * message: the session preamble it builds at startup, and the text a hook\n111\t * contributes. They are recorded as user turns because that is the API role\n112\t * they occupy, but the person at the keyboard did not write them, so they are\n113\t * attributed to `system` rather than carrying the git identity. Slash commands\n114\t * (`/help`) — which Gemini also filters out of its own resume history — *are*\n115\t * attributed to the human, because the human typed them.\n116\t */\n117\tconst HARNESS_USER_PREFIXES = [\"<session_context>\", \"<hook_context>\"];\n118\t\n119\t/** Payload Gemini CLI's hooks engine sends on stdin (subset we read). */\n120\tinterface GeminiHookPayload {\n121\t  session_id?: string;\n122\t  transcript_path?: string;\n123\t  cwd?: string;\n124\t  hook_event_name?: string;\n125\t}\n126\t\n127\tinterface GeminiThought {\n128\t  subject?: string;\n129\t  description?: string;\n130\t  timestamp?: string;\n131\t}\n132\t\n133\tinterface GeminiToolCall {\n134\t  id?: string;\n135\t  name?: string;\n136\t  args?: unknown;\n137\t  result?: unknown;\n138\t  status?: string;\n139\t  displayName?: string;\n140\t  description?: string;\n141\t}\n142\t\n143\t/** One message inside the conversation document. */\n144\tinterface GeminiMessage {\n145\t  id?: string;\n146\t  timestamp?: string;\n147\t  type?: string;\n148\t  /** `PartListUnion`: a string, one Part, or a Part array. */\n149\t  content?: unknown;\n150\t  displayContent?: unknown;\n151\t  thoughts?: GeminiThought[];\n152\t  toolCalls?: GeminiToolCall[];\n153\t  tokens?: unknown;\n154\t  model?: string;\n155\t}\n156\t\n157\t/** Session-level metadata accumulated from header and `$set` records. */\n158\tinterface GeminiSessionMetadata {\n159\t  sessionId?: string;\n160\t  projectHash?: string;\n161\t  startTime?: string;\n162\t  lastUpdated?: string;\n163\t  kind?: string;\n164\t}\n165\t\n166\t/** A replayed message plus the ordering key assigned at first sighting. */\n167\tinterface OrderedMessage {\n168\t  message: GeminiMessage;\n169\t  seq: number;\n170\t}\n171\t\n172\t/**\n173\t * A log record that is not a message: a metadata patch or a rewind. Recorded\n174\t * in its own right rather than only being applied, so the ledger keeps the\n175\t * session's declarations and the fact that a rewind happened.\n176\t */\n177\tinterface OrderedMutation {\n178\t  seq: number;\n179\t  /** \"metadata\" for a `$set`/header patch, \"rewind\" for a `$rewindTo`. */\n180\t  kind: \"metadata\" | \"rewind\";\n181\t  fields: Record<string, unknown>;\n182\t  raw: unknown;\n183\t}\n184\t\n185\texport interface GeminiSession {\n186\t  metadata: GeminiSessionMetadata;\n187\t  /** Every message the file ever held, at its last-written value, in first-sighting order. */\n188\t  messages: OrderedMessage[];\n189\t  /** Metadata patches and rewinds, in file order. */\n190\t  mutations: OrderedMutation[];\n191\t  /**\n192\t   * Ids Gemini CLI removed from its own live document — via `$rewindTo` or by\n193\t   * omitting them from a `$set.messages` snapshot. Captured anyway (see the\n194\t   * module comment); a withheld message that has been removed can never be\n195\t   * rewritten, so this is also what stops one holding the cursor forever.\n196\t   */\n197\t  rewound: Set<string>;\n198\t}\n199\t\n200\tfunction isRecord(value: unknown): value is Record<string, unknown> {\n201\t  return typeof value === \"object\" && value !== null;\n202\t}\n203\t\n204\tfunction isStringProp(value: unknown, prop: string): boolean {\n205\t  return isRecord(value) && typeof value[prop] === \"string\";\n206\t}\n207\t\n208\t/**\n209\t * Replay the write-ahead log.\n210\t *\n211\t * Record discrimination and precedence mirror Gemini CLI's own\n212\t * `loadConversationRecord` exactly — including its \"an unresolvable rewind\n213\t * target drops everything\" fallback — so that `live` tracks what the CLI\n214\t * itself would resume. The divergence is what gets *returned*: removals are\n215\t * recorded rather than applied to the captured set.\n216\t */\n217\texport function replaySession(text: string): GeminiSession {\n218\t  const metadata: GeminiSessionMetadata = {};\n219\t  /** Union: every message ever written, at its last-written value. */\n220\t  const seen = new Map<string, GeminiMessage>();\n221\t  /** What Gemini CLI itself would consider the current document. */\n222\t  let live = new Set<string>();\n223\t  const firstSeen = new Map<string, number>();\n224\t  const mutations: OrderedMutation[] = [];\n225\t  let nextSeq = 0;\n226\t\n227\t  const upsert = (candidate: unknown): void => {\n228\t    if (!isStringProp(candidate, \"id\")) return;\n229\t    const message = candidate as GeminiMessage;\n230\t    const id = message.id!;\n231\t    if (!firstSeen.has(id)) firstSeen.set(id, nextSeq++);\n232\t    seen.set(id, message);\n233\t    live.add(id);\n234\t  };\n235\t\n236\t  for (const line of text.split(\"\\n\")) {\n237\t    if (!line.trim()) continue;\n238\t    let record: unknown;\n239\t    try {\n240\t      record = JSON.parse(line);\n241\t    } catch {\n242\t      continue; // partial line — normal at the tail of a live session\n243\t    }\n244\t    if (!isRecord(record)) continue;\n245\t\n246\t    if (isStringProp(record, \"$rewindTo\")) {\n247\t      const target = record[\"$rewindTo\"] as string;\n248\t      const ids = [...live];\n249\t      const at = ids.indexOf(target);\n250\t      // An unresolvable target drops the whole document, matching the CLI.\n251\t      const removed = at === -1 ? ids : ids.slice(at);\n252\t      live = at === -1 ? new Set() : new Set(ids.slice(0, at));\n253\t      mutations.push({\n254\t        seq: nextSeq++,\n255\t        kind: \"rewind\",\n256\t        fields: { rewind_to: target, removed_messages: removed, resolved: at !== -1 },\n257\t        raw: record,\n258\t      });\n259\t      continue;\n260\t    }\n261\t\n262\t    if (isStringProp(record, \"id\")) {\n263\t      upsert(record);\n264\t      continue;\n265\t    }\n266\t\n267\t    if (isRecord(record[\"$set\"])) {\n268\t      const set = record[\"$set\"] as Record<string, unknown>;\n269\t      if (Array.isArray(set[\"messages\"])) {\n270\t        // A snapshot replaces the live document wholesale; anything it omits\n271\t        // is dropped from the CLI's view but kept in `seen`.\n272\t        live = new Set();\n273\t        for (const message of set[\"messages\"]) upsert(message);\n274\t      }\n275\t      Object.assign(metadata, set);\n276\t      const fields = patchFields(set);\n277\t      if (Object.keys(fields).length > 0) {\n278\t        mutations.push({ seq: nextSeq++, kind: \"metadata\", fields, raw: record });\n279\t      }\n280\t      continue;\n281\t    }\n282\t\n283\t    if (isStringProp(record, \"sessionId\") && isStringProp(record, \"projectHash\")) {\n284\t      Object.assign(metadata, record);\n285\t      if (Array.isArray(record[\"messages\"])) {\n286\t        for (const message of record[\"messages\"]) upsert(message);\n287\t      }\n288\t      const fields = patchFields(record);\n289\t      if (Object.keys(fields).length > 0) {\n290\t        mutations.push({ seq: nextSeq++, kind: \"metadata\", fields, raw: record });\n291\t      }\n292\t    }\n293\t  }\n294\t\n295\t  const messages = [...seen.entries()]\n296\t    .map(([id, message]) => ({ message, seq: firstSeen.get(id) ?? 0 }))\n297\t    // Sorting by first sighting makes the emitted order a pure function of the\n298\t    // file rather than of Map insertion history, which a snapshot reshuffles.\n299\t    .sort((a, b) => a.seq - b.seq);\n300\t  const rewound = new Set([...seen.keys()].filter((id) => !live.has(id)));\n301\t  return { metadata, messages, mutations, rewound };\n302\t}\n303\t\n304\t/** A metadata record's own fields, minus the message list it may carry. */\n305\tfunction patchFields(record: Record<string, unknown>): Record<string, unknown> {\n306\t  const out: Record<string, unknown> = {};\n307\t  for (const [key, value] of Object.entries(record)) {\n308\t    if (!MESSAGE_BEARING_KEYS.has(key)) out[key] = value;\n309\t  }\n310\t  return out;\n311\t}\n312\t\n313\t/** Whether every tool call on a message has reached a state that cannot change. */\n314\tfunction isSettled(message: GeminiMessage): boolean {\n315\t  for (const call of message.toolCalls ?? []) {\n316\t    if (call.result !== undefined) continue;\n317\t    if (typeof call.status === \"string\" && SETTLED_TOOL_STATUSES.has(call.status)) continue;\n318\t    return false;\n319\t  }\n320\t  return true;\n321\t}\n322\t\n323\t/**\n324\t * The agent facts a message states about itself. Gemini CLI labels model turns\n325\t * with the serving model and states no provider anywhere in the file (the same\n326\t * CLI reaches AI Studio, Vertex, or a Code Assist tier depending on how the\n327\t * user authenticated), so `provider` is left unset rather than assumed.\n328\t *\n329\t * `source_version` is not recorded per message either — unlike claude-code and\n330\t * qwen-code, Gemini CLI stamps no CLI version into its session file — so it is\n331\t * supplied by the caller when one is known, and otherwise omitted. Guessing it\n332\t * from the installed binary would be wrong for a backfill of an old session.\n333\t */\n334\tfunction agentContext(message: GeminiMessage, sourceVersion?: string): ProducerAgentContext {\n335\t  const agent: ProducerAgentContext = {};\n336\t  if (sourceVersion) agent.source_version = sourceVersion;\n337\t  if (typeof message.model === \"string\" && message.model) agent.model = message.model;\n338\t  return agent;\n339\t}\n340\t\n341\tfunction partListText(content: unknown): string {\n342\t  return ensurePartArray(content)\n343\t    .map((part) => (typeof part.text === \"string\" ? part.text : \"\"))\n344\t    .join(\"\");\n345\t}\n346\t\n347\tfunction isHarnessAuthored(content: unknown): boolean {\n348\t  const text = partListText(content).trim();\n349\t  return HARNESS_USER_PREFIXES.some((prefix) => text.startsWith(prefix));\n350\t}\n351\t\n352\t/**\n353\t * Which conversation a session's messages belong to. Gemini gives a subagent\n354\t * its own session file under `<chats>/<parent session id>/`, so the directory\n355\t * name is the parent link — the file itself never states one.\n356\t */\n357\tfunction conversationFor(sessionId: string, parentId?: string): { id: string; parent?: string } {\n358\t  const id = `gemini-cli:${sessionId}`;\n359\t  return parentId ? { id, parent: `gemini-cli:${parentId}` } : { id };\n360\t}\n361\t\n362\t/** Blocks for a `gemini` message, mirroring the CLI's own history assembly. */\n363\tfunction modelBlocks(message: GeminiMessage): unknown[] {\n364\t  const parts = ensurePartArray(message.content);\n365\t  const callsInContent = parts.some((part) => part.functionCall !== undefined);\n366\t  const thoughtsInContent = parts.some((part) => part.thought === true);\n367\t\n368\t  const blocks: unknown[] = [];\n369\t  // When the content parts already carry the calls or the reasoning, Gemini CLI\n370\t  // uses them alone and ignores the sibling `thoughts`/`toolCalls` fields —\n371\t  // they are the same facts recorded twice. Mirroring that precedence is what\n372\t  // keeps a turn from emitting each tool call as two blocks.\n373\t  if (callsInContent || thoughtsInContent) {\n374\t    blocks.push(...convertParts(message.content));\n375\t  } else {\n376\t    for (const thought of message.thoughts ?? []) {\n377\t      const text = thought.description ?? thought.subject;\n378\t      if (typeof text !== \"string\" || !text.trim()) continue;\n379\t      const block: Record<string, unknown> = { type: \"thinking\", text };\n380\t      if (typeof thought.subject === \"string\" && thought.subject) block[\"subject\"] = thought.subject;\n381\t      blocks.push(block);\n382\t    }\n383\t    blocks.push(...convertParts(message.content));\n384\t    for (const call of message.toolCalls ?? []) {\n385\t      const block: Record<string, unknown> = { type: \"tool_use\" };\n386\t      if (typeof call.id === \"string\") block[\"id\"] = call.id;\n387\t      if (typeof call.name === \"string\") block[\"name\"] = call.name;\n388\t      if (call.args !== undefined) block[\"input\"] = call.args;\n389\t      blocks.push(block);\n390\t    }\n391\t  }\n392\t\n393\t  // Results are appended either way: the content parts hold the *call*, never\n394\t  // its outcome — Gemini CLI emits those as a separate synthetic message.\n395\t  for (const call of message.toolCalls ?? []) {\n396\t    if (call.result === undefined) continue;\n397\t    const block: Record<string, unknown> = { type: \"tool_result\" };\n398\t    if (typeof call.id === \"string\") block[\"tool_use_id\"] = call.id;\n399\t    if (typeof call.name === \"string\") block[\"name\"] = call.name;\n400\t    block[\"content\"] = call.result;\n401\t    if (call.status === \"error\") block[\"is_error\"] = true;\n402\t    blocks.push(block);\n403\t  }\n404\t  return blocks;\n405\t}\n406\t\n407\t/** The `RecordContext` a message or mutation converts under. */\n408\tfunction recordContext(\n409\t  occurredAt: string,\n410\t  seq: number,\n411\t  sessionId: string,\n412\t  version: string,\n413\t  parentId: string | undefined,\n414\t  agent: ProducerAgentContext,\n415\t): RecordContext {\n416\t  const conversation = conversationFor(sessionId, parentId);\n417\t  return {\n418\t    occurredAt,\n419\t    source: \"gemini-cli\",\n420\t    sessionId,\n421\t    seq,\n422\t    version,\n423\t    rawFormat: RAW_FORMAT,\n424\t    conversationId: conversation.id,\n425\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n426\t    agent,\n427\t  };\n428\t}\n429\t\n430\tfunction convertMessage(\n431\t  message: GeminiMessage,\n432\t  seq: number,\n433\t  sessionId: string,\n434\t  baseTime: string,\n435\t  version: string,\n436\t  identity: GitUserIdentity,\n437\t  sourceVersion: string | undefined,\n438\t  parentId: string | undefined,\n439\t): EventDraft | null {\n440\t  const type = message.type;\n441\t  if (typeof type !== \"string\") return null;\n442\t\n443\t  const agent = agentContext(message, sourceVersion);\n444\t  const occurredAt = typeof message.timestamp === \"string\" ? message.timestamp : baseTime;\n445\t  const ctx = recordContext(occurredAt, seq, sessionId, version, parentId, agent);\n446\t\n447\t  if (NOTICE_MESSAGE_TYPES.has(type)) {\n448\t    const text = partListText(message.content).trim();\n449\t    if (text) {\n450\t      return recordDraft(\n451\t        ctx,\n452\t        \"conversation_turn\",\n453\t        \"system\",\n454\t        { role: \"system\", notice_type: type, blocks: [{ type: \"text\", text }] },\n455\t        message,\n456\t      );\n457\t    }\n458\t    const { content: _content, ...fields } = message as Record<string, unknown>;\n459\t    return activityDraft(ctx, `notice/${type}`, fields, message);\n460\t  }\n461\t\n462\t  if (!CONVERTIBLE_MESSAGE_TYPES.has(type)) return null;\n463\t\n464\t  let blocks: unknown[];\n465\t  let actor: Actor;\n466\t  if (type === \"user\") {\n467\t    if (isEmptyParts(message.content)) return null;\n468\t    blocks = convertParts(message.content);\n469\t    if (isHarnessAuthored(message.content)) {\n470\t      actor = { type: \"system\" };\n471\t    } else {\n472\t      actor = { type: \"human\" };\n473\t      if (identity.email) actor.id = identity.email;\n474\t      if (identity.name) actor.display = identity.name;\n475\t    }\n476\t  } else {\n477\t    blocks = modelBlocks(message);\n478\t    if (blocks.length === 0) return null;\n479\t    actor = { type: \"agent\" };\n480\t    if (agent.model) actor.id = agent.model;\n481\t  }\n482\t\n483\t  const conversation = conversationFor(sessionId, parentId);\n484\t  return {\n485\t    kind: \"conversation_turn\",\n486\t    occurred_at: occurredAt,\n487\t    actor,\n488\t    producer: {\n489\t      tool: \"cledger\",\n490\t      version,\n491\t      source: \"gemini-cli\",\n492\t      session_id: sessionId,\n493\t      ...agent,\n494\t    },\n495\t    conversation: {\n496\t      id: conversation.id,\n497\t      seq,\n498\t      ...(conversation.parent ? { parent: conversation.parent } : {}),\n499\t    },\n500\t    content: { role: type === \"user\" ? \"user\" : \"model\", blocks },\n501\t    raw: { format: RAW_FORMAT, data: message },\n502\t  };\n503\t}\n504\t\n505\t/**\n506\t * A metadata patch or a rewind, as its own event.\n507\t *\n508\t * A `$set` is a declaration about the session that holds until restated —\n509\t * `session_state`, exactly like claude-code's `mode` and `summary` lines,\n510\t * restatements included. A `$rewindTo` is something that happened, so it is\n511\t * `activity`; it is the one record that makes the withdrawn turns above it\n512\t * legible as withdrawn rather than merely present.\n513\t */\n514\tfunction convertMutation(mutation: OrderedMutation, ctx: RecordContext): EventDraft {\n515\t  if (mutation.kind === \"rewind\") {\n516\t    return activityDraft(ctx, \"rewind\", mutation.fields, mutation.raw);\n517\t  }\n518\t  return sessionStateDraft(ctx, \"metadata\", liftText(mutation.fields, \"summary\"), mutation.raw);\n519\t}\n520\t\n521\t/** Raw-only preservation event for an unrecognized gemini-cli message. */\n522\tfunction preserve(\n523\t  typeKey: string,\n524\t  message: GeminiMessage,\n525\t  occurredAt: string,\n526\t  seq: number,\n527\t  sessionId: string,\n528\t  version: string,\n529\t  sourceVersion: string | undefined,\n530\t  parentId: string | undefined,\n531\t): EventDraft {\n532\t  const conversation = conversationFor(sessionId, parentId);\n533\t  return unrecognizedDraft({\n534\t    typeKey,\n535\t    line: message,\n536\t    occurredAt,\n537\t    source: \"gemini-cli\",\n538\t    sessionId,\n539\t    seq,\n540\t    version,\n541\t    rawFormat: RAW_FORMAT,\n542\t    conversationId: conversation.id,\n543\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n544\t    agent: agentContext(message, sourceVersion),\n545\t  });\n546\t}\n547\t\n548\t/**\n549\t * Re-normalization hook (see renormalize.ts). The whole message object is what\n550\t * `raw.data` stores — not the log line it arrived on — so reconstruction needs\n551\t * no replay: the same message, the same `seq` and session id go back through\n552\t * `convertMessage`, yielding the id a live capture would produce. `baseTime`\n553\t * falls back to the preserved event's own `occurred_at`, which is the value\n554\t * the preservation path computed, so a timestampless message reconstructs to\n555\t * the same instant and the same id.\n556\t */\n557\texport function renormalizeUnrecognized(\n558\t  event: EvidenceEvent,\n559\t  identity: GitUserIdentity,\n560\t): EventDraft | null {\n561\t  if (!event.raw || event.conversation === undefined) return null;\n562\t  const message = event.raw.data as GeminiMessage | null;\n563\t  if (!message || typeof message !== \"object\") return null;\n564\t  return convertMessage(\n565\t    message,\n566\t    event.conversation.seq,\n567\t    event.producer.session_id ?? \"\",\n568\t    event.occurred_at,\n569\t    packageVersion(),\n570\t    identity,\n571\t    event.producer.source_version,\n572\t    event.conversation.parent?.replace(/^gemini-cli:/, \"\"),\n573\t  );\n574\t}\n575\t\n576\t/**\n577\t * Capture an already-read session log. Split out from the file plumbing so\n578\t * tests and offline backfill exercise replay + conversion directly.\n579\t *\n580\t * `sourceVersion` is the Gemini CLI version, which the session file does not\n581\t * record; a live hook capture does not know it either, so it is optional and\n582\t * omitted rather than guessed.\n583\t */\n584\texport async function captureGeminiSession(\n585\t  text: string,\n586\t  cwd: string,\n587\t  fallbackSessionId: string,\n588\t  sourceVersion?: string,\n589\t  parentId?: string,\n590\t): Promise<CaptureResult> {\n591\t  const repo = await findRepo(cwd);\n592\t  if (!repo) throw new Error(\"not inside a git repository\");\n593\t  const result = await captureSessionInto(repo, text, fallbackSessionId, sourceVersion, parentId, 0);\n594\t  process.stderr.write(\n595\t    `cledger: gemini-cli +${result.appended} events (${result.deduped} deduped)\\n`,\n596\t  );\n597\t  warnUnrecognized(\"gemini-cli\", result.unrecognized);\n598\t  return result;\n599\t}\n600\t\n601\t/** The conversion half, without printing — shared by every capture entrypoint. */\n602\tasync function captureSessionInto(\n603\t  repo: RepoInfo,\n604\t  text: string,\n605\t  fallbackSessionId: string,\n606\t  sourceVersion: string | undefined,\n607\t  parentId: string | undefined,\n608\t  fileSize: number,\n609\t): Promise<CaptureResult> {\n610\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n611\t  const session = replaySession(text);\n612\t  const sessionId = session.metadata.sessionId ?? fallbackSessionId;\n613\t  if (!sessionId) return result;\n614\t\n615\t  const baseTime =\n616\t    session.metadata.startTime ?? session.metadata.lastUpdated ?? new Date().toISOString();\n617\t  const version = packageVersion();\n618\t  const identity = await gitUserIdentity(repo);\n619\t\n620\t  // The cursor is the lowest ordering key not yet finalized — not a position\n621\t  // in the replayed list. Because keys are assigned at first sighting and never\n622\t  // reused, a rewind that shortens the document cannot make the cursor skip\n623\t  // past records written after it.\n624\t  const cursor = (await readCursor(repo, sessionId, CURSOR_FIELD))?.count ?? 0;\n625\t  let nextCursor = cursor;\n626\t  let held = false;\n627\t\n628\t  const drafts: EventDraft[] = [];\n629\t  const advance = (seq: number) => {\n630\t    if (!held) nextCursor = seq + 1;\n631\t  };\n632\t\n633\t  for (const mutation of session.mutations) {\n634\t    if (mutation.seq < cursor) continue;\n635\t    const ctx = recordContext(baseTime, mutation.seq, sessionId, version, parentId, {\n636\t      ...(sourceVersion ? { source_version: sourceVersion } : {}),\n637\t    });\n638\t    drafts.push(convertMutation(mutation, ctx));\n639\t  }\n640\t\n641\t  for (const { message, seq } of session.messages) {\n642\t    if (seq < cursor) continue;\n643\t    const type = typeof message.type === \"string\" ? message.type : \"(untyped)\";\n644\t\n645\t    // A message Gemini has already dropped from its live document can never be\n646\t    // rewritten, so a tool call left mid-flight on one is settled by\n647\t    // abandonment — without this it would hold the cursor back forever.\n648\t    if (!session.rewound.has(message.id ?? \"\") && !isSettled(message)) {\n649\t      held = true;\n650\t      continue