rt.text }\n      : { type: \"text\", text: part.text };\n  }\n  // inlineData / fileData / executableCode / anything new: verbatim.\n  const { thoughtSignature: _signature, ...rest } = part;\n  return rest;\n}\n\nexport function convertParts(content: unknown): unknown[] {\n  return ensurePartArray(content).map(convertPart);\n}\n\n/**\n * True when a part list carries nothing a reader would see. Both CLIs record\n * structurally valid but empty turns (a step that produced only a tool call\n * writes an empty text part first), and an event whose only block is an empty\n * string adds a line to `cledger log` that says nothing.\n */\nexport function isEmptyParts(content: unknown): boolean {\n  const parts = ensurePartArray(content);\n  if (parts.length === 0) return true;\n  return parts.every(\n    (part) =>\n      part.functionCall === undefined &&\n      part.functionResponse === undefined &&\n      (typeof part.text !== \"string\" ? Object.keys(part).length === 0 : part.text.trim() === \"\"),\n  );\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/genai-parts.ts","numLines":111,"startLine":1,"totalLines":111},"type":"text"},"type":"user","userType":"external","uuid":"45a394c1-7d2c-40fd-8824-c6262e226962","version":"2.1.223"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-06T04:47:43.205Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Plumbing every adapter repeats: which cledger version is running, and how\n3\t * far a source has been captured.\n4\t *\n5\t * The cursor design here is the one the claude-code adapter arrived at, made\n6\t * available to the rest rather than copied a fifth time. Three properties\n7\t * matter and none of them are obvious:\n8\t *\n9\t *  - **Absent is not zero.** `readCursor` returns null when no cursor exists,\n10\t *    which is a different fact from a cursor resting at 0. \"cledger has never\n11\t *    captured this session\" is what gates a catch-up sweep; a session\n12\t *    legitimately sitting at line 0 must not be mistaken for one cledger was\n13\t *    never asked to record.\n14\t *  - **`size` bounds the sweep.** A sweep asks \"did this file grow since we\n15\t *    last read it\" for every session in a project, and must answer without\n16\t *    parsing them. A cursor written by an older cledger has no `size`; that\n17\t *    reads as 0, so the file looks grown and is re-read once, which dedups.\n18\t *  - **The write is atomic.** A cursor has two writers — the session's own\n19\t *    hook, and any other session sweeping it — so it is written to a temp\n20\t *    file and renamed. A torn read parses as \"no cursor\", which would send a\n21\t *    sweep down the full-rescan path: safe, but the expensive kind of safe,\n22\t *    and reachable by two ordinary sessions running side by side.\n23\t *\n24\t * `field` is the JSON key the count is stored under. It differs per adapter\n25\t * (`lines` for the append-only transcript formats, `parts` for opencode,\n26\t * `messages` for gemini-cli) because the unit being counted differs, and\n27\t * because renaming it would silently reset every existing cursor on disk to\n28\t * zero — harmless, but a needless full rescan of every session.\n29\t *\n30\t * Cursors live under the repo's *common* git dir (see git.ts) so every\n31\t * worktree of a checkout shares one capture position.\n32\t */\n33\timport { readFileSync } from \"node:fs\";\n34\timport { mkdir, readFile, rename, writeFile } from \"node:fs/promises\";\n35\timport { join } from \"node:path\";\n36\timport type { RepoInfo } from \"../git.js\";\n37\t\n38\texport function packageVersion(): string {\n39\t  try {\n40\t    const pkg = JSON.parse(\n41\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n42\t    ) as { version?: string };\n43\t    return pkg.version ?? \"0.1.0\";\n44\t  } catch {\n45\t    return \"0.1.0\";\n46\t  }\n47\t}\n48\t\n49\t/** Session ids are used as filenames; keep them to a portable character set. */\n50\texport function sanitizeId(id: string): string {\n51\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n52\t}\n53\t\n54\tfunction cursorDir(repo: RepoInfo): string {\n55\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\");\n56\t}\n57\t\n58\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n59\t  return join(cursorDir(repo), `${sanitizeId(sessionId)}.json`);\n60\t}\n61\t\n62\t/**\n63\t * How far a source has been captured: the count consumed, and the byte size\n64\t * that count corresponded to. `size` is 0 for sources with no file behind\n65\t * them (opencode reads through `opencode export`), where staleness has to be\n66\t * decided some other way.\n67\t */\n68\texport interface Cursor {\n69\t  count: number;\n70\t  size: number;\n71\t}\n72\t\n73\texport async function readCursor(\n74\t  repo: RepoInfo,\n75\t  sessionId: string,\n76\t  field: string,\n77\t): Promise<Cursor | null> {\n78\t  try {\n79\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n80\t    const data = JSON.parse(raw) as Record<string, unknown>;\n81\t    const count = data[field];\n82\t    const size = data[\"size\"];\n83\t    return {\n84\t      count: typeof count === \"number\" ? count : 0,\n85\t      size: typeof size === \"number\" ? size : 0,\n86\t    };\n87\t  } catch {\n88\t    return null;\n89\t  }\n90\t}\n91\t\n92\texport async function writeCursor(\n93\t  repo: RepoInfo,\n94\t  sessionId: string,\n95\t  field: string,\n96\t  count: number,\n97\t  size = 0,\n98\t): Promise<void> {\n99\t  await mkdir(cursorDir(repo), { recursive: true });\n100\t  const path = cursorPath(repo, sessionId);\n101\t  const tmp = `${path}.${process.pid}.tmp`;\n102\t  await writeFile(tmp, JSON.stringify({ [field]: count, size }) + \"\\n\");\n103\t  await rename(tmp, path);\n104\t}\n105\t","tool_use_id":"toolu_012BLYddfGPBeDqzLUbELrDu","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","head":"0efe101ae3a794ff333e1c5b4122fdb71b3266fd","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:d10310cd-8144-4046-87b9-97bbb6ace18c","seq":67},"id":"ev1-d51ed8db589e8683935b3a810ad88242676d1c71ab2f6b51b2521578e5127322","kind":"conversation_turn","occurred_at":"2026-08-06T04:39:07.530Z","producer":{"session_id":"d10310cd-8144-4046-87b9-97bbb6ace18c","source":"claude-code","source_version":"2.1.223","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","entrypoint":"cli","gitBranch":"worktree-more-cli-adapters","isSidechain":false,"message":{"content":[{"content":"1\t/**\n2\t * Plumbing every adapter repeats: which cledger version is running, and how\n3\t * far a source has been captured.\n4\t *\n5\t * The cursor design here is the one the claude-code adapter arrived at, made\n6\t * available to the rest rather than copied a fifth time. Three properties\n7\t * matter and none of them are obvious:\n8\t *\n9\t *  - **Absent is not zero.** `readCursor` returns null when no cursor exists,\n10\t *    which is a different fact from a cursor 