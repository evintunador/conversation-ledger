ess\";\nimport { promisify } from \"node:util\";\nconst x = promisify(execFile);\n\nconst WT = process.argv[2];\nconst { captureQwenTranscript } = await import(join(WT, \"dist/adapters/qwen-code.js\"));\nconst { captureGeminiTranscript } = await import(join(WT, \"dist/adapters/gemini-cli.js\"));\nconst { readEvents } = await import(join(WT, \"dist/store.js\"));\nconst { findRepo } = await import(join(WT, \"dist/git.js\"));\n\nasync function newRepo() {\n  const repo = await mkdtemp(join(tmpdir(), \"cledger-e2e-\"));\n  await x(\"git\", [\"init\", \"-q\", repo]);\n  await x(\"git\", [\"-C\", repo, \"config\", \"user.email\", \"a@b.c\"]);\n  await x(\"git\", [\"-C\", repo, \"config\", \"user.name\", \"A\"]);\n  await writeFile(join(repo, \"f.txt\"), \"hi\\n\");\n  await x(\"git\", [\"-C\", repo, \"add\", \".\"]);\n  await x(\"git\", [\"-C\", repo, \"commit\", \"-qm\", \"init\"]);\n  return repo;\n}\n\nfunction summarize(events, label) {\n  const kinds = new Map();\n  for (const e of events) {\n    const c = e.content ?? {};\n    const sub = c.activity_type ?? c.state_type ?? c.injection_type ?? c.operation ?? \"\";\n    const key = `${e.kind}${sub ? \" / \" + sub : \"\"}  [actor=${e.actor?.type}]`;\n    kinds.set(key, (kinds.get(key) ?? 0) + 1);\n  }\n  console.log(`\\n=== ${label}: ${events.length} events ===`);\n  for (const [k, v] of [...kinds].sort((a, b) => b[1] - a[1])) console.log(String(v).padStart(4), k);\n}\n\n// --- qwen: every real local session ---\n{\n  const repo = await newRepo();\n  const info = await findRepo(repo);\n  const root = join(homedir(), \".qwen\", \"projects\");\n  let n = 0;\n  for (const proj of await readdir(root)) {\n    let files;\n    try { files = await readdir(join(root, proj, \"chats\")); } catch { continue; }\n    for (const f of files) {\n      if (!f.endsWith(\".jsonl\")) continue;\n      await captureQwenTranscript(join(root, proj, \"chats\", f), repo);\n      n++;\n    }\n  }\n  summarize(await readEvents(info), `qwen-code (${n} real session files)`);\n}\n\n// --- gemini: the real local session ---\n{\n  const repo = await newRepo();\n  const info = await findRepo(repo);\n  const dir = join(homedir(), \".gemini\", \"tmp\", \"sandbox\", \"chats\");\n  for (const f of await readdir(dir)) {\n    if (!f.endsWith(\".jsonl\")) continue;\n    await captureGeminiTranscript(join(dir, f), repo);\n  }\n  const events = await readEvents(info);\n  summarize(events, \"gemini-cli (real session)\");\n  for (const e of events) {\n    const t = (e.content?.blocks ?? []).map((b) => b.text ?? \"\").join(\"\").slice(0, 70).replace(/\\n/g, \"\\\\n\");\n    console.log(`  seq=${e.conversation?.seq} ${e.kind} actor=${e.actor?.type} :: ${t}`);\n  }\n}\n","filePath":"/Users/evintunador/.claude/jobs/8f1a9339/tmp/e2e.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"d9c6c8ff-1788-49ba-8cbf-6d8623699422","version":"2.1.223"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-06T04:47:43.208Z","schema":"conversation-ledger/v1"}
