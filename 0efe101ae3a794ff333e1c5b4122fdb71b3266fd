of the supported CLIs share this exact config format -- a top-level\n89\t * `hooks` object mapping an event name to an array of\n90\t * `{matcher?, hooks:[{type:\"command\", command, timeout}]}` definitions. That\n91\t * is not a coincidence: Gemini CLI ships a `gemini hooks migrate` command\n92\t * whose whole job is importing Claude Code's hook config, and Qwen Code\n93\t * inherited the same engine. Only the file path and the event names differ,\n94\t * so they are the parameters here.\n95\t */\n96\tasync function installJsonHooks(\n97\t  source: string,\n98\t  settingsPath: string,\n99\t  events: string[],\n100\t  options: { detach?: boolean } = {},\n101\t): Promise<string> {\n102\t  const settings: Record<string, unknown> = existsSync(settingsPath)\n103\t    ? (JSON.parse(await readFile(settingsPath, \"utf8\")) as Record<string, unknown>)\n104\t    : {};\n105\t  const command = (await hookCommand(source)) + (options.detach ? DETACH_SUFFIX : \"\");\n106\t  const hooks = (settings[\"hooks\"] ?? {}) as Record<string, ClaudeHookEntry[]>;\n107\t  let changed = false;\n108\t  for (const event of events) {\n109\t    if (!hasCledgerHook(hooks[event], `hook ${source}`)) {\n110\t      hooks[event] = [\n111\t        ...(hooks[event] ?? []),\n112\t        { hooks: [{ type: \"command\", command, timeout: 120 }] },\n113\t      ];\n114\t      changed = true;\n115\t    }\n116\t  }\n117\t  if (!changed) return `${source}: already installed (${settingsPath})`;\n118\t  settings[\"hooks\"] = hooks;\n119\t  await backup(settingsPath);\n120\t  await mkdir(dirname(settingsPath), { recursive: true });\n121\t  await writeFile(settingsPath, JSON.stringify(settings, null, 2) + \"\\n\");\n122\t  return `${source}: ${events.join(\" + \")} hooks added to ${settingsPath}`;\n123\t}\n124\t\n125\texport async function installClaudeCode(): Promise<string> {\n126\t  return installJsonHooks(\"claude-code\", join(homedir(), \".claude\", \"settings.json\"), [\n127\t    \"Stop\",\n128\t    \"SessionEnd\",\n129\t  ]);\n130\t}\n131\t\n132\t/**\n133\t * Gemini CLI names its lifecycle events differently from Claude Code:\n134\t * `AfterAgent` is the \"the agent finished responding\" event (Claude's `Stop`),\n135\t * and `SessionEnd` matches by name. Both are used, for the same reason\n136\t * claude-code installs both -- `AfterAgent` captures each turn as it lands, and\n137\t * `SessionEnd` is the backstop for a session that exits mid-turn.\n138\t */\n139\texport async function installGeminiCli(): Promise<string> {\n140\t  return installJsonHooks(\n141\t    \"gemini-cli\",\n142\t    join(homedir(), \".gemini\", \"settings.json\"),\n143\t    [\"AfterAgent\", \"SessionEnd\"],\n144\t    { detach: true },\n145\t  );\n146\t}\n147\t\n148\t/** Qwen Code forked Claude Code's event names verbatim, `Stop` included. */\n149\texport async function installQwenCode(): Promise<string> {\n150\t  return installJsonHooks(\n151\t    \"qwen-code\",\n152\t    join(homedir(), \".qwen\", \"settings.json\"),\n153\t    [\"Stop\", \"SessionEnd\"],\n154\t    { detach: true },\n155\t  );\n156\t}\n157\t\n158\texport async function installCodex(): Promise<string> {\n159\t  const path = join(homedir(), \".codex\", \"config.toml\");\n160\t  const existing = existsSync(path) ? await readFile(path, \"utf8\") : \"\";\n161\t  const additions: string[] = [];\n162\t  // Hooks are silently ignored unless features.hooks is enabled.\n163\t  if (!/^\\s*hooks\\s*=\\s*true/m.test(existing)) {\n164\t    if (existing.includes(\"[features]\")) {\n165\t      return (\n166\t        `codex: config has a [features] section without hooks = true — ` +\n167\t        `add it there manually, then re-run install (${path})`\n168\t      );\n169\t    }\n170\t    additions.push(\"[features]\", \"hooks = true\", \"\");\n171\t  }\n172\t  if (!existing.includes(\"hook codex\")) {\n173\t    const command = await hookCommand(\"codex\");\n174\t    additions.push(\n175\t      \"[[hooks.Stop]]\",\n176\t      \"[[hooks.Stop.hooks]]\",\n177\t      'type = \"command\"',\n178\t      `command = '${command}'`,\n179\t      \"timeout = 120\",\n180\t      \"\",\n181\t    );\n182\t  }\n183\t  if (additions.length === 0) return `codex: already installed (${path})`;\n184\t  // TOML array-of-tables headers reset table scope, so appending at EOF is\n185\t  // always valid regardless of what section the file currently ends in.\n186\t  const block =\n187\t    \"\\n# conversation-ledger capture (added by `cledger install codex`)\\n\" +\n188\t    additions.join(\"\\n\");\n189\t  await backup(path);\n190\t  await mkdir(dirname(path), { recursive: true });\n191\t  await writeFile(path, existing.replace(/\\n?$/, \"\\n\") + block);\n192\t  return (\n193\t    `codex: hook config added to ${path} — run /hooks once inside codex ` +\n194\t    `to trust the new hook (codex requires interactive approval)`\n195\t  );\n196\t}\n197\t\n198\t/**\n199\t * opencode has no shell-hook config the way claude-code and codex do; it\n200\t * loads JS plugins from `<config>/plugin/*.js` (verified: a bare\n201\t * `export const server` in that directory is picked up on every command).\n202\t * So installation writes a small plugin that listens for `session.idle` and\n203\t * spawns the normal `cledger hook opencode` entrypoint.\n204\t *\n205\t * Two deliberate choices in the generated plugin:\n206\t *\n207\t *  - The child is detached and unref'd rather than awaited. `session.idle`\n208\t *    fires inside the TUI's event loop; blocking it for the length of an\n209\t *    export plus a git-notes append would stall the interface, and detaching\n210\t *    also keeps capture alive when a one-shot `opencode run` exits straight\n211\t *    after going idle.\n212\t *  - The session id is read from `properties.sessionID`, confirmed against a\n213\t *    live `session.idle` from opencode 1.18.5. It is still passed as optional:\n214\t *    the hook falls back to the most recently updated session for the\n215\t *    directory if a future opencode renames the field, which keeps capture\n216\t *    working rather than silently stopping.\n217\t */\n218\texport async function installOpencode(): Promise<string> {\n219\t  const configHome = process.env[\"XDG_CONFIG_HOME\"] || join(homedir(), \".config\");\n220\t  const path = join(configHome, \"opencode\", \"plugin\", \"cledger.js\");\n221\t  const argv = await hookArgv(\"opencode\");\n222\t  const body = `// conversation-ledger capture for opencode.\n223\t// Written by \\`cledger install opencode\\`. Safe to delete to stop capturing.\n224\tconst COMMAND = ${JSON.stringify(argv)};\n225\t\n226\texport const server = async ({ directory, worktree }) => {\n227\t  const { spawn } = await import(\"node:child_process\");\n228\t  return {\n229\t    event: async ({ event }) => {\n230\t      if (!event || event.type !== \"session.idle\") return;\n231\t      const sessionID = (event.properties && event.properties.sessionID) || undefined;\n232\t      const cwd = worktree || directory || process.cwd();\n233\t      let child;\n234\t      try {\n235\t        child = spawn(COMMAND[0], COMMAND.slice(1), {\n236\t          cwd,\n237\t          detached: true,\n238\t          // stderr is discarded, not inherited: this child outlives the\n239\t          // plugin and would otherwise write into opencode's TUI while it is\n240\t          // drawing. Run \\`cledger capture opencode --all\\` to see the\n241\t          // capture's own output, including format-drift warnings.\n242\t          stdio: [\"pipe\", \"ignore\", \"ignore\"],\n243\t        });\n244\t      } catch {\n245\t        return;\n246\t      }\n247\t      child.on(\"error\", () => {});\n248\t      try {\n249\t        child.stdin.end(\n250\t          JSON.stringify({ session_id: sessionID, cwd, hook_event_name: \"session.idle\" }),\n251\t        );\n252\t      } catch {\n253\t        /* child already gone */\n254\t      }\n255\t      child.unref();\n256\t    },\n257\t  };\n258\t};\n259\t`;\n260\t  if (existsSync(path) && (await readFile(path, \"utf8\")) === body) {\n261\t    return `opencode: already installed (${path})`;\n262\t  }\n263\t  await backup(path);\n264\t  await mkdir(dirname(path), { recursive: true });\n265\t  await writeFile(path, body);\n266\t  return `opencode: session.idle capture plugin written to ${path}`;\n267\t}\n268\t\n269\t/** Every adapter `cledger install` knows how to wire up, in listing order. */\n270\texport const INSTALLABLE_ADAPTERS: Record<string, () => Promise<string>> = {\n271\t  \"claude-code\": installClaudeCode,\n272\t  codex: installCodex,\n273\t  opencode: installOpencode,\n274\t  \"gemini-cli\": installGeminiCli,\n275\t  \"qwen-code\": installQwenCode,\n276\t};\n277\t\n278\texport async function installAdapters(which: string): Promise<void> {\n279\t  const names =\n280\t    which === \"all\"\n281\t      ? Object.keys(INSTALLABLE_ADAPTERS)\n282\t      : which in INSTALLABLE_ADAPTERS\n283\t        ? [which]\n284\t        : [];\n285\t  const results: string[] = [];\n286\t  for (const name of names) results.push(await INSTALLABLE_ADAPTERS[name]!());\n287\t  if (results.length === 0) {\n288\t    process.stderr.write(\n289\t      `unknown adapter: ${which} (expected ${Object.keys(INSTALLABLE_ADAPTERS).join(\"|\")}|all)\\n`,\n290\t    );\n291\t    process.exit(2);\n292\t  }\n293\t  for (const line of results) process.stdout.write(line + \"\\n\");\n294\t  if (!(await hasAuthorIdentity())) {\n295\t    process.stderr.write(\n296\t      \"cledger: warning — git has no author identity configured, so your conversation turns \" +\n297\t        \"will be recorded unattributed (no actor.id). Fix with:\\n\" +\n298\t        '  git config --global user.email \"you@example.com\"\\n' +\n299\t        '  git config --global user.name \"Your Name\"\\n',\n300\t    );\n301\t  }\n302\t}\n303\t","tool_use_id":"toolu_01YHynCEjUFkbpJ885c9NTk6","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/co