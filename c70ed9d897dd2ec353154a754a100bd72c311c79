encode | python3 /tmp/cledger-inspect.py\n\nShows the things `cledger log` truncates away: block types, actor identity,\nand the producer provenance fields.\n\"\"\"\nimport sys, json\n\nrows = []\nfor line in sys.stdin:\n    line = line.strip()\n    if not line:\n        continue\n    e = json.loads(line)\n    c = e.get(\"content\") or {}\n    blocks = c.get(\"blocks\") if isinstance(c, dict) else None\n    btypes = [b.get(\"type\") for b in blocks if isinstance(b, dict)] if isinstance(blocks, list) else []\n    p, a = e.get(\"producer\", {}), e.get(\"actor\", {})\n    rows.append((\n        e.get(\"conversation\", {}).get(\"seq\"),\n        e.get(\"kind\"),\n        a.get(\"type\"),\n        a.get(\"id\") or \"-\",\n        c.get(\"role\") if isinstance(c, dict) else \"-\",\n        \"+\".join(t for t in btypes if t) or \"-\",\n        p.get(\"model\") or \"-\",\n        p.get(\"provider\") or \"-\",\n        p.get(\"source_version\") or \"-\",\n    ))\n\nif not rows:\n    sys.exit(\"no events on stdin\")\n\nrows.sort(key=lambda r: (r[0] is None, r[0]))\nhdr = (\"seq\", \"kind\", \"actor\", \"actor.id\", \"role\", \"blocks\", \"model\", \"provider\", \"ver\")\nw = [max(len(str(r[i])) for r in rows + [hdr]) for i in range(len(hdr))]\nfmt = \"  \".join(\"{:<%d}\" % x for x in w)\nprint(fmt.format(*hdr))\nprint(\"-\" * (sum(w) + 2 * len(w)))\nfor r in rows:\n    print(fmt.format(*[str(x) for x in r]))\n","filePath":"/tmp/cledger-inspect.py","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"32503c4c-7218-41e4-a89d-c6c050a286a7","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-03T00:35:24.528Z","schema":"conversation-ledger/v1"}
