{"content":{"blocks":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { mkdtemp, open, readFile, rm } from \"node:fs/promises\";\n26\timport { tmpdir } from \"node:os\";\n27\timport { join } from \"node:path\";\n28\timport { findRepo, gitUserIdentity, type GitUserIdentity } from \"../git.js\";\n29\timport { appendEvents } from \"../store.js\";\n30\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n31\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  mergeCaptureResult,\n35\t  unrecognizedDraft,\n36\t  warnUnrecognized,\n37\t  type CaptureResult,\n38\t} from \"./drift.js\";\n39\timport { activityDraft, type RecordContext } from \"./records.js\";\n40\t\n41\tconst RAW_FORMAT = \"opencode-export-json/1\";\n42\t\n43\tconst CURSOR_FIELD = \"parts\";\n44\t\n45\t/**\n46\t * Part types carrying visible conversation content.\n47\t *\n48\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n49\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n50\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n51\t * stores reasoning as plain `text`. So it converts to an ordinary\n52\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n53\t * thinking blocks do — no opacity marker, nothing withheld.\n54\t */\n55\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n56\t\n57\t/**\n58\t * Part types recorded as `activity` rather than as turns.\n59\t *\n60\t * `step-start` and `step-finish` carry no prose, which is why they were once\n61\t * dropped, but they carry the two things nothing else in the export does: the\n62\t * git snapshot hash opencode took at each step boundary, and the token counts,\n63\t * cost, and finish reason for the step. The snapshot hash in particular is a\n64\t * real handle on intermediate repository state — the closest opencode analogue\n65\t * to Claude Code's file history.\n66\t *\n67\t * `patch` points into opencode's private snapshot store, and the diff it names\n68\t * is usually already in git. It is recorded anyway, for the same reason the\n69\t * file-history pointers are: \"usually already in git\" is not \"always\", and a\n70\t * pointer with provenance beats a hole.\n71\t *\n72\t * Part types opencode's binary references but no session on hand exercises —\n73\t * `file`, `agent`, `snapshot`, `todo` — are still left off every list here.\n74\t * Guessing at their shape would discard content on the first session that used\n75\t * one; leaving them out routes them through the drift path, which preserves\n76\t * them raw, warns, and lets `cledger renormalize` upgrade them later.\n77\t */\n78\tconst ACTIVITY_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n79\t\n80\t/**\n81\t * Tool-call states that will never change again. A `pending`/`running` part\n82\t * is still being written; capturing it would bake a half-finished tool call\n83\t * into an immutable event id. The capture loop skips unsettled parts *and*\n84\t * holds the cursor back at the first one, so the finished version is picked\n85\t * up on the next capture rather than being skipped forever.\n86\t */\n87\tconst SETTLED_TOOL_STATUSES = new Set([\"completed\", \"error\"]);\n88\t\n89\t/** Payload the installed opencode plugin sends on stdin (see install.ts). */\n90\tinterface OpencodeHookPayload {\n91\t  session_id?: string;\n92\t  cwd?: string;\n93\t  hook_event_name?: string;\n94\t}\n95\t\n96\tinterface OpencodeSessionInfo {\n97\t  id?: string;\n98\t  /** Set on subagent sessions; those are skipped (see captureOpencodeExport). */\n99\t  parentID?: string;\n100\t  directory?: string;\n101\t  title?: string;\n102\t  /** opencode's own CLI version, e.g. \"1.18.5\". */\n103\t  version?: string;\n104\t  time?: { created?: number; updated?: number };\n105\t}\n106\t\n107\tinterface OpencodeMessageInfo {\n108\t  id?: string;\n109\t  sessionID?: string;\n110\t  role?: string;\n111\t  /** Agent persona, e.g. \"build\" / \"plan\". */\n112\t  agent?: string;\n113\t  mode?: string;\n114\t  /** Assistant messages state the model flat; user messages nest it. */\n115\t  modelID?: string;\n116\t  providerID?: string;\n117\t  model?: { modelID?: string; providerID?: string };\n118\t  time?: { created?: number; completed?: number };\n119\t}\n120\t\n121\tinterface OpencodePart {\n122\t  id?: string;\n123\t  type?: string;\n124\t  messageID?: string;\n125\t  sessionID?: string;\n126\t  text?: string;\n127\t  tool?: string;\n128\t  callID?: string;\n129\t  /** `step-start`/`step-finish`: opencode's git snapshot hash at the boundary. */\n130\t  snapshot?: string;\n131\t  /** `step-finish`: why the step ended, e.g. \"tool-calls\" / \"stop\". */\n132\t  reason?: string;\n133\t  /** `step-finish`: token accounting for the step. */\n134\t  tokens?: Record<string, unknown>;\n135\t  cost?: number;\n136\t  state?: {\n137\t    status?: string;\n138\t    input?: unknown;\n139\t    output?: unknown;\n140\t    error?: unknown;\n141\t    time?: { start?: number; end?: number };\n142\t  };\n143\t  time?: { start?: number; end?: number };\n144\t}\n145\t\n146\tinterface OpencodeMessage {\n147\t  info?: OpencodeMessageInfo;\n148\t  parts?: OpencodePart[];\n149\t}\n150\t\n151\texport interface OpencodeExport {\n152\t  info?: OpencodeSessionInfo;\n153\t  messages?: OpencodeMessage[];\n154\t}\n155\t\n156\t/** What `opencode session list --format json` returns, per row. */\n157\tinterface OpencodeSessionRow {\n158\t  id?: string;\n159\t  title?: string;\n160\t  directory?: string;\n161\t  updated?: number;\n162\t}\n163\t\n164\t/** One part, paired with the message that owns it and its session position. */\n165\tinterface FlatPart {\n166\t  info: OpencodeMessageInfo;\n167\t  part: OpencodePart;\n168\t  seq: number;\n169\t}\n170\t\n171\t/** opencode stores times as epoch milliseconds; the ledger wants ISO 8601. */\n172\tfunction isoFromMs(ms: unknown): string | null {\n173\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n174\t  const date = new Date(ms);\n175\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n176\t}\n177\t\n178\t/**\n179\t * Run an opencode subcommand and return its stdout.\n180\t *\n181\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n182\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n183\t * silently lost — a large session's export still parses as JSON right up to\n184\t * the truncation point in some cases, which would quietly capture a partial\n185\t * conversation. Writing to a real file descriptor returns the full output.\n186\t *\n187\t * Returns null when opencode is not installed or the command fails; every\n188\t * caller treats that as \"nothing to capture\" rather than an error, so a\n189\t * missing opencode never breaks a hook.\n190\t */\n191\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n192\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n193\t  const path = join(dir, \"out.json\");\n194\t  try {\n195\t    const handle = await open(path, \"w\");\n196\t    try {\n197\t      const code = await new Promise<number | null>((resolve, reject) => {\n198\t        const child = spawn(\"opencode\", args, {\n199\t          cwd,\n200\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n201\t        });\n202\t        child.on(\"error\", reject);\n203\t        child.on(\"close\", resolve);\n204\t      });\n205\t      if (code !== 0) return null;\n206\t    } finally {\n207\t      await handle.close();\n208\t    }\n209\t    return await readFile(path, \"utf8\");\n210\t  } catch {\n211\t    return null;\n212\t  } finally {\n213\t    await rm(dir, { recursive: true, force: true });\n214\t  }\n215\t}\n216\t\n217\t/**\n218\t * Export one session as JSON. `--pure` skips external plugins, which matters\n219\t * because the capture this call belongs to was very likely triggered *by* an\n220\t * opencode plugin — loading that plugin again inside the export would invite\n221\t * re-entrancy.\n222\t */\n223\texport async function exportOpencodeSession(\n224\t  sessionId: string,\n225\t  cwd: string,\n226\t): Promise<OpencodeExport | null> {\n227\t  const stdout = await runOpencode([\"export\", \"--pure\", sessionId], cwd);\n228\t  if (!stdout) return null;\n229\t  try {\n230\t    return JSON.parse(stdout) as OpencodeExport;\n231\t  } catch {\n232\t    return null;\n233\t  }\n234\t}\n235\t\n236\t/**\n237\t * List opencode sessions. opencode scopes this to the project containing\n238\t * `cwd`, which is exactly the scoping a repo-local capture wants — a sweep\n239\t * never reaches into conversations that belong to other checkouts.\n240\t */\n241\texport async function listOpencodeSessions(cwd: string): Promise<OpencodeSessionRow[]> {\n242\t  const stdout = await runOpencode([\"session\", \"list\", \"--pure\", \"--format\", \"json\"], cwd);\n243\t  if (!stdout) return [];\n244\t  try {\n245\t    const parsed = JSON.parse(stdout) as unknown;\n246\t    return Array.isArray(parsed) ? (parsed as OpencodeSessionRow[]) : [];\n247\t  } catch {\n248\t    return [];\n249\t  }\n250\t}\n251\t\n252\t/**\n253\t * The agent facts a message states about itself. opencode labels every\n254\t * message with its model and provider — including *user* messages, which\n255\t * carry the model selected to answer them. That is a genuine difference from\n256\t * claude-code, where a user line states no model and none is invented; here\n257\t * the source does state it, so it is recorded, per `Producer.model`'s rule of\n258\t * \"set only when the source states it for this turn\".\n259\t *\n260\t * `providerID` is opencode's *config* provider key (e.g. \"ds4\", \"local-mlx\"),\n261\t * which the user names themselves rather than a canonical vendor name. It is\n262\t * passed through verbatim anyway — the schema asks for the provider as the\n263\t * source names it, and rewriting it would be interpretation.\n264\t */\n265\tfunction agentContext(info: OpencodeMessageInfo, sessionVersion?: string): ProducerAgentContext {\n266\t  const agent: ProducerAgentContext = {};\n267\t  if (sessionVersion) agent.source_version = sessionVersion;\n268\t  const model = info.modelID ?? info.model?.modelID;\n269\t  if (typeof model === \"string\" && model) agent.model = model;\n270\t  const provider = info.providerID ?? info.model?.providerID;\n271\t  if (typeof provider === \"string\" && provider) agent.provider = provider;\n272\t  return agent;\n273\t}\n274\t\n275\t/**\n276\t * When this part happened: its own start time, else the message's creation\n277\t * time, else the session base time. Every step is a pure function of the\n278\t * export, so rescans and re-normalization land on the same value — which\n279\t * matters because `occurred_at` is part of event identity.\n280\t */\n281\tfunction partTime(info: OpencodeMessageInfo, part: OpencodePart, baseTime: string): string {\n282\t  return (\n283\t    isoFromMs(part.time?.start) ??\n284\t    isoFromMs(part.state?.time?.start) ??\n285\t    isoFromMs(info.time?.created) ??\n286\t    baseTime\n287\t  );\n288\t}\n289\t\n290\t/** Flatten messages into parts, numbering every part in export order. */\n291\tfunction flattenParts(data: OpencodeExport): FlatPart[] {\n292\t  const flat: FlatPart[] = [];\n293\t  let seq = 0;\n294\t  for (const message of data.messages ?? []) {\n295\t    const info = message.info ?? {};\n296\t    for (const part of message.parts ?? []) {\n297\t      flat.push({ info, part, seq });\n298\t      seq++;\n299\t    }\n300\t  }\n301\t  return flat;\n302\t}\n303\t\n304\t/**\n305\t * `raw.data` for one part. The part alone would be lossy: it carries ids but\n306\t * no role, model, or timing for the message that owns it, so an exported\n307\t * event could not be replayed without the rest of the session. Pairing it\n308\t * with its message info keeps every event independently lossless, at the cost\n309\t * of repeating a small object across the parts of one message.\n310\t */\n311\tfunction rawData(info: OpencodeMessageInfo, part: OpencodePart): unknown {\n312\t  return { info, part };\n313\t}\n314\t\n315\t/**\n316\t * True when a part carries nothing a reader would see. Empty text and\n317\t * reasoning parts do occur (a step that produced only a tool call, say), and\n318\t * emitting an event whose only block is an empty string adds a line to\n319\t * `cledger log` that says nothing.\n320\t */\n321\tfunction isEmptyText(part: OpencodePart): boolean {\n322\t  return typeof part.text !== \"string\" || part.text.trim() === \"\";\n323\t}\n324\t\n325\t/** Whether a tool part has reached a state that will not change again. */\n326\tfunction isSettledTool(part: OpencodePart): boolean {\n327\t  const status = part.state?.status;\n328\t  return typeof status === \"string\" && SETTLED_TOOL_STATUSES.has(status);\n329\t}\n330\t\n331\tfunction convertPart(\n332\t  info: OpencodeMessageInfo,\n333\t  part: OpencodePart,\n334\t  seq: number,\n335\t  sessionId: string,\n336\t  baseTime: string,\n337\t  version: string,\n338\t  identity: GitUserIdentity,\n339\t  agent: ProducerAgentContext,\n340\t  parentId?: string,\n341\t): EventDraft | null {\n342\t  const type = part.type;\n343\t  if (typeof type !== \"string\" || !CONVERTIBLE_PART_TYPES.has(type)) return null;\n344\t\n345\t  const role = typeof info.role === \"string\" ? info.role : \"assistant\";\n346\t  const isHuman = role === \"user\" && type === \"text\";\n347\t\n348\t  const actor: Actor = isHuman ? { type: \"human\" } : { type: \"agent\" };\n349\t  if (isHuman) {\n350\t    if (identity.email) actor.id = identity.email;\n351\t    if (identity.name) actor.display = identity.name;\n352\t  } else if (agent.model) {\n353\t    actor.id = agent.model;\n354\t  }\n355\t\n356\t  let blocks: unknown[];\n357\t  if (type === \"text\") {\n358\t    if (isEmptyText(part)) return null;\n359\t    blocks = [{ type: \"text\", text: part.text }];\n360\t  } else if (type === \"reasoning\") {\n361\t    if (isEmptyText(part)) return null;\n362\t    blocks = [{ type: \"thinking\", text: part.text }];\n363\t  } else {\n364\t    // tool: opencode keeps the call and its result on one part, so both\n365\t    // blocks belong to one event. The actor stays `agent` rather than the\n366\t    // `system` other adapters give a standalone tool result — opencode does\n367\t    // not model the result as a separate speaker, and splitting it here\n368\t    // would be inventing structure the source does not have.\n369\t    if (!isSettledTool(part)) return null;\n370\t    const call: Record<string, unknown> = { type: \"tool_use\" };\n371\t    if (typeof part.tool === \"string\") call[\"name\"] = part.tool;\n372\t    if (part.state?.input !== undefined) call[\"input\"] = part.state.input;\n373\t    if (typeof part.callID === \"string\") call[\"id\"] = part.callID;\n374\t    const result: Record<string, unknown> = { type: \"tool_result\" };\n375\t    if (typeof part.callID === \"string\") result[\"tool_use_id\"] = part.callID;\n376\t    const failed = part.state?.status === \"error\";\n377\t    result[\"content\"] = failed ? (part.state?.error ?? part.state?.output) : part.state?.output;\n378\t    if (failed) result[\"is_error\"] = true;\n379\t    blocks = [call, result];\n380\t  }\n381\t\n382\t  const content: Record<string, unknown> = { role };\n383\t  // opencode's agent persona (\"build\", \"plan\", ...) has no home in `Producer`,\n384\t  // which describes the model and the capture tool, not which persona the\n385\t  // user was driving. It goes in `content` next to `role`, the way codex's\n386\t  // agent_message author/recipient do.\n387\t  if (typeof info.agent === \"string\" && info.agent) content[\"agent\"] = info.agent;\n388\t  content[\"blocks\"] = blocks;\n389\t\n390\t  const conversation = conversationFor(sessionId, parentId);\n391\t  return {\n392\t    kind: \"conversation_turn\",\n393\t    occurred_at: partTime(info, part, baseTime),\n394\t    actor,\n395\t    producer: { tool: \"cledger\", version, source: \"opencode\", session_id: sessionId, ...agent },\n396\t    conversation: {\n397\t      id: conversation.id,\n398\t      seq,\n399\t      ...(conversation.parent ? { parent: conversation.parent } : {}),\n400\t    },\n401\t    content,\n402\t    raw: { format: RAW_FORMAT, data: rawData(info, part) },\n403\t  };\n404\t}\n405\t\n406\t/**\n407\t * Which conversation a session's parts belong to. opencode gives a subagent\n408\t * its own session id, so a subagent session is already its own conversation —\n409\t * all it was missing is the pointer back to the session that spawned it, and\n410\t * a capture path that did not return early on sight of `parentID`.\n411\t */\n412\tfunction conversationFor(\n413\t  sessionId: string,\n414\t  parentId: string | undefined,\n415\t): { id: string; parent?: string } {\n416\t  const id = `opencode:${sessionId}`;\n417\t  return parentId ? { id, parent: `opencode:${parentId}` } : { id };\n418\t}\n419\t\n420\t/**\n421\t * The `RecordContext` a non-turn part converts under. Shared by the capture\n422\t * loop and the re-normalization hook so both mint the same event identity.\n423\t */\n424\tfunction recordContext(\n425\t  occurredAt: string,\n426\t  seq: number,\n427\t  sessionId: string,\n428\t  parentId: string | undefined,\n429\t  version: string,\n430\t  agent: ProducerAgentContext,\n431\t): RecordContext {\n432\t  const conversation = conversationFor(sessionId, parentId);\n433\t  return {\n434\t    occurredAt,\n435\t    source: \"opencode\",\n436\t    sessionId,\n437\t    seq,\n438\t    version,\n439\t    rawFormat: RAW_FORMAT,\n440\t    conversationId: conversation.id,\n441\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n442\t    agent,\n443\t  };\n444\t}\n445\t\n446\t/**\n447\t * Convert a part that is not a turn into the record it deserves, or null when\n448\t * the part type is unknown (the caller routes it to the drift path).\n449\t *\n450\t * The actor is `agent`: a step boundary or a patch is the model's own work\n451\t * being recorded, not the harness reporting on itself.\n452\t */\n453\tfunction convertRecordPart(part: OpencodePart, ctx: RecordContext, info: OpencodeMessageInfo): EventDraft | null {\n454\t  const type = part.type;\n455\t  if (typeof type !== \"string\" || !ACTIVITY_PART_TYPES.has(type)) return null;\n456\t  const { type: _type, ...fields } = part as Record<string, unknown>;\n457\t  return activityDraft(ctx, type, fields, rawData(info, part), \"agent\");\n458\t}\n459\t\n460\t/** Raw-only preservation event for an unrecognized opencode part (see drift.ts). */\n461\tfunction preserve(\n462\t  typeKey: string,\n463\t  info: OpencodeMessageInfo,\n464\t  part: OpencodePart,\n465\t  occurredAt: string,\n466\t  seq: number,\n467\t  sessionId: string,\n468\t  version: string,\n469\t  agent: ProducerAgentContext,\n470\t  parentId?: string,\n471\t): EventDraft {\n472\t  const conversation = conversationFor(sessionId, parentId);\n473\t  return unrecognizedDraft({\n474\t    typeKey,\n475\t    line: rawData(info, part),\n476\t    occurredAt,\n477\t    source: \"opencode\",\n478\t    sessionId,\n479\t    seq,\n480\t    version,\n481\t    rawFormat: RAW_FORMAT,\n482\t    conversationId: conversation.id,\n483\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n484\t    agent: { ...agent },\n485\t  });\n486\t}\n487\t\n488\t/**\n489\t * Re-normalization hook (see renormalize.ts): turn a preserved `unrecognized`\n490\t * event back into the `conversation_turn` a live capture would now produce.\n491\t *\n492\t * Id fidelity works the same way as in the claude-code and codex twins, and\n493\t * the `{info, part}` shape stored in `raw.data` is what makes it possible\n494\t * here: the message info a part needs for its role, model and time fallback\n495\t * travels with the part instead of living in a session header this path can\n496\t * no longer see. `baseTime` falls back to the preserved event's own\n497\t * `occurred_at`, which is the value the preservation path computed — so a\n498\t * part with no time of its own reconstructs to the same instant, and\n499\t * therefore the same id.\n500\t */\n501\texport function renormalizeUnrecognized(\n502\t  event: EvidenceEvent,\n503\t  identity: GitUserIdentity,\n504\t): EventDraft | null {\n505\t  if (!event.raw || event.conversation === undefined) return null;\n506\t  const stored = event.raw.data as { info?: OpencodeMessageInfo; part?: OpencodePart } | null;\n507\t  if (!stored || !stored.part) return null;\n508\t  const info = stored.info ?? {};\n509\t  const agent: ProducerAgentContext = {};\n510\t  if (event.producer.source_version) agent.source_version = event.producer.source_version;\n511\t  if (event.producer.model) agent.model = event.producer.model;\n512\t  if (event.producer.provider) agent.provider = event.producer.provider;\n513\t  const sessionId = event.producer.session_id ?? \"\";\n514\t  const version = packageVersion();\n515\t  // The parent session id is not in `raw.data` — it lives on the session\n516\t  // export, which this path cannot see. It is read back off the preserved\n517\t  // event's own `conversation.parent`, where the capture that preserved the\n518\t  // part recorded it, and stripped of its `opencode:` namespace so\n519\t  // `conversationFor` re-derives the identical ref.\n520\t  const parentId = event.conversation.parent?.replace(/^opencode:/, \"\");\n521\t  const turn = convertPart(\n522\t    info,\n523\t    stored.part,\n524\t    event.conversation.seq,\n525\t    sessionId,\n526\t    event.occurred_at,\n527\t    version,\n528\t    identity,\n529\t    agent,\n530\t    parentId,\n531\t  );\n532\t  if (turn) return turn;\n533\t  return convertRecordPart(\n534\t    stored.part,\n535\t    recordContext(event.occurred_at, event.conversation.seq, sessionId, parentId, version, agent),\n536\t    info,\n537\t  );\n538\t}\n539\t\n540\t/**\n541\t * Capture a session from an already-parsed export. Split out from the\n542\t * subprocess plumbing so tests (and offline backfill from a saved export\n543\t * file) exercise the conversion without needing opencode installed.\n544\t */\n545\texport async function captureOpencodeExport(\n546\t  data: OpencodeExport,\n547\t  cwd: string,\n548\t): Promise<CaptureResult> {\n549\t  const repo = await findRepo(cwd);\n550\t  if (!repo) throw new Error(\"not inside a git repository\");\n551\t\n552\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n553\t\n554\t  const sessionId = data.info?.id;\n555\t  if (typeof sessionId !== \"string\" || !sessionId) return result;\n556\t\n557\t  // Subagent sessions are captured, as their own conversation pointing back\n558\t  // at the parent (see `conversationFor`). They used to be skipped for want of\n559\t  // a way to express that relation; `ConversationRef.parent` is that way. What\n560\t  // was being lost was every internal step of every subagent — the parent's\n561\t  // `task` tool part keeps only the child's final answer, so the reasoning\n562\t  // that produced it, and every tool call behind it, went unrecorded.\n563\t  const parentId =\n564\t    typeof data.info?.parentID === \"string\" && data.info.parentID ? data.info.parentID : undefined;\n565\t\n566\t  const flat = flattenParts(data);\n567\t  let cursor = (await readCursor(repo, sessionId, CURSOR_FIELD))?.count ?? 0;\n568\t  // A session shorter than the cursor means parts were removed (a revert, or\n569\t  // a deleted message). Rescan from the start; identical events dedup.\n570\t  if (cursor > flat.length) cursor = 0;\n571\t\n572\t  const baseTime =\n573\t    isoFromMs(data.info?.time?.created) ?? isoFromMs(data.info?.time?.updated) ?? new Date().toISOString();\n574\t  const version = packageVersion();\n575\t  const identity = await gitUserIdentity(repo);\n576\t  const sessionVersion = typeof data.info?.version === \"string\" ? data.info.version : undefined;\n577\t\n578\t  // Where the cursor stops. An unsettled tool call holds it back so the\n579\t  // finished part is seen again next time; parts after it still convert now\n580\t  // and simply dedup on the rescan.\n581\t  let nextCursor = flat.length;\n582\t\n583\t  const drafts: EventDraft[] = [];\n584\t  for (let i = cursor; i < flat.length; i++) {\n585\t    const { info, part, seq } = flat[i]!;\n586\t    const type = typeof part.type === \"string\" ? part.type : \"(untyped)\";\n587\t    const agent = agentContext(info, sessionVersion);\n588\t\n589\t    if (!CONVERTIBLE_PART_TYPES.has(type)) {\n590\t      const occurredAt = partTime(info, part, baseTime);\n591\t      const ctx = recordContext(occurredAt, seq, sessionId, parentId, version, agent);\n592\t      const record = convertRecordPart(part, ctx, info);\n593\t      if (record) {\n594\t        drafts.push(record);\n595\t        continue;\n596\t      }\n597\t      countUnrecognized(result.unrecognized, type);\n598\t      drafts.push(preserve(type, info, part, occurredAt, seq, sessionId, version, agent, parentId));\n599\t      continue;\n600\t    }\n601\t\n602\t    if (type === \"tool\" && !isSettledTool(part)) {\n603\t      nextCursor = Math.min(nextCursor, i);\n604\t      continue;\n605\t    }\n606\t\n607\t    const draft = convertPart(info, part, seq, sessionId, baseTime, version, identity, agent, parentId);\n608\t    if (draft) drafts.push(draft);\n609\t  }\n610\t\n611\t  if (drafts.length > 0) {\n612\t    const appendResult = await appendEvents(repo, drafts);\n613\t    result.appended = appendResult.appended.length;\n614\t    result.deduped = appendResult.deduped;\n615\t  }\n616\t  await writeCursor(repo, sessionId, CURSOR_FIELD, nextCursor);\n617\t  process.stderr.write(`cledger: opencode +${result.appended} events (${result.deduped} deduped)\\n`);\n618\t  warnUnrecognized(\"opencode\", result.unrecognized);\n619\t  return result;\n620\t}\n621\t\n622\t/**\n623\t * The subagent sessions a session spawned, read off its own `task` tool\n624\t * parts: opencode records the child's session id in the part's\n625\t * `state.metadata.sessionId`.\n626\t *\n627\t * This is how subagent conversations are found at all. `opencode session list`\n628\t * returns only top-level sessions, so a child is reachable only from the\n629\t * parent that spawned it — which means a capture that stopped at the parent\n630\t * could never have found them, no matter how the ledger modelled the relation.\n631\t */\n632\tfunction childSessionIds(data: OpencodeExport): string[] {\n633\t  const ids: string[] = [];\n634\t  for (const message of data.messages ?? []) {\n635\t    for (const part of message.parts ?? []) {\n636\t      if (part.type !== \"tool\" || part.tool !== \"task\") continue;\n637\t      const metadata = (part.state as { metadata?: { sessionId?: unknown } } | undefined)?.metadata;\n638\t      const id = metadata?.sessionId;\n639\t      if (typeof id === \"string\" && id && id !== data.info?.id) ids.push(id);\n640\t    }\n641\t  }\n642\t  return ids;\n643\t}\n644\t\n645\t/**\n646\t * Export one session via the opencode CLI, then capture it — and every\n647\t * subagent session it spawned, depth-first.\n648\t *\n649\t * `visited` guards the recursion. opencode's task metadata is not guaranteed\n650\t * acyclic by anything the ledger can see, and an export that named its own\n651\t * ancestor would otherwise loop forever inside a capture hook.\n652\t */\n653\texport async function captureOpencodeSession(\n654\t  sessionId: string,\n655\t  cwd: string,\n656\t  visited: Set<string> = new Set(),\n657\t): Promise<CaptureResult> {\n658\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n659\t  if (visited.has(sessionId)) return result;\n660\t  visited.add(sessionId);\n661\t\n662\t  const data = await exportOpencodeSession(sessionId, cwd);\n663\t  if (!data) return result;\n664\t  mergeCaptureResult(result, await captureOpencodeExport(data, cwd));\n665\t  for (const child of childSessionIds(data)) {\n666\t    mergeCaptureResult(result, await captureOpencodeSession(child, cwd, visited));\n667\t  }\n668\t  return result;\n669\t}\n670\t\n671\t/** Capture a session from a saved `opencode export` JSON file (backfill). */\n672\texport async function captureOpencodeExportFile(\n673\t  path: string,\n674\t  cwd: string,\n675\t): Promise<CaptureResult> {\n676\t  const raw = await readFile(path, \"utf8\");\n677\t  return captureOpencodeExport(JSON.parse(raw) as OpencodeExport, cwd);\n678\t}\n679\t\n680\t/**\n681\t * Capture every session opencode associates with `cwd`'s project. Used by\n682\t * `cledger capture opencode --all`, and as the hook's fallback when the\n683\t * plugin could not tell us which session went idle.\n684\t */\n685\texport async function captureOpencodeAll(\n686\t  cwd: string,\n687\t  limit?: number,\n688\t): Promise<CaptureResult> {\n689\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n690\t  const sessions = await listOpencodeSessions(cwd);\n691\t  const ordered = [...sessions].sort((a, b) => (b.updated ?? 0) - (a.updated ?? 0));\n692\t  const selected = typeof limit === \"number\" ? ordered.slice(0, limit) : ordered;\n693\t  // One `visited` set across the sweep: two top-level sessions can name the\n694\t  // same subagent session, and it should be exported once.\n695\t  const visited = new Set<string>();\n696\t  for (const session of selected) {\n697\t    if (typeof session.id !== \"string\" || !session.id) continue;\n698\t    mergeCaptureResult(total, await captureOpencodeSession(session.id, cwd, visited));\n699\t  }\n700\t  return total;\n701\t}\n702\t\n703\t/**\n704\t * Hook entrypoint, invoked by the plugin `cledger install opencode` writes.\n705\t *\n706\t * `session_id` is optional on purpose. The plugin reads it out of opencode's\n707\t * `session.idle` event, whose exact payload shape is not something cledger\n708\t * can pin down across opencode versions; when it is missing, capture falls\n709\t * back to the most recently updated session for this project, which is the\n710\t * session that just went idle in every realistic case.\n711\t */\n712\texport async function runOpencodeHook(stdinJson: string): Promise<void> {\n713\t  try {\n714\t    const payload = JSON.parse(stdinJson) as OpencodeHookPayload;\n715\t    const cwd = payload.cwd ?? process.cwd();\n716\t    const repo = await findRepo(cwd);\n717\t    if (!repo) return; // hooks must never break the user's session outside a repo\n718\t    if (payload.session_id) {\n719\t      await captureOpencodeSession(payload.session_id, cwd);\n720\t      return;\n721\t    }\n722\t    await captureOpencodeAll(cwd, 1);\n723\t  } catch (err) {\n724\t    process.stderr.write(\n725\t      `cledger: opencode hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n726\t    );\n727\t  }\n728\t}\n729\t","tool_use_id":"toolu_01YTv9okE3XRZqSEd7JmCcgk","type":"tool_result"}],"role":"user"},"context":{"branch":"opencode-stable-seq","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","head":"a67735deb89658e859eb93287ce9a1491ec9d37f","repo":"git@github.com:evintunador/conversation-ledger.git"},"id":"ev2-1bccd5eab7ae4be9f1e0acd62ffa07323a4dd5ad70f73c34cc5f3c282f6371c2","kind":"conversation_turn","meta":{"actor":{"type":"system"},"session_id":"224d1239-00ba-4ddb-8117-5a487d569b0d","source":"claude-code","source_version":"2.1.235"},"occurred_at":"2026-08-19T02:10:14.133Z","producer":{"tool":"cledger","version":"0.25.0"},"raw":{"data":{"agentId":"aa509a04dda91edeb","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","entrypoint":"cli","gitBranch":"main","isSidechain":true,"message":{"content":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { mkdtemp, open, readFile, rm } from \"node:fs/promises\";\n26\timport { tmpdir } from \"node:os\";\n27\timport { join } from \"node:path\";\n28\timport { findRepo, gitUserIdentity, type GitUserIdentity } from \"../git.js\";\n29\timport { appendEvents } from \"../store.js\";\n30\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n31\timport { packageVersion, readCursor, writeCursor } from \"./common.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  mergeCaptureResult,\n35\t  unrecognizedDraft,\n36\t  warnUnrecognized,\n37\t  type CaptureResult,\n38\t} from \"./drift.js\";\n39\timport { activityDraft, type RecordContext } from \"./records.js\";\n40\t\n41\tconst RAW_FORMAT = \"opencode-export-json/1\";\n42\t\n43\tconst CURSOR_FIELD = \"parts\";\n44\t\n45\t/**\n46\t * Part types carrying visible conversation content.\n47\t *\n48\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n49\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n50\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n51\t * stores reasoning as plain `text`. So it converts to an ordinary\n52\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n53\t * thinking blocks do — no opacity marker, nothing withheld.\n54\t */\n55\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n56\t\n57\t/**\n58\t * Part types recorded as `activity` rather than as turns.\n59\t *\n60\t * `step-start` and `step-finish` carry no prose, which is why they were once\n61\t * dropped, but they carry the two things nothing else in the export does: the\n62\t * git snapshot hash opencode took at each step boundary, and the token counts,\n63\t * cost, and finish reason for the step. The snapshot hash in particular is a\n64\t * real handle on intermediate repository state — the closest opencode analogue\n65\t * to Claude Code's file history.\n66\t *\n67\t * `patch` points into opencode's private snapshot store, and the diff it names\n68\t * is usually already in git. It is recorded anyway, for the same reason the\n69\t * file-history pointers are: \"usually already in git\" is not \"always\", and a\n70\t * pointer with provenance beats a hole.\n71\t *\n72\t * Part types opencode's binary references but no session on hand exercises —\n73\t * `file`, `agent`, `snapshot`, `todo` — are still left off every list here.\n74\t * Guessing at their shape would discard content on the first session that used\n75\t * one; leaving them out routes them through the drift path, which preserves\n76\t * them raw, warns, and lets `cledger renormalize` upgrade them later.\n77\t */\n78\tconst ACTIVITY_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n79\t\n80\t/**\n81\t * Tool-call states that will never change again. A `pending`/`running` part\n82\t * is still being written; capturing it would bake a half-finished tool call\n83\t * into an immutable event id. The capture loop skips unsettled parts *and*\n84\t * holds the cursor back at the first one, so the finished version is picked\n85\t * up on the next capture rather than being skipped forever.\n86\t */\n87\tconst SETTLED_TOOL_STATUSES = new Set([\"completed\", \"error\"]);\n88\t\n89\t/** Payload the installed opencode plugin sends on stdin (see install.ts). */\n90\tinterface OpencodeHookPayload {\n91\t  session_id?: string;\n92\t  cwd?: string;\n93\t  hook_event_name?: string;\n94\t}\n95\t\n96\tinterface OpencodeSessionInfo {\n97\t  id?: string;\n98\t  /** Set on subagent sessions; those are skipped (see captureOpencodeExport). */\n99\t  parentID?: string;\n100\t  directory?: string;\n101\t  title?: string;\n102\t  /** opencode's own CLI version, e.g. \"1.18.5\". */\n103\t  version?: string;\n104\t  time?: { created?: number; updated?: number };\n105\t}\n106\t\n107\tinterface OpencodeMessageInfo {\n108\t  id?: string;\n109\t  sessionID?: string;\n110\t  role?: string;\n111\t  /** Agent persona, e.g. \"build\" / \"plan\". */\n112\t  agent?: string;\n113\t  mode?: string;\n114\t  /** Assistant messages state the model flat; user messages nest it. */\n115\t  modelID?: string;\n116\t  providerID?: string;\n117\t  model?: { modelID?: string; providerID?: string };\n118\t  time?: { created?: number; completed?: number };\n119\t}\n120\t\n121\tinterface OpencodePart {\n122\t  id?: string;\n123\t  type?: string;\n124\t  messageID?: string;\n125\t  sessionID?: string;\n126\t  text?: string;\n127\t  tool?: string;\n128\t  callID?: string;\n129\t  /** `step-start`/`step-finish`: opencode's git snapshot hash at the boundary. */\n130\t  snapshot?: string;\n131\t  /** `step-finish`: why the step ended, e.g. \"tool-calls\" / \"stop\". */\n132\t  reason?: string;\n133\t  /** `step-finish`: token accounting for the step. */\n134\t  tokens?: Record<string, unknown>;\n135\t  cost?: number;\n136\t  state?: {\n137\t    status?: string;\n138\t    input?: unknown;\n139\t    output?: unknown;\n140\t    error?: unknown;\n141\t    time?: { start?: number; end?: number };\n142\t  };\n143\t  time?: { start?: number; end?: number };\n144\t}\n145\t\n146\tinterface OpencodeMessage {\n147\t  info?: OpencodeMessageInfo;\n148\t  parts?: OpencodePart[];\n149\t}\n150\t\n151\texport interface OpencodeExport {\n152\t  info?: OpencodeSessionInfo;\n153\t  messages?: OpencodeMessage[];\n154\t}\n155\t\n156\t/** What `opencode session list --format json` returns, per row. */\n157\tinterface OpencodeSessionRow {\n158\t  id?: string;\n159\t  title?: string;\n160\t  directory?: string;\n161\t  updated?: number;\n162\t}\n163\t\n164\t/** One part, paired with the message that owns it and its session position. */\n165\tinterface FlatPart {\n166\t  info: OpencodeMessageInfo;\n167\t  part: OpencodePart;\n168\t  seq: number;\n169\t}\n170\t\n171\t/** opencode stores times as epoch milliseconds; the ledger wants ISO 8601. */\n172\tfunction isoFromMs(ms: unknown): string | null {\n173\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n174\t  const date = new Date(ms);\n175\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n176\t}\n177\t\n178\t/**\n179\t * Run an opencode subcommand and return its stdout.\n180\t *\n181\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n182\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n183\t * silently lost — a large session's export still parses as JSON right up to\n184\t * the truncation point in some cases, which would quietly capture a partial\n185\t * conversation. Writing to a real file descriptor returns the full output.\n186\t *\n187\t * Returns null when opencode is not installed or the command fails; every\n188\t * caller treats that as \"nothing to capture\" rather than an error, so a\n189\t * missing opencode never breaks a hook.\n190\t */\n191\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n192\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n193\t  const path = join(dir, \"out.json\");\n194\t  try {\n195\t    const handle = await open(path, \"w\");\n196\t    try {\n197\t      const code = await new Promise<number | null>((resolve, reject) => {\n198\t        const child = spawn(\"opencode\", args, {\n199\t          cwd,\n200\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n201\t        });\n202\t        child.on(\"error\", reject);\n203\t        child.on(\"close\", resolve);\n204\t      });\n205\t      if (code !== 0) return null;\n206\t    } finally {\n207\t      await handle.close();\n208\t    }\n209\t    return await readFile(path, \"utf8\");\n210\t  } catch {\n211\t    return null;\n212\t  } finally {\n213\t    await rm(dir, { recursive: true, force: true });\n214\t  }\n215\t}\n216\t\n217\t/**\n218\t * Export one session as JSON. `--pure` skips external plugins, which matters\n219\t * because the capture this call belongs to was very likely triggered *by* an\n220\t * opencode plugin — loading that plugin again inside the export would invite\n221\t * re-entrancy.\n222\t */\n223\texport async function exportOpencodeSession(\n224\t  sessionId: string,\n225\t  cwd: string,\n226\t): Promise<OpencodeExport | null> {\n227\t  const stdout = await runOpencode([\"export\", \"--pure\", sessionId], cwd);\n228\t  if (!stdout) return null;\n229\t  try {\n230\t    return JSON.parse(stdout) as OpencodeExport;\n231\t  } catch {\n232\t    return null;\n233\t  }\n234\t}\n235\t\n236\t/**\n237\t * List opencode sessions. opencode scopes this to the project containing\n238\t * `cwd`, which is exactly the scoping a repo-local capture wants — a sweep\n239\t * never reaches into conversations that belong to other checkouts.\n240\t */\n241\texport async function listOpencodeSessions(cwd: string): Promise<OpencodeSessionRow[]> {\n242\t  const stdout = await runOpencode([\"session\", \"list\", \"--pure\", \"--format\", \"json\"], cwd);\n243\t  if (!stdout) return [];\n244\t  try {\n245\t    const parsed = JSON.parse(stdout) as unknown;\n246\t    return Array.isArray(parsed) ? (parsed as OpencodeSessionRow[]) : [];\n247\t  } catch {\n248\t    return [];\n249\t  }\n250\t}\n251\t\n252\t/**\n253\t * The agent facts a message states about itself. opencode labels every\n254\t * message with its model and provider — including *user* messages, which\n255\t * carry the model selected to answer them. That is a genuine difference from\n256\t * claude-code, where a user line states no model and none is invented; here\n257\t * the source does state it, so it is recorded, per `Producer.model`'s rule of\n258\t * \"set only when the source states it for this turn\".\n259\t *\n260\t * `providerID` is opencode's *config* provider key (e.g. \"ds4\", \"local-mlx\"),\n261\t * which the user names themselves rather than a canonical vendor name. It is\n262\t * passed through verbatim anyway — the schema asks for the provider as the\n263\t * source names it, and rewriting it would be interpretation.\n264\t */\n265\tfunction agentContext(info: OpencodeMessageInfo, sessionVersion?: string): ProducerAgentContext {\n266\t  const agent: ProducerAgentContext = {};\n267\t  if (sessionVersion) agent.source_version = sessionVersion;\n268\t  const model = info.modelID ?? info.model?.modelID;\n269\t  if (typeof model === \"string\" && model) agent.model = model;\n270\t  const provider = info.providerID ?? info.model?.providerID;\n271\t  if (typeof provider === \"string\" && provider) agent.provider = provider;\n272\t  return agent;\n273\t}\n274\t\n275\t/**\n276\t * When this part happened: its own start time, else the message's creation\n277\t * time, else the session base time. Every step is a pure function of the\n278\t * export, so rescans and re-normalization land on the same value — which\n279\t * matters because `occurred_at` is part of event identity.\n280\t */\n281\tfunction partTime(info: OpencodeMessageInfo, part: OpencodePart, baseTime: string): string {\n282\t  return (\n283\t    isoFromMs(part.time?.start) ??\n284\t    isoFromMs(part.state?.time?.start) ??\n285\t    isoFromMs(info.time?.created) ??\n286\t    baseTime\n287\t  );\n288\t}\n289\t\n290\t/** Flatten messages into parts, numbering every part in export order. */\n291\tfunction flattenParts(data: OpencodeExport): FlatPart[] {\n292\t  const flat: FlatPart[] = [];\n293\t  let seq = 0;\n294\t  for (const message of data.messages ?? []) {\n295\t    const info = message.info ?? {};\n296\t    for (const part of message.parts ?? []) {\n297\t      flat.push({ info, part, seq });\n298\t      seq++;\n299\t    }\n300\t  }\n301\t  return flat;\n302\t}\n303\t\n304\t/**\n305\t * `raw.data` for one part. The part alone would be lossy: it carries ids but\n306\t * no role, model, or timing for the message that owns it, so an exported\n307\t * event could not be replayed without the rest of the session. Pairing it\n308\t * with its message info keeps every event independently lossless, at the cost\n309\t * of repeating a small object across the parts of one message.\n310\t */\n311\tfunction rawData(info: OpencodeMessageInfo, part: OpencodePart): unknown {\n312\t  return { info, part };\n313\t}\n314\t\n315\t/**\n316\t * True when a part carries nothing a reader would see. Empty text and\n317\t * reasoning parts do occur (a step that produced only a tool call, say), and\n318\t * emitting an event whose only block is an empty string adds a line to\n319\t * `cledger log` that says nothing.\n320\t */\n321\tfunction isEmptyText(part: OpencodePart): boolean {\n322\t  return typeof part.text !== \"string\" || part.text.trim() === \"\";\n323\t}\n324\t\n325\t/** Whether a tool part has reached a state that will not change again. */\n326\tfunction isSettledTool(part: OpencodePart): boolean {\n327\t  const status = part.state?.status;\n328\t  return typeof status === \"string\" && SETTLED_TOOL_STATUSES.has(status);\n329\t}\n330\t\n331\tfunction convertPart(\n332\t  info: OpencodeMessageInfo,\n333\t  part: OpencodePart,\n334\t  seq: number,\n335\t  sessionId: string,\n336\t  baseTime: string,\n337\t  version: string,\n338\t  identity: GitUserIdentity,\n339\t  agent: ProducerAgentContext,\n340\t  parentId?: string,\n341\t): EventDraft | null {\n342\t  const type = part.type;\n343\t  if (typeof type !== \"string\" || !CONVERTIBLE_PART_TYPES.has(type)) return null;\n344\t\n345\t  const role = typeof info.role === \"string\" ? info.role : \"assistant\";\n346\t  const isHuman = role === \"user\" && type === \"text\";\n347\t\n348\t  const actor: Actor = isHuman ? { type: \"human\" } : { type: \"agent\" };\n349\t  if (isHuman) {\n350\t    if (identity.email) actor.id = identity.email;\n351\t    if (identity.name) actor.display = identity.name;\n352\t  } else if (agent.model) {\n353\t    actor.id = agent.model;\n354\t  }\n355\t\n356\t  let blocks: unknown[];\n357\t  if (type === \"text\") {\n358\t    if (isEmptyText(part)) return null;\n359\t    blocks = [{ type: \"text\", text: part.text }];\n360\t  } else if (type === \"reasoning\") {\n361\t    if (isEmptyText(part)) return null;\n362\t    blocks = [{ type: \"thinking\", text: part.text }];\n363\t  } else {\n364\t    // tool: opencode keeps the call and its result on one part, so both\n365\t    // blocks belong to one event. The actor stays `agent` rather than the\n366\t    // `system` other adapters give a standalone tool result — opencode does\n367\t    // not model the result as a separate speaker, and splitting it here\n368\t    // would be inventing structure the source does not have.\n369\t    if (!isSettledTool(part)) return null;\n370\t    const call: Record<string, unknown> = { type: \"tool_use\" };\n371\t    if (typeof part.tool === \"string\") call[\"name\"] = part.tool;\n372\t    if (part.state?.input !== undefined) call[\"input\"] = part.state.input;\n373\t    if (typeof part.callID === \"string\") call[\"id\"] = part.callID;\n374\t    const result: Record<string, unknown> = { type: \"tool_result\" };\n375\t    if (typeof part.callID === \"string\") result[\"tool_use_id\"] = part.callID;\n376\t    const failed = part.state?.status === \"error\";\n377\t    result[\"content\"] = failed ? (part.state?.error ?? part.state?.output) : part.state?.output;\n378\t    if (failed) result[\"is_error\"] = true;\n379\t    blocks = [call, result];\n380\t  }\n381\t\n382\t  const content: Record<string, unknown> = { role };\n383\t  // opencode's agent persona (\"build\", \"plan\", ...) has no home in `Producer`,\n384\t  // which describes the model and the capture tool, not which persona the\n385\t  // user was driving. It goes in `content` next to `role`, the way codex's\n386\t  // agent_message author/recipient do.\n387\t  if (typeof info.agent === \"string\" && info.agent) content[\"agent\"] = info.agent;\n388\t  content[\"blocks\"] = blocks;\n389\t\n390\t  const conversation = conversationFor(sessionId, parentId);\n391\t  return {\n392\t    kind: \"conversation_turn\",\n393\t    occurred_at: partTime(info, part, baseTime),\n394\t    actor,\n395\t    producer: { tool: \"cledger\", version, source: \"opencode\", session_id: sessionId, ...agent },\n396\t    conversation: {\n397\t      id: conversation.id,\n398\t      seq,\n399\t      ...(conversation.parent ? { parent: conversation.parent } : {}),\n400\t    },\n401\t    content,\n402\t    raw: { format: RAW_FORMAT, data: rawData(info, part) },\n403\t  };\n404\t}\n405\t\n406\t/**\n407\t * Which conversation a session's parts belong to. opencode gives a subagent\n408\t * its own session id, so a subagent session is already its own conversation —\n409\t * all it was missing is the pointer back to the session that spawned it, and\n410\t * a capture path that did not return early on sight of `parentID`.\n411\t */\n412\tfunction conversationFor(\n413\t  sessionId: string,\n414\t  parentId: string | undefined,\n415\t): { id: string; parent?: string } {\n416\t  const id = `opencode:${sessionId}`;\n417\t  return parentId ? { id, parent: `opencode:${parentId}` } : { id };\n418\t}\n419\t\n420\t/**\n421\t * The `RecordContext` a non-turn part converts under. Shared by the capture\n422\t * loop and the re-normalization hook so both mint the same event identity.\n423\t */\n424\tfunction recordContext(\n425\t  occurredAt: string,\n426\t  seq: number,\n427\t  sessionId: string,\n428\t  parentId: string | undefined,\n429\t  version: string,\n430\t  agent: ProducerAgentContext,\n431\t): RecordContext {\n432\t  const conversation = conversationFor(sessionId, parentId);\n433\t  return {\n434\t    occurredAt,\n435\t    source: \"opencode\",\n436\t    sessionId,\n437\t    seq,\n438\t    version,\n439\t    rawFormat: RAW_FORMAT,\n440\t    conversationId: conversation.id,\n441\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n442\t    agent,\n443\t  };\n444\t}\n445\t\n446\t/**\n447\t * Convert a part that is not a turn into the record it deserves, or null when\n448\t * the part type is unknown (the caller routes it to the drift path).\n449\t *\n450\t * The actor is `agent`: a step boundary or a patch is the model's own work\n451\t * being recorded, not the harness reporting on itself.\n452\t */\n453\tfunction convertRecordPart(part: OpencodePart, ctx: RecordContext, info: OpencodeMessageInfo): EventDraft | null {\n454\t  const type = part.type;\n455\t  if (typeof type !== \"string\" || !ACTIVITY_PART_TYPES.has(type)) return null;\n456\t  const { type: _type, ...fields } = part as Record<string, unknown>;\n457\t  return activityDraft(ctx, type, fields, rawData(info, part), \"agent\");\n458\t}\n459\t\n460\t/** Raw-only preservation event for an unrecognized opencode part (see drift.ts). */\n461\tfunction preserve(\n462\t  typeKey: string,\n463\t  info: OpencodeMessageInfo,\n464\t  part: OpencodePart,\n465\t  occurredAt: string,\n466\t  seq: number,\n467\t  sessionId: string,\n468\t  version: string,\n469\t  agent: ProducerAgentContext,\n470\t  parentId?: string,\n471\t): EventDraft {\n472\t  const conversation = conversationFor(sessionId, parentId);\n473\t  return unrecognizedDraft({\n474\t    typeKey,\n475\t    line: rawData(info, part),\n476\t    occurredAt,\n477\t    source: \"opencode\",\n478\t    sessionId,\n479\t    seq,\n480\t    version,\n481\t    rawFormat: RAW_FORMAT,\n482\t    conversationId: conversation.id,\n483\t    ...(conversation.parent ? { parentConversationId: conversation.parent } : {}),\n484\t    agent: { ...agent },\n485\t  });\n486\t}\n487\t\n488\t/**\n489\t * Re-normalization hook (see renormalize.ts): turn a preserved `unrecognized`\n490\t * event back into the `conversation_turn` a live capture would now produce.\n491\t *\n492\t * Id fidelity works the same way as in the claude-code and codex twins, and\n493\t * the `{info, part}` shape stored in `raw.data` is what makes it possible\n494\t * here: the message info a part needs for its role, model and time fallback\n495\t * travels with the part instead of living in a session header this path can\n496\t * no longer see. `baseTime` falls back to the preserved event's own\n497\t * `occurred_at`, which is the value the preservation path computed — so a\n498\t * part with no time of its own reconstructs to the same instant, and\n499\t * therefore the same id.\n500\t */\n501\texport function renormalizeUnrecognized(\n502\t  event: EvidenceEvent,\n503\t  identity: GitUserIdentity,\n504\t): EventDraft | null {\n505\t  if (!event.raw || event.conversation === undefined) return null;\n506\t  const stored = event.raw.data as { info?: OpencodeMessageInfo; part?: OpencodePart } | null;\n507\t  if (!stored || !stored.part) return null;\n508\t  const info = stored.info ?? {};\n509\t  const agent: ProducerAgentContext = {};\n510\t  if (event.producer.source_version) agent.source_version = event.producer.source_version;\n511\t  if (event.producer.model) agent.model = event.producer.model;\n512\t  if (event.producer.provider) agent.provider = event.producer.provider;\n513\t  const sessionId = event.producer.session_id ?? \"\";\n514\t  const version = packageVersion();\n515\t  // The parent session id is not in `raw.data` — it lives on the session\n516\t  // export, which this path cannot see. It is read back off the preserved\n517\t  // event's own `conversation.parent`, where the capture that preserved the\n518\t  // part recorded it, and stripped of its `opencode:` namespace so\n519\t  // `conversationFor` re-derives the identical ref.\n520\t  const parentId = event.conversation.parent?.replace(/^opencode:/, \"\");\n521\t  const turn = convertPart(\n522\t    info,\n523\t    stored.part,\n524\t    event.conversation.seq,\n525\t    sessionId,\n526\t    event.occurred_at,\n527\t    version,\n528\t    identity,\n529\t    agent,\n530\t    parentId,\n531\t  );\n532\t  if (turn) return turn;\n533\t  return convertRecordPart(\n534\t    stored.part,\n535\t    recordContext(event.occurred_at, event.conversation.seq, sessionId, parentId, version, agent),\n536\t    info,\n537\t  );\n538\t}\n539\t\n540\t/**\n541\t * Capture a session from an already-parsed export. Split out from the\n542\t * subprocess plumbing so tests (and offline backfill from a saved export\n543\t * file) exercise the conversion without needing opencode installed.\n544\t */\n545\texport async function captureOpencodeExport(\n546\t  data: OpencodeExport,\n547\t  cwd: string,\n548\t): Promise<CaptureResult> {\n549\t  const repo = await findRepo(cwd);\n550\t  if (!repo) throw new Error(\"not inside a git repository\");\n551\t\n552\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n553\t\n554\t  const sessionId = data.info?.id;\n555\t  if (typeof sessionId !== \"string\" || !sessionId) return result;\n556\t\n557\t  // Subagent sessions are captured, as their own conversation pointing back\n558\t  // at the parent (see `conversationFor`). They used to be skipped for want of\n559\t  // a way to express that relation; `ConversationRef.parent` is that way. What\n560\t  // was being lost was every internal step of every subagent — the parent's\n561\t  // `task` tool part keeps only the child's final answer, so the reasoning\n562\t  // that produced it, and every tool call behind it, went unrecorded.\n563\t  const parentId =\n564\t    typeof data.info?.parentID === \"string\" && data.info.parentID ? data.info.parentID : undefined;\n565\t\n566\t  const flat = flattenParts(data);\n567\t  let cursor = (await readCur