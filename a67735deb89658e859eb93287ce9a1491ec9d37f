if (draft) drafts.push(draft);\n609\t  }\n610\t\n611\t  if (drafts.length > 0) {\n612\t    const appendResult = await appendEvents(repo, drafts);\n613\t    result.appended = appendResult.appended.length;\n614\t    result.deduped = appendResult.deduped;\n615\t  }\n616\t  await writeCursor(repo, sessionId, CURSOR_FIELD, nextCursor);\n617\t  process.stderr.write(`cledger: opencode +${result.appended} events (${result.deduped} deduped)\\n`);\n618\t  warnUnrecognized(\"opencode\", result.unrecognized);\n619\t  return result;\n620\t}\n621\t\n622\t/**\n623\t * The subagent sessions a session spawned, read off its own `task` tool\n624\t * parts: opencode records the child's session id in the part's\n625\t * `state.metadata.sessionId`.\n626\t *\n627\t * This is how subagent conversations are found at all. `opencode session list`\n628\t * returns only top-level sessions, so a child is reachable only from the\n629\t * parent that spawned it — which means a capture that stopped at the parent\n630\t * could never have found them, no matter how the ledger modelled the relation.\n631\t */\n632\tfunction childSessionIds(data: OpencodeExport): string[] {\n633\t  const ids: string[] = [];\n634\t  for (const message of data.messages ?? []) {\n635\t    for (const part of message.parts ?? []) {\n636\t      if (part.type !== \"tool\" || part.tool !== \"task\") continue;\n637\t      const metadata = (part.state as { metadata?: { sessionId?: unknown } } | undefined)?.metadata;\n638\t      const id = metadata?.sessionId;\n639\t      if (typeof id === \"string\" && id && id !== data.info?.id) ids.push(id);\n640\t    }\n641\t  }\n642\t  return ids;\n643\t}\n644\t\n645\t/**\n646\t * Export one session via the opencode CLI, then capture it — and every\n647\t * subagent session it spawned, depth-first.\n648\t *\n649\t * `visited` guards the recursion. opencode's task metadata is not guaranteed\n650\t * acyclic by anything the ledger can see, and an export that named its own\n651\t * ancestor would otherwise loop forever inside a capture hook.\n652\t */\n653\texport async function captureOpencodeSession(\n654\t  sessionId: string,\n655\t  cwd: string,\n656\t  visited: Set<string> = new Set(),\n657\t): Promise<CaptureResult> {\n658\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n659\t  if (visited.has(sessionId)) return result;\n660\t  visited.add(sessionId);\n661\t\n662\t  const data = await exportOpencodeSession(sessionId, cwd);\n663\t  if (!data) return result;\n664\t  mergeCaptureResult(result, await captureOpencodeExport(data, cwd));\n665\t  for (const child of childSessionIds(data)) {\n666\t    mergeCaptureResult(result, await captureOpencodeSession(child, cwd, visited));\n667\t  }\n668\t  return result;\n669\t}\n670\t\n671\t/** Capture a session from a saved `opencode export` JSON file (backfill). */\n672\texport async function captureOpencodeExportFile(\n673\t  path: string,\n674\t  cwd: string,\n675\t): Promise<CaptureResult> {\n676\t  const raw = await readFile(path, \"utf8\");\n677\t  return captureOpencodeExport(JSON.parse(raw) as OpencodeExport, cwd);\n678\t}\n679\t\n680\t/**\n681\t * Capture every session opencode associates with `cwd`'s project. Used by\n682\t * `cledger capture opencode --all`, and as the hook's fallback when the\n683\t * plugin could not tell us which session went idle.\n684\t */\n685\texport async function captureOpencodeAll(\n686\t  cwd: string,\n687\t  limit?: number,\n688\t): Promise<CaptureResult> {\n689\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n690\t  const sessions = await listOpencodeSessions(cwd);\n691\t  const ordered = [...sessions].sort((a, b) => (b.updated ?? 0) - (a.updated ?? 0));\n692\t  const selected = typeof limit === \"number\" ? ordered.slice(0, limit) : ordered;\n693\t  // One `visited` set across the sweep: two top-level sessions can name the\n694\t  // same subagent session, and it should be exported once.\n695\t  const visited = new Set<string>();\n696\t  for (const session of selected) {\n697\t    if (typeof session.id !== \"string\" || !session.id) continue;\n698\t    mergeCaptureResult(total, await captureOpencodeSession(session.id, cwd, visited));\n699\t  }\n700\t  return total;\n701\t}\n702\t\n703\t/**\n704\t * Hook entrypoint, invoked by the plugin `cledger install opencode` writes.\n705\t *\n706\t * `session_id` is optional on purpose. The plugin reads it out of opencode's\n707\t * `session.idle` event, whose exact payload shape is not something cledger\n708\t * can pin down across opencode versions; when it is missing, capture falls\n709\t * back to the most recently updated session for this project, which is the\n710\t * session that just went idle in every realistic case.\n711\t */\n712\texport async function runOpencodeHook(stdinJson: string): Promise<void> {\n713\t  try {\n714\t    const payload = JSON.parse(stdinJson) as OpencodeHookPayload;\n715\t    const cwd = payload.cwd ?? process.cwd();\n716\t    const repo = await findRepo(cwd);\n717\t    if (!repo) return; // hooks must never break the user's session outside a repo\n718\t    if (payload.session_id) {\n719\t      await captureOpencodeSession(payload.session_id, cwd);\n720\t      return;\n721\t    }\n722\t    await captureOpencodeAll(cwd, 1);\n723\t  } catch (err) {\n724\t    process.stderr.write(\n725\t      `cledger: opencode hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n726\t    );\n727\t  }\n728\t}\n729\t","tool_use_id":"toolu_01YTv9okE3XRZqSEd7JmCcgk","type":"tool_result"}],"role":"user"},"parentUuid":"e2890ac4-83ec-4d9d-af38-eb677cf5c567","promptId":"9fa2acf0-2a13-4430-9a93-7836a725fe92","sessionId":"224d1239-00ba-4ddb-8117-5a487d569b0d","sessionKind":"bg","sourceToolAssistantUUID":"e2890ac4-83ec-4d9d-af38-eb677cf5c567","timestamp":"2026-08-19T02:10:14.133Z","toolUseResult":{"file":{"content":"/**\n * opencode adapter.\n *\n * Unlike claude-code and codex, opencode has no append-only transcript file:\n * sessions live in a mutable SQLite database at\n * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n * adapter shells out to opencode's own `opencode export <sessionID>`, which\n * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n *\n *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n *     `node:sqlite` would force both to change.\n *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n *     table sits alongside the populated `message`/`part` tables it is\n *     evidently meant to replace). The export shape is the interface opencode\n *     documents; the tables are not.\n *  3. The same database holds `credential.value` and `account.access_token`.\n *     Reading conversations should not require opening the file that stores\n *     the user's API tokens.\n *\n * `--sanitize` is deliberately *not* passed to the export: cledger has its\n * own redaction stack, and letting opencode rewrite content would make event\n * ids depend on opencode's version.\n */\nimport { spawn } from \"node:child_process\";\nimport { mkdtemp, open, readFile, rm } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { findRepo, gitUserIdentity, type GitUserIdentity } from \"../git.js\";\nimport { appendEvents } from \"../store.js\";\nimport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\nimport { packageVersion, readCursor, writeCursor } from \"./common.js\";\nimport {\n  countUnrecognized,\n  mergeCaptureResult,\n  unrecognizedDraft,\n  warnUnrecognized,\n  type CaptureResult,\n} from \"./drift.js\";\nimport { activityDraft, type RecordContext } from \"./records.js\";\n\nconst RAW_FORMAT = \"opencode-export-json/1\";\n\nconst CURSOR_FIELD = \"parts\";\n\n/**\n * Part types carrying visible conversation content.\n *\n * `reasoning` belongs here, and that is a real difference from codex: codex