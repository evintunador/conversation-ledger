if (test === \"2\") {\n  console.log(\"\\nTEST 2 — Gemini /rewind\\n\");\n  const ev = await load(\"gemini-cli\");\n  const rewinds = ev.filter((e) => e.content?.activity_type === \"rewind\");\n  if (!rewinds.length) {\n    no(\"no `rewind` activity found — did you pick 'Rewind conversation' in the dialog?\");\n    info(\"`Revert code changes` alone does NOT rewind the conversation.\");\n  } else {\n    ok(`${rewinds.length} rewind activity/activities recorded`);\n    // Every id a rewind withdrew must still exist as a captured turn: that is\n    // the whole union-capture thesis.\n    const turnIds = new Set(\n      ev.filter((e) => e.kind === \"conversation_turn\").map((e) => e.raw?.data?.id).filter(Boolean),\n    );\n    for (const r of rewinds) {\n      const removed = r.content.removed_messages ?? [];\n      info(`seq=${r.conversation.seq} withdrew ${removed.length} message(s): ${JSON.stringify(removed)}`);\n      const missing = removed.filter((id) => !turnIds.has(id));\n      missing.length\n        ? no(`withdrawn but NOT captured: ${JSON.stringify(missing)} — union capture is broken`)\n        : ok(\"every withdrawn message is still captured as a turn (union capture holds)\");\n    }\n  }\n  const drops = ev.filter((e) => e.content?.activity_type === \"snapshot_drop\");\n  info(`(also saw ${drops.length} snapshot_drop activity/activities)`);\n}\n\n// The sweep is only observable as a *change*: a session that was killed\n// mid-life has a stranded tail, and a later session's hook must grow it.\n// Merely having two conversations proves nothing.\nconst SNAP = \"/Users/evintunador/tmp/cledger-smoke-snapshot.json\";\n\nif (test === \"3a\" || test === \"3b\") {\n  const { writeFile, readFile } = await import(\"node:fs/promises\");\n  const ev = await load(\"gemini-cli\");\n  const counts = Object.fromEntries([...bySession(ev)].map(([id, es]) => [id, es.length]));\n\n  if (test === \"3a\") {\n    console.log(\"\\nTEST 3a — snapshot taken (run this right after `kill -9`)\\n\");\n    await writeFile(SNAP, JSON.stringify(counts, null, 2));\n    for (const [id, n] of Object.entries(counts)) info(`  ${id}  ${n} events`);\n    ok(\"snapshot saved — now start a second gemini session and quit it normally\");\n  } else {\n    console.log(\"\\nTEST 3b — did the sweep grow the killed session?\\n\");\n    let before;\n    try {\n      before = JSON.parse(await readFile(SNAP, \"utf8\"));\n    } catch {\n      no(\"no snapshot found — run `node ~/tmp/cledger-check.mjs 3a` first\");\n      process.exit(0);\n    }\n    let grew = 0;\n    for (const [id, n] of Object.entries(before)) {\n      const now = counts[id] ?? 0;\n      info(`  ${id}  ${n} -> ${now}`);\n      if (now > n) grew++;\n    }\n    grew\n      ? ok(`${grew} previously-captured session(s) grew — the sweep picked up the stranded tail`)\n      : no(\"no earlier session grew — the sweep did not run, or had nothing stranded to collect\");\n    const fresh = Object.keys(counts).filter((id) => !(id in before));\n    info(`(${fresh.length} new conversation(s) from the second session, which is expected)`);\n  }\n}\n\nif (test === \"4\" || test === \"5\") {\n  console.log(`\\nTEST ${test} — Qwen Code\\n`);\n  const ev = await load(\"qwen-code\");\n  const kinds = new Map();\n  for (const e of ev) {\n    const c = e.content ?? {};\n    const sub = c.activity_type ?? c.state_type ?? c.injection_type ?? c.operation ?? \"\";\n    const k = `${e.kind}${sub ? \"/\" + sub : \"\"}`;\n    kinds.set(k, (kinds.get(k) ?? 0) + 1);\n  }\n  info(`${ev.length} events`);\n  for (const [k, v] of [...kinds].sort((a, b) => b[1] - a[1])) info(`  ${String(v).padStart(4)}  ${k}`);\n\n  ev.length ? ok(\"qwen-code events captured\") : no(\"nothing captured\");\n  if (test === \"4\") {\n    const inj = ev.filter((e) => e.kind === \"context_injection\");\n    inj.length ? ok(`context_injection present (${inj.length}) — @file worked`) : no(\"no context_injection — did you use @calc.py?\");\n    const titles = 