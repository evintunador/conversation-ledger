ick up the killed one\");\n}\n\nif (test === \"4\" || test === \"5\") {\n  console.log(`\\nTEST ${test} — Qwen Code\\n`);\n  const ev = await load(\"qwen-code\");\n  const kinds = new Map();\n  for (const e of ev) {\n    const c = e.content ?? {};\n    const sub = c.activity_type ?? c.state_type ?? c.injection_type ?? c.operation ?? \"\";\n    const k = `${e.kind}${sub ? \"/\" + sub : \"\"}`;\n    kinds.set(k, (kinds.get(k) ?? 0) + 1);\n  }\n  info(`${ev.length} events`);\n  for (const [k, v] of [...kinds].sort((a, b) => b[1] - a[1])) info(`  ${String(v).padStart(4)}  ${k}`);\n\n  ev.length ? ok(\"qwen-code events captured\") : no(\"nothing captured\");\n  if (test === \"4\") {\n    const inj = ev.filter((e) => e.kind === \"context_injection\");\n    inj.length ? ok(`context_injection present (${inj.length}) — @file worked`) : no(\"no context_injection — did you use @calc.py?\");\n    const titles = ev.filter((e) => e.content?.state_type === \"custom_title\");\n    titles.length ? ok(\"custom_title session_state present\") : no(\"no custom_title — did /chat save run?\");\n    const kids = ev.filter((e) => e.conversation?.parent);\n    kids.length\n      ? ok(`${kids.length} sub-conversation event(s) with a parent link — subagent captured`)\n      : no(\"no sub-conversation — did a subagent actually run?\");\n    const unrec = ev.filter((e) => e.kind === \"unrecognized\");\n    unrec.length ? no(`${unrec.length} unrecognized line(s) — FORMAT DRIFT, tell Claude`) : ok(\"no format drift\");\n  }\n}\n\nif (![\"1\", \"2\", \"3\", \"4\", \"5\"].includes(test)) {\n  console.log(\"usage: node ~/tmp/cledger-check.mjs <1|2|3|4|5>\");\n}\nconsole.log(\"\");\n","replaceAll":false,"structuredPatch":[{"lines":["   info(`(also saw ${drops.length} snapshot_drop activity/activities)`);"," }"," ","-if (test === \"3\") {","-  console.log(\"\\nTEST 3 — Gemini catch-up sweep\\n\");","+// The sweep is only observable as a *change*: a session that was killed","+// mid-life has a stranded 