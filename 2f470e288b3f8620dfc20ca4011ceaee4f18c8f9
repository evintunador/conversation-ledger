 {\n  console.log(\"usage: node ~/tmp/cledger-check.mjs <1|2|3|4|5>\");\n}","originalFile":"#!/usr/bin/env node\n// Smoke-test checker for the cledger gemini-cli / qwen-code adapters.\n// Usage:  node ~/tmp/cledger-check.mjs <1|2|3|4|5>\nimport { execFile } from \"node:child_process\";\nimport { promisify } from \"node:util\";\nconst x = promisify(execFile);\n\nconst REPO = process.env.SMOKE_REPO || \"/Users/evintunador/tmp/cledger-smoke\";\nconst test = process.argv[2];\n\nasync function load(source) {\n  const { stdout } = await x(\n    \"cledger\",\n    [\"log\", \"--with-state\", \"--source\", source, \"--json\"],\n    { cwd: REPO, maxBuffer: 64 * 1024 * 1024 },\n  );\n  return stdout.trim().split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));\n}\n\nconst ok = (m) => console.log(`  \\x1b[32mPASS\\x1b[0m  ${m}`);\nconst no = (m) => console.log(`  \\x1b[31mFAIL\\x1b[0m  ${m}`);\nconst info = (m) => console.log(`        ${m}`);\n\nfunction bySession(events) {\n  const m = new Map();\n  for (const e of events) {\n    const id = e.conversation?.id ?? \"(none)\";\n    if (!m.has(id)) m.set(id, []);\n    m.get(id).push(e);\n  }\n  return m;\n}\n\nif (test === \"1\") {\n  console.log(\"\\nTEST 1 — Gemini model turns and tool calls\\n\");\n  const ev = await load(\"gemini-cli\");\n  const models = ev.filter((e) => e.kind === \"conversation_turn\" && e.content?.role === \"model\");\n  models.length ? ok(`${models.length} model turn(s) captured`) : no(\"no model turns captured\");\n  let dupes = 0;\n  for (const e of models) {\n    const ids = (e.content.blocks ?? []).filter((b) => b.type === \"tool_use\").map((b) => b.id);\n    if (ids.length !== new Set(ids).size) dupes++;\n    info(`seq=${e.conversation.seq} blocks=${JSON.stringify((e.content.blocks ?? []).map((b) => b.type))}`);\n  }\n  dupes ? no(`${dupes} turn(s) double-emitted a tool call`) : ok(\"no tool call was emitted twice\");\n}\n\nif (test === \"2\") {\n  console.log(\"\\nTEST 2 — Gemini /rewind\\n\");\n  const ev = await load(\"gemini-cli\");\n  const rewinds = ev.filter((e) => e.content?.activity_type === \"rewind\");\n  if (!rewinds.length) {\n    no(\"no `rewind` activity found — did you pick 'Rewind conversation' in the dialog?\");\n    info(\"`Revert code changes` alone does NOT rewind the conversation.\");\n  } else {\n    ok(`${rewinds.length} rewind activity/activities recorded`);\n    // Every id a rewind withdrew must still exist as a captured turn: that is\n    // the whole union-capture thesis.\n    const turnIds = new Set(\n      ev.filter((e) => e.kind === \"conversation_turn\").map((e) => e.raw?.data?.id).filter(Boolean),\n    );\n    for (const r of rewinds) {\n      const removed = r.content.removed_messages ?? [];\n      info(`seq=${r.conversation.seq} withdrew ${removed.length} message(s): ${JSON.stringify(removed)}`);\n      const missing = removed.filter((id) => !turnIds.has(id));\n      missing.length\n        ? no(`withdrawn but NOT captured: ${JSON.stringify(missing)} — union capture is broken`)\n        : ok(\"every withdrawn message is still captured as a turn (union capture holds)\");\n    }\n  }\n  const drops = ev.filter((e) => e.content?.activity_type === \"snapshot_drop\");\n  info(`(also saw ${drops.length} snapshot_drop activity/activities)`);\n}\n\n// The sweep is only observable as a *change*: a session that was killed\n// mid-life has a stranded tail, and a later session's hook must grow it.\n// Merely having two conversations proves nothing.\nconst SNAP = \"/Users/evintunador/tmp/cledger-smoke-snapshot.json\";\n\nif (test === \"3a\" || test === \"3b\") {\n  const { writeFile, readFile } = await import(\"node:fs/promises\");\n  const ev = await load(\"gemini-cli\");\n  const counts = Object.fromEntries([...bySession(ev)].map(([id, es]) => [id, es.length]));\n\n  if (test === \"3a\") {\n    console.log(\"\\nTEST 3a — snapshot taken (run this right after `kill -9`)\\n\");\n    await writeFile(SNAP, JSON.stringify(counts, null, 2))