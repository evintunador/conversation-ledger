on.\");\n  } else {\n    ok(`${rewinds.length} rewind activity/activities recorded`);\n    // Every id a rewind withdrew must still exist as a captured turn: that is\n    // the whole union-capture thesis.\n    const turnIds = new Set(\n      ev.filter((e) => e.kind === \"conversation_turn\").map((e) => e.raw?.data?.id).filter(Boolean),\n    );\n    for (const r of rewinds) {\n      const removed = r.content.removed_messages ?? [];\n      info(`seq=${r.conversation.seq} withdrew ${removed.length} message(s): ${JSON.stringify(removed)}`);\n      const missing = removed.filter((id) => !turnIds.has(id));\n      missing.length\n        ? no(`withdrawn but NOT captured: ${JSON.stringify(missing)} — union capture is broken`)\n        : ok(\"every withdrawn message is still captured as a turn (union capture holds)\");\n    }\n  }\n  const drops = ev.filter((e) => e.content?.activity_type === \"snapshot_drop\");\n  info(`(also saw ${drops.length} snapshot_drop activity/activities)`);\n}\n\nif (test === \"3\") {\n  console.log(\"\\nTEST 3 — Gemini catch-up sweep\\n\");\n  const ev = await load(\"gemini-cli\");\n  const sessions = bySession(ev);\n  info(`${sessions.size} gemini conversation(s) in the ledger:`);\n  for (const [id, es] of sessions) {\n    const turns = es.filter((e) => e.kind === \"conversation_turn\").length;\n    info(`  ${id}  ${es.length} events (${turns} turns)`);\n  }\n  sessions.size >= 2\n    ? ok(\"more than one session captured — the killed session was swept up\")\n    : no(\"only one session present — the sweep did not pick up the killed one\");\n}\n\nif (test === \"4\" || test === \"5\") {\n  console.log(`\\nTEST ${test} — Qwen Code\\n`);\n  const ev = await load(\"qwen-code\");\n  const kinds = new Map();\n  for (const e of ev) {\n    const c = e.content ?? {};\n    const sub = c.activity_type ?? c.state_type ?? c.injection_type ?? c.operation ?? \"\";\n    const k = `${e.kind}${sub ? \"/\" + sub : \"\"}`;\n    kinds.set(k, (kinds.get(k) ?? 0) + 1);\n  }\n  info(`${ev.length} events`);\n  for (const [k, v] of [...kinds].sort((a, b) => b[1] - a[1])) info(`  ${String(v).padStart(4)}  ${k}`);\n\n  ev.length ? ok(\"qwen-code events captured\") : no(\"nothing captured\");\n  if (test === \"4\") {\n    const inj = ev.filter((e) => e.kind === \"context_injection\");\n    inj.length ? ok(`context_injection present (${inj.length}) — @file worked`) : no(\"no context_injection — did you use @calc.py?\");\n    const titles = ev.filter((e) => e.content?.state_type === \"custom_title\");\n    titles.length ? ok(\"custom_title session_state present\") : no(\"no custom_title — did /chat save run?\");\n    const kids = ev.filter((e) => e.conversation?.parent);\n    kids.length\n      ? ok(`${kids.length} sub-conversation event(s) with a parent link — subagent captured`)\n      : no(\"no sub-conversation — did a subagent actually run?\");\n    const unrec = ev.filter((e) => e.kind === \"unrecognized\");\n    unrec.length ? no(`${unrec.length} unrecognized line(s) — FORMAT DRIFT, tell Claude`) : ok(\"no format drift\");\n  }\n}\n\nif (![\"1\", \"2\", \"3\", \"4\", \"5\"].includes(test)) {\n  console.log(\"usage: node ~/tmp/cledger-check.mjs <1|2|3|4|5>\");\n}\nconsole.log(\"\");\n","filePath":"/Users/evintunador/tmp/cledger-check.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"6afc6285-baf5-4b14-8303-7b1566b3d220","version":"2.1.223"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-06T05:39:42.493Z","schema":"conversation-ledger/v1"}
