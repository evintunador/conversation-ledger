{"content":{"attachment":{"filename":"/Users/evintunador/repos/evintunador/conversation-ledger/src/schema.ts","snippet":"1\t/**\n2\t * cledger's vocabulary over the annals envelope. The envelope itself —\n3\t * identity, serialization, validation — lives in annals and is re-exported\n4\t * here; what this module owns is the set of kinds cledger writes and what\n5\t * they mean. `kind` stays an open string: downstream tools extend the ledger\n6\t * by writing their own kinds, identified by `(producer.tool, kind)`, without\n7\t * a schema release here.\n8\t *\n9\t * `unrecognized` is the one kind cledger emits for content it could *not*\n10\t * interpret: an adapter that meets a transcript line type it has no mapping\n11\t * for preserves the line raw-only under `raw.data` rather than dropping it,\n12\t * so a later adapter version can re-normalize (and supersede) it. Its\n13\t * `content` carries only a `{unrecognized_type}` label — the payload lives in\n14\t * `raw` — but identity still separates distinct lines via `stream.seq`.\n15\t *\n16\t * `reasoning` is for content cledger deliberately never interprets: a\n17\t * provider-encrypted reasoning/thinking blob (e.g. Codex's `reasoning`\n18\t * response_items) that only the originating provider can decrypt. Its\n19\t * `content` carries only an opacity marker; the ciphertext lives in `raw`,\n20\t * for a consumer to opt into replaying back through the same provider.\n21\t * Unlike `unrecognized`, this is not a placeholder awaiting a smarter\n22\t * cledger version — no future version will ever be able to read it either.\n23\t *\n24\t * The four kinds below `reasoning` cover what a source records *around* the\n25\t * conversation. Every one of them was previously discarded at capture as\n26\t * \"bookkeeping\"; they are kept because the ledger's job is the whole record,\n27\t * and because the things a session declares about itself (which model, which\n28\t * sandbox, which worktree) are exactly what a consumer needs to judge whether\n29\t * a turn still applies. They are non-conversational by construction, so\n30\t * `log`/`show` hide them unless asked — recorded always, displayed on request.\n31\t *\n32\t * `session_state` is a *declaration that holds until restated*: the session's\n33\t * mode, permission mode, model settings, sandbox and approval policy, title,\n34\t * worktree or cwd relocation. Sources restate these freely, and each\n35\t * restatement is its own event — \"still true at this point in the transcript\"\n36\t * is a fact, not a duplicate.\n37\t *\n38\t * `activity` is a *point-in-time occurrence that is not a turn*: a hook run,\n39\t * a turn duration, a token count, a task starting or finishing, a queue\n40\t * operation, a context compaction, an aborted turn, a step boundary.\n41\t *\n42\t * `context_injection` is material the harness inserted into the model's\n43\t * context that no participant typed — Claude Code's `attachment` lines\n44\t * (task reminders, skill listings, diagnostics, pasted files). It is content\n45\t * the model read, which is why it is not `activity`, but nobody said it,\n46\t * which is why it is not `conversation_turn`.\n47\t *\n48\t * `file_snapshot` is intermediate file state: the versions a file passed\n49\t * through between commits. Tool calls cannot reconstruct this — a `Bash`\n50\t * mutation records the command, not the result — so without it the record of\n51\t * how a file got from one commit to the next has holes. Sources describe\n52\t * these versions with pointers into a machine-local cache, so the pointers\n53\t * live in `content` and what the ledger could resolve of them at capture time\n54\t * lives in `resolved`.\n55\t */\n56\texport const KNOWN_KINDS = [\n57\t  \"conversation_turn\",\n58\t  \"decision\",\n59\t  \"document\",\n60\t  \"annotation\",\n61\t  \"redaction\",\n62\t  \"supersession\",\n63\t  \"re_anchor\",\n64\t  \"unrecognized\",\n65\t  \"reasoning\",\n66\t  \"session_state\",\n67\t  \"activity\",\n68\t  \"context_injection\",\n69\t  \"file_snapshot\",\n70\t] as const;\n71\t\n72\t/**\n73\t * The kinds that record machinery around the conversation rather than\n74\t * anything a participant said. `log`/`show` hide these unless `--with-state`\n75\t * (or an explicit `--kind`) asks for them: a session restates its mode and\n76\t * its tracked-file set constantly, and letting that outnumber the turns\n77\t * ten-to-one would make the default view useless. Capture, export, and sync\n78\t * are unaffected — this list is a display default, nothing more.\n79\t */\n80\texport const SESSION_MACHINERY_KINDS = new Set<string>([\n81\t  \"session_state\",\n82\t  \"activity\",\n83\t  \"context_injection\",\n84\t  \"file_snapshot\",\n85\t]);\n86\t\n87\timport * as A from \"annals\";\n88\t\n89\texport { parseEventLine as parseAnnalsEventLine, SCHEMA_VERSION } from \"annals\";\n90\texport type {\n91\t  EventLink,\n92\t  RepoContext,\n93\t  StreamRef,\n94\t} from \"annals\";\n95\t/** Pre-extraction name for StreamRef: for cledger a stream is a conversation. */\n96\texport type { StreamRef as ConversationRef } from \"annals\";\n97\t\n98\t/** Who a record is about/by: \"human\" | \"agent\" | \"system\". cledger\n99\t * vocabulary — the annals envelope has no actor; it rides in `meta`. */\n100\texport interface Actor {\n101\t  type: string;\n102\t  /** Stable identity when known, e.g. git author email or model id. */\n103\t  id?: string;\n104\t  display?: string;\n105\t}\n106\t\n107\t/**\n108\t * cledger's producer view. Only `tool`/`version` live on the annals\n109\t * envelope; the rest is cledger vocabulary carried in `meta` — the\n110\t * translation in this module folds it back and forth so adapters and\n111\t * consumers keep one flat shape.\n112\t */\n113\texport interface Producer {\n114\t  tool: string;\n115\t  version?: string;\n116\t  /** Source system the content came from, e.g. \"claude-code\", \"codex\". */\n117\t  source?: string;\n118\t  /** The source system's own version, e.g. the coding CLI's. */\n119\t  source_version?: string;\n120\t  /** Model that served this turn, verbatim, only when the source states it. */\n121\t  model?: string;\n122\t  /** Inference provider serving `model`, verbatim, never inferred. */\n123\t  provider?: string;\n124\t  /** Source system's native session identifier. */\n125\t  session_id?: string;\n126\t}\n127\t\n128\texport type ProducerAgentContext = Pick<Producer, \"source_version\" | \"model\" | \"provider\">;\n129\t\n130\texport interface EvidenceEvent extends Omit<A.EvidenceEvent, \"producer\"> {\n131\t  actor: Actor;\n132\t  producer: Producer;\n133\t}\n134\t\n135\t/** Fields an adapter supplies; id/schema/recorded_at are filled at append. */\n136\texport type EventDraft = Omit<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\" | \"actor\"> &\n137\t  Partial<Pick<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\" | \"actor\">>;\n138\t\n139\tconst META_PRODUCER_KEYS = [\"source\", \"source_version\", \"model\", \"provider\", \"session_id\"] as const;\n140\t\n141\t/** Fold cledger vocabulary (actor, producer extras) into the annals meta. */\n142\texport function toAnnals(draft: EventDraft): A.EventDraft {\n143\t  const { actor, producer, meta, ...rest } = draft;\n144\t  const outMeta: Record<string, unknown> = { ...(meta ?? {}) };\n145\t  if (actor && outMeta[\"actor\"] === undefined) outMeta[\"actor\"] = actor;\n146\t  for (const key of META_PRODUCER_KEYS) {\n147\t    const value = producer[key];\n148\t    if (value !== undefined && outMeta[key] === undefined) outMeta[key] = value;\n149\t  }\n150\t  const outProducer: A.Producer = { tool: producer.tool };\n151\t  if (producer.version !== undefined) outProducer.version = producer.version;\n152\t  return {\n153\t    ...rest,\n154\t    producer: outProducer,\n155\t    ...(Object.keys(outMeta).length > 0 ? { meta: outMeta } : {}),\n156\t  } as A.EventDraft;\n157\t}\n158\t\n159\t/**\n160\t * Lift the flat cledger shape back out of an annals even