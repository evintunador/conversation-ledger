h;\n85\t  if (head) context.head = head;\n86\t  if (status.trim()) context.dirty_fingerprint = sha256Hex(status);\n87\t  return context;\n88\t}\n89\t\n90\tasync function readNoteLines(repo: RepoInfo, anchor: string, refName = NOTES_NAME): Promise<string[]> {\n91\t  const body = await git([\"notes\", \"--ref\", refName, \"show\", anchor], {\n92\t    cwd: repo.root,\n93\t    allowFailure: true,\n94\t  });\n95\t  return body.split(\"\\n\").filter((l) => l.trim().length > 0);\n96\t}\n97\t\n98\t/** `refName` defaults to the main ledger ref; the scan gate also reads a temp fetched ref. */\n99\texport async function readNoteEvents(\n100\t  repo: RepoInfo,\n101\t  anchor: string,\n102\t  refName = NOTES_NAME,\n103\t): Promise<EvidenceEvent[]> {\n104\t  return (await readNoteLines(repo, anchor, refName)).map(parseEventLine);\n105\t}\n106\t\n107\t/** All (anchor commit, note) pairs in the ledger ref (or `refName`, for reading a temp fetched ref). */\n108\texport async function listAnchors(repo: RepoInfo, refName = NOTES_NAME): Promise<string[]> {\n109\t  const out = await git([\"notes\", \"--ref\", refName, \"list\"], {\n110\t    cwd: repo.root,\n111\t    allowFailure: true,\n112\t  });\n113\t  return out\n114\t    .split(\"\\n\")\n115\t    .filter(Boolean)\n116\t    .map((line) => line.split(/\\s+/)[1])\n117\t    .filter((sha): sha is string => Boolean(sha));\n118\t}\n119\t\n120\tasync function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n121\t  await ensureStateDir(repo);\n122\t  const lockDir = join(stateDir(repo), \"lock\");\n123\t  const deadline = Date.now() + 10_000;\n124\t  for (;;) {\n125\t    try {\n126\t      await mkdir(lockDir);\n127\t      break;\n128\t    } catch {\n129\t      if (Date.now() > deadline) {\n130\t        // A crashed writer can leave the lock behind; steal it after the\n131\t        // wait budget rather than wedging capture hooks forever.\n132\t        await rm(lockDir, { recursive: true, force: true });\n133\t      } else {\