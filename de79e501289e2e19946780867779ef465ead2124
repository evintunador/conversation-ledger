ode stamps every\n148:  * transcript line with the CLI `version`, and labels assistant lines with the\n149:  * model that produced them; user lines carry no model, and none is invented\n150:  * for them — the model that will answer a prompt is not knowable from the\n151:  * prompt's own line, and the session's model can change mid-conversation.\n152:  * The provider is never stated (the same CLI can talk to the first-party API,\n153:  * Bedrock, or Vertex), so `provider` is left unset rather than assumed.\n154:  *\n155:  * Values pass through verbatim, including Claude Code's `\"<synthetic>\"`\n156:  * placeholder for harness-generated assistant messages: that is a true and\n157:  * useful statement about the turn (\"no model produced this\"), and rewriting\n158:  * it would be interpretation.\n159:  */\n160: function agentContext(line: ClaudeTranscriptLine): ProducerAgentContext {\n161:   const agent: ProducerAgentContext = {};\n162:   if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n163:   const model = line.message?.model;\n164:   if (typeof model === \"string\" && model) agent.model = model;\n165:   return agent;\n166: }\n167: \n168: /** Raw-only preservation event for an unrecognized claude-code line (see drift.ts). */\n169: function preserve(\n170:   type: string,\n171:   line: ClaudeTranscriptLine,\n172:   occurredAt: string,\n173:   seq: number,\n174:   fileSessionId: string,\n175:   version: string,\n176: ): EventDraft {\n177:   const sessionId = line.sessionId ?? fileSessionId;\n178:   return unrecognizedDraft({\n179:     typeKey: type,\n180:     line,\n181:     occurredAt,\n182:     source: \"claude-code\",\n183:     sessionId,\n184:     seq,\n185:     version,\n186:     rawFormat: RAW_FORMAT,\n187:     conversationId: `claude-code:${sessionId}`,\n188:     agent: agentContext(line),\n189:   });\n190: }\n191: \n192: function convertLine(\n193:   line: ClaudeTranscriptLine,\n194:   seq: number,\n195:   version: string,\n196:   identity: GitUserIdentity,\n197: ): EventDraft | null {\n198:   if (line.type !== \"user\" && line.type !== \"assistant\") return null;\n199:   if (line.isSidechain === true) return null;\n200:   if (!line.message) return null;\n201:   if (typeof line.timestamp !== \"string\") return null;\n202:   const sessionId = line.sessionId ?? \"\";\n203: \n204:   const actor: Actor = line.type === \"user\" ? { type: \"human\" } : { type: \"agent\" };\n205:   if (line.type === \"user\") {\n206:     if (identity.email) actor.id = identity.email;\n207:     if (identity.name) actor.display = identity.name;\n208:   }\n209:   if (line.type === \"assistant\" && line.message.model) actor.id = line.message.model;\n210: \n211:   return {\n212:     kind: \"conversation_turn\",\n213:     occurred_at: line.timestamp,\n214:     actor,\n215:     producer: {\n216:       tool: \"cledger\",\n217:       version,\n218:       source: \"claude-code\",\n219:       session_id: sessionId,\n220:       ...agentContext(line),\n221:     },\n222:     conversation: { id: `claude-code:${sessionId}`, seq },\n223:     content: { role: line.message.role, blocks: convertContentBlocks(line.message.content) },\n224:     raw: { format: RAW_FORMAT, data: line },\n225:   };\n226: }\n227: \n228: /**\n229:  * Re-normalization hook (see renormalize.ts): given a preserved\n230:  * `unrecognized` event this adapter's `producer.source` owns, try to turn its\n231:  * stored `raw.data` into the `conversation_turn` a live capture would produce.\n232:  *\n233:  * Id fidelity is the whole point: `convertLine` is fed the exact inputs the\n234:  * capture loop used — the same source line (`raw.data`), the same seq\n235:  * (`conversation.seq`), the same session id (carried in the line) — so the\n236:  * turn's identity subset, and therefore its id, is byte-identical to what a\n237:  * later live capture of the same line yields, and the two dedup instead of\n238:  * duplicating. `version`/`identity` are the current