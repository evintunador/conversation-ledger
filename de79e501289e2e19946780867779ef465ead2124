{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert\";\n3\timport { readFile, stat, writeFile } from \"node:fs/promises\";\n4\timport { existsSync } from \"node:fs\";\n5\timport { join } from \"node:path\";\n6\timport { git, type RepoInfo } from \"../git.js\";\n7\timport { absorbIncoming, ensureTransport, INCOMING_REF, NOTES_REF } from \"../transport.js\";\n8\timport { appendEvents, readEvents, ScanBlockedError, sync, transportPush } from \"../store.js\";\n9\timport { cleanupDir, cleanupRepo, draft, makeBareRepo, makeCommit, makeTempRepo } from \"./helpers.js\";\n10\t\n11\tfunction hookPath(repo: RepoInfo): string {\n12\t  return join(repo.gitDir, \"hooks\", \"pre-push\");\n13\t}\n14\t\n15\tasync function remoteHasNotesRef(repo: RepoInfo): Promise<boolean> {\n16\t  const out = await git([\"ls-remote\", \"origin\", NOTES_REF], { cwd: repo.root, allowFailure: true });\n17\t  return out.trim().length > 0;\n18\t}\n19\t\n20\ttest(\"ensureTransport: installs the pre-push hook and origin fetch refspec, idempotently\", async () => {\n21\t  const remote = await makeBareRepo();\n22\t  const repo = await makeTempRepo(\"cledger-transport-\");\n23\t  try {\n24\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n25\t\n26\t    const first = await ensureTransport(repo, {});\n27\t    assert.deepStrictEqual(first, { hook: \"installed\", refspec: \"added\" });\n28\t\n29\t    const script = await readFile(hookPath(repo), \"utf8\");\n30\t    assert.ok(script.includes(\"conversation-ledger pre-push\"));\n31\t    assert.ok(script.includes(\"transport-push\"));\n32\t    const mode = (await stat(hookPath(repo))).mode;\n33\t    assert.ok(mode & 0o111, \"hook must be executable\");\n34\t\n35\t    const fetchSpecs = await git([\"config\", \"--get-all\", \"remote.origin.fetch\"], { cwd: repo.root });\n36\t    assert.ok(fetchSpecs.includes(`+${NOTES_REF}:${INCOMING_REF}`));\n37\t\n38\t