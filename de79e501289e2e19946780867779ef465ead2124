asename(transcriptPath, \".jsonl\");\n286:   let cursor = await readCursor(repo, sessionId);\n287:   if (cursor > lines.length) cursor = 0; // transcript is shorter than expected — rescan from the start\n288: \n289:   const version = packageVersion();\n290:   const identity = await gitUserIdentity(repo);\n291:   let baseTime: string | null = null; // computed lazily, only if a timestampless unrecognized line needs it\n292:   const drafts: EventDraft[] = [];\n293:   for (let i = cursor; i < lines.length; i++) {\n294:     const text = lines[i]!;\n295:     if (!text.trim()) continue;\n296:     let parsed: ClaudeTranscriptLine;\n297:     try {\n298:       parsed = JSON.parse(text) as ClaudeTranscriptLine;\n299:     } catch {\n300:       continue; // partial line — normal at the tail of a live transcript\n301:     }\n302:     const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n303:     if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n304:       if (!KNOWN_SKIPPED_LINE_TYPES.has(type)) {\n305:         countUnrecognized(result.unrecognized, type);\n306:         if (baseTime === null) baseTime = firstTimestamp(lines) ?? (await sessionMtime(transcriptPath));\n307:         const occurredAt = typeof parsed.timestamp === \"string\" ? parsed.timestamp : baseTime;\n308:         drafts.push(preserve(type, parsed, occurredAt, i, sessionId, version));\n309:       }\n310:       continue;\n311:     }\n312:     const draft = convertLine(parsed, i, version, identity);\n313:     if (draft) drafts.push(draft);\n314:   }\n315: \n316:   if (drafts.length > 0) {\n317:     const appendResult = await appendEvents(repo, drafts);\n318:     result.appended = appendResult.appended.length;\n319:     result.deduped = appendResult.deduped;\n320:   }\n321:   await writeCursor(repo, sessionId, lines.length);\n322:   process.stderr.write(\n323:     `cledger: claude-code +${result.appended} events (${result.deduped} deduped)\\n`,\n324:   );\n325:   warnUnrecognized(\"claude-code\", re