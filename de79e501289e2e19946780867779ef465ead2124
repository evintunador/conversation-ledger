flags };\n108\t}\n109\t\n110\tasync function requireRepo(): Promise<RepoInfo> {\n111\t  const repo = await findRepo(process.cwd());\n112\t  if (!repo) {\n113\t    process.stderr.write(\"cledger: not inside a git repository\\n\");\n114\t    process.exit(2);\n115\t  }\n116\t  return repo;\n117\t}\n118\t\n119\tasync function readStdin(): Promise<string> {\n120\t  const chunks: Buffer[] = [];\n121\t  for await (const chunk of input) chunks.push(chunk as Buffer);\n122\t  return Buffer.concat(chunks).toString(\"utf8\");\n123\t}\n124\t\n125\tfunction readOptionsFrom(flags: Flags): ReadOptions {\n126\t  const opts: ReadOptions = {};\n127\t  if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n128\t  if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n129\t  if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n130\t  if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n131\t  return opts;\n132\t}\n133\t\n134\tfunction snippet(event: EvidenceEvent): string {\n135\t  const c = event.content as Record<string, unknown> | string | null;\n136\t  let text = \"\";\n137\t  if (typeof c === \"string\") text = c;\n138\t  else if (c && typeof c === \"object\") {\n139\t    text = String(c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"] ?? JSON.stringify(c));\n140\t  }\n141\t  text = text.replace(/\\s+/g, \" \").trim();\n142\t  return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n143\t}\n144\t\n145\tfunction printHuman(events: EvidenceEvent[]): void {\n146\t  for (const e of events) {\n147\t    const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n148\t    const role =\n149\t      (e.content as Record<string, unknown> | null | undefined) &&\n150\t      typeof e.content === \"object\"\n151\t        ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n152\t        : e.actor.type;\n153\t    process.stdout.write(\n154\t      `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n155\t    );\n156\t  }\n157\t}\n158\t\n159\t/**\n160\t * `reasoning` events are opaque ciphertext, never meant for a human-facing\n161\t * transcript — `log`/`show` hide them by default. `--with-reasoning` opts\n162\t * in, as does asking for the kind explicitly via `--kind reasoning` (hiding\n163\t * them there would just return nothing). `export`'s job is a lossless dump,\n164\t * so it never filters by kind and needs no equivalent flag.\n165\t */\n166\tfunction includeReasoning(flags: Flags, opts: ReadOptions): boolean {\n167\t  return flags[\"with-reasoning\"] === true || opts.kind === \"reasoning\";\n168\t}\n169\t\n170\tfunction hideOpaqueReasoning(events: EvidenceEvent[]): EvidenceEvent[] {\n171\t  return events.filter((e) => e.kind !== \"reasoning\");\n172\t}\n173\t\n174\tfunction printJsonl(events: EvidenceEvent[], includeRaw: boolean): void {\n175\t  for (const e of events) {\n176\t    const out = includeRaw ? e : { ...e, raw: undefined };\n177\t    process.stdout.write(JSON.stringify(out) + \"\\n\");\n178\t  }\n179\t}\n180\t\n181\tasync function cmdAppend(flags: Flags): Promise<void> {\n182\t  const repo = await requireRepo();\n183\t  const body = await readStdin();\n184\t  const drafts: EventDraft[] = body\n185\t    .split(\"\\n\")\n186\t    .filter((l) => l.trim())\n187\t    .map((l) => JSON.parse(l) as EventDraft);\n188\t  if (drafts.length === 0) return;\n189\t  const result = await appendEvents(repo, drafts);\n190\t  if (!flags[\"quiet\"]) {\n191\t    for (const e of result.appended) process.stdout.write(e.id + \"\\n\");\n192\t    process.stderr.write(\n193\t      `appended ${result.appended.length}, deduped ${result.deduped}` +\n194\t        (result.anchor ? ` (anchor ${result.anchor.slice(0, 12)})` : \" (pending: no commits yet)\") +\n195\t        \"\\n\",\n196\t    );\n197\t  }\n198\t}\n199\t\n200\tasync function cmdLog(fl