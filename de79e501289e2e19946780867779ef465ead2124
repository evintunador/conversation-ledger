hed ref). */\n114: export async function listAnchors(repo: RepoInfo, refName = NOTES_NAME): Promise<string[]> {\n115:   const out = await git([\"notes\", \"--ref\", refName, \"list\"], {\n116:     cwd: repo.root,\n117:     allowFailure: true,\n118:   });\n119:   return out\n120:     .split(\"\\n\")\n121:     .filter(Boolean)\n122:     .map((line) => line.split(/\\s+/)[1])\n123:     .filter((sha): sha is string => Boolean(sha));\n124: }\n125: \n126: async function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n127:   await ensureStateDir(repo);\n128:   const lockDir = join(stateDir(repo), \"lock\");\n129:   const deadline = Date.now() + 10_000;\n130:   for (;;) {\n131:     try {\n132:       await mkdir(lockDir);\n133:       break;\n134:     } catch {\n135:       if (Date.now() > deadline) {\n136:         // A crashed writer can leave the lock behind; steal it after the\n137:         // wait budget rather than wedging capture hooks forever.\n138:         await rm(lockDir, { recursive: true, force: true });\n139:       } else {\n140:         await new Promise((r) => setTimeout(r, 100));\n141:       }\n142:     }\n143:   }\n144:   try {\n145:     return await fn();\n146:   } finally {\n147:     await rm(lockDir, { recursive: true, force: true });\n148:   }\n149: }\n150: \n151: export interface AppendResult {\n152:   appended: EvidenceEvent[];\n153:   deduped: number;\n154:   /** null when events went to the pending queue (unborn HEAD). */\n155:   anchor: string | null;\n156: }\n157: \n158: export async function appendEvents(\n159:   repo: RepoInfo,\n160:   drafts: EventDraft[],\n161:   opts: { context?: RepoContext; anchor?: string } = {},\n162: ): Promise<AppendResult> {\n163:   const config = await loadConfig(repo.root);\n164:   // Master per-repo switch: skip everything, including the transport wiring\n165:   // below, so a disabled repo's ledger ref is never even touched.\n166:   if (config.enabled === false) {\n167:     return { appended: [], deduped: 0, anchor: null };\n168:   }\n169:   const context = opts.context ?? (await captureContext(repo));\n170:   // First capture in a repo wires up transport (pre-push hook + fetch\n171:   // refspec); later calls are cheap re-checks. Never throws.\n172:   await ensureTransport(repo, config);\n173:   const rules = captureRules(config);\n174:   // Exact-value scrubbing layers, each tagged with its own rule id for the\n175:   // audit trail. Only consulted when capture redaction is active at all\n176:   // (rules.length > 0); known-secrets additionally requires its opt-in flag.\n177:   const extraValues: ExtraValueGroup[] = [];\n178:   if (rules.length > 0) {\n179:     if (config.redact?.knownSecrets === true) {\n180:       const known = await loadKnownSecrets(repo);\n181:       if (known.length > 0) extraValues.push({ ruleId: \"known-secret\", values: known });\n182:     }\n183:     if (config.redact?.env === true) {\n184:       const env = await collectEnvValues(repo.root);\n185:       if (env.length > 0) extraValues.push({ ruleId: \"env-value\", values: env });\n186:     }\n187:   }\n188:   const events = drafts.map((draft) => {\n189:     const withContext = { ...draft, context: draft.context ?? context };\n190:     if (rules.length === 0) return finalizeEvent(withContext);\n191:     const { draft: redacted, records } = redactDraft(withContext, {\n192:       rules,\n193:       ...(extraValues.length > 0 ? { extraValues } : {}),\n194:     });\n195:     return finalizeEvent(records.length > 0 ? { ...redacted, redactions: records } : redacted);\n196:   });\n197:   return withLock(repo, async () => {\n198:     await ensureMergeConfig(repo);\n199:     // Almost everything anchors to HEAD at capture time; re-anchor mapping\n200:     // events override this to anchor at the successor commit so the mapping\n201:     // rides the surviving branch's DAG regardless of where it was created.\n202:     const anchor = opts.anchor ?? (await headSha(repo));\n203:     if (!anchor) {\n204:       return appendPending(repo, events);\n205:     }\n206:     const pending = await drainPending(repo);\n207:     const existing = await readNoteLines(repo, anchor);\n208:     const known = new Set(existing.map((l) => parseEventLine(l).id));\n209:     const fresh = [...pending, ...events].filter((e) => {\n210:       if (known.has(e.id)) return false;\n211:       known.add(e.id);\n212:       return true;\n213:     });\n214:     if (fresh.length === 0) {\n215:       return { appended: [], deduped: events.length, anchor };\n216:     }\n217:     const lines = [...existing, ...fresh.map(serializeEvent)].sort();\n218:     await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n219:       cwd: repo.root,\n220:       input: lines.join(\"\\n\") + \"\\n\",\n221:     });\n222:     const freshIds = new Set(fresh.map((e) => e.id));\n223:     return {\n224:       appended: events.filter((e) => freshIds.has(e.id)),\n225:       deduped: events.length - events.filter((e) => freshIds.has(e.id)).length,\n226:       anchor,\n227:     };\n228:   });\n229: }\n230: \n231: async function appendPending(repo: RepoInfo, events: EvidenceEvent[]): Promise<AppendResult> {\n232:   await ensureStateDir(repo);\n233:   const path = pendingPath(repo);\n234:   const existing = existsSync(path)\n235:     ? (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean)\n236:     : [];\n237:   const known = new Set(existing.map((l) => parseEventLine(l).id));\n238:   const fresh = events.filter((e) => !known.has(e.id));\n239:   await writeFile(path, [...existing, ...fresh.map(serializeEvent)].join(\"\\n\") + \"\\n\");\n240:   return { appended: fresh, deduped: events.length - fresh.length, anchor: null };\n241: }\n242: \n243: /** Events held while HEAD was unborn; caller writes them into a real note. */\n244: async function drainPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n245:   const path = pendingPath(repo);\n246:   if (!existsSync(path)) return [];\n247:   const events = (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n248:   await rm(path, { force: true });\n249:   return events;\n250: }\n251: \n252: export async function readPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n253:   const path = pendingPath(repo);\n254:   if (!existsSync(path)) return [];\n255:   return (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n256: }\n257: \n258: export interface ReadOptions {\n259:   /** Restrict to events anchored to commits reachable from this rev. */\n260:   reachableFrom?: string;\n261:   kind?: string;\n262:   source?: string;\n263:   /**\n264:    * Exact match on `producer.model`. Events the source never labelled with a\n265:    * model (human turns in most transcripts, cledger's own bookkeeping events)\n266:    * have no model and are therefore excluded by this filter, rather than\n267:    * being folded in on a guess about which model they belong to.\n268:    */\n269:   model?: string;\n270:   conversation?: string;\n271: }\n272: \n273: export async function readEvents(repo: RepoInfo, opts: ReadOptions = {}): Promise<EvidenceEvent[]> {\n274:   // Lazy transport: fold in anything a plain `git fetch`/`git pull` staged.\n275:   await absorbIncoming(repo);\n276:   // Lazy re-anchoring, same shape: if the fetch revealed that the remote\n277:   // target branch rewrote noted commits (squash merge), map them before\n278:   // filtering by reachability below.\n279:   await autoReAnchor(repo);\n280:   let anchors = await listAnchors(repo);\n281:   const noteCache = new Map<string, EvidenceEvent[]>();\n282:   const readNote = async (anchor: string): Promise<EvidenceEvent[]> => {\n283:     let events = noteCache.get(anchor);\n284:     if (!events) {\n285:       events = await readNoteEvents(repo, anchor);\n286:       noteCache.set(anchor, events);\n287:     }\n288:     return events;\n289:   };\n290:   if (opts.reachableFrom) {\n291:     anchors = await resolveAnchors(repo, anchors, opts.reachableFrom, readNote);\n292:   }\n293:   const events: EvidenceEvent[] = [];\n294:   for (const anchor of anchors) {\n295:     events.push(...(await readNote(anchor)));\n296:   }\n297:   events.push(...(await readPending(repo)));\n298:   const filtered = events.filter(\n299:     (e) =>\n300:       (!opts.kind || e.kind === opts.kind) &&\n301:       (!opts.source || e.producer.source === opts.source) &&\n302:       (!opts.model || e.producer.model === opts.model) &&\n303:       (!opts.conversation || e.conversation?.id === opts.conversation ||\n304:         e.conversation?.id.startsWith(opts.conversation)),\n305:   );\n306:   return sortEvents(dedupById(filtered));\n307: }\n308: \n309: /**\n310:  * Collapse events that share an id but live under different anchor commits.\n311:  *\n312:  * Append-time dedup only ever consults the note of the commit being written\n313:  * to (see `appendEvents`), so it cannot see a copy filed under a different\n314:  * anchor. Any capture that re-reads transcript lines it already ingested\n315:  * *after* HEAD moved therefore files a second copy of the same events against\n316:  * the new HEAD — and once both anchors are reachable, reads returned the turn\n317:  * twice. Worktrees made this routine before capture cursors became shared\n318:  * (they were per-worktree, so entering or leaving one restarted the scan),\n319:  * but it is not worktree-specific: a forced rescan does it too, and the\n320:  * duplicates already written this way are permanent, since the ledger is\n321:  * append-only.\n322:  *\n323:  * Identical ids mean identical *identity* fields by construction, so the\n324:  * copies differ only in provenance the id excludes — `recorded_at`, the\n325:  * `context` captured at the time, `raw`. The earliest `recorded_at` wins as\n326:  * the original capture, with the canonical serialization as a tie-break so\n327:  * every clone independently picks the same one.\n328:  */\n329: function dedupById(events: EvidenceEvent[]): EvidenceEvent[] {\n330:   const byId = new Map<string, EvidenceEvent>();\n331:   for (const event of events) {\n332:     const seen = byId.get(event.id);\n333:     if (!seen) {\n334:       byId.set(event.id, event);\n335:       continue;\n336:     }\n337:     if (event.recorded_at < seen.recorded_at) byId.set(event.id, event);\n338:     else if (event.recorded_at === seen.recorded_at) {\n339:       if (canonicalJson(event) < canonicalJson(seen)) byId.set(event.id, event);\n340:     }\n341:   }\n342:   return [...byId.values()];\n343: }\n344: \n345: /**\n346:  * Reachability with re-anchor resolution. Plain reachability drops any\n347:  * conversation whose anchor commit was rewritten away (a GitHub squash merge\n348:  * discards the branch's commits, so their notes fall out of `rev-list` even\n349:  * though the work survives in the squash commit). A `re_anchor` event —\n350:  * anchored to the successor commit, so it is discoverable exactly when the\n351:  * successor is in view — repairs this: an anchor counts as reachable when the\n352:  * rev reaches it, or when a mapping whose successor is reachable names it as\n353:  * superseded. Superseded commits can themselves anchor further mappings\n354:  * (a squash commit later rewritten again), so resolution loops to a fixpoint:\n355:  * grow the reachable set, read the notes that just became visible, repeat.\n356:  * The set only grows and each note is read once, so it terminates.\n357:  */\n358: async function resolveAnchors(\n359:   repo: RepoInfo,\n360:   anchors: string[],\n361:   rev: string,\n362:   readNote: (anchor: string) => Promise<EvidenceEvent[]>,\n363: ): Promise<string[]> {\n364:   const reachable = await revList(repo, rev);\n365:   const visited = new Set<string>();\n366:   const mappings: ReAnchorMapping[] = [];\n367:   for (;;) {\n368:     const frontier = anchors.filter((a) => reachable.has(a) && !visited.has(a));\n369:     for (const anchor of frontier) {\n370:       visited.add(anchor);\n371:       for (const event of await readNote(anchor)) {\n372:         const mapping = parseReAnchor(event);\n373:         if (mapping) mappings.push(mapping);\n374:       }\n375:     }\n376:     let grew = false;\n377:     for (const mapping of mappings) {\n378:       // A mapping only applies once its successor is in view; one pointing\n379:       // at an unreachable successor (e.g. asserted from another branch)\n380:       // changes nothing here.\n381:       if (!reachable.has(mapping.successor)) continue;\n382:       for (const sha of mapping.superseded) {\n383:         if (!reachable.has(sha)) {\n384:           reachable.add(sha);\n385:           grew = true;\n386:         }\n387:       }\n388:     }\n389:     if (frontier.length === 0 && !grew) break;\n390:   }\n391:   return anchors.filter((a) => reachable.has(a));\n392: }\n393: \n394: /** Commits carrying notes, and the commits existing mappings already supersede. */\n395: async function reAnchorState(\n396:   repo: RepoInfo,\n397: ): Promise<{ anchors: Set<string>; alreadySuperseded: Set<string> }> {\n398:   const anchors = new Set(await listAnchors(repo));\n399:   const alreadySuperseded = new Set<string>();\n400:   for (const anchor of anchors) {\n401:     for (const event of await readNoteEvents(repo, anchor)) {\n402:       const mapping = parseReAnchor(event);\n403:       if (mapping) for (const sha of mapping.superseded) alreadySuperseded.add(sha);\n404:     }\n405:   }\n406:   return { anchors, alreadySuperseded };\n407: }\n408: \n409: export interface ReAnchorRunResult {\n410:   /** Rev the detection compared against, or null when none could be resolved. */\n411:   target: string | null;\n412:   detected: DetectedRewrite[];\n413:   ambiguous: string[];\n414:   /** Noted, rewritten-looking branches exact matching could not map. */\n415:   unmatched: UnmatchedBranch[];\n416:   /** Mapping events actually appended — empty on dry runs and re-runs. */\n417:   applied: EvidenceEvent[];\n418: }\n419: \n420: /**\n421:  * One detection pass against `target` (default: the remote default branch),\n422:  * optionally appending the proposed exact mappings, each anchored to its\n423:  * successor commit. Re-running is a no-op: commits an existing mapping\n424:  * covers are excluded from detection, and identical mapping events dedup by\n425:  * id anyway. Ambiguous branches are reported, never guessed at.\n426:  */\n427: export async function runReAnchor(\n428:   repo: RepoInfo,\n429:   opts: { target?: string; apply: boolean },\n430: ): Promise<ReAnchorRunResult> {\n431:   const target = opts.target ?? (await defaultRewriteTarget(repo));\n432:   if (!target) return { target: null, detected: [], ambiguous: [], unmatched: [], applied: [] };\n433:   const { anchors, alreadySuperseded } = await reAnchorState(repo);\n434:   if (anchors.size === 0) return { target, detected: [], ambiguous: [], unmatched: [], applied: [] };\n435:   const { detected, ambiguous, unmatched } = await detectRewrites(repo, {\n436:     target,\n437:     anchors,\n438:     alreadySuperseded,\n439:   });\n440:   const applied: EvidenceEvent[] = [];\n441:   if (opts.apply) {\n442:     for (const rewrite of detected) {\n443:       const result = await appendEvents(repo, [reAnchorDraft(rewrite.mapping)], {\n444:         anchor: rewrite.mapping.successor,\n445:       });\n446:       applied.push(...result.appended);\n447:     }\n448:   }\n449:   return { target, detected, ambiguous, unmatched, applied };\n450: }\n451: \n452: /**\n453:  * Manual mapping — the escape hatch for everything mechanical matching\n454:  * cannot assert: a maintainer edited during the squash, the branch is long\n455:  * gone, an ambiguous match needed a human eye. Asserted by the user, so the\n456:  * actor is the user (two humans asserting the same mapping yield two\n457:  * events; honest provenance, and the reads they affect are identical).\n458:  */\n459: export async function manualReAnchor(\n460:   repo: RepoInfo,\n461:   supersededRevs: string[],\n462:   ontoRev: string,\n463: ): Promise<{ event: EvidenceEvent | null; superseded: string[]; successor: string }> {\n464:   const resolve = async (rev: string): Promise<string> => {\n465:     const sha = (await git([\"rev-parse\", \"--verify\", \"--quiet\", `${rev}^{commit}`], {\n466:       cwd: repo.root,\n467:       allowFailure: true,\n468:     })).trim();\n469:     if (!sha) throw new Error(`cledger re-anchor: cannot resolve \"${rev}\" to a commit`);\n470:     return sha;\n471:   };\n472:   const successor = await resolve(ontoRev);\n473:   const superseded = [];\n474:   for (const rev of supersededRevs) {\n475:     // A superseded commit may already be GC'd (its branch deleted long ago)\n476:     // — the mapping is how its still-enumerable note stays meaningful — so a\n477:     // full SHA is taken at its word; only shorthand needs a live object.\n478:     superseded.push(/^[0-9a-f]{40}$/.test(rev) ? rev : await resolve(rev));\n479:   }\n480: \n481:   const identity = await gitUserIdentity(repo);\n482:   const actor: Actor = { type: \"human\" };\n483:   if (identity.email) actor.id = identity.email;\n484:   if (identity.name) actor.display = identity.name;\n485: \n486:   const result = await appendEvents(\n487:     repo,\n488:     [\n489:       reAnchorDraft({\n490:         superseded,\n491:         successor,\n492:         method: \"manual\",\n493:         occurredAt: await commitDateIso(repo, successor),\n494:         actor,\n495:       }),\n496:     ],\n497:     { anchor: successor },\n498:   );\n499:   // null means an identical mapping already exists — dedup, not failure.\n500:   return { event: result.appended[0] ?? null, superseded, successor };\n501: }\n502: \n503: /**\n504:  * Default-on half of re-anchoring (config: {\"reanchor\": {\"auto\": false}} to\n505:  * disable): runs inside every read, right after absorbIncoming, so a plain\n506:  * `git fetch` + `cledger log` is enough for a squash-merged branch's\n507:  * conversations to follow the squash commit. The detection pass costs a\n508:  * handful of subprocesses per local branch, so it is gated on a cursor over\n509:  * the target tip and only runs when the target actually moved. Never throws\n510:  * — a read must never fail because detection did. The known gap the cursor\n511:  * accepts: conversations captured onto an already-dead branch after the\n512:  * target was seen won't auto-map until the target moves again — `cledger\n513:  * re-anchor` covers that manually.\n514:  */\n515: async function autoReAnchor(repo: RepoInfo): Promise<void> {\n516:   try {\n517:     const config = await loadConfig(repo.root);\n518:     if (config.reanchor?.auto === false) return;\n519:     const target = await defaultRewriteTarget(repo);\n520:     if (!target) return;\n521:     const tip = (await git([\"rev-parse\", \"--verify\", \"--quiet\", target], {\n522:       cwd: repo.root,\n523:       allowFailure: true,\n524:     })).trim();\n525:     if (!tip) return;\n526:     const cursorPath = join(stateDir(repo), \"reanchor-cursor\");\n527:     let seen = \"\";\n528:     try {\n529:       seen = (await readFile(cursorPath, \"utf8\")).trim();\n530:     } catch {\n531:       // first run, or unreadable state — state is rebuildable\n532:     }\n533:     if (seen === tip) return;\n534:     const result = await runReAnchor(repo, { target, apply: true });\n535:     if (result.applied.length > 0) {\n536:       const anchors = result.detected.reduce((n, d) => n + d.notedAnchors, 0);\n537:       process.stderr.write(\n538:         `cledger: re-anchored ${anchors} conversation anchor(s) rewritten away by ${target} ` +\n539:           `(mappings recorded in the ledger)\\n`,\n540:       );\n541:     }\n542:     if (result.ambiguous.length > 0) {\n543:       process.stderr.write(\n544:         `cledger: branch(es) ${result.ambiguous.join(\", \")} look rewritten onto ${target} but ` +\n545:           `match more than one commit — run \\`cledger re-anchor\\` to resolve manually\\n`,\n546:       );\n547:     }\n548:     await ensureStateDir(repo);\n549:     await writeFile(cursorPath, tip + \"\\n\");\n550:   } catch {\n551:     // Reads must never fail because detection did.\n552:   }\n553: }\n554: \n555: /** Stable order: conversation, then seq, then time, then id. */\n556: export function sortEvents(events: EvidenceEvent[]): EvidenceEvent[] {\n557:   return [...events].sort((a, b) => {\n558:     const conv = (a.conversation?.id ?? \"\").localeCompare(b.conversation?.id ?? \"\");\n559:     if (conv !== 0) return conv;\n560:     const seq = (a.conversation?.seq ?? 0) - (b.conversation?.seq ?? 0);\n561:     if (seq !== 0) return seq;\n562:     const time = a.occurred_at.localeCompare(b.occurred_at);\n563:     if (time !== 0) return time;\n564:     return a.id.localeCompare(b.id);\n565:   });\n566: }\n567: \n568: export interface SyncResult {\n569:   fetched: boolean;\n570:   pushed: boolean;\n571:   /**\n572:    * Anchors whose conversations this push was scoped to, or null when the\n573:    * push was unscoped (`--all`). Length is the anchor count, not the event\n574:    * count.\n575:    */\n576:   scopedAnchors: number | null;\n577: }\n578: \n579: /**\n580:  * The anchors a push from `rev` should carry: exactly the set a read at that\n581:  * rev resolves to.\n582:  *\n583:  * Storage is per-commit and reads are per-branch, but a push is per-*ref* and\n584:  * a ref carries the whole notes database — so until 0.14.0 pushing any branch\n585:  * shipped every branch's conversations. Scoping the push to the same anchors\n586:  * `readEvents({reachableFrom: rev})` would return makes distribution agree\n587:  * with visibility: what you can see from a branch is what pushing that branch\n588:  * shares.\n589:  *\n590:  * Reusing `resolveAnchors` rather than a plain `git rev-list` is what makes\n591:  * this survive squash merges. A squash discards the source branch's commits,\n592:  * so its conversations sit on anchors unreachable from the target; the\n593:  * re_anchor mapping events that repair this are themselves anchored to the\n594:  * *surviving* commit, and `resolveAnchors` walks them transitively to pull\n595:  * the orphaned anchors back into view. A rev-list-only scope would silently\n596:  * drop precisely the conversations re-anchoring exists to save — and would\n597:  * push the mapping events describing them while leaving the events they\n598:  * point at behind.\n599:  */\n600: async function anchorsForRevs(repo: RepoInfo, revs: string[]): Promise<string[]> {\n601:   const anchors = await listAnchors(repo);\n602:   const noteCache = new Map<string, EvidenceEvent[]>();\n603:   const readNote = async (anchor: string): Promise<EvidenceEvent[]> => {\n604:     let events = noteCache.get(anchor);\n605:     if (!events) {\n606:       events = await readNoteEvents(repo, anchor);\n607:       noteCache.set(anchor, events);\n608:     }\n609:     return events;\n610:   };\n611:   // Union across revs: `git push origin a b` should share both branches, and\n612:   // resolving each separately keeps each one's re_anchor mappings applied in\n613:   // its own reachability context rather than in a merged one.\n614:   const union = new Set<string>();\n615:   for (const rev of revs) {\n616:     for (const anchor of await resolveAnchors(repo, anchors, rev, readNote)) union.add(anchor);\n617:   }\n618:   return [...union];\n619: }\n620: \n621: /**\n622:  * Push `anchors`' notes to the remote's ledger ref without disturbing\n623:  * anything already there.\n624:  *\n625:  * The subtlety that makes this non-obvious: a notes ref is a *snapshot of the\n626:  * whole database*, not an append log. Its tip commit's tree maps every\n627:  * annotated commit to its note, so whatever tree you push becomes the\n628:  * remote's entire notes database. Pushing a tree containing only this\n629:  * branch's notes would therefore delete every other branch's — they would\n630:  *