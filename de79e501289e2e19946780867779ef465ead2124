{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { mkdir, readFile, rm, writeFile } from \"node:fs/promises\";\n2\timport { existsSync } from \"node:fs\";\n3\timport { join } from \"node:path\";\n4\timport { sha256Hex } from \"./canonical.js\";\n5\timport {\n6\t  currentBranch,\n7\t  git,\n8\t  headSha,\n9\t  repoIdentity,\n10\t  revList,\n11\t  statusPorcelain,\n12\t  type RepoInfo,\n13\t} from \"./git.js\";\n14\timport {\n15\t  finalizeEvent,\n16\t  parseEventLine,\n17\t  serializeEvent,\n18\t  type EventDraft,\n19\t  type EvidenceEvent,\n20\t  type RepoContext,\n21\t} from \"./schema.js\";\n22\t\n23\texport const NOTES_NAME = \"conversation-ledger\";\n24\texport const NOTES_REF = `refs/notes/${NOTES_NAME}`;\n25\t\n26\t/**\n27\t * Storage model: one git note per anchor commit under refs/notes/\n28\t * conversation-ledger. The note body is JSONL — one canonical-JSON event\n29\t * per line, lexicographically sorted, unique. Everything lives in the note\n30\t * blob itself (no out-of-tree pointers), so records are reachable from the\n31\t * ref, GC-safe, travel with `git push`/`fetch` of that one ref, and merge\n32\t * conflict-free with the cat_sort_uniq notes strategy.\n33\t *\n34\t * Events are anchored to HEAD at capture time, so conversations ride the\n35\t * commit DAG: merge a branch and its conversations become reachable from\n36\t * the target branch with no extra machinery.\n37\t */\n38\t\n39\tfunction stateDir(repo: RepoInfo): string {\n40\t  return join(repo.gitDir, \"conversation-ledger\");\n41\t}\n42\t\n43\tfunction pendingPath(repo: RepoInfo): string {\n44\t  return join(stateDir(repo), \"pending.jsonl\");\n45\t}\n46\t\n47\t/** Local, rebuildable cache/state only — never the record of truth. */\n48\tasync function ensureStateDir(repo: RepoInfo): Promise<void> {\n49\t  await mkdir(stateDir(repo), { recursive: true });\n50\t}\n51\t\n52\texport async function ensureMergeConfig(repo: RepoInfo): Promise<void> {\n53\t  const key = `notes.${NOTES_NAME}.mergeStrategy`;\n54\t  const current = (await git([\"config\", \"--get\", key], {\n55\t    cwd: repo.root,\n56\t    allowFailure: true,\n57\t  })).trim();\n58\t  if (current !== \"cat_sort_uniq\") {\n59\t    await git([\"config\", key, \"cat_sort_uniq\"], { cwd: repo.root });\n60\t  }\n61\t}\n62\t\n63\texport async function captureContext(repo: RepoInfo): Promise<RepoContext> {\n64\t  const [identity, branch, head, status] = await Promise.all([\n65\t    repoIdentity(repo),\n66\t    currentBranch(repo),\n67\t    headSha(repo),\n68\t    statusPorcelain(repo),\n69\t  ]);\n70\t  const context: RepoContext = { repo: identity, cwd: repo.root };\n71\t  if (branch) context.branch = branch;\n72\t  if (head) context.head = head;\n73\t  if (status.trim()) context.dirty_fingerprint = sha256Hex(status);\n74\t  return context;\n75\t}\n76\t\n77\tasync function readNoteLines(repo: RepoInfo, anchor: string): Promise<string[]> {\n78\t  const body = await git([\"notes\", \"--ref\", NOTES_NAME, \"show\", anchor], {\n79\t    cwd: repo.root,\n80\t    allowFailure: true,\n81\t  });\n82\t  return body.split(\"\\n\").filter((l) => l.trim().length > 0);\n83\t}\n84\t\n85\texport async function readNoteEvents(repo: RepoInfo, anchor: string): Promise<EvidenceEvent[]> {\n86\t  return (await readNoteLines(repo, anchor)).map(parseEventLine);\n87\t}\n88\t\n89\t/** All (anchor commit, note) pairs in the ledger ref. */\n90\texport async function listAnchors(repo: RepoInfo): Promise<string[]> {\n91\t  const out = await git([\"notes\", \"--ref\", NOTES_NAME, \"list\"], {\n92\t    cwd: repo.root,\n93\t    allowFailure: true,\n94\t  });\n95\t  return out\n96\t    .split(\"\\n\")\n97\t    .filter(Boolean)\n98\t    .map((line) => line.split(/\\s+/)[1])\n99\t    .filter((sha): sha is string => Boolean(sha));\n100\t}\n101\t\n102\tasync function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n103\t  await ensureStateDir(repo);\n104\t  const lockDir = join(stateDir(repo), \"lock