rift handling shared by adapters. Adapters are tolerant parsers:\n * a line type in neither the convertible set nor the deliberately-skipped set\n * is *unrecognized* — most likely new upstream content this cledger version\n * has no mapping for. Two things happen for such a line:\n *\n *  1. It is counted per type and surfaced in a capture-time warning (the\n *     drift tripwire — \"the format changed, update cledger\").\n *  2. It is preserved raw-only as an `unrecognized` event (see\n *     `unrecognizedDraft`) instead of being dropped, so a later adapter\n *     version can re-normalize the line rather than lose it forever.\n *\n * Preservation events ride the normal append path, so the capture-time\n * redaction stack walks their `raw.data` exactly as it does interpreted\n * events — an unrecognized line is not a hole in secret redaction.\n */\n\nimport type { EventDraft } from \"../schema.js\";\n\nexport interface CaptureResult {\n  appended: number;\n  deduped: number;\n  /** Skipped-line tallies keyed by unrecognized type, e.g. {\"response_item/agent_message\": 3}. */\n  unrecognized: Record<string, number>;\n}\n\nexport function countUnrecognized(unrecognized: Record<string, number>, key: string): void {\n  unrecognized[key] = (unrecognized[key] ?? 0) + 1;\n}\n\n/**\n * Build the raw-only preservation event for one unrecognized transcript line.\n *\n * `content` holds only the type label — the ledger did not interpret the\n * line, so it claims no roles, no actor identity (actor is `system`), no\n * structured blocks. The full source line lives under `raw.data`, versioned\n * by `rawFormat` so a future adapter knows which native shape to re-parse.\n *\n * Identity: `raw` is excluded from the event id, but that is fine here —\n * `conversation.seq` (the source line index, part of the identity subset)\n * already makes distinct lines distinct and re-scans of the same line\n * idempotent, the same guarantee interpreted turns rely on. Keeping the\n * format marker in `raw` therefore means format-version bumps never churn\n * ids, matching every other event kind.\n */\nexport function unrecognizedDraft(params: {\n  typeKey: string;\n  line: unknown;\n  occurredAt: string;\n  source: string;\n  sessionId: string;\n  seq: number;\n  version: string;\n  rawFormat: string;\n  conversationId: string;\n}): EventDraft {\n  return {\n    kind: \"unrecognized\",\n    occurred_at: params.occurredAt,\n    actor: { type: \"system\" },\n    producer: {\n      tool: \"cledger\",\n      version: params.version,\n      source: params.source,\n      session_id: params.sessionId,\n    },\n    conversation: { id: params.conversationId, seq: params.seq },\n    content: { unrecognized_type: params.typeKey },\n    raw: { format: params.rawFormat, data: params.line },\n  };\n}\n\n/**\n * Build the opaque preservation event for a reasoning-kind payload whose\n * content the provider encrypted (Codex's `encrypted_content`, and any\n * future adapter's equivalent). Unlike `unrecognizedDraft`, this is not a\n * format-drift placeholder awaiting renormalization: the ciphertext is\n * permanently opaque to us, and only the originating provider can ever\n * restore it, by replaying the raw blob back through its own API. `content`\n * carries only an opacity marker, never the blob itself — the blob lives\n * solely in `raw.data` for lossless export by a consumer that opts in.\n */\nexport function reasoningDraft(params: {\n  line: unknown;\n  occurredAt: string;\n  source: string;\n  sessionId: string;\n  seq: number;\n  version: string;\n  rawFormat: string;\n  conversationId: string;\n}): EventDraft {\n  return {\n    kind: \"reasoning\",\n    occurred_at: params.occurredAt,\n    actor: { type: \"agent\" },\n    producer: {\n      tool: \"cledger\",\n      version: params.version,\n      source: params.source,\n      session_id: params.sessionId,\n    },\n    conversation: { id: params.conversationId, seq: params.seq },\n    content: { opaque: true },\n    raw: { format: params.rawFormat, data: params.line },\n  };\n}\n\nexport function warnUnrecognized(source: string, unrecognized: Record<string, number>): void {\n  const entries = Object.entries(unrecognized);\n  if (entries.length === 0) return;\n  const total = entries.reduce((n, [, c]) => n + c, 0);\n  const detail = entries\n    .sort((a, b) => b[1] - a[1])\n    .map(([type, count]) => `${type} x${count}`)\n    .join(\", \");\n  process.stderr.write(\n    `cledger: ${source} preserved ${total} transcript line(s) of unrecognized type (${detail}) ` +\n      `raw-only — the ${source} format may have added content this cledger version cannot ` +\n      `interpret; update conversation-ledger to normalize these, or report it\\n`,\n  );\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/src/adapters/drift.ts","numLines":123,"startLine":1,"totalLines":123},"type":"text"},"type":"user","userType":"external","uuid":"0a15c673-9444-43e3-9b1b-be15908fbf4f","version":"2.1.217"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-11T11:07:27.716Z","schema":"conversation-ledger/v1"}
{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t/**\n2\t * Format-drift re-normalization: the supersession half of the drift story\n3\t * (the preservation half — emitting raw-only `unrecognized` events — lives in\n4\t * adapters/drift.ts). When a newer cledger version has learned to interpret a\n5\t * transcript line type it once preserved raw-only, `renormalize` turns each\n6\t * such stored line into the proper `conversation_turn` and appends a\n7\t * `supersession` event linking the two, so consumers stop seeing the raw\n8\t * placeholder and see the interpreted turn instead.\n9\t *\n10\t * Invariants:\n11\t *  - Append-only. The `unrecognized` event is never deleted; it is superseded\n12\t *    via a `supersession` event carrying `links:[{rel:\"supersedes\",target}]`.\n13\t *  - Idempotent. A second run is a no-op: already-superseded events are\n14\t *    skipped, and every id we produce is deterministic, so `appendEvents`\n15\t *    dedups anything that slips through.\n16\t *  - Id fidelity. The turn is reconstructed by re-feeding the stored `raw.data`\n17\t *    through the owning adapter's *same* convert path (see each adapter's\n18\t *    `renormalizeUnrecognized`), so it gets the exact id a live capture of the\n19\t *    same line would — a future live capture then dedups against it rather\n20\t *    than duplicating.\n21\t *  - Redaction safety. The stored `raw.data` was already redacted at\n22\t *    preservation time; the reconstructed turn also rides the normal\n23\t *    `appendEvents` redaction path, which is idempotent on already-placeholdered\n24\t *    text — nothing is re-exposed.\n25\t *\n26\t * Manual-only for now: this is an explicit `cledger renormalize` step, not\n27\t * auto-triggered on capture. Auto-detecting \"the adapter changed\" and running\n28\t * this after a version bump is a deferred follow-up (see the roadmap).\n29\t */\n30\timport type { RepoInfo } from \"./git.js\";\n31\timport { gitUserIdentity } from \"./git.js\";\n32\timport { appendEvents, readEvents } from \"./store.js\";\n33\timport { eventId, type EventDraft, type EventLink, type EvidenceEvent } from \"./schema.js\";\n34\timport { renormalizeUnrecognized as renormalizeClaude } from \"./adapters/claude-code.js\";\n35\timport { renormalizeUnrecognized as renormalizeCodex } from \"./adapters/codex.js\";\n36\t\n37\t/** Route a preserved event to the adapter that owns its `producer.source`. */\n38\ttype Renormalizer = (event: EvidenceEvent, identity: Awaited<ReturnType<typeof gitUserIdentity>>) => EventDraft | null;\n39\t\n40\tfunction renormalizerFor(source: string | undefined): Renormalizer | null {\n41\t  if (source === \"claude-code\") return renormalizeClaude;\n42\t  if (source === \"codex\") return renormalizeCodex;\n43\t  return null;\n44\t}\n45\t\n46\texport interface RenormalizeResult {\n47\t  /** Preserved `unrecognized` events examined (excludes ones already superseded). */\n48\t  scanned: number;\n49\t  /** Events an adapter could now interpret (a turn + supersession pair was produced). */\n50\t  interpreted: number;\n51\t  /** Fresh `conversation_turn` events written (an interpreted turn that already\n52\t   *  existed from a prior live capture dedups and is not counted here). */\n53\t  turnsAppended: number;\n54\t  /** Fresh `supersession` events written. */\n55\t  supersessionsAppended: number;\n56\t  /** Preserved events still uninterpretable — no owning adapter, or its\n57\t   *  convert path returned null; these stay preserved raw-only. */\n58\t  skipped: number;\n59\t}\n60\t\n61\texport async function renormalize(repo: RepoInfo): Promise<RenormalizeResult> {\n62\t  const identity = await gitUserIdentity(repo);\n63\t  const all = await readEvents(repo);\n64\t\n65\t  // Targets of any existing supersession — already re-normalized, skip them so\n66\t  // a re-run does no work rather than relying on dedup alone.\n67\t  const supersededTargets = new Set<string>();\n68\t  for (const e of all) {\n69\t    if (e.kind !== \"supersession\") continue;\n70\t    for (const link of e.links ?? []) {\n71\t      if (link.rel === \"supersedes\") supersededTargets.add(link.target);\n72\t    }\n73\t  }\n74\t  // Every id already in the ledger, across all anchors — `appendEvents` only\n75\t  // dedups within the target anchor, so this guards the cross-anchor case\n76\t  // where a live capture already wrote the same turn under a different commit.\n77\t  const existingIds = new Set(all.map((e) => e.id));\n78\t\n79\t  const result: RenormalizeResult = {\n80\t    scanned: 0,\n81\t    interpreted: 0,\n82\t    turnsAppended: 0,\n83\t    supersessionsAppended: 0,\n84\t    skipped: 0,\n85\t  };\n86\t  const drafts: EventDraft[] = [];\n87\t\n88\t  for (const event of all) {\n89\t    if (event.kind !== \"unrecognized\") continue;\n90\t    if (supersededTargets.has(event.id)) continue;\n91\t    result.scanned++;\n92\t\n93\t    const renormalizer = renormalizerFor(event.producer.source);\n94\t    if (!renormalizer) {\n95\t      result.skipped++;\n96\t      continue;\n97\t    }\n98\t    const turnDraft = renormalizer(event, identity);\n99\t    if (!turnDraft) {\n100\t      result.skipped++;\n101\t      continue;\n102\t    }\n103\t    result.interpreted++;\n104\t\n105\t    // The turn's id, computed the same way a fresh capture would (the stored\n106\t    // raw.data is already redacted, so the appendEvents redaction pass is a\n107\t    // no-op and does not shift this id).\n108\t    const turnId = eventId(turnDraft);\n109\t    if (!existingIds.has(turnId)) {\n110\t      drafts.push(turnDraft);\n111\t      existingIds.add(turnId);\n112\t    }\n113\t\n114\t    const link: EventLink = { rel: \"supersedes\", target: event.id };\n115\t    const supersessionDraft: EventDraft = {\n116\t      kind: \"supersession\",\n117\t      // Same instant the content \"happened\" — keeps this event's id\n118\t      // deterministic (occurred_at is part of the identity subset), so a\n119\t      // re-run dedups instead of minting a second supersession.\n120\t      occurred_at: turnDraft.occurred_at,\n121\t      actor: { type: \"system\" },\n122\t      producer: {\n123\t        tool: \"cledger\",\n124\t        ...(turnDraft.producer.version ? { version: turnDraft.producer.version } : {}),\n125\t        ...(event.producer.source ? { source: event.producer.source } : {}),\n126\t        ...(event.producer.session_id ? { session_id: event.producer.session_id } : {}),\n127\t      },\n128\t      content: {\n129\t        superseded: event.id,\n130\t        by: turnId,\n131\t        reason: \"renormalized\",\n132\t        ...(event.raw?.format ? { raw_format: event.raw.format } : {}),\n133\t      },\n134\t      links: [link],\n135\t    };\n136\t    if (event.conversation) supersessionDraft.conversation = event.conversation;\n137\t    drafts.push(supersessionDraft);\n138\t  }\n139\t\n140\t  if (drafts.length > 0) {\n141\t    const appended = await appendEvents(repo, drafts);\n142\t    for (const e of appended.appended) {\n143\t      if (e.kind === \"conversation_turn\") result.turnsAppended++;\n144\t      else if (e.kind === \"supersession\") result.supersessionsAppended++;\n145\t    }\n146\t  }\n147\t  return result;\n148\t}\n149\t","tool_use_id":"toolu_0184fJwFY6btvkWZPTrChaue","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","head":"de79e501289e2e19946780867779ef465ead2124","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:ca50d7db-8621-495c-a94a-c3d3ab731073#agent:aed5fef0c20867100","parent":"claude-code:ca50d7db-8621-495c-a94a-c3d3ab731073","seq":22},"id":"ev1-038724b633f79221034195d5f4c69416449754342b931612409cf485e85c8865","kind":"conversation_turn","occurred_at":"2026-07-22T21:21:36.991Z","producer":{"session_id":"ca50d7db-8621-495c-a94a-c3d3ab731073","source":"claude-code","source_version":"2.1.217","tool":"cledger","version":"0.20.0"},"raw":{"data":{"agen