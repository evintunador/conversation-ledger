nst drafts: EventDraft[] = [];\n87: \n88:   for (const event of all) {\n89:     if (event.kind !== \"unrecognized\") continue;\n90:     if (supersededTargets.has(event.id)) continue;\n91:     result.scanned++;\n92: \n93:     const renormalizer = renormalizerFor(event.producer.source);\n94:     if (!renormalizer) {\n95:       result.skipped++;\n96:       continue;\n97:     }\n98:     const turnDraft = renormalizer(event, identity);\n99:     if (!turnDraft) {\n100:       result.skipped++;\n101:       continue;\n102:     }\n103:     result.interpreted++;\n104: \n105:     // The turn's id, computed the same way a fresh capture would (the stored\n106:     // raw.data is already redacted, so the appendEvents redaction pass is a\n107:     // no-op and does not shift this id).\n108:     const turnId = eventId(turnDraft);\n109:     if (!existingIds.has(turnId)) {\n110:       drafts.push(turnDraft);\n111:       existingIds.add(turnId);\n112:     }\n113: \n114:     const link: EventLink = { rel: \"supersedes\", target: event.id };\n115:     const supersessionDraft: EventDraft = {\n116:       kind: \"supersession\",\n117:       // Same instant the content \"happened\" — keeps this event's id\n118:       // deterministic (occurred_at is part of the identity subset), so a\n119:       // re-run dedups instead of minting a second supersession.\n120:       occurred_at: turnDraft.occurred_at,\n121:       actor: { type: \"system\" },\n122:       producer: {\n123:         tool: \"cledger\",\n124:         ...(turnDraft.producer.version ? { version: turnDraft.producer.version } : {}),\n125:         ...(event.producer.source ? { source: event.producer.source } : {}),\n126:         ...(event.producer.session_id ? { session_id: event.producer.session_id } : {}),\n127:       },\n128:       content: {\n129:         superseded: event.id,\n130:         by: turnId,\n131:         reason: \"renormalized\",\n132:         ...(event.raw?.format ? { raw_format: event.raw.format } : {}),\n133:       },\n134:       links: [link],\n135:     };\n136:     if (event.conversation) supersessionDraft.conversation = event.conversation;\n137:     drafts.push(supersessionDraft);\n138:   }\n139: \n140:   if (drafts.length > 0) {\n141:     const appended = await appendEvents(repo, drafts);\n142:     for (const e of appended.appended) {\n143:       if (e.kind === \"conversation_turn\") result.turnsAppended++;\n144:       else if (e.kind === \"supersession\") result.supersessionsAppended++;\n145:     }\n146:   }\n147:   return result;\n148: }\n\n(End of file - total 148 lines)\n</content>","status":"completed","time":{"end":1785584088030,"start":1785584088025},"title":"src/renormalize.ts"},"tool":"read","type":"tool"}},"format":"opencode-export-json/1"},"recorded_at":"2026-08-11T11:06:41.063Z","schema":"conversation-ledger/v1"}
