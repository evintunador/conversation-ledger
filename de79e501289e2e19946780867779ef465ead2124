t    ? (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean)\n225\t    : [];\n226\t  const known = new Set(existing.map((l) => parseEventLine(l).id));\n227\t  const fresh = events.filter((e) => !known.has(e.id));\n228\t  await writeFile(path, [...existing, ...fresh.map(serializeEvent)].join(\"\\n\") + \"\\n\");\n229\t  return { appended: fresh, deduped: events.length - fresh.length, anchor: null };\n230\t}\n231\t\n232\t/** Events held while HEAD was unborn; caller writes them into a real note. */\n233\tasync function drainPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n234\t  const path = pendingPath(repo);\n235\t  if (!existsSync(path)) return [];\n236\t  const events = (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n237\t  await rm(path, { force: true });\n238\t  return events;\n239\t}\n240\t\n241\texport async function readPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n242\t  const path = pendingPath(repo);\n243\t  if (!existsSync(path)) return [];\n244\t  return (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n245\t}\n246\t\n247\texport interface ReadOptions {\n248\t  /** Restrict to events anchored to commits reachable from this rev. */\n249\t  reachableFrom?: string;\n250\t  kind?: string;\n251\t  source?: string;\n252\t  conversation?: string;\n253\t}\n254\t\n255\texport async function readEvents(repo: RepoInfo, opts: ReadOptions = {}): Promise<EvidenceEvent[]> {\n256\t  // Lazy transport: fold in anything a plain `git fetch`/`git pull` staged.\n257\t  await absorbIncoming(repo);\n258\t  // Lazy re-anchoring, same shape: if the fetch revealed that the remote\n259\t  // target branch rewrote noted commits (squash merge), map them before\n260\t  // filtering by reachability below.\n261\t  await autoReAnchor(repo);\n262\t  let anchors = await listAnchors(repo);\n263\t  const noteCache = new Map<string, EvidenceEvent[]>();\n264\t  const readNote = async (anchor: string