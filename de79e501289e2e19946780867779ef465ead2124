{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t/**\n2\t * Capture-time and scan-time redaction rulesets. See docs/\n3\t * WIP_TECHNICAL_DESIGN.md (\"Privacy and integrity\") for the layered design:\n4\t * capture-tier rules run unconditionally on every draft and must be\n5\t * near-zero-false-positive (a false positive silently rewrites the record),\n6\t * standard/paranoid tiers are scan-time-only and may be noisier since they\n7\t * just warn a human rather than rewrite anything.\n8\t */\n9\t\n10\texport const RULESET_VERSION = \"cledger-rules/1\";\n11\t\n12\texport type RuleTier = \"capture\" | \"standard\" | \"paranoid\";\n13\t\n14\texport interface RedactionRule {\n15\t  id: string;\n16\t  tier: RuleTier;\n17\t  description: string;\n18\t  pattern: RegExp;\n19\t  /**\n20\t   * Paranoid-tier only: the pattern matches *candidate* tokens; the scanner\n21\t   * applies entropy filtering on top before treating a match as a finding.\n22\t   * Not consulted by capture-time redaction (redactText skips these rules).\n23\t   */\n24\t  entropyGated?: true;\n25\t}\n26\t\n27\tconst CAPTURE_RULES: RedactionRule[] = [\n28\t  {\n29\t    id: \"github-token\",\n30\t    tier: \"capture\",\n31\t    description: \"GitHub personal access / OAuth / app / refresh token\",\n32\t    pattern: /\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255}\\b/g,\n33\t  },\n34\t  {\n35\t    id: \"github-fine-grained\",\n36\t    tier: \"capture\",\n37\t    description: \"GitHub fine-grained personal access token\",\n38\t    pattern: /\\bgithub_pat_[A-Za-z0-9_]{22,255}\\b/g,\n39\t  },\n40\t  {\n41\t    id: \"anthropic-api-key\",\n42\t    tier: \"capture\",\n43\t    description: \"Anthropic API key\",\n44\t    pattern: /\\bsk-ant-[A-Za-z0-9_-]{32,}\\b/g,\n45\t  },\n46\t  {\n47\t    id: \"openai-api-key\",\n48\t    tier: \"capture\",\n49\t    description: \"OpenAI API key\",\n50\t    pattern: /\\bsk-(?!ant-)(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{48})\\b/g,\n51\t  },\n52\t  {\n53\t    id: \"aws-access-key-id\",\n54\t    tier: \"capture\",\n55\t    description: \"AWS access key id\",\n56\t    pattern: /\\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\\b/g,\n57\t  },\n58\t  {\n59\t    id: \"google-api-key\",\n60\t    tier: \"capture\",\n61\t    description: \"Google API key\",\n62\t    pattern: /\\bAIza[0-9A-Za-z_-]{35}\\b/g,\n63\t  },\n64\t  {\n65\t    id: \"slack-token\",\n66\t    tier: \"capture\",\n67\t    description: \"Slack token\",\n68\t    pattern: /\\bxox[baprs]-[0-9A-Za-z-]{10,}\\b/g,\n69\t  },\n70\t  {\n71\t    id: \"stripe-key\",\n72\t    tier: \"capture\",\n73\t    description: \"Stripe live secret/restricted key\",\n74\t    pattern: /\\b[sr]k_live_[0-9a-zA-Z]{24,}\\b/g,\n75\t  },\n76\t  {\n77\t    id: \"gitlab-pat\",\n78\t    tier: \"capture\",\n79\t    description: \"GitLab personal access token\",\n80\t    pattern: /\\bglpat-[0-9a-zA-Z_-]{20,}\\b/g,\n81\t  },\n82\t  {\n83\t    id: \"npm-token\",\n84\t    tier: \"capture\",\n85\t    description: \"npm access token\",\n86\t    pattern: /\\bnpm_[A-Za-z0-9]{36}\\b/g,\n87\t  },\n88\t  {\n89\t    id: \"sendgrid-key\",\n90\t    tier: \"capture\",\n91\t    description: \"SendGrid API key\",\n92\t    pattern: /\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b/g,\n93\t  },\n94\t  {\n95\t    id: \"private-key-block\",\n96\t    tier: \"capture\",\n97\t    description: \"PEM-style private key block\",\n98\t    pattern:\n99\t      /-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----/g,\n100\t  },\n101\t  {\n102\t    id: \"jwt\",\n103\t    tier: \"capture\",\n104\t    description: \"JSON Web Token\",\n105\t    pattern: /\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b/g,\n106\t  },\n107\t];\n108\t\n109\tconst STANDARD_RULES: RedactionRule[] = [\n110\t  {\n111\t    id: \"keyword-assignment\",\n112\t    tier: \"standard\",\n113\t    description: \"Keyword-anchored secret assignment (password=, api_key:, ...)\",\n114\t    /**\n115\t     * The value charset deliberately excludes code punctuation — (){}[]<>;,$`\\\n116\t     * — as well as whitespace and quotes. A real credential is drawn from\n117\t     * token-ish characters (alphanumerics, -_.+/=~ etc.), whereas the dominant\n118\t     * false-positive class is *source code that talks about secrets*: type\n119\t     * annotations (`secret: string): string {`) and template interpolation\n120\t     * (`secret: ${secret.slice(i, i + 6)}`) both hit the excluded set\n121\t     * immediately and now fall below the 8-char floor instead of matching.\n122\t     * Surfaced by dogfooding cledger on its own repo, where the old charset\n123\t     * flagged the redaction source files themselves.\n124\t     *\n125\t     * Note this cannot (and should not) suppress secret-*shaped* string\n126\t     * literals in source, e.g. a test fixture containing \"password=hunter2...\":\n127\t     * those are indistinguishable from the real thing by pattern alone.\n128\t     */\n129\t    pattern:\n130\t      /(?:password|passwd|secret|api_key|apikey|access_token|auth_token|credentials?)[\"']?\\s*[:=]\\s*[\"']?[^\\s\"'`(){}[\\]<>;,$\\\\]{8,}/gi,\n131\t  },\n132\t  {\n133\t    id: \"url-credentials\",\n134\t    tier: \"standard\",\n135\t    description: \"Credentials embedded in a URL (scheme://user:pass@host)\",\n136\t    pattern: /[a-z][a-z0-9+.-]*:\\/\\/[^\\s\\/:@]+:[^\\s@]{4,}@/gi,\n137\t  },\n138\t  {\n139\t    id: \"bearer-token\",\n140\t    tier: \"standard\",\n141\t    description: \"Bearer token in an Authorization-style header value\",\n142\t    pattern: /\\bbearer\\s+[A-Za-z0-9_\\-.=]{20,}/gi,\n143\t  },\n144\t];\n145\t\n146\tconst PARANOID_RULES: RedactionRule[] = [\n147\t  {\n148\t    id: \"high-entropy\",\n149\t    tier: \"paranoid\",\n150\t    description: \"High-entropy token candidate; entropy filtering applied by the scanner\",\n151\t    pattern: /\\b[A-Za-z0-9+/_=-]{24,}\\b/g,\n152\t    entropyGated: true,\n153\t  },\n154\t];\n155\t\n156\texport const RULES: readonly RedactionRule[] = [\n157\t  ...CAPTURE_RULES,\n158\t  ...STANDARD_RULES,\n159\t  ...PARANOID_RULES,\n160\t];\n161\t\n162\t/** \"capture\" -> capture only; \"standard\" -> capture+standard; \"paranoid\" -> all. */\n163\texport function rulesForTier(tier: RuleTier): RedactionRule[] {\n164\t  if (tier === \"capture\") return [...CAPTURE_RULES];\n165\t  if (tier === \"standard\") return [...CAPTURE_RULES, ...STANDARD_RULES];\n166\t  return [...RULES];\n167\t}\n168\t\n169\t/** Shannon entropy in bits per character, for paranoid-tier scan filtering. */\n170\texport function shannonEntropy(s: string): number {\n171\t  if (s.length === 0) return 0;\n172\t  const counts = new Map<string, number>();\n173\t  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);\n174\t  let entropy = 0;\n175\t  for (const count of counts.values()) {\n176\t    const p = count / s.length;\n177\t    entropy -= p * Math.log2(p);\n178\t  }\n179\t  return entropy;\n180\t}\n181\t","tool_use_id":"toolu_01NP88R5PooYu431CCiSt1JQ","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","head":"de79e501289e2e19946780867779ef465ead2124","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:ca50d7db-8621-495c-a94a-c3d3ab731073#agent:a0166d8e8bd90f909","parent":"claude-code:ca50d7db-8621-495c-a94a-c3d3ab731073","seq":36},"id":"ev1-8cb1c712b75d9dc15f96258a543841b2f5ca6f01f4bedc8e5d7c8f7bb90c1ccc","kind":"conversation_turn","occurred_at":"2026-07-22T21:21:20.948Z","producer":{"session_id":"ca50d7db-8621-495c-a94a-c3d3ab731073","source":"claude-code","source_version":"2.1.217","tool":"cledger","version":"0.20.0"},"raw":{"data":{"agentId":"a0166d8e8bd90f909","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","entrypoint":"cli","gitBranch":"main","isSidechain":true,"message":{"content":[{"content":"1\t/**\n2\t * Ca