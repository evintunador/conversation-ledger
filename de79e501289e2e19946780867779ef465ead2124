 }\n620: \n621: /**\n622:  * Push `anchors`' notes to the remote's ledger ref without disturbing\n623:  * anything already there.\n624:  *\n625:  * The subtlety that makes this non-obvious: a notes ref is a *snapshot of the\n626:  * whole database*, not an append log. Its tip commit's tree maps every\n627:  * annotated commit to its note, so whatever tree you push becomes the\n628:  * remote's entire notes database. Pushing a tree containing only this\n629:  * branch's notes would therefore delete every other branch's — they would\n630:  * survive in the ref's history but vanish from `git notes show` and from any\n631:  * fresh clone, which is silent data loss for collaborators.\n632:  *\n633:  * So the scoped push is built the other way round: seed a temp ref from the\n634:  * remote's current tip, union this scope's notes into it, and push that. The\n635:  * result descends from what the remote already had, so it fast-forwards and\n636:  * strictly adds. Conversations on branches outside the scope are simply never\n637:  * written into the temp ref, and never leave the machine.\n638:  */\n639: async function pushScopedNotes(\n640:   repo: RepoInfo,\n641:   remote: string,\n642:   anchors: string[],\n643: ): Promise<void> {\n644:   const tmpName = \"cledger-push-tmp\";\n645:   const tmpRef = `refs/notes/${tmpName}`;\n646:   await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n647:   // Seed from the remote. Failure here means the remote has no ledger ref\n648:   // yet (first push), so the temp ref simply starts empty.\n649:   await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n650:   try {\n651:     for (const anchor of anchors) {\n652:       const local = await readNoteLines(repo, anchor);\n653:       if (local.length === 0) continue;\n654:       const seeded = await readNoteLines(repo, anchor, tmpName);\n655:       // Line-level sort+unique: the same shape `cat_sort_uniq` gives the\n656:       // merge path, so a scoped push and a full merge converge.\n657:       const union = [...new Set([...seeded, ...local])].sort();\n658:       if (union.length === seeded.length) continue; // remote already had all of them\n659:       await git([\"notes\", \"--ref\", tmpName, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n660:         cwd: repo.root,\n661:         input: union.join(\"\\n\") + \"\\n\",\n662:       });\n663:     }\n664:     const tmpExists = (await git([\"rev-parse\", \"--verify\", \"--quiet\", tmpRef], {\n665:       cwd: repo.root,\n666:       allowFailure: true,\n667:     })).trim();\n668:     if (!tmpExists) return; // nothing in scope and the remote had nothing\n669:     await git([\"push\", remote, `${tmpRef}:${NOTES_REF}`], { cwd: repo.root });\n670:   } finally {\n671:     await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n672:   }\n673: }\n674: \n675: /**\n676:  * Event ids the remote's notes ref already has, fetched into a throwaway\n677:  * temp ref that is deleted before returning. Null means the remote has no\n678:  * ledger ref at all (e.g. first push), in which case the caller should\n679:  * treat everything local as unshared.\n680:  */\n681: async function remoteNoteIds(repo: RepoInfo, remote: string): Promise<Set<string> | null> {\n682:   const remoteHasRef = (await git([\"ls-remote\", remote, NOTES_REF], {\n683:     cwd: repo.root,\n684:     allowFailure: true,\n685:   })).trim();\n686:   if (!remoteHasRef) return null;\n687: \n688:   const tmpName = \"conversation-ledger-scan-tmp\";\n689:   const tmpRef = `refs/notes/${tmpName}`;\n690:   await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n691:   try {\n692:     const ids = new Set<string>();\n693:     for (const anchor of await listAnchors(repo, tmpName)) {\n694:       for (const event of await readNoteEvents(repo, anchor, tmpName)) ids.add(event.id);\n695:     }\n696:     return ids;\n697:   } finally {\n698:     await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n699:   }\n700: }\n701: \n702: /** Thrown when the layer-E scan gate blocks a push; carries no secrets. */\n703: export class ScanBlockedError extends Error {\n704:   constructor(public readonly findings: number) {\n705:     super(`cledger sync: push blocked — ${findings} potential secret(s) found (see report above)`);\n706:   }\n707: }\n708: \n709: /**\n710:  * Layer E: before push, scan only the events the remote does not yet have\n711:  * (already-pushed events are not rescanned every time). On any surviving\n712:  * finding, print a report and throw so sync() does not proceed to push —\n713:  * the fetch/merge phase, if it already ran, is left in place.\n714:  */\n715: async function runScanGate(\n716:   repo: RepoInfo,\n717:   remote: string,\n718:   tier: \"standard\" | \"paranoid\",\n719:   anchors: string[] | null,\n720: ): Promise<void> {\n721:   const remoteIds = await remoteNoteIds(repo, remote);\n722: \n723:   const localEvents: EvidenceEvent[] = [];\n724:   // Scan exactly what the push will carry. Before scoping this swept every\n725:   // anchor, so a finding on a branch that was never going to be pushed still\n726:   // blocked the push — which, given how often the flagged text is a\n727:   // conversation *about* credential-shaped code, was a routine false block.\n728:   for (const anchor of anchors ?? (await listAnchors(repo))) {\n729:     localEvents.push(...(await readNoteEvents(repo, anchor)));\n730:   }\n731:   // Pending events are unanchored, so they are not in this push at all; they\n732:   // are still scanned because they exist only before the first commit, when\n733:   // there is nothing else to push anyway, and gating them early is the\n734:   // conservative side to err on.\n735:   localEvents.push(...(await readPending(repo)));\n736: \n737:   const candidates = remoteIds ? localEvents.filter((e) => !remoteIds.has(e.id)) : localEvents;\n738:   if (candidates.length === 0) return;\n739: \n740:   const findings = filterFindings(scanEvents(candidates, tier), await loadAllowlist(repo));\n741:   if (findings.length === 0) return;\n742: \n743:   const eventIds = [...new Set(findings.map((f) => f.eventId))];\n744:   process.stderr.write(\n745:     `cledger sync: blocked — ${findings.length} potential secret(s) across ` +\n746:       `${eventIds.length} event(s) not yet on ${remote}\\n\\n`,\n747:   );\n748:   for (const f of findings) process.stderr.write(`  ${formatFinding(f)}\\n`);\n749:   process.stderr.write(`\\n${findingGuidance(eventIds)}\\n`);\n750:   process.stderr.write(\n751:     \"\\nRemediate, then re-run sync:\\n\" +\n752:       \"  cledger redact <event-id>     rewrite the event and remove the secret\\n\" +\n753:       \"  cledger allow <fingerprint>   mark a fingerprint as a known false positive\\n\" +\n754:       \"  cledger sync --no-scan        skip this gate for this sync only\\n\",\n755:   );\n756:   throw new ScanBlockedError(findings.length);\n757: }\n758: \n759: /**\n760:  * Sync of the single ledger ref: explicit via `cledger sync`, or run by the\n761:  * pre-push transport hook (see transportPush). The fetch phase stages into\n762:  * INCOMING_REF and absorbs it — the same path a plain `git fetch` plus a\n763:  * later read takes.\n764:  */\n765: export async function sync(\n766:   repo: RepoInfo,\n767:   remote = \"origin\",\n768:   mode: \"both\" | \"push\" | \"fetch\" = \"both\",\n769:   opts: { skipScan?: boolean; paranoid?: boolean; scope?: string | string[] | null } = {},\n770: ): Promise<SyncResult> {\n771:   const result: SyncResult = { fetched: false, pushed: false, scopedAnchors: null };\n772:   await ensureMergeConfig(repo);\n773:   if (mode !== \"push\") {\n774:     await git(\n775:       [\"fetch\", remote, `+${NOTES_REF}:${INCOMING_REF}`],\n776:       { cwd: repo.root, allowFailure: true },\n777:     );\n778:     result.fetched = await absorbIncoming(repo);\n779:   }\n780:   if (mode !== \"fetch\") {\n781:     const config = await loadConfig(repo.root);\n782:     // Scoped by default, to the current branch. `scope: null` opts out and\n783:     // pushes the whole ledger — the pre-0.14.0 behavior. An empty array means\n784:     // \"nothing in scope\", which is distinct from \"unscoped\" and must not\n785:     // silently widen to everything.\n786:     const scope = opts.scope === undefined ? [\"HEAD\"] : opts.scope;\n787:     const revs = scope === null ? null : Array.isArray(scope) ? scope : [scope];\n788:     const anchors = revs === null ? null : await anchorsForRevs(repo, revs);\n789:     const scanDisabled = opts.skipScan === true || config.scan?.tier === \"off\";\n790:     if (!scanDisabled) {\n791:       const tier: \"standard\" | \"paranoid\" =\n792:         opts.paranoid === true || config.scan?.tier === \"paranoid\" ? \"paranoid\" : \"standard\";\n793:       await runScanGate(repo, remote, tier, anchors);\n794:     }\n795:     // The pushed child git inherits CLEDGER_INTERNAL, telling the pre-push\n796:     // transport hook this push *is* the ledger push — no recursion.\n797:     const prior = process.env[\"CLEDGER_INTERNAL\"];\n798:     process.env[\"CLEDGER_INTERNAL\"] = \"1\";\n799:     try {\n800:       if (anchors === null) {\n801:         await git([\"push\", remote, `${NOTES_REF}:${NOTES_REF}`], { cwd: repo.root });\n802:       } else {\n803:         await pushScopedNotes(repo, remote, anchors);\n804:       }\n805:     } finally {\n806:       if (prior === undefined) delete process.env[\"CLEDGER_INTERNAL\"];\n807:       else process.env[\"CLEDGER_INTERNAL\"] = prior;\n808:     }\n809:     result.pushed = true;\n810:     result.scopedAnchors = anchors === null ? null : anchors.length;\n811:   }\n812:   return result;\n813: }\n814: \n815: export interface TransportPushResult {\n816:   pushed: boolean;\n817:   /** True when scan findings held the ledger back (non-strict mode). */\n818:   held: boolean;\n819: }\n820: \n821: /**\n822:  * Local shas from git's pre-push stdin, which supplies one\n823:  * `<local ref> <local sha> <remote ref> <remote sha>` line per ref.\n824:  *\n825:  * The local sha is used rather than the local ref name because it is what\n826:  * git is actually pushing and needs no further resolution. A deletion sends\n827:  * an all-zero local sha and is skipped: there is no branch tip to scope to,\n828:  * and deleting a remote branch is not an occasion to share anything.\n829:  */\n830: export function parsePrePushRefs(stdin: string): string[] {\n831:   const revs: string[] = [];\n832:   for (const line of stdin.split(\"\\n\")) {\n833:     const parts = line.trim().split(/\\s+/);\n834:     if (parts.length < 2) continue;\n835:     const localSha = parts[1]!;\n836:     if (!/^[0-9a-f]{40,64}$/.test(localSha)) continue;\n837:     if (/^0+$/.test(localSha)) continue; // ref deletion\n838:     revs.push(localSha);\n839:   }\n840:   return revs;\n841: }\n842: \n843: /**\n844:  * Pre-push hook entrypoint policy. Pushes the ledger ref alongside the\n845:  * user's own push, scoped to the refs git is actually pushing.\n846:  *\n847:  * `revs` comes from git's pre-push stdin (see `parsePrePushRefs`), so\n848:  * `git push origin some-branch` shares that branch's conversations even when\n849:  * it is not the one checked out. It falls back to `HEAD` only when stdin\n850:  * carried nothing usable — an old installed hook that still redirects\n851:  * `</dev/null`, or a manual invocation.\n852:  *\n853:  * A scan finding blocks only the ledger by default —\n854:  * secrets never leave the machine, but a false positive never blocks\n855:  * shipping code; {\"transport\": {\"strict\": true}} escalates to aborting the\n856:  * whole push (rethrows ScanBlockedError; the CLI exits nonzero). Any other\n857:  * failure (network, missing remote ref perms) warns and lets the push\n858:  * proceed — the hook must never make `git push` flaky.\n859:  */\n860: export async function transportPush(\n861:   repo: RepoInfo,\n862:   remote: string,\n863:   revs?: string[],\n864: ): Promise<TransportPushResult> {\n865:   const config = await loadConfig(repo.root);\n866:   if (config.transport?.hook === false) return { pushed: false, held: false };\n867:   const hasNotes = (await git([\"rev-parse\", \"--verify\", \"--quiet\", NOTES_REF], {\n868:     cwd: repo.root,\n869:     allowFailure: true,\n870:   })).trim();\n871:   if (!hasNotes) return { pushed: false, held: false };\n872: \n873:   try {\n874:     // No usable refs (deletes only, or an old hook that ate stdin): fall back\n875:     // to the checked-out branch rather than to the whole ledger.\n876:     await sync(repo, remote, \"push\", { scope: revs && revs.length > 0 ? revs : [\"HEAD\"] });\n877:     return { pushed: true, held: false };\n878:   } catch (err) {\n879:     if (err instanceof ScanBlockedError) {\n880:       if (config.transport?.strict === true) throw err;\n881:       process.stderr.write(\n882:         \"cledger: conversation records were held back from this push (potential secrets — \" +\n883:           \"see report above); your code push continues. Run `cledger sync` to review and \" +\n884:           \"remediate.\\n\",\n885:       );\n886:       return { pushed: false, held: true };\n887:     }\n888:     process.stderr.write(\n889:       `cledger: ledger push skipped (${err instanceof Error ? err.message : String(err)})\\n`,\n890:     );\n891:     return { pushed: false, held: false };\n892:   }\n893: }\n894: \n895: interface LocatedEvent {\n896:   event: EvidenceEvent;\n897:   /** Anchor commit holding the note line, or null when the event is still in pending.jsonl. */\n898:   anchor: string | null;\n899:   /** Full line array of the containing note (or of pending.jsonl), for in-place rewrite. */\n900:   lines: string[];\n901:   index: number;\n902: }\n903: \n904: function idMatchesPrefix(id: string, prefix: string): boolean {\n905:   if (id.startsWith(prefix)) return true;\n906:   const hash = id.startsWith(\"ev1-\") ? id.slice(4) : id;\n907:   return hash.startsWith(prefix);\n908: }\n909: \n910: /** Find the one event matching `idPrefix` across every anchor and the pending queue. */\n911: async function locateEvent(repo: RepoInfo, idPrefix: string): Promise<LocatedEvent> {\n912:   const matches: LocatedEvent[] = [];\n913: \n914:   for (const anchor of await listAnchors(repo)) {\n915:     const lines = await readNoteLines(repo, anchor);\n916:     lines.forEach((line, index) => {\n917:       const event = parseEventLine(line);\n918:       if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor, lines, index });\n919:     });\n920:   }\n921: \n922:   const pendingFile = pendingPath(repo);\n923:   const pendingLines = existsSync(pendingFile)\n924:     ? (await readFile(pendingFile, \"utf8\")).split(\"\\n\").filter((l) => l.trim().length > 0)\n925:     : [];\n926:   pendingLines.forEach((line, index) => {\n927:     const event = parseEventLine(line);\n928:     if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor: null, lines: pendingLines, index });\n929:   });\n930: \n931:   if (matches.length === 0) {\n932:     throw new Error(`cledger redact: no event matches id prefix \"${idPrefix}\"`);\n933:   }\n934:   if (matches.length > 1) {\n935:     throw new Error(\n936:       `cledger redact: id prefix \"${idPrefix}\" is ambiguous (${matches.length} matches: ` +\n937:         `${matches.map((m) => m.event.id).join(\", \")})`,\n938:     );\n939:   }\n940:   return matches[0]!;\n941: }\n942: \n943: export interface RedactResult {\n944:   /** The rewritten event, with the secret removed. */\n945:   event: EvidenceEvent;\n946:   /** The companion `redaction` event recording why `event`'s content no longer matches its id. */\n947:   redactionEvent: EvidenceEvent;\n948:   /** True when the pre-redaction notes history was squashed away locally (see below). */\n949:   squashed: boolean;\n950:   /**\n951:    *