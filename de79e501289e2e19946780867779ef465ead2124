const config = await loadConfig(repo.root);\n  const rememberSecrets = hasPattern && config.redact?.knownSecrets === true;\n\n  const { located, rewritten, newRecords, secretValues } = await withLock(repo, async () => {\n    const located = await locateEvent(repo, idPrefix);\n    const original = located.event;\n\n    let rewrittenContent: unknown = original.content;\n    let rewrittenRaw = original.raw;\n    const newRecords: RedactionRecord[] = [];\n    const secretValues: string[] = [];\n\n    if (hasPattern) {\n      let pattern: RegExp;\n      try {\n        pattern = new RegExp(opts.pattern!, \"g\");\n      } catch (err) {\n        throw new Error(\n          `cledger redact: invalid --pattern regex: ${err instanceof Error ? err.message : String(err)}`,\n        );\n      }\n      const rule: RedactionRule = {\n        id: \"manual\",\n        tier: \"capture\",\n        description: \"Manually specified redaction pattern\",\n        pattern,\n      };\n      const { draft: patched, records } = redactDraft(original, { rules: [rule] });\n      if (records.length === 0) {\n        throw new Error(`cledger redact: --pattern matched nothing in event ${original.id}`);\n      }\n      rewrittenContent = patched.content;\n      rewrittenRaw = patched.raw;\n      newRecords.push(...records);\n      if (rememberSecrets) {\n        secretValues.push(...collectMatches(original.content, pattern));\n        if (original.raw) secretValues.push(...collectMatches(original.raw.data, pattern));\n      }\n    } else {\n      const fingerprint = sha256Hex(canonicalJson(original.content)).slice(0, 12);\n      rewrittenContent = `[REDACTED:manual:${fingerprint}]`;\n      rewrittenRaw = undefined;\n      newRecords.push({ rule: \"manual\", ruleset: RULESET_VERSION, fingerprint, path: \"content\" });\n    }\n\n    // CRITICAL: this draft carries `original.id` explicitly, and\n    // finalizeEvent below (`draft.id ?? eventId(draft)`) preserves a\n    // supplied id rather than recomputing it. If the id were recomputed\n    // here from the rewritten (secret-free) content, it would no longer\n    // match the id a fresh capture of the *original* source material would\n    // produce — so a later transcript rescan (ids are a pure function of\n    // source content; that's what makes capture idempotent) would\n    // regenerate the original, unredacted event under its old id, dedup\n    // would no longer recognize it as \"already seen\" against this\n    // rewritten line, and the secret would silently reappear in the\n    // ledger. Keeping the id stable means the rewritten line permanently\n    // occupies that id slot — any rescan producing the same id dedups\n    // against it instead. The companion `redaction` event appended below\n    // is what records why this event's content no longer matches what its\n    // id would normally imply.\n    const rewrittenDraft: EventDraft = {\n      ...original,\n      id: original.id,\n      content: rewrittenContent,\n      redactions: [...(original.redactions ?? []), ...newRecords],\n    };\n    if (rewrittenRaw === undefined) delete rewrittenDraft.raw;\n    else rewrittenDraft.raw = rewrittenRaw;\n\n    const rewritten = finalizeEvent(rewrittenDraft);\n    if (rewritten.id !== original.id) {\n      // Should be unreachable given the explicit `id: original.id` above;\n      // guarded because a dedup break here is exactly the failure mode the\n      // comment above exists to prevent.\n      throw new Error(\"cledger redact: internal error — rewritten event id drifted from the original\");\n    }\n\n    const newLines = [...located.lines];\n    newLines[located.index] = serializeEvent(rewritten);\n    if (located.anchor !== null) {\n      newLines.sort();\n      await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", located.anchor], {\n        cwd: repo.root,\n        input: newLines.join(\"\\n\") + \"\\n\",\n      });\n    } else {\n      await ensureStateDir(repo);\n      await writeFile(pendingPath(repo), newLines.join(\"\\n\") + \"\\n\");\n    }\n\n    return { located, rewritten, newRecords, secretValues };\n  });\n\n  // Persist remembered secret values outside the notes lock (the store is its\n  // own file under .git/, unrelated to the notes ref). addKnownSecrets applies\n  // the min-length filter and dedups, returning how many were newly stored.\n  let knownSecretsRemembered = 0;\n  if (rememberSecrets && secretValues.length > 0) {\n    const before = (await loadKnownSecrets(repo)).length;\n    await addKnownSecrets(repo, secretValues);\n    knownSecretsRemembered = (await loadKnownSecrets(repo)).length - before;\n  }\n\n  // Companion event: goes through the normal appendEvents path (its own\n  // lock cycle) rather than being written inline above, so it behaves\n  // exactly like any other captured event (dedup, context, validation).\n  const identity = await gitUserIdentity(repo);\n  const actor: Actor = { type: \"human\" };\n  if (identity.email) actor.id = identity.email;\n  if (identity.name) actor.display = identity.name;\n\n  const redactionContent: Record<string, unknown> = {\n    target: located.event.id,\n    mode: hasPattern ? \"pattern\" : \"all\",\n    fingerprints: newRecords.map((r) => r.fingerprint),\n  };\n  if (opts.reason) redactionContent.reason = opts.reason;\n\n  const redactionDraft: EventDraft = {\n    kind: \"redaction\",\n    occurred_at: new Date().toISOString(),\n    actor,\n    producer: { tool: \"cledger\" },\n    content: redactionContent,\n    links: [{ rel: \"redacts\", target: located.event.id }],\n  };\n  if (located.event.conversation) redactionDraft.conversation = located.event.conversation;\n\n  const appendResult = await appendEvents(repo, [redactionDraft]);\n  const redactionEvent = appendResult.appended[0];\n  if (!redactionEvent) {\n    throw new Error(\"cledger redact: failed to append companion redaction event\");\n  }\n\n  // Local purge: only meaningful when the event was already anchored (a\n  // pending-queue rewrite never touched the notes ref) and only safe when\n  // nobody else has a copy of the pre-redaction history yet.\n  let squashed = false;\n  if (located.anchor !== null) {\n    const remoteHasRef = (await git([\"ls-remote\", \"origin\", NOTES_REF], {\n      cwd: repo.root,\n      allowFailure: true,\n    })).trim();\n    if (!remoteHasRef) {\n      const tree = (await git([\"rev-parse\", `${NOTES_REF}^{tree}`], { cwd: repo.root })).trim();\n      const squashedCommit = (\n        await git([\"commit-tree\", tree, \"-m\", \"cledger: notes history squashed after redaction\"], {\n          cwd: repo.root,\n        })\n      ).trim();\n      await git([\"update-ref\", NOTES_REF, squashedCommit], { cwd: repo.root });\n      squashed = true;\n    } else {\n      process.stderr.write(\n        \"cledger redact: refs/notes/conversation-ledger already has a copy on origin, so the \" +\n          \"pre-redaction content is already shared history — skipping the local squash. Purging \" +\n          \"already-pushed history is separate, not-yet-built tooling (force-push + collaborator \" +\n          \"re-fetch coordination).\\n\",\n      );\n    }\n  }\n\n  return { event: rewritten, redactionEvent, squashed, knownSecretsRemembered };\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/src/store.ts","numLines":689,"startLine":1,"totalLines":689},"type":"text"},"type":"user","userType":"external","uuid":"46dc14d0-35bd-4a6e-998a-2c4cc984d045","version":"2.1.216"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-11T11:07:25.059Z","schema":"conversation-ledger/v1"}
{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { mkdir, readFile, rm, writeFile } from \"node:fs/promises\";\n2\timport { existsSync } from \"node:fs\";\n3\timport { join } from \"node:path\";\n4\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n5\timport {\n6\t  currentBranch,\n7\t  git,\n8\t  gitUserIdentity,\n9\t  headSha,\n10\t  repoIdentity,\n11\t  revList,\n12\t  statusPorcelain,\n13\t  type RepoInfo,\n14\t} from \"./git.js\";\n15\timport {\n16\t  absorbIncoming,\n17\t  ensureMergeConfig,\n18\t  ensureTransport,\n19\t  INCOMING_REF,\n20\t  NOTES_NAME,\n21\t  NOTES_REF,\n22\t} from \"./transport.js\";\n23\timport {\n24\t  finalizeEvent,\n25\t  parseEventLine,\n26\t  serializeEvent,\n27\t  type Actor,\n28\t  type EventDraft,\n29\t  type EvidenceEvent,\n30\t  type RepoContext,\n31\t} from \"./schema.js\";\n32\timport {\n33\t  commitDateIso,\n34\t  defaultRewriteTarget,\n35\t  detectRewrites,\n36\t  parseReAnchor,\n37\t  reAnchorDraft,\n38\t  type DetectedRewrite,\n39\t  type ReAnchorMapping,\n40\t  type UnmatchedBranch,\n41\t} from \"./reanchor.js\";\n42\timport { collectMatches, redactDraft, type ExtraValueGroup, type RedactionRecord } from \"./redact/apply.js\";\n43\timport { captureRules, collectEnvValues, loadConfig } from \"./redact/config.js\";\n44\timport { addKnownSecrets, loadKnownSecrets } from \"./redact/known-secrets.js\";\n45\timport { RULESET_VERSION, type RedactionRule } from \"./redact/rules.js\";\n46\timport { filterFindings, formatFinding, loadAllowlist, scanEvents } from \"./redact/scan.js\";\n47\t\n48\texport { ensureMergeConfig, NOTES_NAME, NOTES_REF } from \"./transport.js\";\n49\t\n50\t/**\n51\t * Storage model: one git note per anchor commit under refs/notes/\n52\t * conversation-ledger. The note body is JSONL — one canonical-JSON event\n53\t * per line, lexicographically sorted, unique. Everything lives in the note\n54\t * blob itself (no out-of-tree pointers), so records are reachable from the\n55\t * ref, GC-safe, travel with `git push`/`fetch` of that one ref, and merge\n56\t * conflict-free with the cat_sort_uniq notes strategy.\n57\t *\n58\t * Events are anchored to HEAD at capture time, so conversations ride the\n59\t * commit DAG: merge a branch and its conversations become reachable from\n60\t * the target branch with no extra machinery.\n61\t */\n62\t\n63\tfunction stateDir(repo: RepoInfo): string {\n64\t  return join(repo.gitDir, \"conversation-ledger\");\n65\t}\n66\t\n67\tfunction pendingPath(repo: RepoInfo): string {\n68\t  return join(stateDir(repo), \"pending.jsonl\");\n69\t}\n70\t\n71\t/** Local, rebuildable cache/state only — never the record of truth. */\n72\tasync function ensureStateDir(repo: RepoInfo): Promise<void> {\n73\t  await mkdir(stateDir(repo), { recursive: true });\n74\t}\n75\t\n76\texport async function captureContext(repo: RepoInfo): Promise<RepoContext> {\n77\t  const [identity, branch, head, status] = await Promise.all([\n78\t    repoIdentity(repo),\n79\t    currentBranch(repo),\n80\t    headSha(repo),\n81\t    statusPorcelain(repo),\n82\t  ]);\n83\t  const context: RepoContext = { repo: identity, cwd: repo.root };\n84\t  if (branch) context.branch = branch;\n85\t  if (head) context.head = head;\n86\t  if (status.trim()) context.dirty_fingerprint = sha256Hex(status);\n87\t  return context;\n88\t}\n89\t\n90\tasync function readNoteLines(repo: RepoInfo, anchor: string, refName = NOTES_NAME): Promise<string[]> {\n91\t  const body = await git([\"notes\", \"--ref\", refName, \"show\", anchor], {\n92\t    cwd: repo.root,\n93\t    allowFailure: true,\n94\t  });\n95\t  return body.split(\"\\n\").filter((l) => l.trim().length > 0);\n96\t}\n97\t\n98\t/** `refName` defaults to the main ledger ref; the scan gate also reads a temp fetched ref. */\n99\texport async function readNoteEvents(\n100\t  repo: RepoInfo,\n101\t  anchor: string,\n102\t  refName = NOTES_NAME,\n103\t): Promise<EvidenceEvent[]> {\n104\t  return (await readNoteLines(repo, anchor, refName)).map(parseEventLine);\n105\t}\n106\t\n107\t/** All (anchor commit, note) pairs in the ledger ref (or `refName`, for reading a temp fetched ref). */\n108\texport async function listAnchors(repo: RepoInfo, refName = NOTES_NAME): Promise<string[]> {\n109\t  const out = await git([\"notes\", \"--ref\", refName, \"list\"], {\n110\t    cwd: repo.root,\n111\t    allowFailure: true,\n112\t  });\n113\t  return out\n114\t    .split(\"\\n\")\n115\t    .filter(Boolean)\n116\t    .map((line) => line.split(/\\s+/)[1])\n117\t    .filter((sha): sha is string => Boolean(sha));\n118\t}\n119\t\n120\tasync function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n121\t  await ensureStateDir(repo);\n122\t  const lockDir = join(stateDir(repo), \"lock\");\n123\t  const deadline = Date.now() + 10_000;\n124\t  for (;;) {\n125\t    try {\n126\t      await mkdir(lockDir);\n127\t      break;\n128\t    } catch {\n129\t      if (Date.now() > deadline) {\n130\t        // A crashed writer can leave the lock behind; steal it after the\n131\t        // wait budget rather than wedging capture hooks forever.\n132\t        await rm(lockDir, { recursive: true, force: true });\n133\t      } else {\n134\t        await new Promise((r) => setTimeout(r, 100));\n135\t      }\n136\t    }\n137\t  }\n138\t  try {\n139\t    return await fn();\n140\t  } finally {\n141\t    await rm(lockDir, { recursive: true, force: true });\n142\t  }\n143\t}\n144\t\n145\texport interface AppendResult {\n146\t  appended: EvidenceEvent[];\n147\t  deduped: number;\n148\t  /** null when events went to the pending queue (unborn HEAD). */\n149\t  anchor: string | null;\n150\t}\n151\t\n152\texport async function appendEvents(\n153\t  repo: RepoInfo,\n154\t  drafts: EventDraft[],\n155\t  opts: { context?: RepoContext; anchor?: string } = {},\n156\t): Promise<AppendResult> {\n157\t  const context = opts.context ?? (await captureContext(repo));\n158\t  const config = await loadConfig(repo.root);\n159\t  // First capture in a repo wires up transport (pre-push hook + fetch\n160\t  // refspec); later calls are cheap re-checks. Never throws.\n161\t  await ensureTransport(repo, config);\n162\t  const rules = captureRules(config);\n163\t  // Exact-value scrubbing layers, each tagged with its own rule id for the\n164\t  // audit trail. Only consulted when capture redaction is active at all\n165\t  // (rules.length > 0); known-secrets additionally requires its opt-in flag.\n166\t  const extraValues: ExtraValueGroup[] = [];\n167\t  if (rules.length > 0) {\n168\t    if (config.redact?.knownSecrets === true) {\n169\t      const known = await loadKnownSecrets(repo);\n170\t      if (known.length > 0) extraValues.push({ ruleId: \"known-secret\", values: known });\n171\t    }\n172\t    if (config.redact?.env === true) {\n173\t      const env = await collectEnvValues(repo.root);\n174\t      if (env.length > 0) extraValues.push({ ruleId: \"env-value\", values: env });\n175\t    }\n176\t  }\n177\t  const events = drafts.map((draft) => {\n178\t    const withContext = { ...draft, context: draft.context ?? context };\n179\t    if (rules.length === 0) return finalizeEvent(withContext);\n180\t    const { draft: redacted, records } = redactDraft(withContext, {\n181\t      rules,\n182\t      ...(extraValues.length > 0 ? { extraValues } : {}),\n183\t    });\n184\t    return finalizeEvent(records.length > 0 ? { ...redacted, redactions: records } : redacted);\n185\t  });\n186\t  return withLock(repo, async () => {\n187\t    await ensureMergeConfig(repo);\n188\t    // Almost everything anchors to HEAD at capture time; re-anchor mapping\n189\t    // events override this to anchor at the successor commit so the mapping\n190\t    // rides the surviving branch's DAG regardless of where it was created.\n191\t    const anchor = opts.anchor ?? (await headSha(repo));\n192\t    if (!anchor) {\n193\t      return appendPending(repo, events);\n194\t    }\n195\t    const pending = await drainPending(repo);\n196\t    const existing = await readNoteLines(repo, anchor);\n197\t    const known = new Set(existing.map((l) => parseEventLine(l).id));\n198\t    const fresh = [...pending, ...events].filter((e) => {\n199\t      if (known.has(e.id)) return false;\n200\t      known.add(e.id);\n201\t      return true;\n202\t    });\n203\t    if (fresh.length === 0) {\n204\t      return { appended: [], deduped: events.length, anchor };\n205\t    }\n206\t    const lines = [...existing, ...fresh.map(serializeEvent)].sort();\n207\t    await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n208\t      cwd: repo.root,\n209\t      input: lines.join(\"\\n\") + \"\\n\",\n210\t    });\n211\t    const freshIds = new Set(fresh.map((e) => e.id));\n212\t    return {\n213\t      appended: events.filter((e) => freshIds.has(e.id)),\n214\t      deduped: events.length - events.filter((e) => freshIds.has(e.id)).length,\n215\t      anchor,\n216\t    };\n217\t  });\n218\t}\n219\t\n220\tasync function appendPending(repo: RepoInfo, events: EvidenceEvent[]): Promise<AppendResult> {\n221\t  await ensureStateDir(repo);\n222\t  const path = pendingPath(repo);\n223\t  const existing = existsSync(path)\n224\t    ? (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean)\n225\t    : [];\n226\t  const known = new Set(existing.map((l) => parseEventLine(l).id));\n227\t  const fresh = events.filter((e) => !known.has(e.id));\n228\t  await writeFile(path, [...existing, ...fresh.map(serializeEvent)].join(\"\\n\") + \"\\n\");\n229\t  return { appended: fresh, deduped: events.length - fresh.length, anchor: null };\n230\t}\n231\t\n232\t/** Events held while HEAD was unborn; caller writes them into a real note. */\n233\tasync function drainPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n234\t  const path = pendingPath(repo);\n235\t  if (!existsSync(path)) return [];\n236\t  const events = (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n237\t  await rm(path, { force: true });\n238\t  return events;\n239\t}\n240\t\n241\texport async function readPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n242\t  const path = pendingPath(repo);\n243\t  if (!existsSync(path)) return [];\n244\t  return (await readFile(path, \"utf8\")).split(\"\\n\").filter(Boolean).map(parseEventLine);\n245\t}\n246\t\n247\texport interface ReadOptions {\n248\t  /** Restrict to events anchored to commits reachable from this rev. */\n249\t  reachableFrom?: string;\n250\t  kind?: string;\n251\t  source?: string;\n252\t  conversation?: string;\n253\t}\n254\t\n255\texport async function readEvents(repo: RepoInfo, opts: ReadOptions = {}): Promise<EvidenceEvent[]> {\n256\t  // Lazy transport: fold in anything a plain `git fetch`/`git pull` staged.\n257\t  await absorbIncoming(repo);\n258\t  // Lazy re-anchoring, same shape: if the fetch revealed that the remote\n259\t  // target branch rewrote noted commits (squash merge), map them before\n260\t  // filtering by reachability below.\n261\t  await autoReAnchor(repo);\n262\t  let anchors = await listAnchors(repo);\n263\t  const noteCache = new Map<string, EvidenceEvent[]>();\n264\t  const readNote = async (anchor: string): Promise<EvidenceEvent[]> => {\n265\t    let events = noteCache.get(anchor);\n266\t    if (!events) {\n267\t      events = await readNoteEvents(repo, anchor);\n268\t      noteCache.set(anchor, events);\n269\t    }\n270\t    return events;\n271\t  };\n272\t  if (opts.reachableFrom) {\n273\t    anchors = await resolveAnchors(repo, anchors, opts.reachableFrom, readNote);\n274\t  }\n275\t  const events: EvidenceEvent[] = [];\n276\t  for (const anchor of anchors) {\n277\t    events.push(...(await readNote(anchor)));\n278\t  }\n279\t  events.push(...(await readPending(repo)));\n280\t  const filtered = events.filter(\n281\t    (e) =>\n282\t      (!opts.kind || e.kind === opts.kind) &&\n283\t      (!opts.source || e.producer.source === opts.source) &&\n284\t      (!opts.conversation || e.conversation?.id === opts.conversation ||\n285\t        e.conversation?.id.startsWith(opts.conversation)),\n286\t  );\n287\t  return sortEvents(filtered);\n288\t}\n289\t\n290\t/**\n291\t * Reachability with re-anchor resolution. Plain reachability drops any\n292\t * conversation whose anchor commit was rewritten away (a GitHub squash merge\n293\t * discards the branch's commits, so their notes fall out of `rev-list` even\n294\t * though the work survives in the squash commit). A `re_anchor` event —\n295\t * anchored to the successor commit, so it is discoverable exactly when the\n296\t * successor is in view — repairs this: an anchor counts as reachable when the\n297\t * rev reaches it, or when a mapping whose successor is reachable names it as\n298\t * superseded. Superseded commits can themselves anchor further mappings\n299\t * (a squash commit later rewritten again), so resolution loops to a fixpoint:\n300\t * grow the reachable set, read the notes that just became visible, repeat.\n301\t * The set only grows and each note is read once, so it terminates.\n302\t */\n303\tasync function resolveAnchors(\n304\t  repo: RepoInfo,\n305\t  anchors: string[],\n306\t  rev: string,\n307\t  readNote: (anchor: string) => Promise<EvidenceEvent[]>,\n308\t): Promise<string[]> {\n309\t  const reachable = await revList(repo, rev);\n310\t  const visited = new Set<string>();\n311\t  const mappings: ReAnchorMapping[] = [];\n312\t  for (;;) {\n313\t    const frontier = anchors.filter((a) => reachable.has(a) && !visited.has(a));\n314\t    for (const anchor of frontier) {\n315\t      visited.add(anchor);\n316\t      for (const event of await readNote(anchor)) {\n317\t        const mapping = parseReAnchor(event);\n318\t        if (mapping) mappings.push(mapping);\n319\t      }\n320\t    }\n321\t    let grew = false;\n322\t    for (const mapping of mappings) {\n323\t      // A mapping only applies once its successor is in view; one pointing\n324\t      // at an unreachable successor (e.g. asserted from another branch)\n325\t      // changes nothing here.\n326\t      if (!reachable.has(mapping.successor)) continue;\n327\t      for (const sha of mapping.superseded) {\n328\t        if (!reachable.has(sha)) {\n329\t          reachable.add(sha);\n330\t          grew = true;\n331\t        }\n332\t      }\n333\t    }\n334\t    if (frontier.length === 0 && !grew) break;\n335\t  }\n336\t  return anchors.filter((a) => reachable.has(a));\n337\t}\n338\t\n339\t/** Commits carrying notes, and the commits existing mappings already supersede. */\n340\tasync function reAnchorState(\n341\t  repo: RepoInfo,\n342\t): Promise<{ anchors: Set<string>; alreadySuperseded: Set<string> }> {\n343\t  const anchors = new Set(await listAnchors(repo));\n344\t  const alreadySuperseded = new Set<string>();\n345\t  for (const anchor of anchors) {\n346\t    for (const event of await readNoteEvents(repo, anchor)) {\n347\t      const mapping = parseReAnchor(event);\n348\t      if (mapping) for (const sha of mapping.superseded) alreadySuperseded.add(sha);\n349\t    }\n350\t  }\n351\t  return { anchors, alreadySuperseded };\n352\t}\n353\t\n354\texport interface ReAnchorRunResult {\n355\t  /** Rev the detection compared against, or null when none could be resolved. */\n356\t  target: string | null;\n357\t  detected: DetectedRewrite[];\n358\t  ambiguous: string[];\n359\t  /** Noted, rewritten-looking branches exact matching could not map. */\n360\t  unmatched: UnmatchedBranch[];\n361\t  /** Mapping events actually appended — empty on dry runs and re-runs. */\n362\t  applied: EvidenceEvent[];\n363\t}\n364\t\n365\t/**\n366\t * One detection pass against `target` (default: the remote default branch),\n367\t * optionally appending the proposed exact mappings, each anchored to its\n368\t * successor commit. Re-running is a no-op: commits an existing mapping\n369\t * covers are excluded from detection, and identical mapping events dedup by\n370\t * id anyway. Ambiguous branches are reported, never guessed at.\n371\t */\n372\texport async function runReAnchor(\n373\t  repo: RepoInfo,\n374\t  opts: { target?: string; apply: boolean },\n375\t): Promise<ReAnchorRunResult> {\n376\t  const target = opts.target ?? (await defaultRewriteTarget(repo));\n377\t  if (!target) return { target: null, detected: [], ambiguous: [], unmatched: [], applied: [] };\n378\t  const { anchors, alreadySuperseded } = await reAnchorState(repo);\n379\t  if (anchors.size === 0) return { target, detected: [], ambiguous: [], unmatched: [], applied: [] };\n380\t  const { detected, ambiguous, unmatched } = await detectRewrites(repo, {\n381\t    target,\n382\t    anchors,\n383\t    alreadySuperseded,\n384\t  });\n385\t  const applied: EvidenceEvent[] = [];\n386\t  if (opts.apply) {\n387\t    for (const rewrite of detected) {\n388\t      const result = await appendEvents(repo, [reAnchorDraft(rewrite.mapping)], {\n389\t        anchor: rewrite.mapping.successor,\n390\t      });\n391\t      applied.push(...result.appended);\n392\t    }\n393\t  }\n394\t  return { target, detected, ambiguous, unmatched, applied };\n395\t}\n396\t\n397\t/**\n398\t * Manual mapping — the escape hatch for everything mechanical matching\n399\t * cannot assert: a maintainer edited during the squash, the branch is long\n400\t * gone, an ambiguous match needed a human eye. Asserted by the user, so the\n401\t * actor is the user (two humans asserting the same mapping yield two\n402\t * events; honest provenance, and the reads they affect are identical).\n403\t */\n404\texport async function manualReAnchor(\n405\t  repo: RepoInfo,\n406\t  supersededRevs: string[],\n407\t  ontoRev: string,\n408\t): Promise<{ event: EvidenceEvent | null; superseded: string[]; successor: string }> {\n409\t  const resolve = async (rev: string): Promise<string> => {\n410\t    const sha = (await git([\"rev-parse\", \"--verify\", \"--quiet\", `${rev}^{commit}`], {\n411\t      cwd: repo.root,\n412\t      allowFailure: true,\n413\t    })).trim();\n414\t    if (!sha) throw new Error(`cledger re-anchor: cannot resolve \"${rev}\" to a commit`);\n415\t    return sha;\n416\t  };\n417\t  const successor = await resolve(ontoRev);\n418\t  const superseded = [];\n419\t  for (const rev of supersededRevs) {\n420\t    // A superseded commit may already be GC'd (its branch deleted long ago)\n421\t    // — the mapping is how its still-enumerable note stays meaningful — so a\n422\t    // full SHA is taken at its word; only shorthand needs a live object.\n423\t    superseded.push(/^[0-9a-f]{40}$/.test(rev) ? rev : await resolve(rev));\n424\t  }\n425\t\n426\t  const identity = await gitUserIdentity(repo);\n427\t  const actor: Actor = { type: \"human\" };\n428\t  if (identity.email) actor.id = identity.email;\n429\t  if (identity.name) actor.display = identity.name;\n430\t\n431\t  const result = await appendEvents(\n432\t    repo,\n433\t    [\n434\t      reAnchorDraft({\n435\t        superseded,\n436\t        successor,\n437\t        method: \"manual\",\n438\t        occurredAt: await commitDateIso(repo, successor),\n439\t        actor,\n440\t      }),\n441\t    ],\n442\t    { anchor: successor },\n443\t  );\n444\t  // null means an identical mapping already exists — dedup, not failure.\n445\t  return { event: result.appended[0] ?? null, superseded, successor };\n446\t}\n447\t\n448\t/**\n449\t * Default-on half of re-anchoring (config: {\"reanchor\": {\"auto\": false}} to\n450\t * disable): runs inside every read, right after absorbIncoming, so a plain\n451\t * `git fetch` + `cledger log` is enough for a squash-merged branch's\n452\t * conversations to follow the squash commit. The detection pass costs a\n453\t * handful of subprocesses per local branch, so it is gated on a cursor over\n454\t * the target tip and only runs when the target actually moved. Never throws\n455\t * — a read must never fail because detection did. The known gap the cursor\n456\t * accepts: conversations captured onto an already-dead branch after the\n457\t * target was seen won't auto-map until the target moves again — `cledger\n458\t * re-anchor` covers that manually.\n459\t */\n460\tasync function autoReAnchor(repo: RepoInfo): Promise<void> {\n461\t  try {\n462\t    const config = await loadConfig(repo.root);\n463\t    if (config.reanchor?.auto === false) return;\n464\t    const target = await defaultRewriteTarget(repo);\n465\t    if (!target) return;\n466\t    const tip = (await git([\"rev-parse\", \"--verify\", \"--quiet\", target], {\n467\t      cwd: repo.root,\n468\t      allowFailure: true,\n469\t    })).trim();\n470\t    if (!tip) return;\n471\t    const cursorPath = join(stateDir(repo), \"reanchor-cursor\");\n472\t    let seen = \"\";\n473\t    try {\n474\t      seen = (await readFile(cursorPath, \"utf8\")).trim();\n475\t    } catch {\n476\t      // first run, or unreadable state — state is rebuildable\n477\t    }\n478\t    if (seen === tip) return;\n479\t    const result = await runReAnchor(repo, { target, apply: true });\n480\t    if (result.applied.length > 0) {\n481\t      const anchors = result.detected.reduce((n, d) => n + d.notedAnchors, 0);\n482\t      process.stderr.write(\n483\t        `cledger: re-anchored ${anchors} conversation anchor(s) rewritten away by ${target} ` +\n484\t          `(mappings recorded in the ledger)\\n`,\n485\t      );\n486\t    }\n487\t    if (result.ambiguous.length > 0) {\n488\t      process.stderr.write(\n489\t        `cledger: branch(es) ${result.ambiguous.join(\", \")} look rewritten onto ${target} but ` +\n490\t          `match more than one commit — run \\`cledger re-anchor\\` to resolve manually\\n`,\n491\t      );\n492\t    }\n493\t    await ensureStateDir(repo);\n494\t    await writeFile(cursorPath, tip + \"\\n\");\n495\t  } catch {\n496\t    // Reads must never fail because detection did.\n497\t  }\n498\t}\n499\t\n500\t/** Stable order: conversation, then seq, then time, then id. */\n501\texport function sortEvents(events: EvidenceEvent[]): EvidenceEvent[] {\n502\t  return [...events].sort((a, b) => {\n503\t    const conv = (a.conversation?.id ?? \"\").localeCompare(b.conversation?.id ?? \"\");\n504\t    if (conv !== 0) return conv;\n505\t    const seq = (a.conversation?.seq ?? 0) - (b.conversation?.seq ?? 0);\n506\t    if (seq !== 0) return seq;\n507\t    const time = a.occurred_at.localeCompare(b.occurred_at);\n508\t    if (time !== 0) return time;\n509\t    return a.id.localeCompare(b.id);\n510\t  });\n511\t}\n512\t\n513\texport interface SyncResult {\n514\t  fetched: boolean;\n515\t  pushed: boolean;\n516\t}\n517\t\n518\t/**\n519\t * Event ids the remote's notes ref already has, fetched into a throwaway\n520\t * temp ref that is deleted before returning. Null means the remote has no\n521\t * ledger ref at all (e.g. first push), in which case the caller should\n522\t * treat everything local as unshared.\n523\t */\n524\tasync function remoteNoteIds(repo: RepoInfo, remote: string): Promise<Set<string> | null> {\n525\t  const remoteHasRef = (await git([\"ls-remote\", remote, NOTES_REF], {\n526\t    cwd: repo.root,\n527\t    allowFailure: true,\n528\t  })).trim();\n529\t  if (!remoteHasRef) return null;\n530\t\n531\t  const tmpName = \"conversation-ledger-scan-tmp\";\n532\t  const tmpRef = `refs/notes/${tmpName}`;\n533\t  await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n534\t  try {\n535\t    const ids = new Set<string>();\n536\t    for (const anchor of await listAnchors(repo, tmpName)) {\n537\t      for (const event of await readNoteEvents(repo, anchor, tmpName)) ids.add(event.id);\n538\t    }\n539\t    return ids;\n540\t  } finally {\n541\t    await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n542\t  }\n543\t}\n544\t\n545\t/** Thrown when the layer-E scan gate blocks a push; carries no secrets. */\n546\texport class ScanBlockedError extends Error {\n547\t  constructor(public readonly findings: number) {\n548\t    super(`cledger sync: push blocked — ${findings} potential secret(s) found (see report above)`);\n549\t  }\n550\t}\n551\t\n552\t/**\n553\t * Layer E: before push, scan only the events the remote does not yet have\n554\t * (already-pushed events are not rescanned every time). On any surviving\n555\t * finding, print a report and throw so sync() does not proceed to push —\n556\t * the fetch/merge phase, if it already ran, is left in place.\n557\t */\n558\tasync function runScanGate(repo: RepoInfo, remote: string, tier: \"standard\" | \"paranoid\"): Promise<void> {\n559\t  const remoteIds = await remoteNoteIds(repo, remote);\n560\t\n561\t  const localEvents: EvidenceEvent[] = [];\n562\t  for (const anchor of await listAnchors(repo)) {\n563\t    localEvents.push(...(await readNoteEvents(repo, anchor)));\n564\t  }\n565\t  localEvents.push(...(await readPending(repo)));\n566\t\n567\t  const candidates = remoteIds ? localEvents.filter((e) => !remoteIds.has(e.id)) : localEvents;\n568\t  if (candidates.length === 0) return;\n569\t\n570\t  const findings = filterFindings(scanEvents(candidates, tier), await loadAllowlist(repo));\n571\t  if (findings.length === 0) return;\n572\t\n573\t  process.stderr.write(\n574\t    `cledger sync: blocked — ${findings.length} potential secret(s) in event(s) not yet on ${remote}\\n\\n`,\n575\t  );\n576\t  for (const f of findings) process.stderr.write(`  ${formatFinding(f)}\\n`);\n577\t  process.stderr.write(\n578\t    \"\\nRemediate, then re-run sync:\\n\" +\n579\t      \"  cledger redact <event-id>     rewrite the event and remove the secret\\n\" +\n580\t      \"  cledger allow <fingerprint>   mark a fingerprint as a known false positive\\n\" +\n581\t      \"  cledger sync --no-scan        skip this gate for this sync only\\n\",\n582\t  );\n583\t  throw new ScanBlockedError(findings.length);\n584\t}\n585\t\n586\t/**\n587\t * Sync of the single ledger ref: explicit via `cledger sync`, or run by the\n588\t * pre-push transport hook (see transportPush). The fetch phase stages into\n589\t * INCOMING_REF and absorbs it — the same path a plain `git fetch` plus a\n590\t * later read takes.\n591\t */\n592\texport async function sync(\n593\t  repo: RepoInfo,\n594\t  remote = \"origin\",\n595\t  mode: \"both\" | \"push\" | \"fetch\" = \"both\",\n596\t  opts: { skipScan?: boolean; paranoid?: boolean } = {},\n597\t): Promise<SyncResult> {\n598\t  const result: SyncResult = { fetched: false, pushed: false };\n599\t  await ensureMergeConfig(repo);\n600\t  if (mode !== \"push\") {\n601\t    await git(\n602\t      [\"fetch\", remote, `+${NOTES_REF}:${INCOMING_REF}`],\n603\t      { cwd: repo.root, allowFailure: true },\n604\t    );\n605\t    result.fetched = await absorbIncoming(repo);\n606\t  }\n607\t  if (mode !== \"fetch\") {\n608\t    const config = await loadConfig(repo.root);\n609\t    const scanDisabled = opts.skipScan === true || config.scan?.tier === \"off\";\n610\t    if (!scanDisabled) {\n611\t      const tier: \"standard\" | \"paranoid\" =\n612\t        opts.paranoid === true || config.scan?.tier === \"paranoid\" ? \"paranoid\" : \"standard\";\n613\t      await runScanGate(repo, remote, tier);\n614\t    }\n615\t    // The pushed child git inherits CLEDGER_INTERNAL, telling the pre-push\n616\t    // transport hook this push *is* the ledger push — no recursion.\n617\t    const prior = process.env[\"CLEDGER_INTERNAL\"];\n618\t    process.env[\"CLEDGER_INTERNAL\"] = \"1\";\n619\t    try {\n620\t      await git([\"push\", remote, `${NOTES_REF}:${NOTES_REF}`], { cwd: repo.root });\n621\t    } finally {\n622\t      if (prior === undefined) delete process.env[\"CLEDGER_INTERNAL\"];\n623\t      else process.env[\"CLEDGER_INTERNAL\"] = prior;\n624\t    }\n625\t    result.pushed = true;\n626\t  }\n627\t  return result;\n628\t}\n629\t\n630\texport interface TransportPushResult {\n631\t  pushed: boolean;\n632\t  /** True when scan findings held the ledger back (non-strict mode). */\n633\t  held: boolean;\n634\t}\n635\t\n636\t/**\n637\t * Pre-push hook entrypoint policy. Pushes the ledger ref alongside the\n638\t * user's own push. A scan finding blocks only the ledger by default —\n639\t * secrets never leave the machine, but a false positive never blocks\n640\t * shipping code; {\"transport\": {\"strict\": true}} escalates to aborting the\n641\t * whole push (rethrows ScanBlockedError; the CLI exits nonzero). Any other\n642\t * failure (network, missing remote ref perms) warns and lets the push\n643\t * proceed — the hook must never make `git push` flaky.\n644\t */\n645\texport async function transportPush(repo: RepoInfo, remote: string): Promise<TransportPushResult> {\n646\t  const config = await loadConfig(repo.root);\n647\t  if (config.transport?.hook === false) return { pushed: false, held: false };\n648\t  const hasNotes = (await git([\"rev-parse\", \"--verify\", \"--quiet\", NOTES_REF], {\n649\t    cwd: repo.root,\n650\t    allowFailure: true,\n651\t  })).trim();\n652\t  if (!hasNotes) return { pushed: false, held: false };\n653\t\n654\t  try {\n655\t    await sync(repo, remote, \"push\");\n656\t    return { pushed: true, held: false };\n657\t  } catch (err) {\n658\t    if (err instanceof ScanBlockedError) {\n659\t      if (config.transport?.strict === true) throw err;\n660\t      process.stderr.write(\n661\t        \"cledger: conversation records were held back from this push (potential secrets — \" +\n662\t          \"see report above); your code push continues. Run `cledger sync` to review and \" +\n663\t          \"remediate.\\n\",\n664\t      );\n665\t      return { pushed: false, held: true };\n666\t    }\n667\t    process.stderr.write(\n668\t      `cledger: ledger push skipped (${err instanceof Error ? err.message : String(err)})\\n`,\n669\t    );\n670\t    return { pushed: false, held: false };\n671\t  }\n672\t}\n673\t\n674\tinterface LocatedEvent {\n675\t  event: EvidenceEvent;\n676\t  /** Anchor commit holding the note line, or null when the event is still in pending.jsonl. */\n677\t  anchor: string | null;\n678\t  /** Full line array of the containing note (or of pending.jsonl), for in-place rewrite. */\n679\t  lines: string[];\n680\t  index: number;\n681\t}\n682\t\n683\tfunction idMatchesPrefix(id: string, prefix: string): boolean {\n684\t  if (id.startsWith(prefix)) return true;\n685\t  const hash = id.startsWith(\"ev1-\") ? id.slice(4) : id;\n686\t  return hash.startsWith(prefix);\n687\t}\n688\t\n689\t/** Find the one event matching `idPrefix` across every anchor and the pending queue. */\n690\tasync function locateEvent(repo: RepoInfo, idPrefix: string): Promise<LocatedEvent> {\n691\t  const matches: LocatedEvent[] = [];\n692\t\n693\t  for (const anchor of await listAnchors(repo)) {\n694\t    const lines = await readNoteLines(repo, anchor);\n695\t    lines.forEach((line, index) => {\n696\t      const event = parseEventLine(line);\n697\t      if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor, lines, index });\n698\t    });\n699\t  }\n700\t\n701\t  const pendingFile = pendingPath(repo);\n702\t  const pendingLines = existsSync(pendingFile)\n703\t    ? (await readFile(pendingFile, \"utf8\")).split(\"\\n\").filter((l) => l.trim().length > 0)\n704\t    : [];\n705\t  pendingLines.forEach((line, index) => {\n706\t    const event = parseEventLine(line);\n707\t    if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor: null, lines: pendingLines, index });\n708\t  });\n709\t\n710\t  if (matches.length === 0) {\n711\t    throw new Error(`cledger redact: no event matches id prefix \"${idPrefix}\"`);\n712\t  }\n713\t  if (matches.length > 1) {\n714\t    throw new Error(\n715\t      `cledger redact: id prefix \"${idPrefix}\" is ambiguous (${matches.length} matches: ` +\n716\t        `${matches.map((m) => m.event.id).join(\", \")})`,\n717\t    );\n718\t  }\n719\t  return matches[0]!;\n720\t}\n721\t\n722\texport interface RedactResult {\n723\t  /** The rewritten event, with the secret removed. */\n724\t  event: EvidenceEvent;\n725\t  /** The companion `redaction` event recording why `event`'s content no longer matches its id. */\n726\t  redactionEvent: EvidenceEvent;\n727\t  /** True when the pre-redaction notes history was squashed away locally (see below). */\n728\t  squashed: boolean;\n729\t  /**\n730\t   * Count of newly-remembered secret values written to the opt-in\n731\t   * known-secrets store (0 unless `redact.knownSecrets` is on and this was a\n732\t   * `--pattern` redaction that matched at least one not-already-known value).\n733\t   */\n734\t  knownSecretsRemembered: number;\n735\t}\n736\t\n737\t/**\n738\t * Human redaction of an *existing* event (layer E's remediation path, as\n739\t * opposed to capture-time redaction in redact/apply.ts). Locates the event\n740\t * by id prefix, rewrites its content in place, appends a companion\n741\t * `redaction` event, and — when the pre-redaction content was never\n742\t * pushed — squashes the local notes ref history so the old blob becomes\n743\t * unreachable.\n744\t */\n745\texport async function redactEvent(\n746\t  repo: RepoInfo,\n747\t  idPrefix: string,\n748\t  opts: { pattern?: string; all?: boolean; reason?: string },\n749\t): Promise<RedactResult> {\n750\t  const hasPattern = typeof opts.pattern === \"string\" && opts.pattern.length > 0;\n751\t  const hasAll = opts.all === true;\n752\t  if (hasPattern === hasAll) {\n753\t    throw new Error(\"cledger redact: exactly one of --pattern or --all is required\");\n754\t  }\n755\t\n756\t  // Opt-in: when on, remember the exact values a --pattern redaction scrubs so\n757\t  // capture-time redaction can keep them out of future events (see\n758\t  // redact/known-secrets.ts). The --all path blanks whole content, so there is\n759\t  // no reusable value to remember there.\n760\t  const config = await loadConfig(repo.root);\n761\t  const rememberSecrets = hasPattern && config.redact?.knownSecrets === true;\n762\t\n763\t  const { located, rewritten, newRecords, secretValues } = await withLock(repo, async () => {\n764\t    const located = await locateEvent(repo, idPrefix);\n765\t    const original = located.event;\n766\t\n767\t    let rewrittenContent: unknown = original.content;\n768\t    let rewrittenRaw = original.raw;\n769\t    const newRecords: RedactionRecord[] = [];\n770\t    const secretValues: string[] = [];\n771\t\n772\t    if (hasPattern) {\n773\t      let pattern: RegExp;\n774\t      try {\n775\t        pattern = new RegExp(opts.pattern!, \"g\");\n776\t      } catch (err) {\n777\t        throw new Error(\n778\t          `cledger redact: invalid --pattern regex: ${err instanceof Error ? err.message : String(err)}`,\n779\t        );\n780\t      }\n781\t      const rule: RedactionRule = {\n782\t        id: \"manual\",\n783\t        tier: \"capture\",\n784\t        description: \"Manually specified redaction pattern\",\n785\t        pattern,\n786\t      };\n787\t      const { draft: patched, records } = redactDraft(original, { rules: [rule] });\n788\t      if (records.length === 0) {\n789\t        throw new Error(`cledger redact: --pattern matched nothing in event ${original.id}`);\n790\t      }\n791\t      rewrittenContent = patched.content;\n792\t      rewrittenRaw = patched.raw;\n793\t      newRecords.push(...records);\n794\t      if (rememberSecrets) {\n795\t        secretValues.push(...collectMatches(original.content, pattern));\n796\t        if (original.raw) secretValues.push(...collectMatches(original.raw.data, pattern));\n797\t      }\n798\t    } else {\n799\t      const fingerprint = sha256Hex(canonicalJson(original.content)).slice(0, 12);\n800\t      rewrittenContent = `[REDACTED:manual:${fingerprint}]`;\n801\t      rewrittenRaw = undefined;\n802\t      newRecords.push({ rule: \"manual\", ruleset: RULESET_VERSION, fingerprint, path: \"content\" });\n803\t    }\n804\t\n805\t    // CRITICAL: this draft carries `original.id` explicitly, and\n806\t    // finalizeEvent below (`draft.id ?? eventId(draft)`) preserves a\n807\t    // supplied id rather than recomputing it. If the id were recomputed\n808\t    // here from the rewritten (secret-free) content, it would no longer\n809\t    // match the id a fresh capture of the *original* source material would\n810\t    // produce — so a later transcript rescan (ids are a pure function of\n811\t    // source content; that's what makes capture idempotent) would\n812\t    // regenerate the original, unredacted event under its old id, dedup\n813\t    // would no longer recognize it as \"already seen\" against this\n814\t    // rewritten line, and the secret would silently reappear in the\n815\t    // ledger. Keeping the id stable means the rewritten line permanently\n816\t    // occupies that id slot — any rescan producing the same id dedups\n817\t    // against it instead. The companion `redaction` event appended below\n818\t    // is what records why this event's content no longer matches what its\n819\t    // id would normally imply.\n820\t    const rewrittenDraft: EventDraft = {\n821\t      ...original,\n822\t      id: original.id,\n823\t      content: rewrittenContent,\n824\t      redactions: [...(original.redactions ?? []), ...newRecords],\n825\t    };\n826\t    if (rewrittenRaw === undefined) delete rewrittenDraft.raw;\n827\t    else rewrittenDraft.raw = rewrittenRaw;\n828\t\n829\t    const rewritten = finalizeEvent(rewrittenDraft);\n830\t    if (rewritten.id !== original.id) {\n831\t      // Should be unreachable given the explicit `id: original.id` above;\n832\t      // guarded because a dedup break here is exactly the failure mode the\n833\t      // comment above exists to prevent.\n834\t      throw new Error(\"cledger redact: internal error — rewritten event id drifted from the original\");\n835\t    }\n836\t\n837\t    const newLines = [...located.lines];\n838\t    newLines[located.index] = serializeEvent(rewritten);\n839\t    if (located.anchor !== null) {\n840\t      newLines.sort();\n841\t      await git([\"notes\", \"--ref\", NOTES_NA