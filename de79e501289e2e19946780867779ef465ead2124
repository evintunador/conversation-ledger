{"actor":{"type":"system"},"content":{"blocks":[{"content":"120\t  const chunks: Buffer[] = [];\n121\t  for await (const chunk of input) chunks.push(chunk as Buffer);\n122\t  return Buffer.concat(chunks).toString(\"utf8\");\n123\t}\n124\t\n125\tfunction readOptionsFrom(flags: Flags): ReadOptions {\n126\t  const opts: ReadOptions = {};\n127\t  if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n128\t  if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n129\t  if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n130\t  if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n131\t  return opts;\n132\t}\n133\t\n134\tfunction snippet(event: EvidenceEvent): string {\n135\t  const c = event.content as Record<string, unknown> | string | null;\n136\t  let text = \"\";\n137\t  if (typeof c === \"string\") text = c;\n138\t  else if (c && typeof c === \"object\") {\n139\t    text = String(c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"] ?? JSON.stringify(c));\n140\t  }\n141\t  text = text.replace(/\\s+/g, \" \").trim();\n142\t  return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n143\t}\n144\t\n145\tfunction printHuman(events: EvidenceEvent[]): void {\n146\t  for (const e of events) {\n147\t    const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n148\t    const role =\n149\t      (e.content as Record<string, unknown> | null | undefined) &&\n150\t      typeof e.content === \"object\"\n151\t        ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n152\t        : e.actor.type;\n153\t    process.stdout.write(\n154\t      `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n155\t    );\n156\t  }\n157\t}\n158\t\n159\t/**\n160\t * `reasoning` events are opaque ciphertext, never meant for a human-facing\n161\t * transcript — `log`/`show` hid