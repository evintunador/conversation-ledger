_id?: string;\n76: }\n77: \n78: /**\n79:  * The source-stated agent facts an adapter attaches to `producer`. Adapters\n80:  * gather these from wherever the source records them — a per-line field, a\n81:  * preceding session/turn-context line — and spread them onto every event\n82:  * they emit for that part of the transcript.\n83:  */\n84: export type ProducerAgentContext = Pick<Producer, \"source_version\" | \"model\" | \"provider\">;\n85: \n86: export interface RepoContext {\n87:   /** Best-known repository identity (origin URL or top-level dir name). */\n88:   repo?: string;\n89:   branch?: string;\n90:   /** HEAD commit SHA at capture time. */\n91:   head?: string;\n92:   /** Working directory the conversation ran in. */\n93:   cwd?: string;\n94:   /** sha256 of `git status --porcelain` output when the tree was dirty. */\n95:   dirty_fingerprint?: string;\n96: }\n97: \n98: export interface ConversationRef {\n99:   /** Namespaced conversation id, e.g. \"claude-code:<session uuid>\". */\n100:   id: string;\n101:   /** Stable ordering key within the conversation (source line index). */\n102:   seq: number;\n103: }\n104: \n105: export interface EventLink {\n106:   /** e.g. \"redacts\", \"supersedes\", \"annotates\", \"replies_to\" */\n107:   rel: string;\n108:   /** Target event id. */\n109:   target: string;\n110: }\n111: \n112: export interface EvidenceEvent {\n113:   /** \"ev1-\" + sha256 of the identity subset (see eventId). */\n114:   id: string;\n115:   schema: typeof SCHEMA_VERSION;\n116:   kind: string;\n117:   /** When the content happened, ISO 8601 UTC (from the source when known). */\n118:   occurred_at: string;\n119:   /** When this event was appended to the ledger. Not part of identity. */\n120:   recorded_at: string;\n121:   actor: Actor;\n122:   producer: Producer;\n123:   /** IANA media type of `content`; defaults to application/json. */\n124:   media_type?: string;\n125:   /** The visible content itself, stored inline and never reinterpreted. */\n126:   content: unknown;\n127:   /** Repository context at capture time. Not part of identity. */\n128:   context?: RepoContext;\n129:   conversation?: ConversationRef;\n130:   links?: EventLink[];\n131:   /**\n132:    * Opaque source-native payload for lossless export, e.g. the original\n133:    * transcript line(s). Versioned by `format`. Not part of identity.\n134:    */\n135:   raw?: { format: string; data: unknown };\n136:   /**\n137:    * Capture-time redaction records (rule id, ruleset version, fingerprint,\n138:    * location path), present when the capture-tier ruleset rewrote part of\n139:    * `content`/`raw.data` before this event was finalized. Deliberately\n140:    * excluded from the identity subset: the rewritten `content` already\n141:    * determines `id`, so including this here would double-count the same\n142:    * fact and would churn ids on ruleset upgrades even when the visible\n143:    * content is unchanged.\n144:    */\n145:   redactions?: RedactionRecord[];\n146: }\n147: \n148: /** Fields an adapter supplies; id/schema/recorded_at are filled at append. */\n149: export type EventDraft = Omit<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\"> &\n150:   Partial<Pick<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\">>;\n151: \n152: /**\n153:  * Event identity is derived from the durable, source-determined subset so\n154:  * that re-scanning the same source material always yields the same id\n155:  * (idempotent capture). Volatile provenance — recorded_at, context, raw,\n156:  * producer.version/tool — is deliberately excluded: a re-ingestion under a\n157:  * different HEAD or adapter version must dedup, not duplicate.\n158:  *\n159:  * `producer.model`/`provider`/`source_version` are excluded for the same\n160:  * reason even though they *are* source-determined and stable per line. They\n161:  * were added after events had already been captured without them, so folding\n162:  * them into identity would give the very same transcript line a