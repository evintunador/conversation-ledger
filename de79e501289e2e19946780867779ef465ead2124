3:   );\n374:   process.exit(1);\n375: }\n376: \n377: /**\n378:  * Show a finding with enough surrounding text to actually judge it — the\n379:  * counterpart to `formatFinding`'s deliberately contentless report.\n380:  *\n381:  * Two guards, both load-bearing rather than decorative. It refuses to run\n382:  * inside a coding-agent session, because an agent investigating a blocked sync\n383:  * would otherwise read the flagged text into the transcript and mint a fresh\n384:  * event carrying it. And it writes to a file outside the repo by default\n385:  * rather than to stdout, so the content does not pass through a terminal that\n386:  * something else may be recording.\n387:  */\n388: async function cmdInspect(positional: string[], flags: Flags): Promise<void> {\n389:   if (positional.length === 0) {\n390:     process.stderr.write(\n391:       \"usage: cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\\n\",\n392:     );\n393:     process.exit(2);\n394:   }\n395:   const agentVar = inAgentSession();\n396:   if (agentVar && !flags[\"force\"]) {\n397:     process.stderr.write(\n398:       `cledger inspect: refusing to run inside a coding-agent session (saw $${agentVar}).\\n\\n` +\n399:         \"  Reading flagged content here would capture it into this conversation and\\n\" +\n400:         \"  re-seed the finding you are inspecting. Run this in a plain terminal.\\n\\n\" +\n401:         \"  --force overrides, and is almost always the wrong call.\\n\",\n402:     );\n403:     process.exit(2);\n404:   }\n405: \n406:   const repo = await requireRepo();\n407:   const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n408:   const prefix = positional[0]!;\n409:   const context = typeof flags[\"context\"] === \"string\" ? Number(flags[\"context\"]) : 400;\n410:   if (!Number.isFinite(context) || context < 0) {\n411:     process.stderr.write(\"cledger inspect: --context must be a non-negative number\\n\");\n41