{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\timport { readFileSync } from \"node:fs\";\n3\timport { stdin as input } from \"node:process\";\n4\timport { findRepo, type RepoInfo } from \"./git.js\";\n5\timport {\n6\t  appendEvents,\n7\t  readEvents,\n8\t  redactEvent,\n9\t  ScanBlockedError,\n10\t  sortEvents,\n11\t  sync,\n12\t  transportPush,\n13\t  type ReadOptions,\n14\t} from \"./store.js\";\n15\timport { parseEventLine, type EventDraft, type EvidenceEvent } from \"./schema.js\";\n16\timport { runClaudeCodeHook, captureClaudeTranscript } from \"./adapters/claude-code.js\";\n17\timport { runCodexHook, captureCodexTranscript } from \"./adapters/codex.js\";\n18\timport { renormalize } from \"./renormalize.js\";\n19\timport { installAdapters } from \"./install.js\";\n20\timport {\n21\t  addToAllowlist,\n22\t  filterFindings,\n23\t  formatFinding,\n24\t  loadAllowlist,\n25\t  scanEvents,\n26\t} from \"./redact/scan.js\";\n27\t\n28\tconst USAGE = `conversation-ledger — durable records of coding-agent conversations, in git notes\n29\t\n30\tUsage:\n31\t  cledger append [--quiet]                 append JSONL events/drafts from stdin\n32\t  cledger log [--all|--rev R] [--kind K] [--source S] [--conversation C] [--json]\n33\t  cledger show <conversation-id-prefix> [--json]\n34\t  cledger conversations [--rev R]         list conversations on current branch (--all for every branch)\n35\t  cledger export [--rev R]                lossless JSONL dump (default: everything)\n36\t  cledger sync [--remote R] [--push|--fetch] [--no-scan] [--paranoid]\n37\t                                           fetch/merge/push of the ledger ref;\n38\t                                           push is gated by a secret scan unless --no-scan\n39\t  cledger transport-push [remote]         pre-push hook entrypoint (installed automatically):\n40\t                                           pushes the ledger ref alongside git push; scan findings\n41\t          