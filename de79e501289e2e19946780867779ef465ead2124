246:   await git([\"config\", \"--add\", \"remote.origin.fetch\", FETCH_REFSPEC], { cwd: repo.root });\n247:   return \"added\";\n248: }\n249: \n250: /**\n251:  * Fold the staged incoming ref (populated by `git fetch` via the refspec)\n252:  * into the local ledger ref — the lazy, read-time half of transport. The\n253:  * merge is the same cat_sort_uniq union sync() uses, so absorbing can only\n254:  * add events. Returns true when new remote state was absorbed. Never\n255:  * throws: a concurrent notes merge just means the next read tries again.\n256:  */\n257: export async function absorbIncoming(repo: RepoInfo): Promise<boolean> {\n258:   const incoming = (await git([\"rev-parse\", \"--verify\", \"--quiet\", INCOMING_REF], {\n259:     cwd: repo.root,\n260:     allowFailure: true,\n261:   })).trim();\n262:   if (!incoming) return false;\n263: \n264:   const local = (await git([\"rev-parse\", \"--verify\", \"--quiet\", NOTES_REF], {\n265:     cwd: repo.root,\n266:     allowFailure: true,\n267:   })).trim();\n268:   if (local === incoming) {\n269:     await git([\"update-ref\", \"-d\", INCOMING_REF], { cwd: repo.root, allowFailure: true });\n270:     return false;\n271:   }\n272: \n273:   try {\n274:     await ensureMergeConfig(repo);\n275:     if (!local) {\n276:       await git([\"update-ref\", NOTES_REF, incoming], { cwd: repo.root });\n277:     } else {\n278:       await git([\"notes\", \"--ref\", NOTES_NAME, \"merge\", \"-s\", \"cat_sort_uniq\", INCOMING_REF], {\n279:         cwd: repo.root,\n280:       });\n281:     }\n282:   } catch {\n283:     return false;\n284:   }\n285:   await git([\"update-ref\", \"-d\", INCOMING_REF], { cwd: repo.root, allowFailure: true });\n286:   return true;\n287: }\n288: \n289: /**\n290:  * True when git can produce an explicit author identity (config or env —\n291:  * never a hostname guess; see gitUserIdentity). Used by `cledger install`\n292:  * to warn that captured human turns would be unattributed.\n293:  */\n294: export asy