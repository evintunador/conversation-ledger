cwd: repo.root,\n666:       allowFailure: true,\n667:     })).trim();\n668:     if (!tmpExists) return; // nothing in scope and the remote had nothing\n669:     await git([\"push\", remote, `${tmpRef}:${NOTES_REF}`], { cwd: repo.root });\n670:   } finally {\n671:     await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n672:   }\n673: }\n674: \n675: /**\n676:  * Event ids the remote's notes ref already has, fetched into a throwaway\n677:  * temp ref that is deleted before returning. Null means the remote has no\n678:  * ledger ref at all (e.g. first push), in which case the caller should\n679:  * treat everything local as unshared.\n680:  */\n681: async function remoteNoteIds(repo: RepoInfo, remote: string): Promise<Set<string> | null> {\n682:   const remoteHasRef = (await git([\"ls-remote\", remote, NOTES_REF], {\n683:     cwd: repo.root,\n684:     allowFailure: true,\n685:   })).trim();\n686:   if (!remoteHasRef) return null;\n687: \n688:   const tmpName = \"conversation-ledger-scan-tmp\";\n689:   const tmpRef = `refs/notes/${tmpName}`;\n690:   await git([\"fetch\", remote, `+${NOTES_REF}:${tmpRef}`], { cwd: repo.root, allowFailure: true });\n691:   try {\n692:     const ids = new Set<string>();\n693:     for (const anchor of await listAnchors(repo, tmpName)) {\n694:       for (const event of await readNoteEvents(repo, anchor, tmpName)) ids.add(event.id);\n695:     }\n696:     return ids;\n697:   } finally {\n698:     await git([\"update-ref\", \"-d\", tmpRef], { cwd: repo.root, allowFailure: true });\n699:   }\n700: }\n701: \n702: /** Thrown when the layer-E scan gate blocks a push; carries no secrets. */\n703: export class ScanBlockedError extends Error {\n704:   constructor(public readonly findings: number) {\n705:     super(`cledger sync: push blocked — ${findings} potential secret(s) found (see report above)`);\n706:   }\n707: }\n708: \n709: /**\n710:  * Layer E: before push, scan only the events the remote does not yet have\n711:  * (already-pushed events are not rescanned every time). On any surviving\n712:  * finding, print a report and throw so sync() does not proceed to push —\n713:  * the fetch/merge phase, if it already ran, is left in place.\n714:  */\n715: async function runScanGate(\n716:   repo: RepoInfo,\n717:   remote: string,\n718:   tier: \"standard\" | \"paranoid\",\n719:   anchors: string[] | null,\n720: ): Promise<void> {\n721:   const remoteIds = await remoteNoteIds(repo, remote);\n722: \n723:   const localEvents: EvidenceEvent[] = [];\n724:   // Scan exactly what the push will carry. Before scoping this swept every\n725:   // anchor, so a finding on a branch that was never going to be pushed still\n726:   // blocked the push — which, given how often the flagged text is a\n727:   // conversation *about* credential-shaped code, was a routine false block.\n728:   for (const anchor of anchors ?? (await listAnchors(repo))) {\n729:     localEvents.push(...(await readNoteEvents(repo, anchor)));\n730:   }\n731:   // Pending events are unanchored, so they are not in this push at all; they\n732:   // are still scanned because they exist only before the first commit, when\n733:   // there is nothing else to push anyway, and gating them early is the\n734:   // conservative side to err on.\n735:   localEvents.push(...(await readPending(repo)));\n736: \n737:   const candidates = remoteIds ? localEvents.filter((e) => !remoteIds.has(e.id)) : localEvents;\n738:   if (candidates.length === 0) return;\n739: \n740:   const findings = filterFindings(scanEvents(candidates, tier), await loadAllowlist(repo));\n741:   if (findings.length === 0) return;\n742: \n743:   const eventIds = [...new Set(findings.map((f) => f.eventId))];\n744:   process.stderr.write(\n745:     `cledger sync: blocked — ${findings.length} potential secret(s) across ` +\n746:       `${eventIds.length} event(s) not yet on ${remote}\\n\\n`,\n747:   );\n748:   for (const f of findings) process.stderr.write(`  ${formatFinding