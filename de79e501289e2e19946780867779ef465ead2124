e Flags {\n104:   [key: string]: string | boolean;\n105: }\n106: \n107: function parseArgs(argv: string[]): { positional: string[]; flags: Flags } {\n108:   const positional: string[] = [];\n109:   const flags: Flags = {};\n110:   for (let i = 0; i < argv.length; i++) {\n111:     const arg = argv[i]!;\n112:     if (arg.startsWith(\"--\")) {\n113:       const name = arg.slice(2);\n114:       const next = argv[i + 1];\n115:       if (next !== undefined && !next.startsWith(\"--\")) {\n116:         flags[name] = next;\n117:         i++;\n118:       } else {\n119:         flags[name] = true;\n120:       }\n121:     } else {\n122:       positional.push(arg);\n123:     }\n124:   }\n125:   return { positional, flags };\n126: }\n127: \n128: async function requireRepo(): Promise<RepoInfo> {\n129:   const repo = await findRepo(process.cwd());\n130:   if (!repo) {\n131:     process.stderr.write(\"cledger: not inside a git repository\\n\");\n132:     process.exit(2);\n133:   }\n134:   return repo;\n135: }\n136: \n137: async function readStdin(): Promise<string> {\n138:   const chunks: Buffer[] = [];\n139:   for await (const chunk of input) chunks.push(chunk as Buffer);\n140:   return Buffer.concat(chunks).toString(\"utf8\");\n141: }\n142: \n143: function readOptionsFrom(flags: Flags): ReadOptions {\n144:   const opts: ReadOptions = {};\n145:   if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n146:   if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n147:   if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n148:   if (typeof flags[\"model\"] === \"string\") opts.model = flags[\"model\"];\n149:   if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n150:   return opts;\n151: }\n152: \n153: function snippet(event: EvidenceEvent): string {\n154:   const c = event.content as Record<string, unknown> | string | null;\n155:   let text = \"\";\n156:   if (typeof c === \"string\") text = c;\n157:   else if (c && typeof c === \"object\") {\n158:     text = String(c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"] ?? JSON.stringify(c));\n159:   }\n160:   text = text.replace(/\\s+/g, \" \").trim();\n161:   return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n162: }\n163: \n164: function printHuman(events: EvidenceEvent[]): void {\n165:   for (const e of events) {\n166:     const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n167:     const role =\n168:       (e.content as Record<string, unknown> | null | undefined) &&\n169:       typeof e.content === \"object\"\n170:         ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n171:         : e.actor.type;\n172:     process.stdout.write(\n173:       `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n174:     );\n175:   }\n176: }\n177: \n178: /**\n179:  * `reasoning` events are opaque ciphertext, never meant for a human-facing\n180:  * transcript — `log`/`show` hide them by default. `--with-reasoning` opts\n181:  * in, as does asking for the kind explicitly via `--kind reasoning` (hiding\n182:  * them there would just return nothing). `export`'s job is a lossless dump,\n183:  * so it never filters by kind and needs no equivalent flag.\n184:  */\n185: function includeReasoning(flags: Flags, opts: ReadOptions): boolean {\n186:   return flags[\"with-reasoning\"] === true || opts.kind === \"reasoning\";\n187: }\n188: \n189: function hideOpaqueReasoning(events: EvidenceEvent[]): EvidenceEvent[] {\n190:   return events.filter((e) => e.kind !== \"reasoning\");\n191: }\n192: \n193: function printJsonl(events: EvidenceEvent[], includeRaw: boolean): void {\n194:   for (const e of events) {\n195:     const out = includeRaw ? e : { ...e, raw: undefined };\n196:     process.stdout.write(JSON.stringify(out) + \"\\n\");\n197:   }\n198: }\n199: \n200: async function cmdAppend(flags: Flags): Promise<void> {\n201:   const repo = await requireRepo();\n202:   const body = await readStdin();\n203:   const drafts: EventDraft[] = body\n204:     .split(\"\\n\")\n205:     .filter((l) => l.trim())\n206:     .map((l) => JSON.parse(l) as EventDraft);\n207:   if (drafts.length === 0) return;\n208:   const result = await appendEvents(repo, drafts);\n209:   if (!flags[\"quiet\"]) {\n210:     for (const e of result.appended) process.stdout.write(e.id + \"\\n\");\n211:     process.stderr.write(\n212:       `appended ${result.appended.length}, deduped ${result.deduped}` +\n213:         (result.anchor ? ` (anchor ${result.anchor.slice(0, 12)})` : \" (pending: no commits yet)\") +\n214:         \"\\n\",\n215:     );\n216:   }\n217: }\n218: \n219: async function cmdLog(flags: Flags): Promise<void> {\n220:   const repo = await requireRepo();\n221:   const opts = readOptionsFrom(flags);\n222:   let events = await readEvents(repo, opts);\n223:   if (!includeReasoning(flags, opts)) events = hideOpaqueReasoning(events);\n224:   if (flags[\"json\"]) printJsonl(events, false);\n225:   else printHuman(events);\n226: }\n227: \n228: async function cmdShow(positional: string[], flags: Flags): Promise<void> {\n229:   const prefix = positional[0];\n230:   if (!prefix) {\n231:     process.stderr.write(\"usage: cledger show <conversation-id-prefix>\\n\");\n232:     process.exit(2);\n233:   }\n234:   const repo = await requireRepo();\n235:   let events = await readEvents(repo, { conversation: prefix });\n236:   if (!includeReasoning(flags, {})) events = hideOpaqueReasoning(events);\n237:   if (events.length === 0) {\n238:     process.stderr.write(`no events for conversation ${prefix}\\n`);\n239:     process.exit(1);\n240:   }\n241:   if (flags[\"json\"]) {\n242:     printJsonl(events, true);\n243:     return;\n244:   }\n245:   for (const e of sortEvents(events)) {\n246:     const c = e.content as Record<string, unknown>;\n247:     const role = typeof c === \"object\" &