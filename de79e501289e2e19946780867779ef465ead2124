ss.exit(2);\n477:   }\n478:   const repo = await requireRepo();\n479:   const redactOpts: { pattern?: string; all?: boolean; reason?: string } = {};\n480:   if (typeof flags[\"pattern\"] === \"string\") redactOpts.pattern = flags[\"pattern\"];\n481:   if (flags[\"all\"] === true) redactOpts.all = true;\n482:   if (typeof flags[\"reason\"] === \"string\") redactOpts.reason = flags[\"reason\"];\n483:   const result = await redactEvent(repo, idPrefix, redactOpts);\n484:   const fingerprints = result.event.redactions?.map((r) => r.fingerprint).join(\", \") || \"(none)\";\n485:   process.stderr.write(\n486:     `cledger redact: rewrote ${result.event.id.slice(0, 16)} — fingerprints: ${fingerprints}\\n` +\n487:       `companion event: ${result.redactionEvent.id.slice(0, 16)}\\n` +\n488:       `history squashed: ${result.squashed ? \"yes\" : \"no\"}\\n`,\n489:   );\n490:   if (result.knownSecretsRemembered > 0) {\n491:     process.stderr.write(\n492:       `remembered ${result.knownSecretsRemembered} secret value(s) for capture-time redaction ` +\n493:         `(redact.knownSecrets is on)\\n`,\n494:     );\n495:   }\n496: }\n497: \n498: async function cmdReAnchor(positional: string[], flags: Flags): Promise<void> {\n499:   const repo = await requireRepo();\n500: \n501:   if (positional.length > 0) {\n502:     if (typeof flags[\"onto\"] !== \"string\") {\n503:       process.stderr.write(\"usage: cledger re-anchor <old-rev...> --onto REV\\n\");\n504:       process.exit(2);\n505:     }\n506:     const { event, superseded, successor } = await manualReAnchor(repo, positional, flags[\"onto\"]);\n507:     process.stderr.write(\n508:       event\n509:         ? `cledger re-anchor: mapped ${superseded.length} commit(s) onto ${successor.slice(0, 12)} ` +\n510:             `(event ${event.id.slice(0, 16)})\\n`\n511:         : `cledger re-anchor: an identical mapping already exists — nothing appended\\n`,\n512:     );\n513:     return;\n514:   }\n515: \n516:   const apply = flags[\"ap