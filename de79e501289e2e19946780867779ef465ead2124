n37: }\n38: \n39: /**\n40:  * The command hook scripts should run. Prefers this exact installation\n41:  * (absolute node + cli.js — immune to PATH differences and to an older\n42:  * global `cledger` that predates a subcommand), with a PATH fallback baked\n43:  * into the script itself for when this installation moves.\n44:  */\n45: function cledgerInvocation(): { node: string; cli: string } {\n46:   return {\n47:     node: process.execPath,\n48:     cli: fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n49:   };\n50: }\n51: \n52: /**\n53:  * The block cledger owns inside `pre-push`, delimited by HOOK_MARKER so it can\n54:  * be recognized, upgraded, and removed without touching the rest of the file.\n55:  *\n56:  * The hook is fed git's pre-push stdin — one `<local ref> <local sha> <remote\n57:  * ref> <remote sha>` line per ref being pushed — so the ledger push can be\n58:  * scoped to the refs actually being pushed rather than to whatever happens to\n59:  * be checked out. Before 0.15.0 this was `</dev/null` and the scope fell back\n60:  * to `HEAD`, which meant `git push origin some-other-branch` shared nothing of\n61:  * that branch.\n62:  *\n63:  * Consuming that stdin has a cost worth being explicit about: a `pre-push`\n64:  * script's stdin can only be read once, so anything chained *after* this\n65:  * block finds it exhausted. In practice that is nearly always fine, because\n66:  * `installHook` appends this block to the end of an existing hook — an\n67:  * existing script runs, and reads stdin, before this block does. When it\n68:  * does read stdin first, this block's `$(cat)` comes back empty and the\n69:  * scope falls back to `HEAD`, which is the pre-0.15.0 behavior rather than a\n70:  * failure. Only hand-editing content in after this block loses the ref list,\n71:  * and restoring it would mean spilling stdin to a temp file and `exec`-ing it\n72:  * back onto fd 0 — more machinery in every user's hook than that case earns.\n73:  */\n74: function hookBlock(): string {\n75:   const { node, cli } = cledgerInvocation();\n76:   return [\n77:     `# >>> ${HOOK_MARKER} (added by cledger) >>>`,\n78:     `# Shares this repo's conversation records (${NOTES_REF}) when you push.`,\n79:     `# Scoped to the refs being pushed, read from git's pre-push stdin.`,\n80:     `# Delete this block to disable, or set {\"transport\": {\"hook\": false}} in`,\n81:     `# .cledger.json / ~/.config/cledger/config.json.`,\n82:     `if [ -z \"$CLEDGER_INTERNAL\" ]; then`,\n83:     `  _cledger_refs=$(cat)`,\n84:     `  if [ -x \"${node}\" ] && [ -e \"${cli}\" ]; then`,\n85:     `    printf '%s\\\\n' \"$_cledger_refs\" | \"${node}\" \"${cli}\" transport-push \"$1\" || exit $?`,\n86:     `  elif command -v cledger >/dev/null 2>&1; then`,\n87:     `    printf '%s\\\\n' \"$_cledger_refs\" | cledger transport-push \"$1\" || exit $?`,\n88:     `  fi`,\n89:     `  # Note: a pre-push script's stdin can only be read once, so anything`,\n90:     `  # chained after this block will not see the ref list.`,\n91:     `fi`,\n92:     `# <<< ${HOOK_MARKER} <<<`,\n93:   ].join(\"\\n\");\n94: }\n95: \n96: /**\n97:  * Replace an already-installed cledger block with the current one.\n98:  *\n99:  * Without this an existing install keeps whatever block it was created with\n100:  * forever — `installHook` used to return \"present\" on any file containing the\n101:  * marker — so a behavior change in the hook itself (the stdin plumbing above)\n102:  * would only ever reach fresh repos. Only the marked region is touched;\n103:  * anything the user wrote around it is preserved byte for byte.\n104:  */\n105: function replaceHookBlock(existing: string, block: string): string | null {\n106:   const start = existing.indexOf(`# >>> ${HOOK_MARKER}`);\n107:   const endMarker = `# <<< ${HOOK_MARKER} <<<`;\n108:   const endIdx = existing.indexOf(endMarker, start);\n109:   if (start === -1 || endIdx === -1) return null;\n110:   const end = endIdx + endMarker.length;\n111:   const current = existing.slice(start, end);\n112:   if (current === block) return null; // already current\n113:   return existing.slice(0, start) + block + existing.slice(end);\n114: }\n115: \n116: /** Warnings that should print once per repo, not on every capture. */\n117: async function warnOnce(repo: RepoInfo, key: string, message: string): Promise<void> {\n118:   const stateDir = join(repo.commonDir, \"conversation-ledger\");\n119:   const path = join(stateDir, \"transport-warnings.json\");\n120:   let warned: string[] = [];\n121:   try {\n122:     warned = JSON.parse(await readFile(path, \"utf8\")) as string[];\n123:   } catch {\n124:     // first warning, or unreadable state — state is rebuildable\n125:   }\n126:   if (warned.includes(key)) return;\n127:   process.stderr.write(message);\n128:   await mkdir(stateDir, { recursive: true });\n129:   await writeFile(path, JSON.stringify([...warned, key]) + \"\\n\");\n130: }\n131: \n132: export interface TransportSetup {\n133:   hook:\n134:     | \"installed\"\n135:     | \"present\"\n136:     | \"upgraded\"\n137:     | \"appended\"\n138:     | \"skipped-config\"\n139:     | \"skipped-hookspath\"\n140:     | \"skipped-foreign\";\n141:   refspec: \"added\" | \"present\" | \"skipped-config\" | \"no-remote\";\n142: }\n143: \n144: /**\n145:  * Transport is default-on but must cost the user nothing to get: the first\n146:  * capture in a repo wires it up. Installs the pre-push hook (chain-safe:\n147:  * appends to an existing shell hook, backs off with a one-time warning when\n148:  * core.hooksPath or a non-shell hook owns the file) and adds the fetch\n149:  * refspec that stages the remote's ledger ref on normal `git fetch`.\n150:  * Runs on every append — each check is a cheap stat/config read — so a\n151:  * remote added later still gets wired. Never throws: this runs inside\n152:  * capture, which must never fail a user's session.\n153:  */\n154: export async function ensureTransport(\n155:   repo: RepoInfo,\n156:   config: CledgerConfig,\n157: ): Promise<TransportSetup | null> {\n158:   try {\n159:     return {\n160:       hook: await ensurePrePushHook(repo, config),\n161:       refspec: await ensureFetchRefspec(repo, config),\n162:     };\n163:   } catch {\n164:     return null;\n165:   }\n166: }\n167: \n168: async function ensurePrePushHook(\n169:   repo: RepoInfo,\n170:   config: CledgerConfig,\n171: ): Promise<TransportSetup[\"hook\"]> {\n172:   if (config.transport?.hook === false) return \"skipped-config\";\n173: \n174:   const hooksPath = (await git([\"config\", \"--get\", \"core.hooksPath\"], {\n175:     cwd: repo.root,\n176:     allowFailure: true,\n177:   })).trim();\n178:   if (hooksPath) {\n179:     await warnOnce(\n180:       repo,\n181:       \"hookspath\",\n182:       `cledger: core.hooksPath is set (${hooksPath}), so the ledger pre-push hook was not ` +\n183:         `installed. To share conversation records on push, add\\n` +\n184:         `  cledger transport-push \"$1\"\\n` +\n185:         `to that pre-push hook, or run \\`cledger sync\\` manually.\\n`,\n186:     );\n187:     return \"skipped-hookspath\";\n188:   }\n189: \n190:   // The common dir, never this worktree's own git dir: git resolves hooks\n191:   // relative to `$GIT_COMMON_DIR`, so a pre-push script written under\n192:   // `.git/worktrees/<name>/hooks/` is simply never executed. Installing it\n193:   // there would leave a repo whose first capture happened inside a worktree\n194:   // with a hook that looks installed and silently never runs.\n195:   const hookPath = join(repo.commonDir, \"hooks\", \"pre-push\");\n196:   if (!existsSync(hookPath)) {\n197:     await mkdir(join(repo.commonDir, \"hooks\"), { recursive: true });\n198:     await writeFile(hookPath, `#!/bin/sh\\n${hookBlock()}\\n`);\n199:     await chmod(hookPath, 0o755);\n200:     return \"installed\";\n201:   }\n202: \n203:   const existing = await readFile(hookPath, \"utf8\");\n204:   if (existing.includes(HOOK_MARKER)) {\n205:     const upgraded = replaceHookBlock(existing, hookBlock());\n206:     if (upgraded === null) return \"present\";\n207:     await writeFile(hookPath, upgraded);\n208:     await chmod(hookPath, 0o755);\n209:     return \"upgraded\";\n210:   }\n211: \n212:   const shebang = existing.split(\"\\n\", 1)[0] ?? \"\";\n213:   if (!/^#!.*\\b(sh|bash|zsh|dash|ksh)\\b/.test(shebang)) {\n214:     await warnOnce(\n215:       repo,\n216:       \"foreign-hook\",\n217:       `cledger: this repo's pre-push hook is not a shell script, so the ledger hook was not ` +\n218:         `chained onto it. Run \\`cledger sync\\` to share conversation records manually.\\n`,\n219:     );\n220:     return \"skipped-foreign\";\n221:   }\n222: \n223:   await writeFile(hookPath, existing.replace(/\\n?$/, \"\\n\") + \"\\n\" + hookBlock() + \"\\n\");\n224:   await chmod(hookPath, 0o755);\n225:   return \"appended\";\n226: }\n227: \n228: async function ensureFetchRefspec(\n229:   repo: RepoInfo,\n230:   config: CledgerConfig,\n231: ): Promise<TransportSetup[\"refspec\"]> {\n232:   if (config.transport?.fetchRefspec === false) return \"skipped-config\";\n233: \n234:   const originUrl = (await git([\"remote\", \"get-url\", \"origin\"], {\n235:     cwd: repo.root,\n236:     allowFailure: true,\n237:   })).trim();\n238:   if (!originUrl) return \"no-remote\";\n239: \n240:   const fetchSpecs = await git([\"config\", \"--get-all\", \"remote.origin.fetch\"], {\n241:     cwd: repo.root,\n242:     allowFailure: true,\n243:   });\n244:   if (fetchSpecs.includes(INCOMING_REF)) return \"present\";\n245: \n246:   await git([\"config\", \"--add\", \"remote.origin.fetch\", FETCH_REFSPEC], { cwd: repo.root });\n247:   return \"added\";\n248: }\n249: \n250: /**\n251:  * Fold the staged incoming ref (populated by `git fetch` via the refspec)\n252:  * into the local ledger ref — the lazy, read-time half of transport. The\n253:  * merge is the same cat_sort_uniq union sync() uses, so absorbing can only\n254:  * add 