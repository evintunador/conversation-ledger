:   warnUnrecognized,\n12:   type CaptureResult,\n13: } from \"./drift.js\";\n14: \n15: const RAW_FORMAT = \"codex-rollout-jsonl/2\";\n16: \n17: /** Codex CLI hooks-engine payload (subset we read). */\n18: interface CodexHookPayload {\n19:   session_id?: string;\n20:   transcript_path?: string;\n21:   cwd?: string;\n22:   hook_event_name?: string;\n23:   turn_id?: string;\n24: }\n25: \n26: /** One line of a `~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl` file. */\n27: interface CodexRolloutLine {\n28:   type?: string;\n29:   timestamp?: string;\n30:   payload?: Record<string, unknown>;\n31: }\n32: \n33: const CONVERTIBLE_RESPONSE_TYPES = new Set([\n34:   \"message\",\n35:   \"function_call\",\n36:   \"function_call_output\",\n37:   \"custom_tool_call\",\n38:   \"custom_tool_call_output\",\n39:   \"agent_message\",\n40: ]);\n41: \n42: /**\n43:  * Line types we deliberately do not capture: session/turn bookkeeping and\n44:  * the event_msg UI stream (whose conversation content duplicates\n45:  * response_item lines). Anything else is unrecognized — likely new upstream\n46:  * content — and counted for the drift warning; same for response_item\n47:  * payload types outside CONVERTIBLE_RESPONSE_TYPES. `reasoning` payloads are\n48:  * a third case: recognized, but their `encrypted_content` is opaque to us\n49:  * by design (only the provider can decrypt it), so they're captured as a\n50:  * `reasoning`-kind event instead of a `conversation_turn` or `unrecognized`\n51:  * one — see `reasoningDraft` and the capture loop below.\n52:  */\n53: const KNOWN_SKIPPED_LINE_TYPES = new Set([\n54:   \"session_meta\",\n55:   \"turn_context\",\n56:   \"compacted\",\n57:   \"event_msg\",\n58:   \"world_state\",\n59:   \"inter_agent_communication_metadata\",\n60: ]);\n61: \n62: /**\n63:  * Line types that state agent facts (model, provider, CLI version) about the\n64:  * response_items that follow them. They stay in KNOWN_SKIPPED_LINE_TYPES —\n65:  * they are still not captured as events