to\n322:   // reasoningDraft before calling convertLine.\n323:   if (typeof payloadType !== \"string\" || !CONVERTIBLE_RESPONSE_TYPES.has(payloadType)) return null;\n324: \n325:   const occurredAt = typeof line.timestamp === \"string\" ? line.timestamp : baseTime;\n326: \n327:   let actor: Actor;\n328:   let content: { role: string; blocks: unknown[] };\n329: \n330:   if (payloadType === \"message\") {\n331:     const role = payload[\"role\"];\n332:     const roleStr = typeof role === \"string\" ? role : \"user\";\n333:     actor = roleStr === \"assistant\" ? { type: \"agent\" } : { type: \"human\" };\n334:     if (actor.type === \"human\") {\n335:       if (identity.email) actor.id = identity.email;\n336:       if (identity.name) actor.display = identity.name;\n337:     }\n338:     content = { role: roleStr, blocks: convertMessageBlocks(payload[\"content\"]) };\n339:   } else if (payloadType === \"agent_message\") {\n340:     actor = { type: \"agent\" };\n341:     if (typeof payload[\"author\"] === \"string\") actor.id = payload[\"author\"];\n342:     const rawBlocks = payload[\"content\"];\n343:     const visible = Array.isArray(rawBlocks) ? rawBlocks.filter((b) => !isEncryptedBlock(b)) : [];\n344:     content = {\n345:       role: \"agent_message\",\n346:       ...(typeof payload[\"author\"] === \"string\" ? { author: payload[\"author\"] } : {}),\n347:       ...(typeof payload[\"recipient\"] === \"string\" ? { recipient: payload[\"recipient\"] } : {}),\n348:       blocks: convertMessageBlocks(visible),\n349:     } as { role: string; blocks: unknown[] };\n350:   } else if (payloadType === \"function_call\" || payloadType === \"custom_tool_call\") {\n351:     actor = { type: \"agent\" };\n352:     const block: Record<string, unknown> = { type: \"tool_use\" };\n353:     if (typeof payload[\"name\"] === \"string\") block[\"name\"] = payload[\"name\"];\n354:     const input = payload[\"arguments\"] ?? payload[\"input\"];\n355:     if (input !== undefined) block[\"inpu