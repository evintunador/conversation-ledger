{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t/**\n2\t * Sync-time secret scan (layer E, see docs/WIP_TECHNICAL_DESIGN.md \"Privacy\n3\t * and integrity\"). Unlike capture-tier redaction (apply.ts), this scanner\n4\t * never rewrites anything — it only reports findings so a human can decide\n5\t * whether to `cledger redact` the event, `cledger allow` the fingerprint as\n6\t * a known false positive, or push anyway with `--no-scan`. Rules may\n7\t * therefore be noisier than the capture tier.\n8\t */\n9\timport { mkdir, readFile, writeFile } from \"node:fs/promises\";\n10\timport { join } from \"node:path\";\n11\timport { sha256Hex } from \"../canonical.js\";\n12\timport type { RepoInfo } from \"../git.js\";\n13\timport type { EvidenceEvent } from \"../schema.js\";\n14\timport { walkStrings } from \"./apply.js\";\n15\timport { rulesForTier, shannonEntropy } from \"./rules.js\";\n16\t\n17\texport interface Finding {\n18\t  eventId: string;\n19\t  conversation?: string;\n20\t  occurred_at: string;\n21\t  rule: string;\n22\t  fingerprint: string;\n23\t  excerpt: string;\n24\t}\n25\t\n26\tconst PLACEHOLDER_RE = /\\[REDACTED:[^\\]]+\\]/g;\n27\t\n28\t/** True if [start, end) overlaps an existing `[REDACTED:...]` placeholder span in `text`. */\n29\tfunction overlapsPlaceholder(text: string, start: number, end: number): boolean {\n30\t  for (const m of text.matchAll(PLACEHOLDER_RE)) {\n31\t    const pStart = m.index ?? 0;\n32\t    const pEnd = pStart + m[0].length;\n33\t    if (start < pEnd && end > pStart) return true;\n34\t  }\n35\t  return false;\n36\t}\n37\t\n38\t/**\n39\t * Marker that stands in for the matched secret in a finding excerpt. Prints\n40\t * zero characters of the secret itself — not even leading/trailing ones —\n41\t * so the excerpt can be safely re-captured (e.g. when the scan report itself\n42\t * lands in a later conversation) without re-seeding the very finding it\n43\t * describes. See the redaction-feedback-loop discussion in the README roadmap.\n44\t */\n45\tconst MATCH_MARKER = \"<redacted>\";\n46\t\n47\t/**\n48\t * ~20 chars of surrounding context on each side, with the matched span\n49\t * replaced by MATCH_MARKER. The context gives a human enough of a \"what was\n50\t * this\" cue to act; the secret's own characters are never printed.\n51\t */\n52\tfunction buildExcerpt(text: string, start: number, end: number): string {\n53\t  const pre = text.slice(Math.max(0, start - 20), start);\n54\t  const post = text.slice(end, end + 20);\n55\t  return `${pre}${MATCH_MARKER}${post}`.replace(/\\s+/g, \" \").trim();\n56\t}\n57\t\n58\tconst PURE_HEX_RE = /^[0-9a-fA-F]+$/;\n59\t\n60\t/**\n61\t * Scan already-finalized events for potential secrets. Read-only: never\n62\t * mutates content, only reports. `tier` selects the ruleset — \"standard\"\n63\t * re-runs the full capture ruleset plus scan-only keyword/URL/bearer rules\n64\t * (catching events captured under an older capture ruleset); \"paranoid\"\n65\t * additionally enables the entropy-gated high-entropy-token rule.\n66\t */\n67\texport function scanEvents(events: EvidenceEvent[], tier: \"standard\" | \"paranoid\"): Finding[] {\n68\t  const rules = rulesForTier(tier);\n69\t  const findings: Finding[] = [];\n70\t\n71\t  for (const event of events) {\n72\t    const visit = (value: string, _path: string): string => {\n73\t      for (const rule of rules) {\n74\t        for (const m of value.matchAll(rule.pattern)) {\n75\t          const matchText = m[0];\n76\t          const start = m.index ?? 0;\n77\t          const end = start + matchText.length;\n78\t          if (overlapsPlaceholder(value, start, end)) continue;\n79\t          if (rule.entropyGated) {\n80\t            // Belt-and-suspenders: rulesForTier already excludes this rule\n81\t            // below \"paranoid\", but the gate is cheap to state explicitly.\n82\t            if (tier !== \"paranoid\") continue;\n83\t            if (PURE_HEX_RE.test(matchText)) continue; // git SHAs, content 