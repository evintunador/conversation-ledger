{"actor":{"id":"deepseek-v4-flash","type":"agent"},"content":{"agent":"explore","blocks":[{"id":"call_44fb65f7dc151c0fab4fde6eff3f13bf","input":{"filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/src/adapters/claude-code.ts"},"name":"read","type":"tool_use"},{"content":"<path>/Users/evintunador/repos/evintunador/conversation-ledger/src/adapters/claude-code.ts</path>\n<type>file</type>\n<content>\n1: import { readFileSync } from \"node:fs\";\n2: import { mkdir, readFile, stat, writeFile } from \"node:fs/promises\";\n3: import { basename, join } from \"node:path\";\n4: import { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n5: import { appendEvents } from \"../store.js\";\n6: import type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n7: import {\n8:   countUnrecognized,\n9:   unrecognizedDraft,\n10:   warnUnrecognized,\n11:   type CaptureResult,\n12: } from \"./drift.js\";\n13: \n14: const CONVERTIBLE_LINE_TYPES = new Set([\"user\", \"assistant\"]);\n15: \n16: const RAW_FORMAT = \"claude-code-jsonl/1\";\n17: \n18: /**\n19:  * Line types we deliberately do not capture: session bookkeeping, UI state,\n20:  * and file-history machinery, not visible conversation content. A parsed\n21:  * line whose type is in neither set is *unrecognized* — likely new upstream\n22:  * content — and gets counted for the drift warning.\n23:  */\n24: const KNOWN_SKIPPED_LINE_TYPES = new Set([\n25:   \"system\",\n26:   \"summary\",\n27:   \"progress\",\n28:   \"attachment\",\n29:   \"mode\",\n30:   \"permission-mode\",\n31:   \"ai-title\",\n32:   \"last-prompt\",\n33:   \"queue-operation\",\n34:   \"file-history-snapshot\",\n35:   \"file-history-delta\",\n36: ]);\n37: \n38: /** Claude Code hooks-engine payload (subset we read). */\n39: interface ClaudeCodeHookPayload {\n40:   session_id?: string;\n41:   transcript_path?: string;\n42:   cwd?: string;\n43:   hook_event_name?: string;\n44: }\n45: \n46: /** One line of a `~/.claude/projects/<escaped-cwd>/<session-id>.jsonl` transcript. */\n47: interface ClaudeTranscriptLine {\n48:   type?: string;\n49:   isSidechain?: boolean;\n50:   message?: {\n51:     role?: string;\n52:     model?: string;\n53:     content?: unknown;\n54:   };\n55:   uuid?: string;\n56:   parentUuid?: string;\n57:   sessionId?: string;\n58:   timestamp?: string;\n59:   cwd?: string;\n60:   gitBranch?: string;\n61:   version?: string;\n62: }\n63: \n64: function packageVersion(): string {\n65:   try {\n66:     const pkg = JSON.parse(\n67:       readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n68:     ) as { version?: string };\n69:     return pkg.version ?? \"0.1.0\";\n70:   } catch {\n71:     return \"0.1.0\";\n72:   }\n73: }\n74: \n75: function sanitizeId(id: string): string {\n76:   return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n77: }\n78: \n79: function cursorPath(repo: RepoInfo, sessionId: string): string {\n80:   return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n81: }\n82: \n83: async function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n84:   try {\n85:     const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n86:     const data = JSON.parse(raw) as { lines?: number };\n87:     return typeof data.lines === \"number\" ? data.lines : 0;\n88:   } catch {\n89:     return 0;\n90:   }\n91: }\n92: \n93: async function writeCursor(repo: RepoInfo, sessionId: string, lines: number): Promise<void> {\n94:   const path = cursorPath(repo, sessionId);\n95:   await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n96:   await writeFile(path, JSON.stringify({ lines }) + \"\\n\");\n97: }\n98: \n99: function convertContentBlocks(content: unknown): unknown[] {\n100:   if (typeof content === \"string\") return [{ type: \"text\", text: content }];\n101:   if (!Array.isArray(content)) return [];\n102:   return content.map(convertBlock);\n103: }\n104: \n105: function convertBlock(block: unknown): unknown {\n106:   if (!block || typeof block !== \"object\") return block;\n107:   const b = block as Record<string, unknown>;\n108:   if (b[\"type\"] === \"thinking\") {\n109:     // signature is a provider-internal verification token, not visible content\n110:     return { type: \"thinking\", text: b[\"thinking\"] };\n111:   }\n112:   // text / tool_use / tool_result / unknown block shapes pass through verbatim\n113:   return b;\n114: }\n115: \n116: /**\n117:  * A deterministic session time for preserving unrecognized lines that carry\n118:  * no timestamp of their own: the first timestamp anywhere in the transcript\n119:  * (stable across rescans), falling back to the file mtime. Claude lines\n120:  * almost always carry a timestamp, so this is a rarely-hit safety net.\n121:  */\n122: function firstTimestamp(lines: string[]): string | null {\n123:   for (const text of lines) {\n124:     if (!text.trim()) continue;\n125:     try {\n126:       const parsed = JSON.parse(text) as ClaudeTranscriptLine;\n127:       if (typeof parsed.timestamp === \"string\" && !Number.isNaN(Date.parse(parsed.timestamp))) {\n128:         return parsed.timestamp;\n129:       }\n130:     } catch {\n131:       continue;\n132:     }\n133:   }\n134:   return null;\n135: }\n136: \n137: /** File mtime as ISO, else now — last-resort deterministic-ish base time. */\n138: async function sessionMtime(transcriptPath: string): Promise<string> {\n139:   try {\n140:     return (await stat(transcriptPath)).mtime.toISOString();\n141:   } catch {\n142:     return new Date().toISOString();\n143:   }\n144: }\n145: \n146: /**\n147:  * The agent facts this line states about itself. Claude Code stamps every\n148:  * transcript line with the CLI `version`, and labels assistant lines with the\n149:  * model that produced them; user lines carry no model, and none is invented\n150:  * for them — the model that will answer a prompt is not knowable from the\n151:  * prompt's own line, and the session's model can change mid-conversation.\n152:  * The provider is never stated (the same CLI can talk to the first-party API,\n153:  * Bedrock, or Vertex), so `provider` is left unset rather than assumed.\n154:  *\n155:  * Values pass through verbatim, including Claude Code's `\"<synthetic>\"`\n156:  * placeholder for harness-generated assistant messages: that is a true and\n157:  * useful statement about the turn (\"no model produced this\"), and rewriting\n158:  * it would be interpretation.\n159:  */\n160: function agentContext(line: ClaudeTranscriptLine): ProducerAgentContext {\n161:   const agent: ProducerAgentContext = {};\n162:   if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n163:   const model = line.message?.model;\n164:   if (typeof model === \"string\" && model) agent.model = model;\n165:   return agent;\n166: }\n167: \n168: /** Raw-only preservation event for an unrecognized claude-code line (see drift.ts). */\n169: function preserve(\n170:   type: string,\n171:   line: ClaudeTranscriptLine,\n172:   occurredAt: string,\n173:   seq: number,\n174:   fileSessionId: string,\n175:   version: string,\n176: ): EventDraft {\n177:   const sessionId = line.sessionId ?? fileSessionId;\n178:   return unrecognizedDraft({\n179:     typeKey: type,\n180:     line,\n181:     occurredAt,\n182:     source: \"claude-code\",\n183:     sessionId,\n184:     seq,\n185:     version,\n186:     rawFormat: RAW_FORMAT,\n187:     conversationId: `claude-code:${sessionId}`,\n188:     agent: agentContext(line),\n189:   });\n190: }\n191: \n192: function convertLine(\n193:   line: ClaudeTranscriptLine,\n194:   seq: number,\n195:   version: string,\n196:   identity: GitUserIdentity,\n197: ): EventDraft | null {\n198:   if (line.type !== \"user\" && line.type !== \"assistant\") return null;\n199:   if (line.isSidechain === true) return null;\n200:   if (!line.message) return null;\n201:   if (typeof line.timestamp !== \"string\") return null;\n202:   const sessionId = line.sessionId ?? \"\";\n203: \n204:   const actor: Actor = line.type === \"user\" ? { type: \"human\" } : { type: \"agent\" };\n205:   if (line.type === \"user\") {\n206:     if (identity.email) actor.id = identity.email;\n207:     if (identity.name) actor.display = identity.name;\n208:   }\n209:   if (line.type === \"assistant\" && line.message.model) actor.id = line.message.model;\n210: \n211:   return {\n212:     kind: \"conversation_turn\",\n213:     occurred_at: line.timestamp,\n214:     actor,\n215:     producer: {\n216:       tool: \"cledger\",\n217:       version,\n218:       source: \"claude-code\",\n219:       session_id: sessionId,\n220:       ...agentContext(line),\n221:     },\n222:     conversation: { id: `claude-code:${sessionId}`, seq },\n223:     content: { role: line.message.role, blocks: convertContentBlocks(line.message.content) },\n224:     raw: { format: RAW_FORMAT, data: line },\n225:   };\n226: }\n227: \n228: /**\n229:  * Re-normalization hook (see renormalize.ts): given a preserved\n230:  * `unrecognized` event this adapter's `producer.source` owns, try to turn its\n231:  * stored `raw.data` into the `conversation_turn` a live capture would produce.\n232:  *\n233:  * Id fidelity is the whole point: `convertLine` is fed the exact inputs the\n234:  * capture loop used — the same source line (`raw.data`), the same seq\n235:  * (`conversation.seq`), the same session id (carried in the line) — so the\n236:  * turn's identity subset, and therefore its id, is byte-identical to what a\n237:  * later live capture of the same line yields, and the two dedup instead of\n238:  * duplicating. `version`/`identity` are the current ones (version is not part\n239:  * of identity; identity is the same git identity a live capture here would\n240:  * read). Returns null when this adapter still cannot interpret the line —\n241:  * timestampless lines included, since `conver