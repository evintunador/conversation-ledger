{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { git } from \"../git.js\";\n4\timport {\n5\t  appendEvents,\n6\t  listAnchors,\n7\t  NOTES_REF,\n8\t  readEvents,\n9\t  readNoteEvents,\n10\t  readPending,\n11\t  redactEvent,\n12\t  sync,\n13\t} from \"../store.js\";\n14\timport {\n15\t  cleanupDir,\n16\t  cleanupRepo,\n17\t  draft,\n18\t  makeBareRepo,\n19\t  makeCommit,\n20\t  makeTempRepo,\n21\t} from \"./helpers.js\";\n22\t\n23\ttest(\"redactEvent: --pattern rewrites content+raw, preserves the id, appends a redacts companion, and squashes local history\", async () => {\n24\t  const repo = await makeTempRepo();\n25\t  try {\n26\t    await makeCommit(repo, \"init\");\n27\t    const secret = \"hunter2xK9aa\"; // format the capture-tier ruleset does not recognize\n28\t    const originalDraft = draft({\n29\t      content: { text: `db_password: ${secret}` },\n30\t      raw: { format: \"test/1\", data: { blob: `db_password: ${secret}` } },\n31\t    });\n32\t    const appendResult = await appendEvents(repo, [originalDraft]);\n33\t    assert.strictEqual(appendResult.appended.length, 1);\n34\t    const original = appendResult.appended[0]!;\n35\t    assert.ok(\n36\t      JSON.stringify(original).includes(secret),\n37\t      \"sanity: this secret shape must survive capture-tier redaction unredacted\",\n38\t    );\n39\t\n40\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret, reason: \"test-reason\" });\n41\t\n42\t    // Id preservation is the crux of the whole mechanism: rewriting the\n43\t    // content must not change the event's id (see the CRITICAL comment in\n44\t    // store.ts) or a later rescan would resurrect the secret under the old\n45\t    // id.\n46\t    assert.strictEqual(result.event.id, original.id);\n47\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n48\t    assert.ok(!JSON.stringify(result.event.raw ?? {}).includes(secret));\n49\t    assert.ok(result.event.redactions?.some((r) => r.rule === \"manual\"));\n50\t\n51\t    // Companion event.\n52\t    assert.strictEqual(result.redactionEvent.kind, \"redaction\");\n53\t    assert.deepStrictEqual(result.redactionEvent.links, [{ rel: \"redacts\", target: original.id }]);\n54\t    const companionContent = result.redactionEvent.content as {\n55\t      target: string;\n56\t      mode: string;\n57\t      reason?: string;\n58\t    };\n59\t    assert.strictEqual(companionContent.target, original.id);\n60\t    assert.strictEqual(companionContent.mode, \"pattern\");\n61\t    assert.strictEqual(companionContent.reason, \"test-reason\");\n62\t\n63\t    // The stored note itself reflects the rewrite, not just the returned object.\n64\t    const [anchor] = await listAnchors(repo);\n65\t    assert.ok(anchor);\n66\t    const stored = await readNoteEvents(repo, anchor);\n67\t    const storedTarget = stored.find((e) => e.id === original.id);\n68\t    assert.ok(storedTarget);\n69\t    assert.ok(!JSON.stringify(storedTarget).includes(secret));\n70\t\n71\t    // No remote configured: local notes history is squashed to one commit.\n72\t    assert.strictEqual(result.squashed, true);\n73\t    const log = await git([\"log\", \"--oneline\", NOTES_REF], { cwd: repo.root });\n74\t    assert.strictEqual(log.trim().split(\"\\n\").filter(Boolean).length, 1);\n75\t\n76\t    // THE dedup test: re-appending the exact original, unredacted draft\n77\t    // must not resurrect the secret under a new event. Because the\n78\t    // rewritten event kept the original id, recomputing the id for the\n79\t    // same source draft collides with the id already on record (which now\n80\t    // holds redacted content), so it dedups instead of creating a second,\n81\t    // unredacted copy.\n82\t    const rescan = await appendEvents(repo, [originalDraft]);\n83\t    assert.strictEqual(rescan.appended.length, 0, \"the secret must not be able to sneak back 