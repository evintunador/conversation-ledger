{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { execFile } from \"node:child_process\";\n2\timport { chmod, mkdir, readFile, writeFile } from \"node:fs/promises\";\n3\timport { existsSync } from \"node:fs\";\n4\timport { join } from \"node:path\";\n5\timport { fileURLToPath } from \"node:url\";\n6\timport { promisify } from \"node:util\";\n7\timport { git, type RepoInfo } from \"./git.js\";\n8\timport { type CledgerConfig } from \"./redact/config.js\";\n9\t\n10\tconst execFileP = promisify(execFile);\n11\t\n12\texport const NOTES_NAME = \"conversation-ledger\";\n13\texport const NOTES_REF = `refs/notes/${NOTES_NAME}`;\n14\t\n15\t/**\n16\t * Staging ref for events arriving from a remote. `git fetch` lands the\n17\t * remote's ledger ref here (via the refspec ensureTransport configures);\n18\t * absorbIncoming() folds it into the local ref lazily at read time. The\n19\t * local ref is never force-overwritten — absorption is always the\n20\t * cat_sort_uniq union.\n21\t */\n22\texport const INCOMING_NAME = \"cledger-incoming\";\n23\texport const INCOMING_REF = `refs/notes/${INCOMING_NAME}`;\n24\t\n25\tconst FETCH_REFSPEC = `+${NOTES_REF}:${INCOMING_REF}`;\n26\tconst HOOK_MARKER = \"conversation-ledger pre-push\";\n27\t\n28\texport async function ensureMergeConfig(repo: RepoInfo): Promise<void> {\n29\t  const key = `notes.${NOTES_NAME}.mergeStrategy`;\n30\t  const current = (await git([\"config\", \"--get\", key], {\n31\t    cwd: repo.root,\n32\t    allowFailure: true,\n33\t  })).trim();\n34\t  if (current !== \"cat_sort_uniq\") {\n35\t    await git([\"config\", key, \"cat_sort_uniq\"], { cwd: repo.root });\n36\t  }\n37\t}\n38\t\n39\t/**\n40\t * The command hook scripts should run. Prefers this exact installation\n41\t * (absolute node + cli.js — immune to PATH differences and to an older\n42\t * global `cledger` that predates a subcommand), with a PATH fallback baked\n43\t * into the script itself for when this installation moves.\n44\t */\n45\tfunction cledgerInvocation(): { node: string; cli: string } {\n46\t  return {\n47\t    node: process.execPath,\n48\t    cli: fileURLToPath(new URL(\"./cli.js\", import.meta.url)),\n49\t  };\n50\t}\n51\t\n52\tfunction hookBlock(): string {\n53\t  const { node, cli } = cledgerInvocation();\n54\t  return [\n55\t    `# >>> ${HOOK_MARKER} (added by cledger) >>>`,\n56\t    `# Shares this repo's conversation records (${NOTES_REF}) when you push.`,\n57\t    `# Delete this block to disable, or set {\"transport\": {\"hook\": false}} in`,\n58\t    `# .cledger.json / ~/.config/cledger/config.json.`,\n59\t    `if [ -z \"$CLEDGER_INTERNAL\" ]; then`,\n60\t    `  if [ -x \"${node}\" ] && [ -e \"${cli}\" ]; then`,\n61\t    `    \"${node}\" \"${cli}\" transport-push \"$1\" </dev/null || exit $?`,\n62\t    `  elif command -v cledger >/dev/null 2>&1; then`,\n63\t    `    cledger transport-push \"$1\" </dev/null || exit $?`,\n64\t    `  fi`,\n65\t    `fi`,\n66\t    `# <<< ${HOOK_MARKER} <<<`,\n67\t  ].join(\"\\n\");\n68\t}\n69\t\n70\t/** Warnings that should print once per repo, not on every capture. */\n71\tasync function warnOnce(repo: RepoInfo, key: string, message: string): Promise<void> {\n72\t  const stateDir = join(repo.gitDir, \"conversation-ledger\");\n73\t  const path = join(stateDir, \"transport-warnings.json\");\n74\t  let warned: string[] = [];\n75\t  try {\n76\t    warned = JSON.parse(await readFile(path, \"utf8\")) as string[];\n77\t  } catch {\n78\t    // first warning, or unreadable state — state is rebuildable\n79\t  }\n80\t  if (warned.includes(key)) return;\n81\t  process.stderr.write(message);\n82\t  await mkdir(stateDir, { recursive: true });\n83\t  await writeFile(path, JSON.stringify([...warned, key]) + \"\\n\");\n84\t}\n85\t\n86\texport interface TransportSetup {\n87\t  hook: \"installed\" | \"present\" | \"appended\" | \"skipped-config\" | \"skipped-hookspath\" | \"skipped-foreign\";\n88\t  refspec: \"added\" | \"present\" | \"skipped-config\" | \"no-remote\";\n89\t}\n90\t\n91\t/**\n92\t * Transport is default-on but must cost the user nothing to get: the first\n93\t * capture in a repo wires it up. Installs the pre-push hook (chain-safe:\n94\t * appends to an existing shell hook, backs off with a one-time warning when\n95\t * core.hooksPath or a non-shell hook owns the file) and adds the fetch\n96\t * refspec that stages the remote's ledger ref on normal `git fetch`.\n97\t * Runs on every append — each check is a cheap stat/config read — so a\n98\t * remote added later still gets wired. Never throws: this runs inside\n99\t * capture, which must never fail a user's session.\n100\t */\n101\texport async function ensureTransport(\n102\t  repo: RepoInfo,\n103\t  config: CledgerConfig,\n104\t): Promise<TransportSetup | null> {\n105\t  try {\n106\t    return {\n107\t      hook: await ensurePrePushHook(repo, config),\n108\t      refspec: await ensureFetchRefspec(repo, config),\n109\t    };\n110\t  } catch {\n111\t    return null;\n112\t  }\n113\t}\n114\t\n115\tasync function ensurePrePushHook(\n116\t  repo: RepoInfo,\n117\t  config: CledgerConfig,\n118\t): Promise<TransportSetup[\"hook\"]> {\n119\t  if (config.transport?.hook === false) return \"skipped-config\";\n120\t\n121\t  const hooksPath = (await git([\"config\", \"--get\", \"core.hooksPath\"], {\n122\t    cwd: repo.root,\n123\t    allowFailure: true,\n124\t  })).trim();\n125\t  if (hooksPath) {\n126\t    await warnOnce(\n127\t      repo,\n128\t      \"hookspath\",\n129\t      `cledger: core.hooksPath is set (${hooksPath}), so the ledger pre-push hook was not ` +\n130\t        `installed. To share conversation records on push, add\\n` +\n131\t        `  cledger transport-push \"$1\"\\n` +\n132\t        `to that pre-push hook, or run \\`cledger sync\\` manually.\\n`,\n133\t    );\n134\t    return \"skipped-hookspath\";\n135\t  }\n136\t\n137\t  const hookPath = join(repo.gitDir, \"hooks\", \"pre-push\");\n138\t  if (!existsSync(hookPath)) {\n139\t    await mkdir(join(repo.gitDir, \"hooks\"), { recursive: true });\n140\t    await writeFile(hookPath, `#!/bin/sh\\n${hookBlock()}\\n`);\n141\t    await chmod(hookPath, 0o755);\n142\t    return \"installed\";\n143\t  }\n144\t\n145\t  const existing = await readFile(hookPath, \"utf8\");\n146\t  if (existing.includes(HOOK_MARKER)) return \"present\";\n147\t\n148\t  const shebang = existing.split(\"\\n\", 1)[0] ?? \"\";\n149\t  if (!/^#!.*\\b(sh|bash|zsh|dash|ksh)\\b/.test(shebang)) {\n150\t    await warnOnce(\n151\t      repo,\n152\t      \"foreign-hook\",\n153\t      `cledger: this repo's pre-push hook is not a shell script, so the ledger hook was not ` +\n154\t        `chained onto it. Run \\`cledger sync\\` to share conversation records manually.\\n`,\n155\t    );\n156\t    return \"skipped-foreign\";\n157\t  }\n158\t\n159\t  await writeFile(hookPath, existing.replace(/\\n?$/, \"\\n\") + \"\\n\" + hookBlock() + \"\\n\");\n160\t  await chmod(hookPath, 0o755);\n161\t  return \"appended\";\n162\t}\n163\t\n164\tasync function ensureFetchRefspec(\n165\t  repo: RepoInfo,\n166\t  config: CledgerConfig,\n167\t): Promise<TransportSetup[\"refspec\"]> {\n168\t  if (config.transport?.fetchRefspec === false) return \"skipped-config\";\n169\t\n170\t  const originUrl = (await git([\"remote\", \"get-url\", \"origin\"], {\n171\t    cwd: repo.root,\n172\t    allowFailure: true,\n173\t  })).trim();\n174\t  if (!originUrl) return \"no-remote\";\n175\t\n176\t  const fetchSpecs = await git([\"config\", \"--get-all\", \"remote.origin.fetch\"], {\n177\t    cwd: repo.root,\n178\t    allowFailure: true,\n179\t  });\n180\t  if (fetchSpecs.includes(INCOMING_REF)) return \"present\";\n181\t\n182\t  await git([\"config\", \"--add\", \"remote.origin.fetch\", FETCH_REFSPEC], { cwd: repo.root });\n183\t  return \"added\";\n184\t}\n185\t\n186\t/**\n187\t * Fold the staged incoming ref (populated by `git fetch` via the refspec)\n188\t * into the local ledger ref — the lazy, read-time half of transport. The\n189\t * merge is