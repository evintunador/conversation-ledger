  });\n101:   return body.split(\"\\n\").filter((l) => l.trim().length > 0);\n102: }\n103: \n104: /** `refName` defaults to the main ledger ref; the scan gate also reads a temp fetched ref. */\n105: export async function readNoteEvents(\n106:   repo: RepoInfo,\n107:   anchor: string,\n108:   refName = NOTES_NAME,\n109: ): Promise<EvidenceEvent[]> {\n110:   return (await readNoteLines(repo, anchor, refName)).map(parseEventLine);\n111: }\n112: \n113: /** All (anchor commit, note) pairs in the ledger ref (or `refName`, for reading a temp fetched ref). */\n114: export async function listAnchors(repo: RepoInfo, refName = NOTES_NAME): Promise<string[]> {\n115:   const out = await git([\"notes\", \"--ref\", refName, \"list\"], {\n116:     cwd: repo.root,\n117:     allowFailure: true,\n118:   });\n119:   return out\n120:     .split(\"\\n\")\n121:     .filter(Boolean)\n122:     .map((line) => line.split(/\\s+/)[1])\n123:     .filter((sha): sha is string => Boolean(sha));\n124: }\n125: \n126: async function withLock<T>(repo: RepoInfo, fn: () => Promise<T>): Promise<T> {\n127:   await ensureStateDir(repo);\n128:   const lockDir = join(stateDir(repo), \"lock\");\n129:   const deadline = Date.now() + 10_000;\n130:   for (;;) {\n131:     try {\n132:       await mkdir(lockDir);\n133:       break;\n134:     } catch {\n135:       if (Date.now() > deadline) {\n136:         // A crashed writer can leave the lock behind; steal it after the\n137:         // wait budget rather than wedging capture hooks forever.\n138:         await rm(lockDir, { recursive: true, force: true });\n139:       } else {\n140:         await new Promise((r) => setTimeout(r, 100));\n141:       }\n142:     }\n143:   }\n144:   try {\n145:     return await fn();\n146:   } finally {\n147:     await rm(lockDir, { recursive: true, force: true });\n148:   }\n149: }\n150: \n151: export interface AppendResult {\n152:   appended: EvidenceEvent[];\n153:   deduped: number;\n154:   /** null when events went to the pending qu