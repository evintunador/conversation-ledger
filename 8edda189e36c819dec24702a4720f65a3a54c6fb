{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert\";\n3\timport { mkdtemp, writeFile, appendFile } from \"node:fs/promises\";\n4\timport { tmpdir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport { captureCodexTranscript } from \"../adapters/codex.js\";\n7\timport { readEvents } from \"../store.js\";\n8\timport { cleanupDir, cleanupRepo, makeCommit, makeTempRepo } from \"./helpers.js\";\n9\t\n10\tconst SESSION_ID = \"codex-sess-1\";\n11\t// Filename carries a base timestamp + a uuid the sessionIdFromFilename regex\n12\t// can extract; the session_meta line (index 0) then overrides the id, which\n13\t// is the more common real-world case and worth exercising too.\n14\tconst FILENAME = \"rollout-2026-01-01T00-00-00-123e4567-e89b-12d3-a456-426614174000.jsonl\";\n15\t\n16\t/** Index 0 is session_meta (not a response_item, dropped); 1-4 are real\n17\t * content; 5 is a reasoning item (preserved opaquely as a `reasoning` event,\n18\t * never as a conversation_turn); 6 is a truncated trailing line that must be\n19\t * tolerated. */\n20\tfunction rolloutLines(): unknown[] {\n21\t  return [\n22\t    { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n23\t    {\n24\t      type: \"response_item\",\n25\t      timestamp: \"2026-01-01T00:00:01.000Z\",\n26\t      payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"Please run tests\" }] },\n27\t    },\n28\t    {\n29\t      type: \"response_item\",\n30\t      timestamp: \"2026-01-01T00:00:02.000Z\",\n31\t      payload: {\n32\t        type: \"message\",\n33\t        role: \"assistant\",\n34\t        content: [{ type: \"output_text\", text: \"Sure, running now.\" }],\n35\t      },\n36\t    },\n37\t    {\n38\t      type: \"response_item\",\n39\t      timestamp: \"2026-01-01T00:00:03.000Z\",\n40\t      payload: { type: \"function_call\", name: \"shell\", arguments: { command: \"pytest\" }, call_id: \"call_9\" },\n41\t    },\n42\t    {\n43\t      type: \"response_item\",\n44\t      timestamp: \"2026-01-01T00:00:04.000Z\",\n45\t      payload: { type: \"function_call_output\", call_id: \"call_9\", output: \"5 passed\" },\n46\t    },\n47\t    {\n48\t      type: \"response_item\",\n49\t      timestamp: \"2026-01-01T00:00:05.000Z\",\n50\t      payload: { type: \"reasoning\", encrypted_content: \"opaque-blob-must-never-be-stored\" },\n51\t    },\n52\t  ];\n53\t}\n54\t\n55\tasync function writeRollout(dir: string): Promise<string> {\n56\t  const path = join(dir, FILENAME);\n57\t  const lines = rolloutLines().map((l) => JSON.stringify(l));\n58\t  lines.push('{\"type\":\"response_item\",\"payload\":{\"type\":\"message\"');\n59\t  await writeFile(path, lines.join(\"\\n\") + \"\\n\");\n60\t  return path;\n61\t}\n62\t\n63\ttest(\"captureCodexTranscript: converts a synthetic rollout end to end\", async () => {\n64\t  const repo = await makeTempRepo(\"cledger-codex-\");\n65\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-\"));\n66\t  try {\n67\t    await makeCommit(repo, \"init\");\n68\t    const rolloutPath = await writeRollout(rolloutDir);\n69\t\n70\t    await captureCodexTranscript(rolloutPath, repo.root);\n71\t\n72\t    const events = await readEvents(repo);\n73\t    assert.strictEqual(\n74\t      events.length,\n75\t      5,\n76\t      \"session_meta and the malformed trailing line must be dropped; reasoning is preserved opaquely\",\n77\t    );\n78\t\n79\t    for (const e of events) {\n80\t      assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n81\t      assert.strictEqual(e.conversation?.id, `codex:${SESSION_ID}`);\n82\t      assert.strictEqual(e.producer.source, \"codex\");\n83\t      assert.strictEqual(\n84\t        e.producer.session_id,\n85\t        SESSION_ID,\n86\t        \"session_meta's session_id must override the filename-derived id\",\n87\t      );\n88\t    }\n89\t\n90\t    // seq must equal the original line index (session_meta occupies index 0).\n91\t    const bySeq = new Map(events.map((e) => [e.conversation!.seq, e]));\n92\t    assert.deepStrictEqual([...bySeq.keys()].sort((a, b) => a - b), [1, 2, 3, 4, 5]);\n93\t\n94\t    const userMsg = bySeq.get(1)!;\n95\t    assert.strictEqual(userMsg.actor.type, \"human\");\n96\t    assert.strictEqual(userMsg.actor.id, \"test@example.com\");\n97\t    assert.strictEqual(userMsg.actor.display, \"Test User\");\n98\t    assert.deepStrictEqual(userMsg.content, {\n99\t      role: \"user\",\n100\t      blocks: [{ type: \"text\", text: \"Please run tests\" }],\n101\t    });\n102\t    assert.strictEqual(userMsg.occurred_at, \"2026-01-01T00:00:01.000Z\");\n103\t\n104\t    const assistantMsg = bySeq.get(2)!;\n105\t    assert.strictEqual(assistantMsg.actor.type, \"agent\");\n106\t    assert.deepStrictEqual(assistantMsg.content, {\n107\t      role: \"assistant\",\n108\t      blocks: [{ type: \"text\", text: \"Sure, running now.\" }],\n109\t    });\n110\t\n111\t    const functionCall = bySeq.get(3)!;\n112\t    assert.strictEqual(functionCall.actor.type, \"agent\");\n113\t    assert.deepStrictEqual(functionCall.content, {\n114\t      role: \"assistant\",\n115\t      blocks: [{ type: \"tool_use\", name: \"shell\", input: { command: \"pytest\" }, id: \"call_9\" }],\n116\t    });\n117\t\n118\t    const functionCallOutput = bySeq.get(4)!;\n119\t    assert.strictEqual(functionCallOutput.actor.type, \"system\");\n120\t    assert.deepStrictEqual(functionCallOutput.content, {\n121\t      role: \"tool_result\",\n122\t      blocks: [{ type: \"tool_result\", tool_use_id: \"call_9\", content: \"5 passed\" }],\n123\t    });\n124\t\n125\t    const reasoning = bySeq.get(5)!;\n126\t    assert.strictEqual(reasoning.kind, \"reasoning\");\n127\t    assert.strictEqual(reasoning.actor.type, \"agent\");\n128\t    assert.deepStrictEqual(reasoning.content, { opaque: true });\n129\t    assert.strictEqual(\n130\t      (reasoning.raw!.data as { payload?: { encrypted_content?: string } }).payload?.encrypted_content,\n131\t      \"opaque-blob-must-never-be-stored\",\n132\t      \"the ciphertext itself lives only in raw.data, never in content\",\n133\t    );\n134\t    assert.ok(\n135\t      !JSON.stringify(reasoning.content).includes(\"opaque-blob\"),\n136\t      \"the blob must never leak into the visible content field\",\n137\t    );\n138\t\n139\t    // --- Rerun on the unchanged rollout: cursor is past EOF, no new events. ---\n140\t    await captureCodexTranscript(rolloutPath, repo.root);\n141\t    const eventsAfterRerun = await readEvents(repo);\n142\t    assert.strictEqual(eventsAfterRerun.length, 5, \"rerun on unchanged rollout must not duplicate\");\n143\t  } finally {\n144\t    await cleanupRepo(repo);\n145\t    await cleanupDir(rolloutDir);\n146\t  }\n147\t});\n148\t\n149\ttest(\"captureCodexTranscript: reasoning items are preserved opaquely, never as a conversation_turn\", async () => {\n150\t  const repo = await makeTempRepo(\"cledger-codex-reasoning-\");\n151\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-reasoning-\"));\n152\t  try {\n153\t    await makeCommit(repo, \"init\");\n154\t    const rolloutPath = await writeRollout(rolloutDir);\n155\t    await captureCodexTranscript(rolloutPath, repo.root);\n156\t    const events = await readEvents(repo);\n157\t    const reasoningEvents = events.filter((e) => e.kind === \"reasoning\");\n158\t    assert.strictEqual(reasoningEvents.length, 1);\n159\t    for (const e of events) {\n160\t      if (e.kind === \"reasoning\") continue;\n161\t      assert.notStrictEqual(\n162\t        (e.raw?.data as { payload?: { type?: string } })?.payload?.type,\n163\t        \"reasoning\",\n164\t        \"reasoning payloads must never surface as a conversation_turn or unrecognized event\",\n165\t      );\n166\t    }\n167\t\n168\t    // Reprocessing the same rollout must dedup, not duplicate the opaque event.\n169\t    await captureCodexTranscript(rolloutPath, repo.root);\n170\t    const afterRerun = (await readEvents(repo)).filter((e) => e.kind === \"reasoning\");\n171\t    assert.strictEqual(afterRerun.length, 1);\n172\t  } finally {\n173\t    await cleanupRepo(repo);\n174\t    await cleanupDir(rolloutDir);\n175\t  }\n176\t});\n177\t\n178\ttest(\"captureCodexTranscript: a populated reasoning summary becomes a visible conversation_turn alongside the opaque event\", async () => {\n179\t  const repo = await makeTempRepo(\"cledger-codex-reasoning-summary-\");\n180\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-reasoning-summary-\"));\n181\t  try {\n182\t    await makeCommit(repo, \"init\");\n183\t    const path = join(dir, FILENAME);\n184\t    const lines = [\n185\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n186\t      {\n187\t        type: \"response_item\",\n188\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n189\t        payload: {\n190\t          type: \"reasoning\",\n191\t          encrypted_content: \"opaque-blob-must-never-be-stored\",\n192\t          summary: [\n193\t            { type: \"summary_text\", text: \"Considering the test suite.\" },\n194\t            { type: \"summary_text\", text: \"Deciding to run pytest.\" },\n195\t          ],\n196\t        },\n197\t      },\n198\t    ];\n199\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n200\t\n201\t    const result = await captureCodexTranscript(path, repo.root);\n202\t    assert.strictEqual(result.appended, 2, \"one visible turn plus one opaque reasoning event\");\n203\t\n204\t    const events = await readEvents(repo);\n205\t    const visible = events.find((e) => e.kind === \"conversation_turn\")!;\n206\t    const opaque = events.find((e) => e.kind === \"reasoning\")!;\n207\t    assert.ok(visible, \"the summary must surface as an ordinary conversation_turn\");\n208\t    assert.ok(opaque);\n209\t    assert.strictEqual(visible.conversation?.seq, opaque.conversation?.seq, \"same source line, same seq\");\n210\t    assert.deepStrictEqual(visible.content, {\n211\t      role: \"reasoning_summary\",\n212\t      blocks: [{ type: \"text\", text: \"Considering the test suite.\\n\\nDeciding to run pytest.\" }],\n213\t    });\n214\t    assert.deepStrictEqual(opaque.content, { opaque: true });\n215\t    const serialized = JSON.stringify(visible);\n216\t    assert.ok(!serialized.includes(\"opaque-blob\"), \"the ciphertext must never leak into the visible turn\");\n217\t  } finally {\n218\t    await cleanupRepo(repo);\n219\t    await cleanupDir(dir);\n220\t  }\n221\t});\n222\t\n223\ttest(\"captureCodexTranscript: a later capture only ingests newly appended lines\", async () => {\n224\t  const repo = await makeTempRepo(\"cledger-codex-growth-\");\n225\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-growth-\"));\n226\t  try {\n227\t    await makeCommit(repo, \"init\");\n228\t    const rolloutPath = await writeRollout(rolloutDir);\n229\t    await captureCodexTranscript(rolloutPath, repo.root);\n230\t    assert.strictEqual((await readEvents(repo)).length, 5);\n231\t\n232\t    await appendFile(\n233\t      rolloutPath,\n234\t      JSON.stringify({\n235\t        type: \"response_item\",\n236\t        timestamp: \"2026-01-01T00:00:10.000Z\",\n237\t        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"one more turn\" }] },\n238\t      }) + \"\\n\",\n239\t    );\n240\t    await captureCodexTranscript(rolloutPath, repo.root);\n241\t\n242\t    const events = await readEvents(repo);\n243\t    assert.strictEqual(events.length, 6, \"only the newly appended line should be added\");\n244\t  } finally {\n245\t    await cleanupRepo(repo);\n246\t    await cleanupDir(rolloutDir);\n247\t  }\n248\t});\n249\t\n250\ttest(\"captureCodexTranscript: unrecognized line and payload types are counted for drift\", async () => {\n251\t  const repo = await makeTempRepo(\"cledger-codex-drift-\");\n252\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-\"));\n253\t  try {\n254\t    await makeCommit(repo, \"init\");\n255\t    const path = join(dir, FILENAME);\n256\t    const lines = [\n257\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n258\t      {\n259\t        type: \"response_item\",\n260\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n261\t        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"hi\" }] },\n262\t      },\n263\t      // Recognized-but-opaque: reasoning payloads become a reasoning event,\n264\t      // not drift. Known-skipped: bookkeeping line types.\n265\t      { type: \"response_item\", timestamp: \"2026-01-01T00:00:02.000Z\", payload: { type: \"reasoning\" } },\n266\t      { type: \"turn_context\", payload: {} },\n267\t      // Drift: a payload type and a line type this adapter has never seen.\n268\t      {\n269\t        type: \"response_item\",\n270\t        timestamp: \"2026-01-01T00:00:03.000Z\",\n271\t        payload: { type: \"holo_call\", text: \"future content kind\" },\n272\t      },\n273\t      { type: \"brand_new_line_kind\", payload: {} },\n274\t    ];\n275\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n276\t\n277\t    const result = await captureCodexTranscript(path, repo.root);\n278\t    // 1 interpreted message + 1 opaque reasoning event + 2 raw-only preservation events for the drift lines.\n279\t    assert.strictEqual(result.appended, 4);\n280\t    assert.deepStrictEqual(result.unrecognized, {\n281\t      \"response_item/holo_call\": 1,\n282\t      brand_new_line_kind: 1,\n283\t    });\n284\t\n285\t    // The unrecognized lines are preserved raw-only, not dropped.\n286\t    const events = await readEvents(repo);\n287\t    const preserved = events\n288\t      .filter((e) => e.kind === \"unrecognized\")\n289\t      .sort((a, b) => (a.conversation!.seq - b.conversation!.seq));\n290\t    assert.strictEqual(preserved.length, 2);\n291\t\n292\t    const holo = preserved[0]!;\n293\t    assert.strictEqual(holo.actor.type, \"system\");\n294\t    assert.deepStrictEqual(holo.content, { unrecognized_type: \"response_item/holo_call\" });\n295\t    assert.strictEqual(holo.raw!.format, \"codex-rollout-jsonl/2\");\n296\t    // Full source line retained under raw.data for later re-normalization.\n297\t    assert.deepStrictEqual(holo.raw!.data, {\n298\t      type: \"response_item\",\n299\t      timestamp: \"2026-01-01T00:00:03.000Z\",\n300\t      payload: { type: \"holo_call\", text: \"future content kind\" },\n301\t    });\n302\t    assert.strictEqual(holo.occurred_at, \"2026-01-01T00:00:03.000Z\");\n303\t\n304\t    const brandNew = preserved[1]!;\n305\t    assert.deepStrictEqual(brandNew.content, { unrecognized_type: \"brand_new_line_kind\" });\n306\t    assert.deepStrictEqual(brandNew.raw!.data, { type: \"brand_new_line_kind\", payload: {} });\n307\t  } finally {\n308\t    await cleanupRepo(repo);\n309\t    await cleanupDir(dir);\n310\t  }\n311\t});\n312\t\n313\ttest(\"captureCodexTranscript: a secret inside an unrecognized line is redacted in raw\", async () => {\n314\t  const repo = await makeTempRepo(\"cledger-codex-drift-secret-\");\n315\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-secret-\"));\n316\t  try {\n317\t    await makeCommit(repo, \"init\");\n318\t    const path = join(dir, FILENAME);\n319\t    const secret = \"ghp_\" + \"a\".repeat(36);\n320\t    const lines = [\n321\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n322\t      {\n323\t        type: \"response_item\",\n324\t        timestamp: \"2026-01-01T00:00:03.000Z\",\n325\t        payload: { type: \"holo_call\", token: secret },\n326\t      },\n327\t    ];\n328\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n329\t\n330\t    await captureCodexTranscript(path, repo.root);\n331\t    const events = await readEvents(repo);\n332\t    const preserved = events.find((e) => e.kind === \"unrecognized\")!;\n333\t    const serialized = JSON.stringify(preserved);\n334\t    assert.ok(!serialized.includes(secret), \"secret must not survive in the preserved event\");\n335\t    assert.ok(serialized.includes(\"[REDACTED:\"), \"secret must be replaced with a redaction placeholder\");\n336\t    assert.ok((preserved.redactions ?? []).length > 0, \"a redaction record must be attached\");\n337\t  } finally {\n338\t    await cleanupRepo(repo);\n339\t    await cleanupDir(dir);\n340\t  }\n341\t});\n342\t\n343\ttest(\"captureCodexTranscript: agent_message keeps visible text, drops encrypted blocks everywhere\", async () => {\n344\t  const repo = await makeTempRepo(\"cledger-codex-agentmsg-\");\n345\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-agentmsg-\"));\n346\t  try {\n347\t    await makeCommit(repo, \"init\");\n348\t    const path = join(dir, FILENAME);\n349\t    const lines = [\n350\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n351\t      {\n352\t        type: \"response_item\",\n353\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n354\t        payload: {\n355\t          type: \"agent_message\",\n356\t          author: \"/root\",\n357\t          recipient: \"/root/subagent\",\n358\t          content: [\n359\t            { type: \"input_text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" },\n360\t            { type: \"encrypted_content\", encrypted_content: \"gAAAAAB-opaque-blob-must-never-be-stored\" },\n361\t          ],\n362\t        },\n363\t      },\n364\t    ];\n365\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n366\t\n367\t    const result = await captureCodexTranscript(path, repo.root);\n368\t    assert.strictEqual(result.appended, 1);\n369\t    assert.deepStrictEqual(result.unrecognized, {}, \"agent_message is a recognized type now\");\n370\t\n371\t    const events = await readEvents(repo);\n372\t    const e = events[0]!;\n373\t    assert.strictEqual(e.actor.type, \"agent\");\n374\t    assert.strictEqual(e.actor.id, \"/root\");\n375\t    assert.deepStrictEqual(e.content, {\n376\t      role: \"agent_message\",\n377\t      author: \"/root\",\n378\t      recipient: \"/root/subagent\",\n379\t      blocks: [{ type: \"text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" }],\n380\t    });\n381\t\n382\t    // The encrypted payload must be gone from the event wholesale — content\n383\t    // and raw alike — leaving only the bare type marker in raw.\n384\t    const serialized = JSON.stringify(e);\n385\t    assert.ok(!serialized.includes(\"opaque-blob\"), \"encrypted content must never be stored\");\n386\t    const rawContent = ((e.raw?.data as { payload?: { content?: unknown[] } }).payload?.content) ?? [];\n387\t    assert.deepStrictEqual(rawContent[1], { type: \"encrypted_content\" });\n388\t    assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n389\t  } finally {\n390\t    await cleanupRepo(repo);\n391\t    await cleanupDir(dir);\n392\t  }\n393\t});\n394\t","tool_use_id":"toolu_01UFmSUsgYiC2UrHCEj5ZZK1","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","head":"8edda189e36c819dec24702a4720f65a3a54c6fb","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:cef69ec2-8b5a-4e91-8078-ac955e039295","seq":171},"id":"ev1-cab27762b3f4f7cab8a2b4d50b91de1abdc1b7216afe397f9e0ebf5ade5ac7d8","kind":"conversation_turn","occurred_at":"2026-07-27T06:54:27.018Z","producer":{"session_id":"cef69ec2-8b5a-4e91-8078-ac955e039295","source":"claude-code","source_version":"2.1.220","tool":"cledger","version":"0.12.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/producer-metadata","entrypoint":"cli","gitBranch":"worktree-producer-metadata","isSidechain":false,"message":{"content":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert\";\n3\timport { mkdtemp, writeFile, appendFile } from \"node:fs/promises\";\n4\timport { tmpdir } from \"node:os\";\n5\timport { join } from \"node:path\";\n6\timport { captureCodexTranscript } from \"../adapters/codex.js\";\n7\timport { readEvents } from \"../store.js\";\n8\timport { cleanupDir, cleanupRepo, makeCommit, makeTempRepo } from \"./helpers.js\";\n9\t\n10\tconst SESSION_ID = \"codex-sess-1\";\n11\t// Filename carries a base timestamp + a uuid the sessionIdFromFilename regex\n12\t// can extract; the session_meta line (index 0) then overrides the id, which\n13\t// is the more common real-world case and worth exercising too.\n14\tconst FILENAME = \"rollout-2026-01-01T00-00-00-123e4567-e89b-12d3-a456-426614174000.jsonl\";\n15\t\n16\t/** Index 0 is session_meta (not a response_item, dropped); 1-4 are real\n17\t * content; 5 is a reasoning item (preserved opaquely as a `reasoning` event,\n18\t * never as a conversation_turn); 6 is a truncated trailing line that must be\n19\t * tolerated. */\n20\tfunction rolloutLines(): unknown[] {\n21\t  return [\n22\t    { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n23\t    {\n24\t      type: \"response_item\",\n25\t      timestamp: \"2026-01-01T00:00:01.000Z\",\n26\t      payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"Please run tests\" }] },\n27\t    },\n28\t    {\n29\t      type: \"response_item\",\n30\t      timestamp: \"2026-01-01T00:00:02.000Z\",\n31\t      payload: {\n32\t        type: \"message\",\n33\t        role: \"assistant\",\n34\t        content: [{ type: \"output_text\", text: \"Sure, running now.\" }],\n35\t      },\n36\t    },\n37\t    {\n38\t      type: \"response_item\",\n39\t      timestamp: \"2026-01-01T00:00:03.000Z\",\n40\t      payload: { type: \"function_call\", name: \"shell\", arguments: { command: \"pytest\" }, call_id: \"call_9\" },\n41\t    },\n42\t    {\n43\t      type: \"response_item\",\n44\t      timestamp: \"2026-01-01T00:00:04.000Z\",\n45\t      payload: { type: \"function_call_output\", call_id: \"call_9\", output: \"5 passed\" },\n46\t    },\n47\t    {\n48\t      type: \"response_item\",\n49\t      timestamp: \"2026-01-01T00:00:05.000Z\",\n50\t      payload: { type: \"reasoning\", encrypted_content: \"opaque-blob-must-never-be-stored\" },\n51\t    },\n52\t  ];\n53\t}\n54\t\n55\tasync function writeRollout(dir: string): Promise<string> {\n56\t  const path = join(dir, FILENAME);\n57\t  const lines = rolloutLines().map((l) => JSON.stringify(l));\n58\t  lines.push('{\"type\":\"response_item\",\"payload\":{\"type\":\"message\"');\n59\t  await writeFile(path, lines.join(\"\\n\") + \"\\n\");\n60\t  return path;\n61\t}\n62\t\n63\ttest(\"captureCodexTranscript: converts a synthetic rollout end to end\", async () => {\n64\t  const repo = await makeTempRepo(\"cledger-codex-\");\n65\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-\"));\n66\t  try {\n67\t    await makeCommit(repo, \"init\");\n68\t    const rolloutPath = await writeRollout(rolloutDir);\n69\t\n70\t    await captureCodexTranscript(rolloutPath, repo.root);\n71\t\n72\t    const events = await readEvents(repo);\n73\t    assert.strictEqual(\n74\t      events.length,\n75\t      5,\n76\t      \"session_meta and the malformed trailing line must be dropped; reasoning is preserved opaquely\",\n77\t    );\n78\t\n79\t    for (const e of events) {\n80\t      assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n81\t      assert.strictEqual(e.conversation?.id, `codex:${SESSION_ID}`);\n82\t      assert.strictEqual(e.producer.source, \"codex\");\n83\t      assert.strictEqual(\n84\t        e.producer.session_id,\n85\t        SESSION_ID,\n86\t        \"session_meta's session_id must override the filename-derived id\",\n87\t      );\n88\t    }\n89\t\n90\t    // seq must equal the original line index (session_meta occupies index 0).\n91\t    const bySeq = new Map(events.map((e) => [e.conversation!.seq, e]));\n92\t    assert.deepStrictEqual([...bySeq.keys()].sort((a, b) => a - b), [1, 2, 3, 4, 5]);\n93\t\n94\t    const userMsg = bySeq.get(1)!;\n95\t    assert.strictEqual(userMsg.actor.type, \"human\");\n96\t    assert.strictEqual(userMsg.actor.id, \"test@example.com\");\n97\t    assert.strictEqual(userMsg.actor.display, \"Test User\");\n98\t    assert.deepStrictEqual(userMsg.content, {\n99\t      role: \"user\",\n100\t      blocks: [{ type: \"text\", text: \"Please run tests\" }],\n101\t    });\n102\t    assert.strictEqual(userMsg.occurred_at, \"2026-01-01T00:00:01.000Z\");\n103\t\n104\t    const assistantMsg = bySeq.get(2)!;\n105\t    assert.strictEqual(assistantMsg.actor.type, \"agent\");\n106\t    assert.deepStrictEqual(assistantMsg.content, {\n107\t      role: \"assistant\",\n108\t      blocks: [{ type: \"text\", text: \"Sure, running now.\" }],\n109\t    });\n110\t\n111\t    const functionCall = bySeq.get(3)!;\n112\t    assert.strictEqual(functionCall.actor.type, \"agent\");\n113\t    assert.deepStrictEqual(functionCall.content, {\n114\t      role: \"assistant\",\n115\t      blocks: [{ type: \"tool_use\", name: \"shell\", input: { command: \"pytest\" }, id: \"call_9\" }],\n116\t    });\n117\t\n118\t    const functionCallOutput = bySeq.get(4)!;\n119\t    assert.strictEqual(functionCallOutput.actor.type, \"system\");\n120\t    assert.deepStrictEqual(functionCallOutput.content, {\n121\t      role: \"tool_result\",\n122\t      blocks: [{ type: \"tool_result\", tool_use_id: \"call_9\", content: \"5 passed\" }],\n123\t    });\n124\t\n125\t    const reasoning = bySeq.get(5)!;\n126\t    assert.strictEqual(reasoning.kind, \"reasoning\");\n127\t    assert.strictEqual(reasoning.actor.type, \"agent\");\n128\t    assert.deepStrictEqual(reasoning.content, { opaque: true });\n129\t    assert.strictEqual(\n130\t      (reasoning.raw!.data as { payload?: { encrypted_content?: string } }).payload?.encrypted_content,\n131\t      \"opaque-blob-must-never-be-stored\",\n132\t      \"the ciphertext itself lives only in raw.data, never in content\",\n133\t    );\n134\t    assert.ok(\n135\t      !JSON.stringify(reasoning.content).includes(\"opaque-blob\"),\n136\t      \"the blob must never leak into the visible content field\",\n137\t    );\n138\t\n139\t    // --- Rerun on the unchanged rollout: cursor is past EOF, no new events. ---\n140\t    await captureCodexTranscript(rolloutPath, repo.root);\n141\t    const eventsAfterRerun = await readEvents(repo);\n142\t    assert.strictEqual(eventsAfterRerun.length, 5, \"rerun on unchanged rollout must not duplicate\");\n143\t  } finally {\n144\t    await cleanupRepo(repo);\n145\t    await cleanupDir(rolloutDir);\n146\t  }\n147\t});\n148\t\n149\ttest(\"captureCodexTranscript: reasoning items are preserved opaquely, never as a conversation_turn\", async () => {\n150\t  const repo = await makeTempRepo(\"cledger-codex-reasoning-\");\n151\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-reasoning-\"));\n152\t  try {\n153\t    await makeCommit(repo, \"init\");\n154\t    const rolloutPath = await writeRollout(rolloutDir);\n155\t    await captureCodexTranscript(rolloutPath, repo.root);\n156\t    const events = await readEvents(repo);\n157\t    const reasoningEvents = events.filter((e) => e.kind === \"reasoning\");\n158\t    assert.strictEqual(reasoningEvents.length, 1);\n159\t    for (const e of events) {\n160\t      if (e.kind === \"reasoning\") continue;\n161\t      assert.notStrictEqual(\n162\t        (e.raw?.data as { payload?: { type?: string } })?.payload?.type,\n163\t        \"reasoning\",\n164\t        \"reasoning payloads must never surface as a conversation_turn or unrecognized event\",\n165\t      );\n166\t    }\n167\t\n168\t    // Reprocessing the same rollout must dedup, not duplicate the opaque event.\n169\t    await captureCodexTranscript(rolloutPath, repo.root);\n170\t    const afterRerun = (await readEvents(repo)).filter((e) => e.kind === \"reasoning\");\n171\t    assert.strictEqual(afterRerun.length, 1);\n172\t  } finally {\n173\t    await cleanupRepo(repo);\n174\t    await cleanupDir(rolloutDir);\n175\t  }\n176\t});\n177\t\n178\ttest(\"captureCodexTranscript: a populated reasoning summary becomes a visible conversation_turn alongside the opaque event\", async () => {\n179\t  const repo = await makeTempRepo(\"cledger-codex-reasoning-summary-\");\n180\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-reasoning-summary-\"));\n181\t  try {\n182\t    await makeCommit(repo, \"init\");\n183\t    const path = join(dir, FILENAME);\n184\t    const lines = [\n185\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n186\t      {\n187\t        type: \"response_item\",\n188\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n189\t        payload: {\n190\t          type: \"reasoning\",\n191\t          encrypted_content: \"opaque-blob-must-never-be-stored\",\n192\t          summary: [\n193\t            { type: \"summary_text\", text: \"Considering the test suite.\" },\n194\t            { type: \"summary_text\", text: \"Deciding to run pytest.\" },\n195\t          ],\n196\t        },\n197\t      },\n198\t    ];\n199\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n200\t\n201\t    const result = await captureCodexTranscript(path, repo.root);\n202\t    assert.strictEqual(result.appended, 2, \"one visible turn plus one opaque reasoning event\");\n203\t\n204\t    const events = await readEvents(repo);\n205\t    const visible = events.find((e) => e.kind === \"conversation_turn\")!;\n206\t    const opaque = events.find((e) => e.kind === \"reasoning\")!;\n207\t    assert.ok(visible, \"the summary must surface as an ordinary conversation_turn\");\n208\t    assert.ok(opaque);\n209\t    assert.strictEqual(visible.conversation?.seq, opaque.conversation?.seq, \"same source line, same seq\");\n210\t    assert.deepStrictEqual(visible.content, {\n211\t      role: \"reasoning_summary\",\n212\t      blocks: [{ type: \"text\", text: \"Considering the test suite.\\n\\nDeciding to run pytest.\" }],\n213\t    });\n214\t    assert.deepStrictEqual(opaque.content, { opaque: true });\n215\t    const serialized = JSON.stringify(visible);\n216\t    assert.ok(!serialized.includes(\"opaque-blob\"), \"the ciphertext must never leak into the visible turn\");\n217\t  } finally {\n218\t    await cleanupRepo(repo);\n219\t    await cleanupDir(dir);\n220\t  }\n221\t});\n222\t\n223\ttest(\"captureCodexTranscript: a later capture only ingests newly appended lines\", async () => {\n224\t  const repo = await makeTempRepo(\"cledger-codex-growth-\");\n225\t  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-growth-\"));\n226\t  try {\n227\t    await makeCommit(repo, \"init\");\n228\t    const rolloutPath = await writeRollout(rolloutDir);\n229\t    await captureCodexTranscript(rolloutPath, repo.root);\n230\t    assert.strictEqual((await readEvents(repo)).length, 5);\n231\t\n232\t    await appendFile(\n233\t      rolloutPath,\n234\t      JSON.stringify({\n235\t        type: \"response_item\",\n236\t        timestamp: \"2026-01-01T00:00:10.000Z\",\n237\t        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"one more turn\" }] },\n238\t      }) + \"\\n\",\n239\t    );\n240\t    await captureCodexTranscript(rolloutPath, repo.root);\n241\t\n242\t    const events = await readEvents(repo);\n243\t    assert.strictEqual(events.length, 6, \"only the newly appended line should be added\");\n244\t  } finally {\n245\t    await cleanupRepo(repo);\n246\t    await cleanupDir(rolloutDir);\n247\t  }\n248\t});\n249\t\n250\ttest(\"captureCodexTranscript: unrecognized line and payload types are counted for drift\", async () => {\n251\t  const repo = await makeTempRepo(\"cledger-codex-drift-\");\n252\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-\"));\n253\t  try {\n254\t    await makeCommit(repo, \"init\");\n255\t    const path = join(dir, FILENAME);\n256\t    const lines = [\n257\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n258\t      {\n259\t        type: \"response_item\",\n260\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n261\t        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"hi\" }] },\n262\t      },\n263\t      // Recognized-but-opaque: reasoning payloads become a reasoning event,\n264\t      // not drift. Known-skipped: bookkeeping line types.\n265\t      { type: \"response_item\", timestamp: \"2026-01-01T00:00:02.000Z\", payload: { type: \"reasoning\" } },\n266\t      { type: \"turn_context\", payload: {} },\n267\t      // Drift: a payload type and a line type this adapter has never seen.\n268\t      {\n269\t        type: \"response_item\",\n270\t        timestamp: \"2026-01-01T00:00:03.000Z\",\n271\t        payload: { type: \"holo_call\", text: \"future content kind\" },\n272\t      },\n273\t      { type: \"brand_new_line_kind\", payload: {} },\n274\t    ];\n275\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n276\t\n277\t    const result = await captureCodexTranscript(path, repo.root);\n278\t    // 1 interpreted message + 1 opaque reasoning event + 2 raw-only preservation events for the drift lines.\n279\t    assert.strictEqual(result.appended, 4);\n280\t    assert.deepStrictEqual(result.unrecognized, {\n281\t      \"response_item/holo_call\": 1,\n282\t      brand_new_line_kind: 1,\n283\t    });\n284\t\n285\t    // The unrecognized lines are preserved raw-only, not dropped.\n286\t    const events = await readEvents(repo);\n287\t    const preserved = events\n288\t      .filter((e) => e.kind === \"unrecognized\")\n289\t      .sort((a, b) => (a.conversation!.seq - b.conversation!.seq));\n290\t    assert.strictEqual(preserved.length, 2);\n291\t\n292\t    const holo = preserved[0]!;\n293\t    assert.strictEqual(holo.actor.type, \"system\");\n294\t    assert.deepStrictEqual(holo.content, { unrecognized_type: \"response_item/holo_call\" });\n295\t    assert.strictEqual(holo.raw!.format, \"codex-rollout-jsonl/2\");\n296\t    // Full source line retained under raw.data for later re-normalization.\n297\t    assert.deepStrictEqual(holo.raw!.data, {\n298\t      type: \"response_item\",\n299\t      timestamp: \"2026-01-01T00:00:03.000Z\",\n300\t      payload: { type: \"holo_call\", text: \"future content kind\" },\n301\t    });\n302\t    assert.strictEqual(holo.occurred_at, \"2026-01-01T00:00:03.000Z\");\n303\t\n304\t    const brandNew = preserved[1]!;\n305\t    assert.deepStrictEqual(brandNew.content, { unrecognized_type: \"brand_new_line_kind\" });\n306\t    assert.deepStrictEqual(brandNew.raw!.data, { type: \"brand_new_line_kind\", payload: {} });\n307\t  } finally {\n308\t    await cleanupRepo(repo);\n309\t    await cleanupDir(dir);\n310\t  }\n311\t});\n312\t\n313\ttest(\"captureCodexTranscript: a secret inside an unrecognized line is redacted in raw\", async () => {\n314\t  const repo = await makeTempRepo(\"cledger-codex-drift-secret-\");\n315\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-secret-\"));\n316\t  try {\n317\t    await makeCommit(repo, \"init\");\n318\t    const path = join(dir, FILENAME);\n319\t    const secret = \"ghp_\" + \"a\".repeat(36);\n320\t    const lines = [\n321\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n322\t      {\n323\t        type: \"response_item\",\n324\t        timestamp: \"2026-01-01T00:00:03.000Z\",\n325\t        payload: { type: \"holo_call\", token: secret },\n326\t      },\n327\t    ];\n328\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n329\t\n330\t    await captureCodexTranscript(path, repo.root);\n331\t    const events = await readEvents(repo);\n332\t    const preserved = events.find((e) => e.kind === \"unrecognized\")!;\n333\t    const serialized = JSON.stringify(preserved);\n334\t    assert.ok(!serialized.includes(secret), \"secret must not survive in the preserved event\");\n335\t    assert.ok(serialized.includes(\"[REDACTED:\"), \"secret must be replaced with a redaction placeholder\");\n336\t    assert.ok((preserved.redactions ?? []).length > 0, \"a redaction record must be attached\");\n337\t  } finally {\n338\t    await cleanupRepo(repo);\n339\t    await cleanupDir(dir);\n340\t  }\n341\t});\n342\t\n343\ttest(\"captureCodexTranscript: agent_message keeps visible text, drops encrypted blocks everywhere\", async () => {\n344\t  const repo = await makeTempRepo(\"cledger-codex-agentmsg-\");\n345\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-agentmsg-\"));\n346\t  try {\n347\t    await makeCommit(repo, \"init\");\n348\t    const path = join(dir, FILENAME);\n349\t    const lines = [\n350\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n351\t      {\n352\t        type: \"response_item\",\n353\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n354\t        payload: {\n355\t          type: \"agent_message\",\n356\t          author: \"/root\",\n357\t          recipient: \"/root/subagent\",\n358\t          content: [\n359\t            { type: \"input_text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" },\n360\t            { type: \"encrypted_content\", encrypted_content: \"gAAAAAB-opaque-blob-must-never-be-stored\" },\n361\t          ],\n362\t        },\n363\t      },\n364\t    ];\n365\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n366\t\n367\t    const result = await captureCodexTranscript(path, repo.root);\n368\t    assert.strictEqual(result.appended, 1);\n369\t    assert.deepStrictEqual(result.unrecognized, {}, \"agent_message is a recognized type now\");\n370\t\n371\t    const events = await readEvents(repo);\n372\t    const e = events[0]!;\n373\t    assert.strictEqual(e.actor.type, \"agent\");\n374\t    assert.strictEqual(e.actor.id, \"/root\");\n375\t    assert.deepStrictEqual(e.content, {\n376\t      role: \"agent_message\",\n377\t      author: \"/root\",\n378\t      recipient: \"/root/subagent\",\n379\t      blocks: [{ type: \"text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" }],\n380\t    });\n381\t\n382\t    // The encrypted payload must be gone from the event wholesale — content\n383\t    // and raw alike — leaving only the bare type marker in raw.\n384\t    const serialized = JSON.stringify(e);\n385\t    assert.ok(!serialized.includes(\"opaque-blob\"), \"encrypted content must never be stored\");\n386\t    const rawContent = ((e.raw?.data as { payload?: { content?: unknown[] } }).payload?.content) ?? [];\n387\t    assert.deepStrictEqual(rawContent[1], { type: \"encrypted_content\" });\n388\t    assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n389\t  } finally {\n390\t    await cleanupRepo(repo);\n391\t    await cleanupDir(dir);\n392\t  }\n393\t});\n394\t","tool_use_id":"toolu_01UFmSUsgYiC2UrHCEj5ZZK1","type":"tool_result"}],"role":"user"},"parentUuid":"db95aa2f-fc36-47c9-8999-99185b22a8ec","promptId":"7112bb84-3e3c-455e-ab6a-003e9ffb26f7","sessionId":"cef69ec2-8b5a-4e91-8078-ac955e039295","sessionKind":"bg","session_id":"cef69ec2-8b5a-4e91-8078-ac955e039295","sourceToolAssistantUUID":"db95aa2f-fc36-47c9-8999-99185b22a8ec","timestamp":"2026-07-27T06:54:27.018Z","toolUseResult":{"file":{"content":"import { test } from \"node:test\";\nimport assert from \"node:assert\";\nimport { mkdtemp, writeFile, appendFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { captureCodexTranscript } from \"../adapters/codex.js\";\nimport { readEvents } from \"../store.js\";\nimport { cleanupDir, cleanupRepo, makeCommit, makeTempRepo } from \"./helpers.js\";\n\nconst SESSION_ID = \"codex-sess-1\";\n// Filename carries a base timestamp + a uuid the sessionIdFromFilename regex\n// can extract; the session_meta line (index 0) then overrides the id, which\n// is the more common real-world case and worth exercising too.\nconst FILENAME = \"rollout-2026-01-01T00-00-00-123e4567-e89b-12d3-a456-426614174000.jsonl\";\n\n/** Index 0 is session_meta (not a response_item, dropped); 1-4 are real\n * content; 5 is a reasoning item (preserved opaquely as a `reasoning` event,\n * never as a conversation_turn); 6 is a truncated trailing line that must be\n * tolerated. */\nfunction rolloutLines(): unknown[] {\n  return [\n    { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n    {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:01.000Z\",\n      payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"Please run tests\" }] },\n    },\n    {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:02.000Z\",\n      payload: {\n        type: \"message\",\n        role: \"assistant\",\n        content: [{ type: \"output_text\", text: \"Sure, running now.\" }],\n      },\n    },\n    {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:03.000Z\",\n      payload: { type: \"function_call\", name: \"shell\", arguments: { command: \"pytest\" }, call_id: \"call_9\" },\n    },\n    {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:04.000Z\",\n      payload: { type: \"function_call_output\", call_id: \"call_9\", output: \"5 passed\" },\n    },\n    {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:05.000Z\",\n      payload: { type: \"reasoning\", encrypted_content: \"opaque-blob-must-never-be-stored\" },\n    },\n  ];\n}\n\nasync function writeRollout(dir: string): Promise<string> {\n  const path = join(dir, FILENAME);\n  const lines = rolloutLines().map((l) => JSON.stringify(l));\n  lines.push('{\"type\":\"response_item\",\"payload\":{\"type\":\"message\"');\n  await writeFile(path, lines.join(\"\\n\") + \"\\n\");\n  return path;\n}\n\ntest(\"captureCodexTranscript: converts a synthetic rollout end to end\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-\");\n  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const rolloutPath = await writeRollout(rolloutDir);\n\n    await captureCodexTranscript(rolloutPath, repo.root);\n\n    const events = await readEvents(repo);\n    assert.strictEqual(\n      events.length,\n      5,\n      \"session_meta and the malformed trailing line must be dropped; reasoning is preserved opaquely\",\n    );\n\n    for (const e of events) {\n      assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n      assert.strictEqual(e.conversation?.id, `codex:${SESSION_ID}`);\n      assert.strictEqual(e.producer.source, \"codex\");\n      assert.strictEqual(\n        e.producer.session_id,\n        SESSION_ID,\n        \"session_meta's session_id must override the filename-derived id\",\n      );\n    }\n\n    // seq must equal the original line index (session_meta occupies index 0).\n    const bySeq = new Map(events.map((e) => [e.conversation!.seq, e]));\n    assert.deepStrictEqual([...bySeq.keys()].sort((a, b) => a - b), [1, 2, 3, 4, 5]);\n\n    const userMsg = bySeq.get(1)!;\n    assert.strictEqual(userMsg.actor.type, \"human\");\n    assert.strictEqual(userMsg.actor.id, \"test@example.com\");\n    assert.strictEqual(userMsg.actor.display, \"Test User\");\n    assert.deepStrictEqual(userMsg.content, {\n      role: \"user\",\n      blocks: [{ type: \"text\", text: \"Please run tests\" }],\n    });\n    assert.strictEqual(userMsg.occurred_at, \"2026-01-01T00:00:01.000Z\");\n\n    const assistantMsg = bySeq.get(2)!;\n    assert.strictEqual(assistantMsg.actor.type, \"agent\");\n    assert.deepStrictEqual(assistantMsg.content, {\n      role: \"assistant\",\n      blocks: [{ type: \"text\", text: \"Sure, running now.\" }],\n    });\n\n    const functionCall = bySeq.get(3)!;\n    assert.strictEqual(functionCall.actor.type, \"agent\");\n    assert.deepStrictEqual(functionCall.content, {\n      role: \"assistant\",\n      blocks: [{ type: \"tool_use\", name: \"shell\", input: { command: \"pytest\" }, id: \"call_9\" }],\n    });\n\n    const functionCallOutput = bySeq.get(4)!;\n    assert.strictEqual(functionCallOutput.actor.type, \"system\");\n    assert.deepStrictEqual(functionCallOutput.content, {\n      role: \"tool_result\",\n      blocks: [{ type: \"tool_result\", tool_use_id: \"call_9\", content: \"5 passed\" }],\n    });\n\n    const reasoning = bySeq.get(5)!;\n    assert.strictEqual(reasoning.kind, \"reasoning\");\n    assert.strictEqual(reasoning.actor.type, \"agent\");\n    assert.deepStrictEqual(reasoning.content, { opaque: true });\n    assert.strictEqual(\n      (reasoning.raw!.data as { payload?: { encrypted_content?: string } }).payload?.encrypted_content,\n      \"opaque-blob-must-never-be-stored\",\n      \"the ciphertext itself lives only in raw.data, never in content\",\n    );\n    assert.ok(\n      !JSON.stringify(reasoning.content).includes(\"opaque-blob\"),\n      \"the blob must never leak into the visible content field\",\n    );\n\n    // --- Rerun on the unchanged rollout: cursor is past EOF, no new events. ---\n    await captureCodexTranscript(rolloutPath, repo.root);\n    const eventsAfterRerun = await readEvents(repo);\n    assert.strictEqual(eventsAfterRerun.length, 5, \"rerun on unchanged rollout must not duplicate\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(rolloutDir);\n  }\n});\n\ntest(\"captureCodexTranscript: reasoning items are preserved opaquely, never as a conversation_turn\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-reasoning-\");\n  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-reasoning-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const rolloutPath = await writeRollout(rolloutDir);\n    await captureCodexTranscript(rolloutPath, repo.root);\n    const events = await readEvents(repo);\n    const reasoningEvents = events.filter((e) => e.kind === \"reasoning\");\n    assert.strictEqual(reasoningEvents.length, 1);\n    for (const e of events) {\n      if (e.kind === \"reasoning\") continue;\n      assert.notStrictEqual(\n        (e.raw?.data as { payload?: { type?: string } })?.payload?.type,\n        \"reasoning\",\n        \"reasoning payloads must never surface as a conversation_turn or unrecognized event\",\n      );\n    }\n\n    // Reprocessing the same rollout must dedup, not duplicate the opaque event.\n    await captureCodexTranscript(rolloutPath, repo.root);\n    const afterRerun = (await readEvents(repo)).filter((e) => e.kind === \"reasoning\");\n    assert.strictEqual(afterRerun.length, 1);\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(rolloutDir);\n  }\n});\n\ntest(\"captureCodexTranscript: a populated reasoning summary becomes a visible conversation_turn alongside the opaque event\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-reasoning-summary-\");\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-reasoning-summary-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const path = join(dir, FILENAME);\n    const lines = [\n      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n      {\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:01.000Z\",\n        payload: {\n          type: \"reasoning\",\n          encrypted_content: \"opaque-blob-must-never-be-stored\",\n          summary: [\n            { type: \"summary_text\", text: \"Considering the test suite.\" },\n            { type: \"summary_text\", text: \"Deciding to run pytest.\" },\n          ],\n        },\n      },\n    ];\n    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n\n    const result = await captureCodexTranscript(path, repo.root);\n    assert.strictEqual(result.appended, 2, \"one visible turn plus one opaque reasoning event\");\n\n    const events = await readEvents(repo);\n    const visible = events.find((e) => e.kind === \"conversation_turn\")!;\n    const opaque = events.find((e) => e.kind === \"reasoning\")!;\n    assert.ok(visible, \"the summary must surface as an ordinary conversation_turn\");\n    assert.ok(opaque);\n    assert.strictEqual(visible.conversation?.seq, opaque.conversation?.seq, \"same source line, same seq\");\n    assert.deepStrictEqual(visible.content, {\n      role: \"reasoning_summary\",\n      blocks: [{ type: \"text\", text: \"Considering the test suite.\\n\\nDeciding to run pytest.\" }],\n    });\n    assert.deepStrictEqual(opaque.content, { opaque: true });\n    const serialized = JSON.stringify(visible);\n    assert.ok(!serialized.includes(\"opaque-blob\"), \"the ciphertext must never leak into the visible turn\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(dir);\n  }\n});\n\ntest(\"captureCodexTranscript: a later capture only ingests newly appended lines\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-growth-\");\n  const rolloutDir = await mkdtemp(join(tmpdir(), \"cledger-codex-transcript-growth-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const rolloutPath = await writeRollout(rolloutDir);\n    await captureCodexTranscript(rolloutPath, repo.root);\n    assert.strictEqual((await readEvents(repo)).length, 5);\n\n    await appendFile(\n      rolloutPath,\n      JSON.stringify({\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:10.000Z\",\n        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"one more turn\" }] },\n      }) + \"\\n\",\n    );\n    await captureCodexTranscript(rolloutPath, repo.root);\n\n    const events = await readEvents(repo);\n    assert.strictEqual(events.length, 6, \"only the newly appended line should be added\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(rolloutDir);\n  }\n});\n\ntest(\"captureCodexTranscript: unrecognized line and payload types are counted for drift\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-drift-\");\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const path = join(dir, FILENAME);\n    const lines = [\n      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n      {\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:01.000Z\",\n        payload: { type: \"message\", role: \"user\", content: [{ type: \"input_text\", text: \"hi\" }] },\n      },\n      // Recognized-but-opaque: reasoning payloads become a reasoning event,\n      // not drift. Known-skipped: bookkeeping line types.\n      { type: \"response_item\", timestamp: \"2026-01-01T00:00:02.000Z\", payload: { type: \"reasoning\" } },\n      { type: \"turn_context\", payload: {} },\n      // Drift: a payload type and a line type this adapter has never seen.\n      {\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:03.000Z\",\n        payload: { type: \"holo_call\", text: \"future content kind\" },\n      },\n      { type: \"brand_new_line_kind\", payload: {} },\n    ];\n    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n\n    const result = await captureCodexTranscript(path, repo.root);\n    // 1 interpreted message + 1 opaque reasoning event + 2 raw-only preservation events for the drift lines.\n    assert.strictEqual(result.appended, 4);\n    assert.deepStrictEqual(result.unrecognized, {\n      \"response_item/holo_call\": 1,\n      brand_new_line_kind: 1,\n    });\n\n    // The unrecognized lines are preserved raw-only, not dropped.\n    const events = await readEvents(repo);\n    const preserved = events\n      .filter((e) => e.kind === \"unrecognized\")\n      .sort((a, b) => (a.conversation!.seq - b.conversation!.seq));\n    assert.strictEqual(preserved.length, 2);\n\n    const holo = preserved[0]!;\n    assert.strictEqual(holo.actor.type, \"system\");\n    assert.deepStrictEqual(holo.content, { unrecognized_type: \"response_item/holo_call\" });\n    assert.strictEqual(holo.raw!.format, \"codex-rollout-jsonl/2\");\n    // Full source line retained under raw.data for later re-normalization.\n    assert.deepStrictEqual(holo.raw!.data, {\n      type: \"response_item\",\n      timestamp: \"2026-01-01T00:00:03.000Z\",\n      payload: { type: \"holo_call\", text: \"future content kind\" },\n    });\n    assert.strictEqual(holo.occurred_at, \"2026-01-01T00:00:03.000Z\");\n\n    const brandNew = preserved[1]!;\n    assert.deepStrictEqual(brandNew.content, { unrecognized_type: \"brand_new_line_kind\" });\n    assert.deepStrictEqual(brandNew.raw!.data, { type: \"brand_new_line_kind\", payload: {} });\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(dir);\n  }\n});\n\ntest(\"captureCodexTranscript: a secret inside an unrecognized line is redacted in raw\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-drift-secret-\");\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-drift-secret-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const path = join(dir, FILENAME);\n    const secret = \"ghp_\" + \"a\".repeat(36);\n    const lines = [\n      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n      {\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:03.000Z\",\n        payload: { type: \"holo_call\", token: secret },\n      },\n    ];\n    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n\n    await captureCodexTranscript(path, repo.root);\n    const events = await readEvents(repo);\n    const preserved = events.find((e) => e.kind === \"unrecognized\")!;\n    const serialized = JSON.stringify(preserved);\n    assert.ok(!serialized.includes(secret), \"secret must not survive in the preserved event\");\n    assert.ok(serialized.includes(\"[REDACTED:\"), \"secret must be replaced with a redaction placeholder\");\n    assert.ok((preserved.redactions ?? []).length > 0, \"a redaction record must be attached\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(dir);\n  }\n});\n\ntest(\"captureCodexTranscript: agent_message keeps visible text, drops encrypted blocks everywhere\", async () => {\n  const repo = await makeTempRepo(\"cledger-codex-agentmsg-\");\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-agentmsg-\"));\n  try {\n    await makeCommit(repo, \"init\");\n    const path = join(dir, FILENAME);\n    const lines = [\n      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n      {\n        type: \"response_item\",\n        timestamp: \"2026-01-01T00:00:01.000Z\",\n        payload: {\n          type: \"agent_message\",\n          author: \"/root\",\n          recipient: \"/root/subagent\",\n          content: [\n            { type: \"input_text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" },\n            { type: \"encrypted_content\", encrypted_content: \"gAAAAAB-opaque-blob-must-never-be-stored\" },\n          ],\n        },\n      },\n    ];\n    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n\n    const result = await captureCodexTranscript(path, repo.root);\n    assert.strictEqual(result.appended, 1);\n    assert.deepStrictEqual(result.unrecognized, {}, \"agent_message is a recognized type now\");\n\n    const events = await readEvents(repo);\n    const e = events[0]!;\n    assert.strictEqual(e.actor.type, \"agent\");\n    assert.strictEqual(e.actor.id, \"/root\");\n    assert.deepStrictEqual(e.content, {\n      role: \"agent_message\",\n      author: \"/root\",\n      recipient: \"/root/subagent\",\n      blocks: [{ type: \"text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" }],\n    });\n\n    // The encrypted payload must be gone from the event wholesale — content\n    // and raw alike — leaving only the bare type marker in raw.\n    const serialized = JSON.stringify(e);\n    assert.ok(!serialized.includes(\"opaque-blob\"), \"encrypted content must never be stored\");\n    const rawContent = ((e.raw?.data as { payload?: { content?: unknown[] } }).payload?.content) ?? [];\n    assert.deepStrictEqual(rawContent[1], { type: \"encrypted_content\" });\n    assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(dir);\n  }\n});\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/producer-metadata/src/test/adapter-codex.test.ts","numLines":394,"startLine":1,"totalLines":394},"type":"text"},"type":"user","userType":"external","uuid":"ab966ea4-ddbd-4f4a-ba69-004ac5e2ea16","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-07-27T07:19:34.700Z","schema":"conversation-ledger/v1"}
