ime;\n374\t    if (type === \"response_item\") {\n375\t      const payloadType = parsed.payload?.[\"type\"];\n376\t      const pt = typeof payloadType === \"string\" ? payloadType : \"(untyped)\";\n377\t      if (pt === \"reasoning\") {\n378\t        const summaryText = reasoningSummaryText(parsed.payload?.[\"summary\"]);\n379\t        if (summaryText) {\n380\t          // Visible half: a normal conversation_turn, shown in log/show like\n381\t          // any other turn. Same seq as the sibling opaque event below —\n382\t          // distinct kinds keep their ids from colliding.\n383\t          drafts.push({\n384\t            kind: \"conversation_turn\",\n385\t            occurred_at: occurredAt,\n386\t            actor: { type: \"agent\" },\n387\t            producer: { tool: \"cledger\", version, source: \"codex\", session_id: sessionId },\n388\t            conversation: { id: `codex:${sessionId}`, seq: i },\n389\t            content: { role: \"reasoning_summary\", blocks: [{ type: \"text\", text: summaryText }] },\n390\t          });\n391\t        }\n392\t        drafts.push(\n393\t          reasoningDraft({\n394\t            line: parsed,\n395\t            occurredAt,\n396\t            source: \"codex\",\n397\t            sessionId,\n398\t            seq: i,\n399\t            version,\n400\t            rawFormat: RAW_FORMAT,\n401\t            conversationId: `codex:${sessionId}`,\n402\t          }),\n403\t        );\n404\t        continue;\n405\t      }\n406\t      if (!CONVERTIBLE_RESPONSE_TYPES.has(pt)) {\n407\t        const typeKey = `response_item/${pt}`;\n408\t        countUnrecognized(result.unrecognized, typeKey);\n409\t        drafts.push(preserve(typeKey, parsed, occurredAt, i, sessionId, version));\n410\t        continue;\n411\t      }\n412\t    } else if (!KNOWN_SKIPPED_LINE_TYPES.has(type)) {\n413\t      countUnrecognized(result.unrecognized, type);\n414\t      drafts.push(preserve(type, parsed, occurredAt, i, sessionId, version));\n415\t      contin