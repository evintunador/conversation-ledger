{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n2\timport type { RedactionRecord } from \"./redact/apply.js\";\n3\t\n4\texport const SCHEMA_VERSION = \"conversation-ledger/v1\";\n5\t\n6\t/**\n7\t * The well-known event kinds. `kind` is an open string so downstream tools\n8\t * can extend the ledger without a schema release; unknown kinds are stored\n9\t * verbatim. The ledger never interprets content, whatever the kind.\n10\t *\n11\t * `unrecognized` is the one kind the ledger emits for content it could *not*\n12\t * interpret: an adapter that meets a transcript line type it has no mapping\n13\t * for preserves the line raw-only under `raw.data` rather than dropping it,\n14\t * so a later adapter version can re-normalize (and supersede) it. Its\n15\t * `content` carries only a `{unrecognized_type}` label — the payload lives in\n16\t * `raw` — but identity still separates distinct lines via `conversation.seq`.\n17\t *\n18\t * `reasoning` is for content the ledger deliberately never interprets: a\n19\t * provider-encrypted reasoning/thinking blob (e.g. Codex's `reasoning`\n20\t * response_items) that only the originating provider can decrypt. Its\n21\t * `content` carries only an opacity marker; the ciphertext lives in `raw`,\n22\t * for a consumer to opt into replaying back through the same provider.\n23\t * Unlike `unrecognized`, this is not a placeholder awaiting a smarter\n24\t * cledger version — no future version will ever be able to read it either.\n25\t */\n26\texport const KNOWN_KINDS = [\n27\t  \"conversation_turn\",\n28\t  \"decision\",\n29\t  \"document\",\n30\t  \"annotation\",\n31\t  \"redaction\",\n32\t  \"supersession\",\n33\t  \"re_anchor\",\n34\t  \"unrecognized\",\n35\t  \"reasoning\",\n36\t] as const;\n37\t\n38\texport interface Actor {\n39\t  /** \"human\" | \"agent\" | \"system\" */\n40\t  type: string;\n41\t  /** Stab