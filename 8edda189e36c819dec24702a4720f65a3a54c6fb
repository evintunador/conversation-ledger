,\n200\t    version,\n201\t    rawFormat: RAW_FORMAT,\n202\t    conversationId: `codex:${sessionId}`,\n203\t  });\n204\t}\n205\t\n206\tfunction convertLine(\n207\t  line: CodexRolloutLine,\n208\t  seq: number,\n209\t  sessionId: string,\n210\t  baseTime: string,\n211\t  version: string,\n212\t  identity: GitUserIdentity,\n213\t): EventDraft | null {\n214\t  if (line.type !== \"response_item\") return null;\n215\t  const payload = line.payload;\n216\t  if (!payload) return null;\n217\t  const payloadType = payload[\"type\"];\n218\t  // reasoning items never reach here — the capture loop diverts them to\n219\t  // reasoningDraft before calling convertLine.\n220\t  if (typeof payloadType !== \"string\" || !CONVERTIBLE_RESPONSE_TYPES.has(payloadType)) return null;\n221\t\n222\t  const occurredAt = typeof line.timestamp === \"string\" ? line.timestamp : baseTime;\n223\t\n224\t  let actor: Actor;\n225\t  let content: { role: string; blocks: unknown[] };\n226\t\n227\t  if (payloadType === \"message\") {\n228\t    const role = payload[\"role\"];\n229\t    const roleStr = typeof role === \"string\" ? role : \"user\";\n230\t    actor = roleStr === \"assistant\" ? { type: \"agent\" } : { type: \"human\" };\n231\t    if (actor.type === \"human\") {\n232\t      if (identity.email) actor.id = identity.email;\n233\t      if (identity.name) actor.display = identity.name;\n234\t    }\n235\t    content = { role: roleStr, blocks: convertMessageBlocks(payload[\"content\"]) };\n236\t  } else if (payloadType === \"agent_message\") {\n237\t    actor = { type: \"agent\" };\n238\t    if (typeof payload[\"author\"] === \"string\") actor.id = payload[\"author\"];\n239\t    const rawBlocks = payload[\"content\"];\n240\t    const visible = Array.isArray(rawBlocks) ? rawBlocks.filter((b) => !isEncryptedBlock(b)) : [];\n241\t    content = {\n242\t      role: \"agent_message\",\n243\t      ...(typeof payload[\"author\"] === \"string\" ? { author: payload[\"author\"] } : {}),\n244\t      ...(typeof payload[\"recipient\"] === \"string\" ? { recipient: payload[\"recipient\"] } : {}),\n245\t      blocks: convertMessageBlocks(visible),\n246\t    } as { role: string; blocks: unknown[] };\n247\t  } else if (payloadType === \"function_call\" || payloadType === \"custom_tool_call\") {\n248\t    actor = { type: \"agent\" };\n249\t    const block: Record<string, unknown> = { type: \"tool_use\" };\n250\t    if (typeof payload[\"name\"] === \"string\") block[\"name\"] = payload[\"name\"];\n251\t    const input = payload[\"arguments\"] ?? payload[\"input\"];\n252\t    if (input !== undefined) block[\"input\"] = input;\n253\t    if (typeof payload[\"call_id\"] === \"string\") block[\"id\"] = payload[\"call_id\"];\n254\t    content = { role: \"assistant\", blocks: [block] };\n255\t  } else {\n256\t    // function_call_output / custom_tool_call_output\n257\t    actor = { type: \"system\" };\n258\t    content = {\n259\t      role: \"tool_result\",\n260\t      blocks: [{ type: \"tool_result\", tool_use_id: payload[\"call_id\"], content: payload[\"output\"] }],\n261\t    };\n262\t  }\n263\t\n264\t  return {\n265\t    kind: \"conversation_turn\",\n266\t    occurred_at: occurredAt,\n267\t    actor,\n268\t    producer: { tool: \"cledger\", version, source: \"codex\", session_id: sessionId },\n269\t    conversation: { id: `codex:${sessionId}`, seq },\n270\t    content,\n271\t    // /2: agent_message payloads convert (encrypted blocks omitted) — /1 dropped them.\n272\t    raw: {\n273\t      format: RAW_FORMAT,\n274\t      data: payloadType === \"agent_message\" ? sanitizeAgentMessageRaw(line) : line,\n275\t    },\n276\t  };\n277\t}\n278\t\n279\t/**\n280\t * Re-normalization hook (see renormalize.ts): given a preserved\n281\t * `unrecognized` event this adapter's `producer.source` owns, try to turn its\n282\t * stored `raw.data` into the `conversation_turn` a live capture would produce.\n283\t *\n284\t * Id fidelity is the whole point (see the claude-code twin for the general\n285\t * argument). Two codex-specific inputs are not derivable from the line alone\n286\t * and are recovered from the preserved event: the session id lives in\n287\t * `producer.session_id`, and the `baseTime` fallback (used only when the line\n288\t * carries no timestamp of its own) is the preserved event's `occurred_at` —\n289\t * which is exactly the value the preservation path computed via\n290\t * `sessionBaseTime`, i.e. what a live capture of the same rollout file would\n291\t * compute too. `reasoning` payloads are never preserved as `unrecognized` in\n292\t * the first place (they get their own `reasoning`-kind event instead), so\n293\t * this path never reconstructs provider-withheld content into a visible\n294\t * `conversation_turn`. Returns null when still uninterpretable.\n295\t */\n296\texport function renormalizeUnrecognized(\n297\t  event: EvidenceEvent,\n298\t  identity: GitUserIdentity,\n299\t): EventDraft | null {\n300\t  if (!event.raw || event.conversation === undefined) return null;\n301\t  const line = event.raw.data as CodexRolloutLine;\n302\t  const sessionId = event.producer.session_id ?? \"\";\n303\t  return convertLine(\n304\t    line,\n305\t    event.conversation.seq,\n306\t    sessionId,\n307\t    event.occurred_at,\n308\t    packageVersion(),\n309\t    identity,\n310\t  );\n311\t}\n312\t\n313\texport async function runCodexHook(stdinJson: string): Promise<void> {\n314\t  try {\n315\t    const payload = JSON.parse(stdinJson) as CodexHookPayload;\n316\t    const cwd = payload.cwd ?? process.cwd();\n317\t    if (!payload.transcript_path) return;\n318\t    const repo = await findRepo(cwd);\n319\t    if (!repo) return; // hooks must never break the user's session outside a repo\n320\t    await captureCodexTranscript(payload.transcript_path, cwd);\n321\t  } catch (err) {\n322\t    process.stderr.write(\n323\t      `cledger: codex hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n324\t    );\n325\t  }\n326\t}\n327\t\n328\texpo