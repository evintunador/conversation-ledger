t never touch this\n * project's own repo.\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { mkdtemp, rm } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { git, findRepo, type RepoInfo } from \"../git.js\";\nimport { finalizeEvent, type EventDraft, type EvidenceEvent } from \"../schema.js\";\n\n/**\n * Isolate every test process from the developer's real home directory.\n *\n * loadConfig() reads user-level config at `~/.config/cledger/config.json` via\n * os.homedir() (which honors $HOME on POSIX), so a developer who has, say,\n * `redact.knownSecrets` enabled globally would silently change test behavior\n * — tests asserting *default* behavior would exercise an opt-in layer and\n * fail, and worse, tests could pass or fail depending on whose machine ran\n * them. The node test runner gives each test *file* its own process, so\n * setting HOME at module load is safe and scoped to that file.\n */\nconst ISOLATED_HOME = mkdtempSync(join(tmpdir(), \"cledger-test-home-\"));\nprocess.env.HOME = ISOLATED_HOME;\nprocess.on(\"exit\", () => {\n  try {\n    rmSync(ISOLATED_HOME, { recursive: true, force: true });\n  } catch {\n    /* best effort */\n  }\n});\n\n/** Create a fresh repo under the OS temp dir, with local git identity set. */\nexport async function makeTempRepo(prefix = \"cledger-test-\"): Promise<RepoInfo> {\n  const dir = await mkdtemp(join(tmpdir(), prefix));\n  await git([\"init\", \"-q\", \"-b\", \"main\"], { cwd: dir });\n  await git([\"config\", \"user.email\", \"test@example.com\"], { cwd: dir });\n  await git([\"config\", \"user.name\", \"Test User\"], { cwd: dir });\n  await git([\"config\", \"commit.gpgsign\", \"false\"], { cwd: dir });\n  const repo = await findRepo(dir);\n  if (!repo) throw new Error(\"failed to initialize temp repo\");\n  return repo;\n}\n\n/** Create a bare repo under the OS temp dir, for use as a sync remote. */\nexport async function makeBareRepo(prefix = \"cledger-remote-\"): Promise<string> {\n  const dir = await mkdtemp(join(tmpdir(), prefix));\n  await git([\"init\", \"-q\", \"--bare\", \"-b\", \"main\"], { cwd: dir });\n  return dir;\n}\n\n/** Recursively remove a temp repo/dir. Safe no-op if already gone. */\nexport async function cleanupDir(dir: string): Promise<void> {\n  await rm(dir, { recursive: true, force: true });\n}\n\nexport async function cleanupRepo(repo: RepoInfo): Promise<void> {\n  await cleanupDir(repo.root);\n}\n\n/** Create a commit (empty by default) and return its SHA. */\nexport async function makeCommit(repo: RepoInfo, message = \"commit\"): Promise<string> {\n  await git([\"commit\", \"--allow-empty\", \"-q\", \"-m\", message], { cwd: repo.root });\n  return (await git([\"rev-parse\", \"HEAD\"], { cwd: repo.root })).trim();\n}\n\n/** Build a minimal, valid EventDraft with sensible defaults, override at will. */\nexport function draft(overrides: Partial<EventDraft> = {}): EventDraft {\n  const base: EventDraft = {\n    kind: \"conversation_turn\",\n    occurred_at: \"2026-01-01T00:00:00.000Z\",\n    actor: { type: \"human\" },\n    producer: { tool: \"cledger\" },\n    content: { text: \"hello\" },\n  };\n  return { ...base, ...overrides };\n}\n\n/** Build a fully finalized event from overrides (id/schema/recorded_at auto-filled). */\nexport function event(overrides: Partial<EventDraft> = {}, now?: Date): EvidenceEvent {\n  return finalizeEvent(draft(overrides), now);\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/redaction-pre-push-only/src/test/helpers.ts","numLines":86,"startLine":1,"totalLines":86},"type":"text"},"type":"user","userType":"external","uuid":"f13c09aa-f82d-4bed-aa50-c5e246a3067c","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-03T03:28:53.998Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { git } from \"../git.js\";\n4\timport {\n5\t  appendEvents,\n6\t  listAnchors,\n7\t  NOTES_REF,\n8\t  readEvents,\n9\t  readNoteEvents,\n10\t  readPending,\n11\t  redactEvent,\n12\t  sync,\n13\t} from \"../store.js\";\n14\timport {\n15\t  cleanupDir,\n16\t  cleanupRepo,\n17\t  draft,\n18\t  makeBareRepo,\n19\t  makeCommit,\n20\t  makeTempRepo,\n21\t} from \"./helpers.js\";\n22\t\n23\ttest(\"redactEvent: --pattern rewrites content+raw, preserves the id, appends a redacts companion, and squashes local history\", async () => {\n24\t  const repo = await makeTempRepo();\n25\t  try {\n26\t    await makeCommit(repo, \"init\");\n27\t    const secret = \"hunter2xK9aa\"; // format the capture-tier ruleset does not recognize\n28\t    const originalDraft = draft({\n29\t      content: { text: `db_password: ${secret}` },\n30\t      raw: { format: \"test/1\", data: { blob: `db_password: ${secret}` } },\n31\t    });\n32\t    const appendResult = await appendEvents(repo, [originalDraft]);\n33\t    assert.strictEqual(appendResult.appended.length, 1);\n34\t    const original = appendResult.appended[0]!;\n35\t    assert.ok(\n36\t      JSON.stringify(original).includes(secret),\n37\t      \"sanity: this secret shape must survive capture-tier redaction unredacted\",\n38\t    );\n39\t\n40\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret, reason: \"test-reason\" });\n41\t\n42\t    // Id preservation is the crux of the whole mechanism: rewriting the\n43\t    // content must not change the event's id (see the CRITICAL comment in\n44\t    // store.ts) or a later rescan would resurrect the secret under the old\n45\t    // id.\n46\t    assert.strictEqual(result.event.id, original.id);\n47\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n48\t    assert.ok(!JSON.stringify(result.event.raw ?? {}).includes(secret));\n49\t    assert.ok(result.event.redactions?.some((r) => r.rule === \"manual\"));\n50\t\n51\t    // Companion event.\n52\t    assert.strictEqual(result.redactionEvent.kind, \"redaction\");\n53\t    assert.deepStrictEqual(result.redactionEvent.links, [{ rel: \"redacts\", target: original.id }]);\n54\t    const companionContent = result.redactionEvent.content as {\n55\t      target: string;\n56\t      mode: string;\n57\t      reason?: string;\n58\t    };\n59\t    assert.strictEqual(companionContent.target, original.id);\n60\t    assert.strictEqual(companionContent.mode, \"pattern\");\n61\t    assert.strictEqual(companionContent.reason, \"test-reason\");\n62\t\n63\t    // The stored note itself reflects the rewrite, not just the returned object.\n64\t    const [anchor] = await listAnchors(repo);\n65\t    assert.ok(anchor);\n66\t    const stored = await readNoteEvents(repo, anchor);\n67\t    const storedTarget = stored.find((e) => e.id === original.id);\n68\t    assert.ok(storedTarget);\n69\t    assert.ok(!JSON.stringify(storedTarget).includes(secret));\n70\t\n71\t    // No remote configured: local notes history is squashed to one commit.\n72\t    assert.strictEqual(result.squashed, true);\n73\t    const log = await git([\"log\", \"--oneline\", NOTES_REF], { cwd: repo.root });\n74\t    assert.strictEqual(log.trim().split(\"\\n\").filter(Boolean).length, 1);\n75\t\n76\t    // THE dedup test: re-appending the exact original, unredacted draft\n77\t    // must not resurrect the secret under a new event. Because the\n78\t    // rewritten event kept the original id, recomputing the id for the\n79\t    // same source draft collides with the id already on record (which now\n80\t    // holds redacted content), so it dedups instead of creating a second,\n81\t    // unredacted copy.\n82\t    const rescan = await appendEvents(repo, [originalDraft]);\n83\t    assert.strictEqual(rescan.appended.length, 0, \"the secret must not be able to sneak back in via rescan\");\n84\t    assert.strictEqual(rescan.deduped, 1);\n85\t\n86\t    const eventsAfterRescan = await readEvents(repo);\n87\t    const copiesOfTarget = eventsAfterRescan.filter((e) => e.id === original.id);\n88\t    assert.strictEqual(copiesOfTarget.length, 1, \"must still be exactly one copy of the event under this id\");\n89\t    assert.ok(!JSON.stringify(copiesOfTarget[0]).includes(secret));\n90\t  } finally {\n91\t    await cleanupRepo(repo);\n92\t  }\n93\t});\n94\t\n95\ttest(\"redactEvent: --all replaces content with a placeholder and drops raw entirely\", async () => {\n96\t  const repo = await makeTempRepo();\n97\t  try {\n98\t    await makeCommit(repo, \"init\");\n99\t    const secret = \"hunter2xK9aa\";\n100\t    const appendResult = await appendEvents(repo, [\n101\t      draft({\n102\t        content: { text: `db_password: ${secret}` },\n103\t        raw: { format: \"test/1\", data: { blob: `db_password: ${secret}` } },\n104\t      }),\n105\t    ]);\n106\t    const original = appendResult.appended[0]!;\n107\t\n108\t    const result = await redactEvent(repo, original.id.slice(4, 12), { all: true });\n109\t\n110\t    assert.strictEqual(result.event.id, original.id);\n111\t    assert.strictEqual(typeof result.event.content, \"string\");\n112\t    assert.match(result.event.content as string, /^\\[REDACTED:manual:[0-9a-f]{12}\\]$/);\n113\t    assert.strictEqual(result.event.raw, undefined);\n114\t    assert.strictEqual(result.squashed, true);\n115\t  } finally {\n116\t    await cleanupRepo(repo);\n117\t  }\n118\t});\n119\t\n120\ttest(\"redactEvent: pending-queue redaction works before the first commit exists, no squash needed\", async () => {\n121\t  const repo = await makeTempRepo();\n122\t  try {\n123\t    const secret = \"hunter2xK9aa\";\n124\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n125\t    assert.strictEqual(appendResult.anchor, null, \"HEAD must still be unborn\");\n126\t    const original = appendResult.appended[0]!;\n127\t\n128\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n129\t\n130\t    assert.strictEqual(result.event.id, original.id);\n131\t    assert.strictEqual(result.squashed, false, \"nothing was ever anchored, so there is no history to squash\");\n132\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n133\t\n134\t    const pending = await readPending(repo);\n135\t    const target = pending.find((e) => e.id === original.id);\n136\t    assert.ok(target, \"rewritten target must still be in the pending queue\");\n137\t    assert.ok(!JSON.stringify(target).includes(secret));\n138\t\n139\t    const companion = pending.find((e) =>\n140\t      e.links?.some((l) => l.rel === \"redacts\" && l.target === original.id),\n141\t    );\n142\t    assert.ok(companion, \"companion redaction event must also be queued (HEAD is still unborn)\");\n143\t  } finally {\n144\t    await cleanupRepo(repo);\n145\t  }\n146\t});\n147\t\n148\ttest(\"redactEvent: when origin already has the notes ref, squash is skipped and a warning is printed\", async () => {\n149\t  const remote = await makeBareRepo();\n150\t  const repo = await makeTempRepo();\n151\t  try {\n152\t    await makeCommit(repo, \"init\");\n153\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n154\t    const secret = \"hunter2xK9aa\";\n155\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n156\t    const original = appendResult.appended[0]!;\n157\t\n158\t    // Seed the remote with the pre-redaction content. This secret shape\n159\t    // trips the standard-tier keyword-assignment scan rule, so bypass the\n160\t    // gate here — that's the exact precondition this test needs, not what\n161\t    // it's testing.\n162\t    const pushResult = await sync(repo, \"origin\", \"push\", { skipScan: true });\n163\t    assert.strictEqual(pushResult.pushed, true);\n164\t\n165\t    const originalWrite = process.stderr.write.bind(process.stderr);\n166\t    const stderrChunks: string[] = [];\n167\t    process.stderr.write = ((chunk: unknown) => {\n168\t      stderrChunks.push(String(chunk));\n169\t      return true;\n170\t    }) as typeof process.stderr.write;\n171\t\n172\t    let result;\n173\t    try {\n174\t      result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n175\t    } finally {\n176\t      process.stderr.write = originalWrite;\n177\t    }\n178\t\n179\t    assert.strictEqual(result.squashed, false);\n180\t    assert.ok(\n181\t      stderrChunks.some((c) => c.includes(\"skipping the local squash\")),\n182\t      \"expected a warning that already-shared history was not squashed\",\n183\t    );\n184\t  } finally {\n185\t    await cleanupRepo(repo);\n186\t    await cleanupDir(remote);\n187\t  }\n188\t});\n189\t\n190\ttest(\"redactEvent: throws when no event matches the id prefix\", async () => {\n191\t  const repo = await makeTempRepo();\n192\t  try {\n193\t    await makeCommit(repo, \"init\");\n194\t    await assert.rejects(() => redactEvent(repo, \"ev1-doesnotexist\", { all: true }), /no event matches/);\n195\t  } finally {\n196\t    await cleanupRepo(repo);\n197\t  }\n198\t});\n199\t\n200\ttest(\"redactEvent: requires exactly one of --pattern or --all\", async () => {\n201\t  const repo = await makeTempRepo();\n202\t  try {\n203\t    await makeCommit(repo, \"init\");\n204\t    await assert.rejects(() => redactEvent(repo, \"ev1-x\", {}), /exactly one of/);\n205\t    await assert.rejects(\n206\t      () => redactEvent(repo, \"ev1-x\", { pattern: \"x\", all: true }),\n207\t      /exactly one of/,\n208\t    );\n209\t  } finally {\n210\t    await cleanupRepo(repo);\n211\t  }\n212\t});\n213\t","tool_use_id":"toolu_015rqPkRDKDKmyxnApEaLPnm","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-redaction-pre-push-only","