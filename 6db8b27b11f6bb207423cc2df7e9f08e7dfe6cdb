ring;\n167\t}\n168\t\n169\texport interface EventLink {\n170\t  /** e.g. \"redacts\", \"supersedes\", \"annotates\", \"replies_to\" */\n171\t  rel: string;\n172\t  /** Target event id. */\n173\t  target: string;\n174\t}\n175\t\n176\texport interface EvidenceEvent {\n177\t  /** \"ev1-\" + sha256 of the identity subset (see eventId). */\n178\t  id: string;\n179\t  schema: typeof SCHEMA_VERSION;\n180\t  kind: string;\n181\t  /** When the content happened, ISO 8601 UTC (from the source when known). */\n182\t  occurred_at: string;\n183\t  /** When this event was appended to the ledger. Not part of identity. */\n184\t  recorded_at: string;\n185\t  actor: Actor;\n186\t  producer: Producer;\n187\t  /** IANA media type of `content`; defaults to application/json. */\n188\t  media_type?: string;\n189\t  /** The visible content itself, stored inline and never reinterpreted. */\n190\t  content: unknown;\n191\t  /** Repository context at capture time. Not part of identity. */\n192\t  context?: RepoContext;\n193\t  conversation?: ConversationRef;\n194\t  links?: EventLink[];\n195\t  /**\n196\t   * Opaque source-native payload for lossless export, e.g. the original\n197\t   * transcript line(s). Versioned by `format`. Not part of identity.\n198\t   */\n199\t  raw?: { format: string; data: unknown };\n200\t  /**\n201\t   * What the ledger could resolve, at capture time, of pointers the source\n202\t   * line only names. A Claude Code `file-history-snapshot` says a file's\n203\t   * bytes live at `<backup file>` under a machine-local cache directory; this\n204\t   * is where the sha256 and size the ledger read from that file go, so the\n205\t   * record can be verified later even though the cache itself is prunable and\n206\t   * unshareable.\n207\t   *\n208\t   * Excluded from the identity subset, and that exclusion is the point: the\n209\t   * same transcript line resolves differently on a machine without the cache,\n210\t   * or after the cache is pruned, and identity must answer 