\n          time: { created: SESSION_CREATED + 2, completed: SESSION_CREATED + 9000 },\n        },\n        parts: [\n          // seq 1 — bookkeeping, skipped silently (no drift warning)\n          { id: \"prt_1\", type: \"step-start\" },\n          // seq 2 — plaintext reasoning becomes a visible thinking block\n          {\n            id: \"prt_2\",\n            type: \"reasoning\",\n            text: \"They want the file read.\",\n            time: { start: SESSION_CREATED + 3 },\n          },\n          // seq 3 — settled tool call: one event carrying call + result\n          {\n            id: \"prt_3\",\n            type: \"tool\",\n            tool: \"read\",\n            callID: \"call_abc\",\n            state: {\n              status: \"completed\",\n              input: { filePath: \"/tmp/note.txt\" },\n              output: \"hello\",\n              time: { start: SESSION_CREATED + 4 },\n            },\n          },\n          // seq 4 — still running: must not be captured, and must hold the cursor\n          {\n            id: \"prt_4\",\n            type: \"tool\",\n            tool: \"bash\",\n            callID: \"call_running\",\n            state: { status: \"running\", input: { command: \"sleep 1\" } },\n          },\n          // seq 5 — visible assistant text\n          { id: \"prt_5\", type: \"text\", text: \"It says hello.\", time: { start: SESSION_CREATED + 5 } },\n          // seq 6 — empty text produces no event\n          { id: \"prt_6\", type: \"text\", text: \"   \" },\n          // seq 7 — unknown to this adapter version: preserved raw-only\n          { id: \"prt_7\", type: \"some-future-part\", text: \"from a newer opencode\" },\n          // seq 8 — bookkeeping, skipped silently\n          { id: \"prt_8\", type: \"step-finish\" },\n        ],\n      },\n    ],\n  };\n}\n\ntest(\"captures visible parts, skips bookkeeping, preserves unknown part types\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"initial\");\n    const result = await captureOpencodeExport(sessionExport(), repo.root);\n\n    assert.equal(result.appended, 5, \"user text, reasoning, tool, assistant text, unrecognized\");\n    assert.deepEqual(result.unrecognized, { \"some-future-part\": 1 });\n\n    const events = await readEvents(repo);\n    const bySeq = new Map(events.map((e) => [e.conversation?.seq, e]));\n\n    // Bookkeeping and empty/unsettled parts produced nothing.\n    for (const seq of [1, 4, 6, 8]) {\n      assert.equal(bySeq.has(seq), false, `seq ${seq} should not be captured`);\n    }\n\n    const user = bySeq.get(0)!;\n    assert.equal(user.kind, \"conversation_turn\");\n    assert.equal(user.actor.type, \"human\");\n    assert.equal(user.actor.id, \"test@example.com\");\n    assert.equal(user.producer.source, \"opencode\");\n    assert.equal(user.conversation?.id, `opencode:${SESSION_ID}`);\n    // opencode states the model even on user messages, unlike claude-code.\n    assert.equal(user.producer.model, \"deepseek-v4-flash\");\n    assert.equal(user.producer.provider, \"ds4\");\n    assert.equal(user.producer.source_version, \"1.18.5\");\n    assert.deepEqual((user.content as { blocks: unknown[] }).blocks, [\n      { type: \"text\", text: \"Read note.txt please\" },\n    ]);\n    assert.equal((user.content as { agent?: string }).agent, \"build\");\n\n    // Reasoning is plaintext in opencode, so it is a normal visible turn —\n    // never the opaque `reasoning` kind codex needs.\n    const reasoning = bySeq.get(2)!;\n    assert.equal(reasoning.kind, \"conversation_turn\");\n    assert.equal(reasoning.actor.type, \"agent\");\n    assert.deepEqual((reasoning.content as { blocks: unknown[] }).blocks, [\n      { type: \"thinking\", text: \"They want the file read.\" },\n    ]);\n\n    // A tool part carries call and result together in one event.\n    const tool = bySeq.get(3)!;\n    assert.equal(tool.actor.type, \"agent\");\n    const toolBlocks = (tool.content as { blocks: Record<string, unknown>[] }).blocks;\n    assert.equal(toolBlocks.length, 2);\n    assert.deepEqual(toolBlocks[0], {\n      type: \"tool_use\",\n      name: \"read\",\n      input: { filePath: \"/tmp/note.txt\" },\n      id: \"call_abc\",\n    });\n    assert.deepEqual(toolBlocks[1], {\n      type: \"tool_result\",\n      tool_use_id: \"call_abc\",\n      content: \"hello\",\n    });\n\n    const unknown = bySeq.get(7)!;\n    assert.equal(unknown.kind, \"unrecognized\");\n    assert.deepEqual(unknown.content, { unrecognized_type: \"some-future-part\" });\n    // raw pairs the part with its message info so the event stands alone.\n    const raw = unknown.raw?.data as { info?: { role?: string }; part?: { id?: string } };\n    assert.equal(raw.part?.id, \"prt_7\");\n    assert.equal(raw.info?.role, \"assistant\");\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"occurred_at falls back from part to message to session time\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"initial\");\n    await captureOpencodeExport(sessionExport(), repo.root);\n    const events = await readEvents(repo);\n    const bySeq = new Map(events.map((e) => [e.conversation?.seq, e]));\n    // seq 0's part has no time of its own, so it takes the message's.\n    assert.equal(bySeq.get(0)!.occurred_at, new Date(SESSION_CREATED + 1).toISOString());\n    // seq 2's part states its own start time.\n    assert.equal(bySeq.get(2)!.occurred_at, new Date(SESSION_CREATED + 3).toISOString());\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"re-capturing is idempotent, and an unsettled tool call is picked up once it settles\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"initial\");\n    const first = await captureOpencodeExport(sessionExport(), repo.root);\n    assert.equal(first.appended, 5);\n\n    // Same export again: the cursor was held at the running tool part, so\n    // everything after it is re-examined and must dedup rather than duplicate.\n    const second = await captureOpencodeExport(sessionExport(), repo.root);\n    assert.equal(second.appended, 0);\n    assert.ok(second.deduped > 0, \"re-scanned parts should dedup\");\n\n    // The tool call finishes; only that one new event should appear.\n    const settled = sessionExport();\n    const running = settled.messages![1]!.parts![4]!;\n    running.state = { status: \"completed\", input: { command: \"sleep 1\" }, output: \"done\" };\n    const third = await captureOpencodeExport(settled, repo.root);\n    assert.equal(third.appended, 1);\n\n    const events = await readEvents(repo);\n    const seqs = events.map((e) => e.conversation?.seq).sort((a, b) => (a ?? 0) - (b ?? 0));\n    assert.deepEqual(seqs, [0, 2, 3, 4, 5, 7]);\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"subagent sessions are skipped\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"initial\");\n    const child = sessionExport();\n    child.info!.parentID = \"ses_parent00000000000000000\";\n    const result = await captureOpencodeExport(child, repo.root);\n    assert.equal(result.appended, 0);\n    assert.equal((await readEvents(repo)).length, 0);\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"an errored tool call is captured with is_error\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"initial\");\n    const data = sessionExport();\n    const tool = data.messages![1]!.parts![3]!;\n    tool.state = { status: \"error\", input: { filePath: \"/nope\" }, error: \"ENOENT\" };\n    await captureOpencodeExport(data, repo.root);\n    const events = await readEvents(repo);\n    const failed = events.find((e) => e.conversation?.seq === 3)!;\n    const blocks = (failed.content as { blocks: Record<string, unknown>[] }).blocks;\n    assert.equal(blocks[1]![\"is_error\"], true);\n    assert.equal(blocks[1]![\"content\"], \"ENOENT\");\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n","replaceAll":false,"structuredPatch":[{"lines":[" ","     // The tool call finishes; only that one new event should appear.","     const settled = sessionExport();","-    const running = settled.messages![1]!.parts![4]!;","+    const running = settled.messages![1]!.parts![3]!; // seq 4, the running tool","     running.state = { status: \"completed\", input: { command: \"sleep 1\" }, output: \"done\" };","     const third = await captureOpencodeExport(settled, repo.root);","     assert.equal(third.appended, 1);"],"newLines":7,"newStart":191,"oldLines":7,"oldStart":191}],"userModified":false},"type":"user","userType":"external","uuid":"a4dbf9bd-717d-4faa-8ca1-c9d4a4675c59","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-02T17:18:57.180Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"The user answered: \"How should the adapter read opencode's data?\"=\"`opencode export` CLI (Recommended)\", \"What triggers capture?\"=\"Install an opencode plugin (Recommended)\", \"opencode's store is mutable, so a positional seq can shift. What granularity should an event be?\"=\"One event per part (Recommended)\", \"opencode's subagents (the `task` tool) create real child sessions with parent_id set — I found 4 locally. Capture them?\"=\"skip for now but add a todo for later to include child sessions from both opencode and claude code and all others\". Read the answers carefully — they may request clarification, changes, or that you not proceed — and follow what they actually say.","tool_use_id":"toolu_01KBc68t9YesAoWi9kLL9g8u","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-opencode-adapter","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/opencode-adapter","head":"5476c74237583d41f5acff542b07f3b2eb42daf0","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:fe9cea6b-80c2-4e6e-bff4-aa88447380f6","seq":181},"id":"ev1-884c1bc29c6a93a8f7c124a99eec878a5e2378962b774383d3f981f6ac00a743","kind":"conversation_turn","occurred_at":"2026-08-02T17:01:57.925Z","producer":{"session_id":"fe9cea6b-80c2-4e6e-bff4-aa88447380f6","source":"claude-code","source_version":"2.1.220","tool":"cledger","version":"0.16.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","entrypoint":"cli","gitBranch":"main","isSidechain":false,"message":{"content":[{"content":"The user answered: \"How should the adapter read opencode's data?\"=\"`opencode export` CLI (Recommended)\", \"What triggers capture?\"=\"Install an opencode plugin (Recommended)\", \"opencode's store is mutable, so a positional seq can shift. What granularity should an event be?\"=\"One event per part (Recommended)\", \"opencode's subagents (the `task` tool) create real child sessions with parent_id set — I found 4 locally. Capture them?\"=\"skip for now but add a todo for later to include child sessions from both opencode and claude code and all others\". Read the answers carefully — they may request clarification, changes, or that you not proceed — and follow what they actually say.","tool_use_id":"toolu_01KBc68t9YesAoWi9kLL9g8u","type":"tool_result"}],"role":"user"},"parentUuid":"9fbd45fb-921c-47ae-9f95-ab437efe78bd","promptId":"7634b6a4-030c-450a-a53a-dc3f3ed5dda3","sessionId":"fe9cea6b-80c2-4e6e-bff4-aa88447380f6","sessionKind":"bg","session_id":"fe9cea6b-80c2-4e6e-bff4-aa88447380f6","sourceToolAssistantUUID":"9fbd45fb-921c-47ae-9f95-ab437efe78bd","timestamp":"2026-08-02T17:01:57.925Z","toolUseResult":{"annotations":{},"answers":{"How should the adapter read opencode's data?":"`opencode export` CLI (Recommended)","What triggers capture?":"Install an opencode plugin (Recommended)","opencode's store is mutable, so a positional seq can shift. What granularity should an event be?":"One event per part (Recommended)","opencode's subagents (the `task` tool) create real child sessions with parent_id set — I found 4 locally. Capture them?":"skip for now but add a todo for later to include child sessions from both opencode and claude code and all others"},"questions":[{"header":"Read path","multiSelect":false,"options":[{"description":"Spawn `opencode export --pure <id>`. Keeps cledger's zero-runtime-deps and Node>=20 engines intact, insulates us from DB schema churn (that empty session_message table), and never touches the credential/token tables. Cost: requires `opencode` on PATH, and re-exports the whole session each capture (a cursor still makes appends incremental).","label":"`opencode export` CLI (Recommended)"},{"description":"Use node:sqlite. No subprocess, true incremental queries. Cost: node:sqlite needs Node >=22.5 so package.json engines must move off >=20; we'd be reverse-engineering a schema that is visibly mid-migration; and we'd be opening a DB that also stores API tokens.","label":"Read SQLite directly"},{"description":"Try the CLI, drop to direct DB reads when opencode isn't on PATH. Most robust, roughly double the code and test surface, and still pays the engines bump.","label":"Export CLI, fall back to SQLite"}],"question":"How should the adapter read opencode's data?"},{"header":"Trigger","multiSelect":false,"options":[{"description":"`cledger install opencode` writes ~/.config/opencode/plugin/cledger.js listening for `session.idle`, which spawns `cledger hook opencode`. Per-turn capture matching claude-code/codex. Cost: we now ship and maintain third-party JS; the hook must use `--pure` so re-entering opencode doesn't reload our own plugin.","label":"Install an opencode plugin (Recommended)"},{"description":"No plugin. `cledger capture opencode --session <id>` plus a `--all` that sweeps every session for the current repo via `opencode session list`. Far simpler and nothing to install, but capture only happens when you remember (or at commit/push time).","label":"Manual / sweep only"},{"description":"Ship the sweep command first as the reliable floor, add the plugin for per-turn capture. Most work, but the sweep also serves backfill and covers sessions that predate the install.","label":"Both: plugin plus a sweep command"}],"question":"What triggers capture?"},{"header":"Granularity","multiSelect":false,"options":[{"description":"Codex-like. A part is small and immutable once complete, so incremental capture is idempotent at the finest available unit. Critically: if a message gains parts after an early session.idle, already-captured parts are untouched and only new parts append. Per-message would instead re-emit changed content under a new id — a duplicate.","label":"One event per part (Recommended)"},{"description":"claude-code-like: parts become the blocks array, one turn per visible agent turn. Cleanest for consumers like intent-recall. But an opencode message spans many LLM steps, so events get large, and any part appended to an already-captured message duplicates it.","label":"One event per message"},{"description":"Per-message granularity, gated on time.completed being set. Reduces but does not eliminate the duplicate risk, and drops content from sessions abandoned mid-turn.","label":"Per message, but only completed ones"}],"question":"opencode's store is mutable, so a positional seq can shift. What granularity should an event be?"},{"header":"Subagents","multiSelect":false,"options":[{"description":"Matches claude-code, which skips isSidechain lines. The parent's `task` tool part already stores the child's final output, so nothing user-visible is lost — only the subagent's internal steps.","label":"Skip child sessions (Recommended)"},{"description":"Each child gets its own `opencode:<ses_...>` conversation id. Full fidelity of subagent work, but ledger volume grows a lot and the parent/child relationship isn't expressible in the current schema without a new link rel.","label":"Capture as separate conversations"},{"description":"Capture children and add a links entry relating them to the parent's tool-call event. Most faithful, but needs a new link rel and touches schema.ts rather than staying adapter-local.","label":"Capture, linked to the parent"}],"question":"opencode's subagents (the `task` tool) create real child sessions with parent_id set — I found 4 locally. Capture them?"}]},"type":"user","userType":"external","uuid":"6f4bd32a-5cfd-4d58-ba0d-87995894aa0a","version":"2.1.220"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-02T17:18:57.175Z","schema":"conversation-ledger/v1"}
