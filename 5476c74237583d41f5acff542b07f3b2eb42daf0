xt(lines, cursor);\n474\t  const drafts: EventDraft[] = [];\n475\t  for (let i = cursor; i < lines.length; i++) {\n476\t    const text = lines[i]!;\n477\t    if (!text.trim()) continue;\n478\t    let parsed: CodexRolloutLine;\n479\t    try {\n480\t      parsed = JSON.parse(text) as CodexRolloutLine;\n481\t    } catch {\n482\t      continue; // partial line — normal at the tail of a live transcript\n483\t    }\n484\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n485\t    // Context lines precede the items they describe, so fold them in before\n486\t    // this iteration can emit anything.\n487\t    if (CONTEXT_LINE_TYPES.has(type)) applyContextLine(agent, parsed);\n488\t    const occurredAt = typeof parsed.timestamp === \"string\" ? parsed.timestamp : baseTime;\n489\t    if (type === \"response_item\") {\n490\t      const payloadType = parsed.payload?.[\"type\"];\n491\t      const pt = typeof payloadType === \"string\" ? payloadType : \"(untyped)\";\n492\t      if (pt === \"reasoning\") {\n493\t        const summaryText = reasoningSummaryText(parsed.payload?.[\"summary\"]);\n494\t        if (summaryText) {\n495\t          // Visible half: a normal conversation_turn, shown in log/show like\n496\t          // any other turn. Same seq as the sibling opaque event below —\n497\t          // distinct kinds keep their ids from colliding.\n498\t          drafts.push({\n499\t            kind: \"conversation_turn\",\n500\t            occurred_at: occurredAt,\n501\t            actor: { type: \"agent\" },\n502\t            producer: {\n503\t              tool: \"cledger\",\n504\t              version,\n505\t              source: \"codex\",\n506\t              session_id: sessionId,\n507\t              ...agent,\n508\t            },\n509\t            conversation: { id: `codex:${sessionId}`, seq: i },\n510\t            content: { role: \"reasoning_summary\", blocks: [{ type: \"text\", text: summaryText }] },\n511\t          });\n512\t        }\