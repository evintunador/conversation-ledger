{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n2\timport type { RedactionRecord } from \"./redact/apply.js\";\n3\t\n4\texport const SCHEMA_VERSION = \"conversation-ledger/v1\";\n5\t\n6\t/**\n7\t * The well-known event kinds. `kind` is an open string so downstream tools\n8\t * can extend the ledger without a schema release; unknown kinds are stored\n9\t * verbatim. The ledger never interprets content, whatever the kind.\n10\t *\n11\t * `unrecognized` is the one kind the ledger emits for content it could *not*\n12\t * interpret: an adapter that meets a transcript line type it has no mapping\n13\t * for preserves the line raw-only under `raw.data` rather than dropping it,\n14\t * so a later adapter version can re-normalize (and supersede) it. Its\n15\t * `content` carries only a `{unrecognized_type}` label — the payload lives in\n16\t * `raw` — but identity still separates distinct lines via `conversation.seq`.\n17\t *\n18\t * `reasoning` is for content the ledger deliberately never interprets: a\n19\t * provider-encrypted reasoning/thinking blob (e.g. Codex's `reasoning`\n20\t * response_items) that only the originating provider can decrypt. Its\n21\t * `content` carries only an opacity marker; the ciphertext lives in `raw`,\n22\t * for a consumer to opt into replaying back through the same provider.\n23\t * Unlike `unrecognized`, this is not a placeholder awaiting a smarter\n24\t * cledger version — no future version will ever be able to read it either.\n25\t */\n26\texport const KNOWN_KINDS = [\n27\t  \"conversation_turn\",\n28\t  \"decision\",\n29\t  \"document\",\n30\t  \"annotation\",\n31\t  \"redaction\",\n32\t  \"supersession\",\n33\t  \"re_anchor\",\n34\t  \"unrecognized\",\n35\t  \"reasoning\",\n36\t] as const;\n37\t\n38\texport interface Actor {\n39\t  /** \"human\" | \"agent\" | \"system\" */\n40\t  type: string;\n41\t  /** Stable identity when known, e.g. git author email or model id. */\n42\t  id?: string;\n43\t  display?: string;\n44\t}\n45\t\n46\texport interface Producer {\n47\t  /** Capture tool that wrote this event, e.g. \"cledger\". */\n48\t  tool: string;\n49\t  /** Capture tool version. Not part of event identity. */\n50\t  version?: string;\n51\t  /** Source system the content came from, e.g. \"claude-code\", \"codex\". */\n52\t  source?: string;\n53\t  /**\n54\t   * The source system's own version — the coding CLI's version, not\n55\t   * cledger's (that is `version`), e.g. \"2.1.220\" for claude-code or\n56\t   * \"0.145.0\" for codex. Not part of event identity.\n57\t   */\n58\t  source_version?: string;\n59\t  /**\n60\t   * Model that served this turn, verbatim as the source names it, e.g.\n61\t   * \"claude-opus-5\" or \"gpt-5.6-sol\". Set only when the source states it\n62\t   * for this turn — never guessed, never carried across turns the source\n63\t   * did not label. Not part of event identity.\n64\t   */\n65\t  model?: string;\n66\t  /**\n67\t   * Inference provider serving `model`, verbatim as the source names it,\n68\t   * e.g. \"openai\". Set only when the source states it — notably *not*\n69\t   * inferred from `source` or from the model id, since the same CLI can be\n70\t   * pointed at a first-party API, a cloud reseller, or a local endpoint.\n71\t   * Not part of event identity.\n72\t   */\n73\t  provider?: string;\n74\t  /** Source system's native session identifier. */\n75\t  session_id?: string;\n76\t}\n77\t\n78\t/**\n79\t * The source-stated agent facts an adapter attaches to `producer`. Adapters\n80\t * gather these from wherever the source records them — a per-line field, a\n81\t * preceding session/turn-context line — and spread them onto every event\n82\t * they emit for that part of the transcript.\n83\t */\n84\texport type ProducerAgentContext = Pick<Producer, \"source_version\" | \"model\" | \"provider\">;\n85\t\n86\texport interface RepoContext {\n