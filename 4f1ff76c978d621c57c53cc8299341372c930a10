nnals\";\n     7\timport type { RepoContext, RepoInfo } from \"annals\";\n     8\timport { asLedger, CLEDGER_NAMESPACE } from \"./ledger.js\";\n     9\timport { fromAnnals, toAnnals, type EventDraft, type EvidenceEvent } from \"./schema.js\";\n    10\t\n    11\texport { ScanBlockedError, RedactAfterShareError, parsePrePushRefs } from \"annals\";\n    12\texport type { SyncResult, TransportPushResult } from \"annals\";\n    13\t\n    14\t/** annals' options plus the cledger-vocabulary filters lifted from meta. */\n    15\texport interface ReadOptions extends A.ReadOptions {\n    16\t  /** Exact match on producer.source (a meta field on the wire). */\n    17\t  source?: string;\n    18\t  /** Exact match on producer.model; events without one are excluded. */\n    19\t  model?: string;\n    20\t}\n    21\t\n    22\texport interface AppendResult {\n    23\t  appended: EvidenceEvent[];\n    24\t  deduped: number;\n    25\t  anchor: string | null;\n    26\t}\n    27\t\n    28\texport interface ReAnchorRunResult extends Omit<A.ReAnchorRunResult, \"applied\"> {\n    29\t  applied: EvidenceEvent[];\n    30\t}\n    31\t\n    32\texport interface RedactResult extends Omit<A.RedactResult, \"event\" | \"redactionEvent\"> {\n    33\t  event: EvidenceEvent;\n    34\t  redactionEvent: EvidenceEvent;\n    35\t}\n    36\t\n    37\t/** Stable order: stream, then seq, then time, then id. */\n    38\texport function sortEvents(events: EvidenceEvent[]): EvidenceEvent[] {\n    39\t  return A.sortEvents(events) as EvidenceEvent[];\n    40\t}\n    41\t\n    42\texport const NOTES_NAME = CLEDGER_NAMESPACE.name;\n    43\texport const NOTES_REF = A.notesRef(CLEDGER_NAMESPACE);\n    44\texport const INCOMING_REF = A.incomingRef(CLEDGER_NAMESPACE);\n    45\t\n    46\texport async function appendEvents(\n    47\t  repo: RepoInfo,\n    48\t  events: EventDraft[],\n    49\t  opts: { context?: RepoContext; anchor?: string } = {},\n    50\t): Promise<AppendResult> {\n    51\t  const result = await A.appendEvents(asLedger(repo), events.map(toAnnals), opts);\n    52\t  return { ...result, appended: result.appended.map(fromAnnals) };\n    53\t}\n    54\t\n    55\texport async function readEvents(repo: RepoInfo, opts: ReadOptions = {}): Promise<EvidenceEvent[]> {\n    56\t  const { source, model, ...annalsOpts } = opts;\n    57\t  const events = (await A.readEvents(asLedger(repo), annalsOpts)).map(fromAnnals);\n    58\t  if (source === undefined && model === undefined) return events;\n    59\t  return events.filter(\n    60\t    (e) =>\n    61\t      (source === undefined || e.producer.source === source) &&\n    62\t      (model === undefined || e.producer.model === model),\n    63\t  );\n    64\t}\n    65\t\n    66\texport async function readPending(repo: RepoInfo): Promise<EvidenceEvent[]> {\n    67\t  return (await A.readPending(asLedger(repo))).map(fromAnnals);\n    68\t}\n    69\t\n    70\texport async function readNoteEvents(\n    71\t  repo: RepoInfo,\n    72\t  anchor: string,\n    73\t  refName?: string,\n    74\t): Promise<EvidenceEvent[]> {\n    75\t  const ledger = asLedger(repo);\n    76\t  return (await A.readNoteEvents(ledger, anchor, refName ?? ledger.ns.name)).map(fromAnnals);\n    77\t}\n    78\t\n    79\texport function listAnchors(repo: RepoInfo, refName?: string): Promise<string[]> {\n    80\t  const ledger = asLedger(repo);\n    81\t  return A.listAnchors(ledger, refName ?? ledger.ns.name);\n    82\t}\n    83\t\n    84\texport function captureContext(repo: RepoInfo): Promise<RepoContext> {\n    85\t  return A.captureContext(asLedger(repo));\n    86\t}\n    87\t\n    88\texport async function runReAnchor(\n    89\t  repo: RepoInfo,\n    90\t  opts: { target?: string; apply: boolean },\n    91\t): Promise<ReAnchorRunResult> {\n    92\t  const result = await A.runReAnchor(asLedger(repo), opts);\n    93\t  return { ...result, applied: result.applied.map(fromAnnals) };\n    94\t}\n    95\t\n    96\texport async function manualReAnchor(\n    97\t  r