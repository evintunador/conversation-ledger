   351\t    .filter((t): t is string => typeof t === \"string\" && t.length > 0);\n   352\t  return parts.length > 0 ? parts.join(\"\\n\\n\") : null;\n   353\t}\n   354\t\n   355\t/**\n   356\t * A payload's fields without its own `type` discriminator, which the record's\n   357\t * `activity_type`/`state_type` already names — keeping both would put the\n   358\t * same string in two places in one object.\n   359\t */\n   360\tfunction payloadFields(payload: Record<string, unknown> | undefined): Record<string, unknown> {\n   361\t  if (!payload) return {};\n   362\t  const { type: _type, ...rest } = payload;\n   363\t  return rest;\n   364\t}\n   365\t\n   366\t/**\n   367\t * The `RecordContext` a non-turn codex line converts under. Built identically\n   368\t * by the capture loop and the re-normalization hook so both produce the same\n   369\t * event identity for the same line.\n   370\t */\n   390\t/**\n   391\t * Convert a codex line that is not a `response_item` into the record it\n   392\t * deserves. Returns null for a type this adapter does not know (the caller\n   393\t * routes it to the drift path) and for the `event_msg` payloads that\n   394\t * duplicate a response_item (the caller drops those, deliberately).\n   395\t */\n   396\tfunction convertRecordLine(line: CodexRolloutLine, ctx: RecordContext): EventDraft | null {\n   397\t  const type = line.type;\n   398\t  if (typeof type !== \"string\") return null;\n   399\t  const fields = payloadFields(line.payload);\n   400\t\n   401\t  if (SESSION_STATE_LINE_TYPES.has(type)) return sessionStateDraft(ctx, type, fields, line);\n   402\t  if (ACTIVITY_LINE_TYPES.has(type)) return activityDraft(ctx, type, fields, line);\n   403\t\n   404\t  if (type === \"event_msg\") {\n   405\t    const payloadType = line.payload?.[\"type\"];\n   406\t    const pt = typeof payloadType === \"string\" ? payloadType : \"(untyped)\";\n   407\t    if (DUPLICATE_EVENT_MSG_TYPES.has(pt)) return null;\n   408\t    if (STATE_EVENT_MSG_TYPES.has(pt)) {\n   409\t      return sessionStateDraft(ctx, `event_msg/${pt}`, fields, line);\n   410\t    }\n   411\t    // The model drove the task and sub-agent events; the harness drove the\n   412\t    // rest (token accounting, patch application, rollbacks).\n   413\t    const actorType = pt.startsWith(\"task_\") || pt.startsWith(\"sub_agent\") ? \"agent\" : \"system\";\n   414\t    return activityDraft(ctx, `event_msg/${pt}`, liftText(fields, \"message\"), line, actorType);\n   415\t  }\n   416\t\n   417\t  return null;\n   418\t}\n   419\t\n   420\t/** Raw-only preservation event for an unrecognized codex line (see drift.ts). */\n   421\tfunction preserve(\n   422\t  typeKey: string,\n   423\t  line: CodexRolloutLine,\n   424\t  occurredAt: string,\n   425\t  seq: number,\n   426\t  sessionId: string,\n   427\t  version: string,\n   428\t  agent: CodexAgentState,\n   429\t): EventDraft {\n   430\t  return unrecognizedDraft({\n   431\t    typeKey,\n   432\t    line,\n   433\t    occurredAt,\n   434\t    source: \"codex\",\n   435\t    sessionId,\n   436\t    seq,\n   437\t    version,\n   438\t    rawFormat: RAW_FORMAT,\n   439\t    conversationId: `codex:${sessionId}`,\n   440\t    agent: { ...agent },\n   441\t  });\n   442\t}\n   443\t\n   444\tfunction convertLine(\n   445\t  line: CodexRolloutLine,\n   446\t  seq: number,\n   447\t  sessionId: string,\n   448\t  baseTime: string,\n   449\t  version: string,\n   450\t  identity: GitUserIdentity,\n   451\t  agent: CodexAgentState,\n   452\t): EventDraft | null {\n   453\t  if (line.type !== \"response_item\") return null;\n   454\t  const payload = line.payload;\n   455\t  if (!payload) return null;\n   456\t  const payloadType = payload[\"type\"];\n   457\t  // reasoning items never reach here — the capture loop diverts them to\n   458\t  // reasoningDraft before calling convertLine.\n   459\t  if (typeof payloadType !== \"string\" || !CONVERTIBLE_RESPONSE_TYPES.has(payloadType)) return null;\n   460\t\n   461\t  const occurredAt = typeof line.timestamp === \"string\" ? line.timestamp : baseTime;\n   462\t\n   463\t  let actor: Actor;\n   464\t  let content: { role: string; blocks: unknown[] };\n   465\t\n   466\t  if (payloadType === \"message\") {\n   467\t    const role = payload[\"role\"];\n   468\t    const roleStr = typeof role === \"string\" ? role : \"user\";\n   469\t    actor = roleStr === \"assistant\" ? { type: \"agent\" } : { type: \"human\" };\n   470\t    if (actor.type === \"human\") {\n   340\t\n   341\t    await captureCodexTranscript(path, repo.root);\n   342\t    const events = await readEvents(repo);\n   343\t    const preserved = events.find((e) => e.kind === \"unrecognized\")!;\n   344\t    const serialized = JSON.stringify(preserved);\n   345\t    assert.ok(!serialized.includes(secret), \"secret must not survive in the preserved event\");\n   346\t    assert.ok(serialized.includes(\"[REDACTED:\"), \"secret must be replaced with a redaction placeholder\");\n   347\t    assert.ok((preserved.redactions ?? []).length > 0, \"a redaction record must be attached\");\n   348\t  } finally {\n   349\t    await cleanupRepo(repo);\n   350\t    await cleanupDir(dir);\n   351\t  }\n   352\t});\n   353\t\n   354\ttest(\"captureCodexTranscript: agent_message keeps visible text, drops encrypted blocks everywhere\", async () => {\n   355\t  const repo = await makeTempRepo(\"cledger-codex-agentmsg-\");\n   356\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-codex-agentmsg-\"));\n   357\t  try {\n   358\t    await makeCommit(repo, \"init\");\n   359\t    const path = join(dir, FILENAME);\n   360\t    const lines = [\n   361\t      { type: \"session_meta\", payload: { session_id: SESSION_ID } },\n   362\t      {\n   363\t        type: \"response_item\",\n   364\t        timestamp: \"2026-01-01T00:00:01.000Z\",\n   365\t        payload: {\n   366\t          type: \"agent_message\",\n   367\t          author: \"/root\",\n   368\t          recipient: \"/root/subagent\",\n   369\t          content: [\n   370\t            { type: \"input_text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" },\n   371\t            { type: \"encrypted_content\", encrypted_content: \"gAAAAAB-opaque-blob-must-never-be-stored\" },\n   372\t          ],\n   373\t        },\n   374\t      },\n   375\t    ];\n   376\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n   377\t\n   378\t    const result = await captureCodexTranscript(path, repo.root);\n   379\t    assert.strictEqual(\n   380\t      result.appended,\n   381\t      3,\n   382\t      \"the session_meta state record, the visible turn, and the sealed sibling\",\n   383\t    );\n   384\t    assert.deepStrictEqual(result.unrecognized, {}, \"agent_message is a recognized type now\");\n   385\t\n   386\t    const events = await readEvents(repo);\n   387\t    const e = events.find((ev) => ev.kind === \"conversation_turn\")!;\n   388\t    assert.strictEqual(e.actor.type, \"agent\");\n   389\t    assert.strictEqual(e.actor.id, \"/root\");\n   390\t    assert.deepStrictEqual(e.content, {\n   391\t      role: \"agent_message\",\n   392\t      author: \"/root\",\n   393\t      recipient: \"/root/subagent\",\n   394\t      blocks: [{ type: \"text\", text: \"Message Type: NEW_TASK\\nTask name: /root/subagent\" }],\n   395\t    });\n   396\t\n   397\t    // The ciphertext must be gone from the *visible turn* — content and raw\n   398\t    // alike — leaving only the bare type marker so the split is visible.\n   399\t    const serialized = JSON.stringify(e);\n   400\t    assert.ok(!serialized.includes(\"opaque-blob\"), \"the visible turn must not carry ciphertext\");\n   401\t    const rawContent = ((e.raw?.data as { payload?: { content?: unknown[] } }).payload?.content) ?? [];\n   402\t    assert.deepStrictEqual(rawContent[1], { type: \"encrypted_content\" });\n   403\t    assert.strictEqual(e.raw?.format, \"codex-rollout-jsonl/2\");\n   