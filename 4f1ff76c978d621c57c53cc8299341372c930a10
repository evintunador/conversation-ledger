{"content":{"activity_type":"event_msg/item_completed","completed_at_ms":1790216240043,"item":{"aggregated_output":"   280\tfunction isEncryptedBlock(block: unknown): boolean {\n   281\t  return (\n   282\t    block !== null &&\n   283\t    typeof block === \"object\" &&\n   284\t    (block as Record<string, unknown>)[\"type\"] === \"encrypted_content\"\n   285\t  );\n   286\t}\n   287\t\n   288\t/**\n   289\t * Inter-agent messages mix visible input_text blocks with encrypted_content\n   290\t * blocks — the same provider-withheld material as reasoning payloads.\n   291\t *\n   292\t * The two halves are split across two events at the same `seq`: the visible\n   293\t * turn this function shapes `raw` for, and a sibling `reasoning`-kind event\n   294\t * carrying the ciphertext (see `encryptedAgentMessage`). So the turn keeps\n   295\t * only a bare `{type: \"encrypted_content\"}` marker where a sealed block was,\n   296\t * which is what makes the split visible rather than silent — but the blob\n   297\t * itself is preserved, not dropped, exactly as a standalone `reasoning` item\n   298\t * is. The transform is a pure function of the source line, so ids stay stable\n   299\t * across rescans.\n   300\t */\n   301\tfunction sanitizeAgentMessageRaw(line: CodexRolloutLine): CodexRolloutLine {\n   302\t  const content = line.payload?.[\"content\"];\n   303\t  if (!Array.isArray(content) || !content.some(isEncryptedBlock)) return line;\n   304\t  return {\n   305\t    ...line,\n   306\t    payload: {\n   307\t      ...line.payload,\n   308\t      content: content.map((b) => (isEncryptedBlock(b) ? { type: \"encrypted_content\" } : b)),\n   309\t    },\n   310\t  };\n   311\t}\n   312\t\n   313\t/**\n   314\t * The sealed half of an inter-agent message: the same line with `content`\n   315\t * reduced to its `encrypted_content` blocks, or null when there are none.\n   316\t *\n   317\t * This is what a sibling `reasoning` event stores, so the ciphertext survives\n   318\t * capture instead of being discarded. Preserving it matters for the same\n   319\t * reason a standalone `reasoning` item's does: only the originating provider\n   320\t * can decrypt it, and a consumer replaying a conversation back through that\n   321\t * provider needs the blob to reconstruct what the agent was actually working\n   322\t * from. Dropping it made inter-agent codex sessions the one place that replay\n   323\t * could not be reconstructed.\n   324\t *\n   325\t * The redaction stack exempts `.../encrypted_content` on `reasoning`-kind\n   326\t * events, so pattern-matching can never corrupt a blob it cannot read.\n   327\t */\n   328\tfunction encryptedAgentMessage(line: CodexRolloutLine): CodexRolloutLine | null {\n   329\t  const content = line.payload?.[\"content\"];\n   330\t  if (!Array.isArray(content)) return null;\n   331\t  const sealed = content.filter(isEncryptedBlock);\n   332\t  if (sealed.length === 0) return null;\n   333\t  return { ...line, payload: { ...line.payload, content: sealed } };\n   334\t}\n   335\t\n   336\t/**\n   337\t * A `reasoning` response_item's `summary` field carries visible,\n   338\t * provider-decrypted plaintext (typically `{type: \"summary_text\", text}`\n   339\t * blocks per OpenAI's Responses API) when reasoning-summary mode is\n   340\t * enabled — real content, not ciphertext, unlike `encrypted_content` on the\n   341\t * same item. Returns null when there's nothing visible (summary absent or\n   342\t * empty, the common case), so the caller knows to skip the visible-turn\n   343\t * draft entirely and store only the opaque `reasoning` event.\n   344\t */\n   345\tfunction reasoningSummaryText(summary: unknown): string | null {\n   346\t  if (!Array.isArray(summary) || summary.length === 0) return null;\n   347\t  const parts = summary\n   348\t    .map((block) =>\n   349\t      block && typeof block === \"object\" ? (block as Record<string, unknown>)[\"text\"] : undefined,\n   350\t    )\n   351\t    .filter((t): t is string => typeof t === \"string\" && t.length > 0);\n   352\t  return parts.length > 0 ? parts.join(\"\\n\\n\") : null;\n   353\t}\n   354\t\n   355\t/**\n   356\t * A payload's fields without its own `type` discriminator, which the record's\n   357\t * `activity_type`/`state_type` already names — keeping both would put the\n   358\t * same string in two places in one object.\n   359\t */\n   360\tfunction payloadFields(payload: Record<string, unknown> | undefined): Record<string, unknown> {\n   361\t  if (!payload) return {};\n   362\t  const { type: _type, ...rest } = payload;\n   363\t  return rest;\n   364\t}\n   365\t\n   366\t/**\n   367\t * The `RecordContext` a non-turn codex line converts under. Built identically\n   368\t * by the capture loop and the re-normalization hook so both produce the same\n   369\t * event identity for the same line.\n   370\t */\n   390\t/**\n   391\t * Convert a codex line that is not a `response_item` into the record it\n   392\t * deserves. Returns null for a type this adapter does not know (the caller\n   393\t * routes it to the drift path) and for the `event_msg` payloads that\n   394\t * duplicate a response_item (the caller drops those, deliberately).\n   395\t */\n   396\tfunction convertRecordLine(line: CodexRolloutLine, ctx: RecordContext): EventDraft | null {\n   397\t  const type = line.type;\n   398\t  if (typeof type !== \"string\") return null;\n   399\t  const fields = payloadFields(line.payload);\n   400\t\n   401\t  if (SESSION_STATE_LINE_TYPES.has(type)) return sessionStateDraft(ctx, type, fields, line);\n   402\t  if (ACTIVITY_LINE_TYPES.has(type)) return activityDraft(ctx, type, fields, line);\n   403\t\n   404\t  if (type === \"event_msg\") {\n   405\t    const payloadType = line.payload?.[\"type\"];\n   406\t    const pt = typeof payloadType === \"string\" ? payloadType : \"(untyped)\";\n   407\t    if (DUPLICATE_EVENT_MSG_TYPES.has(pt)) return null;\n   408\t    if (STATE_EVENT_MSG_TY