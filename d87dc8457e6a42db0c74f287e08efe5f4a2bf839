{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"140\t  } finally {\n141\t    await rm(lockDir, { recursive: true, force: true });\n142\t  }\n143\t}\n144\t\n145\texport interface AppendResult {\n146\t  appended: EvidenceEvent[];\n147\t  deduped: number;\n148\t  /** null when events went to the pending queue (unborn HEAD). */\n149\t  anchor: string | null;\n150\t}\n151\t\n152\texport async function appendEvents(\n153\t  repo: RepoInfo,\n154\t  drafts: EventDraft[],\n155\t  opts: { context?: RepoContext; anchor?: string } = {},\n156\t): Promise<AppendResult> {\n157\t  const context = opts.context ?? (await captureContext(repo));\n158\t  const config = await loadConfig(repo.root);\n159\t  // First capture in a repo wires up transport (pre-push hook + fetch\n160\t  // refspec); later calls are cheap re-checks. Never throws.\n161\t  await ensureTransport(repo, config);\n162\t  const rules = captureRules(config);\n163\t  // Exact-value scrubbing layers, each tagged with its own rule id for the\n164\t  // audit trail. Only consulted when capture redaction is active at all\n165\t  // (rules.length > 0); known-secrets additionally requires its opt-in flag.\n166\t  const extraValues: ExtraValueGroup[] = [];\n167\t  if (rules.length > 0) {\n168\t    if (config.redact?.knownSecrets === true) {\n169\t      const known = await loadKnownSecrets(repo);\n170\t      if (known.length > 0) extraValues.push({ ruleId: \"known-secret\", values: known });\n171\t    }\n172\t    if (config.redact?.env === true) {\n173\t      const env = await collectEnvValues(repo.root);\n174\t      if (env.length > 0) extraValues.push({ ruleId: \"env-value\", values: env });\n175\t    }\n176\t  }\n177\t  const events = drafts.map((draft) => {\n178\t    const withContext = { ...draft, context: draft.context ?? context };\n179\t    if (rules.length === 0) return finalizeEvent(withContext);\n180\t    const { draft: redacted, records } = redactDraf