{
  "name": "conversation-ledger",
  "version": "0.27.1",
  "description": "Durable, attributable records of visible coding-agent conversations, stored as git notes.",
  "type": "module",
  "license": "MIT",
  "author": "evintunador",
  "repository": {
    "type": "git",
    "url": "https://github.com/evintunador/conversation-ledger"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "conversation-ledger": "dist/cli.js",
    "cledger": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "git-notes",
    "coding-agent",
    "conversation-history",
    "claude-code",
    "codex",
    "opencode",
    "provenance"
  ],
  "files": [
    "dist",
    "verification/requirements",
    "!dist/test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "verify:opencode": "npm run build && node dist/verification/opencode.js --scripted",
    "verify:opencode:local": "npm run build && node dist/verification/opencode.js",
    "verify:qwen": "npm run build && node dist/verification/qwen-code.js",
    "verify:pi": "npm run build && node dist/verification/pi.js",
    "verify:campaign": "npm run build && node dist/verification/campaign.js",
    "prepublishOnly": "npm test",
    "prepare": "npm run build",
    "verify:claude-code": "npm run build && node dist/verification/claude-code.js",
    "verify:codex": "npm run build && node dist/verification/codex.js",
    "verify:gemini-cli": "npm run build && node dist/verification/gemini-cli.js",
    "verify:copilot": "npm run build && node dist/verification/copilot.js",
    "verify:kimi": "npm run build && node dist/verification/kimi.js",
    "verify:mistral-vibe": "npm run build && node dist/verification/mistral-vibe.js",
    "verify:goose": "npm run build && node dist/verification/goose.js",
    "verify:aider": "npm run build && node dist/verification/aider.js",
    "verify:droid": "npm run build && node dist/verification/droid.js",
    "verify:continue": "npm run build && node dist/verification/continue.js",
    "verify:kilo": "npm run build && node dist/verification/kilo.js",
    "verify:cline": "npm run build && node dist/verification/cline.js",
    "verify:maintenance": "npm run build && node dist/verification/maintenance.js",
    "verify:crush": "npm run build && node dist/verification/crush.js",
    "verify:openhands": "npm run build && node dist/verification/openhands.js",
    "verify:open-interpreter": "npm run build && node dist/verification/open-interpreter.js",
    "verify:schedule": "npm run build && node dist/verification/schedule.js",
    "verify:matrix": "npm run build && node dist/verification/support-matrix.js",
    "verify:conformance": "npm run build && node dist/verification/conformance-campaign.js",
    "verify:canary": "npm run build && node dist/verification/canary.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "annals": "file:../annals",
    "fzstd": "^0.1.1",
    "proper-lockfile": "^4.1.2"
  }
}
