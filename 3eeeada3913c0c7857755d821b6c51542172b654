e } from \"node:child_process\";\nimport { promisify } from \"node:util\";\nconst x = promisify(execFile);\n\nconst WT = process.argv[2];\nconst { captureGeminiTranscript } = await import(join(WT, \"dist/adapters/gemini-cli.js\"));\nconst { readEvents } = await import(join(WT, \"dist/store.js\"));\nconst { findRepo } = await import(join(WT, \"dist/git.js\"));\n\nconst repo = await mkdtemp(join(tmpdir(), \"cledger-verify-\"));\nawait x(\"git\", [\"init\", \"-q\", repo]);\nawait x(\"git\", [\"-C\", repo, \"config\", \"user.email\", \"a@b.c\"]);\nawait x(\"git\", [\"-C\", repo, \"config\", \"user.name\", \"A\"]);\nawait writeFile(join(repo, \"f.txt\"), \"hi\\n\");\nawait x(\"git\", [\"-C\", repo, \"add\", \".\"]);\nawait x(\"git\", [\"-C\", repo, \"commit\", \"-qm\", \"init\"]);\nconst info = await findRepo(repo);\n\nconst dir = join(homedir(), \".gemini\", \"tmp\", \"sandbox\", \"chats\");\nfor (const f of await readdir(dir)) {\n  if (f.endsWith(\".jsonl\")) await captureGeminiTranscript(join(dir, f), repo);\n}\n\nconsole.log(\"\\n--- events from the REAL gemini session ---\");\nfor (const e of await readEvents(info)) {\n  const c = e.content ?? {};\n  const label = c.activity_type ?? c.state_type ?? \"\";\n  const t = (c.blocks ?? []).map((b) => b.text ?? \"\").join(\"\").slice(0, 50).replace(/\\n/g, \"\\\\n\");\n  const extra = c.removed_messages ? `  removed=${JSON.stringify(c.removed_messages)}` : \"\";\n  console.log(`seq=${e.conversation?.seq} ${e.kind}${label ? \"/\" + label : \"\"} actor=${e.actor?.type} :: ${t}${extra}`);\n}\n\nconst cdir = join(repo, \".git\", \"conversation-ledger\", \"cursors\");\nconsole.log(\"\\ncursor files:\", await readdir(cdir));\nfor (const f of await readdir(cdir)) console.log(\"  \", f, (await readFile(join(cdir, f), \"utf8\")).trim());\n","filePath":"/Users/evintunador/.claude/jobs/8f1a9339/tmp/verify-real.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid