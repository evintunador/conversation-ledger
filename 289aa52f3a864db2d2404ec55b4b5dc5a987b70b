persession — already re-normalized, skip them so\n68\t  // a re-run does no work rather than relying on dedup alone.\n69\t  const supersededTargets = new Set<string>();\n70\t  for (const e of all) {\n71\t    if (e.kind !== \"supersession\") continue;\n72\t    for (const link of e.links ?? []) {\n73\t      if (link.rel === \"supersedes\") supersededTargets.add(link.target);\n74\t    }\n75\t  }\n76\t  // Every id already in the ledger, across all anchors — `appendEvents` only\n77\t  // dedups within the target anchor, so this guards the cross-anchor case\n78\t  // where a live capture already wrote the same turn under a different commit.\n79\t  const existingIds = new Set(all.map((e) => e.id));\n80\t\n81\t  const result: RenormalizeResult = {\n82\t    scanned: 0,\n83\t    interpreted: 0,\n84\t    turnsAppended: 0,\n85\t    supersessionsAppended: 0,\n86\t    skipped: 0,\n87\t  };\n88\t  const drafts: EventDraft[] = [];\n89\t\n90\t  for (const event of all) {\n91\t    if (event.kind !== \"unrecognized\") continue;\n92\t    if (supersededTargets.has(event.id)) continue;\n93\t    result.scanned++;\n94\t\n95\t    const renormalizer = renormalizerFor(event.producer.source);\n96\t    if (!renormalizer) {\n97\t      result.skipped++;\n98\t      continue;\n99\t    }\n100\t    const turnDraft = renormalizer(event, identity);\n101\t    if (!turnDraft) {\n102\t      result.skipped++;\n103\t      continue;\n104\t    }\n105\t    result.interpreted++;\n106\t\n107\t    // The turn's id, computed the same way a fresh capture would (the stored\n108\t    // raw.data is already redacted, so the appendEvents redaction pass is a\n109\t    // no-op and does not shift this id).\n110\t    const turnId = eventId(turnDraft);\n111\t    if (!existingIds.has(turnId)) {\n112\t      drafts.push(turnDraft);\n113\t      existingIds.add(turnId);\n114\t    }\n115\t\n116\t    const link: EventLink = { rel: \"supersedes\", target: event.id };\n117\t    const supersessionDraft: EventDraft = {\n118\t      k