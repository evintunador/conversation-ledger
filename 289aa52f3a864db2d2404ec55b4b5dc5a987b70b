t assert from \"node:assert\";\nimport { mkdtemp, rm, writeFile } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { captureQwenTranscript, renormalizeUnrecognized } from \"../adapters/qwen-code.js\";\nimport { renormalize } from \"../renormalize.js\";\nimport { readEvents } from \"../store.js\";\nimport { gitUserIdentity } from \"../git.js\";\nimport type { EvidenceEvent } from \"../schema.js\";\nimport { cleanupRepo, makeCommit, makeTempRepo } from \"./helpers.js\";\n\nconst SESSION_ID = \"93335a04-fdc7-4462-b333-16b7f64290b9\";\nconst QWEN_VERSION = \"0.21.5\";\n\n/**\n * Lines shaped like a real Qwen Code 0.21.5 transcript — the envelope fields,\n * the GenAI `parts` content, the top-level `model` on assistant lines, and the\n * `system` telemetry lines that must be skipped without a drift warning. Field\n * values are taken from a session captured against a live Qwen Code.\n */\nfunction transcriptLines(): unknown[] {\n  const base = {\n    sessionId: SESSION_ID,\n    cwd: \"/tmp/project\",\n    gitBranch: \"main\",\n    version: QWEN_VERSION,\n  };\n  return [\n    // 0 — the human's prompt\n    {\n      ...base,\n      uuid: \"u-0\",\n      parentUuid: null,\n      timestamp: \"2026-08-04T03:48:56.645Z\",\n      type: \"user\",\n      provenance: \"real_user\",\n      message: { role: \"user\", parts: [{ text: \"Read calc.py and say what it does.\" }] },\n    },\n    // 1 — telemetry: skipped silently\n    {\n      ...base,\n      uuid: \"s-1\",\n      timestamp: \"2026-08-04T03:48:56.660Z\",\n      type: \"system\",\n      provenance: \"system\",\n      subtype: \"ui_telemetry\",\n      systemPayload: { uiEvent: { \"event.name\": \"qwen-code.api_response\", output_token_count: 77 } },\n    },\n    // 2 — model turn: a thought part plus a function call\n    {\n      ...base,\n      uuid: \"a-2\",\n      timestamp: \"2026-08-04T03:52:17.530Z\",\n      type: \"assistant\",\n      provenance: \"assistant_output\",\n      model: \"deepseek-v4-flash\",\n      message: {\n        role: \"model\",\n        parts: [\n          { text: \"Let me read the file.\", thought: true },\n          { functionCall: { id: \"call_1\", name: \"read_file\", args: { file_path: \"/tmp/calc.py\" } } },\n        ],\n      },\n    },\n    // 3 — the tool's answer, framed by the API as a user-role message\n    {\n      ...base,\n      uuid: \"t-3\",\n      timestamp: \"2026-08-04T03:52:17.558Z\",\n      type: \"tool_result\",\n      provenance: \"tool_result\",\n      message: {\n        role: \"user\",\n        parts: [\n          {\n            functionResponse: {\n              id: \"call_1\",\n              name: \"read_file\",\n              response: { output: \"def add(a,b): return a+b\\n\" },\n            },\n          },\n        ],\n      },\n      toolCallResult: { callId: \"call_1\", status: \"success\" },\n    },\n    // 4 — a record type this adapter version has no mapping for: must be\n    // preserved raw-only rather than dropped, and must trip the drift warning\n    {\n      ...base,\n      uuid: \"x-4\",\n      timestamp: \"2026-08-04T03:52:18.000Z\",\n      type: \"artifact\",\n      payload: { note: \"something a future Qwen Code writes\" },\n    },\n    // 5 — the final answer\n    {\n      ...base,\n      uuid: \"a-5\",\n      timestamp: \"2026-08-04T03:52:19.949Z\",\n      type: \"assistant\",\n      provenance: \"assistant_output\",\n      model: \"deepseek-v4-flash\",\n      message: { role: \"model\", parts: [{ text: \"It defines add(a, b).\" }] },\n    },\n  ];\n}\n\nasync function writeTranscript(lines: unknown[]): Promise<{ dir: string; path: string }> {\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-qwen-\"));\n  const path = join(dir, `${SESSION_ID}.jsonl`);\n  await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n  return { dir, path };\n}\n\ntest(\"qwen-code capture: converts turns, skips telemetry, preserves unknown types\", async () => {\n  const repo = await makeTempRepo();\n  const { dir, path } = await writeTranscript(transcriptLines());\n  try {\n    await makeCommit(repo);\n    const result = await captureQwenTranscript(path, repo.root);\n\n    // 4 conversation turns + 1 raw-only preservation; the `system` line is skipped.\n    assert.equal(result.appended, 5);\n    assert.deepEqual(result.unrecognized, { artifact: 1 });\n\n    const events = await readEvents(repo);\n    const turns = events.filter((e) => e.kind === \"conversation_turn\");\n    assert.equal(turns.length, 4);\n    assert.ok(events.every((e) => e.producer.source === \"qwen-code\"));\n    assert.ok(events.every((e) => e.producer.session_id === SESSION_ID));\n    assert.ok(events.every((e) => e.producer.source_version === QWEN_VERSION));\n\n    const bySeq = new Map(turns.map((e) => [e.conversation!.seq, e]));\n\n    // The human's prompt is attributed to the repo's git identity.\n    const prompt = bySeq.get(0)!;\n    assert.equal(prompt.actor.type, \"human\");\n    assert.equal(prompt.actor.id, \"test@example.com\");\n    assert.equal(prompt.producer.model, undefined, \"a user line states no model, so none is invented\");\n\n    // A thought part becomes a visible thinking block; a functionCall becomes tool_use.\n    const modelTurn = bySeq.get(2)!;\n    assert.equal(modelTurn.actor.type, \"agent\");\n    assert.equal(modelTurn.actor.id, \"deepseek-v4-flash\");\n    assert.equal(modelTurn.producer.model, \"deepseek-v4-flash\");\n    assert.equal(\n      modelTurn.producer.provider,\n      undefined,\n      \"qwen states an auth mode, not an inference provider, so provider stays unset\",\n    );\n    assert.deepEqual((modelTurn.content as { blocks: unknown[] }).blocks, [\n      { type: \"thinking\", text: \"Let me read the file.\" },\n      { type: \"tool_use\", id: \"call_1\", name: \"read_file\", input: { file_path: \"/tmp/calc.py\" } },\n    ]);\n\n    // A tool result carries role \"user\" from the API, but is not the human speaking.\n    const toolResult = bySeq.get(3)!;\n    assert.equal(toolResult.actor.type, \"system\");\n    assert.equal((toolResult.content as { role: string }).role, \"user\");\n    assert.deepEqual((toolResult.content as { blocks: unknown[] }).blocks, [\n      {\n        type: \"tool_result\",\n        tool_use_id: \"call_1\",\n        name: \"read_file\",\n        content: { output: \"def add(a,b): return a+b\\n\" },\n      },\n    ]);\n\n    // The unknown type is preserved whole, not dropped.\n    const preserved = events.find((e) => e.kind === \"unrecognized\")!;\n    assert.equal(preserved.conversation!.seq, 4);\n    assert.deepEqual(preserved.content, { unrecognized_type: \"artifact\" });\n    assert.equal(preserved.raw!.format, \"qwen-code-jsonl/1\");\n    assert.deepEqual((preserved.raw!.data as { payload: unknown }).payload, {\n      note: \"something a future Qwen Code writes\",\n    });\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"qwen-code capture: rescanning the same transcript dedups rather than duplicating\", async () => {\n  const repo = await makeTempRepo();\n  const { dir, path } = await writeTranscript(transcriptLines());\n  try {\n    await makeCommit(repo);\n    const first = await captureQwenTranscript(path, repo.root);\n    assert.equal(first.appended, 5);\n\n    // The cursor makes a second capture a no-op...\n    const second = await captureQwenTranscript(path, repo.root);\n    assert.equal(second.appended, 0);\n\n    // ...and even with the cursor gone, identical ids dedup.\n    await rm(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), {\n      recursive: true,\n      force: true,\n    });\n    const forced = await captureQwenTranscript(path, repo.root);\n    assert.equal(forced.appended, 0);\n    assert.equal(forced.deduped, 5);\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"qwen-code capture: an appended turn is picked up without re-reading the prefix\", async () => {\n  const repo = await makeTempRepo();\n  const lines = transcriptLines();\n  const { dir, path } = await writeTranscript(lines.slice(0, 2));\n  try {\n    await makeCommit(repo);\n    assert.equal((await captureQwenTranscript(path, repo.root)).appended, 1);\n\n    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n    const second = await captureQwenTranscript(path, repo.root);\n    assert.equal(second.appended, 4);\n    assert.equal(second.deduped, 0);\n\n    const turns = (await readEvents(repo)).filter((e) => e.kind === \"conversation_turn\");\n    assert.deepEqual(\n      turns.map((e) => e.conversation!.seq).sort((a, b) => a - b),\n      [0, 2, 3, 5],\n      \"seq stays the source line index across a resumed capture\",\n    );\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"qwen-code capture: a partial trailing line is skipped, then captured once complete\", async () => {\n  const repo = await makeTempRepo();\n  const lines = transcriptLines();\n  const dir = await mkdtemp(join(tmpdir(), \"cledger-qwen-\"));\n  const path = join(dir, `${SESSION_ID}.jsonl`);\n  try {\n    await makeCommit(repo);\n    const complete = JSON.stringify(lines[0]);\n    await writeFile(path, complete + \"\\n\" + complete.slice(0, 40));\n    assert.equal((await captureQwenTranscript(path, repo.root)).appended, 1);\n\n    // The torn line finishes as a *different* turn; the cursor must not have\n    // consumed it, or the finished line would be lost forever.\n    await writeFile(path, complete + \"\\n\" + JSON.stringify(lines[5]) + \"\\n\");\n    const second = await captureQwenTranscript(path, repo.root);\n    assert.equal(second.appended, 1);\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"qwen-code renormalize: a preserved line becomes the turn a live capture would write\", async () => {\n  const repo = await makeTempRepo();\n  // The same line, once as an unknown type (preserved) and once as the known\n  // type it will be understood as after an adapter upgrade.\n  const preservedShape = { ...(transcriptLines()[5] as Record<string, unknown>), type: \"future\" };\n  const { dir, path } = await writeTranscript([preservedShape]);\n  try {\n    await makeCommit(repo);\n    await captureQwenTranscript(path, repo.root);\n    const stored = (await readEvents(repo)).find((e) => e.kind === \"unrecognized\")!;\n\n    // Nothing can interpret it while the type is still unknown.\n    const identity = await gitUserIdentity(repo);\n    assert.equal(renormalizeUnrecognized(stored, identity), null);\n    assert.equal((await renormalize(repo)).interpreted, 0);\n\n    // Rewrite the stored raw payload as the recognized type and re-run: the\n    // adapter now interprets it, and supersedes the placeholder.\n    const upgraded: EvidenceEvent = {\n      ...stored,\n      raw: { ...stored.raw!, data: { ...(stored.raw!.data as object), type: \"assistant\" } },\n    };\n    const draft = renormalizeUnrecognized(upgraded, identity)!;\n    assert.equal(draft.kind, \"conversation_turn\");\n    assert.equal(draft.conversation!.seq, stored.conversation!.seq, \"seq is preserved, so the id matches a live capture\");\n    assert.equal(draft.producer.model, \"deepseek-v4-flash\");\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"qwen-code capture: empty-part turns produce no event\", async () => {\n  const repo = await makeTempRepo();\n  const { dir, path } = await writeTranscript([\n    {\n      sessionId: SESSION_ID,\n      uuid: \"a-0\",\n      timestamp: \"2026-08-04T03:52:19.949Z\",\n      type: \"assistant\",\n      version: QWEN_VERSION,\n      model: \"deepseek-v4-flash\",\n      message: { role: \"model\", parts: [{ text: \"   \" }] },\n    },\n  ]);\n  try {\n    await makeCommit(repo);\n    const result = await captureQwenTranscript(path, repo.root);\n    assert.equal(result.appended, 0);\n    assert.deepEqual(result.unrecognized, {});\n  } finally {\n    await rm(dir, { recursive: true, force: true });\n    await cleanupRepo(repo);\n  }\n});\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/test/adapter-qwen-code.test.ts","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"4db86577-8763-41cc-9b10-7e31fd3f3825","version":"2.1.221"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-04T04:51:56.337Z","schema":"conversation-ledger/v1"}
