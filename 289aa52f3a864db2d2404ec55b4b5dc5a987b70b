string | null {\n190\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n191\t  const date = new Date(ms);\n192\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n193\t}\n194\t\n195\t/**\n196\t * Run an opencode subcommand and return its stdout.\n197\t *\n198\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n199\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n200\t * silently lost — a large session's export still parses as JSON right up to\n201\t * the truncation point in some cases, which would quietly capture a partial\n202\t * conversation. Writing to a real file descriptor returns the full output.\n203\t *\n204\t * Returns null when opencode is not installed or the command fails; every\n205\t * caller treats that as \"nothing to capture\" rather than an error, so a\n206\t * missing opencode never breaks a hook.\n207\t */\n208\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n209\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n210\t  const path = join(dir, \"out.json\");\n211\t  try {\n212\t    const handle = await open(path, \"w\");\n213\t    try {\n214\t      const code = await new Promise<number | null>((resolve, reject) => {\n215\t        const child = spawn(\"opencode\", args, {\n216\t          cwd,\n217\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n218\t        });\n219\t        child.on(\"error\", reject);\n220\t        child.on(\"close\", resolve);\n221\t      });\n222\t      if (code !== 0) return null;\n223\t    } finally {\n224\t      await handle.close();\n225\t    }\n226\t    return await readFile(path, \"utf8\");\n227\t  } catch {\n228\t    return null;\n229\t  } finally {\n230\t    await rm(dir, { recursive: true, force: true });\n231\t  }\n232\t}\n233\t\n234\t/**\n235\t * Export one session as JSON. `--pure` skips external plugins, which matters\n236\t * because the capture this call belong