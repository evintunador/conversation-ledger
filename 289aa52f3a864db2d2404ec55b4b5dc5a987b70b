 process.stderr.write(`cledger: opencode +${result.appended} events (${result.deduped} deduped)\\n`);\n551\t  warnUnrecognized(\"opencode\", result.unrecognized);\n552\t  return result;\n553\t}\n554\t\n555\t/** Export one session via the opencode CLI, then capture it. */\n556\texport async function captureOpencodeSession(\n557\t  sessionId: string,\n558\t  cwd: string,\n559\t): Promise<CaptureResult> {\n560\t  const data = await exportOpencodeSession(sessionId, cwd);\n561\t  if (!data) return { appended: 0, deduped: 0, unrecognized: {} };\n562\t  return captureOpencodeExport(data, cwd);\n563\t}\n564\t\n565\t/** Capture a session from a saved `opencode export` JSON file (backfill). */\n566\texport async function captureOpencodeExportFile(\n567\t  path: string,\n568\t  cwd: string,\n569\t): Promise<CaptureResult> {\n570\t  const raw = await readFile(path, \"utf8\");\n571\t  return captureOpencodeExport(JSON.parse(raw) as OpencodeExport, cwd);\n572\t}\n573\t\n574\t/**\n575\t * Capture every session opencode associates with `cwd`'s project. Used by\n576\t * `cledger capture opencode --all`, and as the hook's fallback when the\n577\t * plugin could not tell us which session went idle.\n578\t */\n579\texport async function captureOpencodeAll(\n580\t  cwd: string,\n581\t  limit?: number,\n582\t): Promise<CaptureResult> {\n583\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n584\t  const sessions = await listOpencodeSessions(cwd);\n585\t  const ordered = [...sessions].sort((a, b) => (b.updated ?? 0) - (a.updated ?? 0));\n586\t  const selected = typeof limit === \"number\" ? ordered.slice(0, limit) : ordered;\n587\t  for (const session of selected) {\n588\t    if (typeof session.id !== \"string\" || !session.id) continue;\n589\t    const one = await captureOpencodeSession(session.id, cwd);\n590\t    total.appended += one.appended;\n591\t    total.deduped += one.deduped;\n592\t    for (const [key, count] of Object.entries(one.unrecognized)) {\n5