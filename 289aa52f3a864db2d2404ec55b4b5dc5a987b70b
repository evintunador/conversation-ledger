"source":"claude-code","source_version":"2.1.221","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","entrypoint":"cli","gitBranch":"main","isSidechain":false,"message":{"content":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { readFileSync } from \"node:fs\";\n26\timport { mkdir, mkdtemp, open, readFile, rm, writeFile } from \"node:fs/promises\";\n27\timport { tmpdir } from \"node:os\";\n28\timport { join } from \"node:path\";\n29\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n30\timport { appendEvents } from \"../store.js\";\n31\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\t\n39\tconst RAW_FORMAT = \"opencode-export-json/1\";\n40\t\n41\t/**\n42\t * Part types carrying visible conversation content.\n43\t *\n44\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n45\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n46\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n47\t * stores reasoning as plain `text`. So it converts to an ordinary\n48\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n49\t * thinking blocks do — no opacity marker, nothing withheld.\n50\t */\n51\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n52\t\n53\t/**\n54\t * Part types deliberately not captured: per-step bookkeeping (`step-start` /\n55\t * `step-finish` carry token counts and finish reasons, not content) and\n56\t * `patch`, which is a content hash plus file list pointing into opencode's\n57\t * private snapshot store — meaningless outside opencode, and the diff it\n58\t * refers to is already in git.\n59\t *\n60\t * Kept deliberately short. opencode's binary also references `file`, `agent`,\n61\t * `snapshot` and `todo` part types that no session on hand exercises; listing\n62\t * them here on speculation would silently discard content on the first\n63\t * session that used one. Leaving them out routes them through the drift path\n64\t * instead — preserved raw-only, warned about, and upgradeable later by\n65\t * `cledger renormalize`, which is exactly what that machinery is for.\n66\t */\n67\tconst KNOWN_SKIPPED_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n68\t\n69\t/**\n70\t * Tool-call states that will never change again. A `pending`/`running` part\n71\t * is still being written; capturing it would bake a half-