{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n2\timport type { RedactionRecord } from \"./redact/apply.js\";\n3\t\n4\texport const SCHEMA_VERSION = \"conversation-ledger/v1\";\n5\t\n6\t/**\n7\t * The well-known event kinds. `kind` is an open string so downstream tools\n8\t * can extend the ledger without a schema release; unknown kinds are stored\n9\t * verbatim. The ledger never interprets content, whatever the kind.\n10\t *\n11\t * `unrecognized` is the one kind the ledger emits for content it could *not*\n12\t * interpret: an adapter that meets a transcript line type it has no mapping\n13\t * for preserves the line raw-only under `raw.data` rather than dropping it,\n14\t * so a later adapter version can re-normalize (and supersede) it. Its\n15\t * `content` carries only a `{unrecognized_type}` label — the payload lives in\n16\t * `raw` — but identity still separates distinct lines via `conversation.seq`.\n17\t *\n18\t * `reasoning` is for content the ledger deliberately never interprets: a\n19\t * provider-encrypted reasoning/thinking blob (e.g. Codex's `reasoning`\n20\t * response_items) that only the originating provider can decrypt. Its\n21\t * `content` carries only an opacity marker; the ciphertext lives in `raw`,\n22\t * for a consumer to opt into replaying back through the same provider.\n23\t * Unlike `unrecognized`, this is not a placeholder awaiting a smarter\n24\t * cledger version — no future version will ever be able to read it either.\n25\t */\n26\texport const KNOWN_KINDS = [\n27\t  \"conversation_turn\",\n28\t  \"decision\",\n29\t  \"document\",\n30\t  \"annotation\",\n31\t  \"redaction\",\n32\t  \"supersession\",\n33\t  \"re_anchor\",\n34\t  \"unrecognized\",\n35\t  \"reasoning\",\n36\t] as const;\n37\t\n38\texport interface Actor {\n39\t  /** \"human\" | \"agent\" | \"system\" */\n40\t  type: string;\n41\t  /** Stable identity when known, e.g. git author email or model id. */\n42\t  id?: string;\n43\t  display?: string;\n44\t}\n45\t\n46\texport interface Producer {\n47\t  /** Capture tool that wrote this event, e.g. \"cledger\". */\n48\t  tool: string;\n49\t  /** Capture tool version. Not part of event identity. */\n50\t  version?: string;\n51\t  /** Source system the content came from, e.g. \"claude-code\", \"codex\". */\n52\t  source?: string;\n53\t  /**\n54\t   * The source system's own version — the coding CLI's version, not\n55\t   * cledger's (that is `version`), e.g. \"2.1.220\" for claude-code or\n56\t   * \"0.145.0\" for codex. Not part of event identity.\n57\t   */\n58\t  source_version?: string;\n59\t  /**\n60\t   * Model that served this turn, verbatim as the source names it, e.g.\n61\t   * \"claude-opus-5\" or \"gpt-5.6-sol\". Set only when the source states it\n62\t   * for this turn — never guessed, never carried across turns the source\n63\t   * did not label. Not part of event identity.\n64\t   */\n65\t  model?: string;\n66\t  /**\n67\t   * Inference provider serving `model`, verbatim as the source names it,\n68\t   * e.g. \"openai\". Set only when the source states it — notably *not*\n69\t   * inferred from `source` or from the model id, since the same CLI can be\n70\t   * pointed at a first-party API, a cloud reseller, or a local endpoint.\n71\t   * Not part of event identity.\n72\t   */\n73\t  provider?: string;\n74\t  /** Source system's native session identifier. */\n75\t  session_id?: string;\n76\t}\n77\t\n78\t/**\n79\t * The source-stated agent facts an adapter attaches to `producer`. Adapters\n80\t * gather these from wherever the source records them — a per-line field, a\n81\t * preceding session/turn-context line — and spread them onto every event\n82\t * they emit for that part of the transcript.\n83\t */\n84\texport type ProducerAgentContext = Pick<Producer, \"source_version\" | \"model\" | \"provider\">;\n85\t\n86\texport interface RepoContext {\n87\t  /** Best-known repository identity (origin URL or top-level dir name). */\n88\t  repo?: string;\n89\t  branch?: string;\n90\t  /** HEAD commit SHA at capture time. */\n91\t  head?: string;\n92\t  /** Working directory the conversation ran in. */\n93\t  cwd?: string;\n94\t  /** sha256 of `git status --porcelain` output when the tree was dirty. */\n95\t  dirty_fingerprint?: string;\n96\t}\n97\t\n98\texport interface ConversationRef {\n99\t  /** Namespaced conversation id, e.g. \"claude-code:<session uuid>\". */\n100\t  id: string;\n101\t  /** Stable ordering key within the conversation (source line index). */\n102\t  seq: number;\n103\t}\n104\t\n105\texport interface EventLink {\n106\t  /** e.g. \"redacts\", \"supersedes\", \"annotates\", \"replies_to\" */\n107\t  rel: string;\n108\t  /** Target event id. */\n109\t  target: string;\n110\t}\n111\t\n112\texport interface EvidenceEvent {\n113\t  /** \"ev1-\" + sha256 of the identity subset (see eventId). */\n114\t  id: string;\n115\t  schema: typeof SCHEMA_VERSION;\n116\t  kind: string;\n117\t  /** When the content happened, ISO 8601 UTC (from the source when known). */\n118\t  occurred_at: string;\n119\t  /** When this event was appended to the ledger. Not part of identity. */\n120\t  recorded_at: string;\n121\t  actor: Actor;\n122\t  producer: Producer;\n123\t  /** IANA media type of `content`; defaults to application/json. */\n124\t  media_type?: string;\n125\t  /** The visible content itself, stored inline and never reinterpreted. */\n126\t  content: unknown;\n127\t  /** Repository context at capture time. Not part of identity. */\n128\t  context?: RepoContext;\n129\t  conversation?: ConversationRef;\n130\t  links?: EventLink[];\n131\t  /**\n132\t   * Opaque source-native payload for lossless export, e.g. the original\n133\t   * transcript line(s). Versioned by `format`. Not part of identity.\n134\t   */\n135\t  raw?: { format: string; data: unknown };\n136\t  /**\n137\t   * Capture-time redaction records (rule id, ruleset version, fingerprint,\n138\t   * location path), present when the capture-tier ruleset rewrote part of\n139\t   * `content`/`raw.data` before this event was finalized. Deliberately\n140\t   * excluded from the identity subset: the rewritten `content` already\n141\t   * determines `id`, so including this here would double-count the same\n142\t   * fact and would churn ids on ruleset upgrades even when the visible\n143\t   * content is unchanged.\n144\t   */\n145\t  redactions?: RedactionRecord[];\n146\t}\n147\t\n148\t/** Fields an adapter supplies; id/schema/recorded_at are filled at append. */\n149\texport type EventDraft = Omit<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\"> &\n150\t  Partial<Pick<EvidenceEvent, \"id\" | \"schema\" | \"recorded_at\">>;\n151\t\n152\t/**\n153\t * Event identity is derived from the durable, source-determined subset so\n154\t * that re-scanning the same source material always yields the same id\n155\t * (idempotent capture). Volatile provenance — recorded_at, context, raw,\n156\t * producer.version/tool — is deliberately excluded: a re-ingestion under a\n157\t * different HEAD or adapter version must dedup, not duplicate.\n158\t *\n159\t * `producer.model`/`provider`/`source_version` are excluded for the same\n160\t * reason even though they *are* source-determined and stable per line. They\n161\t * were added after events had already been captured without them, so folding\n162\t * them into identity would give the very same transcript line a different id\n163\t * before and after the upgrade — a rescan would duplicate every pre-upgrade\n164\t * turn rather than dedup it. Identity answers \"which piece of source material\n165\t * is this\"; the model that served it is provenance about that material, not\n166\t * a second copy of it.\n167\t */\n168\texport function eventId(event: EventDraft): string {\n169\t  const identity = {\n170\t    schema: SCHEMA_VERSION,\n171\t    kind: event.kind,\n172\t    occurred_at: event.occurred_at,\n173\t    actor: { type: event.actor.type, id: event.actor.id },\n174\t    source: event.producer.source,\n175\t    session_id: event.producer.session_id,\n176\t    conversation: event.conversation,\n177\t    media_type: event.media_type,\n178\t    content: event.content,\n179\t    links: event.links,\n180\t  };\n181\t  return \"ev1-\" + sha256Hex(canonicalJson(identity));\n182\t}\n183\t\n184\texport function finalizeEvent(draft: EventDraft, now = new Date()): EvidenceEvent {\n185\t  const event: EvidenceEvent = {\n186\t    ...draft,\n187\t    id: draft.id ?? eventId(draft),\n188\t    schema: SCHEMA_VERSION,\n189\t    recorded_at: draft.recorded_at ?? now.toISOString(),\n190\t  };\n191\t  const problems = validateEvent(event);\n192\t  if (problems.length > 0) {\n193\t    throw new Error(`invalid event: ${problems.join(\"; \")}`);\n194\t  }\n195\t  return event;\n196\t}\n197\t\n198\texport function validateEvent(event: EvidenceEvent): string[] {\n199\t  const problems: string[] = [];\n200\t  if (!event.id?.startsWith(\"ev1-\")) problems.push(\"id must start with ev1-\");\n201\t  if (event.schema !== SCHEMA_VERSION) problems.push(`schema must be ${SCHEMA_VERSION}`);\n202\t  if (!event.kind) problems.push(\"kind is required\");\n203\t  if (!isIsoDate(event.occurred_at)) problems.push(\"occurred_at must be ISO 8601\");\n204\t  if (!isIsoDate(event.recorded_at)) problems.push(\"recorded_at must be ISO 8601\");\n205\t  if (!event.actor?.type) problems.push(\"actor.type is required\");\n206\t  if (!event.producer?.tool) problems.push(\"producer.tool is required\");\n207\t  if (event.content === undefined) problems.push(\"content is required\");\n208\t  return problems;\n209\t}\n210\t\n211\tfunction isIsoDate(s: unknown): boolean {\n212\t  return typeof s === \"string\" && !Number.isNaN(Date.parse(s));\n213\t}\n214\t\n215\t/** One event per line, canonical bytes — the note storage format. */\n216\texport function serializeEvent(event: EvidenceEvent): string {\n