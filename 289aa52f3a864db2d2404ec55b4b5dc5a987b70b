actor,\n410\t    producer: { tool: \"cledger\", version, source: \"opencode\", session_id: sessionId, ...agent },\n411\t    conversation: { id: `opencode:${sessionId}`, seq },\n412\t    content,\n413\t    raw: { format: RAW_FORMAT, data: rawData(info, part) },\n414\t  };\n415\t}\n416\t\n417\t/** Raw-only preservation event for an unrecognized opencode part (see drift.ts). */\n418\tfunction preserve(\n419\t  typeKey: string,\n420\t  info: OpencodeMessageInfo,\n421\t  part: OpencodePart,\n422\t  occurredAt: string,\n423\t  seq: number,\n424\t  sessionId: string,\n425\t  version: string,\n426\t  agent: ProducerAgentContext,\n427\t): EventDraft {\n428\t  return unrecognizedDraft({\n429\t    typeKey,\n430\t    line: rawData(info, part),\n431\t    occurredAt,\n432\t    source: \"opencode\",\n433\t    sessionId,\n434\t    seq,\n435\t    version,\n436\t    rawFormat: RAW_FORMAT,\n437\t    conversationId: `opencode:${sessionId}`,\n438\t    agent: { ...agent },\n439\t  });\n440\t}\n441\t\n442\t/**\n443\t * Re-normalization hook (see renormalize.ts): turn a preserved `unrecognized`\n444\t * event back into the `conversation_turn` a live capture would now produce.\n445\t *\n446\t * Id fidelity works the same way as in the claude-code and codex twins, and\n447\t * the `{info, part}` shape stored in `raw.data` is what makes it possible\n448\t * here: the message info a part needs for its role, model and time fallback\n449\t * travels with the part instead of living in a session header this path can\n450\t * no longer see. `baseTime` falls back to the preserved event's own\n451\t * `occurred_at`, which is the value the preservation path computed — so a\n452\t * part with no time of its own reconstructs to the same instant, and\n453\t * therefore the same id.\n454\t */\n455\texport function renormalizeUnrecognized(\n456\t  event: EvidenceEvent,\n457\t  identity: GitUserIdentity,\n458\t): EventDraft | null {\n459\t  if (!event.raw || event.conversation === undefined) return null;\n460\t  const stored = event.raw.data as { info?: OpencodeMessageInfo; part?: OpencodePart } | null;\n461\t  if (!stored || !stored.part) return null;\n462\t  const info = stored.info ?? {};\n463\t  const agent: ProducerAgentContext = {};\n464\t  if (event.producer.source_version) agent.source_version = event.producer.source_version;\n465\t  if (event.producer.model) agent.model = event.producer.model;\n466\t  if (event.producer.provider) agent.provider = event.producer.provider;\n467\t  return convertPart(\n468\t    info,\n469\t    stored.part,\n470\t    event.conversation.seq,\n471\t    event.producer.session_id ?? \"\",\n472\t    event.occurred_at,\n473\t    packageVersion(),\n474\t    identity,\n475\t    agent,\n476\t  );\n477\t}\n478\t\n479\t/**\n480\t * Capture a session from an already-parsed export. Split out from the\n481\t * subprocess plumbing so tests (and offline backfill from a saved export\n482\t * file) exercise the conversion without needing opencode installed.\n483\t */\n484\texport async function captureOpencodeExport(\n485\t  data: OpencodeExport,\n486\t  cwd: string,\n487\t): Promise<CaptureResult> {\n488\t  const repo = await findRepo(cwd);\n489\t  if (!repo) throw new Error(\"not inside a git repository\");\n490\t\n491\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n492\t\n493\t  const sessionId = data.info?.id;\n494\t  if (typeof sessionId !== \"string\" || !sessionId) return result;\n495\t\n496\t  // Subagent sessions are skipped, matching claude-code's treatment of\n497\t  // sidechain lines: the parent's `task` tool part already stores the child's\n498\t  // final output, so only the subagent's internal steps are missed. Capturing\n499\t  // them properly needs a way to express the parent/child relation, which is\n500\t  // a cross-adapter schema question rather than an opencode one.\n501\t  if (typeof data.info?.parentID === \"string\" && data.info.parentID) return result;\n502\t\n503\t  const flat = flatten