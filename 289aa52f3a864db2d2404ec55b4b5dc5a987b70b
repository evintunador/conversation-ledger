file. Falling back to the project's most\n    // recently touched chat keeps capture working rather than silently\n    // stopping if a future version drops the field.\n    await captureQwenAll(cwd, 1);\n  } catch (err) {\n    process.stderr.write(\n      `cledger: qwen-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n    );\n  }\n}\n\n/** Exported for tests: ensure the project chats dir exists. */\nexport async function ensureQwenProjectDir(cwd: string): Promise<string> {\n  const dir = qwenProjectChatsDir(cwd);\n  await mkdir(dir, { recursive: true });\n  return dir;\n}\n","file_path":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/qwen-code.ts"},"name":"Write","type":"tool_use"}],"role":"assistant"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","head":"289aa52f3a864db2d2404ec55b4b5dc5a987b70b","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","seq":337},"id":"ev1-175f847f981e1d656416fdf300f109ed492a16e448fcba62e952b07240a267db","kind":"conversation_turn","occurred_at":"2026-08-04T04:01:45.046Z","producer":{"model":"claude-opus-5","session_id":"8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","source":"claude-code","source_version":"2.1.221","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","effort":"high","entrypoint":"cli","gitBranch":"worktree-more-cli-adapters","isSidechain":false,"message":{"content":[{"caller":{"type":"direct"},"id":"toolu_01SVGAuNvBTsXh2Uz4KhKxbx","input":{"content":"/**\n * Qwen Code adapter.\n *\n * Qwen Code is a fork of Gemini CLI, but its conversation store is the one\n * piece it did *not* inherit: where gemini-cli keeps a replayed write-ahead\n * log (see gemini-cli.ts), Qwen 