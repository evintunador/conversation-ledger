roject's own repo.\n */\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { mkdtemp, rm } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { git, findRepo, type RepoInfo } from \"../git.js\";\nimport { finalizeEvent, type EventDraft, type EvidenceEvent } from \"../schema.js\";\n\n/**\n * Isolate every test process from the developer's real home directory.\n *\n * loadConfig() reads user-level config at `~/.config/cledger/config.json` via\n * os.homedir() (which honors $HOME on POSIX), so a developer who has, say,\n * `redact.knownSecrets` enabled globally would silently change test behavior\n * — tests asserting *default* behavior would exercise an opt-in layer and\n * fail, and worse, tests could pass or fail depending on whose machine ran\n * them. The node test runner gives each test *file* its own process, so\n * setting HOME at module load is safe and scoped to that file.\n */\nconst ISOLATED_HOME = mkdtempSync(join(tmpdir(), \"cledger-test-home-\"));\nprocess.env.HOME = ISOLATED_HOME;\nprocess.on(\"exit\", () => {\n  try {\n    rmSync(ISOLATED_HOME, { recursive: true, force: true });\n  } catch {\n    /* best effort */\n  }\n});\n\n/** Create a fresh repo under the OS temp dir, with local git identity set. */\nexport async function makeTempRepo(prefix = \"cledger-test-\"): Promise<RepoInfo> {\n  const dir = await mkdtemp(join(tmpdir(), prefix));\n  await git([\"init\", \"-q\", \"-b\", \"main\"], { cwd: dir });\n  await git([\"config\", \"user.email\", \"test@example.com\"], { cwd: dir });\n  await git([\"config\", \"user.name\", \"Test User\"], { cwd: dir });\n  await git([\"config\", \"commit.gpgsign\", \"false\"], { cwd: dir });\n  const repo = await findRepo(dir);\n  if (!repo) throw new Error(\"failed to initialize temp repo\");\n  return repo;\n}\n\n/** Create a bare repo under the OS temp dir, for use as a sync remote. */\nexport async function makeBareRepo(prefix = \"cledger-remote-\"): Promise<string> {\n  const dir = await mkdtemp(join(tmpdir(), prefix));\n  await git([\"init\", \"-q\", \"--bare\", \"-b\", \"main\"], { cwd: dir });\n  return dir;\n}\n\n/** Recursively remove a temp repo/dir. Safe no-op if already gone. */\nexport async function cleanupDir(dir: string): Promise<void> {\n  await rm(dir, { recursive: true, force: true });\n}\n\nexport async function cleanupRepo(repo: RepoInfo): Promise<void> {\n  await cleanupDir(repo.root);\n}\n\n/** Create a commit (empty by default) and return its SHA. */\nexport async function makeCommit(repo: RepoInfo, message = \"commit\"): Promise<string> {\n  await git([\"commit\", \"--allow-empty\", \"-q\", \"-m\", message], { cwd: repo.root });\n  return (await git([\"rev-parse\", \"HEAD\"], { cwd: repo.root })).trim();\n}\n\n/** Build a minimal, valid EventDraft with sensible defaults, override at will. */\nexport function draft(overrides: Partial<EventDraft> = {}): EventDraft {\n  const base: EventDraft = {\n    kind: \"conversation_turn\",\n    occurred_at: \"2026-01-01T00:00:00.000Z\",\n    actor: { type: \"human\" },\n    producer: { tool: \"cledger\" },\n    content: { text: \"hello\" },\n  };\n  return { ...base, ...overrides };\n}\n\n/** Build a fully finalized event from overrides (id/schema/recorded_at auto-filled). */\nexport function event(overrides: Partial<EventDraft> = {}, now?: Date): EvidenceEvent {\n  return finalizeEvent(draft(overrides), now);\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/test/helpers.ts","numLines":86,"startLine":1,"totalLines":86},"type":"text"},"type":"user","userType":"external","uuid":"4a5ee8b5-2bc6-4ba1-a868-dc23fec7d6a9","version":"2.1.221"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-04T04:51:56.332Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { readFileSync } from \"node:fs\";\n26\timport { mkdir, mkdtemp, open, readFile, rm, writeFile } from \"node:fs/promises\";\n27\timport { tmpdir } from \"node:os\";\n28\timport { join } from \"node:path\";\n29\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n30\timport { appendEvents } from \"../store.js\";\n31\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\t\n39\tconst RAW_FORMAT = \"opencode-export-json/1\";\n40\t\n41\t/**\n42\t * Part types carrying visible conversation content.\n43\t *\n44\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n45\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n46\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n47\t * stores reasoning as plain `text`. So it converts to an ordinary\n48\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n49\t * thinking blocks do — no opacity marker, nothing withheld.\n50\t */\n51\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n52\t\n53\t/**\n54\t * Part types deliberately not captured: per-step bookkeeping (`step-start` /\n55\t * `step-finish` carry token counts and finish reasons, not content) and\n56\t * `patch`, which is a content hash plus file list pointing into opencode's\n57\t * private snapshot store — meaningless outside opencode, and the diff it\n58\t * refers to is already in git.\n59\t *\n60\t * Kept deliberately short. opencode's binary also references `file`, `agent`,\n61\t * `snapshot` and `todo` part types that no session on hand exercises; listing\n62\t * them here on speculation would silently discard content on the first\n63\t * session that used one. Leaving them out routes them through the drift path\n64\t * instead — preserved raw-only, warned about, and upgradeable later by\n65\t * `cledger renormalize`, which is exactly what that machinery is for.\n66\t */\n67\tconst KNOWN_SKIPPED_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n68\t\n69\t/**\n70\t * Tool-call states that will never change again. A `pending`/`running` part\n71\t * is still being written; capturing it would bake a half-finished tool call\n72\t * into an immutable event id. The capture loop skips unsettled parts *and*\n73\t * holds the cursor back at the first one, so the finished version is picked\n74\t * up on the next capture rather than being skipped forever.\n75\t */\n76\tconst SETTLED_TOOL_STATUSES = new Set([\"completed\", \"error\"]);\n77\t\n78\t/** Payload the installed opencode plugin sends on stdin (see install.ts). */\n79\tinterface OpencodeHookPayload {\n80\t  session_id?: string;\n81\t  cwd?: string;\n82\t  hook_event_name?: string;\n83\t}\n84\t\n85\tinterface OpencodeSessionInfo {\n86\t  id?: string;\n87\t  /** Set on subagent sessions; those are skipped (see captureOpencodeExport). */\n88\t  parentID?: string;\n89\t  directory?: string;\n90\t  title?: string;\n91\t  /** opencode's own CLI version, e.g. \"1.18.5\". */\n92\t  version?: string;\n93\t  time?: { created?: number; updated?: number };\n94\t}\n95\t\n96\tinterface OpencodeMessageInfo {\n97\t  id?: string;\n98\t  sessionID?: string;\n99\t  role?: string;\n100\t  /** Agent persona, e.g. \"build\" / \"plan\". */\n101\t  agent?: string;\n102\t  mode?: string;\n103\t  /** Assistant messages state the model flat; user messages nest it. */\n104\t  modelID?: string;\n105\t  providerID?: string;\n106\t  model?: { modelID?: string; providerID?: string };\n107\t  time?: { created?: number; completed?: number };\n108\t}\n109\t\n110\tinterface OpencodePart {\n111\t  id?: string;\n112\t  type?: string;\n113\t  messageID?: string;\n114\t  sessionID?: string;\n115\t  text?: string;\n116\t  tool?: string;\n117\t  callID?: string;\n118\t  state?: {\n119\t    status?: string;\n120\t    input?: unknown;\n121\t    output?: unknown;\n122\t    error?: unknown;\n123\t    time?: { start?: number; end?: number };\n124\t  };\n125\t  time?: { start?: number; end?: number };\n126\t}\n127\t\n128\tinterface OpencodeMessage {\n129\t  info?: OpencodeMessageInfo;\n130\t  parts?: OpencodePart[];\n131\t}\n132\t\n133\texport interface OpencodeExport {\n134\t  info?: OpencodeSessionInfo;\n135\t  messages?: OpencodeMessage[];\n136\t}\n137\t\n138\t/** What `opencode session list --format json` returns, per row. */\n139\tinterface OpencodeSessionRow {\n140\t  id?: string;\n141\t  title?: string;\n142\t  directory?: string;\n143\t  updated?: number;\n144\t}\n145\t\n146\t/** One part, paired with the message that owns it and its session position. */\n147\tinterface FlatPart {\n148\t  info: OpencodeMessageInfo;\n149\t  part: OpencodePart;\n150\t  seq: number;\n151\t}\n152\t\n153\tfunction packageVersion(): string {\n154\t  try {\n155\t    const pkg = JSON.parse(\n156\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n157\t    ) as { version?: string };\n158\t    return pkg.version ?? \"0.1.0\";\n159\t  } catch {\n160\t    return \"0.1.0\";\n161\t  }\n162\t}\n163\t\n164\tfunction sanitizeId(id: string): string {\n165\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n166\t}\n167\t\n168\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n169\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n170\t}\n171\t\n172\tasync function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n173\t  try {\n174\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n175\t    const data = JSON.parse(raw) as { parts?: number };\n176\t    return typeof data.parts === \"number\" ? data.parts : 0;\n177\t  } catch {\n178\t    return 0;\n179\t  }\n180\t}\n181\t\n182\tasync function writeCursor(repo: RepoInfo, sessionId: string, parts: number): Promise<void> {\n183\t  const path = cursorPath(repo, sessionId);\n184\t  await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n185\t  await writeFile(path, JSON.stringify({ parts }) + \"\\n\");\n186\t}\n187\t\n188\t/** opencode stores times as epoch milliseconds; the ledger wants ISO 8601. */\n189\tfunction isoFromMs(ms: unknown): string | null {\n190\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n191\t  const date = new Date(ms);\n192\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n193\t}\n194\t\n195\t/**\n196\t * Run an opencode subcommand and return its stdout.\n197\t *\n198\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n199\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n200\t * silently lost — a large session's export still parses as JSON right up to\n201\t * the truncation point in some cases, which would quietly capture a partial\n202\t * conversation. Writing to a real file descriptor returns the full output.\n203\t *\n204\t * Returns null when opencode is not installed or the command fails; every\n205\t * caller treats that as \"nothing to capture\" rather than an error, so a\n206\t * missing opencode never breaks a hook.\n207\t */\n208\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n209\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n210\t  const path = join(dir, \"out.json\");\n211\t  try {\n212\t    const handle = await open(path, \"w\");\n213\t    try {\n214\t      const code = await new Promise<number | null>((resolve, reject) => {\n215\t        const child = spawn(\"opencode\", args, {\n216\t          cwd,\n217\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n218\t        });\n219\t        child.on(\"error\", reject);\n220\t        child.on(\"close\", resolve);\n221\t      });\n222\t      if (code !== 0) return null;\n223\t    } finally {\n224\t      await handle.close();\n225\t    }\n226\t    return await readFile(path, \"utf8\");\n227\t  } catch {\n228\t    return null;\n229\t  } finally {\n230\t    await rm(dir, { recursive: true, force: true });\n231\t  }\n232\t}\n233\t\n234\t/**\n235\t * Export one session as JSON. `--pure` skips external plugins, which matters\n236\t * because the capture this call belongs to was very likely triggered *by* an\n237\t * opencode plugin — loading that plugin again inside the export would invite\n238\t * re-entrancy.\n239\t */\n240\texport async function exportOpencodeSession(\n241\t  sessionId: string,\n242\t  cwd: string,\n243\t): Promise<OpencodeExport | null> {\n244\t  const stdout = await runOpencode([\"export\", \"--pure\", sessionId], cwd);\n245\t  if (!stdout) return null;\n246\t  try {\n247\t    return JSON.parse(stdout) as OpencodeExport;\n248\t  } catch {\n249\t    return null;\n250\t  }\n251\t}\n252\t\n253\t/**\n254\t * List opencode sessions. opencode scopes this to the project containing\n255\t * `cwd`, which is exactly the scoping a repo-local capture wants — a sweep\n256\t * never reaches into conversations that belong to other checkouts.\n257\t */\n258\texport async function listOpencodeSessions(cwd: string): Promise<OpencodeSessionRow[]> {\n259\t  const stdout = await runOpencode([\"session\", \"list\", \"--pure\", \"--format\", \"json\"], cwd);\n260\t  if (!stdout) return [];\n261\t  try {\n262\t    const parsed = JSON.parse(stdout) as unknown;\n263\t    return Array.isArray(parsed) ? (parsed as OpencodeSessionRow[]) : [];\n264\t  } catch {\n265\t    return [];\n266\t  }\n267\t}\n268\t\n269\t/**\n270\t * The agent facts a message states about itself. opencode labels every\n271\t * message with its model and provider — including *user* messages, which\n272\t * carry the model selected to answer them. That is a genuine difference from\n273\t * claude-code, where a user line states no model and none is invented; here\n274\t * the source does state it, so it is recorded, per `Producer.model`'s rule of\n275\t * \"set only when the source states it for this turn\".\n276\t *\n277\t * `providerID` is opencode's *config* provider key (e.g. \"ds4\", \"local-mlx\"),\n278\t * which the user names themselves rather than a canonical vendor name. It is\n279\t * passed through verbatim anyway — the schema asks for the provider as the\n280\t * source names it, and rewriting it would be interpretation.\n281\t */\n282\tfunction agentContext(info: OpencodeMessageInfo, sessionVersion?: string): ProducerAgentContext {\n283\t  const agent: ProducerAgentContext = {};\n284\t  if (sessionVersion) agent.source_version = sessionVersion;\n285\t  const model = info.modelID ?? info.model?.modelID;\n286\t  if (typeof model === \"string\" && model) agent.model = model;\n287\t  const provider = info.providerID ?? info.model?.providerID;\n288\t  if (typeof provider === \"string\" && provider) agent.provider = provider;\n289\t  return agent;\n290\t}\n291\t\n292\t/**\n293\t * When this part happened: its own start time, else the message's creation\n294\t * time, else the session base time. Every step is a pure function of the\n295\t * export, so rescans and re-normalization land on the same value — which\n296\t * matters because `occurred_at` is part of event identity.\n297\t */\n298\tfunction partTime(info: OpencodeMessageInfo, part: OpencodePart, baseTime: string): string {\n299\t  return (\n300\t    isoFromMs(part.time?.start) ??\n301\t    isoFromMs(part.state?.time?.start) ??\n302\t    isoFromMs(info.time?.created) ??\n303\t    baseTime\n304\t  );\n305\t}\n306\t\n307\t/** Flatten messages into parts, numbering every part in export order. */\n308\tfunction flattenParts(data: OpencodeExport): FlatPart[] {\n309\t  const flat: FlatPart[] = [];\n310\t  let seq = 0;\n311\t  for (const message of data.messages ?? []) {\n312\t    const info = message.info ?? {};\n313\t    for (const part of message.parts ?? []) {\n314\t      flat.push({ info, part, seq });\n315\t      seq++;\n316\t    }\n317\t  }\n318\t  return flat;\n319\t}\n320\t\n321\t/**\n322\t * `raw.data` for one part. The part alone would be lossy: it carries ids but\n323\t * no role, model, or timing for the message that owns it, so an exported\n324\t * event could not be replayed without the rest of the session. Pairing it\n325\t * with its message info keeps every event independently lossless, at the cost\n326\t * of repeating a small object across the parts of one message.\n327\t */\n328\tfunction rawData(info: OpencodeMessageInfo, part: OpencodePart): unknown {\n329\t  return { info, part };\n330\t}\n331\t\n332\t/**\n333\t * True when a part carries nothing a reader would see. Empty text and\n334\t * reasoning parts do occur (a step that produced only a tool call, say), and\n335\t * emitting an event whose only block is an empty string adds a line to\n336\t * `cledger log` that says nothing.\n337\t */\n338\tfunction isEmptyText(part: OpencodePart): boolean {\n339\t  return typeof part.text !== \"string\" || part.text.trim() === \"\";\n340\t}\n341\t\n342\t/** Whether a tool part has reached a state that will not change again. */\n343\tfunction isSettledTool(part: OpencodePart): boolean {\n344\t  const status = part.state?.status;\n345\t  return typeof status === \"string\" && SETTLED_TOOL_STATUSES.has(status);\n346\t}\n347\t\n348\tfunction convertPart(\n349\t  info: OpencodeMessageInfo,\n350\t  part: OpencodePart,\n351\t  seq: number,\n352\t  sessionId: string,\n353\t  baseTime: string,\n354\t  version: string,\n355\t  identity: GitUserIdentity,\n356\t  agent: ProducerAgentContext,\n357\t): EventDraft | null {\n358\t  const type = part.type;\n359\t  if (typeof type !== \"string\" || !CONVERTIBLE_PART_TYPES.has(type)) return null;\n360\t\n361\t  const role = typeof info.role === \"string\" ? info.role : \"assistant\";\n362\t  const isHuman = role === \"user\" && type === \"text\";\n363\t\n364\t  const actor: Actor = isHuman ? { type: \"human\" } : { type: \"agent\" };\n365\t  if (isHuman) {\n366\t    if (identity.email) actor.id = identity.email;\n367\t    if (identity.name) actor.display = identity.name;\n368\t  } else if (agent.model) {\n369\t    actor.id = agent.model;\n370\t  }\n371\t\n372\t  let blocks: unknown[];\n373\t  if (type === \"text\") {\n374\t    if (isEmptyText(part)) return null;\n375\t    blocks = [{ type: \"text\", text: part.text }];\n376\t  } else if (type === \"reasoning\") {\n377\t    if (isEmptyText(part)) return null;\n378\t    blocks = [