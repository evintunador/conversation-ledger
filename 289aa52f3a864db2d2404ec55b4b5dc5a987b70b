unning, and where\n * a source's per-session capture cursor lives.\n *\n * Cursors are a pure optimization — event ids are idempotent, so a full\n * rescan dedups rather than duplicating — but they are also the reason a\n * hook that fires after every turn stays cheap on a long transcript. They\n * live under the repo's *common* git dir (see git.ts) so every worktree of a\n * checkout shares one capture position.\n *\n * `field` is the JSON key the count is stored under. It differs per adapter\n * (`lines` for the two append-only transcript formats, `parts` for opencode,\n * `messages` for gemini-cli) because the unit being counted differs, and\n * because renaming it would silently reset every existing cursor on disk to\n * zero — harmless, but a needless full rescan of every session.\n */\nimport { readFileSync } from \"node:fs\";\nimport { mkdir, readFile, writeFile } from \"node:fs/promises\";\nimport { join } from \"node:path\";\nimport type { RepoInfo } from \"../git.js\";\n\nexport function packageVersion(): string {\n  try {\n    const pkg = JSON.parse(\n      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n    ) as { version?: string };\n    return pkg.version ?? \"0.1.0\";\n  } catch {\n    return \"0.1.0\";\n  }\n}\n\n/** Session ids are used as filenames; keep them to a portable character set. */\nexport function sanitizeId(id: string): string {\n  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n}\n\nfunction cursorDir(repo: RepoInfo): string {\n  return join(repo.commonDir, \"conversation-ledger\", \"cursors\");\n}\n\nexport function cursorPath(repo: RepoInfo, sessionId: string): string {\n  return join(cursorDir(repo), `${sanitizeId(sessionId)}.json`);\n}\n\nexport async function readCursor(\n  repo: RepoInfo,\n  sessionId: string,\n  field: string,\n): Promise<number> {\n  try {\n    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n    const data = JSON.parse(raw) as Record<string, unknown>;\n    const value = data[field];\n    return typeof value === \"number\" ? value : 0;\n  } catch {\n    return 0;\n  }\n}\n\nexport async function writeCursor(\n  repo: RepoInfo,\n  sessionId: string,\n  field: string,\n  count: number,\n): Promise<void> {\n  await mkdir(cursorDir(repo), { recursive: true });\n  await writeFile(cursorPath(repo, sessionId), JSON.stringify({ [field]: count }) + \"\\n\");\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/common.ts","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"7e055936-3de2-4b8d-a96c-2f5e0fb05c0c","version":"2.1.221"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-04T04:51:56.332Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"File created successfully at: /Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/gemini-cli.ts (file state is current in your context — no need to Read it back)","tool_use_id":"toolu_01Dx13GjLUSP1cBccS2gUeKg","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-more-cli-adapters","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","head":"289aa52f3a864db2d2404ec55b4b5dc5a987b70b","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","seq":360},"id":"ev1-8af3fbf339d510424b6270633e99cc870cd38cc1cf785e9db5879853e1efd728","kind":"conversation_turn","occurred_at":"2026-08-04T04:04:14.071Z","producer":{"session_id":"8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","source":"claude-code","source_version":"2.1.221","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters","entrypoint":"cli","gitBranch":"worktree-more-cli-adapters","isSidechain":false,"message":{"content":[{"content":"File created successfully at: /Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/more-cli-adapters/src/adapters/gemini-cli.ts (file state is current in your context — no need to Read it back)","tool_use_id":"toolu_01Dx13GjLUSP1cBccS2gUeKg","type":"tool_result"}],"role":"user"},"parentUuid":"2980c94c-7eaa-4cf6-8522-ce8335af80dd","promptId":"858cf12d-fe5d-478c-9e0f-f59f65477832","sessionId":"8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","sessionKind":"bg","session_id":"8f1a9339-b2b4-4bad-b2a9-3123e47d2a77","sourceToolAssistantUUID":"2980c94c-7eaa-4cf6-8522-ce8335af80dd","timestamp":"2026-08-04T04:04:14.071Z","toolUseResult":{"content":"/**\n * Gemini CLI adapter.\n *\n * Gemini CLI records a session to `~/.gemini/tmp/<project>/chats/session-<ts>-<id>.jsonl`,\n * and the hook payload hands us that path directly. The file is append-only on\n * disk but it is *not* a transcript: it is a write-ahead log of mutations to a\n * single conversation document, and a line's meaning depends on every line\n * before it. Four record forms exist, discriminated exactly as Gemini CLI's own\n * `loadConversationRecord` discriminates them, and in this precedence order:\n *\n *  1. `{\"$rewindTo\": \"<message id>\"}` — the user rewound; that message and\n *     every message after it are removed from the document. An unknown id\n *     clears the document entirely.\n *  2. a bare message object (identified by a string `id`) — upsert by id.\n *     Re-appending an existing id *replaces* it, which is how a model turn\n *     grows its `toolCalls` as tools run.\n *  3. `{\"$set\": {...}}` — metadata patch. When it carries a `messages` array\n *     it replaces the entire message list.\n *  4. the header (`sessionId` + `projectHash`), which may itself carry a\n *     `messages` array.\n *\n * Two consequences drive this adapter's design.\n *\n * **Ordering key.** A positional index over the replayed document is not\n * stable: a rewind deletes messages out of the middle and everything after\n * would renumber, re-capturing under new ids (the defect the opencode adapter\n * documents and accepts). Gemini messages carry durable string ids, so `seq`\n * is instead assigned by *first sighting in the file* and remembered even for\n * messages a later rewind removes. Numbers are never reused, so a rewind\n * cannot renumber a surviving message, and a rescan of the same file always\n * lands on the same value.\n *\n * **Settledness.** Because re-appending an id replaces the message, a model\n * turn is mutable while its tools run: capturing it early would freeze a\n * half-finished tool call into an immutable event id. A message whose\n * `toolCalls` contain one that has neither a result nor a terminal status is\n * therefore skipped, and holds the cursor back so the finished version is\n * picked up next time.\n */\nimport { readFile, readdir, stat } from \"node:fs/promises\";\nimport { homedir } from \"node:os\";\nimport { basename, join } from \"node:path\";\nimport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\nimport { appendEvents } from \"../store.js\";\nimport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\nimport { packageVersion, readCursor, writeCursor } from \"./common.js\";\nimport { convertParts, ensurePartArray, isEmptyParts } from \"./genai-parts.js\";\nimport {\n  countUnrecognized,\n  unrecognizedDraft,\n  warnUnrecognized,\n  type CaptureResult,\n} from \"./drift.js\";\n\nconst RAW_FORMAT = \"gemini-cli-chatlog/1\";\n\nconst CURSOR_FIELD = \"messages\";\n\n/** Message types carrying visible conversation content. */\nconst CONVERTIBLE_MESSAGE_TYPES = new Set([\"user\", \"gemini\"]);\n\n/**\n * Message types deliberately not captured: transient UI notices Gemini CLI\n * itself excludes from conversation history (`convertSessionToClientHistory`\n * skips exactly these three). They are chrome — \"quota exceeded\", \"switched\n * model\" — rather than anything a participant said.\n *\n * Confirmed against Gemini CLI 0.53.1's sources rather than guessed, which is\n * the bar for this set: any type *not* listed here routes through the drift\n * path instead, preserved raw-only and warned about, so a record type a\n * future version adds is never silently dropped.\n */\nconst KNOWN_SKIPPED_MESSAGE_TYPES = new Set([\"info\", \"error\", \"warning\"]);\n\n/**\n * Tool-call states that will never change again. A call with a `result` is\n * settled whatever its status says; one with neither is still running.\n */\nconst SETTLED_TOOL_STATUSES = new Set([\"success\", \"error\", \"cancelled\", \"canceled\"]);\n\n/**\n * Prefixes Gemini CLI uses to inject harness-generated text as a `user`\n * message: the session preamble it builds at startup, and the text a hook\n * contributes. They are recorded as user turns because that is the API role\n * they occupy, but the person at the keyboard did not write them, so they are\n * attributed to `system` rather than carrying the git identity. Slash commands\n * (`/help`) — which Gemini also filters out of its own resume history — *are*\n * attributed to the human, because the human typed them.\n */\nconst HARNESS_USER_PREFIXES = [\"<session_context>\", \"<hook_context>\"];\n\n/** Payload Gemini CLI's hooks engine sends on stdin (subset we read). */\ninterface GeminiHookPayload {\n  session_id?: string;\n  transcript_path?: string;\n  cwd?: string;\n  hook_event_name?: string;\n}\n\ninterface GeminiThought {\n  subject?: string;\n  description?: string;\n  timestamp?: string;\n}\n\ninterface GeminiToolCall {\n  id?: string;\n  name?: string;\n  args?: unknown;\n  result?: unknown;\n  status?: string;\n  displayName?: string;\n  description?: string;\n}\n\n/** One message inside the replayed conversation document. */\ninterface GeminiMessage {\n  id?: string;\n  timestamp?: string;\n  type?: string;\n  /** `PartListUnion`: a string, one Part, or a Part array. */\n  content?: unknown;\n  displayContent?: unknown;\n  thoughts?: GeminiThought[];\n  toolCalls?: GeminiToolCall[];\n  tokens?: unknown;\n  model?: string;\n}\n\n/** Session-level metadata accumulated from header and `$set` records. */\ninterface GeminiSessionMetadata {\n  sessionId?: string;\n  projectHash?: string;\n  startTime?: string;\n  lastUpdated?: string;\n  kind?: string;\n}\n\n/** A replayed message plus the ordering key assigned at first sighting. */\ninterface OrderedMessage {\n  message: GeminiMessage;\n  seq: number;\n}\n\nexport interface GeminiSession {\n  metadata: GeminiSessionMetadata;\n  messages: OrderedMessage[];\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof v