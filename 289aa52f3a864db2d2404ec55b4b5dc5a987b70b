{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\timport { readFileSync } from \"node:fs\";\n2\timport { mkdir, readFile, stat, writeFile } from \"node:fs/promises\";\n3\timport { basename, join } from \"node:path\";\n4\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n5\timport { appendEvents } from \"../store.js\";\n6\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n7\timport {\n8\t  countUnrecognized,\n9\t  unrecognizedDraft,\n10\t  warnUnrecognized,\n11\t  type CaptureResult,\n12\t} from \"./drift.js\";\n13\t\n14\tconst CONVERTIBLE_LINE_TYPES = new Set([\"user\", \"assistant\"]);\n15\t\n16\tconst RAW_FORMAT = \"claude-code-jsonl/1\";\n17\t\n18\t/**\n19\t * Line types we deliberately do not capture: session bookkeeping, UI state,\n20\t * and file-history machinery, not visible conversation content. A parsed\n21\t * line whose type is in neither set is *unrecognized* — likely new upstream\n22\t * content — and gets counted for the drift warning.\n23\t */\n24\tconst KNOWN_SKIPPED_LINE_TYPES = new Set([\n25\t  \"system\",\n26\t  \"summary\",\n27\t  \"progress\",\n28\t  \"attachment\",\n29\t  \"mode\",\n30\t  \"permission-mode\",\n31\t  \"ai-title\",\n32\t  \"last-prompt\",\n33\t  \"queue-operation\",\n34\t  \"file-history-snapshot\",\n35\t  \"file-history-delta\",\n36\t]);\n37\t\n38\t/** Claude Code hooks-engine payload (subset we read). */\n39\tinterface ClaudeCodeHookPayload {\n40\t  session_id?: string;\n41\t  transcript_path?: string;\n42\t  cwd?: string;\n43\t  hook_event_name?: string;\n44\t}\n45\t\n46\t/** One line of a `~/.claude/projects/<escaped-cwd>/<session-id>.jsonl` transcript. */\n47\tinterface ClaudeTranscriptLine {\n48\t  type?: string;\n49\t  isSidechain?: boolean;\n50\t  message?: {\n51\t    role?: string;\n52\t    model?: string;\n53\t    content?: unknown;\n54\t  };\n55\t  uuid?: string;\n56\t  parentUuid?: string;\n57\t  sessionId?: string;\n58\t  timestamp?: string;\n59\t  cwd?: string;\n60\t  gitBranch?: string;\n61\t  version?: string;\n62\t}\n63\t\n64\tfunction packageVersion(): string {\n65\t  try {\n66\t    const pkg = JSON.parse(\n67\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n68\t    ) as { version?: string };\n69\t    return pkg.version ?? \"0.1.0\";\n70\t  } catch {\n71\t    return \"0.1.0\";\n72\t  }\n73\t}\n74\t\n75\tfunction sanitizeId(id: string): string {\n76\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n77\t}\n78\t\n79\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n80\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n81\t}\n82\t\n83\tasync function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n84\t  try {\n85\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n86\t    const data = JSON.parse(raw) as { lines?: number };\n87\t    return typeof data.lines === \"number\" ? data.lines : 0;\n88\t  } catch {\n89\t    return 0;\n90\t  }\n91\t}\n92\t\n93\tasync function writeCursor(repo: RepoInfo, sessionId: string, lines: number): Promise<void> {\n94\t  const path = cursorPath(repo, sessionId);\n95\t  await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n96\t  await writeFile(path, JSON.stringify({ lines }) + \"\\n\");\n97\t}\n98\t\n99\tfunction convertContentBlocks(content: unknown): unknown[] {\n100\t  if (typeof content === \"string\") return [{ type: \"text\", text: content }];\n101\t  if (!Array.isArray(content)) return [];\n102\t  return content.map(convertBlock);\n103\t}\n104\t\n105\tfunction convertBlock(block: unknown): unknown {\n106\t  if (!block || typeof block !== \"object\") return block;\n107\t  const b = block as Record<string, unknown>;\n108\t  if (b[\"type\"] === \"thinking\") {\n109\t    // signature is a provider-internal verification token, not visible content\n110\t    return { type: \"thinking\", text: b[\"thinking\"] };\n111\t  }\n112\t  // text / tool_use / tool_result / unknown block shapes pass through verbatim\n113\t  return b;\n114\t}\n115\t\n116\t/**\n117\t * A deterministic session time for preserving unrecognized lines that carry\n118\t * no timestamp of their own: the first timestamp anywhere in the transcript\n119\t * (stable across rescans), falling back to the file mtime. Claude lines\n120\t * almost always carry a timestamp, so this is a rarely-hit safety net.\n121\t */\n122\tfunction firstTimestamp(lines: string[]): string | null {\n123\t  for (const text of lines) {\n124\t    if (!text.trim()) continue;\n125\t    try {\n126\t      const parsed = JSON.parse(text) as ClaudeTranscriptLine;\n127\t      if (typeof parsed.timestamp === \"string\" && !Number.isNaN(Date.parse(parsed.timestamp))) {\n128\t        return parsed.timestamp;\n129\t      }\n130\t    } catch {\n131\t      continue;\n132\t    }\n133\t  }\n134\t  return null;\n135\t}\n136\t\n137\t/** File mtime as ISO, else now — last-resort deterministic-ish base time. */\n138\tasync function sessionMtime(transcriptPath: string): Promise<string> {\n139\t  try {\n140\t    return (await stat(transcriptPath)).mtime.toISOString();\n141\t  } catch {\n142\t    return new Date().toISOString();\n143\t  }\n144\t}\n145\t\n146\t/**\n147\t * The agent facts this line states about itself. Claude Code stamps every\n148\t * transcript line with the CLI `version`, and labels assistant lines with the\n149\t * model that produced them; user lines carry no model, and none is invented\n150\t * for them — the model that will answer a prompt is not knowable from the\n151\t * prompt's own line, and the session's model can change mid-conversation.\n152\t * The provider is never stated (the same CLI can talk to the first-party API,\n153\t * Bedrock, or Vertex), so `provider` is left unset rather than assumed.\n154\t *\n155\t * Values pass through verbatim, including Claude Code's `\"<synthetic>\"`\n156\t * placeholder for harness-generated assistant messages: that is a true and\n157\t * useful statement about the turn (\"no model produced this\"), and rewriting\n158\t * it would be interpretation.\n159\t */\n160\tfunction agentContext(line: ClaudeTranscriptLine): ProducerAgentContext {\n161\t  const agent: ProducerAgentContext = {};\n162\t  if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n163\t  const model = line.message?.model;\n164\t  if (typeof model === \"string\" && model) agent.model = model;\n165\t  return agent;\n166\t}\n167\t\n168\t/** Raw-only preservation event for an unrecognized claude-code line (see drift.ts). */\n169\tfunction preserve(\n170\t  type: string,\n171\t  line: ClaudeTranscriptLine,\n172\t  occurredAt: string,\n173\t  seq: number,\n174\t  fileSessionId: string,\n175\t  version: string,\n176\t): EventDraft {\n177\t  const sessionId = line.sessionId ?? fileSessionId;\n178\t  return unrecognizedDraft({\n179\t    typeKey: type,\n180\t    line,\n181\t    occurredAt,\n182\t    source: \"claude-code\",\n183\t    sessionId,\n184\t    seq,\n185\t    version,\n186\t    rawFormat: RAW_FORMAT,\n187\t    conversationId: `claude-code:${sessionId}`,\n188\t    agent: agentContext(line),\n189\t  });\n190\t}\n191\t\n192\tfunction convertLine(\n193\t  line: ClaudeTranscriptLine,\n194\t  seq: number,\n195\t  version: string,\n196\t  identity: GitUserIdentity,\n197\t): EventDraft | null {\n198\t  if (line.type !== \"user\" && line.type !== \"assistant\") return null;\n199\t  if (line.isSidechain === true) return null;\n200\t  if (!line.message) return null;\n201\t  if (typeof line.timestamp !== \"string\") return null;\n202\t  const sessionId = line.sessionId ?? \"\";\n203\t\n204\t  const actor: Actor = line.type === \"user\" ? { type: \"human\" } : { type: \"agent\" };\n205\t  if (line.type === \"user\") {\n206\t    if (identity.email) actor.id = identity