sion: turnDraft.producer.version } : {}),\n        ...(event.producer.source ? { source: event.producer.source } : {}),\n        ...(event.producer.session_id ? { session_id: event.producer.session_id } : {}),\n      },\n      content: {\n        superseded: event.id,\n        by: turnId,\n        reason: \"renormalized\",\n        ...(event.raw?.format ? { raw_format: event.raw.format } : {}),\n      },\n      links: [link],\n    };\n    if (event.conversation) supersessionDraft.conversation = event.conversation;\n    drafts.push(supersessionDraft);\n  }\n\n  if (drafts.length > 0) {\n    const appended = await appendEvents(repo, drafts);\n    for (const e of appended.appended) {\n      if (e.kind === \"conversation_turn\") result.turnsAppended++;\n      else if (e.kind === \"supersession\") result.supersessionsAppended++;\n    }\n  }\n  return result;\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/capture-everything/src/renormalize.ts","numLines":151,"startLine":1,"totalLines":151},"type":"text"},"type":"user","userType":"external","uuid":"e6122083-5cee-416f-903b-28b2c6a18139","version":"2.1.221"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-04T04:15:06.048Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { readFileSync } from \"node:fs\";\n26\timport { mkdir, mkdtemp, open, readFile, rm, writeFile } from \"node:fs/promises\";\n27\timport { tmpdir } from \"node:os\";\n28\timport { join } from \"node:path\";\n29\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n30\timport { appendEvents } from \"../store.js\";\n31\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\t\n39\tconst RAW_FORMAT = \"opencode-export-json/1\";\n40\t\n41\t/**\n42\t * Part types carrying visible conversation content.\n43\t *\n44\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n45\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n46\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n47\t * stores reasoning as plain `text`. So it converts to an ordinary\n48\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n49\t * thinking blocks do — no opacity marker, nothing withheld.\n50\t */\n51\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n52\t\n53\t/**\n54\t * Part types deliberately not captured: per-step bookkeeping (`step-start` /\n55\t * `step-finish` carry token counts and finish reasons, not content) and\n56\t * `patch`, which is a content hash plus file list pointing into opencode's\n57\t * private snapshot store — meaningless outside opencode, and the diff it\n58\t * refers to is already in git.\n59\t *\n60\t * Kept deliberately short. opencode's binary also references `file`, `agent`,\n61\t * `snapshot` and `todo` part types that no session on hand exercises; listing\n62\t * them here on speculation would silently discard content on the first\n63\t * session that used one. Leaving them out routes them through the drift path\n64\t * instead — preserved raw-only, warned about, and upgradeable later by\n65\t * `cledger renormalize`, which is exactly what that machinery is for.\n66\t */\n67\tconst KNOWN_SKIPPED_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n68\t\n69\t/**\n70\t * Tool-call states that will never change again. A `pending`/`running` part\n71\t * is still being written; capturing it would bake a half-finished tool call\n72\t * into an immutable event id. The capture loop skips unsettled parts *and*\n73\t * holds the cursor back at the first one, so the finished version is picked\n74\t * up on the next capture rather than being skipped forever.\n75\t */\n76\tconst SETTLED_TOOL_STATUSES = new Set([\"completed\", \"error\"]);\n77\t\n78\t/** Payload the installed opencode plugin sends on stdin (see install.ts). */\n79\tinterface OpencodeHookPayload {\n80\t  session_id?: string;\n81\t  cwd?: string;\n82\t  hook_event_name?: string;\n83\t}\n84\t\n85\tinterface OpencodeSessionInfo {\n86\t  id?: string;\n87\t  /** Set on subagent sessions; those are skipped (see captureOpencodeExport). */\n88\t  parentID?: string;\n89\t  directory?: string;\n90\t  title?: string;\n91\t  /** opencode's own CLI version, e.g. \"1.18.5\". */\n92\t  version?: string;\n93\t  time?: { created?: number; updated?: number };\n94\t}\n95\t\n96\tinterface OpencodeMessageInfo {\n97\t  id?: string;\n98\t  sessionID?: string;\n99\t  role?: string;\n100\t  /** Agent persona, e.g. \"build\" / \"plan\". */\n101\t  agent?: string;\n102\t  mode?: string;\n103\t  /** Assistant messages state the model flat; user messages nest it. */\n104\t  modelID?: string;\n105\t  providerID?: string;\n106\t  model?: { modelID?: string; providerID?: string };\n107\t  time?: { created?: number; completed?: number };\n108\t}\n109\t\n110\tinterface OpencodePart {\n111\t  id?: string;\n112\t  type?: string;\n113\t  messageID?: string;\n114\t  sessionID?: string;\n115\t  text?: string;\n116\t  tool?: string;\n117\t  callID?: string;\n118\t  state?: {\n119\t    status?: string;\n120\t    input?: unknown;\n121\t    output?: unknown;\n122\t    error?: unknown;\n123\t    time?: { start?: number; end?: number };\n124\t  };\n125\t  time?: { start?: number; end?: number };\n126\t}\n127\t\n128\tinterface OpencodeMessage {\n129\t  info?: OpencodeMessageInfo;\n130\t  parts?: OpencodePart[];\n131\t}\n132\t\n133\texport interface OpencodeExport {\n134\t  info?: OpencodeSessionInfo;\n135\t  messages?: OpencodeMessage[];\n136\t}\n137\t\n138\t/** What `opencode session list --format json` returns, per row. */\n139\tinterface OpencodeSessionRow {\n140\t  id?: string;\n141\t  title?: string;\n142\t  directory?: string;\n143\t  updated?: number;\n144\t}\n145\t\n146\t/** One part, paired with the message that owns it and its session position. */\n147\tinterface FlatPart {\n148\t  info: OpencodeMessageInfo;\n149\t  part: OpencodePart;\n150\t  seq: number;\n151\t}\n152\t\n153\tfunction packageVersion(): string {\n154\t  try {\n155\t    const pkg = JSON.parse(\n156\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n157\t    ) as { version?: string };\n158\t    return pkg.version ?? \"0.1.0\";\n159\t  } catch {\n160\t    return \"0.1.0\";\n161\t  }\n162\t}\n163\t\n164\tfunction sanitizeId(id: string): string {\n165\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n166\t}\n167\t\n168\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n169\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n170\t}\n171\t\n172\tasync function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n173\t  try {\n174\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n175\t    const data = JSON.parse(raw) as { parts?: number };\n176\t    return typeof data.parts === \"number\" ? data.parts : 0;\n177\t  } catch {\n178\t    return 0;\n179\t  }\n180\t}\n181\t\n182\tasync function writeCursor(repo: RepoInfo, sessionId: string, parts: number): Promise<void> {\n183\t  const path = cursorPath(repo, sessionId);\n184\t  await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n185\t  await writeFile(path, JSON.stringify({ parts }) + \"\\n\");\n186\t}\n187\t\n188\t/** opencode stores times as epoch milliseconds; the ledger wants ISO 8601. */\n189\tfunction isoFromMs(ms: unknown): string | null {\n190\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n191\t  const date = new Date(ms);\n192\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n193\t}\n194\t\n195\t/**\n196\t * Run an opencode subcommand and return its stdout.\n197\t *\n198\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n199\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n200\t * silently lost — a large session's export still parses as JSON right up to\n201\t * the truncation point in some cases, which would quietly capture a partial\n202\t * conversation. Writing to a real file descriptor returns the full output.\n203\t *\n204\t * Returns null when opencode is not installed or the command fails; every\n205\t * caller treats that as \"nothing to capture\" rather than an error, so a\n206\t * missing opencode never breaks a hook.\n207\t */\n208\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n209\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n210\t  const path = join(dir, \"out.json\");\n211\t  try {\n212\t    const handle = await open(path, \"w\");\n213\t    try {\n214\t      const code = await new Promise<number | null>((resolve, reject) => {\n215\t        const child = spawn(\"opencode\", args, {\n216\t          cwd,\n217\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n218\t        });\n219\t        child.on(\"error\", reject);\n220\t        child.on(\"close\", resolve);\n221\t      });\n222\t      if (code !== 0) return null;\n223\t    } finally {\n224\t      await handle.close();\n225\t    }\n226\t    return await readFile(path, \"utf8\");\n227\t  } catch {\n228\t    return null;\n229\t  } finally {\n230\t    await rm(dir, { recursive: true, force: true });\n231\t  }\n232\t}\n233\t\n234\t/**\n235\t * Export one session as JSON. `--pure` skips external plugins, which matters\n236\t * because the capture this call belongs to was very likely triggered *by* an\n237\t * opencode plugin — loading that plugin again inside the export would invite\n238\t * re-entrancy.\n239\t */\n240\texport async function exportOpencodeSession(\n241\t  sessionId: string,\n242\t  cwd: string,\n243\t): Promise<OpencodeExport | null> {\n244\t  const stdout = await runOpencode([\"export\", \"--pure\", sessionId], cwd);\n245\t  if (!stdout) return null;\n246\t  try {\n247\t    return JSON.parse(stdout) as OpencodeExport;\n248\t  } catch {\n249\t    return null;\n250\t  }\n251\t}\n252\t\n253\t/**\n254\t * List opencode sessions. opencode scopes this to the project containing\n255\t * `cwd`, which is exactly the scoping a repo-local capture wants — a sweep\n256\t * never reaches into conversations that belong to other checkouts.\n257\t */\n258\texport async function listOpencodeSessions(cwd: string): Promise<OpencodeSessionRow[]> {\n259\t  const stdout = await runOpencode([\"session\", \"list\", \"--pure\", \"--format\", \"json\"], cwd);\n260\t  if (!stdout) return [];\n261\t  try {\n262\t    const parsed = JSON.parse(stdout) as unknown;\n263\t    return Array.isArray(parsed) ? (parsed as OpencodeSessionRow[]) : [];\n264\t  } catch {\n265\t    return [];\n266\t  }\n267\t}\n268\t\n269\t/**\n270\t * The agent facts a message states about itself. opencode labels every\n271\t * message with its model and provider — including *user* messages, which\n272\t * carry the model selected to answer them. That is a genuine difference from\n273\t * claude-code, where a user line states no model and none is invented; here\n274\t * the source does state it, so it is recorded, per `Producer.model`'s rule of\n275\t * \"set only when the source states it for this turn\".\n276\t *\n277\t * `providerID` is opencode's *config* provider key (e.g. \"ds4\", \"local-mlx\"),\n278\t * which the user names themselves rather than a canonical vendor name. It is\n279\t * passed through verbatim anyway — the schema asks for the provider as the\n280\t * source names it, and rewriting it would be interpretation.\n281\t */\n282\tfunction agentContext(info: OpencodeMessageInfo, sessionVersion?: string): ProducerAgentContext {\n283\t  const agent: ProducerAgentContext = {};\n284\t  if (sessionVersion) agent.source_version = sessionVersion;\n285\t  const model = info.modelID ?? info.model?.modelID;\n286\t  if (typeof model === \"string\" && model) agent.model = model;\n287\t  const provider = info.providerID ?? info.model?.providerID;\n288\t  if (typeof provider === \"string\" && provider) agent.provider = provider;\n289\t  return agent;\n290\t}\n291\t\n292\t/**\n293\t * When this part happened: its own start time, else the message's creation\n294\t * time, else the session base time. Every step is a pure function of the\n295\t * export, so rescans and re-normalization land on the same value — which\n296\t * matters because `occurred_at` is part of event identity.\n297\t */\n298\tfunction partTime(info: OpencodeMessageInfo, part: OpencodePart, baseTime: string): string {\n299\t  return (\n300\t    isoFromMs(part.time?.start) ??\n301\t    isoFromMs(part.state?.time?.start) ??\n302\t    isoFromMs(info.time?.created) ??\n303\t    baseTime\n304\t  );\n305\t}\n306\t\n307\t/** Flatten messages into parts, numbering every part in export order. */\n308\tfunction flattenParts(data: OpencodeExport): FlatPart[] {\n309\t  const flat: FlatPart[] = [];\n310\t  let seq = 0;\n311\t  for (const message of data.messages ?? []) {\n312\t    const info = message.info ?? {};\n313\t    for (const part of message.parts ?? []) {\n314\t      flat.push({ info, part, seq });\n315\t      seq++;\n316\t    }\n317\t  }\n318\t  return flat;\n319\t}\n320\t\n321\t/**\n322\t * `raw.data` for one part. The part alone would be lossy: it carries ids but\n323\t * no role, model, or timing for the message that owns it, so an exported\n324\t * event could not be replayed without the rest of the session. Pairing it\n325\t * with its message info keeps every event independently lossless, at the cost\n326\t * of repeating a small object across the parts of one message.\n327\t */\n328\tfunction rawData(info: OpencodeMessageInfo, part: OpencodePart): unknown {\n329\t  return { info, part };\n330\t}\n331\t\n332\t/**\n333\t * True when a part carries nothing a reader would see. Empty text and\n334\t * reasoning parts do occur (a step that produced only a tool call, say), and\n335\t * emitting an event whose only block is an empty string adds a line to\n336\t * `cledger log` that says nothing.\n337\t */\n338\tfunction isEmptyText(part: OpencodePart): boolean {\n339\t  return typeof part.text !== \"string\" || part.text.trim() === \"\";\n340\t}\n341\t\n342\t/** Whether a tool part has reached a state that will not change again. */\n343\tfunction isSettledTool(part: OpencodePart): boolean {\n344\t  const status = part.state?.status;\n345\t  return typeof status === \"string\" && SETTLED_TOOL_STATUSES.has(status);\n346\t}\n347\t\n348\tfunction convertPart(\n349\t  info: OpencodeMessageInfo,\n350\t  part: OpencodePart,\n351\t  seq: number,\n352\t  sessionId: string,\n353\t  baseTime: string,\n354\t  version: string,\n355\t  identity: GitUserIdentity,\n356\t  agent: ProducerAgentContext,\n357\t): EventDraft | null {\n358\t  const type = part.type;\n359\t  if (typeof type !== \"string\" || !CONVERTIBLE_PART_TYPES.has(type)) return null;\n360\t\n361\t  const role = typeof info.role === \"string\" ? info.role : \"assistant\";\n362\t  const isHuman = role === \"user\" && type === \"text\";\n363\t\n364\t  const actor: Actor = isHuman ? { type: \"human\" } : { type: \"agent\" };\n365\t  if (isHuman) {\n366\t    if (identity.email) actor.id = identity.email;\n367\t    if (identity.name) actor.display = identity.name;\n368\t  } else if (agent.model) {\n369\t    actor.id = agent.model;\n370\t  }\n371\t\n372\t  let blocks: unknown[];\n373\t  if (type === \"text\") {\n374\t    if (isEmptyText(part)) return null;\n375\t    blocks = [{ type: \"text\", text: part.text }];\n376\t  } else if (type === \"reasoning\") {\n377\t    if (isEmptyText(part)) return null;\n378\t    blocks = [{ type: \"thinking\", text: part.text }];\n379\t  } else {\n380\t    // tool: opencode keeps the call and its result on one part, so both\n381\t    // blocks belong to one event. The actor stays `agent` rather than the\n382\t    // `system` other adapters give a standalone tool result — opencode does\n383\t    // not model the result as a separate speaker, and splitting it here\n384\t    // would be inventing structure the source does not have.\n385\t    if (!isSettledTool(part)) return null;\n386\t    const call: Record<string, unknown> = { type: \"tool_use\" };\n387\t    if (typeof part.tool === \"string\") call[\"name\"] = part.tool;\n388\t    if (part.state?.input !== undefined) call[\"input\"] = part.state.input;\n389\t    if (typeof part.callID === \"string\") call[\"id\"] = part.callID;\n390\t    const result: Record<string, unknown> = { type: \"tool_result\" };\n391\t    if (typeof part.callID === \"string\") result[\"tool_use_id\"] = part.callID;\n392\t    const failed = part.state?.status === \"error\";\n393\t    result[\"content\"] = failed ? (part.state?.error ?? part.state?.output) : part.state?.output;\n394\t    if (failed) result[\"is_error\"] = true;\n395\t    blocks = [call, result];\n396\t  }\n397\t\n398\t  const content: Record<string, unknown> = { role };\n399\t  // opencode's agent persona (\"build\", \"plan\", ...) has no home in `Producer`,\n400\t  // which describes the model and the capture tool, not which persona the\n401\t  // user was driving. It goes in `content` next to `role`, the way codex's\n402\t  // agent_message author/recipient do.\n403\t  if (typeof info.agent === \"string\" && info.agent) content[\"agent\"] = info.agent;\n404\t  content[\"blocks\"] = blocks;\n405\t\n406\t  return {\n407\t    kind: \"conversation_turn\",\n408\t    occurred_at: partTime(info, part, baseTime),\n409\t    actor,\n410\t    producer: { tool: \"cledger\", version, source: \"opencode\", session_id: sessionId, ...agent },\n411\t    conversation: { id: `opencode:${sessionId}`, seq },\n412\t    content,\n413\t    raw: { format: RAW_FORMAT, data: rawData(info, part) },\n414\t  };\n415\t}\n416\t\n417\t/** Raw-only preservation event for an unrecognized opencode part (see drift.ts). */\n418\tfunction preserve(\n419\t  typeKey: string,\n420\t  info: OpencodeMessageInfo,\n421\t  part: OpencodePart,\n422\t  occurredAt: string,\n423\t  seq: number,\n424\t  sessionId: string,\n425\t  version: string,\n426\t  agent: ProducerAgentContext,\n427\t): EventDraft {\n428\t  return unrecognizedDraft({\n429\t    typeKey,\n430\t    line: rawData(info, part),\n431\t    occurredAt,\n432\t    source: \"opencode\",\n433\t    sessionId,\n434\t    seq,\n435\t    version,\n436\t    rawFormat: RAW_FORMAT,\n437\t    conversationId: `opencode:${sessionId}`,\n438\t    agent: { ...agent },\n439\t  });\n440\t}\n441\t\n442\t/**\n443\t * Re-normalization hook (see renormalize.ts): turn a preserved `unrecognized`\n444\t * event back into the `conversation_turn` a live capture would now produce.\n445\t *\n446\t * Id fidelity works the same way as in the claude-code and codex twins, and\n447\t * the `{info, part}` shape stored in `raw.data` is what makes it possible\n448\t * here: the message info a part needs for its role, model and time fallback\n449\t * travels with the part instead of living in a session header this path can\n450\t * no longer see. `baseTime` falls back to the preserved event's own\n451\t * `occurred_at`, which is the value the preservation path computed — so a\n452\t * part with no time of its own reconstructs to the same instant, and\n453\t * therefore the same id.\n454\t */\n455\texport function renormalizeUnrecognized(\n456\t  event: EvidenceEvent,\n457\t  identity: GitUserIdentity,\n458\t): EventDraft | null {\n459\t  if (!event.raw || event.conversation === undefined) return null;\n460\t  const stored = event.raw.data as { info?: OpencodeMessageInfo; part?: OpencodePart } | null;\n461\t  if (!stored || !stored.part) return null;\n462\t  const info = stored.info ?? {};\n463\t  const agent: ProducerAgentContext = {};\n464\t  if (event.producer.source_version) agent.source_version = event.producer.source_version;\n465\t  if (event.producer.model) agent.model = event.producer.model;\n466\t  if (event.producer.provider) agent.provider = event.producer.provider;\n467\t  return convertPart(\n468\t    info,\n469\t    stored.part,\n470\t    event.conversation.seq,\n471\t    event.producer.session_id ?? \"\",\n472\t    event.occurred_at,\n473\t    packageVersion(),\n474\t    identity,\n475\t    agent,\n476\t  );\n477\t}\n478\t\n479\t/**\n480\t * Capture a session from an already-parsed export. Split out from the\n481\t * subprocess plumbing so tests (and offline backfill from a saved export\n482\t * file) exercise the conversion without needing opencode installed.\n483\t */\n484\texport async function captureOpencodeExport(\n485\t  data: OpencodeExport,\n486\t  cwd: string,\n487\t): Promise<CaptureResult> {\n488\t  const repo = await findRepo(cwd);\n489\t  if (!repo) throw new Error(\"not inside a git repository\");\n490\t\n491\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n492\t\n493\t  const sessionId = data.info?.id;\n494\t  if (typeof sessionId !== \"string\" || !sessionId) return result;\n495\t\n496\t  // Subagent sessions are skipped, matching claude-code's treatment of\n497\t  // sidechain lines: the parent's `task` tool part already stores the child's\n498\t  // final output, so only the subagent's internal steps are missed. Capturing\n499\t  // them properly needs a way to express the parent/child relation, which is\n500\t  // a cross-adapter schema question rather than an opencode one.\n501\t  if (typeof data.info?.parentID === \"string\" && data.info.parentID) return result;\n502\t\n503\t  const flat = flattenParts(data);\n504\t  let cursor = await readCursor(repo, sessionId);\n505\t  // A session shorter than the cursor means parts were removed (a revert, or\n506\t  // a deleted message). Rescan from the start; identical events dedup.\n507\t  if (cursor > flat.length) cursor = 0;\n508\t\n509\t  const baseTime =\n510\t    isoFromMs(data.info?.time?.created) ?? isoFromMs(data.info?.time?.updated) ?? new Date().toISOString();\n511\t  const version = packageVersion();\n512\t  const identity = await gitUserIdentity(repo);\n513\t  const sessionVersion = typeof data.info?.version === \"string\" ? data.info.version : undefined;\n514\t\n515\t  // Where the cursor stops. An unsettled tool call holds it back so the\n516\t  // finished part is seen again next time; parts after it still convert now\n517\t  // and simply dedup on the rescan.\n518\t  let nextCursor = flat.length;\n519\t\n520\t  const drafts: EventDraft[] = [];\n521\t  for (let i = cursor; i < flat.length; i++) {\n522\t    const { info, part, seq } = flat[i]!;\n523\t    const type = typeof part.type === \"string\" ? part.type : \"(untyped)\";\n524\t    const agent = agentContext(info, sessionVersion);\n525\t\n526\t    if (!CONVERTIBLE_PART_TYPES.has(type)) {\n527\t      if (!KNOWN_SKIPPED_PART_TYPES.has(type)) {\n528\t        countUnrecognized(result.unrecognized, type);\n529\t        const occurredAt = partTime(info, part, baseTime);\n530\t        drafts.push(preserve(type, info, part, occurredAt, seq, sessionId, version, agent));\n531\t      }\n532\t      continue;\n533\t    }\n534\t\n535\t    if (type === \"tool\" && !isSettledTool(part)) {\n536\t      nextCursor = Math.min(nextCursor, i);\n537\t      continue;\n538\t    }\n539\t\n540\t    const draft = convertPart(info, part, seq, sessionId, baseTime, version, identity, agent);\n541\t    if (draft) drafts.push(draft);\n542\t  }\n543\t\n544\t  if (drafts.length > 0) {\n545\t    const appendResult = await appendEvents(repo, drafts);\n546\t    result.appended = appendResult.appended.length;\n547\t    result.deduped = appendResult.deduped;\n548\t  }\n549\t  await writeCursor(repo, sessionId, nextCursor);\n550\t  process.stderr.write(`cledger: opencode +${result.appended} events (${result.deduped} deduped)\\n`);\n551\t  warnUnrecognized(\"opencode\", result.unrecognized);\n552\t  return result;\n553\t}\n554\t\n555\t/** Export one session via the opencode CLI, then capture it. */\n556\texport async function captureOpencodeSession(\n557\t  sessionId: string,\n558\t  cwd: string,\n559\t): Promise<CaptureResult> {\n560\t  const data = await exportOpencodeSession(sessionId, cwd);\n561\t  if (!data) return { appended: 0, deduped: 0, unrecognized: {} };\n562\t  return captureOpencodeExport(data, cwd);\n563\t}\n564\t\n565\t/** Capture a session from a saved `opencode export` JSON file (backfill). */\n566\texport async function captureOpencodeExportFile(\n567\t  path: string,\n568\t  cwd: string,\n569\t): Promise<CaptureResult> {\n570\t  const raw = await readFile(path, \"utf8\");\n571\t  return captureOpencodeExport(JSON.parse(raw) as OpencodeExport, cwd);\n572\t}\n573\t\n574\t/**\n575\t * Capture every session opencode associates with `cwd`'s project. Used by\n576\t * `cledger capture opencode --all`, and as the hook's fallback when the\n577\t * plugin could not tell us which session went idle.\n578\t */\n579\texport async function captureOpencodeAll(\n580\t  cwd: string,\n581\t  limit?: number,\n582\t): Promise<CaptureResult> {\n583\t  const total: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n584\t  const sessions = await listOpencodeSessions(cwd);\n585\t  const ordered = [...sessions].sort((a, b) => (b.updated ?? 0) - (a.updated ?? 0));\n586\t  const selected = typeof limit === \"number\" ? ordered.slice(0, limit) : ordered;\n587\t  for (const session of selected) {\n588\t    if (typeof session.id !== \"string\" || !session.id) continue;\n589\t    const one = await captureOpencodeSession(session.id, cwd);\n590\t    total.appended += one.appended;\n591\t    total.deduped += one.deduped;\n592\t    for (const [key, count] of Object.entries(one.unrecognized)) {\n593\t      total.unrecognized[key] = (total.unrecognized[key] ?? 0) + count;\n594\t    }\n595\t  }\n596\t  return total;\n597\t}\n598\t\n599\t/**\n600\t * Hook entrypoint, invoked by the plugin `cledger install opencode` writes.\n601\t *\n602\t * `session_id` is optional on purpose. The plugin reads it out of opencode's\n603\t * `session.idle` event, whose exact payload shape is not something cledger\n604\t * can pin down across opencode versions; when it is missing, capture falls\n605\t * back to the most recently updated session for this project, which is the\n606\t * session that just went idle in every realistic case.\n607\t */\n608\texport async function runOpencodeHook(stdinJson: string): Promise<void> {\n609\t  try {\n610\t    const payload = JSON.parse(stdinJson) as OpencodeHookPayload;\n611\t    const cwd = payload.cwd ?? process.cwd();\n612\t    const repo = await findRepo(cwd);\n613\t    if (!repo) return; // hooks must never break the user's session outside a repo\n614\t    if (payload.session_id) {\n615\t      await captureOpencodeSession(payload.session_id, cwd);\n616\t      return;\n617\t    }\n618\t    await captureOpencodeAll(cwd, 1);\n619\t  } catch (err) {\n620\t    process.stderr.write(\n621\t      `cledger: opencode hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n622\t    );\n623\t  }\n624\t}\n625\t","tool_use_id":"toolu_011UsUbhPLPN2iv9995LUcGy","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-capture-everything","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/capture-everything","head":"1100858ed17a7ee0b377097e93eafa24d3638f68","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:9a01c126-8f0a-4060-95f9-fe3a00a2a8c3","seq":41},"id":"ev1-0b50d447893f402edc95b9a1eabd70bd9cf49e5c9ea0bc2129a19c4b162a608a","kind":"conversation_turn","occurred_at":"2026-08-04T03:42:30.060Z","producer":{"session_id":"9a01c126-8f0a-4060-95f9-fe3a00a2a8c3","source":"claude-code","source_version":"2.1.221","tool":"cledger","version":"0.18.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","entrypoint":"cli","gitBranch":"main","isSidechain":false,"message":{"content":[{"content":"1\t/**\n2\t * opencode adapter.\n3\t *\n4\t * Unlike claude-code and codex, opencode has no append-only transcript file:\n5\t * sessions live in a mutable SQLite database at\n6\t * `~/.local/share/opencode/opencode.db`. Rather than read that database, this\n7\t * adapter shells out to opencode's own `opencode export <sessionID>`, which\n8\t * emits `{info, messages: [{info, parts}]}` JSON. Three reasons:\n9\t *\n10\t *  1. cledger ships with no runtime dependencies and supports Node >= 20;\n11\t *     `node:sqlite` would force both to change.\n12\t *  2. opencode's schema is visibly mid-migration (an empty `session_message`\n13\t *     table sits alongside the populated `message`/`part` tables it is\n14\t *     evidently meant to replace). The export shape is the interface opencode\n15\t *     documents; the tables are not.\n16\t *  3. The same database holds `credential.value` and `account.access_token`.\n17\t *     Reading conversations should not require opening the file that stores\n18\t *     the user's API tokens.\n19\t *\n20\t * `--sanitize` is deliberately *not* passed to the export: cledger has its\n21\t * own redaction stack, and letting opencode rewrite content would make event\n22\t * ids depend on opencode's version.\n23\t */\n24\timport { spawn } from \"node:child_process\";\n25\timport { readFileSync } from \"node:fs\";\n26\timport { mkdir, mkdtemp, open, readFile, rm, writeFile } from \"node:fs/promises\";\n27\timport { tmpdir } from \"node:os\";\n28\timport { join } from \"node:path\";\n29\timport { findRepo, gitUserIdentity, type GitUserIdentity, type RepoInfo } from \"../git.js\";\n30\timport { appendEvents } from \"../store.js\";\n31\timport type { Actor, EventDraft, EvidenceEvent, ProducerAgentContext } from \"../schema.js\";\n32\timport {\n33\t  countUnrecognized,\n34\t  unrecognizedDraft,\n35\t  warnUnrecognized,\n36\t  type CaptureResult,\n37\t} from \"./drift.js\";\n38\t\n39\tconst RAW_FORMAT = \"opencode-export-json/1\";\n40\t\n41\t/**\n42\t * Part types carrying visible conversation content.\n43\t *\n44\t * `reasoning` belongs here, and that is a real difference from codex: codex's\n45\t * reasoning items are provider-encrypted (`encrypted_content`) and can only\n46\t * ever be preserved opaquely as `reasoning`-kind events, whereas opencode\n47\t * stores reasoning as plain `text`. So it converts to an ordinary\n48\t * `thinking` block inside a `conversation_turn`, exactly as claude-code's\n49\t * thinking blocks do — no opacity marker, nothing withheld.\n50\t */\n51\tconst CONVERTIBLE_PART_TYPES = new Set([\"text\", \"reasoning\", \"tool\"]);\n52\t\n53\t/**\n54\t * Part types deliberately not captured: per-step bookkeeping (`step-start` /\n55\t * `step-finish` carry token counts and finish reasons, not content) and\n56\t * `patch`, which is a content hash plus file list pointing into opencode's\n57\t * private snapshot store — meaningless outside opencode, and the diff it\n58\t * refers to is already in git.\n59\t *\n60\t * Kept deliberately short. opencode's binary also references `file`, `agent`,\n61\t * `snapshot` and `todo` part types that no session on hand exercises; listing\n62\t * them here on speculation would silently discard content on the first\n63\t * session that used one. Leaving them out routes them through the drift path\n64\t * instead — preserved raw-only, warned about, and upgradeable later by\n65\t * `cledger renormalize`, which is exactly what that machinery is for.\n66\t */\n67\tconst KNOWN_SKIPPED_PART_TYPES = new Set([\"step-start\", \"step-finish\", \"patch\"]);\n68\t\n69\t/**\n70\t * Tool-call states that will never change again. A `pending`/`running` part\n71\t * is still being written; capturing it would bake a half-finished tool call\n72\t * into an immutable event id. The capture loop skips unsettled parts *and*\n73\t * holds the cursor back at the first one, so the finished version is picked\n74\t * up on the next capture rather than being skipped forever.\n75\t */\n76\tconst SETTLED_TOOL_STATUSES = new Set([\"completed\", \"error\"]);\n77\t\n78\t/** Payload the installed opencode plugin sends on stdin (see install.ts). */\n79\tinterface OpencodeHookPayload {\n80\t  session_id?: string;\n81\t  cwd?: string;\n82\t  hook_event_name?: string;\n83\t}\n84\t\n85\tinterface OpencodeSessionInfo {\n86\t  id?: string;\n87\t  /** Set on subagent sessions; those are skipped (see captureOpencodeExport). */\n88\t  parentID?: string;\n89\t  directory?: string;\n90\t  title?: string;\n91\t  /** opencode's own CLI version, e.g. \"1.18.5\". */\n92\t  version?: string;\n93\t  time?: { created?: number; updated?: number };\n94\t}\n95\t\n96\tinterface OpencodeMessageInfo {\n97\t  id?: string;\n98\t  sessionID?: string;\n99\t  role?: string;\n100\t  /** Agent persona, e.g. \"build\" / \"plan\". */\n101\t  agent?: string;\n102\t  mode?: string;\n103\t  /** Assistant messages state the model flat; user messages nest it. */\n104\t  modelID?: string;\n105\t  providerID?: string;\n106\t  model?: { modelID?: string; providerID?: string };\n107\t  time?: { created?: number; completed?: number };\n108\t}\n109\t\n110\tinterface OpencodePart {\n111\t  id?: string;\n112\t  type?: string;\n113\t  messageID?: string;\n114\t  sessionID?: string;\n115\t  text?: string;\n116\t  tool?: string;\n117\t  callID?: string;\n118\t  state?: {\n119\t    status?: string;\n120\t    input?: unknown;\n121\t    output?: unknown;\n122\t    error?: unknown;\n123\t    time?: { start?: number; end?: number };\n124\t  };\n125\t  time?: { start?: number; end?: number };\n126\t}\n127\t\n128\tinterface OpencodeMessage {\n129\t  info?: OpencodeMessageInfo;\n130\t  parts?: OpencodePart[];\n131\t}\n132\t\n133\texport interface OpencodeExport {\n134\t  info?: OpencodeSessionInfo;\n135\t  messages?: OpencodeMessage[];\n136\t}\n137\t\n138\t/** What `opencode session list --format json` returns, per row. */\n139\tinterface OpencodeSessionRow {\n140\t  id?: string;\n141\t  title?: string;\n142\t  directory?: string;\n143\t  updated?: number;\n144\t}\n145\t\n146\t/** One part, paired with the message that owns it and its session position. */\n147\tinterface FlatPart {\n148\t  info: OpencodeMessageInfo;\n149\t  part: OpencodePart;\n150\t  seq: number;\n151\t}\n152\t\n153\tfunction packageVersion(): string {\n154\t  try {\n155\t    const pkg = JSON.parse(\n156\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n157\t    ) as { version?: string };\n158\t    return pkg.version ?? \"0.1.0\";\n159\t  } catch {\n160\t    return \"0.1.0\";\n161\t  }\n162\t}\n163\t\n164\tfunction sanitizeId(id: string): string {\n165\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n166\t}\n167\t\n168\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n169\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n170\t}\n171\t\n172\tasync function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n173\t  try {\n174\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n175\t    const data = JSON.parse(raw) as { parts?: number };\n176\t    return typeof data.parts === \"number\" ? data.parts : 0;\n177\t  } catch {\n178\t    return 0;\n179\t  }\n180\t}\n181\t\n182\tasync function writeCursor(repo: RepoInfo, sessionId: string, parts: number): Promise<void> {\n183\t  const path = cursorPath(repo, sessionId);\n184\t  await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n185\t  await writeFile(path, JSON.stringify({ parts }) + \"\\n\");\n186\t}\n187\t\n188\t/** opencode stores times as epoch milliseconds; the ledger wants ISO 8601. */\n189\tfunction isoFromMs(ms: unknown): string | null {\n190\t  if (typeof ms !== \"number\" || !Number.isFinite(ms)) return null;\n191\t  const date = new Date(ms);\n192\t  return Number.isNaN(date.getTime()) ? null : date.toISOString();\n193\t}\n194\t\n195\t/**\n196\t * Run an opencode subcommand and return its stdout.\n197\t *\n198\t * The child's stdout goes to a temp *file*, never a pipe. opencode (a Bun\n199\t * binary) exits without draining a piped stdout, so anything past ~64KB is\n200\t * silently lost — a large session's export still parses as JSON right up to\n201\t * the truncation point in some cases, which would quietly capture a partial\n202\t * conversation. Writing to a real file descriptor returns the full output.\n203\t *\n204\t * Returns null when opencode is not installed or the command fails; every\n205\t * caller treats that as \"nothing to capture\" rather than an error, so a\n206\t * missing opencode never breaks a hook.\n207\t */\n208\tasync function runOpencode(args: string[], cwd: string): Promise<string | null> {\n209\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-opencode-\"));\n210\t  const path = join(dir, \"out.json\");\n211\t  try {\n212\t    const handle = await open(path, \"w\");\n213\t    try {\n214\t      const code = await new Promise<number | null>((resolve, reject) => {\n215\t        const child = spawn(\"opencode\", args, {\n216\t          cwd,\n217\t          stdio: [\"ignore\", handle.fd, \"ignore\"],\n218\t        });\n219\t        child.on(\"error\", reject);\n220\t        child.on(\"close\", resolve);\n221\t      });\n222\t      if (code !== 0) return null;\n223\t    } finally {\n224\t      await handle.close();\n225\t    }\n226\t    return await readFile(path, \"utf8\");\n227\t  } catch {\n228\t    return null;\n229\t  } finally {\n230\t    await rm(dir, { recursive: true, force: true });\n231\t  }\n232\t}\n233\t\n234\t/**\n235\t * Export one session as JSON. `--pure` skips external plugins, which matters\n236\t * because the capture this call belongs to was very likely triggered *by* an\n237\t * opencode plugin — loading that plugin again inside the export would invite\n238\t * re-entrancy.\n239\t */\n240\texport async function exportOpencodeSession(\n241\t  sessionId: string,\n242\t  cwd: string,\n243\t): Promise<OpencodeExport | null> {\n244\t  const stdout = await runOpencode([\"export\", \"--pure\", sessionId], cwd);\n245\t  if (!stdout) return null;\n246\t  try {\n247\t    return JSON.parse(stdout) as OpencodeExport;\n248\t  } catch {\n249\t    return null;\n250\t  }\n251\t}\n252\t\n253\t/**\n254\t * List opencode sessions. opencode scopes this to the project containing\n255\t * `cwd`, which is exactly the scoping a repo-local capture wants — a sweep\n256\t * never reaches into conversations that belong to other checkouts.\n257\t */\n258\texport async function listOpencodeSessions(cwd: string): Promise<OpencodeSessionRow[]> {\n259\t  const stdout = await runOpencode([\"session\", \"list\", \"--pure\", \"--format\", \"json\"], cwd);\n260\t  if (!stdout) return [];\n261\t  try {\n262\t    const parsed = JSON.parse(stdout) as unknown;\n263\t    return Array.isArray(parsed) ? (parsed as OpencodeSessionRow[]) : [];\n264\t  } catch {\n265\t    return [];\n266\t  }\n267\t}\n268\t\n269\t/**\n270\t * The agent facts a message states about itself. opencode labels every\n271\t * message with its model and provider — including *user* messages, which\n272\t * carry the model selected to answer them. That is a genuine difference from\n273\t * claude-code, where a user line states no model and none is invented; here\n274\t * the source does state it, so it is recorded, per `Producer.model`'s rule of\n275\t * \"set only when the source states it for this turn\".\n276\t *\n277\t * `providerID` is opencode's *config* provider key (e.g. \"ds4\", \"local-mlx\"),\n278\t * which the user names themselves rather than a canonical vendor name. It is\n279\t * passed through verbatim anyway — the schema asks for the provider as the\n280\t * source names it, and rewriting it would be interpretation.\n281\t */\n282\tfunction agentContext(info: OpencodeMessageInfo, sessionVersion?: string): ProducerAgentContext {\n283\t  const agent: ProducerAgentContext = {};\n284\t  if (sessionVersion) agent.source_version = sessionVersion;\n285\t  const model = info.modelID ?? info.model?.modelID;\n286\t  if (typeof model === \"string\" && model) agent.model = model;\n287\t  const provider = info.providerID ?? info.model?.providerID;\n288\t  if (typeof provider === \"string\" && provider) agent.provider = provider;\n289\t  return agent;\n290\t}\n291\t\n292\t/**\n293\t * When this part happened: its own start time, else the message's creation\n294\t * time, else the session base time. Every step is a pure function of the\n295\t * export, so rescans and re-normalization land on the same value — which\n296\t * matters because `occurred_at` is part of event identity.\n297\t */\n298\tfunction partTime(info: OpencodeMessageInfo, part: OpencodePart, baseTime: string): string {\n299\t  return (\n300\t    isoFromMs(part.time?.start) ??\n301\t    isoFromMs(part.state?.time?.start) ??\n302\t    isoFromMs(info.time?.created) ??\n303\t    baseTime\n304\t  );\n305\t}\n306\t\n307\t/** Flatten messages into parts, numbering every part in export order. */\n308\tfunction flattenParts(data: OpencodeExport): FlatPart[] {\n309\t  const flat: FlatPart[] = [];\n310\t  let seq = 0;\n311\t  for (const message of data.messages ?? []) {\n312\t    const info = message.info ?? {};\n313\t    for (const part of message.parts ?? []) {\n314\t      flat.push({ info, part, seq });\n315\t      seq++;\n316\t    }\n317\t  }\n318\t  return flat;\n319\t}\n320\t\n321\t/**\n322\t * `raw.data` for one part. The part alone would be lossy: it carries ids but\n323\t * no role, model, or timing for the message that owns it, so an exported\n324\t * event could not be replayed without the rest of the session. Pairing it\n325\t * with its message info keep