{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Format-drift re-normalization: the supersession half of the drift story\n3\t * (the preservation half — emitting raw-only `unrecognized` events — lives in\n4\t * adapters/drift.ts). When a newer cledger version has learned to interpret a\n5\t * transcript line type it once preserved raw-only, `renormalize` turns each\n6\t * such stored line into the proper `conversation_turn` and appends a\n7\t * `supersession` event linking the two, so consumers stop seeing the raw\n8\t * placeholder and see the interpreted turn instead.\n9\t *\n10\t * Invariants:\n11\t *  - Append-only. The `unrecognized` event is never deleted; it is superseded\n12\t *    via a `supersession` event carrying `links:[{rel:\"supersedes\",target}]`.\n13\t *  - Idempotent. A second run is a no-op: already-superseded events are\n14\t *    skipped, and every id we produce is deterministic, so `appendEvents`\n15\t *    dedups anything that slips through.\n16\t *  - Id fidelity. The turn is reconstructed by re-feeding the stored `raw.data`\n17\t *    through the owning adapter's *same* convert path (see each adapter's\n18\t *    `renormalizeUnrecognized`), so it gets the exact id a live capture of the\n19\t *    same line would — a future live capture then dedups against it rather\n20\t *    than duplicating.\n21\t *  - Redaction safety. The stored `raw.data` was already redacted at\n22\t *    preservation time; the reconstructed turn also rides the normal\n23\t *    `appendEvents` redaction path, which is idempotent on already-placeholdered\n24\t *    text — nothing is re-exposed.\n25\t *\n26\t * Manual-only for now: this is an explicit `cledger renormalize` step, not\n27\t * auto-triggered on capture. Auto-detecting \"the adapter changed\" and running\n28\t * this after a version bump is a deferred follow-up (see the roadmap).\n29\t */\n30\timport type { RepoInfo } from \"./git.js\";\n31\timport { gitUserIdentity } from \"./git.js\";\n32\timport { appendEvents, readEvents } from \"./store.js\";\n33\timport { eventId, type EventDraft, type EventLink, type EvidenceEvent } from \"./schema.js\";\n34\timport { renormalizeUnrecognized as renormalizeClaude } from \"./adapters/claude-code.js\";\n35\timport { renormalizeUnrecognized as renormalizeCodex } from \"./adapters/codex.js\";\n36\timport { renormalizeUnrecognized as renormalizeOpencode } from \"./adapters/opencode.js\";\n37\t\n38\t/** Route a preserved event to the adapter that owns its `producer.source`. */\n39\ttype Renormalizer = (event: EvidenceEvent, identity: Awaited<ReturnType<typeof gitUserIdentity>>) => EventDraft | null;\n40\t\n41\tfunction renormalizerFor(source: string | undefined): Renormalizer | null {\n42\t  if (source === \"claude-code\") return renormalizeClaude;\n43\t  if (source === \"codex\") return renormalizeCodex;\n44\t  if (source === \"opencode\") return renormalizeOpencode;\n45\t  return null;\n46\t}\n47\t\n48\texport interface RenormalizeResult {\n49\t  /** Preserved `unrecognized` events examined (excludes ones already superseded). */\n50\t  scanned: number;\n51\t  /** Events an adapter could now interpret (a turn + supersession pair was produced). */\n52\t  interpreted: number;\n53\t  /** Fresh `conversation_turn` events written (an interpreted turn that already\n54\t   *  existed from a prior live capture dedups and is not counted here). */\n55\t  turnsAppended: number;\n56\t  /** Fresh `supersession` events written. */\n57\t  supersessionsAppended: number;\n58\t  /** Preserved events still uninterpretable — no owning adapter, or its\n59\t   *  convert path returned null; these stay preserved raw-only. */\n60\t  skipped: number;\n61\t}\n62\t\n63\texport async function renormalize(repo: RepoInfo): Promise<RenormalizeResult> {\n64\t  const identity = await gitUserIdentity(repo);\n65\t  const all = await readEvents(repo);\n66\t\n67\t  // Targets of any existing supersession — already re-normalized, skip them so\n68\t  // a re-run does no work rather than relying on dedup alone.\n69\t  const supersededTargets = new Set<string>();\n70\t  for (const e of all) {\n71\t    if (e.kind !== \"supersession\") continue;\n72\t    for (const link of e.links ?? []) {\n73\t      if (link.rel === \"supersedes\") supersededTargets.add(link.target);\n74\t    }\n75\t  }\n76\t  // Every id already in the ledger, across all anchors — `appendEvents` only\n77\t  // dedups within the target anchor, so this guards the cross-anchor case\n78\t  // where a live capture already wrote the same turn under a different commit.\n79\t  const existingIds = new Set(all.map((e) => e.id));\n80\t\n81\t  const result: RenormalizeResult = {\n82\t    scanned: 0,\n83\t    interpreted: 0,\n84\t    turnsAppended: 0,\n85\t    supersessionsAppended: 0,\n86\t    skipped: 0,\n87\t  };\n88\t  const drafts: EventDraft[] = [];\n89\t\n90\t  for (const event of all) {\n91\t    if (event.kind !== \"unrecognized\") continue;\n92\t    if (supersededTargets.has(event.id)) continue;\n93\t    result.scanned++;\n94\t\n95\t    const renormalizer = renormalizerFor(event.producer.source);\n96\t    if (!renormalizer) {\n97\t      result.skipped++;\n98\t      continue;\n99\t    }\n100\t    const turnDraft = renormalizer(event, identity);\n101\t    if (!turnDraft) {\n102\t      result.skipped++;\n103\t      continue;\n104\t    }\n105\t    result.interpreted++;\n106\t\n107\t    // The turn's id, computed the same way a fresh capture would (the stored\n108\t    // raw.data is already redacted, so the appendEvents redaction pass is a\n109\t    // no-op and does not shift this id).\n110\t    const turnId = eventId(turnDraft);\n111\t    if (!existingIds.has(turnId)) {\n112\t      drafts.push(turnDraft);\n113\t      existingIds.add(turnId);\n114\t    }\n115\t\n116\t    const link: EventLink = { rel: \"supersedes\", target: event.id };\n117\t    const supersessionDraft: EventDraft = {\n118\t      k