ywhere else: replaying an\n86\t * encrypted reasoning blob only works against the model that produced it, so\n87\t * an opaque event whose `producer.model`/`provider` are unknown is a blob a\n88\t * consumer cannot safely route.\n89\t */\n90\texport function reasoningDraft(params: {\n91\t  line: unknown;\n92\t  occurredAt: string;\n93\t  source: string;\n94\t  sessionId: string;\n95\t  seq: number;\n96\t  version: string;\n97\t  rawFormat: string;\n98\t  conversationId: string;\n99\t  agent?: ProducerAgentContext;\n100\t}): EventDraft {\n101\t  return {\n102\t    kind: \"reasoning\",\n103\t    occurred_at: params.occurredAt,\n104\t    actor: { type: \"agent\" },\n105\t    producer: {\n106\t      tool: \"cledger\",\n107\t      version: params.version,\n108\t      source: params.source,\n109\t      session_id: params.sessionId,\n110\t      ...params.agent,\n111\t    },\n112\t    conversation: { id: params.conversationId, seq: params.seq },\n113\t    content: { opaque: true },\n114\t    raw: { format: params.rawFormat, data: params.line },\n115\t  };\n116\t}\n117\t\n118\texport function warnUnrecognized(source: string, unrecognized: Record<string, number>): void {\n119\t  const entries = Object.entries(unrecognized);\n120\t  if (entries.length === 0) return;\n121\t  const total = entries.reduce((n, [, c]) => n + c, 0);\n122\t  const detail = entries\n123\t    .sort((a, b) => b[1] - a[1])\n124\t    .map(([type, count]) => `${type} x${count}`)\n125\t    .join(\", \");\n126\t  process.stderr.write(\n127\t    `cledger: ${source} preserved ${total} transcript line(s) of unrecognized type (${detail}) ` +\n128\t      `raw-only — the ${source} format may have added content this cledger version cannot ` +\n129\t      `interpret; update conversation-ledger to normalize these, or report it\\n`,\n130\t  );\n131\t}\n132\t","tool_use_id":"toolu_014wNto1PLN9ohBSXkbNpkFi","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-capture-everything","cwd":"/Users/evintunador/