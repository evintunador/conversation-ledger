56\t  parentUuid?: string;\n57\t  sessionId?: string;\n58\t  timestamp?: string;\n59\t  cwd?: string;\n60\t  gitBranch?: string;\n61\t  version?: string;\n62\t}\n63\t\n64\tfunction packageVersion(): string {\n65\t  try {\n66\t    const pkg = JSON.parse(\n67\t      readFileSync(new URL(\"../../package.json\", import.meta.url), \"utf8\"),\n68\t    ) as { version?: string };\n69\t    return pkg.version ?? \"0.1.0\";\n70\t  } catch {\n71\t    return \"0.1.0\";\n72\t  }\n73\t}\n74\t\n75\tfunction sanitizeId(id: string): string {\n76\t  return id.replace(/[^A-Za-z0-9_-]/g, \"_\");\n77\t}\n78\t\n79\tfunction cursorPath(repo: RepoInfo, sessionId: string): string {\n80\t  return join(repo.commonDir, \"conversation-ledger\", \"cursors\", `${sanitizeId(sessionId)}.json`);\n81\t}\n82\t\n83\tasync function readCursor(repo: RepoInfo, sessionId: string): Promise<number> {\n84\t  try {\n85\t    const raw = await readFile(cursorPath(repo, sessionId), \"utf8\");\n86\t    const data = JSON.parse(raw) as { lines?: number };\n87\t    return typeof data.lines === \"number\" ? data.lines : 0;\n88\t  } catch {\n89\t    return 0;\n90\t  }\n91\t}\n92\t\n93\tasync function writeCursor(repo: RepoInfo, sessionId: string, lines: number): Promise<void> {\n94\t  const path = cursorPath(repo, sessionId);\n95\t  await mkdir(join(repo.commonDir, \"conversation-ledger\", \"cursors\"), { recursive: true });\n96\t  await writeFile(path, JSON.stringify({ lines }) + \"\\n\");\n97\t}\n98\t\n99\tfunction convertContentBlocks(content: unknown): unknown[] {\n100\t  if (typeof content === \"string\") return [{ type: \"text\", text: content }];\n101\t  if (!Array.isArray(content)) return [];\n102\t  return content.map(convertBlock);\n103\t}\n104\t\n105\tfunction convertBlock(block: unknown): unknown {\n106\t  if (!block || typeof block !== \"object\") return block;\n107\t  const b = block as Record<string, unknown>;\n108\t  if (b[\"type\"] === \"thinking\") {\n109\t    // signature is a provider-internal verification token, not visible content\n110\t    return { type: \"thinking\", text: b[\"thinking\"] };\n111\t  }\n112\t  // text / tool_use / tool_result / unknown block shapes pass through verbatim\n113\t  return b;\n114\t}\n115\t\n116\t/**\n117\t * A deterministic session time for preserving unrecognized lines that carry\n118\t * no timestamp of their own: the first timestamp anywhere in the transcript\n119\t * (stable across rescans), falling back to the file mtime. Claude lines\n120\t * almost always carry a timestamp, so this is a rarely-hit safety net.\n121\t */\n122\tfunction firstTimestamp(lines: string[]): string | null {\n123\t  for (const text of lines) {\n124\t    if (!text.trim()) continue;\n125\t    try {\n126\t      const parsed = JSON.parse(text) as ClaudeTranscriptLine;\n127\t      if (typeof parsed.timestamp === \"string\" && !Number.isNaN(Date.parse(parsed.timestamp))) {\n128\t        return parsed.timestamp;\n129\t      }\n130\t    } catch {\n131\t      continue;\n132\t    }\n133\t  }\n134\t  return null;\n135\t}\n136\t\n137\t/** File mtime as ISO, else now — last-resort deterministic-ish base time. */\n138\tasync function sessionMtime(transcriptPath: string): Promise<string> {\n139\t  try {\n140\t    return (await stat(transcriptPath)).mtime.toISOString();\n141\t  } catch {\n142\t    return new Date().toISOString();\n143\t  }\n144\t}\n145\t\n146\t/**\n147\t * The agent facts this line states about itself. Claude Code stamps every\n148\t * transcript line with the CLI `version`, and labels assistant lines with the\n149\t * model that produced them; user lines carry no model, and none is invented\n150\t * for them — the model that will answer a prompt is not knowable from the\n151\t * prompt's own line, and the session's model can change mid-conversation.\n152\t * The provider is never stated (the same CLI can talk to the first-party API,\n153\t * Bedrock, or Vertex), so `provider` is left unset rather than assumed.\n154\t *\n155\t * Values pass through verbatim, including Claude Code's `\"<synthetic>\"`\n156\t * placeholder for harness-generated assistant messages: that is a true and\n157\t * useful statement about the turn (\"no model produced this\"), and rewriting\n158\t * it would be interpretation.\n159\t */\n160\tfunction agentContext(line: ClaudeTranscriptLine): ProducerAgentContext {\n161\t  const agent: ProducerAgentContext = {};\n162\t  if (typeof line.version === \"string\" && line.version) agent.source_version = line.version;\n163\t  const model = line.message?.model;\n164\t  if (typeof model === \"string\" && model) agent.model = model;\n165\t  return agent;\n166\t}\n167\t\n168\t/** Raw-only preservation event for an unrecognized claude-code line (see drift.ts). */\n169\tfunction preserve(\n170\t  type: string,\n171\t  line: ClaudeTranscriptLine,\n172\t  occurredAt: string,\n173\t  seq: number,\n174\t  fileSessionId: string,\n175\t  version: string,\n176\t): EventDraft {\n177\t  const sessionId = line.sessionId ?? fileSessionId;\n178\t  return unrecognizedDraft({\n179\t    typeKey: type,\n180\t    line,\n181\t    occurredAt,\n182\t    source: \"claude-code\",\n183\t    sessionId,\n184\t    seq,\n185\t    version,\n186\t    rawFormat: RAW_FORMAT,\n187\t    conversationId: `claude-code:${sessionId}`,\n188\t    agent: agentContext(line),\n189\t  });\n190\t}\n191\t\n192\tfunction convertLine(\n193\t  line: ClaudeTranscriptLine,\n194\t  seq: number,\n195\t  version: string,\n196\t  identity: GitUserIdentity,\n197\t): EventDraft | null {\n198\t  if (line.type !== \"user\" && line.type !== \"assistant\") return null;\n199\t  if (line.isSidechain === true) return null;\n200\t  if (!line.message) return null;\n201\t  if (typeof line.timestamp !== \"string\") return null;\n202\t  const sessionId = line.sessionId ?? \"\";\n203\t\n204\t  const actor: Actor = line.type === \"user\" ? { type: \"human\" } : { type: \"agent\" };\n205\t  if (line.type === \"user\") {\n206\t    if (identity.email) actor.id = identity.email;\n207\t    if (identity.name) actor.display = identity.name;\n208\t  }\n209\t  if (line.type === \"assistant\" && line.message.model) actor.id = line.message.model;\n210\t\n211\t  return {\n212\t    kind: \"conversation_turn\",\n213\t    occurred_at: line.timestamp,\n214\t    actor,\n215\t    producer: {\n216\t      tool: \"cledger\",\n217\t      version,\n218\t      source: \"claude-code\",\n219\t      session_id: sessionId,\n220\t      ...agentContext(line),\n221\t    },\n222\t    conversation: { id: `claude-code:${sessionId}`, seq },\n223\t    content: { role: line.message.role, blocks: convertContentBlocks(line.message.content) },\n224\t    raw: { format: RAW_FORMAT, data: line },\n225\t  };\n226\t}\n227\t\n228\t/**\n229\t * Re-normalization hook (see renormalize.ts): given a preserved\n230\t * `unrecognized` event this adapter's `producer.source` owns, try to turn its\n231\t * stored `raw.data` into the `conversation_turn` a live capture would produce.\n232\t *\n233\t * Id fidelity is the whole point: `convertLine` is fed the exact inputs the\n234\t * capture loop used — the same source line (`raw.data`), the same seq\n235\t * (`conversation.seq`), the same session id (carried in the line) — so the\n236\t * turn's identity subset, and therefore its id, is byte-identical to what a\n237\t * later live capture of the same line yields, and the two dedup instead of\n238\t * duplicating. `version`/`identity` are the current ones (version is not part\n239\t * of identity; identity is the same git identity a live capture here would\n240\t * read). Returns null when this adapter still cannot interpret the line —\n241\t * timestampless lines included, since `convertLine` requires a timestamp — in\n242\t * which case it stays preserved raw-only.\n243\t */\n244\texport function renormalizeUnrecognized(\n245\t  event: EvidenceEvent,\n246\t  identity: GitUserIdentity,\n247\t): EventDraft | null {\n248\t  if (!event.raw || event.conversation === undefined) return null;\n249\t  const line = event.raw.data as ClaudeTranscriptLine;\n250\t  return convertLine(line, event.conversation.seq, packageVersion(), identity);\n251\t}\n252\t\n253\texport async function runClaudeCodeHook(stdinJson: string): Promise<void> {\n254\t  try {\n255\t    const payload = JSON.parse(stdinJson) as ClaudeCodeHookPayload;\n256\t    const cwd = payload.cwd ?? process.cwd();\n257\t    if (!payload.transcript_path) return;\n258\t    const repo = await findRepo(cwd);\n259\t    if (!repo) return; // hooks must never break the user's session outside a repo\n260\t    await captureClaudeTranscript(payload.transcript_path, cwd);\n261\t  } catch (err) {\n262\t    process.stderr.write(\n263\t      `cledger: claude-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n264\t    );\n265\t  }\n266\t}\n267\t\n268\texport async function captureClaudeTranscript(\n269\t  transcriptPath: string,\n270\t  cwd: string,\n271\t): Promise<CaptureResult> {\n272\t  const repo = await findRepo(cwd);\n273\t  if (!repo) throw new Error(\"not inside a git repository\");\n274\t\n275\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n276\t  let raw: string;\n277\t  try {\n278\t    raw = await readFile(transcriptPath, \"utf8\");\n279\t  } catch {\n280\t    return result; // transcript not written yet\n281\t  }\n282\t  const lines = raw.split(\"\\n\");\n283\t  if (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n284\t\n285\t  const sessionId = basename(transcriptPath, \".jsonl\");\n286\t  let cursor = await readCursor(repo, sessionId);\n287\t  if (cursor > lines.length) cursor = 0; // transcript is shorter than expected — rescan from the start\n288\t\n289\t  const version = packageVersion();\n290\t  const identity = await gitUserIdentity(repo);\n291\t  let baseTime: string | null = null; // computed lazily, only if a timestampless unrecognized line needs it\n292\t  const drafts: EventDraft[] = [];\n293\t  for (let i = cursor; i < lines.length; i++) {\n294\t    const text = lines[i]!;\n295\t    if (!text.trim()) continue;\n296\t    let parsed: ClaudeTranscriptLine;\n297\t    try {\n298\t      parsed = JSON.parse(text) as ClaudeTranscriptLine;\n299\t    } catch {\n300\t      continue; // partial line — normal at the tail of a live transcript\n301\t    }\n302\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n303\t    if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n304\t      if (!KNOWN_SKIPPED_LINE_TYPES.has(type)) {\n305\t        countUnrecognized(result.unrecognized, type);\n306\t        if (baseTime === null) baseTime = firstTimestamp(lines) ?? (await sessionMtime(transcriptPath));\n307\t        const occurredAt = typeof parsed.timestamp === \"string\" ? parsed.timestamp : baseTime;\n308\t        drafts.push(preserve(type, parsed, occurredAt, i, sessionId, version));\n309\t      }\n310\t      continue;\n311\t    }\n312\t    const draft = convertLine(parsed, i, version, identity);\n313\t    if (draft) drafts.push(draft);\n314\t  }\n315\t\n316\t  if (drafts.length > 0) {\n317\t    const appendResult = await appendEvents(repo, drafts);\n318\t    result.appended = appendResult.appended.length;\n319\t    result.deduped = appendResult.deduped;\n320\t  }\n321\t  await writeCursor(repo, sessionId, lines.length);\n322\t  process.stderr.write(\n323\t    `cledger: claude-code +${result.appended} events (${result.deduped} deduped)\\n`,\n324\t  );\n325\t  warnUnrecognized(\"claude-code\", result.unrecognized);\n326\t  return result;\n327\t}\n328\t","tool_use_id":"toolu_01DJV5Du9FWiGh3Xgras6VY4","type":"tool_result"}],"role":"user"},"context":{"branch":"worktree-capture-everything","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger/.claude/worktrees/capture-everything","head":"1100858ed17a7ee0b377097e93eafa24d3638f68","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:9a01c126-8f0a-4060-95f9-fe3a00a2a8c3","seq":28}