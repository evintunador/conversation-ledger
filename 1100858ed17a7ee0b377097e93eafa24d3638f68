ole: \"assistant\",\n51\t        model: \"claude-x\",\n52\t        content: [\n53\t          { type: \"thinking\", thinking: \"I should check files\", signature: \"SIGABC123\" },\n54\t          { type: \"text\", text: \"Done.\" },\n55\t        ],\n56\t      },\n57\t    },\n58\t    {\n59\t      type: \"assistant\",\n60\t      isSidechain: true,\n61\t      sessionId: SESSION_ID,\n62\t      timestamp: \"2026-01-01T00:00:04.000Z\",\n63\t      message: { role: \"assistant\", content: \"sidechain content, must be dropped\" },\n64\t    },\n65\t    {\n66\t      type: \"system\",\n67\t      sessionId: SESSION_ID,\n68\t      timestamp: \"2026-01-01T00:00:05.000Z\",\n69\t      message: { role: \"system\", content: \"system event, must be dropped\" },\n70\t    },\n71\t  ];\n72\t}\n73\t\n74\tasync function writeTranscript(dir: string): Promise<string> {\n75\t  const path = join(dir, `${SESSION_ID}.jsonl`);\n76\t  const lines = transcriptLines().map((l) => JSON.stringify(l));\n77\t  // Line 6: a truncated/malformed trailing line — must not crash capture.\n78\t  lines.push('{\"type\":\"user\",\"sessionId\":\"sess-1\",\"message\": {\"role\": \"user\"');\n79\t  await writeFile(path, lines.join(\"\\n\") + \"\\n\");\n80\t  return path;\n81\t}\n82\t\n83\ttest(\"captureClaudeTranscript: converts a synthetic transcript end to end\", async () => {\n84\t  const repo = await makeTempRepo(\"cledger-cc-\");\n85\t  const transcriptDir = await mkdtemp(join(tmpdir(), \"cledger-cc-transcript-\"));\n86\t  try {\n87\t    await makeCommit(repo, \"init\");\n88\t    const transcriptPath = await writeTranscript(transcriptDir);\n89\t\n90\t    await captureClaudeTranscript(transcriptPath, repo.root);\n91\t\n92\t    const events = await readEvents(repo);\n93\t    assert.strictEqual(events.length, 4, \"sidechain, system, and malformed lines must be dropped\");\n94\t\n95\t    for (const e of events) {\n96\t      assert.strictEqual(e.raw?.format, \"claude-code-jsonl/1\");\n97\t      assert.strictEqual(e.conversation?.id, `claude-code:${SESSION_ID}`);\n98\t      assert.strictEqual(e.producer.source, \"claude-code\");\n99\t      assert.strictEqual(e.producer.session_id, SESSION_ID);\n100\t    }\n101\t\n102\t    // seq must equal the original line index in the transcript file.\n103\t    const bySeq = new Map(events.map((e) => [e.conversation!.seq, e]));\n104\t    assert.deepStrictEqual([...bySeq.keys()].sort((a, b) => a - b), [0, 1, 2, 3]);\n105\t\n106\t    const line0 = bySeq.get(0)!;\n107\t    assert.strictEqual(line0.actor.type, \"human\");\n108\t    assert.strictEqual(line0.actor.id, \"test@example.com\");\n109\t    assert.strictEqual(line0.actor.display, \"Test User\");\n110\t    assert.deepStrictEqual(line0.content, {\n111\t      role: \"user\",\n112\t      blocks: [{ type: \"text\", text: \"Hello there\" }],\n113\t    });\n114\t    assert.strictEqual(line0.occurred_at, \"2026-01-01T00:00:00.000Z\");\n115\t\n116\t    const line1 = bySeq.get(1)!;\n117\t    assert.strictEqual(line1.actor.type, \"agent\");\n118\t    assert.strictEqual(line1.actor.id, \"claude-x\");\n119\t    const line1Content = line1.content as { role: string; blocks: unknown[] };\n120\t    assert.deepStrictEqual(line1Content.blocks[1], {\n121\t      type: \"tool_use\",\n122\t      id: \"call_1\",\n123\t      name: \"Bash\",\n124\t      input: { command: \"ls\" },\n125\t    });\n126\t\n127\t    const line2 = bySeq.get(2)!;\n128\t    const line2Content = line2.content as { role: string; blocks: unknown[] };\n129\t    assert.deepStrictEqual(line2Content.blocks[0], {\n130\t      type: \"tool_result\",\n131\t      tool_use_id: \"call_1\",\n132\t      content: \"file1\\nfile2\",\n133\t    });\n134\t\n135\t    const line3 = bySeq.get(3)!;\n136\t    const line3Content = line3.content as { role: string; blocks: unknown[] };\n137\t    const thinkingBlock = line3Content.blocks[0] as Record<string, unknown>;\n138\t    assert.strictEqual(thinkingBlock[\"type\"], \"thinking\");\n139\t    assert.strictEqual(thinkingBlock[\"text\"], \"I should check files\");\n140\t    assert.strictEqual(\n141\t      \"signature\" in thinkingBlock,\n142\t      false,\n143\t      \"signature is provider-internal and must never be stored\",\n144\t    );\n145\t\n146\t    // --- Rerun on the unchanged transcript: cursor is past EOF, no new events. ---\n147\t    await captureClaudeTranscript(transcriptPath, repo.root);\n148\t    const eventsAfterRerun = await readEvents(repo);\n149\t    assert.strictEqual(eventsAfterRerun.length, 4, \"rerun on unchanged transcript must not duplicate\");\n150\t  } finally {\n151\t    await cleanupRepo(repo);\n152\t    await cleanupDir(transcriptDir);\n153\t  }\n154\t});\n155\t\n156\ttest(\"captureClaudeTranscript: unrecognized line types are counted, known ones stay silent\", async () => {\n157\t  const repo = await makeTempRepo(\"cledger-cc-drift-\");\n158\t  const transcriptDir = await mkdtemp(join(tmpdir(), \"cledger-cc-drift-\"));\n159\t  try {\n160\t    await makeCommit(repo, \"init\");\n161\t    const path = join(transcriptDir, `${SESSION_ID}.jsonl`);\n162\t    const lines = [\n163\t      {\n164\t        type: \"user\",\n165\t        sessionId: SESSION_ID,\n166\t        timestamp: \"2026-01-01T00:00:00.000Z\",\n167\t        message: { role: \"user\", content: \"hi\" },\n168\t      },\n169\t      // Known bookkeeping types: skipped without complaint.\n170\t      { type: \"file-history-snapshot\", sessionId: SESSION_ID },\n171\t      { type: \"queue-operation\", sessionId: SESSION_ID },\n172\t      // A type this adapter has never heard of — the drift tripwire.\n173\t      { type: \"holo-message\", sessionId: SESSION_ID, timestamp: \"2026-01-01T00:00:05.000Z\", hologram: \"new content kind\" },\n174\t      { type: \"holo-message\", sessionId: SESSION_ID, timestamp: \"2026-01-01T00:00:06.000Z\", hologram: \"again\" },\n175\t    ];\n176\t    await writeFile(path, lines.map((l) => JSON.stringify(l)).join(\"\\n\") + \"\\n\");\n177\t\n178\t    const result = await captureClaudeTranscript(path, repo.root);\n179\t    // 1 interpreted turn + 2 raw-only preservation events for the drift lines.\n180\t    assert.strictEqual(result.appended, 3);\n181\t    assert.deepStrictEqual(result.unrecognized, { \"holo-message\": 2 });\n182\t\n183\t    // The unrecognized lines are preserved raw-only, not dropped.\n184\t    const preserved = (await readEvents(repo)).filter((e) => e.kind === \"unrecognized\");\n185\t    assert.strictEqual(preserved.length, 2);\n186\t    const first = preserved.sort((a, b) => a.conversation!.seq - b.conversation!.seq)[0]!;\n187\t    assert.strictEqual(first.actor.type, \"system\");\n188\t    assert.deepStrictEqual(first.content, { unrecognized_type: \"holo-message\" });\n189\t    assert.strictEqual(first.raw!.format, \"claude-code-jsonl/1\");\n190\t    assert.deepStrictEqual(first.raw!.data, {\n191\t      type: \"holo-message\",\n192\t      sessionId: SESSION_ID,\n193\t      timestamp: \"2026-01-01T00:00:05.000Z\",\n194\t      hologram: \"new content kind\",\n195\t    });\n196\t    assert.strictEqual(first.occurred_at, \"2026-01-01T00:00:05.000Z\");\n197\t  } finally {\n198\t    await cleanupRepo(repo);\n199\t    await cleanupDir(transcriptDir);\n200\t  }\n201\t});\n202\t\n203\ttest(\"captureClaudeTranscript: a timestampless unrecognized line still gets a deterministic occurred_at\", async () => {\n204\t  const repo = await makeTempRepo(\"cledger-cc-drift-ts-\");\n205\t  const transcriptDir = await mkdtemp(join(tmpdir(), \"cledger-cc-drift-ts-\"));\n206\t  try {\n207\t    await makeCommit(repo, \"init\");\n208\t    const path = join(transcriptDir, `${SESSION_ID}.jsonl`);\n209\t    const lines = [\n210\t      {\n211\t        type: \"user\",\n212\t        sessionId: SESSION_ID,\n213\t        timestamp: \"2026-01-01T00:00:00.000Z\",\n214\t        message: { role: \"user\", content: \"hi\" },\n215\t      },\n216\t      // No timestamp of its own — must fall back to the transcript's first timestamp.\n217\t      { type: 