{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"520\t/**\n521\t * Re-normalization hook (see renormalize.ts): given a preserved\n522\t * `unrecognized` event this adapter's `producer.source` owns, try to turn its\n523\t * stored `raw.data` into the `conversation_turn` a live capture would produce.\n524\t *\n525\t * Id fidelity is the whole point: `convertLine` is fed the exact inputs the\n526\t * capture loop used — the same source line (`raw.data`), the same seq\n527\t * (`conversation.seq`), the same session id (carried in the line) — so the\n528\t * turn's identity subset, and therefore its id, is byte-identical to what a\n529\t * later live capture of the same line yields, and the two dedup instead of\n530\t * duplicating. `version`/`identity` are the current ones (version is not part\n531\t * of identity; identity is the same git identity a live capture here would\n532\t * read). Returns null when this adapter still cannot interpret the line —\n533\t * timestampless lines included, since `convertLine` requires a timestamp — in\n534\t * which case it stays preserved raw-only.\n535\t */\n536\texport function renormalizeUnrecognized(\n537\t  event: EvidenceEvent,\n538\t  identity: GitUserIdentity,\n539\t): EventDraft | null {\n540\t  if (!event.raw || event.conversation === undefined) return null;\n541\t  const line = event.raw.data as ClaudeTranscriptLine;\n542\t  return convertLine(line, event.conversation.seq, packageVersion(), identity);\n543\t}\n544\t\n545\texport async function runClaudeCodeHook(stdinJson: string): Promise<void> {\n546\t  try {\n547\t    const payload = JSON.parse(stdinJson) as ClaudeCodeHookPayload;\n548\t    const cwd = payload.cwd ?? process.cwd();\n549\t    if (!payload.transcript_path) return;\n550\t    const repo = await findRepo(cwd);\n551\t    if (!repo) return; // hooks must never break the user's session outside a repo\n552\t    await captureClaudeTranscript(payload.transcript_path, cwd);\n553\t  } catch (err) {\n554\t    process.stderr.write(\n555\t      `cledger: claude-code hook error: ${err instanceof Error ? err.message : String(err)}\\n`,\n556\t    );\n557\t  }\n558\t}\n559\t\n560\texport async function captureClaudeTranscript(\n561\t  transcriptPath: string,\n562\t  cwd: string,\n563\t): Promise<CaptureResult> {\n564\t  const repo = await findRepo(cwd);\n565\t  if (!repo) throw new Error(\"not inside a git repository\");\n566\t\n567\t  const result: CaptureResult = { appended: 0, deduped: 0, unrecognized: {} };\n568\t  let raw: string;\n569\t  try {\n570\t    raw = await readFile(transcriptPath, \"utf8\");\n571\t  } catch {\n572\t    return result; // transcript not written yet\n573\t  }\n574\t  const lines = raw.split(\"\\n\");\n575\t  if (lines.length > 0 && lines[lines.length - 1] === \"\") lines.pop();\n576\t\n577\t  const sessionId = basename(transcriptPath, \".jsonl\");\n578\t  let cursor = await readCursor(repo, sessionId);\n579\t  if (cursor > lines.length) cursor = 0; // transcript is shorter than expected — rescan from the start\n580\t\n581\t  const version = packageVersion();\n582\t  const identity = await gitUserIdentity(repo);\n583\t  let baseTime: string | null = null; // computed lazily, only if a timestampless unrecognized line needs it\n584\t  const drafts: EventDraft[] = [];\n585\t  for (let i = cursor; i < lines.length; i++) {\n586\t    const text = lines[i]!;\n587\t    if (!text.trim()) continue;\n588\t    let parsed: ClaudeTranscriptLine;\n589\t    try {\n590\t      parsed = JSON.parse(text) as ClaudeTranscriptLine;\n591\t    } catch {\n592\t      continue; // partial line — normal at the tail of a live transcript\n593\t    }\n594\t    const type = typeof parsed.type === \"string\" ? parsed.type : \"(untyped)\";\n595\t    if (!CONVERTIBLE_LINE_TYPES.has(type)) {\n596\t      if (!KNOWN_SKIPPED_LINE_TYPES.has(type)) {\n597\t        countUnrecognized(result.unrecognized, type);\n598\t        if (baseTime