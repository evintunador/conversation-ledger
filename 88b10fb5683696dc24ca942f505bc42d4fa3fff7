{"actor":{"type":"system"},"content":{"blocks":[{"content":"     1\timport { readEvents, sortEvents, type EvidenceEvent, type RepoInfo } from \"conversation-ledger\";\n     2\timport { turnContent, type ConversationSummary } from \"./types.js\";\n     3\t\n     4\texport interface ListOptions {\n     5\t  /** Include conversations from all authors, not just `user` / unowned. */\n     6\t  all?: boolean;\n     7\t  /** The current user's identity (git email) for ownership filtering. */\n     8\t  user?: string | undefined;\n     9\t  /** List conversations from all anchors, not just those reachable from HEAD. */\n    10\t  anyCommit?: boolean;\n    11\t}\n    12\t\n    13\t/** Human-typed text, as opposed to CLI-injected wrappers like <command-name>. */\n    14\tfunction meaningfulText(text: string): string | null {\n    15\t  const t = text.trim();\n    16\t  if (!t || t.startsWith(\"<\")) return null;\n    17\t  return t;\n    18\t}\n    19\t\n    20\tfunction deriveTitle(events: EvidenceEvent[]): string {\n    21\t  for (const event of events) {\n    22\t    if (event.actor.type !== \"human\") continue;\n    23\t    const content = turnContent(event);\n    24\t    if (!content || content.role !== \"user\") continue;\n    25\t    for (const block of content.blocks) {\n    26\t      if (block.type !== \"text\" || typeof block.text !== \"string\") continue;\n    27\t      const t = meaningfulText(block.text);\n    28\t      if (!t) continue;\n    29\t      const oneLine = t.replace(/\\s+/g, \" \");\n    30\t      return oneLine.length > 80 ? oneLine.slice(0, 77) + \"...\" : oneLine;\n    31\t    }\n    32\t  }\n    33\t  return \"(no visible user message)\";\n    34\t}\n    35\t\n    36\t/** Kinds turnbridge builds conversations from: visible turns plus opaque,\n    37\t * provider-encrypted reasoning (readEvents' `kind` filter is exact-match\n    38\t * only, so fetch everything and narrow here rather than issuing two reads). */\n    39\tfunction inScope(event: EvidenceEvent): boolean {\n    40\t  return event.kind === \"conversation_turn\" || event.kind === \"reasoning\";\n    41\t}\n    42\t\n    43\texport async function listConversations(\n    44\t  repo: RepoInfo,\n    45\t  opts: ListOptions = {},\n    46\t): Promise<ConversationSummary[]> {\n    47\t  const events = (\n    48\t    await readEvents(repo, opts.anyCommit ? {} : { reachableFrom: \"HEAD\" })\n    49\t  ).filter(inScope);\n    50\t\n    51\t  const groups = new Map<string, EvidenceEvent[]>();\n    52\t  for (const event of events) {\n    53\t    if (!event.stream?.id) continue;\n    54\t    const group = groups.get(event.stream.id);\n    55\t    if (group) group.push(event);\n    56\t    else groups.set(event.stream.id, [event]);\n    57\t  }\n    58\t\n    59\t  const summaries: ConversationSummary[] = [];\n    60\t  for (const [id, group] of groups) {\n    61\t    const sorted = sortEvents(group);\n    62\t    const owners = new Set<string>();\n    63\t    const ownerDisplays = new Set<string>();\n    64\t    for (const event of sorted) {\n    65\t      if (event.actor.type === \"human\") {\n    66\t        if (event.actor.id) owners.add(event.actor.id);\n    67\t        if (event.actor.display) ownerDisplays.add(event.actor.display);\n    68\t      }\n    69\t    }\n    70\t    const first = sorted[0]!;\n    71\t    const last = sorted[sorted.length - 1]!;\n    72\t    const source = first.producer.source ?? id.split(\":\")[0] ?? \"unknown\";\n    73\t    const sessionId = first.producer.session_id ?? id.split(\":\").slice(1).join(\":\");\n    74\t    summaries.push({\n    75\t      id,\n    76\t      source,\n    77\t      sessionId,\n    78\t      title: deriveTitle(sorted),\n    79\t      firstActivity: first.occurred_at,\n    80\t      lastActivity: last.occurred_at,","is_error":false,"tool_use_id":"toolu_01HNzHwWTbj9geaPFZwfLX9F","type":"tool_result"}],"role":"user"},"context":{"branch":"annals-extraction","cwd":"/Users/evintunador/repos/evintunador/c