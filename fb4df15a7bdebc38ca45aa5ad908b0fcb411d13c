// flagged spans and must not enter a captured conversation.\nimport { execFileSync } from \"node:child_process\";\n\nconst [repo, ...prefixes] = process.argv.slice(2);\nconst want = prefixes.map((p) => p.replace(/^ev1-/, \"\"));\n\nconst notesRef = \"refs/notes/conversation-ledger\";\nconst anchors = execFileSync(\"git\", [\"notes\", \"--ref\", notesRef, \"list\"], {\n  cwd: repo, encoding: \"utf8\", maxBuffer: 1024 * 1024 * 64,\n});\n\nconst safe = [];\nfor (const line of anchors.trim().split(\"\\n\")) {\n  const [noteOid] = line.split(\" \");\n  const body = execFileSync(\"git\", [\"cat-file\", \"-p\", noteOid], {\n    cwd: repo, encoding: \"utf8\", maxBuffer: 1024 * 1024 * 256,\n  });\n  for (const l of body.split(\"\\n\")) {\n    if (!l.trim()) continue;\n    let ev;\n    try { ev = JSON.parse(l); } catch { continue; }\n    const short = (ev.id ?? \"\").replace(/^ev1-/, \"\");\n    if (!want.some((w) => short.startsWith(w))) continue;\n    const meta = {\n      id: (ev.id ?? \"\").slice(0, 16),\n      kind: ev.kind,\n      occurred_at: ev.occurred_at,\n      conversation: ev.conversation,\n    };\n    // tool name + file_path from known shapes, content NEVER\n    const blocks = ev.content?.blocks ?? [];\n    meta.blockTypes = blocks.map((b) => b.type ?? typeof b);\n    for (const b of blocks) {\n      if (b.name) meta.tool = b.name;\n      if (b.input?.file_path) meta.file_path = b.input.file_path;\n      if (b.input?.notebook_path) meta.file_path = b.input.notebook_path;\n    }\n    const raw = ev.raw?.data;\n    if (raw?.toolUseResult?.filePath) meta.result_file = raw.toolUseResult.filePath;\n    if (raw?.toolUseResult?.file?.filePath) meta.result_file = raw.toolUseResult.file.filePath;\n    if (raw?.cwd) meta.cwd = raw.cwd;\n    safe.push(meta);\n  }\n}\nconsole.log(JSON.stringify(safe, null, 1));\n","filePath":"/Users/evintunador/.claude/jobs/b8bc0200/tmp/finding-metadata.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"t