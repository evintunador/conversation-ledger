{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { git } from \"../git.js\";\n4\timport { serializeEvent } from \"../schema.js\";\n5\timport {\n6\t  appendEvents,\n7\t  listAnchors,\n8\t  NOTES_NAME,\n9\t  NOTES_REF,\n10\t  readEvents,\n11\t  readNoteEvents,\n12\t  readPending,\n13\t  redactEvent,\n14\t  RedactAfterShareError,\n15\t  sync,\n16\t} from \"../store.js\";\n17\timport {\n18\t  cleanupDir,\n19\t  cleanupRepo,\n20\t  draft,\n21\t  makeBareRepo,\n22\t  makeCommit,\n23\t  makeTempRepo,\n24\t} from \"./helpers.js\";\n25\t\n26\ttest(\"redactEvent: --pattern rewrites content+raw, preserves the id, appends a redacts companion, and squashes local history\", async () => {\n27\t  const repo = await makeTempRepo();\n28\t  try {\n29\t    await makeCommit(repo, \"init\");\n30\t    const secret = \"hunter2xK9aa\"; // format the capture-tier ruleset does not recognize\n31\t    const originalDraft = draft({\n32\t      content: { text: `db_password: ${secret}` },\n33\t      raw: { format: \"test/1\", data: { blob: `db_password: ${secret}` } },\n34\t    });\n35\t    const appendResult = await appendEvents(repo, [originalDraft]);\n36\t    assert.strictEqual(appendResult.appended.length, 1);\n37\t    const original = appendResult.appended[0]!;\n38\t    assert.ok(\n39\t      JSON.stringify(original).includes(secret),\n40\t      \"sanity: this secret shape must survive capture-tier redaction unredacted\",\n41\t    );\n42\t\n43\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret, reason: \"test-reason\" });\n44\t\n45\t    // Id preservation is the crux of the whole mechanism: rewriting the\n46\t    // content must not change the event's id (see the CRITICAL comment in\n47\t    // store.ts) or a later rescan would resurrect the secret under the old\n48\t    // id.\n49\t    assert.strictEqual(result.event.id, original.id);\n50\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n51\t    assert.ok(!JSON.stringify(result.event.raw ?? {}).includes(secret));\n52\t    assert.ok(result.event.redactions?.some((r) => r.rule === \"manual\"));\n53\t\n54\t    // Companion event.\n55\t    assert.strictEqual(result.redactionEvent.kind, \"redaction\");\n56\t    assert.deepStrictEqual(result.redactionEvent.links, [{ rel: \"redacts\", target: original.id }]);\n57\t    const companionContent = result.redactionEvent.content as {\n58\t      target: string;\n59\t      mode: string;\n60\t      reason?: string;\n61\t    };\n62\t    assert.strictEqual(companionContent.target, original.id);\n63\t    assert.strictEqual(companionContent.mode, \"pattern\");\n64\t    assert.strictEqual(companionContent.reason, \"test-reason\");\n65\t\n66\t    // The stored note itself reflects the rewrite, not just the returned object.\n67\t    const [anchor] = await listAnchors(repo);\n68\t    assert.ok(anchor);\n69\t    const stored = await readNoteEvents(repo, anchor);\n70\t    const storedTarget = stored.find((e) => e.id === original.id);\n71\t    assert.ok(storedTarget);\n72\t    assert.ok(!JSON.stringify(storedTarget).includes(secret));\n73\t\n74\t    // No remote configured: local notes history is squashed to one commit.\n75\t    assert.strictEqual(result.squashed, true);\n76\t    const log = await git([\"log\", \"--oneline\", NOTES_REF], { cwd: repo.root });\n77\t    assert.strictEqual(log.trim().split(\"\\n\").filter(Boolean).length, 1);\n78\t\n79\t    // THE dedup test: re-appending the exact original, unredacted draft\n80\t    // must not resurrect the secret under a new event. Because the\n81\t    // rewritten event kept the original id, recomputing the id for the\n82\t    // same source draft collides with the id already on record (which now\n83\t    // holds redacted content), so it dedups instead of creating a second,\n84\t    // unredacted copy.\n85\t    const rescan = await appendEvents(repo, [originalDraft]);\n86\t    assert.strictEqual(rescan.appended.length, 0, \"the secret must not be able to sneak back in via rescan\");\n87\t    assert.strictEqual(rescan.deduped, 1);\n88\t\n89\t    const eventsAfterRescan = await readEvents(repo);\n90\t    const copiesOfTarget = eventsAfterRescan.filter((e) => e.id === original.id);\n91\t    assert.strictEqual(copiesOfTarget.length, 1, \"must still be exactly one copy of the event under this id\");\n92\t    assert.ok(!JSON.stringify(copiesOfTarget[0]).includes(secret));\n93\t  } finally {\n94\t    await cleanupRepo(repo);\n95\t  }\n96\t});\n97\t\n98\ttest(\"redactEvent: --all replaces content with a placeholder and drops raw entirely\", async () => {\n99\t  const repo = await makeTempRepo();\n100\t  try {\n101\t    await makeCommit(repo, \"init\");\n102\t    const secret = \"hunter2xK9aa\";\n103\t    const appendResult = await appendEvents(repo, [\n104\t      draft({\n105\t        content: { text: `db_password: ${secret}` },\n106\t        raw: { format: \"test/1\", data: { blob: `db_password: ${secret}` } },\n107\t      }),\n108\t    ]);\n109\t    const original = appendResult.appended[0]!;\n110\t\n111\t    const result = await redactEvent(repo, original.id.slice(4, 12), { all: true });\n112\t\n113\t    assert.strictEqual(result.event.id, original.id);\n114\t    assert.strictEqual(typeof result.event.content, \"string\");\n115\t    assert.match(result.event.content as string, /^\\[REDACTED:manual:[0-9a-f]{12}\\]$/);\n116\t    assert.strictEqual(result.event.raw, undefined);\n117\t    assert.strictEqual(result.squashed, true);\n118\t  } finally {\n119\t    await cleanupRepo(repo);\n120\t  }\n121\t});\n122\t\n123\ttest(\"redactEvent: pending-queue redaction works before the first commit exists, no squash needed\", async () => {\n124\t  const repo = await makeTempRepo();\n125\t  try {\n126\t    const secret = \"hunter2xK9aa\";\n127\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n128\t    assert.strictEqual(appendResult.anchor, null, \"HEAD must still be unborn\");\n129\t    const original = appendResult.appended[0]!;\n130\t\n131\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n132\t\n133\t    assert.strictEqual(result.event.id, original.id);\n134\t    assert.strictEqual(result.squashed, false, \"nothing was ever anchored, so there is no history to squash\");\n135\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n136\t\n137\t    const pending = await readPending(repo);\n138\t    const target = pending.find((e) => e.id === original.id);\n139\t    assert.ok(target, \"rewritten target must still be in the pending queue\");\n140\t    assert.ok(!JSON.stringify(target).includes(secret));\n141\t\n142\t    const companion = pending.find((e) =>\n143\t      e.links?.some((l) => l.rel === \"redacts\" && l.target === original.id),\n144\t    );\n145\t    assert.ok(companion, \"companion redaction event must also be queued (HEAD is still unborn)\");\n146\t  } finally {\n147\t    await cleanupRepo(repo);\n148\t  }\n149\t});\n150\t\n151\ttest(\"redactEvent: refuses outright once the event is on origin, leaving the ledger untouched\", async () => {\n152\t  const remote = await makeBareRepo();\n153\t  const repo = await makeTempRepo();\n154\t  try {\n155\t    await makeCommit(repo, \"init\");\n156\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n157\t    const secret = \"hunter2xK9aa\";\n158\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n159\t    const original = appendResult.appended[0]!;\n160\t\n161\t    // Seed the remote with the pre-redaction content. This secret shape\n162\t    // trips the standard-tier keyword-assignment scan rule, so bypass the\n163\t    // gate here — that's the exact precondition this test needs, not what\n164\t    // it's testing.\n165\t    const pushResult = await sync(repo, \"origin\", \"push\", { skipScan: true });\n166\t    assert.strictEqual(pushResult.pushed, true);\n167\t\n168\t    const notesBefore = (await git([\"rev-parse\", NOTES_REF], { cwd: repo.root })).trim();\n169\t\n170\t    // Rewriting shared content does not remove it, and pushing the rewrite\n171\t    // would union the original back onto the remote — so this must refuse\n172\t    // rather than warn-and-proceed.\n173\t    await assert.rejects(\n174\t      () => redactEvent(repo, original.id.slice(4, 12), { pattern: secret }),\n175\t      (err: unknown) => {\n176\t        assert.ok(err instanceof RedactAfterShareError);\n177\t        assert.strictEqual(err.reason, \"already-pushed\");\n178\t        assert.strictEqual(err.eventId, original.id);\n179\t        return true;\n180\t      },\n181\t    );\n182\t\n183\t    // Refusal must be total: no rewritten line, no companion event, no\n184\t    // squash. A half-applied redaction is the state this whole change exists\n185\t    // to prevent.\n186\t    const notesAfter = (await git([\"rev-parse\", NOTES_REF], { cwd: repo.root })).trim();\n187\t    assert.strictEqual(notesAfter, notesBefore, \"the ledger ref must not have moved\");\n188\t    const events = await readEvents(repo, { reachableFrom: \"HEAD\" });\n189\t    assert.strictEqual(events.length, 1, \"no companion redaction event may have been appended\");\n190\t    assert.ok(JSON.stringify(events[0]).includes(secret), \"the event must be left exactly as it was\");\n191\t  } finally {\n192\t    await cleanupRepo(repo);\n193\t    await cleanupDir(remote);\n194\t  }\n195\t});\n196\t\n197\ttest(\"redactEvent: still works for an event captured after an earlier push\", async () => {\n198\t  const remote = await makeBareRepo();\n199\t  const repo = await makeTempRepo();\n200\t  try {\n201\t    await makeCommit(repo, \"init\");\n202\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n203\t\n204\t    // An unrelated event goes out first, so origin has the ledger ref.\n205\t    await appendEvents(repo, [draft({ content: { text: \"already shared, nothing secret\" } })]);\n206\t    await sync(repo, \"origin\", \"push\", { skipScan: true });\n207\t\n208\t    // The secret is captured afterwards and never pushed. Redaction must\n209\t    // remain available: gating per-repo instead of per-event would kill the\n210\t    // primary workflow the moment anyone pushed once.\n211\t    const secret = \"hunter2xK9aa\";\n212\t    const appendResult = await appendEvents(repo, [\n213\t      draft({ occurred_at: \"2026-02-02T00:00:00.000Z\", content: { text: `db_password: ${secret}` } }),\n214\t    ]);\n215\t    const original = appendResult.appended[0]!;\n216\t\n217\t    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n218\t    assert.strictEqual(result.event.id, original.id);\n219\t    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n220\t    assert.strictEqual(result.squashed, true, \"an unshared event's history is still severed\");\n221\t  } finally {\n222\t    await cleanupRepo(repo);\n223\t    await cleanupDir(remote);\n224\t  }\n225\t});\n226\t\n227\ttest(\"redactEvent: refuses when origin cannot be reached, rather than assuming nothing was shared\", async () => {\n228\t  const repo = await makeTempRepo();\n229\t  try {\n230\t    await makeCommit(repo, \"init\");\n231\t    // A remote that exists in config but resolves to nothing: `ls-remote`\n232\t    // fails, which must not be read as \"the remote has no ledger ref\".\n233\t    await git([\"remote\", \"add\", \"origin\", \"/nonexistent/cledger-unreachable-remote.git\"], {\n234\t      cwd: repo.root,\n235\t    });\n236\t    const secret = \"hunter2xK9aa\";\n237\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n238\t    const original = appendResult.appended[0]!;\n239\t\n240\t    await assert.rejects(\n241\t      () => redactEvent(repo, original.id.slice(4, 12), { pattern: secret }),\n242\t      (err: unknown) => {\n243\t        assert.ok(err instanceof RedactAfterShareError);\n244\t        assert.strictEqual(err.reason, \"remote-unreachable\");\n245\t        return true;\n246\t      },\n247\t    );\n248\t  } finally {\n249\t    await cleanupRepo(repo);\n250\t  }\n251\t});\n252\t\n253\ttest(\"readEvents: a redacted copy always beats its pre-redaction original, whatever the bytes say\", async () => {\n254\t  const repo = await makeTempRepo();\n255\t  try {\n256\t    const anchor = await makeCommit(repo, \"init\");\n257\t    // A leading uppercase letter is the adversarial case: 'A' (0x41) sorts\n258\t    // below the '[' (0x5B) that opens a [REDACTED:...] placeholder, so the\n259\t    // old canonical-JSON byte-compare tie-break picked the *plaintext*. Every\n260\t    // secret starting with a digit or capital hit this.\n261\t    const secret = \"AATOPSECRET1234\";\n262\t    const appendResult = await appendEvents(repo, [draft({ content: { text: `key ${secret} end` } })]);\n263\t    const original = appendResult.appended[0]!;\n264\t    const originalLine = serializeEvent(original);\n265\t\n266\t    await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n267\t\n268\t    // Reconstruct what cat_sort_uniq produces when a peer that still holds\n269\t    // the pre-redaction line merges in: two lines, one id, different content.\n270\t    const stored = await readNoteEvents(repo, anchor);\n271\t    const lines = [...stored.map(serializeEvent), originalLine].sort();\n272\t    await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n273\t      cwd: repo.root,\n274\t      input: lines.join(\"\\n\") + \"\\n\",\n275\t    });\n276\t\n277\t    const bothCopies = (await readNoteEvents(repo, anchor)).filter((e) => e.id === original.id);\n278\t    assert.strictEqual(bothCopies.length, 2, \"precondition: both copies must be in the note\");\n279\t    assert.strictEqual(\n280\t      bothCopies[0]!.recorded_at,\n281\t      bothCopies[1]!.recorded_at,\n282\t      \"precondition: the rewrite inherits the original's recorded_at, so that key ties\",\n283\t    );\n284\t\n285\t    const events = await readEvents(repo, { reachableFrom: \"HEAD\" });\n286\t    const surviving = events.filter((e) => e.id === original.id);\n287\t    assert.strictEqual(surviving.length, 1, \"the two copies must collapse to one\");\n288\t    assert.ok(\n289\t      !JSON.stringify(surviving[0]).includes(secret),\n290\t      \"the redacted copy must win — reads must never surface the pre-redaction plaintext\",\n291\t    );\n292\t  } finally {\n293\t    await cleanupRepo(repo);\n294\t  }\n295\t});\n296\t\n297\ttest(\"redactEvent: throws when no event matches the id prefix\", async () => {\n298\t  const repo = await makeTempRepo();\n299\t  try {\n300\t    await makeCommit(repo, \"init\");\n301\t    await assert.rejects(() => redactEvent(repo, \"ev1-doesnotexist\", { all: true }), /no event matches/);\n302\t  } finally {\n303\t    await cleanupRepo(repo);\n304\t  }\n305\t});\n306\t\n307\ttest(\"redactEvent: requires exactly one of --pattern or --all\", async () => {\n308\t  const repo = await makeTempRepo();\n309\t  try {\n310\t    await makeCommit(repo, \"init\");\n311\t    await assert.rejects(() => redactEvent(repo, \"ev1-x\", {}), /exactly one of/);\n312\t    await assert.rejects(\n313\t      () => redactEvent(repo, \"ev1-x\", { pattern: \"x\", all: true }),\n314\t      /exactly one of/,\n315\t    );\n316\t  } finally {\n317\t    await cleanupRepo(repo);\n318\t  }\n319\t});\n320\t","tool_use_id":"toolu_012D4SKBzQCWgXCo5gqHw3xu","type":"tool_result"}],"role":"user"},"context":{"branch":"redaction-ux","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux","head":"fb4df15a7bdebc38ca45aa5ad908b0fcb411d13c","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:b8bc0200-5312-42a4-9c54-a116d8d4a9