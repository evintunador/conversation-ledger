n127\t\n128\texport interface RenderOptions {\n129\t  /** Characters of surrounding text on each side. */\n130\t  context: number;\n131\t  /** Include the matched text verbatim instead of masking it. */\n132\t  reveal: boolean;\n133\t}\n134\t\n135\t/**\n136\t * A finding with enough surrounding text for a human to actually judge it.\n137\t *\n138\t * The whole point of the separate command: `formatFinding` is deliberately\n139\t * unreadable, so this is where readability lives. Callers are expected to send\n140\t * this to a file rather than a terminal — see `cledger inspect`.\n141\t */\n142\texport function renderFinding(event: EvidenceEvent, f: Finding, opts: RenderOptions): string {\n143\t  const value = collectStrings(event).get(f.path);\n144\t  if (value === undefined) {\n145\t    return `${f.path}: string no longer present in event ${f.eventId.slice(0, 16)} (event rewritten since the scan?)\\n`;\n146\t  }\n147\t  const lo = Math.max(0, f.start - opts.context);\n148\t  const hi = Math.min(value.length, f.end + opts.context);\n149\t  const match = opts.reveal ? value.slice(f.start, f.end) : MATCH_MARKER;\n150\t  const body = `${value.slice(lo, f.start)}${match}${value.slice(f.end, hi)}`;\n151\t  return [\n152\t    `rule:        ${f.rule}`,\n153\t    `fingerprint: ${f.fingerprint}`,\n154\t    `event:       ${f.eventId}`,\n155\t    `conversation:${f.conversation ?? \" -\"}`,\n156\t    `occurred_at: ${f.occurred_at}`,\n157\t    `location:    ${f.path}, chars ${f.start}-${f.end} of ${value.length}`,\n158\t    `match:       ${f.end - f.start} chars, ${opts.reveal ? \"SHOWN BELOW\" : \"masked (pass --reveal to show)\"}`,\n159\t    \"\",\n160\t    `${lo > 0 ? `…[${lo} chars before]…\\n` : \"\"}${body}${hi < value.length ? `\\n…[${value.length - hi} chars after]…` : \"\"}`,\n161\t    \"\",\n162\t  ].join(\"\\n\");\n163\t}\n164\t\n165\t/**\n166\t * Whether we appear to be running inside a coding-agent session, i.e. whether\n167\t * anything printed here will be swept int