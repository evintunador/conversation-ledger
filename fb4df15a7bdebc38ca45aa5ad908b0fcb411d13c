*/\n  context: number;\n  /** Include the matched text verbatim instead of masking it. */\n  reveal: boolean;\n}\n\n/**\n * A finding with enough surrounding text for a human to actually judge it.\n *\n * The whole point of the separate command: `formatFinding` is deliberately\n * unreadable, so this is where readability lives. Callers are expected to send\n * this to a file rather than a terminal — see `cledger inspect`.\n */\nexport function renderFinding(event: EvidenceEvent, f: Finding, opts: RenderOptions): string {\n  const value = collectStrings(event).get(f.path);\n  if (value === undefined) {\n    return `${f.path}: string no longer present in event ${f.eventId.slice(0, 16)} (event rewritten since the scan?)\\n`;\n  }\n  const lo = Math.max(0, f.start - opts.context);\n  const hi = Math.min(value.length, f.end + opts.context);\n  const match = opts.reveal ? value.slice(f.start, f.end) : MATCH_MARKER;\n  const body = `${value.slice(lo, f.start)}${match}${value.slice(f.end, hi)}`;\n  return [\n    `rule:        ${f.rule}`,\n    `fingerprint: ${f.fingerprint}`,\n    `event:       ${f.eventId}`,\n    `conversation:${f.conversation ?? \" -\"}`,\n    `occurred_at: ${f.occurred_at}`,\n    `location:    ${f.path}, chars ${f.start}-${f.end} of ${value.length}`,\n    `match:       ${f.end - f.start} chars, ${opts.reveal ? \"SHOWN BELOW\" : \"masked (pass --reveal to show)\"}`,\n    \"\",\n    `${lo > 0 ? `…[${lo} chars before]…\\n` : \"\"}${body}${hi < value.length ? `\\n…[${value.length - hi} chars after]…` : \"\"}`,\n    \"\",\n  ].join(\"\\n\");\n}\n\n/**\n * Whether we appear to be running inside a coding-agent session, i.e. whether\n * anything printed here will be swept into a transcript and captured as a new\n * event. Both supported harnesses export their own marker variables.\n *\n * Used to *refuse* to reveal flagged content rather than merely to warn: an\n * agent asked to investigate a blocked sync will otherwise do the helpful,\n * wrong thing and read the secret into the very record being protected.\n */\nexport function inAgentSession(env: NodeJS.ProcessEnv = process.env): string | null {\n  for (const key of Object.keys(env)) {\n    if (/^(CLAUDECODE|CLAUDE_CODE|CODEX_)/.test(key)) return key;\n  }\n  return null;\n}\n\n/**\n * Shared guidance for every place a finding is reported. Addresses humans and\n * agents separately and explicitly, because the correct action differs: a\n * human should go look, an agent should stop and say so.\n */\nexport function findingGuidance(eventIds: string[]): string {\n  // Prefix, not the full 68-char id: `inspect` takes a prefix, and the short\n  // form is what the finding lines above already show.\n  const first = (eventIds[0] ?? \"<event-id>\").slice(0, 16);\n  return [\n    \"  No excerpt is printed. The text around a match is what tripped the rule,\",\n    \"  so reprinting it into a session that gets captured creates a new event\",\n    \"  that trips the same rule — findings then multiply on every scan.\",\n    \"\",\n    \"  If you are a HUMAN: inspect it in a plain terminal, outside any agent:\",\n    `      cledger inspect ${first}`,\n    \"  That writes the full surrounding context to a file outside the repo and\",\n    \"  prints only the path. Add --reveal to include the matched text itself.\",\n    \"\",\n    \"  If you are an AGENT: stop here and hand this to the human. Do not run\",\n    \"  cledger inspect, cledger export, or otherwise read the flagged content —\",\n    \"  it would be captured into this conversation and re-seed the finding.\",\n  ].join(\"\\n\");\n}\n\n/** Findings whose fingerprint has been allowlisted (known false positive) are suppressed. */\nexport function filterFindings(findings: Finding[], allowlist: Set<string>): Finding[] {\n  return findings.filter((f) => !allowlist.has(f.fingerprint));\n}\n\ninterface AllowlistFile {\n  fingerprints: string[];\n}\n\nfunction allowlistPath(repo: RepoInfo): string {\n  return join(repo.commonDir, \"conversation-ledger\", \"allowlist.json\");\n}\n\n/** Local, rebuildable-if-lost state — same tier as pending.jsonl/cursors, never the record of truth. */\nexport async function loadAllowlist(repo: RepoInfo): Promise<Set<string>> {\n  try {\n    const raw = await readFile(allowlistPath(repo), \"utf8\");\n    const parsed = JSON.parse(raw) as AllowlistFile;\n    return new Set(Array.isArray(parsed.fingerprints) ? parsed.fingerprints : []);\n  } catch {\n    // Missing or malformed allowlist: treat as empty rather than failing the scan/sync.\n    return new Set();\n  }\n}\n\nexport async function addToAllowlist(repo: RepoInfo, fingerprints: string[]): Promise<void> {\n  const existing = await loadAllowlist(repo);\n  for (const fp of fingerprints) existing.add(fp);\n  await mkdir(join(repo.commonDir, \"conversation-ledger\"), { recursive: true });\n  await writeFile(\n    allowlistPath(repo),\n    JSON.stringify({ fingerprints: [...existing].sort() }, null, 2) + \"\\n\",\n  );\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/src/redact/scan.ts","numLines":240,"startLine":1,"totalLines":240},"type":"text"},"type":"user","userType":"external","uuid":"662ae5e1-5924-4a47-aea6-e5a232d488d7","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.468Z","schema":"conversation-ledger/v1"}
{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { canonicalJson, sha256Hex } from \"./canonical.js\";\n2\timport type { RedactionRecord } from \"./redact/apply.js\";\n3\t\n4\texport const SCHEMA_VERSION = \"conversation-ledger/v1\";\n5\t\n6\t/**\n7\t * The well-known event kinds. `kind` is an open string so downstream tools\n8\t * can extend the ledger without a schema release; unknown kinds are stored\n9\t * verbatim. The ledger never interprets content, whatever the kind.\n10\t *\n11\t * `unrecognized` is the one kind the ledger emits for content it could *not*\n12\t * interpret: an adapter that meets a transcript line type it has no mapping\n13\t * for preserves the line raw-only under `raw.data` rather than dropping it,\n14\t * so a later adapter version can re-normalize (and supersede) it. Its\n15\t * `content` carries only a `{unrecognized_type}` label — the payload lives in\n16\t * `raw` — but identity still separates distinct lines via `conversation.seq`.\n17\t *\n18\t * `reasoning` is for content the ledger deliberately never interprets: a\n19\t * provider-encrypted reasoning/thinking blob (e.g. Codex's `reasoning`\n20\t * response_items) that only the originating provider can decrypt. Its\n21\t * `content` carries only an opacity marker; the ciphertext lives in `raw`,\n22\t * for a consumer to opt into replaying back through the same provider.\n23\t * Unlike `unrecognized`, this is not a placeholder awaiting a smarter\n24\t * cledger version — no future version will ever be able to read it either.\n25\t *\n26\t * The four kinds below `reasoning` cover what a source records *around* the\n27\t * conversation. Every one of them was previously discarded at capture as\n28\t * \"bookkeeping\"; they are kept because the ledger's job is the whole record,\n29\t * and because the things a session declares about itself (which model, which\n30\t * sandbox, which worktree) are exactly what a consumer needs to judge whether\n31\t * a turn still applies. They are non-conversational by construction, so\n32\t * `log`/`show` hide them unless asked — recorded always, displayed on request.\n33\t *\n34\t * `session_state` is a *declaration that holds until restated*: the session's\n35\t * mode, permission mode, model settings, sandbox and approval policy, title,\n36\t * worktree or cwd relocation. Sources restate these freely, and each\n37\t * restatement is its own event — \"still true at this point in the transcript\"\n38\t * is a fact, not a duplicate.\n39\t *\n40\t * `activity` is a *point-in-time occurrence that is not a turn*: a hook run,\n41\t * a turn duration, a token count, a task starting or finishing, a queue\n42\t * operation, a context compaction, an aborted turn, a step boundary.\n43\t *\n44\t * `context_injection` is material the harness inserted into the model's\n45\t * context that no participant typed — Claude Code's `attachment` lines\n46\t * (task reminders, skill listings, diagnostics, pasted files). It is content\n47\t * the model read, which is why it is not `activity`, but nobody said it,\n48\t * which is why it is not `conversation_turn`.\n49\t *\n50\t * `file_snapshot` is intermediate file state: the versions a file passed\n51\t * through between commits. Tool calls cannot reconstruct this — a `Bash`\n52\t * mutation records the command, not the result — so without it the record of\n53\t * how a file got from one commit to the next has holes. Sources describe\n54\t * these versions with pointers into a machine-local cache, so the pointers\n55\t * live in `content` and what the ledger could resolve of them at capture time\n56\t * lives in `resolved`.\n57\t */\n58\texport const KNOWN_KINDS = [\n59\t  \"conversation_turn\",\n60\t  \"decision\",\n61\t  \"document\",\n62\t  \"annotation\",\n63\t  \"redaction\",\n64\t  \"supersession\",\n65\t  \"re_anchor\",\n66\t  \"unrecognized\",\n67\t  \"reasoning\",\n68\t  \"session_state\",\n69\t  \"activity\",\n70\t  \"context_injection\",\n71\t  \"file_s