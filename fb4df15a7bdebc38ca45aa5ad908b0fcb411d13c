;,$\\\\]{8,}/gi,\n  },\n  {\n    id: \"url-credentials\",\n    tier: \"standard\",\n    description: \"Credentials embedded in a URL (scheme://user:pass@host)\",\n    pattern: /[a-z][a-z0-9+.-]*:\\/\\/[^\\s\\/:@]+:[^\\s@]{4,}@/gi,\n  },\n  {\n    id: \"bearer-token\",\n    tier: \"standard\",\n    description: \"Bearer token in an Authorization-style header value\",\n    pattern: /\\bbearer\\s+[A-Za-z0-9_\\-.=]{20,}/gi,\n  },\n];\n\nconst PARANOID_RULES: RedactionRule[] = [\n  {\n    id: \"high-entropy\",\n    tier: \"paranoid\",\n    description: \"High-entropy token candidate; entropy filtering applied by the scanner\",\n    pattern: /\\b[A-Za-z0-9+/_=-]{24,}\\b/g,\n    entropyGated: true,\n  },\n];\n\nexport const RULES: readonly RedactionRule[] = [\n  ...CAPTURE_RULES,\n  ...STANDARD_RULES,\n  ...PARANOID_RULES,\n];\n\n/** \"capture\" -> capture only; \"standard\" -> capture+standard; \"paranoid\" -> all. */\nexport function rulesForTier(tier: RuleTier): RedactionRule[] {\n  if (tier === \"capture\") return [...CAPTURE_RULES];\n  if (tier === \"standard\") return [...CAPTURE_RULES, ...STANDARD_RULES];\n  return [...RULES];\n}\n\n/** Shannon entropy in bits per character, for paranoid-tier scan filtering. */\nexport function shannonEntropy(s: string): number {\n  if (s.length === 0) return 0;\n  const counts = new Map<string, number>();\n  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);\n  let entropy = 0;\n  for (const count of counts.values()) {\n    const p = count / s.length;\n    entropy -= p * Math.log2(p);\n  }\n  return entropy;\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/src/redact/rules.ts","numLines":181,"startLine":1,"totalLines":181},"type":"text"},"type":"user","userType":"external","uuid":"2f4a0490-0be5-4ffc-9b6c-dcbd45b18462","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.316Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Sync-time secret scan (layer E, see docs/WIP_TECHNICAL_DESIGN.md \"Privacy\n3\t * and integrity\"). Unlike capture-tier redaction (apply.ts), this scanner\n4\t * never rewrites anything — it only reports findings so a human can decide\n5\t * whether to `cledger redact` the event, `cledger allow` the fingerprint as\n6\t * a known false positive, or push anyway with `--no-scan`. Rules may\n7\t * therefore be noisier than the capture tier.\n8\t */\n9\timport { mkdir, readFile, writeFile } from \"node:fs/promises\";\n10\timport { join } from \"node:path\";\n11\timport { sha256Hex } from \"../canonical.js\";\n12\timport type { RepoInfo } from \"../git.js\";\n13\timport type { EvidenceEvent } from \"../schema.js\";\n14\timport { isExemptFromRedaction, walkStrings } from \"./apply.js\";\n15\timport { rulesForTier, shannonEntropy } from \"./rules.js\";\n16\t\n17\texport interface Finding {\n18\t  eventId: string;\n19\t  conversation?: string;\n20\t  occurred_at: string;\n21\t  rule: string;\n22\t  fingerprint: string;\n23\t  /** JSON path of the string the match sits in, e.g. `content/blocks/0/text`. */\n24\t  path: string;\n25\t  /** Match span within that string, so `cledger inspect` can find it again. */\n26\t  start: number;\n27\t  end: number;\n28\t}\n29\t\n30\tconst PLACEHOLDER_RE = /\\[REDACTED:[^\\]]+\\]/g;\n31\t\n32\t/** True if [start, end) overlaps an existing `[REDACTED:...]` placeholder span in `text`. */\n33\tfunction overlapsPlaceholder(text: string, start: number, end: number): boolean {\n34\t  for (const m of text.matchAll(PLACEHOLDER_RE)) {\n35\t    const pStart = m.index ?? 0;\n36\t    const pEnd = pStart + m[0].length;\n37\t    if (start < pEnd && end > pStart) return true;\n38\t  }\n39\t  return false;\n40\t}\n41\t\n42\t/** Stands in for the matched secret wherever a match is rendered. */\n43\tconst MATCH_MARKER = \"<redacted>\";\n44\t\n45\tconst PURE_HEX_RE = /^[0-9a-fA-F]+$/;\n46\t\n47\t/**\n48\t * Scan already-finalized events for potential secrets. Read-only: never\n49\t * mutates content, only reports. `tier` selects the ruleset — \"standard\"\n50\t * re-runs the full capture ruleset plus scan-only keyword/URL/bearer rules\n51\t * (catching events captured under an older capture ruleset); \"paranoid\"\n52\t * additionally enables the entropy-gated high-entropy-token rule.\n53\t */\n54\texport function scanEvents(events: EvidenceEvent[], tier: \"standard\" | \"paranoid\"): Finding[] {\n55\t  const rules = rulesForTier(tier);\n56\t  const findings: Finding[] = [];\n57\t\n58\t  for (const event of events) {\n59\t    const visit = (value: string, path: string): string => {\n60\t      if (isExemptFromRedaction(event.kind, path)) return value;\n61\t      for (const rule of rules) {\n62\t        for (const m of value.matchAll(rule.pattern)) {\n63\t          const matchText = m[0];\n64\t          const start = m.index ?? 0;\n65\t          const end = start + matchText.length;\n66\t          if (overlapsPlaceholder(value, start, end)) continue;\n67\t          if (rule.entropyGated) {\n68\t            // Belt-and-suspenders: rulesForTier already excludes this rule\n69\t            // below \"paranoid\", but the gate is cheap to state explicitly.\n70\t            if (tier !== \"paranoid\") continue;\n71\t            if (PURE_HEX_RE.test(matchText)) continue; // git SHAs, content digests\n72\t            if (matchText.includes(\"[REDACTED:\")) continue;\n73\t            if (shannonEntropy(matchText) < 4.0) continue;\n74\t          }\n75\t          findings.push({\n76\t            eventId: event.id,\n77\t            ...(event.conversation ? { conversation: event.conversation.id } : {}),\n78\t            occurred_at: event.occurred_at,\n79\t            rule: rule.id,\n80\t            fingerprint: sha256Hex(matchText).slice(0, 12),\n81\t            path,\n82\t            start,\n83\t            end,\n84\t          });\n85\t        }\n86\t      }\n87\t      return value;\n88\t    };\n89\t    walkStrings(event.content, \"content\", visit);\n90\t    if (event.raw) walkStrings(event.raw.data, \"raw/data\", visit);\n91\t  }\n92\t\n93\t  return findings;\n94\t}\n95\t\n96\t/**\n97\t * One line per finding: coordinates only, never a character of the flagged\n98\t * text or its surroundings.\n99\t *\n100\t * This used to print ~20 characters of context with the match masked, on the\n101\t * theory that masking the match was enough to make the report safe to\n102\t * re-capture. It was not. The *context* around a match is itself what tripped\n103\t * the rule — a `keyword-assignment` hit prints the keyword that anchored it —\n104\t * so a report landing in a later conversation re-seeds a finding on the report\n105\t * itself, and every scan compounds the previous one. Observed in the wild:\n106\t * one discussion of GitHub Actions code multiplied into repeat findings that\n107\t * `cledger allow` could not durably clear, because each new report minted a\n108\t * new event. Coordinates cannot do that: an event id and a JSON path match no\n109\t * secret rule. Content lives behind `cledger inspect`, which writes to a file.\n110\t */\n111\texport function formatFinding(f: Finding): string {\n112\t  const where = `${f.path}@${f.start}`;\n113\t  return `${f.eventId.slice(0, 16)}  ${f.conversation ?? \"-\"}  ${f.occurred_at}  ${f.rule}  ${where}  [${f.fingerprint}]`;\n114\t}\n115\t\n116\t/** Every string in an event, keyed by the same JSON paths scanEvents uses. */\n117\texport function collectStrings(event: EvidenceEvent): Map<string, string> {\n118\t  const out = new Map<string, string>();\n119\t  const visit = (value: string, path: string): string => {\n120\t    out.set(path, value);\n121\t    return value;\n122\t  };\n123\t  walkStrings(event.content, \"content\", visit);\n124\t  if (event.raw) walkStrings(event.raw.data, \"raw/data\", visit);\n125\t  return out;\n126\t}\n127\t\n128\texport interface RenderOptions {\n129\t  /** Characters of surrounding text on each side. */\n130\t  context: number;\n131\t  /** Include the matched text verbatim instead of masking it. */\n132\t  reveal: boolean;\n133\t}\n134\t\n135\t/**\n136\t * A finding with enough surrounding text for a human to actually judge it.\n137\t *\n138\t * The whole point of the separate command: `formatFinding` is deliberately\n139\t * unreadable, so this is where readability lives. Callers are expected to send\n140\t * this to a file rather than a terminal — see `cledger inspect`.\n141\t */\n142\texport function renderFinding(event: EvidenceEvent, f: Finding, opts: RenderOptions): string {\n143\t  const value = collectStrings(event).get(f.path);\n144\t  if (value === undefined) {\n145\t    return `${f.path}: string no longer present in event ${f.eventId.slice(0, 16)} (event rewritten since the scan?)\\n`;\n146\t  }\n147\t  const lo = Math.max(0, f.start - opts.context);\n148\t  const hi = Math.min(value.length, f.end + opts.context);\n149\t  const match = opts.reveal ? value.slice(f.start, f.end) : MATCH_MARKER;\n150\t  const body = `${value.slice(lo, f.start)}${match}${value.slice(f.end, hi)}`;\n151\t  return [\n152\t    `rule:        ${f.rule}`,\n153\t    `fingerprint: ${f.fingerprint}`,\n154\t    `event:       ${f.eventId}`,\n155\t    `conversation:${f.conversation ?? \" -\"}`,\n156\t    `occurred_at: ${f.occurred_at}`,\n157\t    `location:    ${f.path}, chars ${f.start}-${f.end} of ${value.length}`,\n158\t    `match:       ${f.end - f.start} chars, ${opts.reveal ? \"SHOWN BELOW\" : \"masked (pass --reveal to show)\"}`,\n159\t    \"\",\n160\t    `${lo > 0 ? `…[${lo} chars before]…\\n` : \"\"}${body}${hi < value.length ? `\\n…[${value.length - hi} chars after]…` : \"\"}`,\n161\t    \"\",\n162\t  ].join(\"\\n\");\n163\t}\n164\t\n165\t/**\n166\t * Whether we appear to be running inside a coding-agent session, i.e. whether\n167\t * anything printed here will be swept into a transcript and captured as a new\n168\t * event. Both supported harnesses export their own marker variables.\n169\t *\n170\t * Used to *refuse* to reveal flagged content rather than merely to warn: an\n171\t * agent asked to investigate a blocked sync will otherwise do the helpful,\n172\t * wrong thing and read the secret into the very record being protected.\n173\t */\n174\texport function inAgentSession(env: NodeJS.ProcessEnv = process.env): string | null {\n175\t  for (const key of Object.keys(env)) {\n176\t    if (/^(CLAUDECODE|CLAUDE_CODE|CODEX_)/.test(key)) return key;\n177\t  }\n178\t  return null;\n179\t}\n180\t\n181\t/**\n182\t * Shared guidance for every place a finding is reported. Addresses humans and\n183\t * agents separately and explicitly, because the correct action differs: a\n184\t * human should go look, an agent should stop and say so.\n185\t */\n186\texport function findingGuidance(eventIds: string[]): string {\n187\t  // Prefix, not the full 68-char id: `inspect` takes a prefix, and the short\n188\t  // form is what the finding lines above already show.\n189\t  const first = (eventIds[0] ?? \"<event-id>\").slice(0, 16);\n190\t  return [\n191\t    \"  No excerpt is printed. The text around a match is what tripped the rule,\",\n192\t    \"  so reprinting it into a session that gets captured creates a new event\",\n193\t    \"  that trips the same rule — findings then multiply on every scan.\",\n194\t    \"\",\n195\t    \"  If you are a HUMAN: inspect it in a plain terminal, outside any agent:\",\n196\t    `      cledger inspect ${first}`,\n197\t    \"  That writes the full surrounding context to a file outside the repo and\",\n198\t    \"  prints only the path. Add --reveal to include the matched text itself.\",\n199\t    \"\",\n200\t    \"  If you are an AGENT: stop here and hand this to the human. Do not run\",\n201\t    \"  cledger inspect, cledger export, or otherwise read the flagged content —\",\n202\t    \"  it would be captured into this conversation and re-seed the finding.\",\n203\t  ].join(\"\\n\");\n204\t}\n205\t\n206\t/** Findings whose fingerprint has been allowlisted (known false positive) are suppressed. */\n207\texport function filterFindings(findings: Finding[], allowlist: Set<string>): Finding[] {\n208\t  return findings.filter((f) => !allowlist.has(f.fingerprint));\n209\t}\n210\t\n211\tinterface AllowlistFile {\n212\t  fingerprints: string[];\n213\t}\n214\t\n215\tfunction allowlistPath(repo: RepoInfo): string {\n216\t  return join(repo.commonDir, \"conversation-ledger\", \"allowlist.json\");\n217\t}\n218\t\n219\t/** Local, rebuildable-if-lost state — same tier as pending.jsonl/cursors, never the record of truth. */\n220\texport async function loadAllowlist(repo: RepoInfo): Promise<Set<string>> {\n221\t  try {\n222\t    const raw = await readFile(allowlistPath(repo), \"utf8\");\n223\t    const parsed = JSON.parse(raw) as AllowlistFile;\n224\t    return new Set(Array.isArray(parsed.fingerprints) ? parsed.fingerprints : []);\n225\t  } catch {\n226\t    // Missing or malformed allowlist: treat as empty rather than failing the scan/sync.\n227\t    return new Set();\n228\t  }\n229\t}\n230\t\n231\texport async function addToAllowlist(repo: RepoInfo, fingerprints: string[]): Promise<void> {\n232\t  const existing = await loadAllowlist(repo);\n233\t  for (const fp of fingerprints) existing.add(fp);\n234\t  await mkdir(join(repo.commonDir, \"conversation-ledger\"), { recursive: true });\n235\t  await writeFile(\n236\t    allowlistPath(repo),\n237\t    JSON.stringify({ fingerprints: [...existing].sort() }, null, 2) + \"\\n\",\n238\t  );\n239\t}\n240\t","tool_use_id":"toolu_01YHruhtZwPaytYoMX7FLu9E","type":"tool_result"}],"role":"user"},"context":{"branch":"redaction-ux","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux","head":"fb4df15a7bdebc38ca45aa5ad908b0fcb411d13c","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-