matches. Output: fingerprint -> corpus entry ids only, never match text.\nimport { execFileSync } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { rulesForTier, shannonEntropy } from \"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/dist/redact/rules.js\";\n\nconst [repo, ...wanted] = process.argv.slice(2);\nconst want = new Set(wanted);\nconst fp = (s) => createHash(\"sha256\").update(s, \"utf8\").digest(\"hex\").slice(0, 12);\n\n// every committed blob version of the corpus file, any path match\nconst objects = execFileSync(\"git\", [\"rev-list\", \"--objects\", \"--all\", \"--not\", \"--glob=refs/notes/*\"], {\n  cwd: repo, maxBuffer: 1024 * 1024 * 256, encoding: \"utf8\",\n});\nconst oids = new Set();\nfor (const line of objects.split(\"\\n\")) {\n  if (line.includes(\"secret-corpus.json\")) oids.add(line.split(\" \")[0]);\n}\nconsole.log(`corpus blob versions found: ${oids.size}`);\n\nconst rules = rulesForTier(\"paranoid\");\nconst hits = new Map();\nconst scanText = (text, label) => {\n  for (const rule of rules) {\n    rule.pattern.lastIndex = 0;\n    let m;\n    while ((m = rule.pattern.exec(text)) !== null) {\n      if (rule.entropyGated && shannonEntropy(m[0]) < 4.0) continue;\n      const f = fp(m[0]);\n      if (want.has(f)) {\n        if (!hits.has(f)) hits.set(f, new Set());\n        hits.get(f).add(`${label} [rule ${rule.id}]`);\n      }\n      if (m.index === rule.pattern.lastIndex) rule.pattern.lastIndex++;\n    }\n  }\n};\n\nfor (const oid of oids) {\n  const raw = execFileSync(\"git\", [\"cat-file\", \"-p\", oid], {\n    cwd: repo, encoding: \"utf8\", maxBuffer: 1024 * 1024 * 64,\n  });\n  let corpus;\n  try { corpus = JSON.parse(raw); } catch { continue; }\n  const entries = Array.isArray(corpus) ? corpus : corpus.entries ?? corpus.positives ?? [];\n  for (const e of entries) {\n    const parts = e.secret_parts ?? e.secretParts ?? [];\n    const secret = Array.isArray(parts) ? parts.join(\"\") : \"\";\n    const ctx = e.context ?? \"\";\n    const label = `blob ${oid.slice(0, 8)} entry ${e.id ?? e.rule ?? \"?\"}`;\n    if (secret) {\n      scanText(secret, label);\n      if (ctx.includes(\"{SECRET}\")) scanText(ctx.split(\"{SECRET}\").join(secret), label);\n      else if (ctx) scanText(`${ctx}${secret}`, label);\n    }\n    if (ctx) scanText(ctx, label + \" (context alone)\");\n    // some versions may inline the secret directly\n    if (e.secret) scanText(String(e.secret), label + \" (inline)\");\n    if (ctx && e.secret) scanText(ctx.split(\"{SECRET}\").join(String(e.secret)), label + \" (inline)\");\n  }\n  // also scan the raw file text itself (pre-split era may have literals)\n  scanText(raw, `blob ${oid.slice(0, 8)} raw file`);\n}\n\nfor (const f of wanted) {\n  if (hits.has(f)) {\n    console.log(`PROVEN  ${f}:`);\n    for (const p of [...hits.get(f)].slice(0, 4)) console.log(`          ${p}`);\n  } else {\n    console.log(`UNPROVEN ${f}`);\n  }\n}\n","filePath":"/Users/evintunador/.claude/jobs/b8bc0200/tmp/prove-corpus.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"1753c3b4-5995-4936-b59b-ffcd61c6f7c8","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.315Z","schema":"conversation-ledger/v1"}
