yGated && shannonEntropy(matchText) < 4.0) continue;\n      const f = fp(matchText);\n      if (want.has(f)) {\n        if (!hits.set) throw new Error(\"unreachable\");\n        if (!hits.has(f)) hits.set(f, new Set());\n        hits.get(f).add(`${path} (blob ${oid.slice(0, 8)})`);\n      }\n      if (m.index === rule.pattern.lastIndex) rule.pattern.lastIndex++;\n    }\n  }\n}\n\nconsole.log(`scanned ${scanned} text blobs reachable from ${refs.join(\", \")} in ${repo}`);\nfor (const f of wanted) {\n  if (hits.has(f)) {\n    console.log(`PROVEN  ${f}  appears in committed content:`);\n    for (const p of [...hits.get(f)].slice(0, 5)) console.log(`          ${p}`);\n  } else {\n    console.log(`UNPROVEN ${f}  no committed blob contains this span`);\n  }\n}\n","filePath":"/Users/evintunador/.claude/jobs/b8bc0200/tmp/prove-fingerprints.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"ac1c2b31-f77f-4c87-bb4d-e7f2a68048cd","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.314Z","schema":"conversation-ledger/v1"}
