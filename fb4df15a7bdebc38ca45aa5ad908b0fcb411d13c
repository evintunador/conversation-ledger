ushed once.\n    const secret = \"hunter2xK9aa\";\n    const appendResult = await appendEvents(repo, [\n      draft({ occurred_at: \"2026-02-02T00:00:00.000Z\", content: { text: `db_password: ${secret}` } }),\n    ]);\n    const original = appendResult.appended[0]!;\n\n    const result = await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n    assert.strictEqual(result.event.id, original.id);\n    assert.ok(!JSON.stringify(result.event.content).includes(secret));\n    assert.strictEqual(result.squashed, true, \"an unshared event's history is still severed\");\n  } finally {\n    await cleanupRepo(repo);\n    await cleanupDir(remote);\n  }\n});\n\ntest(\"redactEvent: refuses when origin cannot be reached, rather than assuming nothing was shared\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"init\");\n    // A remote that exists in config but resolves to nothing: `ls-remote`\n    // fails, which must not be read as \"the remote has no ledger ref\".\n    await git([\"remote\", \"add\", \"origin\", \"/nonexistent/cledger-unreachable-remote.git\"], {\n      cwd: repo.root,\n    });\n    const secret = \"hunter2xK9aa\";\n    const appendResult = await appendEvents(repo, [draft({ content: { text: `db_password: ${secret}` } })]);\n    const original = appendResult.appended[0]!;\n\n    await assert.rejects(\n      () => redactEvent(repo, original.id.slice(4, 12), { pattern: secret }),\n      (err: unknown) => {\n        assert.ok(err instanceof RedactAfterShareError);\n        assert.strictEqual(err.reason, \"remote-unreachable\");\n        return true;\n      },\n    );\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"readEvents: a redacted copy always beats its pre-redaction original, whatever the bytes say\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    const anchor = await makeCommit(repo, \"init\");\n    // A leading uppercase letter is the adversarial case: 'A' (0x41) sorts\n    // below the '[' (0x5B) that opens a [REDACTED:...] placeholder, so the\n    // old canonical-JSON byte-compare tie-break picked the *plaintext*. Every\n    // secret starting with a digit or capital hit this.\n    const secret = \"AATOPSECRET1234\";\n    const appendResult = await appendEvents(repo, [draft({ content: { text: `key ${secret} end` } })]);\n    const original = appendResult.appended[0]!;\n    const originalLine = serializeEvent(original);\n\n    await redactEvent(repo, original.id.slice(4, 12), { pattern: secret });\n\n    // Reconstruct what cat_sort_uniq produces when a peer that still holds\n    // the pre-redaction line merges in: two lines, one id, different content.\n    const stored = await readNoteEvents(repo, anchor);\n    const lines = [...stored.map(serializeEvent), originalLine].sort();\n    await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n      cwd: repo.root,\n      input: lines.join(\"\\n\") + \"\\n\",\n    });\n\n    const bothCopies = (await readNoteEvents(repo, anchor)).filter((e) => e.id === original.id);\n    assert.strictEqual(bothCopies.length, 2, \"precondition: both copies must be in the note\");\n    assert.strictEqual(\n      bothCopies[0]!.recorded_at,\n      bothCopies[1]!.recorded_at,\n      \"precondition: the rewrite inherits the original's recorded_at, so that key ties\",\n    );\n\n    const events = await readEvents(repo, { reachableFrom: \"HEAD\" });\n    const surviving = events.filter((e) => e.id === original.id);\n    assert.strictEqual(surviving.length, 1, \"the two copies must collapse to one\");\n    assert.ok(\n      !JSON.stringify(surviving[0]).includes(secret),\n      \"the redacted copy must win — reads must never surface the pre-redaction plaintext\",\n    );\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"redactEvent: throws when no event matches the id prefix\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"init\");\n    await assert.rejects(() => redactEvent(repo, \"ev1-doesnotexist\", { all: true }), /no event matches/);\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n\ntest(\"redactEvent: requires exactly one of --pattern or --all\", async () => {\n  const repo = await makeTempRepo();\n  try {\n    await makeCommit(repo, \"init\");\n    await assert.rejects(() => redactEvent(repo, \"ev1-x\", {}), /exactly one of/);\n    await assert.rejects(\n      () => redactEvent(repo, \"ev1-x\", { pattern: \"x\", all: true }),\n      /exactly one of/,\n    );\n  } finally {\n    await cleanupRepo(repo);\n  }\n});\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/src/test/redact-command.test.ts","numLines":320,"startLine":1,"totalLines":320},"type":"text"},"type":"user","userType":"external","uuid":"d45ba5d9-6397-46fa-afa3-4cd176a10543","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.473Z","schema":"conversation-ledger/v1"}
{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport { git } from \"../git.js\";\n4\timport { shannonEntropy } from \"../redact/rules.js\";\n5\timport {\n6\t  addToAllowlist,\n7\t  filterFindings,\n8\t  findingGuidance,\n9\t  formatFinding,\n10\t  inAgentSession,\n11\t  loadAllowlist,\n12\t  renderFinding,\n13\t  scanEvents,\n14\t} from \"../redact/scan.js\";\n15\timport { appendEvents, NOTES_NAME, readEvents, sync } from \"../store.js\";\n16\timport {\n17\t  cleanupDir,\n18\t  cleanupRepo,\n19\t  draft,\n20\t  event,\n21\t  makeBareRepo,\n22\t  makeCommit,\n23\t  makeTempRepo,\n24\t} from \"./helpers.js\";\n25\t\n26\ttest(\"scanEvents: standard tier finds a keyword-anchored secret in both content and raw.data; the report carries coordinates, never content\", () => {\n27\t  const secret = \"supersecret123456\";\n28\t  const e = event({\n29\t    content: { text: `config: password=${secret} end` },\n30\t    raw: { format: \"test/1\", data: { blob: `db password=${secret}` } },\n31\t  });\n32\t\n33\t  const findings = scanEvents([e], \"standard\");\n34\t  assert.ok(findings.length >= 2, \"expected findings in both content and raw.data\");\n35\t  for (const f of findings) {\n36\t    assert.strictEqual(f.rule, \"keyword-assignment\");\n37\t    assert.strictEqual(f.eventId, e.id);\n38\t    assert.match(f.fingerprint, /^[0-9a-f]{12}$/);\n39\t    // Findings carry coordinates, not text: the report can point at the match\n40\t    // without reproducing anything that could trip a rule when re-captured.\n41\t    assert.ok(f.path.length > 0, \"finding must record where the match is\");\n42\t    assert.ok(f.end > f.start, \"finding must record the match span\");\n43\t    // The report must leak *zero* characters of the secret — not even the\n44\t    // leading/trailing ones an elided-middle form would print. Every 6-char\n45\t    // window of the secret must be absent from the rendered finding.\n46\t    const rendered = formatFinding(f);\n47\t    for (let i = 0; i + 6 <= secret.length; i++) {\n48\t      assert.ok(\n49\t        !rendered.includes(secret.slice(i, i + 6)),\n50\t        `rendered finding leaked a substring of the secret: ${secret.slice(i, i + 6)}`,\n51\t      );\n52\t    }\n53\t  }\n54\t});\n55\t\n56\ttest(\"scanEvents: keyword-assignment ignores source code that merely talks about secrets\", () => {\n57\t  // The false-positive class that dogfooding surfaced: type annotations and\n58\t  // template interpolation in cledger's own redaction source. None of these\n59\t  // carry an actual credential.\n60\t  const codeShapes = [\n61\t    \"function maskMatch(secret: string): string { return x; }\",\n62\t    \"const msg = `leaked a substring of the secret: ${secret.slice(i, i + 6)}`;\",\n63\t    \"interface Opts { password: string; api_key: string }\",\n64\t    \"log(`credentials: ${JSON.stringify(creds)}`)\",\n65\t    \"type Cfg = { access_token: string | undefined };\",\n66\t  ];\n67\t  for (const text of codeShapes) {\n68\t    const findings = scanEvents([event({ content: { text } })], \"standard\").filter(\n69\t      (f) => f.rule === \"keyword-assignment\",\n70\t    );\n71\t    assert.strictEqual(findings.length, 0, `must not flag source code: ${text}`);\n72\t  }\n73\t});\n74\t\n75\ttest(\"scanEvents: keyword-assignment still catches real credential assignments\", () => {\n76\t  const realShapes = [\n77\t    \"password=supersecret123456\",\n78\t    'db_password: \"hunter2hunter2hunter2\"',\n79\t    \"export password = 'aVeryLongPassphrase1'\",\n80\t    \"api_key:sk_test_abcdefghijklmnop\",\n81\t    \"access_token=ya29.A0ARrdaM-longtokenvalue\",\n82\t  ];\n83\t  for (const text of realShapes) {\n84\t    const findings = scanEvents([event({ content: { text } })], \"standard\").filter(\n85\t      (f) => f.rule === \"keyword-assignment\",\n86\t    );\n87\t    assert.ok(findings.length > 0, `must still flag a real assignment: ${text}`);\n88\t  }\n89\t});\n90\t\n91\ttest(\"scanEvents + filterFindings: an allowlisted fingerprint is suppressed\", () => {\n92\t  const secret = \"supersecret123456\";\n93\t  const e = event({ content: { text: `password=${secret}` } });\n94\t  const findings = scanEvents([e], \"standard\");\n95\t  assert.ok(findings.length > 0);\n96\t\n97\t  const allowlist = new Set(findings.map((f) => f.fingerprint));\n98\t  assert.strictEqual(filterFindings(findings, allowlist).length, 0);\n99\t\n100\t  // A disjoint allowlist must not suppress anything.\n101\t  assert.strictEqual(filterFindings(findings, new Set([\"deadbeefcafe\"])).length, findings.length);\n102\t});\n103\t\n104\ttest(\"scanEvents: paranoid tier finds a high-entropy token that standard tier does not\", () => {\n105\t  const token = \"aB3xQ9mK2pL7vN4wR8tY1zC6dF0sH5jG\"; // 32 chars, mixed case + digits\n106\t  assert.ok(shannonEntropy(token) >= 4.0, \"fixture token must actually clear the entropy bar\");\n107\t\n108\t  const e = event({ content: { text: `random blob: ${token} trailing text` } });\n109\t\n110\t  const standardFindings = scanEvents([e], \"standard\").filter((f) => f.rule === \"high-entropy\");\n111\t  assert.strictEqual(standardFindings.length, 0, \"high-entropy rule must not run at standard tier\");\n112\t\n113\t  const paranoidFindings = scanEvents([e], \"paranoid\").filter((f) => f.rule === \"high-entropy\");\n114\t  assert.strictEqual(paranoidFindings.length, 1);\n115\t  assert.ok(!formatFinding(paranoidFindings[0]!).includes(token));\n116\t});\n117\t\n118\ttest(\"scanEvents: paranoid tier skips pure-hex candidates (git SHAs, digests) even at high entropy\", () => {\n119\t  // Uniform over exactly the 16 hex symbols -> entropy is exactly the\n120\t  // maximum possible for a hex alphabet (log2(16) = 4.0), so this fixture\n121\t  // clears the >=4.0 bar on its own merits and isolates the pure-hex guard.\n122\t  const hexCandidate = \"0123456789abcdef0123456789abcdef\";\n123\t  assert.ok(shannonEntropy(hexCandidate) >= 4.0);\n124\t\n125\t  const e = event({ content: { text: `blob sha: ${hexCandidate} end` } });\n126\t  const findings = scanEvents([e], \"paranoid\").filter((f) => f.rule === \"high-entropy\");\n127\t  assert.strictEqual(findings.length, 0);\n128\t});\n129\t\n130\ttest(\"scanEvents: paranoid tier skips candidates that fall inside an existing [REDACTED:...] placeholder\", () => {\n131\t  const token = \"aB3xQ9mK2pL7vN4wR8tY1zC6dF0sH5jG\";\n132\t  assert.ok(shannonEntropy(token) >= 4.0);\n133\t  // Embed the high-entropy token as the rule-id segment of a placeholder so\n134\t  // it would otherwise be picked up as its own high-entropy candidate.\n135\t  const text = `already handled: [REDACTED:${token}:abc123456789]`;\n136\t  const e = event({ content: { text } });\n137\t\n138\t  const findings = scanEvents([e], \"paranoid\").filter((f) => f.rule === \"high-entropy\");\n139\t  assert.strictEqual(findings.length, 0);\n140\t});\n141\t\n142\ttest(\"scanEvents: paranoid tier never flags a reasoning event's encrypted_content, but still flags its summary field\", () => {\n143\t  const token = \"aB3xQ9mK2pL7vN4wR8tY1zC6dF0sH5jG\"; // 32 chars, clears the entropy bar\n144\t  assert.ok(shannonEntropy(token) >= 4.0);\n145\t\n146\t  const e = event({\n147\t    kind: \"reasoning\",\n148\t    content: { opaque: true },\n149\t    raw: {\n150\t      format: \"codex-rollout-jsonl/2\",\n151\t      data: {\n152\t        payload: {\n153\t          type: \"reasoning\",\n154\t          encrypted_content: `blob-${token}-blob-${token}-more`,\n155\t          summary: [{ type: \"summary_text\", text: `random blob: ${token} trailing text` }],\n156\t        },\n157\t      },\n158\t    },\n159\t  });\n160\t\n161\t  const findings = scanEvents([e], \"paranoid\").filter((f) => f.rule === \"high-entropy\");\n162\t  assert.strictEqual(\n163\t    findings.some((f) => f.path.includes(\"encrypted_content\")),\n164\t    false,\n165\t    \"encrypted_content must never surface a finding\",\n166\t  );\n167\t  assert.ok(\n168\t    findings.some((f) => f.path.includes(\"summary\")),\n169\t    \"summary must still be scanned like any other visible content\",\n170\t  );\n171\t});\n172\t\n173\ttest(\"loadAllowlist/addToAllowlist: persists fingerprints under .git/conversation-ledger/allowlist.json\", async () => {\n174\t  const repo = await makeTempRepo();\n175\t  try {\n176\t    assert.deepStrictEqual(await loadAllowlist(repo), new Set());\n177\t\n178\t    await addToAllowlist(repo, [\"fp1\", \"fp2\"]);\n179\t    assert.deepStrictEqual([...(await loadAllowlist(repo))].sort(), [\"fp1\", \"fp2\"]);\n180\t\n181\t    // Idempotent / additive: re-adding and adding a new one merges, no duplicates.\n182\t    await addToAllowlist(repo, [\"fp2\", \"fp3\"]);\n183\t    assert.deepStrictEqual([...(await loadAllowlist(repo))].sort(), [\"fp1\", \"fp2\", \"fp3\"]);\n184\t  } finally {\n185\t    await cleanupRepo(repo);\n186\t  }\n187\t});\n188\t\n189\ttest(\"sync gate: a secret blocks push, nothing reaches the remote, and the report names the fingerprint\", async () => {\n190\t  const remote = await makeBareRepo();\n191\t  const repo = await makeTempRepo();\n192\t  try {\n193\t    await makeCommit(repo, \"init\");\n194\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n195\t    await appendEvents(repo, [draft({ content: { text: \"password=supersecret123\" } })]);\n196\t\n197\t    await assert.rejects(() => sync(repo, \"origin\", \"push\"), /push blocked/);\n198\t\n199\t    // Nothing was pushed: the remote must still have no notes ref at all.\n200\t    const remoteRef = (\n201\t      await git([\"ls-remote\", remote, \"refs/notes/conversation-ledger\"], { cwd: repo.root })\n202\t    ).trim();\n203\t    assert.strictEqual(remoteRef, \"\", \"the remote must not have received the ledger ref\");\n204\t  } finally {\n205\t    await cleanupRepo(repo);\n206\t    await cleanupDir(remote);\n207\t  }\n208\t});\n209\t\n210\ttest(\"sync gate: allowlisting the fingerprint lets the same sync succeed\", async () => {\n211\t  const remote = await makeBareRepo();\n212\t  const repo = await makeTempRepo();\n213\t  try {\n214\t    await makeCommit(repo, \"init\");\n215\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n216\t    const secret = \"supersecret123\";\n217\t    await appendEvents(repo, [draft({ content: { text: `password=${secret}` } })]);\n218\t\n219\t    let blockedFindings: ReturnType<typeof scanEvents> = [];\n220\t    try {\n221\t      await sync(repo, \"origin\", \"push\");\n222\t      assert.fail(\"expected the first sync to be blocked\");\n223\t    } catch {\n224\t      blockedFindings = filterFindings(\n225\t        scanEvents(await readEvents(repo), \"standard\"),\n226\t        await loadAllowlist(repo),\n227\t      );\n228\t    }\n229\t    assert.ok(blockedFindings.length > 0);\n230\t    await addToAllowlist(repo, blockedFindings.map((f) => f.fingerprint));\n231\t\n232\t    const result = await sync(repo, \"origin\", \"push\");\n233\t    assert.strictEqual(result.pushed, true);\n234\t  } finally {\n235\t    await cleanupRepo(repo);\n236\t    await cleanupDir(remote);\n237\t  }\n238\t});\n239\t\n240\ttest(\"sync gate: skipScan bypasses the gate entirely\", async () => {\n241\t  const remote = await makeBareRepo();\n242\t  const repo = await makeTempRepo();\n243\t  try {\n244\t    await makeCommit(repo, \"init\");\n245\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n246\t    await appendEvents(repo, [draft({ content: { text: \"password=supersecret123\" } })]);\n247\t\n248\t    const result = await sync(repo, \"origin\", \"push\", { skipScan: true });\n249\t    assert.strictEqual(result.pushed, true);\n250\t  } finally {\n251\t    await cleanupRepo(repo);\n252\t    await cleanupDir(remote);\n253\t  }\n254\t});\n255\t\n256\ttest(\"sync gate: events the remote already has are not rescanned on a later sync\", async () => {\n257\t  const remote = await makeBareRepo();\n258\t  const repo = await makeTempRepo();\n259\t  try {\n260\t    await makeCommit(repo, \"init\");\n261\t    await git([\"remote\", \"add\", \"origin\", remote], { cwd: repo.root });\n262\t\n263\t    // First push: clean content, gate passes normally.\n264\t    await appendEvents(repo, [draft({ content: { text: \"hello world\" } })]);\n265\t    const first = await sync(repo, \"origin\", \"push\");\n266\t    assert.strictEqual(first.pushed, true);\n267\t\n268\t    // Mutate the already-pushed note in place to *look* like it now\n269\t    // contains a secret (simulating an old, already-shared event that\n270\t    // would trip the gate if it were rescanned) without going through the\n271\t    // normal capture/redact path.\n272\t    const anchor = (await git([\"rev-parse\", \"HEAD\"], { cwd: repo.root })).trim();\n273\t    const body = await git([\"notes\", \"--ref\", NOTES_NAME, \"show\", anchor], { cwd: repo.root });\n274\t    const tampered = body.replace(\"hello world\", \"password=supersecret123\");\n275\t    await git([\"notes\", \"--ref\", NOTES_NAME, \"add\", \"-f\", \"-F\", \"-\", anchor], {\n276\t      cwd: repo.root,\n277\t      input: tampered,\n278\t    });\n279\t\n280\t    // Add one genuinely new, clean event alongside it.\n281\t    await appendEvents(repo, [draft({ content: { text: \"clean-followup\" } })]);\n282\t\n283\t    // Sync must not rescan the (now-tampered) already-pushed event, so the\n284\t    // push proceeds even though local content technically contains a match.\n285\t    const second = await sync(repo, \"origin\", \"push\");\n286\t    assert.strictEqual(second.pushed, true);\n287\t  } finally {\n288\t    await cleanupRepo(repo);\n289\t    await cleanupDir(remote);\n290\t  }\n291\t});\n292\t\n293\t/**\n294\t * The reporting/inspection split. Reports are contentless so they cannot\n295\t * re-seed themselves when captured; everything readable lives behind\n296\t * `renderFinding`, whose output is expected to reach a file, not a terminal.\n297\t */\n298\t\n299\ttest(\"formatFinding leaks no content — not the match, not its surroundings\", () => {\n300\t  // The surrounding words are the real hazard: `password=` is what the\n301\t  // keyword rule anchors on, so echoing context re-trips the same rule.\n302\t  const secret = \"supersecret123456\";\n303\t  const e = event({ content: { text: `deploy notes: password=${secret} rotate quarterly` } });\n304\t  const [f] = scanEvents([e], \"standard\");\n305\t  assert.ok(f);\n306\t\n307\t  const rendered = formatFinding(f!);\n308\t  assert.ok(!rendered.includes(secret), \"must not contain the secret\");\n309\t  assert.ok(!rendered.includes(\"password=\"), \"must not contain the anchoring keyword\");\n310\t  assert.ok(!rendered.includes(\"rotate quarterly\"), \"must not contain trailing context\");\n311\t  // what it *should* contain: coordinates a human can act on\n312\t  assert.ok(rendered.includes(f!.fingerprint), \"fingerprint is needed for `cledger allow`\");\n313\t  assert.ok(rendered.includes(f!.path), \"path tells the human where to look\");\n314\t});\n315\t\n316\ttest(\"renderFinding gives wide context, masking the match unless revealed\", () => {\n317\t  const secret = \"supersecret123456\";\n318\t  const before = \"A\".repeat(300);\n319\t  const after = \"B\".repeat(300);\n320\t  const e = event({ content: { text: `${before} password=${secret} ${after}` } });\n321\t  const [f] = scanEvents([e], \"standard\");\n322\t  assert.ok(f);\n323\t\n324\t  const masked = renderFinding(e, f!, { context: 200, reveal: false });\n325\t  assert.ok(!masked.includes(secret), \"masked render must not contain the secret\");\n326\t  assert.ok(masked.includes(\"<redacted>\"), \"masked render marks where the match was\");\n327\t  // the point of the command: enough surroundings to actually judge it\n328\t  assert.ok(masked.includes(\"A\".repeat(150)), \"must include wide leading context\");\n329\t  assert.ok(masked.includes(\"B\".repeat(150)), \"must include wide trailing context\");\n330\t  assert.ok(masked.includes(f!.path), \"must say where in the event this is\");\n331\t\n332\t  const revealed = renderFinding(e, f!, { context: 200, reveal: true });\n333\t  assert.ok(revealed.includes(secret), \"--reveal must show the matched text\");\n334\t});\n335\t\n336\ttest(\"renderFinding context width is honoured on both sides\", () => {\n337\t  const e = event({ content: { text: `${\"x\".repeat(500)} password=hunter2000000 ${\"y\".repeat(500)}` } });\n338\t  const [f] = scanEvents([e], \"standard\");\n339\t  const narrow = renderFinding(e, f!, { context: 10, reveal: false });\n340\t  const wide = renderFinding(e, f!, { context: 400, reveal: false });\n341\t  assert.ok(wide.length > narrow.length, \"wider context must render more text\");\n342\t  assert.ok(narrow.includes(\"chars before\"), \"truncation must be disclosed, not silent\");\n343\t});\n344\t\n345\ttest(\"renderFinding survives an event rewritten since the scan\", () => {\n346\t  const e = event({ content: { text: \"password=supersecret123456\" } });\n347\t  const [f] = scanEvents([e], \"standard\");\n348\t  const moved = { ...f!, path: \"content/gone\" };\n349\t  const out = renderFinding(e, moved, { context: 100, reveal: false });\n350\t  assert.match(out, /no longer present/);\n351\t});\n352\t\n353\ttest(\"inAgentSession detects the harness markers it guards against\", () => {\n354\t  assert.equal(inAgentSession({}), null);\n355\t  assert.equal(inAgentSession({ PATH: \"/usr/bin\" }), null);\n356\t  assert.equal(inAgentSession({ CLAUDECODE: \"1\" }), \"CLAUDECODE\");\n357\t  assert.equal(inAgentSession({ CODEX_SANDBOX: \"1\" }), \"CODEX_SANDBOX\");\n358\t});\n359\t\n360\ttest(\"findingGuidance addresses humans and agents separately\", () => {\n361\t  const g = findingGuidance([\"ev1-abc123\"]);\n362\t  assert.match(g, /HUMAN/);\n363\t  assert.match(g, /AGENT/);\n364\t  assert.match(g, /cledger inspect ev1-abc123/, \"must name the actual event 