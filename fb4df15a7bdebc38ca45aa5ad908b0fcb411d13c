{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t# Product intent\n2\t\n3\t## Purpose\n4\t\n5\tConversation Ledger preserves durable, inspectable records of visible\n6\tconversations between people and coding agents. It is a general conversation\n7\tprovenance primitive, not an intent-analysis product. Downstream consumers may\n8\tuse its records as evidence about why a repository changed, but the ledger must\n9\tnot impose that interpretation.\n10\t\n11\tThe record must remain useful to consumers beyond a single tool: cross-CLI\n12\tcontinuity, archival/export, code attribution, review, and later intent\n13\tretrieval are all valid independent uses.\n14\t\n15\t## Behavioral commitments\n16\t\n17\t- Preserve source material and provenance; do not silently rewrite history.\n18\t- Preserve exact visible turns before creating optional derived views.\n19\t- Retain enough provenance for consumers to determine applicability without\n20\t  treating any record as timeless truth.\n21\t- Record the repository, branch, commit, worktree state, author, timestamps,\n22\t  and capture mechanism with each artifact whenever available.\n23\t- Keep storage out of ordinary working-tree status views while retaining normal\n24\t  Git durability and shareability.\n25\t- Make sharing, retention, redaction, and deletion deliberate user choices.\n26\t\n27\t## Non-goals for the foundation\n28\t\n29\t- Deciding which historical statement is correct or intended.\n30\t- Summarizing, ranking, embedding, or otherwise interpreting conversations.\n31\t- Controlling an agent, enforcing a workflow, or orchestrating agents.\n32\t- Decrypting, interpreting, or reproducing reasoning the provider hides.\n33\t  Visible reasoning is recorded when exposed; reasoning withheld behind\n34\t  provider ciphertext (0.10.0+) is preserved losslessly as opaque raw state\n35\t  for a capable downstream consumer to decrypt later, but the ledger itself\n36\t  never attempts to read or reconstruct it, and stores nothing that would let\n37\t  it reproduce a native agent session on its own. As of 0.19.0 that covers\n38\t  ciphertext embedded inside another payload too — an inter-agent message's\n39\t  `encrypted_content` blocks ride alongside the visible turn as a sealed\n40\t  sibling — so \"preserved, never read\" is now the rule everywhere rather than\n41\t  the rule for standalone reasoning items only.\n42\t\n43\tThose belong to clients such as Turnbridge and Intent Recall, not to this core\n44\tstorage layer.\n45\t","tool_use_id":"toolu_018JnK8MnsAY96f5EUidkrE9","type":"tool_result"}],"role":"user"},"context":{"branch":"redaction-ux","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux","head":"fb4df15a7bdebc38ca45aa5ad908b0fcb411d13c","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:b8bc0200-5312-42a4-9c54-a116d8d4a925#agent:ac12a741cf47e6cde","parent":"claude-code:b8bc0200-5312-42a4-9c54-a116d8d4a925","seq":39},"id":"ev1-a3fd9683fe0726f16db7a1e9188a2a2a2f5fc2ca1bf5b71f2bc1b0e92bd54a55","kind":"conversation_turn","occurred_at":"2026-08-12T02:14:22.638Z","producer":{"session_id":"b8bc0200-5312-42a4-9c54-a116d8d4a925","source":"claude-code","source_version":"2.1.228","tool":"cledger","version":"0.20.0"},"raw":{"data":{"agentId":"ac12a741cf47e6cde","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux","entrypoint":"cli","gitBranch":"redaction-ux","isSidechain":true,"message":{"content":[{"content":"1\t# Product intent\n2\t\n3\t## Purpose\n4\t\n5\tConversation Ledger preserves durable, inspectable records of visible\n6\tconversations between people and coding agents. It is a general conversation\n7\tprovenance primitive, not an intent-analysis product. Downstream consumers may\n8\tuse its records as evidence about why a repository changed, but the ledger must\n9\tnot impose that interpretation.\n10\t\n11\tThe record must remain useful to consumers beyond a single tool: cross-CLI\n12\tcontinuity, archival/export, code attribution, review, and later intent\n13\tretrieval are all valid independent uses.\n14\t\n15\t## Behavioral commitments\n16\t\n17\t- Preserve source material and provenance; do not silently rewrite history.\n18\t- Preserve exact visible turns before creating optional derived views.\n19\t- Retain enough provenance for consumers to determine applicability without\n20\t  treating any record as timeless truth.\n21\t- Record the repository, branch, commit, worktree state, author, timestamps,\n22\t  and capture mechanism with each artifact whenever available.\n23\t- Keep storage out of ordinary working-tree status views while retaining normal\n24\t  Git durability and shareability.\n25\t- Make sharing, retention, redaction, and deletion deliberate user choices.\n26\t\n27\t## Non-goals for the foundation\n28\t\n29\t- Deciding which historical statement is correct or intended.\n30\t- Summarizing, ranking, embedding, or otherwise interpreting conversations.\n31\t- Controlling an agent, enforcing a workflow, or orchestrating agents.\n32\t- Decrypting, interpreting, or reproducing reasoning the provider hides.\n33\t  Visible reasoning is recorded when exposed; reasoning withheld behind\n34\t  provider ciphertext (0.10.0+) is preserved losslessly as opaque raw state\n35\t  for a capable downstream consumer to decrypt later, but the ledger itself\n36\t  never attempts to read or reconstruct it, and stores nothing that would let\n37\t  it reproduce a native agent session on its own. As of 0.19.0 that covers\n38\t  ciphertext embedded inside another payload too — an inter-agent message's\n39\t  `encrypted_content` blocks ride alongside the visible turn as a sealed\n40\t  sibling — so \"preserved, never read\" is now the rule everywhere rather than\n41\t  the rule for standalone reasoning items only.\n42\t\n43\tThose belong to clients such as Turnbridge and Intent Recall, not to this core\n44\tstorage layer.\n45\t","tool_use_id":"toolu_018JnK8MnsAY96f5EUidkrE9","type":"tool_result"}],"role":"user"},"parentUuid":"524293d1-31be-4fb4-8738-d1d28bbe255c","promptId":"b6bcbf20-f377-4512-9762-3e53a49290ec","sessionId":"b8bc0200-5312-42a4-9c54-a116d8d4a925","sessionKind":"bg","sourceToolAssistantUUID":"524293d1-31be-4fb4-8738-d1d28bbe255c","timestamp":"2026-08-12T02:14:22.638Z","toolUseResult":{"file":{"content":"# Product intent\n\n## Purpose\n\nConversation Ledger preserves durable, inspectable records of visible\nconversations between people and coding agents. It is a general conversation\nprovenance primitive, not an intent-analysis product. Downstream consumers may\nuse its records as evidence about why a repository changed, but the ledger must\nnot impose that interpretation.\n\nThe record must remain useful to consumers beyond a single tool: cross-CLI\ncontinuity, archival/export, code attribution, review, and later intent\nretrieval are all valid independent uses.\n\n## Behavioral commitments\n\n- Preserve source material and provenance; do not silently rewrite history.\n- Preserve exact visible turns before creating optional derived views.\n- Retain enough provenance for consumers to determine applicability without\n  treating any record as timeless truth.\n- Record the repository, branch, commit, worktree state, author, timestamps,\n  and capture mechanism with each artifact whenever available.\n- Keep storage out of ordinary working-tree status views while retaining normal\n  Git durability and shareability.\n- Make sharing, retention, redaction, and deletion deliberate user choices.\n\n## Non-goals for the foundation\n\n- Deciding which historical statement is correct or intended.\n- Summarizing, ranking, embedding, or otherwise interpreting conversations.\n- Controlling an agent, enforcing a workflow, or orchestrating agents.\n- Decrypting, interpreting, or reproducing reasoning the provider hides.\n  Visible reasoning is recorded when exposed; reasoning withheld behind\n  provider ciphertext (0.10.0+) is preserved losslessly as opaque raw state\n  for a capable downstream consumer to decrypt later, but the ledger itself\n  never attempts to read or reconstruct it, and stores nothing that would let\n  it reproduce a native agent session on its own. As of 0.19.0 that covers\n  ciphertext embedded inside another payload too — an inter-agent message's\n  `encrypted_content` blocks ride alongside the visible turn as a sealed\n  sibling — so \"preserved, never read\" is now the rule everywhere rather than\n  the rule for standalone reasoning items only.\n\nThose belong to clients such as Turnbridge and Intent Recall, not to this core\nstorage layer.\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/docs/PRODUCT_INTENT.md","numLines":45,"startLine":1,"totalLines":45},"type":"text"},"type":"user","userType":"external","uuid":"5fb6b476-a91f-4f4a-9829-cd3b60030564","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.471Z","schema":"conversation-ledger/v1"}
{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t#!/usr/bin/env node\n2\timport { readFileSync } from \"node:fs\";\n3\timport { stdin as input } from \"node:process\";\n4\timport { findRepo, type RepoInfo } from \"./git.js\";\n5\timport {\n6\t  appendEvents,\n7\t  manualReAnchor,\n8\t  NOTES_REF,\n9\t  readEvents,\n10\t  redactEvent,\n11\t  RedactAfterShareError,\n12\t  runReAnchor,\n13\t  ScanBlockedError,\n14\t  sortEvents,\n15\t  sync,\n16\t  parsePrePushRefs,\n17\t  transportPush,\n18\t  type ReadOptions,\n19\t} from \"./store.js\";\n20\timport {\n21\t  parseEventLine,\n22\t  SESSION_MACHINERY_KINDS,\n23\t  type EventDraft,\n24\t  type EvidenceEvent,\n25\t} from \"./schema.js\";\n26\timport { runClaudeCodeHook, captureClaudeTranscript } from \"./adapters/claude-code.js\";\n27\timport { runCodexHook, captureCodexTranscript } from \"./adapters/codex.js\";\n28\timport {\n29\t  runOpencodeHook,\n30\t  captureOpencodeAll,\n31\t  captureOpencodeExportFile,\n32\t  captureOpencodeSession,\n33\t} from \"./adapters/opencode.js\";\n34\timport {\n35\t  runGeminiHook,\n36\t  captureGeminiAll,\n37\t  captureGeminiTranscript,\n38\t} from \"./adapters/gemini-cli.js\";\n39\timport { runQwenHook, captureQwenAll, captureQwenTranscript } from \"./adapters/qwen-code.js\";\n40\timport { renormalize } from \"./renormalize.js\";\n41\timport { installAdapters } from \"./install.js\";\n42\timport { forgeForRepo } from \"./forge/forge.js\";\n43\timport { suggestMappings } from \"./reanchor-suggest.js\";\n44\timport { loadConfig } from \"./redact/config.js\";\n45\timport {\n46\t  addToAllowlist,\n47\t  filterFindings,\n48\t  findingGuidance,\n49\t  formatFinding,\n50\t  inAgentSession,\n51\t  loadAllowlist,\n52\t  renderFinding,\n53\t  scanEvents,\n54\t} from \"./redact/scan.js\";\n55\t\n56\tconst USAGE = `conversation-ledger — durable records of coding-agent conversations, in git notes\n57\t\n58\tUsage:\n59\t  cledger append [--quiet]                 append JSONL events/drafts from stdin\n60\t  cledger log [--all|--rev R] [--kind K] [--source S] [--model M] [--conversation C] [--json]\n61\t              [--with-reasoning] [--with-state]\n62\t                                           --model matches producer.model exactly, e.g. gpt-5.6-sol\n63\t  cledger show <conversation-id-prefix> [--json] [--with-reasoning] [--with-state]\n64\t                                           opaque provider-encrypted \\`reasoning\\` events are hidden\n65\t                                           by default on log/show; --with-reasoning reveals them.\n66\t                                           So are the session-machinery kinds (session_state,\n67\t                                           activity, context_injection, file_snapshot), which a\n68\t                                           session emits far more often than turns; --with-state\n69\t                                           reveals those. Both are always captured and exported —\n70\t                                           these flags only affect what is displayed\n71\t  cledger conversations [--rev R] [--with-reasoning] [--with-state]\n72\t                                           list conversations on current branch (--all for every branch),\n73\t                                           one line each: id, source, model(s), count, time span\n74\t  cledger export [--rev R]                lossless JSONL dump (default: everything, incl. reasoning)\n75\t  cledger sync [--remote R] [--push|--fetch] [--no-scan] [--paranoid] [--all|--rev R]\n76\t                                           fetch/merge/push of the ledger ref;\n77\t                                           push is gated by a secret scan unless --no-scan.\n78\t                                           Push carries only conversations reachable from the\n79\t                                           current branch; --all pushes the whole ledger,\n80\t                                           --rev scopes to another branch/commit\n81\t  cledger transport-push [remote]         pre-push hook entrypoint (installed automatically):\n82\t                                           pushes the ledger ref alongside git push, scoped to the\n83\t                                           refs being pushed (read from git's pre-push stdin;\n84\t                                           falls back to HEAD); scan findings hold back only the\n85\t                                           ledger unless transport.strict\n86\t  cledger scan [--all|--rev R] [--paranoid]   scan local events for potential secrets (CI-friendly:\n87\t                                           exits 1 if any finding, 0 otherwise); default scope is\n88\t                                           every local event, --rev restricts by reachability\n89\t  cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\n90\t                                           show a finding with real surrounding context (default 400\n91\t                                           chars each side). Writes to a file outside the repo and\n92\t                                           refuses to run inside a coding-agent session — reports\n93\t                                           never print content, because reprinting it re-seeds the\n94\t                                           finding. HUMANS ONLY, in a plain terminal.\n95\t  cledger allow <fingerprint...>          mark scan finding fingerprint(s) as known false positives\n96\t  cledger redact <event-id-prefix> (--pattern REGEX | --all) [--reason TEXT]\n97\t                                           rewrite a not-yet-pushed event to remove a secret, keeping\n98\t                                           its id stable, and sever the local notes history chain.\n99\t                                           PRE-PUSH ONLY: refuses once the event is on origin, where\n100\t                                           rewriting cannot remove it (rotate the credential instead)\n101\t  cledger re-anchor [--apply] [--target R] [--no-forge]\n102\t                                           detect branches squash-merged/rewritten onto the remote\n103\t                                           default branch and map their conversations to the\n104\t                                           surviving commits (dry-run by default; exact matches\n105\t                                           also auto-apply on read unless reanchor.auto is false).\n106\t                                           Inexact cases get evidence-ranked suggestions — forge PR\n107\t                                           metadata via your own gh session, commit-message\n108\t                                           corroboration, per-file content match — never auto-applied\n109\t  cledger re-anchor <old-rev...> --onto REV   assert one mapping manually (edited squashes,\n110\t                                           deleted branches, ambiguous matches)\n111\t  cledger renormalize                      re-interpret preserved unrecognized transcript lines this\n112\t                                           cledger version can now parse into their proper kind\n113\t                                           (conversation_turn, session_state, activity, ...),\n114\t                                           superseding the raw-only placeholders (append-only, idempotent)\n115\t  cledger install <claude-code|codex|opencode|gemini-cli|qwen-code|all>\n116\t                                           hook capture into coding CLIs (global)\n117\t  cledger hook <claude-code|codex|opencode|gemini-cli|qwen-code>\n118\t                                           capture entrypoint invoked by CLI hooks (stdin: hook payload)\n119\t  cledger capture <claude-code|codex> --transcript PATH   manual/backfill ingestion\n120\t  cledger capture <gemini-cli|qwen-code> [--transcript PATH | --all]\n121\t                                           both keep per-project session logs; --all backfills every\n122\t                                           session the CLI scopes to this directory, including ones\n123\t                                           cledger has never seen (the hook's own catch-up sweep is\n124\t                                           deliberately narrower — it only finishes sessions cledger\n125\t                                           already tracks)\n126\t  cledger capture opencode [--session ID | --all | --transcript EXPORT.json]\n127\t                                           opencode keeps sessions in SQLite, not a transcript file,\n128\t                                           so capture shells out to \\`opencode export\\`; --all sweeps\n129\t                                           every session opencode scopes to this project\n130\t  cledger --version | --help\n131\t\n132\tEvents are anchored to the HEAD commit at capture time and stored under\n133\trefs/notes/conversation-ledger, so they follow branches through merges and\n134\tsync only when you say so.`;\n135\t\n136\tfunction version(): string {\n137\t  const pkg = JSON.parse(\n138\t    readFileSync(new URL(\"../package.json\", import.meta.url), \"utf8\"),\n139\t  ) as { version: string };\n140\t  return pkg.version;\n141\t}\n142\t\n143\tinterface Flags {\n144\t  [key: string]: string | boolean;\n145\t}\n146\t\n147\tfunction parseArgs(argv: string[]): { positional: string[]; flags: Flags } {\n148\t  const positional: string[] = [];\n149\t  const flags: Flags = {};\n150\t  for (let i = 0; i < argv.length; i++) {\n151\t    const arg = argv[i]!;\n152\t    if (arg.startsWith(\"--\")) {\n153\t      const name = arg.slice(2);\n154\t      const next = argv[i + 1];\n155\t      if (next !== undefined && !next.startsWith(\"--\")) {\n156\t        flags[name] = next;\n157\t        i++;\n158\t      } else {\n159\t        flags[name] = true;\n160\t      }\n161\t    } else {\n162\t      positional.push(arg);\n163\t    }\n164\t  }\n165\t  return { positional, flags };\n166\t}\n167\t\n168\tasync function requireRepo(): Promise<RepoInfo> {\n169\t  const repo = await findRepo(process.cwd());\n170\t  if (!repo) {\n171\t    process.stderr.write(\"cledger: not inside a git repository\\n\");\n172\t    process.exit(2);\n173\t  }\n174\t  return repo;\n175\t}\n176\t\n177\tasync function readStdin(): Promise<string> {\n178\t  const chunks: Buffer[] = [];\n179\t  for await (const chunk of input) chunks.push(chunk as Buffer);\n180\t  return Buffer.concat(chunks).toString(\"utf8\");\n181\t}\n182\t\n183\tfunction readOptionsFrom(flags: Flags): ReadOptions {\n184\t  const opts: ReadOptions = {};\n185\t  if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n186\t  if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n187\t  if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n188\t  if (typeof flags[\"model\"] === \"string\") opts.model = flags[\"model\"];\n189\t  if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n190\t  return opts;\n191\t}\n192\t\n193\t/**\n194\t * The one-line preview `log` shows per event. Record kinds lead with the\n195\t * source's own type name (`mode`, `event_msg/token_count`) because that is\n196\t * what distinguishes one from the next — falling straight through to\n197\t * `JSON.stringify` would show every `session_state` line as the same wall of\n198\t * envelope fields.\n199\t */\n200\tfunction snippet(event: EvidenceEvent): string {\n201\t  const c = event.content as Record<string, unknown> | string | null;\n202\t  let text = \"\";\n203\t  if (typeof c === \"string\") text = c;\n204\t  else if (c && typeof c === \"object\") {\n205\t    const label = c[\"state_type\"] ?? c[\"activity_type\"] ?? c[\"injection_type\"] ?? c[\"operation\"];\n206\t    const body = c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"];\n207\t    if (typeof label === \"string\") {\n208\t      text = `${label}  ${typeof body === \"string\" ? body : JSON.stringify(c)}`;\n209\t    } else {\n210\t      text = String(body ?? JSON.stringify(c));\n211\t    }\n212\t  }\n213\t  text = text.replace(/\\s+/g, \" \").trim();\n214\t  return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n215\t}\n216\t\n217\tfunction printHuman(events: EvidenceEvent[]): void {\n218\t  for (const e of events) {\n219\t    const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n220\t    const role =\n221\t      (e.content as Record<string, unknown> | null | undefined) &&\n222\t      typeof e.content === \"object\"\n223\t        ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n224\t        : e.actor.type;\n225\t    process.stdout.write(\n226\t      `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n227\t    );\n228\t  }\n229\t}\n230\t\n231\t/**\n232\t * What `log`/`show`/`conversations` leave out unless asked.\n233\t *\n234\t * Two groups are hidden by default, for two different reasons. `reasoning`\n235\t * events are opaque ciphertext, never meant for a human-facing transcript.\n236\t * The session-machinery kinds (see SESSION_MACHINERY_KINDS) are meaningful,\n237\t * but a session declares its mode, its tracked files and its token counts far\n238\t * more often than anyone speaks — showing them by default would bury the\n239\t * conversation in its own bookkeeping.\n240\t *\n241\t * `--with-reasoning` / `--with-state` opt in, as does asking for the kind\n242\t * explicitly via `--kind` (hiding it there would just return nothing).\n243\t * `export`'s job is a lossless dump, so it never filters and needs no\n244\t * equivalent flag; neither does capture, which records all of it regardless.\n245\t */\n246\tfunction displayFilter(flags: Flags, opts: ReadOptions): (event: EvidenceEvent) => boolean {\n247\t  const reasoning = flags[\"with-reasoning\"] === true || opts.kind === \"reasoning\";\n248\t  const state =\n249\t    flags[\"with-state\"] === true || (opts.kind !== undefined && SESSION_MACHINERY_KINDS.has(opts.kind));\n250\t  return (event) => {\n251\t    if (!reasoning && event.kind === \"reasoning\") return false;\n252\t    if (!state && SESSION_MACHINERY_KINDS.has(event.kind)) return false;\n253\t    return true;\n254\t  };\n255\t}\n256\t\n257\tfunction printJsonl(events: EvidenceEvent[], includeRaw: boolean): void {\n258\t  for (const e of events) {\n259\t    const out = includeRaw ? e : { ...e, raw: undefined };\n260\t    process.stdout.write(JSON.stringify(out) + \"\\n\");\n261\t  }\n262\t}\n263\t\n264\tasync function cmdAppend(flags: Flags): Promise<void> {\n265\t  const repo = await requireRepo();\n266\t  const body = await readStdin();\n267\t  const drafts: EventDraft[] = body\n268\t    .split(\"\\n\")\n269\t    .filter((l) => l.trim())\n270\t    .map((l) => JSON.parse(l) as EventDraft);\n271\t  if (drafts.length === 0) return;\n272\t  const result = await appendEvents(repo, drafts);\n273\t  if (!flags[\"quiet\"]) {\n274\t    for (const e of result.appended) process.stdout.write(e.id + \"\\n\");\n275\t    process.stderr.write(\n276\t      `appended ${result.appended.length}, deduped ${result.deduped}` +\n277\t        (result.anchor ? ` (anchor ${result.anchor.slice(0, 12)})` : \" (pending: no commits yet)\") +\n278\t        \"\\n\",\n279\t    );\n280\t  }\n281\t}\n282\t\n283\tasync function cmdLog(flags: Flags): Promise<void> {\n284\t  const repo = await requireRepo();\n285\t  const opts = readOptionsFrom(flags);\n286\t  let events = await readEvents(repo, opts);\n287\t  events = events.filter(displayFilter(flags, opts));\n288\t  if (flags[\"json\"]) printJsonl(events, false);\n289\t  else printHuman(events);\n290\t}\n291\t\n292\tasync function cmdShow(positional: string[], flags: Flags): Promise<void> {\n293\t  const prefix = positional[0];\n294\t  if (!prefix) {\n295\t    process.stderr.write(\"usage: cledger show <conversation-id-prefix>\\n\");\n296\t    process.exit(2);\n297\t  }\n298\t  const repo = await requireRepo();\n299\t  let events = await readEvents(repo, { conversation: prefix });\n300\t  events = events.filter(displayFilter(flags, {}));\n301\t  if (events.length === 0) {\n302\t    process.stderr.write(`no events for conversation ${prefix}\\n`);\n303\t    process.exit(1);\n304\t  }\n305\t  if (flags[\"json\"]) {\n306\t    printJsonl(events, true);\n307\t    return;\n308\t  }\n309\t  for (const e of sortEvents(events)) {\n310\t    const c = e.content as Record<string, unknown>;\n311\t    const role = typeof c === \"object\" && c ? String(c[\"role\"] ?? e.actor.type) : e.actor.type;\n312\t    const text =\n313\t      typeof c === \"object\" && c && typeof c[\"text\"] === \"string\"\n314\t        ? (c[\"text\"] as string)\n315\t        : JSON.stringify(e.content, null, 2);\n316\t    process.stdout.write(`\\n[${e.occurred_at}] ${role} (${e.kind}, ${e.id.slice(0, 16)})\\n`);\n317\t    process.stdout.write(text.trimEnd() + \"\\n\");\n318\t  }\n319\t}\n320\t\n321\tasync function cmdConversations(flags: Flags): Promise<void> {\n322\t  const repo = await requireRepo();\n323\t  const opts = readOptionsFrom(flags);\n324\t  let events = await readEvents(repo, opts);\n325\t  events = events.filter(displayFilter(flags, opts));\n326\t  const byConv = new Map<\n327\t    string,\n328\t    { count: number; first: string; last: string; source: string; models: Set<string> }\n329\t  >();\n330\t  for (const e of events) {\n331\t    const id = e.conversation?.id ?? \"(none)\";\n332\t    const entry = byConv.get(id) ?? {\n333\t      count: 0,\n334\t      first: e.occurred_at,\n335\t      last: e.occurred_at,\n336\t      source: e.producer.source ?? e.producer.tool,\n337\t      models: new Set<string>(),\n338\t    };\n339\t    entry.count++;\n340\t    // A conversation can legitimately list several models — codex restates\n341\t    // `turn_context` when the user switches mid-session, and a claude-code\n342\t    // session mixes real model ids with `<synthetic>` harness messages.\n343\t    if (e.producer.model) entry.models.add(e.producer.model);\n344\t    if (e.occurred_at < entry.first) entry.first = e.occurred_at;\n345\t    if (e.occurred_at > entry.last) entry.last = e.occurred_at;\n346\t    byConv.set(id, entry);\n347\t  }\n348\t  for (const [id, s] of [...byConv.entries()].sort((a, b) => a[1].last.localeCompare(b[1].last))) {\n349\t    const models = s.models.size > 0 ? [...s.models].sort().join(\",\") : \"-\";\n350\t    process.stdout.write(\n351\t      `${id}  ${s.source}  ${models}  ${s.count} events  ${s.first} .. ${s.last}\\n`,\n352\t    );\n353\t  }\n354\t}\n355\t\n356\tasync function cmdExport(flags: Flags): Promise<void> {\n357\t  const repo = await requireRepo();\n358\t  const opts: ReadOptions = {};\n359\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n360\t  const events = await readEvents(repo, opts);\n361\t  printJsonl(events, true);\n362\t}\n363\t\n364\tasync function cmdSync(flags: Flags): Promise<void> {\n365\t  const repo = await requireRepo();\n366\t  const remote = typeof flags[\"remote\"] === \"string\" ? flags[\"remote\"] : \"origin\";\n367\t  const mode = flags[\"push\"] ? \"push\" : flags[\"fetch\"] ? \"fetch\" : \"both\";\n368\t  // Push is scoped to the current branch by default; --all restores the\n369\t  // pre-0.14.0 whole-ledger push, --rev scopes to something else.\n370\t  const scope: string | null = flags[\"all\"] === true\n371\t    ? null\n372\t    : typeof flags[\"rev\"] === \"string\"\n373\t      ? flags[\"rev\"]\n374\t      : \"HEAD\";\n375\t  const result = await sync(repo, remote, mode, {\n376\t    skipScan: flags[\"no-scan\"] === true,\n377\t    paranoid: flags[\"paranoid\"] === true,\n378\t    scope,\n379\t  });\n380\t  const pushed = !result.pushed\n381\t    ? \"not pushed\"\n382\t    : result.scopedAnchors === null\n383\t      ? \"pushed (whole ledger)\"\n384\t      : `pushed (${result.scopedAnchors} commit(s) in scope)`;\n385\t  process.stderr.write(\n386\t    `sync ${remote}: ${result.fetched ? \"fetched+merged\" : \"nothing fetched\"}, ${pushed}\\n`,\n387\t  );\n388\t}\n389\t\n390\tasync function cmdTransportPush(positional: string[]): Promise<void> {\n391\t  const repo = await findRepo(process.cwd());\n392\t  if (!repo) return; // a hook must never fail the user's push\n393\t  const remote = positional[0] || \"origin\";\n394\t  // git's pre-push hook pipes the refs being pushed. Only read when stdin is\n395\t  // actually a pipe: a manual `cledger transport-push` from a terminal would\n396\t  // otherwise block forever waiting on a human who has nothing to type.\n397\t  let revs: string[] = [];\n398\t  if (process.stdin.isTTY !== true) {\n399\t    try {\n400\t      revs = parsePrePushRefs(await readStdin());\n401\t    } catch {\n402\t      revs = []; // unreadable stdin must never fail the user's push\n403\t    }\n404\t  }\n405\t  try {\n406\t    await transportPush(repo, remote, revs);\n407\t  } catch (err) {\n408\t    if (err instanceof ScanBlockedError) {\n409\t      // transport.strict: nonzero exit makes git abort the entire push.\n410\t      process.stderr.write(\"cledger: entire push blocked (transport.strict is enabled)\\n\");\n411\t      process.exit(1);\n412\t    }\n413\t    // Anything else is a cledger bug or environment problem; the user's\n414\t    // code push must proceed regardless.\n415\t    process.stderr.write(\n416\t      `cledger: transport-push error (push continues): ${err instanceof Error ? err.message : String(err)}\\n`,\n417\t    );\n418\t  }\n419\t}\n420\t\n421\tasync function cmdScan(flags: Flags): Promise<void> {\n422\t  const repo = await requireRepo();\n423\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n424\t  const opts: ReadOptions = {};\n425\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n426\t  const events = await readEvents(repo, opts);\n427\t  const findings = filterFindings(scanEvents(events, tier), await loadAllowlist(repo));\n428\t  if (findings.length === 0) {\n429\t    process.stderr.write(\"cledger scan: no findings\\n\");\n430\t    return;\n431\t  }\n432\t  for (const f of findings) process.stdout.write(formatFinding(f) + \"\\n\");\n433\t  const eventIds = [...new Set(findings.map((f) => f.eventId))];\n434\t  process.stderr.write(`\\n${findingGuidance(eventIds)}\\n`);\n435\t  process.stderr.write(\n436\t    `\\ncledger scan: ${findings.length} finding(s) across ${eventIds.length} event(s)\\n`,\n437\t  );\n438\t  process.exit(1);\n439\t}\n440\t\n441\t/**\n442\t * Show a finding with enough surrounding text to actually judge it — the\n443\t * counterpart to `formatFinding`'s deliberately contentless report.\n444\t *\n445\t * Two guards, both load-bearing rather than decorative. It refuses to run\n446\t * inside a coding-agent session, because an agent investigating a blocked sync\n447\t * would otherwise read the flagged text into the transcript and mint a fresh\n448\t * event carrying it. And it writes to a file outside the repo by default\n449\t * rather than to stdout, so the content does not pass through a terminal that\n450\t * something else may be recording.\n451\t */\n452\tasync function cmdInspect(positional: string[], flags: Flags): Promise<void> {\n453\t  if (positional.length === 0) {\n454\t    process.stderr.write(\n455\t      \"usage: cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\\n\",\n456\t    );\n457\t    process.exit(2);\n458\t  }\n459\t  const agentVar = inAgentSession();\n460\t  if (agentVar && !flags[\"force\"]) {\n461\t    process.stderr.write(\n462\t      `cledger inspect: refusing to run inside a coding-agent session (saw $${agentVar}).\\n\\n` +\n463\t        \"  Reading flagged content here would capture it into this conversation and\\n\" +\n464\t        \"  re-seed the finding you are inspecting. Run this in a plain terminal.\\n\\n\" +\n465\t        \"  --force overrides, and is almost always the wrong call.\\n\",\n466\t    );\n467\t    process.exit(2);\n468\t  }\n469\t\n470\t  const repo = await requireRepo();\n471\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n472\t  const prefix = positional[0]!;\n473\t  const context = typeof flags[\"context\"] === \"string\" ? Number(flags[\"context\"]) : 400;\n474\t  if (!Number.isFinite(context) || context < 0) {\n475\t    process.stderr.write(\"cledger inspect: --context must be a non-negative number\\n\");\n476\t    process.exit(2);\n477\t  }\n478\t  const reveal = Boolean(flags[\"reveal\"]);\n479\t\n480\t  const events = await readEvents(repo);\n481\t  const matched = events.filter((e) => e.id.startsWith(prefix));\n482\t  if (matched.length === 0) {\n483\t    process.stderr.write(`cledger inspect: no event matching id prefix ${prefix}\\n`);\n484\t    process.exit(1);\n485\t  }\n486\t\n487\t  // Deliberately not allowlist-filtered: inspecting is exactly how you decide\n488\t  // whether something *should* be allowlisted, and re-checking an old decision\n489\t  // is legitimate.\n490\t  const findings = scanEvents(matched, tier);\n491\t  if (findings.length === 0) {\n492\t    process.stderr.write(\n493\t      `cledger inspect: no findings in ${matched.length} matching event(s) at the ${tier} tier\\n`,\n494\t    );\n495\t    return;\n496\t  }\n497\t\n498\t  const byId = new Map(matched.map((e) => [e.id, e]));\n499\t  const body = [\n500\t    `cledger inspect — ${findings.length} finding(s) in ${matched.length} event(s)`,\n501\t    `context: ${context} chars each side | matched text: ${reveal ? \"REVEALED\" : \"masked\"}`,\n502\t    \"\",\n503\t    \"This file contains raw conversation content and possibly a real secret.\",\n504\t    \"Delete it when you are done, and do not paste it into an agent session.\",\n505\t    \"\",\n506\t    ...findings.map((f) => renderFinding(byId.get(f.eventId)!, f, { context, reveal })),\n507\t  ].join(\"\\n\");\n508\t\n509\t  if (flags[\"stdout\"]) {\n510\t    process.stdout.write(body);\n511\t    return;\n512\t  }\n513\t  const { mkdtemp, writeFile } = await import(\"node:fs/promises\");\n514\t  const { tmpdir } = await import(\"node:os\");\n515\t  const { join } = await import(\"node:path\");\n516\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-inspect-\"));\n517\t  const out = join(dir, `${prefix.slice(0, 16)}.txt`);\n518\t  await writeFile(out, body, { mode: 0o600 });\n519\t  process.stderr.write(\n520\t    `${findings.length} finding(s) written to:\\n  ${out}\\n\\n` +\n521\t      \"Open it in an editor, then delete it. Re-run with --reveal to include the\\n\" +\n522\t      \"matched text itself, or --context N to widen the surrounding text.\\n\",\n523\t  );\n524\t}\n525\t\n526\tasync function cmdAllow(positional: string[]): Promise<void> {\n527\t  if (positional.length === 0) {\n528\t    process.stderr.write(\"usage: cledger allow <fingerprint...>\\n\");\n529\t    process.exit(2);\n530\t  }\n531\t  const repo = await requireRepo();\n532\t  await addToAllowlist(repo, positional);\n533\t  process.stderr.write(`allowlisted ${positional.length} fingerprint(s)\\n`);\n534\t}\n535\t\n536\tasync function cmdRedact(positional: string[], flags: Flags): Promise<void> {\n537\t  const idPrefix = positional[0];\n538\t  if (!idPrefix) {\n539\t    process.stderr.write(\"usage: cledger redact <event-id-prefix> (--pattern REGEX | --all) [--reason TEXT]\\n\");\n540\t    process.exit(2);\n541\t  }\n542\t  const repo = await requireRepo();\n543\t  const redactOpts: { pattern?: string; all?: boolean; reason?: string } = {};\n544\t  if (typeof flags[\"pattern\"] === \"string\") redactOpts.pattern = flags[\"pattern\"];\n545\t  if (flags[\"all\"] === true) redactOpts.all = true;\n546\t  if (typeof flags[\"reason\"] === \"string\") redactOpts.reason = flags[\"reason\"];\n547\t  let result;\n548\t  try {\n549\t    result = await redactEvent(repo, idPrefix, redactOpts);\n550\t  } catch (err) {\n551\t    // Already-shared (or unverifiable) content: the message is a full\n552\t    // explanation, so print it as-is rather than through main()'s generic\n553\t    // one-line handler.\n554\t    if (err instanceof RedactAfterShareError) {\n555\t      process.stderr.write(err.message + \"\\n\");\n556\t      process.exit(1);\n557\t    }\n558\t    throw err;\n559\t  }\n560\t  const fingerprints = result.event.redactions?.map((r) => r.fingerprint).join(\", \") || \"(none)\";\n561\t  process.stderr.write(\n562\t    `cledger redact: rewrote ${result.event.id.slice(0, 16)} — fingerprints: ${fingerprints}\\n` +\n563\t      `companion event: ${result.redactionEvent.id.slice(0, 16)}\\n`,\n564\t  );\n565\t  // Say what actually happened. This used to print \"history squashed: yes\",\n566\t  // which read as \"the value is gone\" — it is not, and asserting an outcome\n567\t  // the tool does not achieve is worse than saying nothing.\n568\t  if (result.squashed) {\n569\t    process.stderr.write(\n570\t      `notes history: chain severed — the pre-redaction note is no longer reachable from\\n` +\n571\t        `  ${NOTES_REF} and was never pushed. The old objects remain in this repo's\\n` +\n572\t        `  reflog and object store until git expires them (typically 30-90 days); they are\\n` +\n573\t        `  local-only, as git transfers neither reflogs nor unreachable objects. To drop them\\n` +\n574\t        `  now: git reflog expire --expire=now --all && git gc --prune=now  (repo-wide).\\n`,\n575\t    );\n576\t  } else {\n577\t    process.stderr.write(\n578\t      `notes history: untouched — this event was still in the pending queue, so it never\\n` +\n579\t        `  reached the notes ref.\\n`,\n580\t    );\n581\t  }\n582\t  if (result.knownSecretsRemembered > 0) {\n583\t    process.stderr.write(\n584\t      `remembered ${result.knownSecretsRemembered} secret value(s) for capture-time redaction ` +\n585\t        `(redact.knownSecrets is on)\\n`,\n586\t    );\n587\t  }\n588\t}\n589\t\n590\tasync function cmdReAnchor(positional: string[], flags: Flags): Promise<void> {\n591\t  const repo = await requireRepo();\n592\t\n593\t  if (positional.length > 0) {\n594\t    if (typeof flags[\"onto\"] !== \"string\") {\n595\t      process.stderr.write(\"usage: cledger re-anchor <old-rev...> --onto REV\\n\");\n596\t      process.exit(2);\n597\t    }\n598\t    const { event, superseded, successor } = await manualReAnchor(repo, positional, flags[\"onto\"]);\n599\t    process.stderr.write(\n600\t      event\n601\t        ? `cledger re-anchor: mapped ${superseded.length} commit(s) onto ${successor.slice(0, 12)} ` +\n602\t            `(event ${event.id.slice(0, 16)})\\n`\n603\t        : `cledger re-anchor: an identical mapping already exists — nothing appended\\n`,\n604\t    );\n605\t    return;\n606\t  }\n607\t\n608\t  const apply = flags[\"apply\"] === true;\n609\t  const opts: { target?: string; apply: boolean } = { apply };\n610\t  if (typeof flags[\"target\"] === \"string\") opts.target = flags[\"target\"];\n611\t  const result = await runReAnchor(repo, opts);\n612\t  if (!result.target) {\n613\t    process.stderr.write(\n614\t      \"cledger re-anchor: no target to compare against (no origin default branch or upstream); \" +\n615\t        \"pass one with --target\\n\",\n616\t    );\n617\t    process.exit(2);\n618\t  }\n619\t  if (result.detected.length === 0 && result.unmatched.length === 0) {\n620\t    process.stderr.write(`cledger re-anchor: nothing to re-anchor against ${result.target}\\n`);\n621\t    return;\n622\t  }\n623\t  for (const d of result.detected) {\n624\t    process.stderr.write(\n625\t      `  branch ${d.mapping.branch}: ${d.mapping.superseded.length} commit(s) -> ` +\n626\t        `${d.mapping.successor.slice(0, 12)} (${d.mapping.method} match, ` +\n627\t        `${d.notedAnchors} with conversations)\\n`,\n628\t    );\n629\t  }\n630\t\n631\t  if (result.unmatched.length > 0) {\n632\t    