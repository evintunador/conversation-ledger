n181\t}\n182\t\n183\tfunction readOptionsFrom(flags: Flags): ReadOptions {\n184\t  const opts: ReadOptions = {};\n185\t  if (!flags[\"all\"]) opts.reachableFrom = typeof flags[\"rev\"] === \"string\" ? flags[\"rev\"] : \"HEAD\";\n186\t  if (typeof flags[\"kind\"] === \"string\") opts.kind = flags[\"kind\"];\n187\t  if (typeof flags[\"source\"] === \"string\") opts.source = flags[\"source\"];\n188\t  if (typeof flags[\"model\"] === \"string\") opts.model = flags[\"model\"];\n189\t  if (typeof flags[\"conversation\"] === \"string\") opts.conversation = flags[\"conversation\"];\n190\t  return opts;\n191\t}\n192\t\n193\t/**\n194\t * The one-line preview `log` shows per event. Record kinds lead with the\n195\t * source's own type name (`mode`, `event_msg/token_count`) because that is\n196\t * what distinguishes one from the next — falling straight through to\n197\t * `JSON.stringify` would show every `session_state` line as the same wall of\n198\t * envelope fields.\n199\t */\n200\tfunction snippet(event: EvidenceEvent): string {\n201\t  const c = event.content as Record<string, unknown> | string | null;\n202\t  let text = \"\";\n203\t  if (typeof c === \"string\") text = c;\n204\t  else if (c && typeof c === \"object\") {\n205\t    const label = c[\"state_type\"] ?? c[\"activity_type\"] ?? c[\"injection_type\"] ?? c[\"operation\"];\n206\t    const body = c[\"text\"] ?? c[\"summary\"] ?? c[\"title\"];\n207\t    if (typeof label === \"string\") {\n208\t      text = `${label}  ${typeof body === \"string\" ? body : JSON.stringify(c)}`;\n209\t    } else {\n210\t      text = String(body ?? JSON.stringify(c));\n211\t    }\n212\t  }\n213\t  text = text.replace(/\\s+/g, \" \").trim();\n214\t  return text.length > 100 ? text.slice(0, 97) + \"...\" : text;\n215\t}\n216\t\n217\tfunction printHuman(events: EvidenceEvent[]): void {\n218\t  for (const e of events) {\n219\t    const conv = e.conversation ? `${e.conversation.id.slice(0, 28)}#${e.conversation.seq}` : \"-\";\n220\t    const role =\n221\t      (e.content as Record<string, unknown> | null | undefined) &&\n222\t      typeof e.content === \"object\"\n223\t        ? String((e.content as Record<string, unknown>)[\"role\"] ?? e.actor.type)\n224\t        : e.actor.type;\n225\t    process.stdout.write(\n226\t      `${e.occurred_at}  ${e.kind}  ${role.padEnd(9)}  ${conv}  ${snippet(e)}\\n`,\n227\t    );\n228\t  }\n229\t}\n230\t\n231\t/**\n232\t * What `log`/`show`/`conversations` leave out unless asked.\n233\t *\n234\t * Two groups are hidden by default, for two different reasons. `reasoning`\n235\t * events are opaque ciphertext, never meant for a human-facing transcript.\n236\t * The session-machinery kinds (see SESSION_MACHINERY_KINDS) are meaningful,\n237\t * but a session declares its mode, its tracked files and its token counts far\n238\t * more often than anyone speaks — showing them by default would bury the\n239\t * conversation in its own bookkeeping.\n240\t *\n241\t * `--with-reasoning` / `--with-state` opt in, as does asking for the kind\n242\t * explicitly via `--kind` (hiding it there would just return nothing).\n243\t * `export`'s job is a lossless dump, so it never filters and needs no\n244\t * equivalent flag; neither does capture, which records all of it regardless.\n245\t */\n246\tfunction displayFilter(flags: Flags, opts: ReadOptions): (event: EvidenceEvent) => boolean {\n247\t  const reasoning = flags[\"with-reasoning\"] === true || opts.kind === \"reasoning\";\n248\t  const state =\n249\t    flags[\"with-state\"] === true || (opts.kind !== undefined && SESSION_MACHINERY_KINDS.has(opts.kind));\n250\t  return (event) => {\n251\t    if (!reasoning && event.kind === \"reasoning\") return false;\n252\t    if (!state && SESSION_MACHINERY_KINDS.has(event.kind)) return false;\n253\t    return true;\n254\t  };\n255\t}\n256\t\n257\tfunction printJsonl(events: EvidenceEvent[], includeRaw: boolean): void {\n258\t  for (const e of events) {\n259\t    const out = includeRaw ? e : { ...e, raw: undefined };\n260\t    process.stdout.write(JSON.stringify(out) + \"\\n\");\n261\t  }\n262\t}\n263\t\n264\tasync function cmdAppend(flags: Flags): Promise<void> {\n265\t  const repo = await requireRepo();\n266\t  const body = await readStdin();\n267\t  const drafts: EventDraft[] = body\n268\t    .split(\"\\n\")\n269\t    .filter((l) => l.trim())\n270\t    .map((l) => JSON.parse(l) as EventDraft);\n271\t  if (drafts.length === 0) return;\n272\t  const result = await appendEvents(repo, drafts);\n273\t  if (!flags[\"quiet\"]) {\n274\t    for (const e of result.appended) process.stdout.write(e.id + \"\\n\");\n275\t    process.stderr.write(\n276\t      `appended ${result.appended.length}, deduped ${result.deduped}` +\n277\t        (result.anchor ? ` (anchor ${result.anchor.slice(0, 12)})` : \" (pending: no commits yet)\") +\n278\t        \"\\n\",\n279\t    );\n280\t  }\n281\t}\n282\t\n283\tasync function cmdLog(flags: Flags): Promise<void> {\n284\t  const repo = await requireRepo();\n285\t  const opts = readOptionsFrom(flags);\n286\t  let events = await readEvents(repo, opts);\n287\t  events = events.filter(displayFilter(flags, opts));\n288\t  if (flags[\"json\"]) printJsonl(events, false);\n289\t  else printHuman(events);\n290\t}\n291\t\n292\tasync function cmdShow(positional: string[], flags: Flags): Promise<void> {\n293\t  const prefix = positional[0];\n294\t  if (!prefix) {\n295\t    process.stderr.write(\"usage: cledger show <conversation-id-prefix>\\n\");\n296\t    process.exit(2);\n297\t  }\n298\t  const repo = await requireRepo();\n299\t  let events = await readEvents(repo, { conversation: prefix });\n300\t  events = events.filter(displayFilter(flags, {}));\n301\t  if (events.length === 0) {\n302\t    process.stderr.write(`no events for conversation ${prefix}\\n`);\n303\t    process.exit(1);\n304\t  }\n305\t  if (flags[\"json\"]) {\n306\t    printJsonl(events, true);\n307\t    return;\n308\t  }\n309\t  for (const e of sortEvents(events)) {\n310\t    const c = e.content as Record<string, unknown>;\n311\t    const role = typeof c === \"object\" && c ? String(c[\"role\"] ?? e.actor.type) : e.actor.type;\n312\t    const text =\n313\t      typeof c === \"object\" && c && typeof c[\"text\"] === \"string\"\n314\t        ? (c[\"text\"] as string)\n315\t        : JSON.stringify(e.content, null, 2);\n316\t    process.stdout.write(`\\n[${e.occurred_at}] ${role} (${e.kind}, ${e.id.slice(0, 16)})\\n`);\n317\t    process.stdout.write(text.trimEnd() + \"\\n\");\n318\t  }\n319\t}\n320\t\n321\tasync function cmdConversations(flags: Flags): Promise<void> {\n322\t  const repo = await requireRepo();\n323\t  const opts = readOptionsFrom(flags);\n324\t  let events = await readEvents(repo, opts);\n325\t  events = events.filter(displayFilter(flags, opts));\n326\t  const byConv = new Map<\n327\t    string,\n328\t    { count: number; first: string; last: string; source: string; models: Set<string> }\n329\t  >();\n330\t  for (const e of events) {\n331\t    const id = e.conversation?.id ?? \"(none)\";\n332\t    const entry = byConv.get(id) ?? {\n333\t      count: 0,\n334\t      first: e.occurred_at,\n335\t      last: e.occurred_at,\n336\t      source: e.producer.source ?? e.producer.tool,\n337\t      models: new Set<string>(),\n338\t    };\n339\t    entry.count++;\n340\t    // A conversation can legitimately list several models — codex restates\n341\t    // `turn_context` when the user switches mid-session, and a claude-code\n342\t    // session mixes real model ids with `<synthetic>` harness messages.\n343\t    if (e.producer.model) entry.models.add(e.producer.model);\n344\t    if (e.occurred_at < entry.first) entry.first = e.occurred_at;\n345\t    if (e.occurred_at > entry.last) entry.last = e.occurred_at;\n346\t    byConv.set(id, entry);\n347\t  }\n348\t  for (const [id, s] of [...byConv.entries()].sort((a, b) => a[1].last.localeCompare(b[1].last))) {\n349\t    const models = s.models.size > 0 ? [...s.models].sort().join(\",\") : \"-\";\n350\t    process.stdout.write(\n351\t      `${id}  ${s.source}  ${models}  ${s.count} events  ${s.first} .. ${s.last}\\n`,\n352\t    );\n353\t  }\n354\t}\n355\t\n356\tasync function cmdExport(flags: Flags): Promise<void> {\n357\t  const repo = await requireRepo();\n358\t  const opts: ReadOptions = {};\n359\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n360\t  const events = await readEvents(repo, opts);\n361\t  printJsonl(events, true);\n362\t}\n363\t\n364\tasync function cmdSync(flags: Flags): Promise<void> {\n365\t  const repo = await requireRepo();\n366\t  const remote = typeof flags[\"remote\"] === \"string\" ? flags[\"remote\"] : \"origin\";\n367\t  const mode = flags[\"push\"] ? \"push\" : flags[\"fetch\"] ? \"fetch\" : \"both\";\n368\t  // Push is scoped to the current branch by default; --all restores the\n369\t  // pre-0.14.0 whole-ledger push, --rev scopes to something else.\n370\t  const scope: string | null = flags[\"all\"] === true\n371\t    ? null\n372\t    : typeof flags[\"rev\"] === \"string\"\n373\t      ? flags[\"rev\"]\n374\t      : \"HEAD\";\n375\t  const result = await sync(repo, remote, mode, {\n376\t    skipScan: flags[\"no-scan\"] === true,\n377\t    paranoid: flags[\"paranoid\"] === true,\n378\t    scope,\n379\t  });\n380\t  const pushed = !result.pushed\n381\t    ? \"not pushed\"\n382\t    : result.scopedAnchors === null\n383\t      ? \"pushed (whole ledger)\"\n384\t      : `pushed (${result.scopedAnchors} commit(s) in scope)`;\n385\t  process.stderr.write(\n386\t    `sync ${remote}: ${result.fetched ? \"fetched+merged\" : \"nothing fetched\"}, ${pushed}\\n`,\n387\t  );\n388\t}\n389\t\n390\tasync function cmdTransportPush(positional: string[]): Promise<void> {\n391\t  const repo = await findRepo(process.cwd());\n392\t  if (!repo) return; // a hook must never fail the user's push\n393\t  const remote = positional[0] || \"origin\";\n394\t  // git's pre-push hook pipes the refs being pushed. Only read when stdin is\n395\t  // actually a pipe: a manual `cledger transport-push` from a terminal would\n396\t  // otherwise block forever waiting on a human who has nothing to type.\n397\t  let revs: string[] = [];\n398\t  if (process.stdin.isTTY !== true) {\n399\t    try {\n400\t      revs = parsePrePushRefs(await readStdin());\n401\t    } catch {\n402\t      revs = []; // unreadable stdin must never fail the user's push\n403\t    }\n404\t  }\n405\t  try {\n406\t    await transportPush(repo, remote, revs);\n407\t  } catch (err) {\n408\t    if (err instanceof ScanBlockedError) {\n409\t      // transport.strict: nonzero exit makes git abort the entire push.\n410\t      process.stderr.write(\"cledger: entire push blocked (transport.strict is enabled)\\n\");\n411\t      process.exit(1);\n412\t    }\n413\t    // Anything else is a cledger bug or environment problem; the user's\n414\t    // code push must proceed regardless.\n415\t    process.stderr.write(\n416\t      `cledger: transport-push error (push continues): ${err instanceof Error ? err.message : String(err)}\\n`,\n417\t    );\n418\t  }\n419\t}\n420\t\n421\tasync function cmdScan(flags: Flags): Promise<void> {\n422\t  const repo = await requireRepo();\n423\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n424\t  const opts: ReadOptions = {};\n425\t  if (typeof flags[\"rev\"] === \"string\") opts.reachableFrom = flags[\"rev\"];\n426\t  const events = await readEvents(repo, opts);\n427\t  const findings = filterFindings(scanEvents(events, tier), await loadAllowlist(repo));\n428\t  if (findings.length === 0) {\n429\t    process.stderr.write(\"cledger scan: no findings\\n\");\n430\t    return;\n431\t  }\n432\t  for (const f of findings) process.stdout.write(formatFinding(f) + \"\\n\");\n433\t  const eventIds = [...new Set(findings.map((f) => f.eventId))];\n434\t  process.stderr.write(`\\n${findingGuidance(eventIds)}\\n`);\n435\t  process.stderr.write(\n436\t    `\\ncledger scan: ${findings.length} finding(s) across ${eventIds.length} event(s)\\n`,\n437\t  );\n438\t  process.exit(1);\n439\t}\n440\t\n441\t/**\n442\t * Show a finding with enough surrounding text to actually judge it — the\n443\t * counterpart to `formatFinding`'s deliberately contentless report.\n444\t *\n445\t * Two guards, both load-bearing rather than decorative. It refuses to run\n446\t * inside a coding-agent session, because an agent investigating a blocked sync\n447\t * would otherwise read the flagged text into the transcript and mint a fresh\n448\t * event carrying it. And it writes to a file outside the repo by default\n449\t * rather than to stdout, so the content does not pass through a terminal that\n450\t * something else may be recording.\n451\t */\n452\tasync function cmdInspect(positional: string[], flags: Flags): Promise<void> {\n453\t  if (positional.length === 0) {\n454\t    process.stderr.write(\n455\t      \"usage: cledger inspect <event-id-prefix> [--context N] [--reveal] [--stdout] [--force]\\n\",\n456\t    );\n457\t    process.exit(2);\n458\t  }\n459\t  const agentVar = inAgentSession();\n460\t  if (agentVar && !flags[\"force\"]) {\n461\t    process.stderr.write(\n462\t      `cledger inspect: refusing to run inside a coding-agent session (saw $${agentVar}).\\n\\n` +\n463\t        \"  Reading flagged content here would capture it into this conversation and\\n\" +\n464\t        \"  re-seed the finding you are inspecting. Run this in a plain terminal.\\n\\n\" +\n465\t        \"  --force overrides, and is almost always the wrong call.\\n\",\n466\t    );\n467\t    process.exit(2);\n468\t  }\n469\t\n470\t  const repo = await requireRepo();\n471\t  const tier: \"standard\" | \"paranoid\" = flags[\"paranoid\"] ? \"paranoid\" : \"standard\";\n472\t  const prefix = positional[0]!;\n473\t  const context = typeof flags[\"context\"] === \"string\" ? Number(flags[\"context\"]) : 400;\n474\t  if (!Number.isFinite(context) || context < 0) {\n475\t    process.stderr.write(\"cledger inspect: --context must be a non-negative number\\n\");\n476\t    process.exit(2);\n477\t  }\n478\t  const reveal = Boolean(flags[\"reveal\"]);\n479\t\n480\t  const events = await readEvents(repo);\n481\t  const matched = events.filter((e) => e.id.startsWith(prefix));\n482\t  if (matched.length === 0) {\n483\t    process.stderr.write(`cledger inspect: no event matching id prefix ${prefix}\\n`);\n484\t    process.exit(1);\n485\t  }\n486\t\n487\t  // Deliberately not allowlist-filtered: inspecting is exactly how you decide\n488\t  // whether something *should* be allowlisted, and re-checking an old decision\n489\t  // is legitimate.\n490\t  const findings = scanEvents(matched, tier);\n491\t  if (findings.length === 0) {\n492\t    process.stderr.write(\n493\t      `cledger inspect: no findings in ${matched.length} matching event(s) at the ${tier} tier\\n`,\n494\t    );\n495\t    return;\n496\t  }\n497\t\n498\t  const byId = new Map(matched.map((e) => [e.id, e]));\n499\t  const body = [\n500\t    `cledger inspect — ${findings.length} finding(s) in ${matched.length} event(s)`,\n501\t    `context: ${context} chars each side | matched text: ${reveal ? \"REVEALED\" : \"masked\"}`,\n502\t    \"\",\n503\t    \"This file contains raw conversation content and possibly a real secret.\",\n504\t    \"Delete it when you are done, and do not paste it into an agent session.\",\n505\t    \"\",\n506\t    ...findings.map((f) => renderFinding(byId.get(f.eventId)!, f, { context, reveal })),\n507\t  ].join(\"\\n\");\n508\t\n509\t  if (flags[\"stdout\"]) {\n510\t    process.stdout.write(body);\n511\t    return;\n512\t  }\n513\t  const { mkdtemp, writeFile } = await import(\"node:fs/promises\");\n514\t  const { tmpdir } = await import(\"node:os\");\n515\t  const { join } = await import(\"node:path\");\n516\t  const dir = await mkdtemp(join(tmpdir(), \"cledger-inspect-\"));\n517\t  const out = join(dir, `${prefix.slice(0, 16)}.txt`);\n518\t  await writeFile(out, body, { mode: 0o600 });\n519\t  process.stderr.write(\n520\t    `${findings.length} finding(s) written to:\\n  ${out}\\n\\n` +\n521\t      \"Open it in an editor, then delete it. Re-run with --reveal to include the\\n\" +\n522\t      \"matched text itself, or --context N to widen the surrounding text.\\n\",\n523\t  );\n524\t}\n525\t\n526\tasync function cmdAllow(positional: string[]): Promise<void> {\n527\t  if (positional.length === 0) {\n528\t    process.stderr.write(\"usage: cledger allow <fingerprint...>\\n\");\n529\t    process.exit(2);\n530\t  }\n531\t  const repo = await requireRepo();\n532\t  await addToAllowlist(repo, positional);\n533\t  process.stderr.write(`allowlisted ${positional.length} fingerprint(s)\\n`);\n534\t}\n535\t\n536\tasync function cmdRedact(positional: string[], flags: Flags): Promise<void> {\n537\t  const idPrefix = positional[0];\n538\t  if (!idPrefix) {\n539\t    process.stderr.write(\"usage: cledger redact <event-id-prefix> (--pattern REGEX | --all) [--reason TEXT]\\n\");\n540\t    process.exit(2);\n541\t  }\n542\t  const repo = await requireRepo();\n543\t  const redactOpts: { pattern?: string; all?: boolean; reason?: string } = {};\n544\t  if (typeof flags[\"pattern\"] === \"string\") redactOpts.pattern = flags[\"pattern\"];\n545\t  if (flags[\"all\"] === true) redactOpts.all = true;\n546\t  if (typeof flags[\"reason\"] === \"string\") redactOpts.reason = flags[\"reason\"];\n547\t  let result;\n548\t  try {\n549\t    result = await redactEvent(repo, idPrefix, redactOpts);\n550\t  } catch (err) {\n551\t    // Already-shared (or unverifiable) content: the message is a full\n552\t    // explanation, so print it as-is rather than through main()'s generic\n553\t    // one-line handler.\n554\t    if (err instanceof RedactAfterShareError) {\n555\t      process.stderr.write(err.message + \"\\n\");\n556\t      process.exit(1);\n557\t    }\n558\t    throw err;\n559\t  }\n560\t  const fingerprints = result.event.redactions?.map((r) => r.fingerprint).join(\", \") |