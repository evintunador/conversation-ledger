 | { kind: \"no-ledger-ref\" }\n769\t  | { kind: \"has-ledger-ref\" }\n770\t  | { kind: \"unreachable\"; detail: string };\n771\t\n772\tasync function remoteLedgerState(repo: RepoInfo, remote: string): Promise<RemoteLedgerState> {\n773\t  const url = (await git([\"remote\", \"get-url\", remote], {\n774\t    cwd: repo.root,\n775\t    allowFailure: true,\n776\t  })).trim();\n777\t  if (!url) return { kind: \"no-remote\" };\n778\t  try {\n779\t    const out = (await git([\"ls-remote\", remote, NOTES_REF], { cwd: repo.root })).trim();\n780\t    return out ? { kind: \"has-ledger-ref\" } : { kind: \"no-ledger-ref\" };\n781\t  } catch (err) {\n782\t    return { kind: \"unreachable\", detail: err instanceof Error ? err.message : String(err) };\n783\t  }\n784\t}\n785\t\n786\t/**\n787\t * Layer E: before push, scan only the events the remote does not yet have\n788\t * (already-pushed events are not rescanned every time). On any surviving\n789\t * finding, print a report and throw so sync() does not proceed to push —\n790\t * the fetch/merge phase, if it already ran, is left in place.\n791\t */\n792\tasync function runScanGate(\n793\t  repo: RepoInfo,\n794\t  remote: string,\n795\t  tier: \"standard\" | \"paranoid\",\n796\t  anchors: string[] | null,\n797\t): Promise<void> {\n798\t  const remoteIds = await remoteNoteIds(repo, remote);\n799\t\n800\t  const localEvents: EvidenceEvent[] = [];\n801\t  // Scan exactly what the push will carry. Before scoping this swept every\n802\t  // anchor, so a finding on a branch that was never going to be pushed still\n803\t  // blocked the push — which, given how often the flagged text is a\n804\t  // conversation *about* credential-shaped code, was a routine false block.\n805\t  for (const anchor of anchors ?? (await listAnchors(repo))) {\n806\t    localEvents.push(...(await readNoteEvents(repo, anchor)));\n807\t  }\n808\t  // Pending events are unanchored, so they are not in this push at all; they\n809\t  // are still scanned because they 