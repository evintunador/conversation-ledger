), and\n// intersect with the fingerprints we're trying to explain. Output maps\n// fingerprint -> [file paths] — NEVER the matched text itself, so this\n// report is safe to print into a captured conversation.\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { rulesForTier, shannonEntropy } from \"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/dist/redact/rules.js\";\n\nconst [repo, refSpec, ...wanted] = process.argv.slice(2);\nif (!repo || !refSpec || wanted.length === 0) {\n  console.error(\"usage: prove-fingerprints.mjs <repo> <ref,ref,...> <fp> [fp...]\");\n  process.exit(2);\n}\nconst refs = refSpec.split(\",\");\nconst want = new Set(wanted);\n\nconst fp = (s) => createHash(\"sha256\").update(s, \"utf8\").digest(\"hex\").slice(0, 12);\n\n// blob oid -> representative path\nconst objects = execFileSync(\"git\", [\"rev-list\", \"--objects\", ...refs], {\n  cwd: repo, maxBuffer: 1024 * 1024 * 256, encoding: \"utf8\",\n});\nconst blobs = new Map();\nfor (const line of objects.split(\"\\n\")) {\n  const sp = line.indexOf(\" \");\n  if (sp === -1) continue;\n  const oid = line.slice(0, sp);\n  const path = line.slice(sp + 1);\n  if (path && !blobs.has(oid)) blobs.set(oid, path);\n}\n\nconst rules = rulesForTier(\"paranoid\"); // superset: capture + standard + entropy rule\nconst hits = new Map(); // fp -> Set(path)\nlet scanned = 0;\nfor (const [oid, path] of blobs) {\n  const cat = spawnSync(\"git\", [\"cat-file\", \"-p\", oid], {\n    cwd: repo, maxBuffer: 1024 * 1024 * 64,\n  });\n  if (cat.status !== 0 || !cat.stdout) continue; // trees/commits or unreadable\n  const buf = cat.stdout;\n  if (buf.includes(0)) continue; // binary\n  const text = buf.toString(\"utf8\");\n  scanned++;\n  for (const rule of rules) {\n    rule.pattern.lastIndex = 0;\n    let m;\n    while ((m = rule.pattern.exec(text)) !== null) {\n      const matchText = m[0];\n      if (rule.entropyGated && shannonEntropy(matchText) < 4.0) continue;\n      const f = fp(matchText);\n      if (want.has(f)) {\n        if (!hits.set) throw new Error(\"unreachable\");\n        if (!hits.has(f)) hits.set(f, new Set());\n        hits.get(f).add(`${path} (blob ${oid.slice(0, 8)})`);\n      }\n      if (m.index === rule.pattern.lastIndex) rule.pattern.lastIndex++;\n    }\n  }\n}\n\nconsole.log(`scanned ${scanned} text blobs reachable from ${refs.join(\", \")} in ${repo}`);\nfor (const f of wanted) {\n  if (hits.has(f)) {\n    console.log(`PROVEN  ${f}  appears in committed content:`);\n    for (const p of [...hits.get(f)].slice(0, 5)) console.log(`          ${p}`);\n  } else {\n    console.log(`UNPROVEN ${f}  no committed blob contains this span`);\n  }\n}\n","filePath":"/Users/evintunador/.claude/jobs/b8bc0200/tmp/prove-fingerprints.mjs","originalFile":null,"structuredPatch":[],"type":"create","userModified":false},"type":"user","userType":"external","uuid":"ac1c2b31-f77f-4c87-bb4d-e7f2a68048cd","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.314Z","schema":"conversation-ledger/v1"}
