nRule[] = [\n157\t  ...CAPTURE_RULES,\n158\t  ...STANDARD_RULES,\n159\t  ...PARANOID_RULES,\n160\t];\n161\t\n162\t/** \"capture\" -> capture only; \"standard\" -> capture+standard; \"paranoid\" -> all. */\n163\texport function rulesForTier(tier: RuleTier): RedactionRule[] {\n164\t  if (tier === \"capture\") return [...CAPTURE_RULES];\n165\t  if (tier === \"standard\") return [...CAPTURE_RULES, ...STANDARD_RULES];\n166\t  return [...RULES];\n167\t}\n168\t\n169\t/** Shannon entropy in bits per character, for paranoid-tier scan filtering. */\n170\texport function shannonEntropy(s: string): number {\n171\t  if (s.length === 0) return 0;\n172\t  const counts = new Map<string, number>();\n173\t  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);\n174\t  let entropy = 0;\n175\t  for (const count of counts.values()) {\n176\t    const p = count / s.length;\n177\t    entropy -= p * Math.log2(p);\n178\t  }\n179\t  return entropy;\n180\t}\n181\t","tool_use_id":"toolu_01TzX9VQatqBedfVFaPdoxNG","type":"tool_result"}],"role":"user"},"parentUuid":"c33b0802-2003-4b59-ab21-dd9dfd4a6169","promptId":"b6bcbf20-f377-4512-9762-3e53a49290ec","sessionId":"b8bc0200-5312-42a4-9c54-a116d8d4a925","sessionKind":"bg","session_id":"b8bc0200-5312-42a4-9c54-a116d8d4a925","sourceToolAssistantUUID":"c33b0802-2003-4b59-ab21-dd9dfd4a6169","timestamp":"2026-08-12T02:25:46.938Z","toolUseResult":{"file":{"content":"/**\n * Capture-time and scan-time redaction rulesets. See docs/\n * WIP_TECHNICAL_DESIGN.md (\"Privacy and integrity\") for the layered design:\n * capture-tier rules run unconditionally on every draft and must be\n * near-zero-false-positive (a false positive silently rewrites the record),\n * standard/paranoid tiers are scan-time-only and may be noisier since they\n * just warn a human rather than rewrite anything.\n */\n\nexport const RULESET_VERSION = \"cledger-rules/1\";\n\nexport type RuleTier = \"capture\" | \"standard\" | \"paranoid\";\n\nexport interface RedactionRule {\n  id: string;\n  tier: RuleTier;\n  description: string;\n  pattern: RegExp;\n  /**\n   * Paranoid-tier only: the pattern matches *candidate* tokens; the scanner\n   * applies entropy filtering on top before treating a match as a finding.\n   * Not consulted by capture-time redaction (redactText skips these rules).\n   */\n  entropyGated?: true;\n}\n\nconst CAPTURE_RULES: RedactionRule[] = [\n  {\n    id: \"github-token\",\n    tier: \"capture\",\n    description: \"GitHub personal access / OAuth / app / refresh token\",\n    pattern: /\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255}\\b/g,\n  },\n  {\n    id: \"github-fine-grained\",\n    tier: \"capture\",\n    description: \"GitHub fine-grained personal access token\",\n    pattern: /\\bgithub_pat_[A-Za-z0-9_]{22,255}\\b/g,\n  },\n  {\n    id: \"anthropic-api-key\",\n    tier: \"capture\",\n    description: \"Anthropic API key\",\n    pattern: /\\bsk-ant-[A-Za-z0-9_-]{32,}\\b/g,\n  },\n  {\n    id: \"openai-api-key\",\n    tier: \"capture\",\n    description: \"OpenAI API key\",\n    pattern: /\\bsk-(?!ant-)(?:(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{48})\\b/g,\n  },\n  {\n    id: \"aws-access-key-id\",\n    tier: \"capture\",\n    description: \"AWS access key id\",\n    pattern: /\\b(?:AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\\b/g,\n  },\n  {\n    id: \"google-api-key\",\n    tier: \"capture\",\n    description: \"Google API key\",\n    pattern: /\\bAIza[0-9A-Za-z_-]{35}\\b/g,\n  },\n  {\n    id: \"slack-token\",\n    tier: \"capture\",\n    description: \"Slack token\",\n    pattern: /\\bxox[baprs]-[0-9A-Za-z-]{10,}\\b/g,\n  },\n  {\n    id: \"stripe-key\",\n    tier: \"capture\",\n    description: \"Stripe live secret/restricted key\",\n    pattern: /\\b[sr]k_live_[0-9a-zA-Z]{24,}\\b/g,\n  },\n  {\n    id: \"gitlab-pat\",\n    tier: \"capture\",\n    description: \"GitLab personal access token\",\n    pattern: /\\bglpat-[0-9a-zA-Z_-]{20,}\\b/g,\n  },\n  {\n    id: \"npm-token\",\n    tier: \"capture\",\n    description: \"npm access token\",\n    pattern: /\\bnpm_[A-Za-z0-9]{36}\\b/g,\n  },\n  {\n    id: \"sendgrid-key\",\n    tier: \"capture\",\n    description: \"SendGrid API key\",\n    pattern: /\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b/g,\n  },\n  {\n    id: \"private-key-block\",\n    tier: \"capture\",\n    description: \"PEM-style private key block\",\n    pattern:\n      /-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----[\\s\\S]*?-----END (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----/g,\n  },\n  {\n    id: \"jwt\",\n    tier: \"capture\",\n    description: \"JSON Web Token\",\n    pattern: /\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b/g,\n  },\n];\n\nconst STANDARD_RULES: RedactionRule[] = [\n  {\n    id: \"keyword-assignment\",\n    tier: \"standard\",\n    description: \"Keyword-anchored secret assignment (password=, api_key:, ...)\",\n    /**\n     * The value charset deliberately excludes code punctuation — (){}[]<>;,$`\\\n     * — as well as whitespace and quotes. A real credential is drawn from\n     * token-ish characters (alphanumerics, -_.+/=~ etc.), whereas the dominant\n     * false-positive class is *source code that talks about secrets*: type\n     * annotations (`secret: string): string {`) and template interpolation\n     * (`secret: ${secret.slice(i, i + 6)}`) both hit the excluded set\n     * immediately and now fall below the 8-char floor instead of matching.\n     * Surfaced by dogfooding cledger on its own repo, where the old charset\n     * flagged the redaction source files themselves.\n     *\n     * Note this cannot (and should not) suppress secret-*shaped* string\n     * literals in source, e.g. a test fixture containing \"password=hunter2...\":\n     * those are indistinguishable from the real thing by pattern alone.\n     */\n    pattern:\n      /(?:password|passwd|secret|api_key|apikey|access_token|auth_token|credentials?)[\"']?\\s*[:=]\\s*[\"']?[^\\s\"'`(){}[\\]<>;,$\\\\]{8,}/gi,\n  },\n  {\n    id: \"url-credentials\",\n    tier: \"standard\",\n    description: \"Credentials embedded in a URL (scheme://user:pass@host)\",\n    pattern: /[a-z][a-z0-9+.-]*:\\/\\/[^\\s\\/:@]+:[^\\s@]{4,}@/gi,\n  },\n  {\n    id: \"bearer-token\",\n    tier: \"standard\",\n    description: \"Bearer token in an Authorization-style header value\",\n    pattern: /\\bbearer\\s+[A-Za-z0-9_\\-.=]{20,}/gi,\n  },\n];\n\nconst PARANOID_RULES: RedactionRule[] = [\n  {\n    id: \"high-entropy\",\n    tier: \"paranoid\",\n    description: \"High-entropy token candidate; entropy filtering applied by the scanner\",\n    pattern: /\\b[A-Za-z0-9+/_=-]{24,}\\b/g,\n    entropyGated: true,\n  },\n];\n\nexport const RULES: readonly RedactionRule[] = [\n  ...CAPTURE_RULES,\n  ...STANDARD_RULES,\n  ...PARANOID_RULES,\n];\n\n/** \"capture\" -> capture only; \"standard\" -> capture+standard; \"paranoid\" -> all. */\nexport function rulesForTier(tier: RuleTier): RedactionRule[] {\n  if (tier === \"capture\") return [...CAPTURE_RULES];\n  if (tier === \"standard\") return [...CAPTURE_RULES, ...STANDARD_RULES];\n  return [...RULES];\n}\n\n/** Shannon entropy in bits per character, for paranoid-tier scan filtering. */\nexport function shannonEntropy(s: string): number {\n  if (s.length === 0) return 0;\n  const counts = new Map<string, number>();\n  for (const ch of s) counts.set(ch, (counts.get(ch) ?? 0) + 1);\n  let entropy = 0;\n  for (const count of counts.values()) {\n    const p = count / s.length;\n    entropy -= p * Math.log2(p);\n  }\n  return entropy;\n}\n","filePath":"/Users/evintunador/repos/evintunador/conversation-ledger-worktrees/redaction-ux/src/redact/rules.ts","numLines":181,"startLine":1,"totalLines":181},"type":"text"},"type":"user","userType":"external","uuid":"2f4a0490-0be5-4ffc-9b6c-dcbd45b18462","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-13T00:39:22.316Z","schema":"conversation-ledger/v1"}
{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"content":{"blocks":[{"content":"1\t/**\n2\t * Sync-time secret scan (layer E, see docs/WIP_TECHNICAL_DESIGN.md \"Privacy\n3\t * and integrity\"). Unlike capture-tier redaction (apply.ts), this scanner\n4\t * never rewrites anything — it only reports findings so a human can decide\n5\t * whether to `cledger redact` the event, `cledger allow` the fingerprint as\n6\t * a known false positive, or push anyway with `--no-scan`. Rules may\n7\t * therefore be noisier than the capture tier.\n8\t */\n9\timport { mkdir, readFile, writeFile } from \"node:fs/promises\";\n10\timport { join } from \"node:path\";\n11\timport { sha256Hex } from \"../canonical.js\";\n12\timport type { RepoInfo } from \"../git.js\";\n13\timport type { EvidenceEvent } from \"../schema.js\";\n14\timport { isExemptFromRedaction, walkStrings } from \"./apply.js\";\n15\timport { rulesForTier, shannonEntropy } from \"./rules.js\";\n16\t\n17\texport interface Finding {\n18\t  eventId: string;\n19\t  conversation?: string;\n20\t  occurred_at: string;\n21\t  rule: string;\n22\t  fingerprint: string;\n23\t  /** JSON path of the string the match sits in, e.g. `content/blocks/0/text`. */\n24\t  path: string;\n25\t  /** Match span within that string, so `cledger inspect` can find it again. */\n26\t  start: number;\n27\t  end: number;\n28\t}\n29\t\n30\tconst PLACEHOLDER_RE = /\\[REDACTED:[^\\]]+\\]/g;\n31\t\n32\t/** True if [start, end) overlaps an existing `[REDACTED:...]` placeholder span in `text`. */\n33\tfunction overlapsPlaceholder(text: string, start: number, end: number): boolean {\n34\t  for (const m of text.matchAll(PLACEHOLDER_RE)) {\n35\t    const pStart = m.index ?? 0;\n36\t    const pEnd = pStart + m[0].length;\n37\t    if (start < pEnd && end > pStart) return true;\n38\t  }\n39\t  return false;\n40\t}\n41\t\n42\t/** Stands in for the matched secret wherever a match is rendered. */\n43\tconst MATCH_MARKER = \"<redacted>\";\n44\t\n45\tconst PURE_HEX_RE = /^[0-9a-fA-F]+$/;\n46\t\n47\t/**\n48\t * Scan already-finalized events for potential secrets. Read-only: never\n49\t * mutates content, only reports. `tier` selects the ruleset — \"standard\"\n50\t * re-runs the full capture ruleset plus scan-only keyword/URL/bearer rules\n51\t * (catching events captured under an older capture ruleset); \"paranoid\"\n52\t * additionally enables the entropy-gated high-entropy-token rule.\n53\t */\n54\texport function scanEvents(events: EvidenceEvent[], tier: \"standard\" | \"paranoid\"): Finding[] {\n55\t  const rules = rulesForTier(tier);\n56\t  const findings: Finding[] = [];\n57\t\n58\t  for (const event of events) {\n59\t    const visit = (value: string, path: string): string => {\n60\t      if (isExemptFromRedaction(event.kind, path)) return value;\n61\t      for (const rule of rules) {\n62\t        for (const m of value.matchAll(rule.pattern)) {\n63\t          const matchText = m[0];\n64\t          const start = m.index ?? 0;\n65\t          const end = start + matchText.length;\n66\t          if (overlapsPlaceholder(value, start, end)) continue;\n67\t          if (rule.entropyGated) {\n68\t            // Belt-and-suspenders: rulesForTier already excludes this rule\n69\t            // below \"paranoid\", but the gate is cheap to state explicitly.\n70\t            if (tier !== \"paranoid\") continue;\n71\t            if (PURE_HEX_RE.test(matchText)) continue; // git SHAs, content digests\n72\t            if (matchText.includes(\"[REDACTED:\")) continue;\n73\t            if (shannonEntropy(matchText) < 4.0) continue;\n74\t          }\n75\t          findings.push({\n76\t            eventId: event.id,\n77\t            ...(event.conversation ? { conversation: event.conversation.id } : {}),\n78\t            occurred_at: event.occurred_at,\n79\t            rule: rule.id,\n80\t            fingerprint: sha256Hex(matchText).slice(0, 12),\n81\t            path,\n82\t            start,\n83\t            end,