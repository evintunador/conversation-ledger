{"actor":{"type":"system"},"content":{"blocks":[{"content":"994\t      const event = parseEventLine(line);\n995\t      if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor, lines, index });\n996\t    });\n997\t  }\n998\t\n999\t  const pendingFile = pendingPath(repo);\n1000\t  const pendingLines = existsSync(pendingFile)\n1001\t    ? (await readFile(pendingFile, \"utf8\")).split(\"\\n\").filter((l) => l.trim().length > 0)\n1002\t    : [];\n1003\t  pendingLines.forEach((line, index) => {\n1004\t    const event = parseEventLine(line);\n1005\t    if (idMatchesPrefix(event.id, idPrefix)) matches.push({ event, anchor: null, lines: pendingLines, index });\n1006\t  });\n1007\t\n1008\t  if (matches.length === 0) {\n1009\t    throw new Error(`cledger redact: no event matches id prefix \"${idPrefix}\"`);\n1010\t  }\n1011\t  if (matches.length > 1) {\n1012\t    throw new Error(\n1013\t      `cledger redact: id prefix \"${idPrefix}\" is ambiguous (${matches.length} matches: ` +\n1014\t        `${matches.map((m) => m.event.id).join(\", \")})`,\n1015\t    );\n1016\t  }\n1017\t  return matches[0]!;\n1018\t}\n1019\t\n1020\texport interface RedactResult {\n1021\t  /** The rewritten event, with the secret removed. */\n1022\t  event: EvidenceEvent;\n1023\t  /** The companion `redaction` event recording why `event`'s content no longer matches its id. */\n1024\t  redactionEvent: EvidenceEvent;\n1025\t  /**\n1026\t   * True when the notes ref's commit chain was severed, making the\n1027\t   * pre-redaction note blob unreachable from the ref. Not a purge: the old\n1028\t   * objects remain in the local reflog/object store until git's own\n1029\t   * expiry+gc. False only for a pending-queue redaction, where the notes ref\n1030\t   * was never involved.\n1031\t   */\n1032\t  squashed: boolean;\n1033\t  /**\n1034\t   * Count of newly-remembered secret values written to the opt-in\n1035\t   * known-secrets store (0 unless `redact.knownSecrets` is on and this was a\n1036\t   * `--pattern` redaction that matched at least one not-already-known value).\n1037\t   */\n1038\t  knownSecretsRemembered: number;\n1039\t}\n1040\t\n1041\t/**\n1042\t * Refuse to redact an event whose pre-redaction content has already been\n1043\t * shared — or whose sharing status cannot be established.\n1044\t *\n1045\t * Redaction is a pre-push operation, and only a pre-push operation. Once a\n1046\t * note line is on a remote, rewriting it locally does not remove it and\n1047\t * cannot: a notes ref carries its own commit chain (so every prior note body\n1048\t * is in any clone's history, recoverable with a plain `git log -p`), and\n1049\t * `cat_sort_uniq` unions *lines* (so the original comes back on the next\n1050\t * merge). Worse, `pushScopedNotes` seeds from the remote's tip and unions the\n1051\t * local scope into it, so redact-then-push actively re-uploads the original\n1052\t * alongside the rewrite, leaving both copies on the remote permanently. The\n1053\t * command previously warned about this and proceeded anyway, reporting\n1054\t * partial success while making the situation strictly worse.\n1055\t *\n1056\t * Removing already-shared content is a fundamentally different job — history\n1057\t * rewriting on the notes ref, a force-push, and coordinated re-fetch by every\n1058\t * collaborator — and belongs to separate, deliberately destructive tooling\n1059\t * that does not exist yet. Until it does, the honest answer for a leaked\n1060\t * credential that has left the machine is to rotate it.\n1061\t *\n1062\t * \"Not yet shared\" is per *event*, not per repo: pushing regularly must not\n1063\t * disable redaction for everything captured afterwards, which is the ordinary\n1064\t * workflow. So a remote that has the ledger ref is queried for the ids it\n1065\t * actually holds, and only a hit on this event's id refuses.\n1066\t */\n1067\tasync function assertNotYetShared(repo: RepoInfo, eventId: string): Promise<void> {\n1068\t  const state = await r