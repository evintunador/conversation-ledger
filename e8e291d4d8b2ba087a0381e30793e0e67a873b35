{"actor":{"type":"system"},"content":{"blocks":[{"content":"1\t/**\n2\t * Draft builders for the non-conversational record: the state a session\n3\t * declares about itself, the things that happen in the harness around the\n4\t * turns, the material the harness injects into the model's context, and the\n5\t * intermediate file versions a session leaves behind.\n6\t *\n7\t * These are the counterpart to adapters/drift.ts. Drift handles line types an\n8\t * adapter does *not* know: preserve raw, warn, hope a later version can read\n9\t * them. Everything here is a type the adapter *does* know and has chosen to\n10\t * record with structure. Keeping them apart matters for the drift warning to\n11\t * stay meaningful — a warning that fires on every ordinary `mode` line stops\n12\t * being a signal that the upstream format moved.\n13\t *\n14\t * Every builder produces content in the same two-part shape: a `*_type`\n15\t * discriminator naming the source's own type verbatim, and the source's own\n16\t * fields beside it. Adapters do not rename or reinterpret those fields; a\n17\t * consumer that wants Claude Code's `permissionMode` reads `permissionMode`.\n18\t * What the ledger adds is the kind, the ordering, and the provenance.\n19\t *\n20\t * `blocks` appears whenever a record carries human-readable text, using the\n21\t * same `[{type: \"text\", text}]` shape `conversation_turn` uses. That is the\n22\t * one concession to uniformity: a consumer extracting text across a ledger\n23\t * should not need a per-kind special case to find it.\n24\t */\n25\t\n26\timport type { Actor, EventDraft, ProducerAgentContext } from \"../schema.js\";\n27\timport type { GitUserIdentity } from \"../git.js\";\n28\t\n29\t/** What every record shares: where it came from and where it sits. */\n30\texport interface RecordContext {\n31\t  occurredAt: string;\n32\t  /** Source system, e.g. \"claude-code\". */\n33\t  source: string;\n34\t  sessionId: string;\n35\t  /** Position in the source material — line index, part index. */\n36\t  seq: number;\n37\t  /** cledger's own version. */\n38\t  version: string;\n39\t  rawFormat: string;\n40\t  conversationId: string;\n41\t  /** Parent conversation id, for sub-conversations (see ConversationRef). */\n42\t  parentConversationId?: string;\n43\t  agent?: ProducerAgentContext;\n44\t  /**\n45\t   * Who the person at the keyboard is. Used only for records attributed to\n46\t   * `human` — a record the human drove should name them for the same reason a\n47\t   * turn does, or the ledger says \"a human did this\" while declining to say\n48\t   * which one, which is worse than either alternative.\n49\t   */\n50\t  identity?: GitUserIdentity;\n51\t}\n52\t\n53\t/**\n54\t * The shared skeleton every record shares: provenance, conversation position,\n55\t * and the verbatim source line under `raw`. Exported because a few source\n56\t * types map onto an existing kind rather than a new one — Claude Code's\n57\t * `system` lines that print into the conversation are `conversation_turn`s —\n58\t * and those still want this exact envelope.\n59\t */\n60\texport function recordDraft(\n61\t  ctx: RecordContext,\n62\t  kind: string,\n63\t  actorType: string,\n64\t  content: unknown,\n65\t  raw: unknown,\n66\t): EventDraft {\n67\t  const actor: Actor = { type: actorType };\n68\t  if (actorType === \"human\" && ctx.identity) {\n69\t    if (ctx.identity.email) actor.id = ctx.identity.email;\n70\t    if (ctx.identity.name) actor.display = ctx.identity.name;\n71\t  }\n72\t  return {\n73\t    kind,\n74\t    occurred_at: ctx.occurredAt,\n75\t    actor,\n76\t    producer: {\n77\t      tool: \"cledger\",\n78\t      version: ctx.version,\n79\t      source: ctx.source,\n80\t      session_id: ctx.sessionId,\n81\t      ...ctx.agent,\n82\t    },\n83\t    conversation: {\n84\t      id: ctx.conversationId,\n85\t      seq: ctx.seq,\n86\t      ...(ctx.parentConversationId ? { parent: ctx.parentConversationId } : {}),\n87\t    },\n88\t    content,\n89\t    raw: { format: ctx.rawFormat, data: raw },\n90\t  };\n91\t}\n92\t\n93\t/**\n94\t * Text blocks for a record, or nothing when there is no text to carry.\n95\t * Empty and whitespace-only strings are dropped rather than stored as an\n96\t * empty block — a block that renders as nothing is worse than no block,\n97\t * because a consumer cannot tell it apart from real empty output.\n98\t */\n99\texport function textBlocks(...texts: unknown[]): { blocks: unknown[] } | Record<string, never> {\n100\t  const blocks = texts\n101\t    .filter((t): t is string => typeof t === \"string\" && t.trim() !== \"\")\n102\t    .map((text) => ({ type: \"text\", text }));\n103\t  return blocks.length > 0 ? { blocks } : {};\n104\t}\n105\t\n106\t/**\n107\t * Move a source field's text into `blocks`, returning the remaining fields.\n108\t * Lifting rather than copying: a queued prompt or a command's stdout can run\n109\t * to kilobytes, and storing it under both its source field name and `blocks`\n110\t * would double that for no gain — `raw.data` already holds the original\n111\t * under its original name.\n112\t */\n113\texport function liftText(\n114\t  fields: Record<string, unknown>,\n115\t  key: string,\n116\t): Record<string, unknown> {\n117\t  const value = fields[key];\n118\t  if (typeof value !== \"string\" || value.trim() === \"\") return fields;\n119\t  const { [key]: _lifted, ...rest } = fields;\n120\t  return { ...rest, ...textBlocks(value) };\n121\t}\n122\t\n123\t/**\n124\t * A declaration the session makes about itself, holding until restated.\n125\t *\n126\t * The actor is `system`: a mode change is the harness recording its own\n127\t * configuration, not the user speaking, even when the user is what caused it.\n128\t * Sources restate this constantly and each restatement is kept — `seq` makes\n129\t * them distinct events, so \"the mode was still `auto` here\" survives as a\n130\t * fact rather than collapsing into the first statement.\n131\t */\n132\texport functio