{"actor":{"type":"system"},"content":{"blocks":[{"content":"300\t * A payload's fields without its own `type` discriminator, which the record's\n301\t * `activity_type`/`state_type` already names — keeping both would put the\n302\t * same string in two places in one object.\n303\t */\n304\tfunction payloadFields(payload: Record<string, unknown> | undefined): Record<string, unknown> {\n305\t  if (!payload) return {};\n306\t  const { type: _type, ...rest } = payload;\n307\t  return rest;\n308\t}\n309\t\n310\t/**\n311\t * The `RecordContext` a non-turn codex line converts under. Built identically\n312\t * by the capture loop and the re-normalization hook so both produce the same\n313\t * event identity for the same line.\n314\t */\n315\tfunction recordContext(\n316\t  occurredAt: string,\n317\t  seq: number,\n318\t  sessionId: string,\n319\t  version: string,\n320\t  agent: CodexAgentState,\n321\t): RecordContext {\n322\t  return {\n323\t    occurredAt,\n324\t    source: \"codex\",\n325\t    sessionId,\n326\t    seq,\n327\t    version,\n328\t    rawFormat: RAW_FORMAT,\n329\t    conversationId: `codex:${sessionId}`,\n330\t    agent: { ...agent },\n331\t  };\n332\t}\n333\t\n334\t/**\n335\t * Convert a codex line that is not a `response_item` into the record it\n336\t * deserves. Returns null for a type this adapter does not know (the caller\n337\t * routes it to the drift path) and for the `event_msg` payloads that\n338\t * duplicate a response_item (the caller drops those, deliberately).\n339\t */\n340\tfunction convertRecordLine(line: CodexRolloutLine, ctx: RecordContext): EventDraft | null {\n341\t  const type = line.type;\n342\t  if (typeof type !== \"string\") return null;\n343\t  const fields = payloadFields(line.payload);\n344\t\n345\t  if (SESSION_STATE_LINE_TYPES.has(type)) return sessionStateDraft(ctx, type, fields, line);\n346\t  if (ACTIVITY_LINE_TYPES.has(type)) return activityDraft(ctx, type, fields, line);\n347\t\n348\t  if (type === \"event_msg\") {\n349\