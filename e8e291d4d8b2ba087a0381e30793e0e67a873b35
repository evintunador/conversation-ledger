{"actor":{"type":"system"},"content":{"blocks":[{"content":"300\t\n301\t/** Flatten a source backup record into the ledger's file shape. */\n302\tfunction snapshotFile(path: string, backup: ClaudeFileBackup | undefined): SnapshotFile {\n303\t  const file: SnapshotFile = { path };\n304\t  if (typeof backup?.realParentDir === \"string\") file.dir = backup.realParentDir;\n305\t  if (typeof backup?.version === \"number\") file.version = backup.version;\n306\t  if (typeof backup?.backupTime === \"string\") file.backup_time = backup.backupTime;\n307\t  file.backup_file = typeof backup?.backupFileName === \"string\" ? backup.backupFileName : null;\n308\t  return file;\n309\t}\n310\t\n311\t/**\n312\t * The file versions one file-history line names, and what the ledger could\n313\t * read of them. `snapshot` lines state every tracked file (an empty set is\n314\t * itself a fact — nothing was tracked at that message); `delta` lines state\n315\t * one file's new version.\n316\t */\n317\tasync function fileSnapshotRecord(\n318\t  line: ClaudeTranscriptLine,\n319\t  ctx: RecordContext,\n320\t  historyDir: string | null,\n321\t): Promise<EventDraft> {\n322\t  const isDelta = line.type === \"file-history-delta\";\n323\t  const files: SnapshotFile[] = isDelta\n324\t    ? [snapshotFile(line.trackingPath ?? \"\", line.backup)]\n325\t    : Object.entries(line.snapshot?.trackedFileBackups ?? {}).map(([path, backup]) =>\n326\t        snapshotFile(path, backup),\n327\t      );\n328\t\n329\t  const resolvedFiles: ResolvedFile[] = [];\n330\t  const seen = new Set<string>();\n331\t  for (const file of files) {\n332\t    const name = file.backup_file;\n333\t    if (historyDir === null || typeof name !== \"string\" || seen.has(name)) continue;\n334\t    seen.add(name);\n335\t    const resolved = await resolveBackup(historyDir, name);\n336\t    if (resolved) resolvedFiles.push(resolved);\n337\t  }\n338\t\n339\t  const detail: { message_id?: string; snapshot_message_id?: string; is_update?: boolean } = {};\n340\t  const messageId = line.messageId ?? line.snapshot?.messageId;\n341\t  if (typeof messageId === \"string\") detail.message_id = messageId;\n342\t  if (typeof line.snapshotMessageId === \"string\") detail.snapshot_message_id = line.snapshotMessageId;\n343\t  if (typeof line.isSnapshotUpdate === \"boolean\") detail.is_update = line.isSnapshotUpdate;\n344\t\n345\t  return fileSnapshotDraft(ctx, isDelta ? \"delta\" : \"snapshot\", detail, files, line, resolvedFiles);\n346\t}\n347\t\n348\t/**\n349\t * Convert a line that is not a `user`/`assistant` turn into the record it\n350\t * deserves, or return null when the type is genuinely unknown (the caller\n351\t * then routes it to the drift path).\n352\t *\n353\t * `system` lines split on whether they carry text. Claude Code uses the type\n354\t * for two unrelated things: printing into the conversation (a slash command's\n355\t * stdout, an away summary, a refusal fallback — all of which the user read,\n356\t * so they are turns spoken by the system) and recording harness bookkeeping\n357\t * (turn durations, hook summaries — which nobody read, so they are activity).\n358\t * A string `content` field is exactly the difference, so that is the test,\n359\t * rather than a subtype list that would go stale the moment Claude Code adds\n360\t * a subtype.\n361\t */\n362\tfunction convertRecordLine(line: ClaudeTranscriptLine, ctx: RecordContext): EventDraft | null {\n363\t  const type = line.type;\n364\t  if (typeof type !== \"string\") return null;\n365\t  const fields = payloadFields(line as unknown as Record<string, unknown>);\n366\t\n367\t  if (type === \"system\") {\n368\t    if (typeof line.content === \"string\" && line.content.trim() !== \"\") {\n369\t      return recordDraft(\n370\t        ctx,\n371\t        \"conversation_turn\",\n372\t        \"system\",\n373\t        { ...liftText(fields, \"content\"), role: \"system\" },\n374\t        line,\n375\t      );\n376\t    }\n377\t    return activityDraft(ctx, `system/${line.subtype ?? \"untyped\"}`, fields, line);\n378\t  }\n379\t\n380\t  if (type === \"attachment\") {\n381\t    const attachmentType = line.attachment?.type;\n382\t    return contextInjectionDraft(\n383\t      ctx,\n384\t      `attachment/${typeof attachmentType === \"string\" ? attachmentType : \"untyped\"}`,\n385\t      fields,\n386\t      line,\n387\t    );\n388\t  }\n389\t\n390\t  if (SESSION_STATE_LINE_TYPES.has(type)) {\n391\t    return sessionStateDraft(ctx, type, fields, line);\n392\t  }\n393\t\n394\t  if (ACTIVITY_LINE_TYPES.has(type)) {\n395\t    // A `queue-operation` enqueue carries the queued prompt or task\n396\t    // notification verbatim — the one activity type that is mostly text.\n397\t    return activityDraft(ctx, type, liftText(fields, \"content\"), line);\n398\t  }\n399\t\n400\t  return null;\n401\t}\n402\t\n403\t/** Raw-only preservation event for an unrecognized claude-code line (see drift.ts). */\n404\tfunction preserve(\n405\t  type: string,\n406\t  line: ClaudeTranscriptLine,\n407\t  occurredAt: string,\n408\t  seq: number,\n409\t  fileSessionId: string,\n410\t  version: string,\n411\t): EventDraft {\n412\t  const sessionId = line.sessionId ?? fileSessionId;\n413\t  const conversation = conversationFor(line, sessionId);\n414\t  return unrecognizedDraft({\n415\t    typeKey: type,\n416\t    line,\n417\t    occurredAt,\n418\t    source: \"claude-code\",\n419\t    sessionId,","tool_use_id":"toolu_01CuofFXKuQbvDQuxwR9r3gG","type":"tool_result"}],"role":"user"},"context":{"branch":"fix-epipe-hook-detach-actor-display","cwd":"/Users/evintunador/repos/evintunador/conversation-ledger","head":"e8e291d4d8b2ba087a0381e30793e0e67a873b35","repo":"git@github.com:evintunador/conversation-ledger.git"},"conversation":{"id":"claude-code:224d1239-00ba-4ddb-8117-5a487d569b0d#agent:a61781e63a0a098a3","parent":"claude-code:224d1239-00ba-4ddb-8117-5a487d569b0d","seq":20},"id":"ev1-a6e8bfdcda926017f5486caae0cafced814d0dbbaa6ea69d822f7a91858deafd","